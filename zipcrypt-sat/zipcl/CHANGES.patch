diff --git a/zipcl.cpp b/zipcl.cpp
index 2852eea..56bf0f9 100644
--- a/zipcl.cpp
+++ b/zipcl.cpp
@@ -15,9 +15,36 @@ int main( int argc, char** argv ) {
 
   if( argc<4 ) return 1;
 
+  // 'g' mode: emit a CBMC key-recovery model instead of (de)crypting.
+  //   zipcl g <archive> <model.cpp> <nunk> <k0> <k1> <k2> [nfiles] [usecheck]
+  if( argv[1][0]=='g' ) {
+    if( argc<8 ) return 1;
+    FILE* f  = fopen(argv[2],"rb"); if( f==0 )  return 2;
+    FILE* gf = fopen(argv[3],"wb"); if( gf==0 ) return 3;
+    M.gen = 1; M.gf = gf; M.mode = 1; M.gcount = 0;
+    M.nunk = atoi(argv[4]);
+    uint k0=0,k1=0,k2=0;
+    sscanf(argv[5],"%X",&k0); sscanf(argv[6],"%X",&k1); sscanf(argv[7],"%X",&k2);
+    M.k0=M.genk0=k0; M.k1=M.genk1=k1; M.k2=M.genk2=k2;
+    M.gmax       = (argc>8) ? atoi(argv[8]) : 8;
+    M.g_usecheck = (argc>9) ? atoi(argv[9]) : 1;
+    M.g_reverse  = (argc>10) ? atoi(argv[10]) : 0;
+    M.password[0]=0;
+    PF = fopen("/dev/null","wb"); if( PF==0 ) return 3;
+    FILE* dn = fopen("/dev/null","wb"); if( dn==0 ) return 3;
+    if( M.g_reverse ) M.gen_header_rev(); else M.gen_header();
+    M.processfile( f, dn );
+    M.gen_footer();   // same footer (match label) for both directions
+    fclose(gf); fclose(f); fclose(dn);
+    fprintf( stderr, "generated %s: %u file(s), %u unknown bit(s), key %08X %08X %08X\n",
+             argv[3], M.gcount, M.nunk, k0, k1, k2 );
+    return 0;
+  }
+
   FILE* f = fopen(argv[2],"rb"); if( f==0 ) return 2;
   FILE* g = fopen(argv[3],"wb"); if( g==0 ) return 3;
 
+  M.gen = 0;
   strcpy( M.password, &argv[1][1] );
   M.mode = (argv[1][0]=='d');
 
diff --git a/zipdump.inc b/zipdump.inc
index bc54d1f..725a70d 100644
--- a/zipdump.inc
+++ b/zipdump.inc
@@ -36,6 +36,135 @@ struct zipdump : Coroutine {
   zipcrypt zcr;
   char password[256];
 
+  // ---- CBMC key-recovery model generation (mode 'g') ----
+  int   gen;          // 1 = emit a SAT model instead of just decrypting
+  FILE* gf;           // model output stream
+  uint  nunk;         // number of low k0 bits left unknown (the SAT variables)
+  uint  gmax;         // max number of files (constraint blocks) to emit
+  uint  gcount;       // files emitted so far
+  uint  genk0,genk1,genk2;  // the real key: known bits + the answer to verify
+  int   g_usecheck;   // also constrain the crc-derived header check byte
+  int   g_reverse;    // emit the reverse model (run cipher backward to the init)
+  byte  g_ctsalt[12]; // captured ciphertext header of the current file
+
+  void gen_header( void ) {
+    uint mask = (nunk>=32) ? 0xFFFFFFFFu : ((1u<<nunk)-1u);
+    fprintf( gf,
+"// Auto-generated by `zipcl g`: a ZipCrypto key-recovery model for CBMC.\n"
+"// Recover the low %u bit(s) of k0 from known-plaintext deflate-header bits\n"
+"// (and the crc-derived header check byte). Real key:\n"
+"//   k0=%08X k1=%08X k2=%08X  ->  unknown bits = %08X\n"
+"typedef unsigned int uint; typedef unsigned char byte;\n"
+"#define MASK 0x%08Xu\n"
+"// ZipCrypto's CRC32(crc,b) is the standard reflected CRC32 single-byte update,\n"
+"// emitted bitwise (not table-driven) so its GF(2)-linear structure stays\n"
+"// visible to the SAT solver -- a 256-entry symbolic table lookup is far harder.\n"
+"uint CRC32(uint crc, byte b){ crc^=b; for(int k=0;k<8;k++) crc=(crc>>1)^(0xEDB88320u&(0u-(crc&1u))); return crc; }\n"
+"uint k0,k1,k2;\n"
+"void update_keys(byte c){k0=CRC32(k0,c);k1=(k1+(k0&0xffu))*134775813u+1u;k2=CRC32(k2,(byte)(k1>>24));}\n"
+"byte decrypt_byte(){uint t=(k2&0xffffu)|2u;return (byte)((t*(t^1u))>>8);}\n"
+"extern uint UNK;          // nondeterministic: the SAT solver fills this in\n"
+"int main(){\n"
+"  __CPROVER_assume((UNK & ~MASK)==0u);   // only the low %u bit(s) are free\n",
+      nunk, genk0,genk1,genk2, genk0&mask, mask, nunk );
+  }
+
+  // Emit one file's constraint block. cts[0..11]=ciphertext header, ctb=first
+  // ciphertext body byte, crc/usize/csize from the local header.
+  void gen_emit_file( byte* cts, byte ctb, uint crc, qword usize, qword csize ) {
+    if( g_reverse ) { gen_emit_file_rev( cts, ctb, crc, usize, csize ); return; }
+    if( gcount>=gmax ) return;
+    if( csize==0 ) return;                 // empty body: no deflate byte to use
+    uint btype = (csize>=usize) ? 0u : 2u; // stored(00) if not smaller, else dynamic(10)
+    uint defl3 = 1u | (btype<<1);          // BFINAL=1 (single block) | BTYPE
+    uint check = (crc>>24)&0xFFu;          // last header byte == crc>>24
+    fprintf( gf,
+"  // file %u: uSize=%llu cSize=%llu crc=%08X  -> BFINAL=1 BTYPE=%s\n"
+"  k0=(0x%08Xu&~MASK)|(UNK&MASK); k1=0x%08Xu; k2=0x%08Xu;\n"
+"  { static const byte ct[13]={",
+      gcount,(unsigned long long)usize,(unsigned long long)csize,crc,
+      btype?"10":"00", genk0,genk1,genk2 );
+    for( int i=0;i<12;i++ ) fprintf( gf,"0x%02X,",cts[i] );
+    fprintf( gf,"0x%02X}; byte pt=0;\n",ctb );
+    fprintf( gf,
+"    for(int i=0;i<12;i++){ pt=ct[i]^decrypt_byte(); update_keys(pt); }\n" );
+    if( g_usecheck )
+      fprintf( gf,"    __CPROVER_assume(pt==0x%02Xu);              // crc check byte\n",check );
+    fprintf( gf,
+"    byte b0=ct[12]^decrypt_byte();\n"
+"    __CPROVER_assume((b0&7u)==%uu);             // deflate BFINAL|BTYPE\n"
+"  }\n", defl3 );
+    gcount++;
+  }
+
+  void gen_footer( void ) {
+    fprintf( gf,
+"  match: {}   // reachable iff UNK is consistent with every file's known plaintext\n"
+"  return 0;\n"
+"}\n" );
+  }
+
+  // ---- reverse model: free per-file body-start state, run the cipher BACKWARD
+  //      through the 12-byte header, and require the recovered init == known key.
+  void gen_header_rev( void ) {
+    uint mask = (nunk>=32) ? 0xFFFFFFFFu : ((1u<<nunk)-1u);
+    uint minv = 134775813u; for( int i=0; i<5; i++ ) minv = minv*(2u-134775813u*minv);
+    fprintf( gf,
+"// Auto-generated by `zipcl g ... reverse`: REVERSE ZipCrypto key-recovery model.\n"
+"// The free variables are each file's key state at the start of its body (S[]).\n"
+"// We run the cipher BACKWARD through the 12-byte header; the recovered initial\n"
+"// state must equal the known key, whose low %u bit(s) are left free = answer UNK.\n"
+"//   k0=%08X k1=%08X k2=%08X  ->  unknown bits = %08X\n"
+"typedef unsigned int uint; typedef unsigned char byte;\n"
+"#define MASK 0x%08Xu\n"
+"#define MINV 0x%08Xu      // (134775813)^-1 mod 2^32, inverts the k1 step\n"
+"// inverse of the standard reflected CRC32 single-byte update (8 rounds undone):\n"
+"uint CRC32inv(uint x, byte b){ for(int k=0;k<8;k++){ uint t=x>>31; x=((x^(t?0xEDB88320u:0u))<<1)|t; } return x^b; }\n"
+"byte decrypt_byte(uint k2){ uint t=(k2&0xffffu)|2u; return (byte)((t*(t^1u))>>8); }\n"
+"extern uint UNK;            // recovered low key bit(s) -- the answer\n"
+"extern uint S[%u];          // free: each file's key state at its body start\n"
+"int main(){\n"
+"  __CPROVER_assume((UNK & ~MASK)==0u);\n",
+      nunk, genk0,genk1,genk2, genk0&mask, mask, minv, 3u*gmax );
+  }
+
+  void gen_emit_file_rev( byte* cts, byte ctb, uint crc, qword usize, qword csize ) {
+    if( gcount>=gmax ) return;
+    if( csize==0 ) return;
+    uint btype = (csize>=usize) ? 0u : 2u;
+    uint defl3 = 1u | (btype<<1);
+    uint check = (crc>>24)&0xFFu;
+    uint idx = 3u*gcount;
+    fprintf( gf,
+"  // file %u: uSize=%llu cSize=%llu crc=%08X  -> BFINAL=1 BTYPE=%s\n"
+"  { uint a0=S[%u], a1=S[%u], a2=S[%u];           // free state at body start\n"
+"    static const byte ct[13]={",
+      gcount,(unsigned long long)usize,(unsigned long long)csize,crc,
+      btype?"10":"00", idx,idx+1,idx+2 );
+    for( int i=0;i<12;i++ ) fprintf( gf,"0x%02X,",cts[i] );
+    fprintf( gf,"0x%02X};\n",ctb );
+    fprintf( gf,
+"    __CPROVER_assume(((ct[12]^decrypt_byte(a2))&7u)==%uu);  // deflate (body-start k2)\n"
+"    byte pt11=0;\n"
+"    for(int i=11;i>=0;i--){                       // undo the 12 header updates\n"
+"      uint b2=CRC32inv(a2,(byte)(a1>>24));\n"
+"      byte c=ct[i]^decrypt_byte(b2);              // recovered header plaintext byte\n"
+"      uint b1=(a1-1u)*MINV-(a0&0xffu);\n"
+"      uint b0=CRC32inv(a0,c);\n"
+"      if(i==11) pt11=c;\n"
+"      a0=b0; a1=b1; a2=b2;\n"
+"    }\n", defl3 );
+    if( g_usecheck )
+      fprintf( gf,"    __CPROVER_assume(pt11==0x%02Xu);                      // crc check byte\n",check );
+    fprintf( gf,
+"    __CPROVER_assume(a1==0x%08Xu);                  // recovered init must equal\n"
+"    __CPROVER_assume(a2==0x%08Xu);                  // the known key ...\n"
+"    __CPROVER_assume((a0 & ~MASK)==(0x%08Xu & ~MASK));\n"
+"    __CPROVER_assume((a0 & MASK)==(UNK & MASK));    // ... and exposes UNK\n"
+"  }\n", genk1, genk2, genk0 );
+    gcount++;
+  }
+
   union {
     ZIPFILERECORD hdr;
     ZIPDIRENTRY idx;
@@ -197,6 +326,7 @@ struct zipdump : Coroutine {
 
           //zcr.init_keys( password );
           zcr.k0=k0;zcr.k1=k1;zcr.k2=k2;
+          if( gen ) for( uint gi=0; gi<12; gi++ ) g_ctsalt[gi]=zcr.pad[gi]; // capture ciphertext header
           zcr.crypt( zcr.pad, 12, mode );
 
 // 1+2+5+5+4+3*19 = 74 = 9.25*8
@@ -212,6 +342,7 @@ printf( "%08X %08X %08X %8llu %8llu !", (uint&)zcr.pad[8], hdr.crc32, (uint(hdr.
           qword jj = (f_cr==2) ? hdr.cSize64 : hdr.cSize64-12;
           for( qword ii=0; ii<jj; ii++ ) {
             uint c = get();
+            if( gen && ii==0 ) gen_emit_file( g_ctsalt, byte(c), hdr.crc32, hdr.uSize64, hdr.cSize64 ); // ct body[0]
             d = c ^ zcr.decrypt_byte();
             zcr.update_keys( mode ? d : c );
