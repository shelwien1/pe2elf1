/* rosePublicConfig.h -- generated by the top-level Makefile from config/rosePublicConfig.h.in.
 *
 * Public ROSE configuration (all macros start with "ROSE_").  This corresponds to the file that ROSE's
 * CMake build generates for a C/C++-only configuration (ENABLE_C=ON, no binary analysis), except that the
 * C/C++ front end is the open-source EDG front end built from source.
 */
#ifndef ROSE_PUBLIC_CONFIG_H
#define ROSE_PUBLIC_CONFIG_H

#define ROSE_SCM_VERSION_ID "@ROSE_VERSION@"
#define ROSE_VERSION @ROSE_VERSION_NUMBER@
#define ROSE_PACKAGE_VERSION "@ROSE_VERSION@"

#define ROSE_HAVE_BOOST_SERIALIZATION_LIB 1
#define ROSE_ENABLE_BOOST_SERIALIZATION

#define ROSE_Z3_EXECUTABLE ""
#define ROSE_Z3 ROSE_Z3_EXECUTABLE
#define ROSE_LIBGCRYPT_LIBRARY ""
#define ROSE_CAPSTONE_LIBRARY ""
#define ROSE_SQLITE3_LIBRARY ""
#define ROSE_LIBDWARF_LIBRARY ""

#define ROSE_HAVE_PTHREAD_H

#define ROSE_COMPILE_TREE_PATH "@BUILD_DIR@"
#define ROSE_SOURCE_TREE_PATH "@ROSE_SRC_DIR@"
#define ROSE_SHLIBPATH_VAR "LD_LIBRARY_PATH"

#define ROSE_SIZEOF_INT 4
#ifdef _WIN32
#define ROSE_SIZEOF_LONG 4
#else
#define ROSE_SIZEOF_LONG 8
#endif

#define ROSE_OFP_MAJOR_VERSION_NUMBER 0
#define ROSE_OFP_MINOR_VERSION_NUMBER 8
#define ROSE_OFP_PATCH_VERSION_NUMBER 3
#define ROSE_OFP_VERSION_NUMBER ""

/* The C/C++ front end: open-source EDG (https://github.com/edgcpp/compiler) */
#define ROSE_EDG_MAJOR_VERSION_NUMBER @EDG_MAJOR@
#define ROSE_EDG_MINOR_VERSION_NUMBER @EDG_MINOR@
#define ROSE_USE_EDG_QUAD_FLOAT

/* Analyzable languages: C, C++ and the C preprocessor only */
#define ROSE_BUILD_CXX_LANGUAGE_SUPPORT
#define ROSE_BUILD_C_LANGUAGE_SUPPORT
#define ROSE_BUILD_CPP_LANGUAGE_SUPPORT

#define ROSE_ALLOC_MEMSET 0

/* Configuration synopsis checked by ROSE_INITIALIZE (must match between librose and tools) */
#define ROSE_CONFIG_TOKEN "rose-@ROSE_VERSION@ boost-@BOOST_VERSION@ pthread"

#define ROSE_WAVE_DEFAULT false

#endif
