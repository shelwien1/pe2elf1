// rose_paths.C -- generated by the top-level Makefile from config/rose_paths.C.in
#include <string>
#include "rose_paths.h"

#ifdef _WIN32
#define WIN32_LEAN_AND_MEAN
#define NOMINMAX
#include <windows.h>

// The Windows build is relocatable: the installation prefix is the parent of the directory
// that contains the library (<prefix>\bin\rose.dll, or the program if it is linked statically),
// and the EDG configuration and the system headers are found relative to it
// (<prefix>\edg-base, <prefix>\include\edg).
static std::string executablePrefix() {
  std::string path(32768, '\0');
  HMODULE module = NULL;
  GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
                     (LPCSTR)&executablePrefix, &module);
  DWORD n = GetModuleFileNameA(module, &path[0], (DWORD)path.size());
  path.resize(n < path.size() ? n : 0);
  for (int i = 0; i < 2; ++i) {
    std::string::size_type slash = path.find_last_of("\\/");
    path = slash == std::string::npos ? std::string(".") : path.substr(0, slash);
  }
  return path;
}
#else
#include <dlfcn.h>
#include <stdlib.h>

// The installation prefix is the parent of the directory that contains librose.so
// (<prefix>/lib/librose.so, also in the build tree): the Linux binary release (RELOCATABLE=1) is
// relocatable, and finds the EDG configuration and the system headers relative to it.
static std::string libraryPrefix() {
  Dl_info info;
  if (dladdr((void*)&libraryPrefix, &info) == 0 || info.dli_fname == NULL) return "@BUILD_DIR@";
  char* real = realpath(info.dli_fname, NULL);
  std::string path = real != NULL ? real : info.dli_fname;
  free(real);
  for (int i = 0; i < 2; ++i) {
    std::string::size_type slash = path.find_last_of('/');
    path = slash == std::string::npos ? std::string(".") : path.substr(0, slash);
  }
  return path;
}
#endif

const std::string ROSE_GFORTRAN_PATH          = "";
const std::string ROSE_AUTOMAKE_TOP_SRCDIR    = "@ROSE_SRC_DIR@";
const std::string ROSE_AUTOMAKE_TOP_BUILDDIR  = "@BUILD_DIR@";
#ifdef _WIN32
const std::string ROSE_AUTOMAKE_PREFIX        = executablePrefix();
#else
const std::string ROSE_AUTOMAKE_PREFIX        = libraryPrefix();
#endif
const std::string ROSE_AUTOMAKE_DATADIR       = "/*deprecated*/";
const std::string ROSE_AUTOMAKE_BINDIR        = "/*deprecated*/";
const std::string ROSE_AUTOMAKE_INCLUDEDIR    = "/*deprecated*/";
const std::string ROSE_AUTOMAKE_INFODIR       = "/*deprecated*/";
const std::string ROSE_AUTOMAKE_LIBDIR        = "/*deprecated*/";
const std::string ROSE_AUTOMAKE_LIBEXECDIR    = "/*deprecated*/";
const std::string ROSE_AUTOMAKE_LOCALSTATEDIR = "/*deprecated*/";
const std::string ROSE_AUTOMAKE_MANDIR        = "/*deprecated*/";

const std::string ROSE_AUTOMAKE_ABSOLUTE_PATH_TOP_SRCDIR = "@ROSE_SRC_DIR@";

const std::string ROSE_CONFIGURE_DATE     = "@BUILD_DATE@";
const std::string ROSE_AUTOMAKE_BUILD_OS  = "@BUILD_OS@";
const std::string ROSE_AUTOMAKE_BUILD_CPU = "x86_64";
const std::string ROSE_OFP_VERSION_STRING = "";

const unsigned long ROSE_NUMERIC_VERSION = @ROSE_VERSION_NUMBER@ul;
