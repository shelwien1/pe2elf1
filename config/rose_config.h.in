/* rose_config.h -- generated by the top-level Makefile from config/rose_config.h.in.
 *
 * Private ROSE configuration, equivalent to what ROSE's CMake build generates for a C/C++-only
 * configuration on Linux with GNU compilers.
 */
#ifndef ROSE_CONFIG_H
#define ROSE_CONFIG_H

#include <rosePublicConfig.h>

#define HAVE_LIBDL 1
#define HAVE_BOOST TRUE
#define HAVE_BOOST_DATE_TIME 1
#define HAVE_BOOST_FILESYSTEM 1
#define HAVE_BOOST_PROGRAM_OPTIONS 1
#define HAVE_BOOST_REGEX 1
#define HAVE_BOOST_SYSTEM 1
#define HAVE_BOOST_THREAD 1
#define HAVE_BOOST_WAVE 1
#define USE_ROSE_BOOST_WAVE_SUPPORT 1
#define HAVE_BOOST_SERIALIZATION_LIB 1

#define HAVE_ARGZ_H 1
#define HAVE_ARGZ_APPEND 1
#define HAVE_ARGZ_CREATE_SEP 1
#define HAVE_ARGZ_INSERT 1
#define HAVE_ARGZ_NEXT 1
#define HAVE_ARGZ_STRINGIFY 1
#define HAVE_WORKING_ARGZ 1
#define HAVE_CTYPE_H 1
#define HAVE_DIRENT_H 1
#define HAVE_DLFCN_H 1
#define HAVE_STDLIB_H 1
#define HAVE_SYS_TIME_H 1
#define HAVE_CLOCK_GETTIME 1
#define HAVE_DLADDR 1
#define HAVE_PTHREAD_H
#define TIME_WITH_SYS_TIME 1

/* Backend (vendor) compilers used to compile the unparsed code */
#define BACKEND_CXX_IS_GNU_COMPILER 1
#define BACKEND_CXX_COMPILER_NAME_WITH_PATH "@CXX_PATH@"
#define BACKEND_CXX_COMPILER_NAME_WITHOUT_PATH "@CXX_NAME@"
#define BACKEND_CXX_COMPILER_MAJOR_VERSION_NUMBER @CXX_MAJOR@
#define BACKEND_CXX_COMPILER_MINOR_VERSION_NUMBER @CXX_MINOR@
#define BACKEND_CXX_COMPILER_PATCH_VERSION_NUMBER @CXX_PATCH@
#define ROSE_BACKEND_CXX_COMPILER "@CXX_NAME@"
#define BACKEND_C_COMPILER_NAME_WITH_PATH "@CC_PATH@"
#define BACKEND_C_COMPILER_NAME_WITHOUT_PATH "@CC_NAME@"
#define BACKEND_C_COMPILER_MAJOR_VERSION_NUMBER @CC_MAJOR@
#define BACKEND_C_COMPILER_MINOR_VERSION_NUMBER @CC_MINOR@
#define BACKEND_C_COMPILER_PATCH_VERSION_NUMBER @CC_PATCH@
#define ROSE_BACKEND_C_COMPILER "@CC_NAME@"
#define BACKEND_FORTRAN_COMPILER_NAME_WITH_PATH ""
#define BACKEND_FORTRAN_COMPILER_NAME_WITHOUT_PATH ""
#define BACKEND_FORTRAN_COMPILER_MAJOR_VERSION_NUMBER 0
#define BACKEND_FORTRAN_COMPILER_MINOR_VERSION_NUMBER 0
#define BACKEND_JAVA_COMPILER_NAME_WITH_PATH ""
#define BACKEND_PYTHON_INTERPRETER_NAME_WITH_PATH ""
#define BACKEND_C_COMPILER_SUPPORTS_UNDESCORE_ASM

/* System include directories of the backend compilers (handed to EDG as --sys_include).
 * Unlike ROSE's EDG 6.x binaries, EDG 7.0 parses the GNU headers directly, so no
 * ROSE-modified copies of the compiler headers are needed. */
#define CXX_INCLUDE_STRING { @CXX_INCLUDE_DIRS@ }
#define C_INCLUDE_STRING { @C_INCLUDE_DIRS@ }

/* -D options handed to EDG (EDG itself defines the GNU macros in --gnu_version mode) */
#define CXX_SPEC_DEF { "-D__GNUG__=@CXX_MAJOR@", "-D__GNUC__=@CXX_MAJOR@", "-D__GNUC_MINOR__=@CXX_MINOR@", "-D__GNUC_PATCHLEVEL__=@CXX_PATCH@" }

#define IDA_PRO_PATH ""
#define JAVA_VERSION_MAJOR ""
#define JAVA_JVM_PATH ""

#define SIZEOF_CHAR 1
#define SIZEOF_DOUBLE 8
#define SIZEOF_FLOAT 4
#define SIZEOF_INT 4
#define SIZEOF_LONG 8
#define SIZEOF_LONG_DOUBLE 16
#define SIZEOF_LONG_LONG 8
#define SIZEOF_SHORT 2
#define SIZEOF_VOID_P 8

#define VERSION "@ROSE_VERSION@"
#define USE_ROSE_EDG_DEBUGGING_SUPPORT 0
#define CHECKING 1
#define USE_CMAKE ON
#define CMAKE_COMPILER_IS_GNUCC
#define CMAKE_COMPILER_IS_GNUCXX
#define SAGE_TRANSFORM 1

/* Indicates that rose_config.h has been included */
#define CONFIG_ROSE 1

#endif
