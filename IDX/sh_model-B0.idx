# bmpc's LPC mixer parameters -- the source of record for
# MOD/sh_model-B0_h.inc.  Regenerate with:  GCIDX=1 ./gc.sh
#
# Values are the corpus optimum; README-bmpc.md says what each one measured.
# A leading '!' freezes the line (IDX-FORMAT.md sec.10): same object, same
# value, but the descriptor carries no !MAP! marker so IDX/opt.pl's scan
# skips it.  Everything only reachable through a model toggle that is off in
# the shipped build is frozen, which takes the search from 1387 bits to 215.

Prefix B0
Debug 1
Const 0

# --- Config_LW: one ParamUpdater per mix weight ---
# momentum_D = M1_w/1024, momentum_R = M2_w/65536.  Both 0: the Newton
# denominator is the instantaneous hdot*|x|^2, and an EMA cannot track a
# 1000:1 swing in it.
Number M1_w,    1, 0!0000
Number M2_w,    1, 0!0000
# NW/4096: damping on the exact rank-1 Newton step.
Number NW_w,    1, 1!01111111111
# inc/(1<<20): NLMS epsilon.  0 costs +19%.
Number INC_w,   1, 1!1111111100100110000
# stepMax/65536 and the |w| box /1024.  Measured non-binding, kept live in
# case a future model shape needs them.
Number STEP_w,  1, 1!0110011001100
Number WMAX_w,  1, 1!0111111111111
# grad2_clip/1024 and D_clip/64.
Number G2_w,    1, 1!01011111111100110
Number D_w,     1, 1!0000000000000
Number R_w,     1, 1!011110100001000111111
Number R0_w,    1, 0!0000
# ParamUpdater never reads grad1_clip.
!Number G1_w,   1, 1!0111111111111

# --- loss ---
# MIX_LOSS knee /1024; 48 == 6 byte levels.
Number HUB,     1, 1!0001111

# --- MIX_DUAL: the second mix and the blend coordinate z ---
Number NW2_w,   1, 1!0110110100111
Number INC2_w,  1, 1!0101011001000000100
Number HUB2,    1, 1!100000
Number NWL,     1, 1!011111111111111
Number INCL,    1, 1!000000000000010
Number STEPL,   1, 1!00100100101101111
Number MM2,     1, 0!0000

# --- reachable only through a model toggle that is off ---
# W_LOGIT: weight box lo/hi /1024.
!Number WLO,    1, -4096!00000000000000
!Number WHI,    1, 1!0111111111111
# MIX_BASE=0: seed of the left-neighbour tap /1024.
!Number W0,     1, 1!01111111111
# MIX_LOGISTIC: stretch clamp /1024.
!Number SQC,    1, 1!01111111111111
# MIX_LOSS=3: knee as a multiple of EMA(|e|) /256, its rate and seed /1024.
!Number HUBA,   1, 1!0111111111
!Number MADR,   1, 1!00001111
!Number MAD0,   1, 1!00011111
# MIX_BIAS=2: gradient quantiser thresholds and the offset EMA rate /1024.
!Number BT1,    1, 1!0010
!Number BT2,    1, 1!000110
!Number BT3,    1, 1!0010100
!Number BR,     1, 1!00011111

# --- residual-model mixer and APM ---
# NWB/4096 damping of the mixer's Newton step, INCB/1024 its epsilon,
# STEPB/65536 its trust region, DB/1024 the per-weight gradient clip.
Number NWB,     1, 1!01111111111
Number INCB,    1, 1!0001111111001110
Number STEPB,   1, 1!0110011001100
Number DB,      1, 1!1111000010001
# seed of each mixer weight /1024 (1/RES_NM would be 341)
Number BMW0,    1, 1!0011000000
# how much of the APM's opinion to take /1024 (frozen: RES_SSE=0)
!Number SSEW,    1, 1!01011111111

# --- BLK_STAT: block geometry, as log2 of the edge (6 -> 64x64) ---
# Consumers clamp to 1..12 (blkl()).
# Frozen, and not because they do not matter: the statistic picture costs
# 4*n_colors bytes per block whatever the block holds, so the best edge is a
# trade between how tightly a block constrains its pixels and how much the
# picture costs -- and it lands differently for a noisy 320x240 (32x32 wins,
# -1%) than for a smooth 4096x512 (128x128 wins).  opt.pl's corpus is crops,
# which makes every image small, so it would answer that question with a bias
# it cannot see.  Tune these against whole files.
!Number BLKLW,  1, 1!0101
!Number BLKLH,  1, 1!0101

# --- CT_ON: colour component order ---
# CTM/1024: a non-identity order is only taken if its trial cost is below
# this fraction of the identity's.  1024 = no margin, take the best sample.
# A 0.4% margin was tried to stop sampling noise flipping near-ties: it
# protects the odd file by a couple of tenths and costs more than that
# elsewhere (corpus -0.70% with it, -0.85% without), so it is off.
Number CTM,     1, 1!01111111111
