 dig_t_ps:   ps,   -6!0000000000000
 dig_t_chn: chn, 1!1010101
 dig_t_crun: crun,  1!000000000
 dig_t_cm:   cm,    1!0

#  mp3c's exA: av (running mean) and the six neighbours, weighted, scaled by
#  avC/4096 and log-quantised into `ax`.  avD/256 is the running mean's decay.
Number dig_avD,  1, 0!11101111
Number dig_avA,  1, 0!111
Number dig_avT1, 1, 0!010
Number dig_avT2, 1, 0!001
Number dig_avN1, 1, 0!101
Number dig_avW1, 1, 0!011
Number dig_avQ1, 1, 0!101
Number dig_avQ2, 1, 0!011
Number dig_avC, 1, 0!0110101111

Number dig_rA, 1, 0!11111111
Number dig_rB, 1, 0!11111110
Number dig_rC, 1, 0!00010000
Number dig_rD, 1, 0!11100011
Number dig_rT, 1, 0!11111111
