! flr_s_col:  col,   1!1011101
! flr_s_p1:   p1,    1!000
! flr_s_fy:   fy,    1!101
! flr_s_o1:   o1,    1!0000000
! flr_s_prd:   prd,    1!0000000
! flr_s_od:   od,   -4!000000000
! flr_s_chn:  chn,   1!0
! flr_s_room: room,  1!00000000
! flr_s_hl:   hl,    1!00
! flr_s_lov:  lov,   1!00000000
! flr_s_hiv:  hiv,   1!00000000
! flr_s_pri:  pri,   1!00000000000000000000000000000000
! flr_s_ep:   ep,    1!00000000000

Index flr_f
! flr_f_col:  col,   1!0000000
! flr_f_p1:   p1,    1!000
! flr_f_fy:   fy,    1!000
! flr_f_o1:   o1,    1!0000000
! flr_f_prd:   prd,    1!0000000
