
Prefix MB
Debug 1

# ---------------------------------------------------------------------
# ModelBlock: the original rank-and-escape pixel model.
# ---------------------------------------------------------------------

# Structural: these size members.
Const 1

Number row_margin,       1,0!111
Number row_tail,         1,0!1001
Number freq_table_offset,  1,0!10111100
Number freq_grid_count,  1,0!10000000010111011
Number sel1_syms,        1,0!1100011
Number sel0_syms,        1,0!100001

# pixel_context: which neighbour ranks count as a near hit and which as a
# far one, how deep into a symbol list a membership test looks, and the
# rank positions the context switches shape at.
Const 0

Number near_lo,          1,0!1011
Number near_hi,          1,0!10000
Number far_hi,           1,0!100000
Number exact_rank,       1,0!1010
Number top_depth_0,      1,0!1010
Number top_depth_1,      1,0!100
Number top_depth_2,      1,0!1010
Number top_depth_3,      1,0!110
Number pos_bare,         1,0!110
Number pos_split,        1,0!1110
Number pos_deep,         1,0!1001

# The map context: how far up the rank ladder it separates positions
# before it stops caring, and the alphabet size below which the symbol
# cache is keyed differently.

Number apm_pos_cap,      1,0!111
Number small_alphabet,   1,0!100000

# The fifteen seeded context groups.  Each entry is a set of flags saying which
# of six neighbour relations that group conditions on, so this is the slow
# model's context menu -- and the one table in it that is a design choice
# rather than an ordering.

Number group_flags_00,  1,0!0
Number group_flags_01,  1,0!1
Number group_flags_02,  1,0!10
Number group_flags_03,  1,0!100
Number group_flags_04,  1,0!1000
Number group_flags_05,  1,0!1010
Number group_flags_06,  1,0!1101
Number group_flags_07,  1,0!10000
Number group_flags_08,  1,0!10001
Number group_flags_09,  1,0!10110
Number group_flags_10,  1,0!100000
Number group_flags_11,  1,0!100011
Number group_flags_12,  1,0!100100
Number group_flags_13,  1,0!111000
Number group_flags_14,  1,0!111111

# ---------------------------------------------------------------------
# Context indices, as Index declarations.  See the note in bmf-P2.idx for why
# these build the same integer the CtxIdx chains built.
# ---------------------------------------------------------------------

# The frequency-grid bucket: three ranks in a mixed radix.  ctx_bucket is
# sized by this declaration's Volume, so moving a radix moves the table.

Index Bucket
 ADD 5: prev
 ADD 5: last
 ADD 15: group

# The run counter: a four-bit bucket under a three-way novelty class.

Index RunCtr
 ADD 3: novel
 ADD 16: bucket

# The candidate context: three neighbourhood-hit flags over four
# list-membership flags.  Volume 128.

Index CandCtx
 ADD 2: exact
 ADD 2: near
 ADD 2: far
 ADD 2: in_top
 ADD 2: in_prev
 ADD 2: in_sym
 ADD 2: in_sel

# The counter node it addresses, under the rank position.  Volume 4096, which
# is what bit_node holds -- and the fallback pair's is 16, which is bit_root.

Index CandNode
 ADD 32: pos
 ADD %M%CandCtx_Volume: ctx

Index CandFallback
 ADD 2: deep
 ADD 8: fallback
