#  The mantissa of a digit that escaped the ladder: its own plane, on its own
#  index and its own tables, as mp3c's Smant is a submodel of its own.

Index t
 t_pass: pass,  1!111
 t_band: band,  1!000
 t_q1:   q1,    1!00000
 t_t1:   t1,    1!000
 t_bkq:  bkq,   1!000
 t_cls: cls, 1!010100101001010
 t_vpos: vpos,  1!0
 t_q1s:  q1s,  -6!0000000000000
 t_q2s:  q2s,  -6!0000000000000
 t_t1s:  t1s,  -6!0000000000000
 t_t2:   t2,   1!000
 t_n1:   n1,   1!000
 t_w1:   w1,   1!000
 t_p0:   p0,   1!100
 t_p0s:  p0s,  -6!0000000000000
 t_pn:   pn,   1!000
 t_ax:   ax,   1!000000000000
 t_pq:   pq,    1!00000000000000000000000000000000
 t_ps:   ps,   -6!0000000000000
 t_chn: chn, 1!1010101
 t_crun: crun,  1!000000000
 t_cm:   cm,    1!0
 t_x1: x1, 1!000
 t_x1s: x1s, -6!0000000000000

#  mp3c's exA: av (running mean) and the seven neighbours, weighted, scaled by
#  avC/4096 and log-quantised into `ax`.  avD/256 is the running mean's decay.
#  avN1 is wider than three bits because the sweep wanted 9: what it names is
#  a same-channel neighbour now, and that is worth more than the half-crossed
#  one it named before.
Number avD,  1, 0!11101111
Number avA,  1, 0!111
Number avT1, 1, 0!010
Number avT2, 1, 0!001
Number avN1, 1, 0!01001
Number avW1, 1, 0!011
Number avQ1, 1, 0!101
Number avQ2, 1, 0!011
#  The coupled channel at this place, a packet ago -- only an interleaved
#  residue has one.  See tc_part.
Number avX1, 1, 0!101
Number avC, 1, 0!0110101111

Number rA, 1, 0!11111111
Number rB, 1, 0!11111110
Number rC, 1, 0!00010000
Number rD, 1, 0!11100011
Number rT, 1, 0!11111111
Number rS1, 1, 0!00111
Number rS2, 1, 0!00111
Number lr, 1, 0!01011
Number lrm, 1, 0!100000
Number mbm, 1, 0!01000100
Number mwA, 1, 0!00000010
Number mwB, 1, 0!00000010
Number mwC, 1, 0!00000010
Number mwD, 1, 0!00000010
Number mwT, 1, 0!00000010
Number bw, 1, 0!01011
Number qs, 1, 3!0011110
Number qf, 1, 3!0111110
Number mb, 1, 0!01000100


Index n
 n_pass: pass,  1!111
 n_band: band,  1!000
 n_q1:   q1,    1!00000
 n_t1:   t1,    1!000
 n_bkq:  bkq,   1!000
 n_cls: cls, 1!010100101001010
 n_vpos: vpos,  1!0
 n_q1s:  q1s,  -6!0000000000000
 n_q2s:  q2s,  -6!0000000000000
 n_t1s:  t1s,  -6!0000000000000
 n_t2:   t2,   1!000
 n_n1:   n1,   1!000
 n_w1:   w1,   1!000
 n_p0:   p0,   1!100
 n_p0s:  p0s,  -6!0000000000000
 n_pn:   pn,   1!000
 n_ax:   ax,   1!000000000000
 n_pq:   pq,    1!00000000000000000000000000000000
 n_ps:   ps,   -6!0000000000000
 n_chn: chn, 1!1010101
 n_crun: crun,  1!000000000
 n_cm:   cm,    1!0
