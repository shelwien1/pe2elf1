Index s
 s_pass: pass, 1!10
 s_band: band, 1!100
 s_q1: q1, 1!000
 s_t1: t1, 1!011
 s_bkq: bkq, 1!101
 s_cls:  cls,   1!000
 s_vpos: vpos,  1!0
 s_q1s: q1s, -6!0000000000000
 s_q2s: q2s, -6!0000000000000
 s_t1s: t1s, -6!1000000000000
