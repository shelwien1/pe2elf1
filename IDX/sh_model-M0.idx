
Prefix M0
Debug 1

# ======================================================================
# sh_model-M0.idx -- every tunable of the 2-input mixer (sh_mix2.inc).
#
# p = sq( w*st(p1) + (1-w)*st(p2) + b ),  w = sq(W), per mixer context:
# W and b are ParamUpdater states (the Newton updater of newton.inc),
# p1 = the order-1 prediction, p2 = the SSE output.  See SSE-DESIGN.md.
# ======================================================================

Const 1

# --- mixer context ------------------------------------------------------
Index Cx
 c2: c2, &11111111    # byte before last (bits tunable)
 c1: c1, &11000000    # last byte (bits tunable)
 cx: cxt, b&00000000  # bit-tree node: b& merges node bits counted from the leading 1 (0 = keep)

# --- weight / bias seeds and boxes --------------------------------------
Number W0,    1,0!100100000100101   # initial w (weight of p1), /32768
Number Wclip, 1,0!001100001010   # |W| box in logit coordinates, /256
Number Bclip, 1,0!00010101000   # |b| box, /256
Number Pmin,  1,0!101001111100011   # input probability clip, /(SCALE<<16)

Const 1

# --- ParamUpdater of W: newton.inc scalings ------------------------------
Number M1w,   1,0!1111111111011001010   # momentum_D = 1 - M1w/(SCALE<<9)
Number M2w,   1,0!01111100000101000   # momentum_R = 1 - M2w/(SCALE<<11)
Number NWw,   1,0!0111111011100100000   # step gain NW = NWw/(SCALE<<9)
Number INCw,  1,0!111100101110010000   # Newton damping inc = INCw/(SCALE<<11)
Number STEPw, 1,0!1101000010000110101   # step clip = STEPw/(SCALE<<8)
Number G2w,   1,0!1111001   # curvature clip = G2w/32
Number DCw,   1,0!101111001   # D clip = DCw/16
Number RCw,   1,0!000000011011011   # R clip = RCw/16
Number NAGw,  1,0!1   # 1: Nesterov look-ahead (step from momentum_D*D_new - g)

Const 1

# --- ParamUpdater of the bias --------------------------------------------
Number M1b,   1,0!1111111111110000000
Number M2b,   1,0!00111010001000110
Number NWb,   1,0!10000000000000001000
Number INCb,  1,0!000100101101010011
Number STEPb, 1,0!1111101011100000100
Number G2b,   1,0!0000000
Number DCb,   1,0!010000000
Number RCb,   1,0!100000000000000
Number NAGb,  1,0!1   # 1: Nesterov look-ahead

Const 1

Const 1

# --- A1 young-cell step schedule (sh_mix2.inc Update) ---------------------
# stepMax_eff = stepMax*(1 + AGAx/(1 + age/B)) on W (AGAw) and b (AGAb);
# AGAx/256, 0 = plain limit.  B = AGB/16 updates (64 = 4 updates).
Number AGAw,   1,0!000000000000
Number AGAb,   1,0!000010000100
Number AGB,    1,0!0000010000
