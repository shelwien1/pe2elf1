
Prefix P1
Debug 1

# ---------------------------------------------------------------------
# alt-P1: the MED-predictor residual model.
#
# The counter bumps below are the weights this model spends its evidence
# at: how hard a hit updates the cell it landed in, its two neighbours in
# the level ladder, and the alternate context.  They were tuned as a set.
# ---------------------------------------------------------------------

# Structural sizes: these must stay constant expressions -- they size
# arrays and drive template arguments.
Const 1

Number row_margin,       1,0!100
Number row_tail,         1,0!110
Number counter_count,    1,0!10011001110001100000

# Activity quantiser: the rounding offset and shift that turn the summed
# neighbourhood activity into a table row, and the two guess thresholds.
Const 0

Number act_round,        1,0!111
Number act_shift,        1,0!100
Number guess_thr_0,      1,0!11011000
Number guess_thr_1,      1,0!10110

# The neighbourhood magnitude sum below which a pixel counts as quiet.

Number quiet_thr,        1,0!10000

# The level, group and slot ladders: three monotone quantisers over the
# activity and the predicted value, and the dead-zone width per level.

Number level_step_0,     1,0!1
Number level_step_1,     1,0!1
Number level_step_2,     1,0!10
Number level_step_3,     1,0!10
Number level_step_4,     1,0!10
Number level_step_5,     1,0!100
Number level_step_6,     1,0!100
Number level_step_7,     1,0!100

# The selector mixer: nine ternary weights, geometric in ctxw_ratio.  The seed
# is a shift rather than a weight because the mixer's sum is the most
# significant factor of the P1Result index below and the packed fields fill
# exactly that many low bits -- the two have to agree, and the codec checks
# they do at startup.  ctxw_range is 3^9, the number of distinct sums.

Number ctxw_shift,       1,0!101
Number ctxw_ratio,       1,0!11
Const 1

Number ctxw_range,        1,0!100110011100011

Const 0

# Counter bumps, sel==1: the centre cell and its two ladder neighbours.

Number sel1_ctr,         1,0!110
Number sel1_up,          1,0!100
Number sel1_dn,          1,0!11

# Counter bumps, sel!=1: the far cell, the middle cell, the alternate
# context, and their ladder neighbours.

Number selN_far,         1,0!111
Number selN_mid,         1,0!110
Number selN_alt,         1,0!100
Number selN_mid_up,      1,0!100
Number selN_alt_up,      1,0!10
Number selN_mid_dn,      1,0!11
Number selN_alt_dn,      1,0!10

# Counter bumps in update_model: the alternate context, the two ladder
# neighbours of the chosen cell, and the two nudges that follow.

Number bump_alt,         1,0!10001
Number bump_up,          1,0!1011
Number bump_dn,          1,0!1101
Number nudge_up,         1,0!111
Number nudge_dn,         1,0!101

# ---------------------------------------------------------------------
# Context indices.  See the note in bmf-P2.idx.
# ---------------------------------------------------------------------

# The counter context: the selector mixer's sum over the activity level, a
# flag and the quiet bit.  Volume 629856, which is what counters[] holds.

Index P1Result
 ADD %M%ctxw_range: msum
 ADD 2: quiet
 ADD 2: flag
 ADD 8: lvl

# The alternate context: the same mixer read the other way, over five bits of
# the current context.

Index P1Alt
 ADD %M%ctxw_range: msum
 ADD 32: ctx0

# The two halves of the strip context, built into separate tables and added:
# the activity group is the low factor, the predicted-value slot the one above
# it.  Volume 64, which is the low radix of CN's Strip index.

Index P1Low
 ADD 8: slot
 ADD 8: grp
