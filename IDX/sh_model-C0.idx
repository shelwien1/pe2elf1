Number wr1b,   1,1!10010011011010   # the base of wr1's delta, cloned from wr: W0 (wr) and W1 (wr1b + wr1) are separate knobs
Number mw,     1,1!0110110111111
Number K,      1,0!0100100111011111
Number NWk,    1,1!011111000111001100
Number RKinc,  1,1!000101001110001
Number kStep,  1,1!0010111001011100010
Number kMin,   1,1!0101010010000001000000
Number kMax,   1,1!001110000001001

