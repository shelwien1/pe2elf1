# A1 young-cell step schedule (coder0.cpp Counter::C_Update):
# stepMax_eff = stepMax*(1 + AGAx/(1 + age/B)) on the mw (AGAm) and K (AGAk)
# steps and on the u/v ray clip (AGAu, AGAv per axis); AGAx/256, 0 = plain
# limit.  B = AGB/16 updates (64 = 4 updates) for mw and K, AGBuv/16 for u/v.
Number AGAu,   1,0!000001100000
Number AGAv,   1,0!000001100000   # cloned from AGAu (u and v used to share it)
Number AGAm,   1,0!011111101000
Number AGAk,   1,0!000000000001
Number AGB,    1,0!0000011000
Number AGBuv,  1,0!0000011000   # cloned from AGB (u/v used to share it with mw and K)

Const 0

# A2 end-to-end objective: the parameter gradients use
# (1-E2E)*(own error) + E2E*(final error chained to this cell), E2E/256;
# E2E for mw and K, E2Euv for the u/v axes.
Number E2E,    1,0!100000000
Number E2Euv,  1,0!100000000   # cloned from E2E (u/v used to share it with mw and K)
