
Prefix C0
Debug 1

# The knobs of the rejected proposals (AWIND/HBETA/EFISH/ALEAK/SMASS/MKCPL/
# BIASC), the ADAPT_L rates LWw/LWk/LWm and the four grad1_clip knobs G1_*
# used to sit here frozen with '!' -- 28 entries the coder did not read, so
# neither opt.pl nor optv.pl could ever score a change to one.  They are
# deleted; git history has their last values, and the rejections are
# summarized in coder0.cpp's header.

Const 0

# --- cell context: which bits of the last byte, and the bit-tree node,
# select the order-1 cell.  With every bit on this is the o1[256][256]
# array it replaces (255 nodes: the node index starts at 1), simulated
# exactly; the bits are tunable.
Index Cx
 c1: c1, &11111111    # last byte (bits tunable)
 cx: cxt, b&00000000  # bit-tree node: b& merges node bits counted from the leading 1 (0 = keep)

Const 1


Number mwMax,  1,1!111111111111111

Number G3_m,   1,0!1000000000000000000

Const 0

Number P0,     1,1!100110100001101
Number P1,     1,0!01100000010001

Const 0

