
Prefix GL
Debug 1

# ---------------------------------------------------------------------
# Limits and scales the whole codec shares.
# ---------------------------------------------------------------------

# Structural: array bounds and wire-format masks.
Const 1

Number max_width,        1,0!1111111111111111
Number no_symbol,        1,0!10000000000000
Number model_table_bytes,  1,0!1111111000000000000
Number bank_mirror_mask,  1,0!111111111110000
Number p2_row_pad,       1,0!11101010

# The NLMS weight box, the rescale point of the P2 frequency table, the
# third context table's occupancy limit, and how much worse than the
# fitted blend a degenerate one may be and still win (a fraction of the
# fitted cost, capped).
Const 0

Number weight_min_neg,   1,0!1000000
Number weight_max,       1,0!10111111
Number p2_freq_rescale_total,  1,0!111010000000000
Number ctx_id3_limit,    1,0!1101000000000000
Number slack_shift,      1,0!111
Number slack_max,        1,0!100000000000000

# The symbol lists' rescale and escape schedule: the seed weight's shift, the
# count above which a rescale is forced regardless of the schedule, the
# occupancy ratio below which halving carries a rounding bias, the escape
# weight's floor, and the kick it takes when the list outgrows that floor.

Number seed_shift,           1,0!101
Number rescale_force,        1,0!11111011
Number rescale_bias_ratio,   1,0!10100
Number escape_floor,         1,0!100000000
Number escape_kick,          1,0!1111

# Blending a frequency record from a coarser one: how much of the coarse
# record's shape is mixed in (out of its own total), and the factor the
# alphabet level is scaled by when it is.

Number blend_share,          1,0!10101
Number blend_lvl_scale,      1,0!1000
