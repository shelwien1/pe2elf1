+struct Counter {
+  word state; 
+  const uint P() const { return pp[state]; } //FSM[state].pp; }
+  void Update( uint bit ) { 
+//    state = FSM[state].s[bit]; 
+    uint delta = ((byte*)&FSM[state])-((byte*)&FSM[0]);
+    byte* __restrict p = (byte*)&FSM[0].s[bit];
+    p += delta;
+    state = (word&)p[0];
+  }
+  void Update( uint _state, uint bit ) { 
+//    state = FSM[state].s[bit]; 
+    uint delta = ((byte*)&FSM[_state])-((byte*)&FSM[0]);
+    byte* __restrict p = (byte*)&FSM[0].s[bit];
+    p += delta;
+    state = (word&)p[0];
+  }
+
+  // Probe only: load the whole 4-byte FSM entry and select s[bit], instead of
+  // building the address out of bit. One load, no address dependency on bit.
+  void Update2( uint _state, uint bit ) {
+    uint pair = *(const uint*)&FSM[_state];
+    state = word( bit ? (pair>>16) : (pair&0xFFFF) );
+  }
+};
