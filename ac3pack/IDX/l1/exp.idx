#  ac3pack's exp family at level -1: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l1/exp_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  An exponent's delta (a tree of four nodes), against the last block's exponents
#  there, the partner channel's, and the deltas before.
#  (Cut from level -9: four of its counters (b, c, h, k as a-d), mixer 1 and the mantissa plane.)

Prefix A1_exp
Debug 1
Const 0

Index a
 a_pd: pd, 1!111111111
 a_d1: d1, 1!11111
 a_es: es, 1!111

Index b
 b_pd: pd, 1!111111111
 b_po: po, 1!010111101
 b_es: es, 1!111

Index c
 c_pd: pd, 1!111111111
 c_pl: pl, 1!11111
 c_d1: d1, 1!11111

Index d
 d_ht: ht, 1!1111111
 d_pd: pd, 1!111111111
 d_po: po, 1!011110010

Index m
 m_es: es, 1!000
 m_cc: cc, 1!111

Index t

Index n

Index g
#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!01001010
Number mwA, 1, 0!00000100
Number rB, 1, 0!11111110
Number mwB, 1, 0!00100101
Number rC, 1, 0!11111111
Number mwC, 1, 0!00000100
Number rD, 1, 0!11111111
Number mwD, 1, 0!00000100
Number lr, 1, 0!01111
Number mb, 1, 0!00110011
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
