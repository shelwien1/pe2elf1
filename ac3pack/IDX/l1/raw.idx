#  ac3pack's raw family at level -1: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l1/raw_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  Bytes kept as bytes and the raw fields (addbsi, mixdata, blkstrtinfo, skip
#  fields, the bits after the last block), a bit at a time by its place in the byte's binary
#  tree (nodes 1-255).
#  (Cut from level -9: four of its counters (b, c, d, k as a-d), mixer 1 and the mantissa plane.)

Prefix A1_raw
Debug 1
Const 0

Index a
 a_code: code, 1!111111
 a_c1: c1, &11111111

Index b
 b_code: code, 1!111111
 b_c1: c1, &11111111
 b_c2: c2, &11110000

Index c
 c_code: code, 1!111111
 c_cl: cl, 1!1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111

Index d
 d_c1: c1, &11111111
 d_c2: c2, &11111111

Index m
 m_code: code, 1!111111

Index t

Index n

Index g
#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11111111
Number mwA, 1, 0!00000100
Number rB, 1, 0!11111111
Number mwB, 1, 0!00000100
Number rC, 1, 0!11111111
Number mwC, 1, 0!00000100
Number rD, 1, 0!11111111
Number mwD, 1, 0!00000100
Number lr, 1, 0!01111
Number mb, 1, 0!00110011
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10100
! Number hB, 1, 0!10100
! Number hC, 1, 0!10100
! Number hD, 1, 0!10100
! Number hM, 1, 0!10100
! Number hT, 1, 0!10100
! Number hN, 1, 0!10100
