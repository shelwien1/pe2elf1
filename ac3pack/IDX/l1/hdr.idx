#  ac3pack's hdr family at level -1: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l1/hdr_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The frame's header (syncinfo, bsi, audfrm) and trailer, and the container's
#  kinds and lengths, each field its own values (fld), against its last values.
#  (Cut from level -9: four of its counters (a, b, c, k as a-d), mixer 1 and the mantissa plane.)

Prefix A1_hdr
Debug 1
Const 0

Index a
 a_fld: fld, &1000000

Index b
 b_fld: fld, &1111111
 b_lv: lv, &011110

Index c
 c_fld: fld, &1100000
 c_lv: lv, &011110
 c_l2: l2, 1!00

Index d
 d_fld: fld, &1111111
 d_lv: lv, &111101
 d_pos: pos, 1!1100011111100000000000000000000
 d_l2: l2, 1!00

Index m
 m_fld: fld, &1111100

Index t
 t_fld: fld, &0111100

Index n
 n_fld: fld, &1111111

Index g
 g_fld: fld, &1111111
#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!00001100
Number rB, 1, 0!11111111
Number mwB, 1, 0!00010100
Number rC, 1, 0!11111110
Number mwC, 1, 0!00001000
Number rD, 1, 0!11111111
Number mwD, 1, 0!00100000
Number lr, 1, 0!01110
Number mb, 1, 0!10000001
Number rT, 1, 0!10000000
Number mwT, 1, 0!00011111
Number mt, 1, 0!110
Number lrm, 1, 0!11111
Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!01100000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
