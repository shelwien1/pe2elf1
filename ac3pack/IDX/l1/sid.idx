#  ac3pack's sid family at level -1: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l1/sid_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  An audio block's side information, each field its own values (fld), against
#  the last block's value at its place and its place before in the block.
#  (Cut from level -9: four of its counters (a, b, h, d as a-d), mixer 1 and the mantissa plane.)

Prefix A1_sid
Debug 1
Const 0

Index a
 a_fld: fld, &000000

Index b
 b_fld: fld, &101111
 b_lv: lv, &111111

Index c
 c_fld: fld, &111011
 c_lv: lv, &011111
 c_pr: pr, 1!11
 c_lb: lb, 1!11

Index d
 d_fld: fld, &111111
 d_pq: pq, &111111
 d_lb: lb, 1!01

Index m
 m_fld: fld, &110111

Index t
 t_fld: fld, &111011

Index n
 n_fld: fld, &111111

Index g
 g_fld: fld, &111111
#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11111101
Number mwA, 1, 0!00100000
Number rB, 1, 0!11111111
Number mwB, 1, 0!00000100
Number rC, 1, 0!11111110
Number mwC, 1, 0!00001001
Number rD, 1, 0!11111111
Number mwD, 1, 0!00000000
Number lr, 1, 0!01111
Number mb, 1, 0!01100000
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
Number lrm, 1, 0!11111
Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!10111100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
