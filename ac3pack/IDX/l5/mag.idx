#  ac3pack's mag family at level -5: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l5/mag_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A mantissa's magnitude (bap 1-5: above k?, 6-15: its length, then its bits) and its sign, against
#  the estimates of its neighbours: the bins before, the last block's, the partner channel's; its
#  tile (whose largest coefficient set its exponent) and a tonal predictor's coefficient.
#  (Cut from level -9: its ten counters, mixer 1 and the mantissa plane.)

Prefix A5_mag
Debug 1
Const 0

Index a
 a_bap: bap, 1!111111111111111
 a_gr: gr, 1!111
 a_tx: tx, 1!1001
 a_tb: tb, 1!10
 a_tc: tc, 1!011
 a_tr: tr, 1!1101111

Index b
 b_bap: bap, 1!000000111000000
 b_e1: e1, 1!11111111111111111111111
 b_ts: ts, 1!11
 b_et: et, 1!00100001000100100100010
 b_tq: tq, 1!0011

Index c
 c_bap: bap, 1!111111111111111
 c_ep: ep, 1!11111111111111111111111
 c_sp: sp, 1!11

Index d
 d_bap: bap, 1!111111111111111
 d_e1: e1, 1!1101010101010101
 d_e2: e2, 1!1101010101010101
 d_s1: s1, 1!10
 d_s2: s2, 1!01

Index e
 e_bap: bap, 1!111111111111111
 e_eo: eo, 1!11111111111111111111111
 e_so: so, 1!11
 e_rm: rm, 1!11

Index h
 h_bap: bap, 1!111111111111111
 h_sm: sm, 1!11111111111111111111111
 h_m1: m1, 1!11111111111111111
 h_ts: ts, 1!11
 h_sp: sp, 1!11

Index i
 i_bap: bap, 1!111111111111111
 i_dx: dx, 1!111111111
 i_dn: dn, 1!111111111
 i_gs: gs, 1!111
 i_tb: tb, 1!01

Index j
 j_bap: bap, 1!010000101000111
 j_ex: ex, 1!001001001001001001001
 j_bin: bin, 1!010101001001001001001000100010001000100010001
 j_cc: cc, 1!101

Index k
 k_bap: bap, 1!111111111111111
 k_e1: e1, 1!1101010101010101
 k_ew: ew, 1!1101010101010101
 k_ow: ow, 1!1101010101010101
 k_s1: s1, 1!01
 k_sp: sp, 1!01
 k_so: so, 1!11
 k_rm: rm, 1!01

Index l
 l_bap: bap, 1!111111111111111
 l_nz: nz, 1!1111
 l_bs: bs, 1!1
 l_gr: gr, 1!111
 l_gs: gs, 1!111
 l_s1: s1, 1!11
 l_s2: s2, 1!11

Index m
 m_bap: bap, 1!111111111111111
 m_tx: tx, 1!0001
 m_tb: tb, 1!01
 m_tr: tr, 1!0000000
 m_ts: ts, 1!11

Index t
 t_bap: bap, 1!111111111111111

Index n
#  Frozen, as lrm and mbm: the mantissa mixer they are for mixes only by a hint, and nothing
#  gives this family one.
! n_bap: bap, 1!111111111111111

Index g
#  (No sign counters: the sign is a decision node, MN_SIGN.)
#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11111110
Number mwA, 1, 0!00000000
Number rB, 1, 0!11111111
Number mwB, 1, 0!00000100
Number rC, 1, 0!11001101
Number mwC, 1, 0!01001111
Number rD, 1, 0!11101001
Number mwD, 1, 0!01000001
Number rE, 1, 0!11111110
Number mwE, 1, 0!00000100
Number rH, 1, 0!11111101
Number mwH, 1, 0!00111110
Number rI, 1, 0!11111111
Number mwI, 1, 0!00000100
Number rJ, 1, 0!11111111
Number mwJ, 1, 0!00000000
Number rK, 1, 0!11111111
Number mwK, 1, 0!01000000
Number rL, 1, 0!11110011
Number mwL, 1, 0!10000000
Number lr, 1, 0!01111
Number mb, 1, 0!00100011
Number rT, 1, 0!10000111
Number mwT, 1, 0!00000000
Number mt, 1, 0!110
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
