#  ac3pack's mag family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/mag_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A mantissa's magnitude (bap 1-5: above k?, 6-15: its length, then its bits) and its sign, against
#  the estimates of its neighbours: the bins before, the last block's, the partner channel's.

Prefix A9_mag
Debug 1
Const 0

Index a
 a_bap: bap, 1!111111111111111
 a_gr: gr, 1!111

Index b
 b_bap: bap, 1!000000111000000
 b_e1: e1, 1!11111111111111111111111

Index c
 c_bap: bap, 1!111111111111111
 c_ep: ep, 1!11111111111111111111111

Index d
 d_bap: bap, 1!111111111111111
 d_e1: e1, 1!1101010101010101
 d_e2: e2, 1!1101010101010101

Index e
 e_bap: bap, 1!111111111111111
 e_eo: eo, 1!11111111111111111111111

Index h
 h_bap: bap, 1!111111111111111
 h_sm: sm, 1!11111111111111111111111
 h_m1: m1, 1!11111111111111111

Index i
 i_bap: bap, 1!111111111111111
 i_dx: dx, 1!111111111
 i_dn: dn, 1!111111111
 i_gs: gs, 1!111

Index j
 j_bap: bap, 1!010000101000111
 j_ex: ex, 1!001001001001001001001
 j_bin: bin, 1!010101001001001001001000100010001000100010001
 j_cc: cc, 1!101

Index k
 k_bap: bap, 1!111111111111111
 k_e1: e1, 1!1101010101010101
 k_ew: ew, 1!1101010101010101
 k_ow: ow, 1!1101010101010101

Index l
 l_bap: bap, 1!111111111111111
 l_nz: nz, 1!1111
 l_bs: bs, 1!1
 l_gr: gr, 1!111
 l_gs: gs, 1!111

Index s
 s_bap: bap, 1!010000001001001
 s_e1: e1, 1!1101010101010101

Index f
 f_bap: bap, 1!111111111111111
 f_ep: ep, 1!1101010101010101
 f_eo: eo, 1!11000100010101

Index m
 m_bap: bap, 1!111111111111111

Index w
 w_nz: nz, 1!1000

Index t
 t_bap: bap, 1!111111111111111

Index n
 n_bap: bap, 1!111111111111111

Index g
 g_s1: s1, 1!11
 g_sp: sp, 1!11
 g_so: so, 1!11

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11111111
Number mwA, 1, 0!01001100
Number rB, 1, 0!11111100
Number mwB, 1, 0!00000100
Number rC, 1, 0!11111111
Number mwC, 1, 0!00000100
Number rD, 1, 0!11111111
Number mwD, 1, 0!00000100
Number rE, 1, 0!11111111
Number mwE, 1, 0!00000100
Number rH, 1, 0!11111111
Number mwH, 1, 0!00110011
Number rI, 1, 0!11111111
Number mwI, 1, 0!00000100
Number rJ, 1, 0!11111111
Number mwJ, 1, 0!00000100
Number rK, 1, 0!11111111
Number mwK, 1, 0!00000100
Number rL, 1, 0!11111111
Number mwL, 1, 0!10000000
Number lr, 1, 0!01101
Number mb, 1, 0!00110011
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!0010001
Number qf, 1, 3!0011110
Number bw, 1, 0!01100
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000010
Number mt, 1, 0!110
Number lrm, 1, 0!11111
Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
