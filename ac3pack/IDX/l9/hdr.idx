#  ac3pack's hdr family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/hdr_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The frame's header (syncinfo, bsi, audfrm) and trailer, and the container's
#  kinds and lengths, each field its own values (fld), against its last values.

Prefix A9_hdr
Debug 1
Const 0

Index a
 a_fld: fld, &1000000

Index b
 b_fld: fld, &1111111
 b_lv: lv, &011110

Index c
 c_fld: fld, &1100000
 c_lv: lv, &011110
 c_l2: l2, 1!00

Index d
 d_fld: fld, &1111111
 d_pos: pos, 1!1110101001010000000000000000000

Index e
 e_fld: fld, &1111111
 e_st: st, 1!11
 e_nch: nch, 1!111

Index h
 h_fld: fld, &1111111
 h_lv: lv, &011111
 h_pos: pos, 1!1110100

Index i
 i_fld: fld, &1101100
 i_sk: sk, 1!1111
 i_lv: lv, &011111

Index j
 j_fld: fld, &0111111
 j_l2: l2, 1!10
 j_st: st, 1!01

Index k
 k_fld: fld, &1111111
 k_lv: lv, &111101
 k_pos: pos, 1!1100011111100000000000000000000
 k_l2: l2, 1!00

Index l
 l_fld: fld, &0110101
 l_nch: nch, 1!111
 l_sk: sk, 1!0000
 l_l2: l2, 1!01

Index s
 s_fld: fld, &1101111
 s_l2: l2, 1!11

Index f
 f_fld: fld, &1111111

Index m
 m_fld: fld, &1111100

Index w
 w_l2: l2, 1!10
 w_st: st, 1!11

Index t
 t_fld: fld, &0111100

Index n
 n_fld: fld, &1111111

Index g
 g_fld: fld, &1111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!00001100
Number rB, 1, 0!11111111
Number mwB, 1, 0!00010100
Number rC, 1, 0!11111110
Number mwC, 1, 0!00001000
Number rD, 1, 0!11111111
Number mwD, 1, 0!00000101
Number rE, 1, 0!10100100
Number mwE, 1, 0!00000000
Number rH, 1, 0!10111111
Number mwH, 1, 0!00000100
Number rI, 1, 0!11011111
Number mwI, 1, 0!00000100
Number rJ, 1, 0!11111100
Number mwJ, 1, 0!00000001
Number rK, 1, 0!11111111
Number mwK, 1, 0!00100000
Number rL, 1, 0!11111011
Number mwL, 1, 0!00000100
Number lr, 1, 0!01110
Number mb, 1, 0!10000001
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!0101111
Number qf, 1, 3!0010001
Number bw, 1, 0!01000
Number rT, 1, 0!10000000
Number mwT, 1, 0!00011111
Number mt, 1, 0!110
Number lrm, 1, 0!11111
Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!01100000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
