#  ac3pack's aht family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/aht_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  AHT's data: the vector indices, the gains, the gain adaptive mantissas and the
#  escapes' large ones.

Prefix A9_aht
Debug 1
Const 0

Index a
 a_kd: kd, 1!1111
 a_hb: hb, 1!0011101000111111111

Index b
 b_kd: kd, 1!1111
 b_hb: hb, 1!1111111111111111111
 b_lg: lg, 1!11
 b_bk: bk, 1!11111

Index c
 c_kd: kd, 1!1111
 c_hb: hb, 1!1111111111111111111
 c_q1: q1, 1!11111111111111111111111

Index d
 d_kd: kd, 1!1111
 d_hb: hb, 1!1111111111111111111
 d_q0: q0, 1!10000101001101111101110

Index e
 e_kd: kd, 1!1111
 e_hb: hb, 1!1111111111111111111
 e_q1: q1, 1!1101010101010101
 e_q2: q2, 1!1101010101010101

Index h
 h_kd: kd, 1!1111
 h_gm: gm, 1!111
 h_pg: pg, 1!111
 h_hb: hb, 1!1111111111111111111

Index i
 i_kd: kd, 1!1111
 i_ex: ex, 1!001001001001001001001
 i_bk: bk, 1!11111

Index j
 j_kd: kd, 1!1111
 j_bin: bin, 1!010101001001001001001000100010001000100010001
 j_hb: hb, 1!1111111111111111111

Index k
 k_kd: kd, 1!1111
 k_bk: bk, 1!11111
 k_qa: qa, 1!11111111111111111111111
 k_lg: lg, 1!11

Index l
 l_kd: kd, 1!1111
 l_hb: hb, 1!1111111111111111111
 l_bk: bk, 1!11111
 l_pm: pm, 1!111111111
 l_pb: pb, 1!111111111

Index s
 s_kd: kd, 1!1111
 s_hb: hb, 1!0100010010101000100

Index f
 f_kd: kd, 1!1111
 f_bk: bk, 1!11111
 f_q1: q1, 1!1101010101010101

Index m
 m_kd: kd, 1!1111
 m_hb: hb, 1!1111111111111111111

Index w
 w_kd: kd, 1!0000

Index t
 t_kd: kd, 1!1111
 t_hb: hb, 1!1111111111111111111

Index n
 n_kd: kd, 1!1111

Index g
 g_hb: hb, 1!1111111111111111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11111111
Number mwA, 1, 0!00000100
Number rB, 1, 0!11111111
Number mwB, 1, 0!00000100
Number rC, 1, 0!11111111
Number mwC, 1, 0!00000100
Number rD, 1, 0!11111111
Number mwD, 1, 0!00000100
Number rE, 1, 0!11111101
Number mwE, 1, 0!00000100
Number rH, 1, 0!11111111
Number mwH, 1, 0!00000100
Number rI, 1, 0!11111111
Number mwI, 1, 0!11001100
Number rJ, 1, 0!11111111
Number mwJ, 1, 0!00000100
Number rK, 1, 0!11111111
Number mwK, 1, 0!00000100
Number rL, 1, 0!11111111
Number mwL, 1, 0!00000100
Number lr, 1, 0!01111
Number mb, 1, 0!00110011
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!0111101
Number qf, 1, 3!0011110
Number bw, 1, 0!01100
Number rT, 1, 0!11111111
Number mwT, 1, 0!00000010
Number mt, 1, 0!110
Number lrm, 1, 0!11111
Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
