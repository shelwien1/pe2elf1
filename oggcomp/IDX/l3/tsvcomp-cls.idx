#  tsvcomp's cls model at level -3: its context indices and its tunable
#  parameters.
#
#  One module per family -- IDX/IDX-FORMAT.md is the specification, and sec.7
#  is why there are six of these rather than one file.  Every name here is
#  relative to the family: the prefix below puts the level and `cls_` back, so
#  the index `a` is L3_cls_a and the threshold `a_band` is L3_cls_a_band,
#  which is what IDX/opt.pl finds in a tuning build of the level and what an
#  export.!!! is keyed by.
#
#  ../../mk.sh regenerates MOD/l3/tsvcomp-cls_h.inc and _p.inc from this file
#  and tsvcomp-cls.inc; ../../mk.sh check 3 proves the tuning and shipping
#  builds of the level code identically.
#
#  A factor whose pattern is all zeroes contributes one bucket and costs
#  nothing, which is how a variable that was tried and did not pay stays
#  visible -- and how the optimizer is given somewhere to go.

Prefix L3_cls
Debug 1
Const 0
#  ---------------------------------------------------------------------------
#  Residue classes: the class before it (-15.13% on its own, measured in
#  TSVTRANS.md) and the class the same partition had one packet ago.
#
#  As in tsvcomp-flr.idx, every line here was frozen and both APMs were empty.
#  The partition, the same partition last packet and the next one are worth
#  429 bytes of class over four files.  Unfrozen now.

Index a
  a_rno:  rno,   1!1
  a_band: band,  1!111110111100001
  a_prev: prev,  1!0111111
  a_t1:   t1,    1!0000010
  a_blk:  blk,   1!1
  a_tn:   tn,    1!000
  a_prev2: prev2, 1!110
  a_pq:   pq,    1!00000000000000000000010000000000

Index b
  b_rno:  rno,   1!0
  b_band: band,  1!110101111100010
  b_prev: prev,  1!100111010110001
  b_t1:   t1,    1!111
  b_blk:  blk,   1!1
  b_tn:   tn,    1!100
  b_prev2: prev2, 1!001
  b_pq:   pq,    1!00000000000100000000000000000010

Index c
  c_band: band,  1!011
  c_prev: prev,  1!101
  c_t1:   t1,    1!111
  c_tn:   tn,    1!001
  c_prev2: prev2, 1!000
  c_pq:   pq,    1!00000000000000001010000000000000

Index d
  d_band: band,  1!000
  d_prev: prev,  1!111
  d_t1:   t1,    1!101
  d_tn:   tn,    1!001
  d_prev2: prev2, 1!000
  d_pq:   pq,    1!00100010010000000111101110000000

Index s
  s_band: band, 1!010
  s_prev: prev,  1!000
  s_t1: t1, 1!000
  s_tn: tn, 1!011
  s_prev2: prev2, 1!101
  s_pq:   pq,    1!00001111100001000110000000100001

Index f
  f_band: band, 1!000
  f_prev: prev,  1!101
  f_t1: t1, 1!110
  f_tn: tn, 1!000
  f_prev2: prev2, 1!000
  f_pq:   pq,    1!00000010001101101001100110011110

Index m
  m_band: band,  1!001
  m_prev: prev,  1!000
  m_t1:   t1,    1!0
  m_tn:   tn,    1!101
  m_prev2: prev2, 1!000
  m_pq:   pq,    1!00000000010000100100000000000000

Index t
  t_band: band,  1!100
  t_prev: prev,  1!011
  t_t1:   t1,    1!101
  t_tn:   tn,    1!101
  t_prev2: prev2, 1!000
  t_pq:   pq,    1!00000000000001100000000000000000

Number rA, 1, 0!10001011
Number rB, 1, 0!01011110
Number rC, 1, 0!00100010
Number rD, 1, 0!00000000
Number rT, 1, 0!00000000
Number rS1, 1, 0!10101
Number rS2, 1, 0!00101
Number lr, 1, 0!11111
Number lrm, 1, 0!11111
Number mbm, 1, 0!11111101
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00100000
Number mwD, 1, 0!10010000
Number mwT, 1, 0!01111011
Number bw, 1, 0!01011
Number qs, 1, 3!1001011
Number qf, 1, 3!0111110
Number mb, 1, 0!00010010


Index n
  n_band: band,  1!111
  n_prev: prev,  1!000
  n_t1:   t1,    1!000
  n_tn:   tn,    1!001
  n_prev2: prev2, 1!000
  n_pq:   pq,    1!00000000001000000001001000111110

Index g
#  No factors: fam_cls codes a class through `code`, which never reaches a
#  sign, so there is no sign counter here to give a context to.

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows
#  is direct, one that does not is hashed into 2^h rows and contexts share
#  them (HASHTABLES.md).  31 is "never hashed".  Frozen: left live these
#  only grow, since a bigger table is never worse by the objective alone.
! Number hA, 1, 0!11111
! Number hB, 1, 0!11111
! Number hD, 1, 0!11111
! Number hS, 1, 0!11111
! Number hF, 1, 0!11111
! Number hM, 1, 0!11111
! Number hT, 1, 0!11111
! Number hN, 1, 0!11111
