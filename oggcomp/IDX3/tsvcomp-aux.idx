#  tsvcomp's aux model: its context indices and its tunable parameters.
#
#  One module per family -- IDX/IDX-FORMAT.md is the specification, and sec.7
#  is why there are six of these rather than one file.  Every name here is
#  relative to the family: the prefix below puts `aux_` back, so the index `a`
#  is TC_aux_a and the threshold `a_band` is TC_aux_a_band, which is what
#  IDX/opt.pl finds in the executable and what an export.!!! is keyed by.
#
#  ../mk.sh regenerates MOD/tsvcomp-aux_h.inc and MOD/tsvcomp-aux_p.inc from
#  this file and tsvcomp-aux.inc; ./mk.sh check proves the tuning and shipping
#  builds of all six code identically.
#
#  A factor whose pattern is all zeroes contributes one bucket and costs
#  nothing, which is how a variable that was tried and did not pay stays
#  visible -- and how the optimizer is given somewhere to go.

Prefix TC_aux
Debug 1
Const 0
#  ---------------------------------------------------------------------------
#  Everything the page and packet headers hold, one field id apart.  Each field
#  is a few thousand records at most, so what these want is separation, not
#  resolution: `fld` is a dense factor and the rest is the field's own recent
#  history.

Index a
 a_fld: fld, 1!101011100111111000
! a_p1:   p1,    1!100000001000111
! a_p2:   p2,    1!1000001

Index b
 b_fld: fld, 1!011001001000110000
! b_p1:   p1,    1!000
! b_p2:   p2,    1!000

Index c
 c_fld: fld, 1!000000100010000000

Index d
 d_fld: fld, 1!000100010001010000

Index s
 s_fld: fld, 1!111111111111111111

Index f
 f_fld: fld, 1!111111111111111111

Index m
 m_fld: fld, 1!011000001110101000

Index t
 t_fld: fld, 1!000111000011010111

Number rA, 1, 0!10001100
Number rB, 1, 0!00000000
Number rC, 1, 0!00000000
Number rD, 1, 0!00000000
Number rT, 1, 0!00001101
Number rG, 1, 0!01101110
Number rS1, 1, 0!10000
Number rS2, 1, 0!00111
Number lr, 1, 0!11011
Number lrm, 1, 0!11111
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00010000
Number mwC, 1, 0!01000010
Number mwD, 1, 0!01000001
Number mwT, 1, 0!00000010
Number mwG, 1, 0!00000000
Number bw, 1, 0!01000
Number qs, 1, 3!0011100
Number qf, 1, 3!1000001
Number mb, 1, 0!01000000


Index n
 n_fld: fld, 1!111111111111111111

Index g
 g_p1:   p1,    1!000000100010110
 g_p2: p2, 1!0000011100001

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows
#  is direct, one that does not is hashed into 2^h rows and contexts share
#  them (HASHTABLES.md).  31 is "never hashed".  Frozen: left live these
#  only grow, since a bigger table is never worse by the objective alone.
! Number hA, 1, 0!11111
! Number hB, 1, 0!11111
! Number hD, 1, 0!11111
! Number hS, 1, 0!11111
! Number hF, 1, 0!11111
! Number hM, 1, 0!11111
! Number hT, 1, 0!11111
! Number hN, 1, 0!11111
