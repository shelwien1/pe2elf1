#  tsvcomp's cls model: its context indices and its tunable parameters.
#
#  One module per family -- IDX/IDX-FORMAT.md is the specification, and sec.7
#  is why there are six of these rather than one file.  Every name here is
#  relative to the family: the prefix below puts `cls_` back, so the index `a`
#  is TC_cls_a and the threshold `a_band` is TC_cls_a_band, which is what
#  IDX/opt.pl finds in the executable and what an export.!!! is keyed by.
#
#  ../mk.sh regenerates MOD/tsvcomp-cls_h.inc and MOD/tsvcomp-cls_p.inc from
#  this file and tsvcomp-cls.inc; ./mk.sh check proves the tuning and shipping
#  builds of all six code identically.
#
#  A factor whose pattern is all zeroes contributes one bucket and costs
#  nothing, which is how a variable that was tried and did not pay stays
#  visible -- and how the optimizer is given somewhere to go.

Prefix TC_cls
Debug 1
Const 0
#  ---------------------------------------------------------------------------
#  Residue classes: the class before it (-15.13% on its own, measured in
#  TSVTRANS.md) and the class the same partition had one packet ago.
#
#  As in tsvcomp-flr.idx, every line here was frozen and both APMs were empty.
#  The partition, the same partition last packet and the next one are worth
#  429 bytes of class over four files.  Unfrozen now.

Index a
  a_rno:  rno,   1!1
  a_band: band,  1!000110111000000
  a_prev: prev,  1!0101011
  a_t1:   t1,    1!0001010
  a_blk:  blk,   1!1
  a_tn:   tn,    1!000
  a_prev2: prev2, 1!010
  a_pq:   pq,    1!00000000000000000000000000000010

Index b
  b_rno:  rno,   1!0
  b_band: band,  1!100010001000000
  b_prev: prev,  1!010011000000000
  b_t1:   t1,    1!000
  b_blk:  blk,   1!1
  b_tn:   tn,    1!000
  b_prev2: prev2, 1!000
  b_pq:   pq,    1!00000000000001000100000010010101

Index c
  c_band: band,  1!001
  c_prev: prev,  1!000
  c_t1:   t1,    1!111
  c_tn:   tn,    1!011
  c_prev2: prev2, 1!000
  c_pq:   pq,    1!00000000000000000000000001001000

Index d
  d_band: band,  1!111
  d_prev: prev,  1!101
  d_t1:   t1,    1!100
  d_tn:   tn,    1!000
  d_prev2: prev2, 1!000
  d_pq:   pq,    1!00000000001000000100100000000101

Index s
  s_band: band, 1!100
  s_prev: prev,  1!000
  s_t1: t1, 1!011
  s_tn: tn, 1!001
  s_prev2: prev2, 1!101
  s_pq:   pq,    1!00011000100010011100110011101000

Index f
  f_band: band, 1!000
  f_prev: prev,  1!000
  f_t1: t1, 1!000
  f_tn: tn, 1!000
  f_prev2: prev2, 1!000
  f_pq:   pq,    1!00000000000000000000000000000000

Index m
  m_band: band,  1!001
  m_prev: prev,  1!101
  m_t1:   t1,    1!0
  m_tn:   tn,    1!100
  m_prev2: prev2, 1!000
  m_pq:   pq,    1!10000000000011100001110100100100

Index t
  t_band: band,  1!100
  t_prev: prev,  1!010
  t_t1:   t1,    1!000
  t_tn:   tn,    1!101
  t_prev2: prev2, 1!000
  t_pq:   pq,    1!00000000000000000001000000000000

Number rA, 1, 0!01101010
Number rB, 1, 0!00010100
Number rC, 1, 0!00010001
Number rD, 1, 0!00000000
Number rT, 1, 0!00000000
Number rS1, 1, 0!10100
Number rS2, 1, 0!00101
Number lr, 1, 0!11000
Number lrm, 1, 0!11111
Number mbm, 1, 0!11111001
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000001
Number mwD, 1, 0!00100111
Number mwT, 1, 0!10000010
Number bw, 1, 0!10000
Number qs, 1, 3!1000101
Number qf, 1, 3!0111110
Number mb, 1, 0!00100100


Index n
  n_band: band,  1!111
  n_prev: prev,  1!000
  n_t1:   t1,    1!101
  n_tn:   tn,    1!101
  n_prev2: prev2, 1!000
  n_pq:   pq,    1!00000000000000000000100010010111

Index g
#  No factors: fam_cls codes a class through `code`, which never reaches a
#  sign, so there is no sign counter here to give a context to.

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows
#  is direct, one that does not is hashed into 2^h rows and contexts share
#  them (HASHTABLES.md).  31 is "never hashed".  Frozen: left live these
#  only grow, since a bigger table is never worse by the objective alone.
! Number hA, 1, 0!11111
! Number hB, 1, 0!11111
! Number hD, 1, 0!11111
! Number hS, 1, 0!11111
! Number hF, 1, 0!11111
! Number hM, 1, 0!11111
! Number hT, 1, 0!11111
! Number hN, 1, 0!11111
