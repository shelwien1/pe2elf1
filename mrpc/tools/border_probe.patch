+  int dcv[MAXC];   // per-component mean of org, for the decay rules
+  // The value of a border cell `j` away from an edge whose pixel is `e`.
+  // Rules 8..11 are the "not a fixed copy" family: 8 zero, 9 neutral grey,
+  // 10 decay to grey, 11 decay to the plane's own mean.
+  INLINE int BVal(int e, int j, uint k, int span) const {
+    switch( g_border ) {
+      case 8:  return 0;
+      case 9:  return 128;
+      case 10: return e+(128-e)*j/(span+1);
+      case 11: return e+(dcv[k]-e)*j/(span+1);
+      default: return e;
+    }
+  }
+  // and of its error.  13 says the region off the edge is smooth, 14 half
+  // as active as the edge, 15 twice.
+  INLINE int BErr(int q, int j, int span) const {
+    switch( g_border ) {
+      case 13: return 0;
+      case 14: return q-q*j/(span+1);
+      case 15: return 2*q;
+      default: return q;
+    }
+  }
