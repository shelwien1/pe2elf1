 // -------------------------------------------------------------
+// A learned correction beside the transmitted predictor
+// -------------------------------------------------------------
+// The transmitted predictor is a per-(class, component) linear filter,
+// fitted by weighted least squares over the whole image and quantised to
+// six fractional bits.  It is optimal on average and fixed everywhere,
+// which is exactly the shape of thing a per-pixel learner complements:
+// the filter carries the structure, the learner carries what is left of
+// it locally.
+//
+// The features are the signed residuals at the nearest causal neighbours
+// -- what the transmitted filter has just been getting wrong around here.
+// Least squares makes the residual orthogonal to the *taps*, so it is
+// already unbiased against them; it does not make it orthogonal to the
+// neighbouring residuals, because those depend on pixels outside this
+// pixel's tap set, and it is global, so locally the residual stays
+// correlated even where it is globally orthogonal.  That correlation is
+// what this picks up.
+//
+// All integer: this runs on both sides of the stream and has to give the
+// same answer on both, which floating point compiled twice does not
+// reliably do.
+#ifndef NLMS_N
+#define NLMS_N        8  // taps of the correction
+#endif
+#ifndef NLMS_RATE
+#define NLMS_RATE     2  // log2 of the reciprocal step size
+#endif
+static const int NLMS_FLOOR = 1024;      // damps the normalisation
+static const int NLMS_WMAX = 4<<16;      // 16.16, and +-4 is plenty
+
+struct NlmsMod {
+  int* w;   // [ctx][NLMS_N], 16.16
+  int nctx;
+  int nt_;
+
+  void Init(int n, int taps) {
+    nctx = n;
+    nt_ = taps;
+    w = new int[size_t(n)*NLMS_N];
+    Reset();
+  }
+
+  void Reset() {
+    if( w )
+      for( size_t i = 0; i<size_t(nctx)*NLMS_N; i++ )
+        w[i] = 0;
+  }
+
+  void Quit() {
+    delete[] w;
+    w = 0;
+  }
+
+  // the correction, in the predictor's own fixed point
+  INLINE int Corr(int ctx, const int* d) const {
+    const int* wc = w+size_t(ctx)*NLMS_N;
+    qword acc = 0;
+    long long a = 0;
+    for( int i = 0; i<nt_; i++ )
+      a += (long long) wc[i]*d[i];
+    (void) acc;
+    return int(a>>(16-COEF_PREC));
+  }
+
+  // one normalised least-mean-squares step.  err is in the predictor's
+  // fixed point, so the shift that brings it back to pixel units is
+  // folded into the step.
+  INLINE void Learn(int ctx, const int* d, int err) {
+    int* wc = w+size_t(ctx)*NLMS_N;
+    long long en = NLMS_FLOOR;
+    for( int i = 0; i<nt_; i++ )
+      en += (long long) d[i]*d[i];
+    for( int i = 0; i<nt_; i++ ) {
+      long long g = ((long long) err*d[i])<<(16-COEF_PREC-NLMS_RATE);
+      int v = wc[i]+int(g/en);
+      wc[i] = (v<-NLMS_WMAX) ? -NLMS_WMAX : (v>NLMS_WMAX ? NLMS_WMAX : v);
+    }
+  }
+};
+
