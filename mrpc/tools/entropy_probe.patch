+
+// -------------------------------------------------------------
+// Measurement only: what the coder would have paid under other models,
+// charged on exactly the symbols the real coder saw.  Nothing here is
+// in the bitstream; MRPC_MIX turns it on.
+// -------------------------------------------------------------
+struct Fenwick {                 // counts over the 511 residual positions
+  double t[PMSIZE+1];
+  double all;
+  void Init() { memset(t, 0, sizeof(t)); all = 0.0; }
+  void Add(int i, double v) {
+    for( int x = i+1; x<=PMSIZE; x += x&(-x) )
+      t[x] += v;
+    all += v;
+  }
+  double Sum(int i) const {      // counts strictly below i
+    double s = 0.0;
+    for( int x = i; x>0; x -= x&(-x) )
+      s += t[x];
+    return s;
+  }
+};
+
+
+// A Bayesian mixture of ready-made experts: no counts to learn, no side
+// information, and the decoder can run it because the weights depend
+// only on symbols already coded.  w_i <- w_i * p_i(x), renormalised,
+// with a floor that lets the mixture switch back.
+struct ExpertMix {
+  const char* name;
+  int nctx, nexp;
+  double* w;
+  double cost;
+  void Init(const char* nm, int nc, int ne) {
+    name = nm;
+    nctx = nc;
+    nexp = ne;
+    w = new double[size_t(nc)*ne];
+    for( size_t i = 0; i<size_t(nc)*ne; i++ )
+      w[i] = 1.0/double(ne);
+    cost = 0.0;
+  }
+  void Quit() {
+    delete[] w;
+    w = 0;
+  }
+  void Charge(int c, const double* p) {
+    double* ww = w+size_t(c)*nexp;
+    double q = 0.0;
+    for( int i = 0; i<nexp; i++ )
+      q += ww[i]*p[i];
+    if( q<1e-300 )
+      q = 1e-300;
+    cost += -log(q)/log(2.0);
+    const double floorw = 0.002;
+    double sum = 0.0;
+    for( int i = 0; i<nexp; i++ ) {
+      ww[i] = ww[i]*p[i]/q;
+      sum += ww[i];
+    }
+    for( int i = 0; i<nexp; i++ )
+      ww[i] = (1.0-floorw*double(nexp))*(ww[i]/sum)+floorw;
+  }
+};
