+
+// Secondary estimation, PAQ's APM in the shape this alphabet wants: keep
+// the static pmf and learn one multiplicative correction per band of the
+// residual.  32 numbers a context instead of 511, and the cumulative the
+// decoder needs is 32 lookups into the static table it already has.
+static const int SSEB = 32;
+static INLINE int SseBand(int r) {
+  int a = (r<0) ? -r : r;
+  int l = 0;
+  while( a>0&&l<15 ) {
+    a >>= 1;
+    l++;
+  }
+  int q = (l<15) ? l : 15;
+  return (r<0) ? 15-q : 16+q;
+}
+
+struct SseMix {
+  const char* name;
+  int nctx;
+  double* cnt;   // what turned up in each band
+  double* exp_;  // what the static model expected there
+  double cost;
+  int bs[SSEB+1];   // the band boundaries, in symbol coordinates
+  void Init(const char* nm, int n) {
+    name = nm;
+    nctx = n;
+    cnt = new double[size_t(n)*SSEB];
+    exp_ = new double[size_t(n)*SSEB];
+    for( size_t i = 0; i<size_t(n)*SSEB; i++ )
+      cnt[i] = exp_[i] = 0.0;
+    cost = 0.0;
+    // SseBand is monotone in r, so each band is one run of symbols
+    for( int b = 0; b<=SSEB; b++ )
+      bs[b] = -1;
+    for( int sym = 0; sym<PMSIZE; sym++ ) {
+      int b = SseBand(sym-MAXVAL);
+      if( bs[b]<0 )
+        bs[b] = sym;
+    }
+    bs[SSEB] = PMSIZE;
+    for( int b = SSEB-1; b>=0; b-- )
+      if( bs[b]<0 )
+        bs[b] = bs[b+1];
+  }
+  void Quit() {
+    delete[] cnt;
+    delete[] exp_;
+    cnt = 0;
+    exp_ = 0;
+  }
+  void Charge(int c, const PMod* pm, int sym, int lo, int hi) {
+    double* cn = cnt+size_t(c)*SSEB;
+    double* ex = exp_+size_t(c)*SSEB;
+    const double A = 8.0;
+    double tot = double(pm->cumfreq[hi]-pm->cumfreq[lo]);
+    double pb[SSEB], z = 0.0;
+    for( int b = 0; b<SSEB; b++ ) {
+      int a = bs[b]<lo ? lo : bs[b];
+      int e = bs[b+1]>hi ? hi : bs[b+1];
+      double m = (e>a) ? double(pm->cumfreq[e]-pm->cumfreq[a])/tot : 0.0;
+      pb[b] = m*(cn[b]+A)/(ex[b]+A);
+      z += pb[b];
+    }
+    int bb = SseBand(sym-MAXVAL);
+    double ps = double(pm->freq[sym])/tot;
+    int a = bs[bb]<lo ? lo : bs[bb];
+    int e = bs[bb+1]>hi ? hi : bs[bb+1];
+    double mb = double(pm->cumfreq[e]-pm->cumfreq[a])/tot;
+    double q = (mb>0.0) ? (ps/mb)*(pb[bb]/z) : 1e-12;
+    if( q<1e-300 )
+      q = 1e-300;
+    cost += -log(q)/log(2.0);
+    for( int b = 0; b<SSEB; b++ ) {
+      int a2 = bs[b]<lo ? lo : bs[b];
+      int e2 = bs[b+1]>hi ? hi : bs[b+1];
+      if( e2>a2 )
+        ex[b] += double(pm->cumfreq[e2]-pm->cumfreq[a2])/tot;
+    }
+    cn[bb] += 1.0;
+  }
+};
+
+static const int MIXW = 6;
+static const double MIXWV[MIXW] = {0.0, 0.05, 0.10, 0.20, 0.35, 0.50};
+
+struct MixCtx {
+  const char* name;
+  int nctx;
+  double limit;   // halve the counts past this, to favour what is recent
+  Fenwick* f;
+  double* raw;
+  double cost[MIXW];
+  double acost;   // with a per-context adapted weight
+  float* w;       // that weight
+  void Init(const char* nm, int n, double lim = 0.0) {
+    name = nm;
+    nctx = n;
+    limit = lim;
+    raw = lim ? new double[size_t(n)*PMSIZE] : 0;
+    if( raw )
+      memset(raw, 0, size_t(n)*PMSIZE*sizeof(double));
+    f = new Fenwick[n];
+    for( int i = 0; i<n; i++ )
+      f[i].Init();
+    for( int i = 0; i<MIXW; i++ )
+      cost[i] = 0.0;
+    acost = 0.0;
+    w = new float[n];
+    for( int i = 0; i<n; i++ )
+      w[i] = 0.10f;
+  }
+  void Quit() {
+    delete[] f;
+    delete[] w;
+    delete[] raw;
+    f = 0;
+    w = 0;
+    raw = 0;
+  }
+  // ps: the static model's probability of the symbol, already conditioned
+  // on the window; lo/hi: the window in residual coordinates
+  void Charge(int c, int sym, double ps, int lo, int hi) {
+    Fenwick &fw = f[c];
+    double tot = fw.Sum(hi)-fw.Sum(lo);
+    double cnt = fw.Sum(sym+1)-fw.Sum(sym);
+    const double A = 0.05;                  // prior mass per symbol
+    double pa = (cnt+A)/(tot+A*double(hi-lo));
+    for( int i = 0; i<MIXW; i++ ) {
+      double q = (1.0-MIXWV[i])*ps+MIXWV[i]*pa;
+      cost[i] += -log(q)/log(2.0);
+    }
+    double ww = double(w[c]);
+    double q = (1.0-ww)*ps+ww*pa;
+    acost += -log(q)/log(2.0);
+    // one gradient step on the log loss: d/dw -log((1-w)ps + w pa)
+    double g = (pa-ps)/q;
+    ww += 0.02*g;
+    if( ww<0.0 )
+      ww = 0.0;
+    if( ww>0.9 )
+      ww = 0.9;
+    w[c] = float(ww);
+    fw.Add(sym, 1.0);
+    if( raw ) {
+      double* rc = raw+size_t(c)*PMSIZE;
+      rc[sym] += 1.0;
+      if( fw.all>limit ) {   // halve, and rebuild the tree from the counts
+        fw.Init();
+        for( int i = 0; i<PMSIZE; i++ ) {
+          rc[i] *= 0.5;
+          if( rc[i]>0.0 )
+            fw.Add(i, rc[i]);
+        }
+      }
+    }
+  }
+  void Report(FILE* o, double base, long n) const {
+    fprintf(o, "  %-28s", name);
+    for( int i = 1; i<MIXW; i++ )
+      fprintf(o, " %+6.2f%%", 100.0*(base-cost[i])/base);
+    fprintf(o, "   adaptive-w %+6.2f%%  (%.0f B)\n",
+            100.0*(base-acost)/base, acost/8.0);
+  }
+};
