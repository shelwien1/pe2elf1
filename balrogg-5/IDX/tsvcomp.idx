#  tsvcomp's context indices and tunable parameters.
#
#  IDX-FORMAT.md in this directory is the specification.  idx2inc.pl turns this
#  file plus the template tsvcomp.inc into MOD/tsvcomp_h.inc (the mapping
#  objects or their folded literals, the Volumes and the table struct) and
#  MOD/tsvcomp_p.inc (the index builders).  ../mk.sh drives both builds:
#
#      ./mk.sh              tuning:   Debug 1, Const 0 -- every threshold is a
#                                     live mapping object carrying a "!MAP!"
#                                     descriptor, which is what IDX/opt.pl
#                                     scans the executable for and hill-climbs
#      ./mk.sh release      shipping: every threshold folded to a literal
#
#  Both builds must code byte-identically; ./mk.sh check is that test.
#
#  A factor whose pattern is all zeroes contributes one bucket and costs
#  nothing, which is how a variable that was tried and did not pay stays
#  visible -- and how the optimizer is given somewhere to go.  Every variable a
#  family supplies is listed in every one of its indices for that reason.

Prefix TC
Debug 1
Const 0

#  ---------------------------------------------------------------------------
#  Residue digits: 92% of the records in a stream, so this is the program.
#
#  Variables, from tsvcomp.cpp:
#    rno   which residue          pass  which cascade pass
#    band  partition, log-ish     col   position inside the partition
#    q1 q2 the two digits before it, magnitude, log-ish
#    t1    the same slot one packet ago, log-ish
#    cls   the class of this partition -- the choice of codebook
#    bkq   that codebook's `off`, log-ish: the half-width of its value range
#    zrun  zeros so far in this partition        blk  short or long block
#
#  These patterns are opt.pl's, and what it did to the hand-set ones is worth
#  reading.  They started with dig_a rich -- the class at sixteen buckets, the
#  neighbouring digits, the packet-ago slot -- and dig_b coarse.  The optimizer
#  swapped the two roles: dig_a is now the *structural* counter, on the pass,
#  the band and the class, at 6,144 rows; dig_b is the *local* one, on the
#  neighbouring digits, the column and the zero run, at 62,208.  One counter
#  says where in the stream this digit is, the other what has just been
#  happening around it, and the mixer weighs them.  Hand sweeps do not find a
#  decomposition; they only move one variable at a time inside the one they
#  are given.
#
#  Two things that measured useless by hand are on here.  `col`, the position
#  inside the partition, is +0.27% alone (TSVTRANS.md) and was at zero -- it is
#  now five thresholds in dig_b, where it is not competing with the band.
#  `bkq`, the codebook's value range, was 1.01% worse than the class number it
#  was meant to replace -- it is now on in four indices *alongside* the class,
#  not instead of it.  Neither is a sweep result; both are what a search over
#  654 bits at once finds and a search over one at a time cannot.

Index dig_a
 dig_a_rno:  rno,   1!0
 dig_a_pass: pass,  1!1111111
 dig_a_band: band,  1!100110011000000
 dig_a_col:  col,   1!0000010
 dig_a_q1:   q1,    1!00000
 dig_a_q2:   q2,    1!0000
 dig_a_t1:   t1,    1!000
 dig_a_bkq:  bkq,   1!0001
 dig_a_cls:  cls,   1!010111111000000
 dig_a_zrun: zrun,  1!0001
 dig_a_blk:  blk,   1!1

Index dig_b
 dig_b_rno:  rno,   1!0
 dig_b_pass: pass,  1!1111111
 dig_b_band: band,  1!110000001000000
 dig_b_col:  col,   1!0111101
 dig_b_q1:   q1,    1!11111
 dig_b_q2:   q2,    1!1001
 dig_b_t1:   t1,    1!100
 dig_b_bkq:  bkq,   1!0101
 dig_b_cls:  cls,   1!000
 dig_b_zrun: zrun,  1!011
 dig_b_blk:  blk,   1!0

Index dig_s
 dig_s_pass: pass,  1!01
 dig_s_band: band,  1!011
 dig_s_q1:   q1,    1!111
 dig_s_t1:   t1,    1!111
 dig_s_bkq:  bkq,   1!001
 dig_s_cls:  cls,   1!001

Index dig_m
 dig_m_pass: pass,  1!111
 dig_m_band: band,  1!000
 dig_m_q1:   q1,    1!000
 dig_m_t1:   t1,    1!0
 dig_m_bkq:  bkq,   1!001
 dig_m_cls:  cls,   1!000

#  The mantissa of a digit that escaped the ladder: its own plane, on its own
#  index and its own tables, as mp3c's Smant is a submodel of its own.

Index dig_t
 dig_t_pass: pass,  1!111
 dig_t_band: band,  1!000
 dig_t_q1:   q1,    1!00000
 dig_t_t1:   t1,    1!000
 dig_t_bkq:  bkq,   1!000
 dig_t_cls:  cls,   1!111101011101100

Number dig_rA, 1, 0!11111111
Number dig_rB, 1, 0!11111011
Number dig_rS, 1, 0!01000
Number dig_lr, 1, 0!11011

#  ---------------------------------------------------------------------------
#  Floor posts.  The column is the whole story here -- post 0 and post 1 are
#  coded raw and land at the ends of the row, everything between them is a
#  folded residual at a frequency the column names.  Turning it off costs
#  0.55% of a whole stream, which is most of what the floor costs at all.
#  `p1` is what this post was one packet ago: a floor curve is the spectral
#  envelope, and an envelope moves slowly.

Index flr_a
 flr_a_fno:  fno,   1!1
 flr_a_col:  col,   1!111111111111111111111111111111111111111111111111
 flr_a_p1:   p1,    1!0000111
 flr_a_n1:   n1,    1!011
 flr_a_raw:  raw,   1!0
 flr_a_blk:  blk,   1!0

Index flr_b
 flr_b_fno:  fno,   1!0
 flr_b_col:  col,   1!0000000
 flr_b_p1:   p1,    1!11111001111101
 flr_b_n1:   n1,    1!0000000
 flr_b_raw:  raw,   1!0
 flr_b_blk:  blk,   1!0

Index flr_s
 flr_s_col:  col,   1!1111111
 flr_s_p1:   p1,    1!111
 flr_s_n1:   n1,    1!111

Index flr_m
 flr_m_col:  col,   1!000
 flr_m_p1:   p1,    1!000
 flr_m_n1:   n1,    1!000

Index flr_t
 flr_t_col:  col,   1!011111111010111111111001111100010000000010000000
 flr_t_p1:   p1,    1!000
 flr_t_n1:   n1,    1!001

Number flr_rA, 1, 0!00100000
Number flr_rB, 1, 0!10010000
Number flr_rS, 1, 0!00110
Number flr_lr, 1, 0!11111

#  ---------------------------------------------------------------------------
#  Residue classes: the class before it (-15.13% on its own, measured in
#  TSVTRANS.md) and the class the same partition had one packet ago.

Index cls_a
 cls_a_rno:  rno,   1!1
 cls_a_band: band,  1!000110011000000
 cls_a_prev: prev,  1!0000000
 cls_a_t1:   t1,    1!0101010
 cls_a_blk:  blk,   1!1

Index cls_b
 cls_b_rno:  rno,   1!0
 cls_b_band: band,  1!100000000010000
 cls_b_prev: prev,  1!111111100000001
 cls_b_t1:   t1,    1!101
 cls_b_blk:  blk,   1!1

Index cls_s
 cls_s_band: band,  1!111
 cls_s_prev: prev,  1!111
 cls_s_t1:   t1,    1!000

Index cls_m
 cls_m_band: band,  1!000
 cls_m_prev: prev,  1!000
 cls_m_t1:   t1,    1!0

Index cls_t
 cls_t_band: band,  1!111
 cls_t_prev: prev,  1!000
 cls_t_t1:   t1,    1!011

Number cls_rA, 1, 0!00011100
Number cls_rB, 1, 0!10000000
Number cls_rS, 1, 0!00111
Number cls_lr, 1, 0!11111

#  ---------------------------------------------------------------------------
#  Everything the page and packet headers hold, one field id apart.  Each field
#  is a few thousand records at most, so what these want is separation, not
#  resolution: `fld` is a dense factor and the rest is the field's own recent
#  history.

Index aux_a
ADD 32: fld
 aux_a_p1:   p1,    1!100100001000111
 aux_a_p2:   p2,    1!1000000

Index aux_b
ADD 32: fld
 aux_b_p1:   p1,    1!000
 aux_b_p2:   p2,    1!000

Index aux_s
ADD 32: fld

Index aux_m
ADD 32: fld

Index aux_t
ADD 32: fld

Number aux_rA, 1, 0!00100000
Number aux_rB, 1, 0!00000000
Number aux_rS, 1, 0!00101
Number aux_lr, 1, 0!11111

#  ---------------------------------------------------------------------------
#  The three header packets, coded record by record.  The tag is a dense factor
#  because the alphabet is small and every entry in it is a different kind of
#  number; p1r is the previous value under the same tag, whole, which is what
#  makes cb.len and cmt.byte an order-1 byte model.

Index hdr_a
ADD 64: tag
 hdr_a_p1:   p1,    1!010000000001010
 hdr_a_p2:   p2,    1!1111111
 hdr_a_pos:  pos,   1!111
 hdr_a_p1r:  p1r,   &00000000

Index hdr_b
 hdr_b_p1:   p1,    1!011
 hdr_b_pos:  pos,   1!1
 hdr_b_p1r:  p1r,   &11011111

Index hdr_s
ADD 64: tag

Index hdr_m
ADD 64: tag

Index hdr_t
ADD 64: tag
 hdr_t_p1r:  p1r,   &10011111

Number hdr_rA, 1, 0!00001010
Number hdr_rB, 1, 0!00100000
Number hdr_rS, 1, 0!00001
Number hdr_lr, 1, 0!11111
