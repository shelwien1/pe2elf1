+
+struct Counter {
+  word state;
+#if RC_FOLDP
+  word p;
+  void Update( uint _state, uint bit ) {
+    uint delta = ((byte*)&FSM[_state])-((byte*)&FSM[0]);
+    byte* __restrict q = (byte*)&FSM[0].s[bit];
+    q += delta;
+    word ns = (word&)q[0];
+    state = ns; p = pp[ns];
+  }
+  void Init( void ) { state=0; p=pp[0]; }
+#else
+  void Init( void ) { state=0; }
+#endif
+  
+  const uint P() const { return pp[state]; } //FSM[state].pp; }
+#if !RC_FOLDP
+  void Update( uint bit ) { 
+//    state = FSM[state].s[bit]; 
+    uint delta = ((byte*)&FSM[state])-((byte*)&FSM[0]);
+    byte* __restrict p = (byte*)&FSM[0].s[bit];
+    p += delta;
+    state = (word&)p[0];
+  }
+  void Update( uint _state, uint bit ) { 
+//    state = FSM[state].s[bit]; 
+    uint delta = ((byte*)&FSM[_state])-((byte*)&FSM[0]);
+    byte* __restrict p = (byte*)&FSM[0].s[bit];
+    p += delta;
+    state = (word&)p[0];
+  }
+#endif
+};
