 // SCALElog and friends live here rather than in FSM.cpp because rc.inc, the
 // kernel build options in rc_cl.cpp and the model all need them; FSM.cpp
 // includes this file for them.
+// ---------------------------------------------------------------------------
+//  Decoder prototype knobs -- see rc_decoder_opencl_plan_v1.md. All four
+//  default to off, and the default build is byte-identical to a tree without
+//  them.
+// ---------------------------------------------------------------------------
+
+// S independent order-0 models, byte i using model i%RC_STRIPE. Breaks the
+// decoder's cross-byte model dependency, which is the only thing in the
+// decoder that creates parallelism. Format change: encoder and decoder must
+// agree on S. Measured free -- see the plan, section 4.2. 1 = off.
+#ifndef RC_STRIPE
+#define RC_STRIPE 1
+#endif
+
+// Decode RC_DECILV bytes at a time, one striped model each. Needs
+// RC_DECILV <= RC_STRIPE, both powers of two. 1 = off.
+#ifndef RC_DECILV
+#define RC_DECILV 1
+#endif
+
+// Branchless counted refill in ShiftCode. Slightly slower on its own; a
+// prerequisite for RC_DECILV, which loses 33% without it (plan, section 4.4).
+#ifndef RC_DECREFILL
+#define RC_DECREFILL 0
+#endif
+
+// Fold the probability into the counter cell: {state,p} instead of {state},
+// so reading a counter gives p without the second pp[] lookup. The write-back
+// pays for it -- it has to look up pp[newstate] -- but that is off the chain.
+// A 4% loss scalar, 1.25x in the 16-lane vector form (plan, section 5.4).
+#ifndef RC_FOLDP
+#define RC_FOLDP 0
+#endif
+
 enum { SCALElog=15, SCALE=1<<SCALElog, mSCALE=SCALE-1, hSCALE=SCALE/2, eSCALE=16*SCALE };
 
