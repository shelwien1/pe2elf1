@@ -171,7 +172,17 @@
 
   void ShiftCode( uint n ) {
     code -= rpre; rpre = 0;   // mirrors ShiftLow's deferred update
+#if RC_DECREFILL
+    // Branchless counted refill. n is 0..2 for the binary coder (rc_Renorm's
+    // count), so the two bytes the shift can need are always the two at ptr --
+    // read both unconditionally, shift in the ones that count, advance by n.
+    // Reading one byte past the substream is safe: rc_Read pads FF_PADSIZE.
+    uint v = (uint(ptr[0])<<8) + ptr[1];
+    code = (code<<(n*8)) + (v>>((2-n)*8));
+    ptr += n;
+#else
     for( ; n!=0; n-- ) code = (code<<8) + get();
+#endif
   }
 
