Prefix E0
Debug 1

# ======================================================================
# tc_model-E0.idx -- the masked context models of the paq block (paq.inc,
# tsvcomp.cpp code_value).  Each of the NE models hashes 9 indices built
# from the same candidate variables; every mask starts at zero, so each
# model starts as an order-0 model (column x bit node), and opt.pl decides
# which bits are worth turning on.  Each index holds at most 30 bits with
# every mask bit on, so the int the mask objects build never overflows.
#
#  zr rows since the target changed (<=255)   ep exponent of the previous delta (40 = 0)
#  j1 last jump, j2 the one before (sign + exponent)   ne need_prediction
#  sc change flags (i0 price, volume, trade)   lv level, ol other column's level (>>9, +64)
#  od other column's delta (sign + exponent)   pk prediction, po other prediction (>>9, +64)
#  mq prediction - level, dq prediction change (sign + exponent)   sg signs of a0..a7
#  pm/pu i0 price columns changed / moved up (22 bits)   tm trade columns changed
#  rp rows since a price change (<=255)   vm/vu i0 volume columns changed / up
#  im/iu i1 price columns changed / up
# ======================================================================

Const 0

# --- model 0
Index A0
 zr0: zr, &00000000
 ep0: ep, &000000
 j10: j1, &000000
 j20: j2, &000000
 ne0: ne, &0
 sc0: sc, &000
Index B0
 lv0: lv, &0000000
 ol0: ol, &0000000
 od0: od, &000000
 pk0: pk, &0000000
Index C0
 po0: po, &0000000
 mq0: mq, &000000
 dq0: dq, &000000
 sg0: sg, &00000000
Index D0
 pm0: pm, &0000000000000000000000
 tm0: tm, &00000000
Index E0
 pu0: pu, &0000000000000000000000
 rp0: rp, &00000000
Index F0
 vm0: vm, &0000000000000000000000
Index G0
 vu0: vu, &0000000000000000000000
Index H0
 im0: im, &0000000000000000000000
Index I0
 iu0: iu, &0000000000000000000000

