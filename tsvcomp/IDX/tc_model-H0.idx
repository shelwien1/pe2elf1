Number stP_min,1,1!010110000001100

Number leak1,  1,1!0111111011101000
Number leak2,  1,1!1111011100000011

Const 0

Number mwP0,   1,1!100101011000001

Const 0

Number G3_k,   1,0!0010010001100000111
                              
Number G4_m,   1,0!0100000000110100010
Number G4_k,   1,0!0000000000000000000

Const 0

# added from sh_model-C0_h.inc
Number M1_u,  1,0!010110000010000000
Number M2_u,  1,0!10101010110
Number M2_x,  1,0!11001000010   # decay of the (u,v) cross EMA R_uv, cloned from M2_u (it used to share it)
Number NWu,   1,0!001110000000100000000
Number RUinc, 1,0!010000000000010100
Number uStep, 1,0!1000010010000000000
Number uMin,  1,0!0100110000
Number uMax,  1,0!10110001100000101010000
Number vMin,  1,0!1110001101                # the v box, cloned from uMin/uMax: |v| <= UVH * half its ln width
Number vMax,  1,0!01100101100100000100000   # (it used to be a fraction of the u box)
Number G2_u,  1,0!000000000
Number G3_u,  1,0!01000000000000000000
Number G4_u,  1,0!01000100110
Number R0_u,  1,0!00000001

