
Prefix H0
# tsvcomp copy: counter/mixer/SSE knobs as tuned for coder0 (../IDX), own Index
Debug 1

# The knobs of the rejected proposals (AWIND/HBETA/EFISH/ALEAK/SMASS/MKCPL/
# BIASC), the ADAPT_L rates LWw/LWk/LWm and the four grad1_clip knobs G1_*
# used to sit here frozen with '!' -- 28 entries the coder did not read, so
# neither opt.pl nor optv.pl could ever score a change to one.  They are
# deleted; git history has their last values, and the rejections are
# summarized in coder0.cpp's header.

Const 0
Const 0
# --- the paq block's hashed context models (paq.inc): each is a hash
# table of 2^TB Counter<CP_H0> cells (+ a 32-bit check per slot).  The
# counter knobs below started as a copy of the tuned C0 knobs.
Number TB,     1,12!0101    # table size: 2^TB cells per context model (12..22); 17: 450 MB

Const 0


Number mwMax,  1,1!111111111111000

Number G3_m,   1,0!1000000000000000000

Const 0

Number P0,     1,1!001101101010001
Number P1,     1,0!00011110000000

Const 0

Number wr,     1,1!11111010000100
Number wr1,    1,0!110000000000
Number wr1b,   1,1!11110110010001   # the base of wr1's delta, cloned from wr: W0 (wr) and W1 (wr1b + wr1) are separate knobs
Number mw,     1,1!0001001110000
Number K,      1,0!1111010000000000
Number NWk,    1,1!110010010100000000
Number RKinc,  1,1!000000000000001
Number kStep,  1,1!0010110001001000100
Number kMin,   1,1!1100000000000000000000
Number kMax,   1,1!001101101100001

Const 0

Number NWm,    1,1!01101111100000011000
Number MWinc,  1,1!000000000000000
Number mwStep, 1,1!01010111001000000000
Number mwMin,  1,1!000000000000000

