
Prefix C1
# tsvcomp copy: counter/mixer/SSE knobs as tuned for coder0 (../IDX), own Index
Debug 1

# The knobs of the rejected proposals (AWIND/HBETA/EFISH/ALEAK/SMASS/MKCPL/
# BIASC), the ADAPT_L rates LWw/LWk/LWm and the four grad1_clip knobs G1_*
# used to sit here frozen with '!' -- 28 entries the coder did not read, so
# neither opt.pl nor optv.pl could ever score a change to one.  They are
# deleted; git history has their last values, and the rejections are
# summarized in coder0.cpp's header.

Const 1
Const 0
# --- C1 cell context: jumps and the other column ------------------------
# h: 19-bit hash of (coding node, this column's last nonzero delta, the
#    other column's delta state), see tsvcomp.cpp
Index Cx
 h: h, &1111111111111111111

Const 1


Number mwMax,  1,1!111111111111000

Number G3_m,   1,0!1000000000000000000

Const 1

Number P0,     1,1!100110010000100
Number P1,     1,0!01011000000001

Const 1

Number wr,     1,1!10000001000011
Number wr1,    1,0!101000100001
Number wr1b,   1,1!10111111010001   # the base of wr1's delta, cloned from wr: W0 (wr) and W1 (wr1b + wr1) are separate knobs
Number mw,     1,1!0100010100100
Number K,      1,0!0101010010000000
Number NWk,    1,1!101000001010101000
Number RKinc,  1,1!010000100011011
Number kStep,  1,1!0011011001000110100
Number kMin,   1,1!1111111110111000000000
Number kMax,   1,1!001101100001000

Const 1

Number NWm,    1,1!01010100100000011010
Number MWinc,  1,1!111110010010100
Number mwStep, 1,1!00111111100000000000
Number mwMin,  1,1!000000000000000

Const 1

Number M1_m,   1,1!111111111100000000
Number M2_m,   1,1!001011110111000

Number M1_k,   1,1!11111001011011000001
Number M2_k,   1,1!0101111010000000000

Number G2_m,   1,0!1101000001111
Number G2_k,   1,0!100000011000011

Const 1

Number stP_min,1,1!001100000111000

Number leak1,  1,1!0111111000010000
Number leak2,  1,1!1111011100000011

Const 1

Number mwP0,   1,1!100111111000011

Const 1

Number G3_k,   1,0!0010010001100000111
                              
Number G4_m,   1,0!0100000000110100010
Number G4_k,   1,0!0000000000010000000

Const 1

# added from sh_model-C0_h.inc
Number M1_u,  1,0!111111110000000000
Number M2_u,  1,0!11111101011
Number M2_x,  1,0!11010110110   # decay of the (u,v) cross EMA R_uv, cloned from M2_u (it used to share it)
Number NWu,   1,0!001100000100100000000
Number RUinc, 1,0!111110101000100010
Number uStep, 1,0!1111000010111111000
Number uMin,  1,0!0011011110
Number uMax,  1,0!01100000100000010000000
Number vMin,  1,0!1111001100                # the v box, cloned from uMin/uMax: |v| <= UVH * half its ln width
Number vMax,  1,0!01100101100100000100000   # (it used to be a fraction of the u box)
Number G2_u,  1,0!000000000
Number G3_u,  1,0!01000000000000000000
Number G4_u,  1,0!00001101011
Number R0_u,  1,0!10011100

Number M1_v,  1,0!111111111001100000
Number M2_v,  1,0!100101000
Number NWv,   1,0!01101010110100100000
Number RVinc, 1,0!01010000000000000000
Number vStep, 1,0!001001111010000000
Number G2_v,  1,0!000000010
Number G3_v,  1,0!01000000000000000000
Number G4_v,  1,0!00010000001
Number R0_v,  1,0!00000000

Number UVH, 1,0!010001000000

Const 1

# added from sh_model-C0_h.inc

Number CXW, 1,0!01111110111
Number XHW, 1,0!01110011000
Number UVDET, 1,0!010111000
Number XHC, 1,0!0000000000000
Number mwXlo, 1,0!000000000
Number mwXhi, 1,0!0100000000000000

Const 1

# A1 young-cell step schedule (coder0.cpp Counter::C_Update):
# stepMax_eff = stepMax*(1 + AGAx/(1 + age/B)) on the mw (AGAm) and K (AGAk)
# steps and on the u/v ray clip (AGAu, AGAv per axis); AGAx/256, 0 = plain
# limit.  B = AGB/16 updates (64 = 4 updates) for mw and K, AGBuv/16 for u/v.
Number AGAu,   1,0!000000000000
Number AGAv,   1,0!010000000000   # cloned from AGAu (u and v used to share it)
Number AGAm,   1,0!000001111110
Number AGAk,   1,0!000001000101
Number AGB,    1,0!0100010100
Number AGBuv,  1,0!0101001100   # cloned from AGB (u/v used to share it with mw and K)

Const 1

# A2 end-to-end objective: the parameter gradients use
# (1-E2E)*(own error) + E2E*(final error chained to this cell), E2E/256;
# E2E for mw and K, E2Euv for the u/v axes.
Number E2E,    1,0!100000000
Number E2Euv,  1,0!011001010   # cloned from E2E (u/v used to share it with mw and K)
