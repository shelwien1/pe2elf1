# paq8-G0.idx -- every number in paq8hp_speed.hpp that is a CHOICE.
#
# Two kinds of thing live here and nothing else does:
#
#   Number  -- a tunable scalar.  Fixed mixing weights, adaptation rates, the
#              positions the rate schedules switch at, the mixer's learning
#              rates and output scalers, the bit-history decay parameters.
#   Index   -- the mixer's context selectors, i.e. the arithmetic that turns a
#              handful of model variables into one row of Mixer::wx.
#
# What is deliberately NOT here: P_BITS/P_SCALE/PR_BITS/ST_SCALE and everything
# derived from them.  Those are the arithmetic's resolution, not a tuning
# choice -- they are fixed by the range coder's totFreq and by the width the
# counters are stored at, and paq8hp_speed.hpp already carries the static_asserts
# that say what they may be.  Handing them to opt.pl would be handing it the
# format rather than the model.
#
# Rate/Rate1 are unused: they index a TTable[] of update-rate schedules and
# divide eSCALE, neither of which this coder has.
#
# Every seeded pattern below spells the value the code shipped with, so a fresh
# tuning build and a fresh release build both reproduce the baseline archives
# byte for byte.  ../verify.sh checks exactly that, under both.

Prefix G0
Debug 1
Const 0

# ---------------------------------------------------------------------------
# Probability-domain mixing weights.
#
# Every fixed-weight average of probabilities goes through pmix(), whose weights
# are in P_SCALE units and must sum to P_SCALE.  Declaring them in units of
# P_SCALE/256 keeps that arithmetic exact at any P_BITS >= 8 and gives the
# optimizer 1/256 resolution rather than the 1/32 the original shifts had.
#
# Only the first three of each blend are declared: the fourth is the remainder,
# so the sum is structural.  A sum constraint that opt.pl can violate is not a
# constraint, and a static_assert on it cannot even be written in the tuning
# build, where these are runtime reads.
# ---------------------------------------------------------------------------

# final blend of the four APM chains, when fails&255 is set (6:1:11:14 /32)
Number MIXA_pt,        P_SCALE/256, 0!00111110
Number MIXA_pu,        P_SCALE/256, 0!00001000
Number MIXA_pv,        P_SCALE/256, 0!01011000

# and when it is clear (4:5:12:11 /32)
Number MIXB_pt,        P_SCALE/256, 0!00110000
Number MIXB_pu,        P_SCALE/256, 0!01000000
Number MIXB_pv,        P_SCALE/256, 0!01100010

# ---------------------------------------------------------------------------
# Adaptation rates -- 16-bit fixed-point MULTIPLIERS, not shifts.
#
# Every adaptive counter here updates as v += (target-v)*MUL/65536, where
# 65536 is a full step.  These used to be shift amounts, which meant the only
# rates an optimizer could ever reach were the powers of two: 1/128, 1/256,
# 1/512 and nothing in between.  A shift cannot express 1/192.  Seeding
# MUL = 65536>>shift reproduces every old shift exactly -- so this change is
# byte-identical on its own -- and opens the space between the points.
#
# The *_SW* numbers are the input positions at which one rate gives way to the
# next.  A schedule step is `MUL >> 1`, i.e. halve the step, which is exactly
# what `rate + 1` used to mean.
#
# Multipliers are declared with base 1, so a swept value can never reach 0 and
# freeze a counter, and with 14 bits, which caps MUL at 16384 -- see the
# static_assert in paq8hp_speed.hpp that keeps (target-v)*MUL inside int.
# ---------------------------------------------------------------------------

# StateMap: one shared rate, slowed twice as the counts settle
Number SM_MUL_0,       1,           1!00000001000100
Number SM_MUL_1,       1,           1!00000010011000
Number SM_MUL_2,       1,           1!00000001111111
Number SM_SW1,         65536,       0!01000
Number SM_SW2,         65536,       0!10000
# the Laplace prior on a state's (n0,n1) that seeds StateMap::t
Number SM_PRIOR_ADD,   1,           0!01


# ---------------------------------------------------------------------------
# APM chain -- SIX INSTANCES, SIX SETS OF PARAMETERS.
#
# The six APMs used to share one rate schedule: a single `rate = base +
# (pos>SW1) + (pos>SW2)` computed once and handed to five of them, with a2
# adding a constant on top.  They are not one adaptive unit, though -- they sit
# at different points of the chain (a1 and a3 correct the raw model output, a4
# and a6 correct what a1 already corrected, a5 corrects a2) and they index on
# completely different contexts, from 256 rows to 131072.  Sharing a schedule
# was an accident of how the code was written, not a property of the model, and
# it meant opt.pl could only move all five together.
#
# So each instance now owns its schedule.  Seeds reproduce the old arithmetic
# exactly: A2_MUL is half the others because a2's rate was base+1, and every
# switch position is the value the shared pair held.  a1 keeps a single
# fixed rate because it never had a schedule -- cloning a knob is not the same
# as inventing one.
#
# *_NH is the interpolation grid, and it is the parameter this table never had.
# The grid is 2*NH intervals over the stretch range, i.e. 2*NH+1 nodes, so NH
# half-intervals either side of the middle and always a node exactly at
# p == P_HALF.  16 is the 33 the code shipped with.  Declaring the half-count
# rather than the node count is what keeps the grid symmetric under tuning: a
# free node count would let the optimizer pick an even one, which puts the
# midpoint -- by far the most visited cell -- on an interpolation boundary.
#
# NOTE the cost model here, because it is not the usual one: *_NH multiplies
# that APM's table, and a4 alone is 131072 contexts.  Nodes are cheap in
# accuracy terms and expensive in cache terms; the ceiling is APM_NH_MAX in
# paq8hp_speed.hpp, which the consumer clamps to.
# ---------------------------------------------------------------------------

# a1: fast correction on the raw model output, 256 contexts, no schedule.
# A1_w is how much of a1's output survives the blend with the raw model
# prediction -- 1/8 : 7/8 -- so it belongs to a1 as much as its rate does.
Number A1_MUL,         1,           1!00000100000101
Number A1_NH,          1,           1!10011
Number A1_w,           P_SCALE/256, 0!00000111

# a2: 32768 contexts on failz.  Ran one step slower than the shared rate,
# so its multiplier is half theirs: 512/65536 against 1024/65536.
Number A2_MUL,         1,           1!00001000001100
Number A2_SW1,         262144,      0!00001
Number A2_SW2,         524288,      0!11100
Number A2_NH,          1,           1!01100

# a3: 32768 contexts on x5, corrects the raw model output
Number A3_MUL,         1,           1!00000110000100
Number A3_SW1,         262144,      0!00000
Number A3_SW2,         524288,      0!11100
Number A3_NH,          1,           1!11101

# a4: 131072 contexts on b1/x5, corrects a1's output
Number A4_MUL,         1,           1!00100000000000
Number A4_SW1,         262144,      0!00001
Number A4_SW2,         524288,      0!00001
Number A4_NH,          1,           1!01101

# a5: 65536 contexts on w5, corrects a2's output
Number A5_MUL,         1,           1!00000101000011
Number A5_SW1,         262144,      0!01110
Number A5_SW2,         524288,      0!11100
Number A5_NH,          1,           1!01111

# a6: 65536 contexts on the fail histogram, corrects a4's output
Number A6_MUL,         1,           1!00010000001010
Number A6_SW1,         262144,      0!00001
Number A6_SW2,         524288,      0!11100
Number A6_NH,          1,           1!01100

# SmallStationaryContextMap: one step slower once the counts have settled
Number SCM_MUL_EARLY,  1,           1!11111111011110
Number SCM_MUL_LATE,   1,           1!00000000111111
Number SCM_SW,         1000,        0!111110100000

# ---------------------------------------------------------------------------
# Mixer.
# ---------------------------------------------------------------------------

# learning rates: the prediction error is scaled by MUL/P_SCALE before train().
#
# One multiplier instead of the NUM/DEN pair these used to be.  A ratio spelled
# as two independently patchable integers is not one knob: opt.pl could move the
# numerator and the denominator to the same ratio by many different routes, most
# of the search space was duplicate points, and 7/1 and 14/2 differ only in
# where the single truncation lands.  Declared in units of P_SCALE/256, the same
# unit the fixed mixing weights above use, so P_SCALE is the fixed-point
# denominator and cancels -- the ratio does not move with P_BITS.
#
# 1792/256 == 7/1 and 128/256 == 2/4 reproduce the pair exactly.
Number MIX_LR_MUL,     P_SCALE/256, 0!011100000000
Number MIX2_LR_MUL,    P_SCALE/256, 0!000010000000

# initial weight.  These two reach Mixer as template arguments, which is what
# IDXP() in the consumer is for -- see IDX-FORMAT.md section 8.
Number MIX_W_INIT,     1,           0!0101110111
Number MIX2_W_INIT,    1,           0!101000010100000

# output scalers, logistic domain.  Two mixers, two sets: the main mixer's S>1
# path scales each context's dot product by MIX_DP_*, and the S==1 submixer
# scales its own by MIX2_Z_SHIFT for the value it returns and MIX2_ZB_* for the
# one it hands back up the chain.  The MIX2_ names are not cosmetic -- these
# three only ever execute in the submixer's p(), and calling them MIX_* made it
# read as if the two mixers shared them.
Number MIX_DP_MUL,     1,           0!1010
Number MIX_DP_SHIFT,   1,           0!1001
Number MIX2_Z_SHIFT,   1,           0!1001
Number MIX2_ZB_MUL,    1,           0!1111
Number MIX2_ZB_SHIFT,  1,           0!1101

# per-group input rescaling in ContextModel::p: m.mul(x) is tx = tx*x/P_SCALE.
# The three groups are the 2/1/1 split of the ContextMap outputs.
#
# These were three numerators over one shared denominator, which coupled them:
# opt.pl could not move one group's gain without moving all three, because
# MIX_MUL_DEN sat under every one of them.  As P_SCALE-unit multipliers they are
# three independent knobs.  256/256 == 4/4 and 448/256 == 7/4 reproduce the old
# ratios exactly.
#
# Logistic-domain, so no P_REF rescaling: P_SCALE appears here only as the
# fixed-point denominator, and it cancels against the P_SCALE/256 unit.
Number MIX_MUL_0,      P_SCALE/256, 0!000100000000
Number MIX_MUL_1,      P_SCALE/256, 0!000100000000
Number MIX_MUL_2,      P_SCALE/256, 0!000111000000

# ---------------------------------------------------------------------------
# ContextMap bit histories.
# ---------------------------------------------------------------------------

# a state at or above CM_DECAY_FROM steps back by CM_DECAY_STEP with probability
# ~2^-((CM_DECAY_BIAS-ns)>>CM_DECAY_SHIFT), so the closer to saturation the more
# often it decays.
#
# CM_DECAY_BIAS was seeded 010100101 == 165, which is below CM_DECAY_FROM and
# therefore made that shift count negative for EVERY state the guard admits.
# Negative shifts are undefined, and the two builds resolved it differently --
# the shipping build deleted the decay as unreachable, the tuning build ran it
# with x86's count masked to five bits -- which is why the two builds did not
# produce the same archive.
#
# The seed is now 110100101 == 421, one bit away from what was there and the
# value that states what the masked shift was doing: (421-ns)>>3 equals
# ((165-ns)>>3)&31 for every ns in [CM_DECAY_FROM,255], because 256>>3 is
# exactly 32.  So the schedule is unchanged from the one every opt.pl run
# actually measured, and it is now a defined expression that both builds agree
# on.  The clamp at the point of use is what keeps it defined as opt.pl sweeps.
Number CM_DECAY_FROM,  1,           0!11100001
Number CM_DECAY_BIAS,  1,           0!110100101
Number CM_DECAY_SHIFT, 1,           0!011
Number CM_DECAY_STEP, 1,           0!0110

# run-length counters saturate rather than wrap
Number RCM_RUN_MAX,    1,           0!11111111
Number CM_RUN_MAX,     1,           0!00001010
Number CM_RUN_STEP,    1,           0!010

# ---------------------------------------------------------------------------
# Predictor fail counters.  Both are P-domain thresholds fitted at P_REF_BITS,
# so the consumer passes them through p_from_ref() rather than rescaling here.
# ---------------------------------------------------------------------------
Number FAIL_TH,        1,           0!10111111010
Number FAILZ_TH,       1,           0!1000010100

# ---------------------------------------------------------------------------
# Mixer context selectors.
#
# Four of the six m.set() calls in ContextModel::p are exact packings of a few
# small variables, so they are declarations rather than arithmetic.  The other
# two are not: one is a two-branch expression over bpos, the other adds two
# fields that can carry into each other, and writing either as an Index would
# only be a lie about what it computes.
#
# Every mask line is FROZEN (leading `!`, section 10).  A mask here is a bit
# SELECTOR: widening one multiplies the index Volume, and Mixer::wx is a
# fixed-size member sized from the sum of all six ranges, so a wider mask would
# silently index past it.  Freezing keeps the structure declared and reviewable
# while leaving the search space to the parameters above.  The ADD factors are
# order (7 values) and bpos (8), which are ranges of the variables themselves
# and not tunable either.
# ---------------------------------------------------------------------------

# m.set( 256*order + (w4&240) + (c2>>4), 256*7 )
Index MX0
 ADD 9: order
!mx0_w4:  w4,  &11110000
!mx0_c2:  c2,  &11110000

# m.set( order*256 + (w4&3)*64 + ((words>>1)&63), 256*7 )
Index MX1
 ADD 9: order
!mx1_w4:  w4,     &00000011
!mx1_wd:  words1, &00111111

# m.set( (w4&255) + 256*bpos, 256*8 )
Index MX2
 ADD 8: bpos
!mx2_w4:  w4,  &11111111

# m.set( order*256 + bpos + (c2&248), 256*7 )
Index MX4
 ADD 9: order
!mx4_c2:  c2,  &11111000
 ADD 8: bpos
