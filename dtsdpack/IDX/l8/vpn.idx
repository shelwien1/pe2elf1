#  dtsdpack's vpn family at level -8: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l8/vpn_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The ADPCM predictors' ranks of a channel the WAV doesn't bind, in the order the LPC of its
#  subband's last decoded values makes (vqp's, then vpd's, until format 167; vpd's its start).
#  It has vqr's variables (famvars.inc).

Prefix D8_vpn
Debug 1
Const 0

Index a
 a_kd: kd, 1!000
 a_mg: mg, 1!011000000100
 a_nc: nc, 1!011010
 a_ml: ml, 1!011111101000101
 a_gr: gr, 1!1000110

Index b
 b_kd: kd, 1!110
 b_mg: mg, 1!000000010110
 b_gn: gn, 1!100100000000000

Index c
 c_kd: kd, 1!000
 c_bd: bd, 1!1000010000000001000000100001001
 c_mg: mg, 1!100000000001

Index d
 d_kd: kd, 1!000
 d_lh: lh, 1!11
 d_mg: mg, 1!000001000000
 d_gr: gr, 1!1000010

Index e
 e_kd: kd, 1!101
 e_cc: cc, 1!10
 e_bd: bd, 1!1000110101000000000001000011111

Index h
 h_kd: kd, 1!111
 h_gn: gn, 1!110000000000000
 h_lh: lh, 1!10

Index i
 i_kd: kd, 1!010
 i_mg: mg, 1!000001100110
 i_lh: lh, 1!00
 i_gn: gn, 1!100001000000000

Index j
 j_kd: kd, 1!101
 j_bd: bd, 1!1111000000000010110100100010111
 j_lh: lh, 1!00

Index k
 k_kd: kd, 1!101
 k_cc: cc, 1!11
 k_mg: mg, 1!101000111111

Index l
 l_mq: mq, 1!10010010
 l_kd: kd, 1!000
 l_gn: gn, 1!000000000000000

Index s
 s_kd: kd, 1!111
 s_mg: mg, 1!010001000001

Index f
 f_kd: kd, 1!111
 f_nc: nc, 1!111111
 f_ml: ml, 1!111111111111111

Index m
 m_mq: mq, 1!10110101
 m_kd: kd, 1!010

Index w
 w_mg: mg, 1!000100000000
 w_ml: ml, 1!000011010110100

Index t
 t_kd: kd, 1!111

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_kd: kd, 1!111

Index g
 g_kd: kd, 1!111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11110011
Number mwA, 1, 0!00101101
Number rB, 1, 0!11101010
Number mwB, 1, 0!11100010
Number rC, 1, 0!01111101
Number mwC, 1, 0!00000000
Number rD, 1, 0!00001000
Number mwD, 1, 0!00010001
Number rE, 1, 0!01011000
Number mwE, 1, 0!00000001
Number rH, 1, 0!11111100
Number mwH, 1, 0!11111111
Number rI, 1, 0!11101101
Number mwI, 1, 0!10010100
Number rJ, 1, 0!11110110
Number mwJ, 1, 0!01110101
Number rK, 1, 0!11110011
Number mwK, 1, 0!00000011
Number rL, 1, 0!11001111
Number mwL, 1, 0!01110011
Number lr, 1, 0!00111
Number mb, 1, 0!01001100
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00011111
Number wq, 1, 0!00000000
Number wo, 1, 0!01001101
Number wa, 1, 0!00000000
Number wf, 1, 0!01010101
Number lf, 1, 0!00010000
Number bf, 1, 0!00000000
Number l2, 1, 0!00011110
Number l3, 1, 0!00011100
Number b2, 1, 0!10000000
Number b3, 1, 0!00010000
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!0101110
Number qf, 1, 3!1111010
Number bw, 1, 0!10000
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!10111100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
