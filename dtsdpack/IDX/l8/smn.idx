#  dtsdpack's smn family at level -8: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l8/smn_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The subband samples' quantization indexes of a channel the WAV doesn't bind, as their residuals
#  from the least-squares fit of its decoded values (model_smp.inc's code_q(); smp's or smd's
#  before format 159), against the residuals' spread and how far the fit's value lies from its
#  index.  Its parameters start as smd's, tuned on 9 streams' dumps without their WAVs.
#  -9's parameters, as they are.

Prefix D8_smn
Debug 1
Const 0

Index a
 a_pk: pk, 1!1
 a_nr: nr, 1!001000000000010
 a_nl: nl, 1!101110111011110

Index b
 b_pk: pk, 1!0
 b_ab: ab, 1!001110111101100000000111000
 b_ql: ql, 1!001111111111111111111

Index c
 c_pk: pk, 1!0
 c_nr: nr, 1!000000000010010
 c_hm: hm, 1!11

Index d
 d_pk: pk, 1!0
 d_ab: ab, 1!010100000011000011110001000
 d_m1: m1, 1!1110101110101110000001

Index e
 e_pk: pk, 1!0
 e_ab: ab, 1!010001100010000000100110000
 e_m1: m1, 1!1111111111111000100000
 e_m2: m2, 1!1111111011111110000000

Index h
 h_pk: pk, 1!0
 h_ab: ab, 1!001100100101000011111011000
 h_nr: nr, 1!000000001000111

Index i
 i_pk: pk, 1!1
 i_ab: ab, 1!010010001110011101101001000
 i_hw: hw, 1!001
 i_pm: pm, 1!0

Index j
 j_pk: pk, 1!1
 j_ab: ab, 1!011101011111010000100001000
 j_bd: bd, 1!1111101101111111111111111111111

Index k
 k_pk: pk, 1!0
 k_nr: nr, 1!000000100000111
 k_pm: pm, 1!0

Index l
 l_pk: pk, 1!0
 l_nl: nl, 1!100000000111111
 l_ab: ab, 1!000000001111111111100110000

Index s
 s_pk: pk, 1!1
 s_nr: nr, 1!000000010000100
 s_nl: nl, 1!111111111100000

Index f
 f_pk: pk, 1!1
 f_nl: nl, 1!100001001001000
 f_nr: nr, 1!000000100000111

Index m
 m_pk: pk, 1!1
 m_nr: nr, 1!000001000000000

Index w
 w_nl: nl, 1!000010010000100

Index t
 t_ab: ab, 1!000000111111000000000000000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_ab: ab, 1!111111111111111111111111111

Index g

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11111010
Number mwA, 1, 0!11110010
Number rB, 1, 0!11111110
Number mwB, 1, 0!10111101
Number rC, 1, 0!01000000
Number mwC, 1, 0!10110110
Number rD, 1, 0!11110110
Number mwD, 1, 0!01110101
Number rE, 1, 0!11111001
Number mwE, 1, 0!00100000
Number rH, 1, 0!11111111
Number mwH, 1, 0!11111111
Number rI, 1, 0!11111111
Number mwI, 1, 0!11111111
Number rJ, 1, 0!11111110
Number mwJ, 1, 0!01111111
Number rK, 1, 0!11111111
Number mwK, 1, 0!11111101
Number rL, 1, 0!11111101
Number mwL, 1, 0!10111011
Number lr, 1, 0!10001
Number mb, 1, 0!00010000
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00010000
Number wq, 1, 0!00000111
Number wo, 1, 0!11001110
Number wa, 1, 0!00000000
Number wf, 1, 0!01001110
Number lf, 1, 0!00001001
Number bf, 1, 0!00010000
Number l2, 1, 0!00001011
Number l3, 1, 0!00001000
Number b2, 1, 0!10010000
Number b3, 1, 0!01000000
Number rS1, 1, 0!10000
Number rS2, 1, 0!01000
Number qs, 1, 3!0001001
Number qf, 1, 3!1111010
Number bw, 1, 0!01110
Number rT, 1, 0!11101101
Number mwT, 1, 0!10000000
Number mt, 1, 0!110
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
