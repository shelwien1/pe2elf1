#  dtsdpack's vqr family at level -8: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l8/vqr_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The ranks of the HF VQ vectors (their groups', then theirs in the group) among the code book's
#  entries, in the order of the encoder's search on the audio (where the WAV is bound); the ADPCM
#  predictors' too before format 116 (vqp's since).
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D8_vqr
Debug 1
Const 0

Index a
 a_kd: kd, 1!000
 a_mg: mg, 1!100100000000
 a_nc: nc, 1!111000
 a_ml: ml, 1!001011111010100
 a_gr: gr, 1!1100100

Index b
 b_kd: kd, 1!110
 b_mg: mg, 1!010010000000
 b_gn: gn, 1!011110111010000

Index c
 c_kd: kd, 1!000
 c_bd: bd, 1!0000000000000000000000000000001
 c_mg: mg, 1!000011000000

Index d
 d_kd: kd, 1!000
 d_lh: lh, 1!10
 d_mg: mg, 1!011000100000
 d_gr: gr, 1!1110000

Index e
 e_kd: kd, 1!101
 e_cc: cc, 1!11
 e_bd: bd, 1!0000000000000000000000000001010

Index h
 h_kd: kd, 1!000
 h_gn: gn, 1!011110110010000
 h_lh: lh, 1!10

Index i
 i_kd: kd, 1!010
 i_mg: mg, 1!110001000001
 i_lh: lh, 1!00
 i_gn: gn, 1!001000001110000

Index j
 j_kd: kd, 1!010
 j_bd: bd, 1!0000000000000000000000000000001
 j_lh: lh, 1!10

Index k
 k_kd: kd, 1!101
 k_cc: cc, 1!11
 k_mg: mg, 1!011110100011

Index l
 l_mq: mq, 1!10000010
 l_kd: kd, 1!000
 l_gn: gn, 1!000000010000000

Index s
 s_kd: kd, 1!111
 s_mg: mg, 1!110101100010

Index f
 f_kd: kd, 1!111
 f_nc: nc, 1!111111
 f_ml: ml, 1!111111111111111

Index m
 m_mq: mq, 1!11110101
 m_kd: kd, 1!110

Index w
 w_mg: mg, 1!001011000000
 w_ml: ml, 1!100011010101101

Index t
 t_kd: kd, 1!111

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_kd: kd, 1!111

Index g
 g_kd: kd, 1!111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11101011
Number mwA, 1, 0!00000001
Number rB, 1, 0!11111100
Number mwB, 1, 0!00001010
Number rC, 1, 0!11111111
Number mwC, 1, 0!00001111
Number rD, 1, 0!11111011
Number mwD, 1, 0!00100000
Number rE, 1, 0!01111111
Number mwE, 1, 0!00010000
Number rH, 1, 0!10111111
Number mwH, 1, 0!11111111
Number rI, 1, 0!11111110
Number mwI, 1, 0!00011110
Number rJ, 1, 0!11111100
Number mwJ, 1, 0!11110110
Number rK, 1, 0!10001000
Number mwK, 1, 0!00110111
Number rL, 1, 0!11100101
Number mwL, 1, 0!11111100
Number lr, 1, 0!00110
Number mb, 1, 0!01000000
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00000101
Number wq, 1, 0!00000010
Number wo, 1, 0!01110100
Number wa, 1, 0!00011101
Number wf, 1, 0!01010001
Number lf, 1, 0!00010000
Number bf, 1, 0!00000000
Number l2, 1, 0!00010000
Number l3, 1, 0!00010000
Number b2, 1, 0!00010000
Number b3, 1, 0!00010000
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!1011001
Number qf, 1, 3!1111010
Number bw, 1, 0!10000
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!10111100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
