#  dtsdpack's hit family at level -8: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l8/hit_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  Whether a subband sample's index is the one the audio's subband sample quantizes to (where the
#  WAV is bound), and if not, the one on the other side of the rounding boundary.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D8_hit
Debug 1
Const 0

Index a
 a_nr: nr, 1!000100100010011
 a_nl: nl, 1!000110010111001

Index b
 b_nr: nr, 1!000000010000101
 b_nl: nl, 1!001011111000010
 b_pm: pm, 1!01

Index c
 c_nr: nr, 1!100000000101001
 c_hm: hm, 1!01

Index d
 d_nl: nl, 1!000000000000000
 d_hm: hm, 1!10

Index e
 e_nr: nr, 1!010010011001111
 e_ab: ab, 1!000000000111110000000000010

Index h
 h_nl: nl, 1!100001110000000
 h_ab: ab, 1!001110001010101010111100010

Index i
 i_nr: nr, 1!000001000010001
 i_nl: nl, 1!111111000010010
 i_hm: hm, 1!11

Index j
 j_nr: nr, 1!000101101000100
 j_ql: ql, 1!100000110001000001000

Index k
 k_nl: nl, 1!000000000000011
 k_ql: ql, 1!110000000100000000000
 k_pm: pm, 1!11

Index l
 l_nr: nr, 1!000011100000010
 l_nl: nl, 1!010000000000100
 l_ab: ab, 1!010000010101001100000110000

Index s
 s_nr: nr, 1!000100000000010
 s_nl: nl, 1!000000100101000

Index f
 f_nr: nr, 1!000000000000010
 f_nl: nl, 1!000000011010100

Index m
 m_nl: nl, 1!000100011000001

Index w
 w_nr: nr, 1!000001000001101

Index t
 t_pm: pm, 1!11

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_pm: pm, 1!11

Index g
 g_pm: pm, 1!11

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11111001
Number mwA, 1, 0!00100011
Number rB, 1, 0!11111111
Number mwB, 1, 0!00001000
Number rC, 1, 0!11111111
Number mwC, 1, 0!00010000
Number rD, 1, 0!00000000
Number mwD, 1, 0!01000000
Number rE, 1, 0!11111111
Number mwE, 1, 0!11001110
Number rH, 1, 0!00000000
Number mwH, 1, 0!01100110
Number rI, 1, 0!11111111
Number mwI, 1, 0!00000100
Number rJ, 1, 0!00010000
Number mwJ, 1, 0!01000000
Number rK, 1, 0!00000000
Number mwK, 1, 0!00011001
Number rL, 1, 0!11001000
Number mwL, 1, 0!00000010
Number lr, 1, 0!01000
Number mb, 1, 0!00101111
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00011010
Number wq, 1, 0!00000000
Number wo, 1, 0!01000000
Number wa, 1, 0!00000000
Number wf, 1, 0!01010001
Number lf, 1, 0!01000000
Number bf, 1, 0!00000000
Number l2, 1, 0!00000110
Number l3, 1, 0!00011110
Number b2, 1, 0!11010010
Number b3, 1, 0!00011000
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!1111001
Number qf, 1, 3!0011111
Number bw, 1, 0!10000
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!10111100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
