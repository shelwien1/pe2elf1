#  dtsdpack's hdr family at level -8: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l8/hdr_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The core frame's header, its coding header and its subframes' headers, and the container's
#  kinds and lengths, each field its own values (fld), against its last values.
#  (The counters', mixers' and APMs' parameters start as ac3pack's hdr family's.)

Prefix D8_hdr
Debug 1
Const 0

Index a
 a_fld: fld, &011000

Index b
 b_fld: fld, &111111
 b_lv: lv, &011100

Index c
 c_fld: fld, &111111
 c_lv: lv, &001000
 c_l2: l2, 1!01

Index d
 d_fld: fld, &101110
 d_pos: pos, 1!0000000000000000000000001000000

Index e
 e_fld: fld, &100100
 e_st: st, 1!10
 e_nch: nch, 1!110

Index h
 h_fld: fld, &101010
 h_lv: lv, &000000
 h_pos: pos, 1!1000000000000000000001001000000

Index i
 i_fld: fld, &111100
 i_l2: l2, 1!00
 i_st: st, 1!00

Index j
 j_fld: fld, &000000
 j_lv: lv, &000000
 j_st: st, 1!00

Index k
 k_fld: fld, &101010
 k_pos: pos, 1!0001000000000000000000111000000
 k_l2: l2, 1!00

Index l
 l_fld: fld, &111110
 l_nch: nch, 1!110

Index s
 s_fld: fld, &111111
 s_l2: l2, 1!01

Index f
 f_fld: fld, &101100

Index m
 m_fld: fld, &111111

Index w
 w_l2: l2, 1!00
 w_st: st, 1!00

Index t
 t_fld: fld, &010110

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_fld: fld, &111111

Index g
 g_fld: fld, &111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!10000000
Number mwA, 1, 0!11011000
Number rB, 1, 0!00000000
Number mwB, 1, 0!00000110
Number rC, 1, 0!00000000
Number mwC, 1, 0!00000000
Number rD, 1, 0!00000000
Number mwD, 1, 0!00000000
Number rE, 1, 0!00110001
Number mwE, 1, 0!00011110
Number rH, 1, 0!00110000
Number mwH, 1, 0!00000110
Number rI, 1, 0!01100001
Number mwI, 1, 0!11111100
Number rJ, 1, 0!01100110
Number mwJ, 1, 0!00111000
Number rK, 1, 0!10000010
Number mwK, 1, 0!00000000
Number rL, 1, 0!00010000
Number mwL, 1, 0!00000011
Number lr, 1, 0!01110
Number mb, 1, 0!11011110
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00010011
Number wq, 1, 0!00000011
Number wo, 1, 0!01000000
Number wa, 1, 0!00011000
Number wf, 1, 0!01111111
Number lf, 1, 0!00010000
Number bf, 1, 0!10000000
Number l2, 1, 0!00010000
Number l3, 1, 0!10000000
Number b2, 1, 0!00000000
Number b3, 1, 0!00010000
Number rS1, 1, 0!00100
Number rS2, 1, 0!00000
Number qs, 1, 3!1110111
Number qf, 1, 3!0100001
Number bw, 1, 0!00000
Number rT, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!110
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00000000
Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
