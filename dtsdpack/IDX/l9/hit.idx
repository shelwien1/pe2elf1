#  dtsdpack's hit family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/hit_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  Whether a subband sample's index is the one the audio's subband sample quantizes to (where the
#  WAV is bound), and if not, the one on the other side of the rounding boundary.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_hit
Debug 1
Const 0

Index a
 a_nr: nr, 1!000010110010101
 a_nl: nl, 1!100101010011001

Index b
 b_nr: nr, 1!000000110110011
 b_nl: nl, 1!000000101101011
 b_pm: pm, 1!10

Index c
 c_nr: nr, 1!000000000000001
 c_hm: hm, 1!11

Index d
 d_nl: nl, 1!000000000000000
 d_hm: hm, 1!01

Index e
 e_nr: nr, 1!000010111000000
 e_ab: ab, 1!010110010111111000000100000

Index h
 h_nl: nl, 1!000000000000100
 h_ab: ab, 1!000111000001101000111000000

Index i
 i_nr: nr, 1!000000111000100
 i_nl: nl, 1!010000100000010
 i_hm: hm, 1!11

Index j
 j_nr: nr, 1!000000000000000
 j_ql: ql, 1!111110000000100000000

Index k
 k_nl: nl, 1!000000001001001
 k_ql: ql, 1!111100100011000000000
 k_pm: pm, 1!10

Index l
 l_nr: nr, 1!000000100100011
 l_nl: nl, 1!000001101010001
 l_ab: ab, 1!010010001011010000010010000

Index s
 s_nr: nr, 1!100000000001001
 s_nl: nl, 1!001000000010100

Index f
 f_nr: nr, 1!000000000000010
 f_nl: nl, 1!000000011010100

Index m
 m_nl: nl, 1!100010000000010

Index w
 w_nr: nr, 1!000000001000110

Index t
 t_pm: pm, 1!11

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_pm: pm, 1!11

Index g
 g_pm: pm, 1!11

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11001101
Number mwA, 1, 0!11111001
Number rB, 1, 0!10111100
Number mwB, 1, 0!00000000
Number rC, 1, 0!11111111
Number mwC, 1, 0!00010011
Number rD, 1, 0!00000000
Number mwD, 1, 0!00010100
Number rE, 1, 0!11101101
Number mwE, 1, 0!00000000
Number rH, 1, 0!00000000
Number mwH, 1, 0!00101111
Number rI, 1, 0!00000000
Number mwI, 1, 0!00100111
Number rJ, 1, 0!00000000
Number mwJ, 1, 0!00000010
Number rK, 1, 0!00000000
Number mwK, 1, 0!00001000
Number rL, 1, 0!11110101
Number mwL, 1, 0!00000000
Number lr, 1, 0!01111
Number mb, 1, 0!00100000
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), each mixer's in the final one (wf)
Number wp, 1, 0!00011011
Number wq, 1, 0!00000100
Number wo, 1, 0!01000000
Number wf, 1, 0!01010001
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!1111011
Number qf, 1, 3!0011111
Number bw, 1, 0!10000
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!10111100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
