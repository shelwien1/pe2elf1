#  dtsdpack's hit family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/hit_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  Whether a subband sample's index is the one the audio's subband sample quantizes to (where the
#  WAV is bound), and if not, the one on the other side of the rounding boundary.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_hit
Debug 1
Const 0

Index a
 a_nr: nr, 1!101000110100011
 a_nl: nl, 1!100111001111100

Index b
 b_nr: nr, 1!110010010101111
 b_nl: nl, 1!010000101101011
 b_pm: pm, 1!11

Index c
 c_nr: nr, 1!000000000000011
 c_hm: hm, 1!11

Index d
 d_nl: nl, 1!000000000000000
 d_hm: hm, 1!10

Index e
 e_nr: nr, 1!000000000000010
 e_ab: ab, 1!010001010100000000000000000

Index h
 h_nl: nl, 1!000000000111100
 h_ab: ab, 1!010100011111100101010100000

Index i
 i_nr: nr, 1!100000000001010
 i_nl: nl, 1!100000011011101
 i_hm: hm, 1!01

Index j
 j_nr: nr, 1!000101100001111
 j_ql: ql, 1!111111010000100000000

Index k
 k_nl: nl, 1!100011000000000
 k_ql: ql, 1!011000000000001000000
 k_pm: pm, 1!10

Index l
 l_nr: nr, 1!000000010110111
 l_nl: nl, 1!000011010111111
 l_ab: ab, 1!011111111010001000000000100

Index s
 s_nr: nr, 1!000000010010101
 s_nl: nl, 1!000100110010100

Index f
 f_nr: nr, 1!000000000000010
 f_nl: nl, 1!000000011010100

Index m
 m_nl: nl, 1!100000000000001

Index w
 w_nr: nr, 1!000000000100000

Index t
 t_pm: pm, 1!11

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_pm: pm, 1!11

Index g
 g_pm: pm, 1!11

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11111110
Number mwA, 1, 0!11100011
Number rB, 1, 0!01110110
Number mwB, 1, 0!00000000
Number rC, 1, 0!11111110
Number mwC, 1, 0!00000110
Number rD, 1, 0!00000000
Number mwD, 1, 0!00011111
Number rE, 1, 0!01111110
Number mwE, 1, 0!00000000
Number rH, 1, 0!10001001
Number mwH, 1, 0!00011010
Number rI, 1, 0!11101010
Number mwI, 1, 0!00110101
Number rJ, 1, 0!10000110
Number mwJ, 1, 0!00000001
Number rK, 1, 0!00000000
Number mwK, 1, 0!10000000
Number rL, 1, 0!11111101
Number mwL, 1, 0!00000011
Number lr, 1, 0!01111
Number mb, 1, 0!00100100
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!0010101
Number qf, 1, 3!0011111
Number bw, 1, 0!10000
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!10111100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
