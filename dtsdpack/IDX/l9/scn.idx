#  dtsdpack's scn family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/scn_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The scale factors of a channel the WAV doesn't bind, against the last ones (scl's until format
#  166, its start).

Prefix D9_scn
Debug 1
Const 0

Index a
 a_kd: kd, 1!001
 a_pk: pk, 1!0
 a_dp: dp, 1!1011111

Index b
 b_kd: kd, 1!000
 b_pk: pk, 1!0
 b_pn: pn, 1!0000001
 b_dp: dp, 1!1101001
 b_pl: pl, 1!001100001100010

Index c
 c_kd: kd, 1!000
 c_pk: pk, 1!0
 c_ab: ab, 1!001010001010001000100101000

Index d
 d_kd: kd, 1!110
 d_pk: pk, 1!1
 d_lp: lp, 1!101111111

Index e
 e_kd: kd, 1!110
 e_pk: pk, 1!0
 e_hm: hm, 1!10

Index h
 h_kd: kd, 1!101
 h_pk: pk, 1!0
 h_pn: pn, 1!1000101
 h_ab: ab, 1!101100010000101001000101100

Index i
 i_kd: kd, 1!001
 i_pk: pk, 1!0
 i_pm: pm, 1!1
 i_pn: pn, 1!0000001

Index j
 j_kd: kd, 1!000
 j_pk: pk, 1!1
 j_bd: bd, 1!1000100001000100001000100011111
 j_cc: cc, 1!11
 j_nb: nb, 1!100101000

Index k
 k_kd: kd, 1!000
 k_pk: pk, 1!0
 k_lp: lp, 1!100110011
 k_pn: pn, 1!1000011

Index l
 l_kd: kd, 1!100
 l_pk: pk, 1!0
 l_hm: hm, 1!11
 l_ab: ab, 1!100000000001000000000000100

Index s
 s_kd: kd, 1!100
 s_pk: pk, 1!0
 s_pn: pn, 1!0000011
 s_dp: dp, 1!1100100
 s_cc: cc, 1!11

Index f
 f_kd: kd, 1!110
 f_pk: pk, 1!1
 f_pl: pl, 1!001010110000010

Index m
 m_kd: kd, 1!110
 m_pk: pk, 1!1
 m_dp: dp, 1!0111010

Index w
 w_pn: pn, 1!0000000
 w_pl: pl, 1!100000000000000

Index t
 t_kd: kd, 1!110
 t_pk: pk, 1!0

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_kd: kd, 1!111

Index g
 g_kd: kd, 1!111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!00111111
Number rB, 1, 0!00000000
Number mwB, 1, 0!11110010
Number rC, 1, 0!00001011
Number mwC, 1, 0!11010111
Number rD, 1, 0!11110010
Number mwD, 1, 0!11011111
Number rE, 1, 0!00000000
Number mwE, 1, 0!11110000
Number rH, 1, 0!00010000
Number mwH, 1, 0!11110011
Number rI, 1, 0!11111010
Number mwI, 1, 0!01110000
Number rJ, 1, 0!01110000
Number mwJ, 1, 0!00000011
Number rK, 1, 0!00000000
Number mwK, 1, 0!11101000
Number rL, 1, 0!00000000
Number mwL, 1, 0!10100001
Number lr, 1, 0!01110
Number mb, 1, 0!00100000
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00111110
Number wq, 1, 0!00000011
Number wo, 1, 0!10001111
Number wa, 1, 0!00000000
Number wf, 1, 0!01001100
Number lf, 1, 0!00010000
Number bf, 1, 0!00000000
Number l2, 1, 0!01100000
Number l3, 1, 0!00011110
Number b2, 1, 0!00000100
Number b3, 1, 0!00010010
Number rS1, 1, 0!10000
Number rS2, 1, 0!01000
Number qs, 1, 3!0000000
Number qf, 1, 3!1011010
Number bw, 1, 0!01110
Number rT, 1, 0!00010000
Number mwT, 1, 0!01101110
Number mt, 1, 0!110
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00000010
Number mwG, 1, 0!00111111

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
