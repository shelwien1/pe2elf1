#  dtsdpack's smd family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/smd_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A decoded WAV's subband samples' quantization indexes otherwise (smp's until format 132: where
#  the scale factor search or the bit allocation search shows the WAV decoded), against the index
#  the audio quantizes to, else against their neighbours'.
#  (The counters', mixers' and APMs' parameters start as ac3pack's mag family's.)

Prefix D9_smd
Debug 1
Const 0

Index a
 a_pk: pk, 1!0
 a_nr: nr, 1!000001001000000
 a_nl: nl, 1!100000000000001

Index b
 b_pk: pk, 1!1
 b_ab: ab, 1!000001010110101110101100000
 b_ql: ql, 1!111101111001100000000

Index c
 c_pk: pk, 1!0
 c_nr: nr, 1!000000000000000
 c_hm: hm, 1!11

Index d
 d_pk: pk, 1!1
 d_ab: ab, 1!001101100111000100101000000
 d_m1: m1, 1!1101111100011010000000

Index e
 e_pk: pk, 1!1
 e_ab: ab, 1!000001011011001100001000000
 e_m1: m1, 1!1001001110111000000000
 e_m2: m2, 1!1011111110101110000000

Index h
 h_pk: pk, 1!1
 h_ab: ab, 1!010111010110110101100000000
 h_nr: nr, 1!001001110100000

Index i
 i_pk: pk, 1!1
 i_ab: ab, 1!010000001011010011101001000
 i_hw: hw, 1!000
 i_pm: pm, 1!1

Index j
 j_pk: pk, 1!1
 j_ab: ab, 1!000101011111100010100000000
 j_bd: bd, 1!1011101010111101010000011001101

Index k
 k_pk: pk, 1!0
 k_nr: nr, 1!100100100000001
 k_pm: pm, 1!1

Index l
 l_pk: pk, 1!1
 l_nl: nl, 1!000111001111110
 l_ab: ab, 1!011101101111111010110100000

Index s
 s_pk: pk, 1!0
 s_nr: nr, 1!000000000101111
 s_nl: nl, 1!111111110010000

Index f
 f_pk: pk, 1!1
 f_nl: nl, 1!001011100001001
 f_nr: nr, 1!010000010101000

Index m
 m_pk: pk, 1!0
 m_nr: nr, 1!000010000000000

Index w
 w_nl: nl, 1!000000000000000

Index t
 t_ab: ab, 1!000000011011111111110100000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_ab: ab, 1!111111111111111111111111111

Index g

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!11000111
Number rB, 1, 0!10000011
Number mwB, 1, 0!00000000
Number rC, 1, 0!00000000
Number mwC, 1, 0!11101100
Number rD, 1, 0!00001000
Number mwD, 1, 0!10111010
Number rE, 1, 0!00110010
Number mwE, 1, 0!00010000
Number rH, 1, 0!11111110
Number mwH, 1, 0!00000001
Number rI, 1, 0!11110000
Number mwI, 1, 0!01101000
Number rJ, 1, 0!00011100
Number mwJ, 1, 0!00000001
Number rK, 1, 0!10010010
Number mwK, 1, 0!11100111
Number rL, 1, 0!11111110
Number mwL, 1, 0!01000101
Number lr, 1, 0!10000
Number mb, 1, 0!00100000
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00011111
Number wq, 1, 0!00000000
Number wo, 1, 0!01000000
Number wa, 1, 0!00000011
Number wf, 1, 0!01001111
Number lf, 1, 0!00001000
Number bf, 1, 0!00000010
Number l2, 1, 0!10000000
Number l3, 1, 0!00101100
Number b2, 1, 0!00010101
Number b3, 1, 0!00000010
Number rS1, 1, 0!00111
Number rS2, 1, 0!01000
Number qs, 1, 3!1110100
Number qf, 1, 3!0111110
Number bw, 1, 0!01110
Number rT, 1, 0!00001001
Number mwT, 1, 0!11110001
Number mt, 1, 0!110
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
