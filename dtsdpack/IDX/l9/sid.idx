#  dtsdpack's sid family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/sid_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A subband's side information (PMODE, PVQ, TMODE, the joint scale factors, the HF VQ vectors)
#  and the LFE samples, each field against its last value and the place before's.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_sid
Debug 1
Const 0

Index a
 a_fld: fld, 1!11111111
 a_lv: lv, &000011

Index b
 b_fld: fld, 1!00100000
 b_lv: lv, &000011
 b_pq: pq, &111111

Index c
 c_fld: fld, 1!11111111
 c_bd: bd, 1!1110001010011010010111110111011
 c_lv: lv, &111111

Index d
 d_fld: fld, 1!00100010
 d_ac: ac, 1!11110111
 d_lv: lv, &000011

Index e
 e_fld: fld, 1!00000000
 e_cc: cc, 1!11
 e_bd: bd, 1!0011111110011111111111101010001

Index h
 h_fld: fld, 1!00010000
 h_ab: ab, 1!000110110000000001011110110
 h_lv: lv, &111111

Index i
 i_fld: fld, 1!11111111
 i_ec: ec, 1!011111001
 i_lv: lv, &000001

Index j
 j_fld: fld, 1!11111111
 j_pq: pq, &000000
 j_st: st, 1!10

Index k
 k_fld: fld, 1!00000010
 k_bd: bd, 1!1100000101100100000100000010011
 k_ac: ac, 1!11010100

Index l
 l_fld: fld, 1!11111111
 l_lv: lv, &000011
 l_ab: ab, 1!111111101000110000001101110
 l_ac: ac, 1!11101111

Index s
 s_fld: fld, 1!11111111
 s_lv: lv, &000001

Index f
 f_fld: fld, 1!00010010
 f_ac: ac, 1!11111110

Index m
 m_fld: fld, 1!01110000

Index w
 w_st: st, 1!11

Index t
 t_fld: fld, 1!11111111

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_fld: fld, 1!11111111

Index g
 g_fld: fld, 1!11111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!10111011
Number mwA, 1, 0!10100111
Number rB, 1, 0!11110100
Number mwB, 1, 0!00011111
Number rC, 1, 0!11111100
Number mwC, 1, 0!00000010
Number rD, 1, 0!11111001
Number mwD, 1, 0!00100111
Number rE, 1, 0!11111100
Number mwE, 1, 0!00010111
Number rH, 1, 0!00000000
Number mwH, 1, 0!10011100
Number rI, 1, 0!11111101
Number mwI, 1, 0!00000000
Number rJ, 1, 0!00110011
Number mwJ, 1, 0!00010110
Number rK, 1, 0!11101101
Number mwK, 1, 0!00000010
Number rL, 1, 0!11111110
Number mwL, 1, 0!00000000
Number lr, 1, 0!01111
Number mb, 1, 0!01100000
Number rS1, 1, 0!01000
Number rS2, 1, 0!00100
Number qs, 1, 3!1111000
Number qf, 1, 3!0111111
Number bw, 1, 0!01100
Number rT, 1, 0!11111110
Number mwT, 1, 0!00000000
Number mt, 1, 0!000
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!01011000
Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
