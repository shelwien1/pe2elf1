#  dtsdpack's hdr family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/hdr_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The core frame's header, its coding header and its subframes' headers, and the container's
#  kinds and lengths, each field its own values (fld), against its last values.
#  (The counters', mixers' and APMs' parameters start as ac3pack's hdr family's.)

Prefix D9_hdr
Debug 1
Const 0

Index a
 a_fld: fld, &011000

Index b
 b_fld: fld, &101111
 b_lv: lv, &011100

Index c
 c_fld: fld, &000001
 c_lv: lv, &001001
 c_l2: l2, 1!01

Index d
 d_fld: fld, &111011
 d_pos: pos, 1!0100100000000000000000001000000

Index e
 e_fld: fld, &000010
 e_st: st, 1!11
 e_nch: nch, 1!100

Index h
 h_fld: fld, &111011
 h_lv: lv, &010011
 h_pos: pos, 1!1000110000010000000110001000000

Index i
 i_fld: fld, &110100
 i_l2: l2, 1!11
 i_st: st, 1!11

Index j
 j_fld: fld, &100100
 j_lv: lv, &000100
 j_st: st, 1!11

Index k
 k_fld: fld, &101110
 k_pos: pos, 1!0000101000010000000100001000000
 k_l2: l2, 1!00

Index l
 l_fld: fld, &101110
 l_nch: nch, 1!110

Index s
 s_fld: fld, &111111
 s_l2: l2, 1!01

Index f
 f_fld: fld, &111111

Index m
 m_fld: fld, &111111

Index w
 w_l2: l2, 1!00
 w_st: st, 1!11

Index t
 t_fld: fld, &010110

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_fld: fld, &111111

Index g
 g_fld: fld, &111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!10001111
Number rB, 1, 0!00000000
Number mwB, 1, 0!00000000
Number rC, 1, 0!11010110
Number mwC, 1, 0!01111101
Number rD, 1, 0!00000000
Number mwD, 1, 0!00000000
Number rE, 1, 0!00101000
Number mwE, 1, 0!00011101
Number rH, 1, 0!01011111
Number mwH, 1, 0!00000000
Number rI, 1, 0!01100010
Number mwI, 1, 0!10001110
Number rJ, 1, 0!01100101
Number mwJ, 1, 0!00011100
Number rK, 1, 0!10000100
Number mwK, 1, 0!00100100
Number rL, 1, 0!00000000
Number mwL, 1, 0!10000101
Number lr, 1, 0!01111
Number mb, 1, 0!11010100
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113)
Number wp, 1, 0!00010011
Number wq, 1, 0!00000010
Number wo, 1, 0!01000000
Number wa, 1, 0!00010000
Number wf, 1, 0!01001111
Number lf, 1, 0!00010000
Number bf, 1, 0!00010000
Number rS1, 1, 0!00011
Number rS2, 1, 0!01000
Number qs, 1, 3!1110011
Number qf, 1, 3!0100001
Number bw, 1, 0!00101
Number rT, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!110
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00000000
Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
