#  dtsdpack's hdr family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/hdr_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The core frame's header, its coding header and its subframes' headers, and the container's
#  kinds and lengths, each field its own values (fld), against its last values.
#  (The counters', mixers' and APMs' parameters start as ac3pack's hdr family's.)

Prefix D9_hdr
Debug 1
Const 0

Index a
 a_fld: fld, &101110

Index b
 b_fld: fld, &110111
 b_lv: lv, &000001

Index c
 c_fld: fld, &100100
 c_lv: lv, &001101
 c_l2: l2, 1!00

Index d
 d_fld: fld, &101011
 d_pos: pos, 1!0000100000000000000000001000000

Index e
 e_fld: fld, &000010
 e_st: st, 1!01
 e_nch: nch, 1!000

Index h
 h_fld: fld, &011011
 h_lv: lv, &000111
 h_pos: pos, 1!1000000000000000000000001000000

Index i
 i_fld: fld, &111100
 i_l2: l2, 1!11
 i_st: st, 1!10

Index j
 j_fld: fld, &111101
 j_lv: lv, &000001
 j_st: st, 1!10

Index k
 k_fld: fld, &111111
 k_pos: pos, 1!0000000000000000000000001000000
 k_l2: l2, 1!00

Index l
 l_fld: fld, &100100
 l_nch: nch, 1!100

Index s
 s_fld: fld, &101110
 s_l2: l2, 1!01

Index f
 f_fld: fld, &111101

Index m
 m_fld: fld, &111111

Index w
 w_l2: l2, 1!00
 w_st: st, 1!11

Index t
 t_fld: fld, &010110

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_fld: fld, &111111

Index g
 g_fld: fld, &111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!01011100
Number rB, 1, 0!00110111
Number mwB, 1, 0!01010001
Number rC, 1, 0!11111110
Number mwC, 1, 0!00001100
Number rD, 1, 0!00101010
Number mwD, 1, 0!00001001
Number rE, 1, 0!10111000
Number mwE, 1, 0!11111101
Number rH, 1, 0!10001000
Number mwH, 1, 0!00000000
Number rI, 1, 0!00010000
Number mwI, 1, 0!00000100
Number rJ, 1, 0!00011110
Number mwJ, 1, 0!01000000
Number rK, 1, 0!11111000
Number mwK, 1, 0!00001000
Number rL, 1, 0!01101000
Number mwL, 1, 0!00000111
Number lr, 1, 0!01111
Number mb, 1, 0!10111101
Number rS1, 1, 0!00000
Number rS2, 1, 0!01000
Number qs, 1, 3!0000111
Number qf, 1, 3!0010001
Number bw, 1, 0!00000
Number rT, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!110
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!01001000
Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
