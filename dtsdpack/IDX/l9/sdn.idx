#  dtsdpack's sdn family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/sdn_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The side information of a channel the WAV doesn't bind, and the LFE samples where the LFE
#  isn't bound, each field against its last value and the place before's (sid's, then sdd's,
#  until format 167; sdd's its start).

Prefix D9_sdn
Debug 1
Const 0

Index a
 a_fld: fld, 1!00100100
 a_lv: lv, &000011

Index b
 b_fld: fld, 1!00001000
 b_lv: lv, &000111
 b_pq: pq, &000000

Index c
 c_fld: fld, 1!00100000
 c_bd: bd, 1!1111111111111111111000000100001
 c_lv: lv, &000001

Index d
 d_fld: fld, 1!00010000
 d_ac: ac, 1!10000110
 d_lv: lv, &000011

Index e
 e_fld: fld, 1!00100100
 e_cc: cc, 1!11
 e_bd: bd, 1!1111111111111111111111101000111

Index h
 h_fld: fld, 1!00010100
 h_ab: ab, 1!111000011010111111001110101
 h_lv: lv, &100011
 h_tr: tr, 1!110101111111111111111

Index i
 i_fld: fld, 1!00010100
 i_ec: ec, 1!001010010
 i_lv: lv, &000001
 i_tr: tr, 1!11100

Index j
 j_fld: fld, 1!00000100
 j_pq: pq, &000101
 j_st: st, 1!11

Index k
 k_fld: fld, 1!00100000
 k_bd: bd, 1!0000000100110010000000000001011
 k_ac: ac, 1!11111110

Index l
 l_fld: fld, 1!00000100
 l_lv: lv, &000011
 l_ab: ab, 1!111110100101000101111000101
 l_ac: ac, 1!01101110

Index s
 s_fld: fld, 1!00100100
 s_lv: lv, &000011

Index f
 f_fld: fld, 1!00010010
 f_ac: ac, 1!11111110

Index m
 m_fld: fld, 1!00100100

Index w
 w_st: st, 1!01

Index t
 t_fld: fld, 1!00000000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_fld: fld, 1!11111111

Index g
 g_fld: fld, 1!11111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!01000001
Number rB, 1, 0!00000000
Number mwB, 1, 0!11111100
Number rC, 1, 0!00000000
Number mwC, 1, 0!00100000
Number rD, 1, 0!00000000
Number mwD, 1, 0!01011110
Number rE, 1, 0!01000010
Number mwE, 1, 0!00000000
Number rH, 1, 0!11111110
Number mwH, 1, 0!00000000
Number rI, 1, 0!00000000
Number mwI, 1, 0!00110010
Number rJ, 1, 0!00000000
Number mwJ, 1, 0!00111000
Number rK, 1, 0!01101000
Number mwK, 1, 0!00000010
Number rL, 1, 0!01100100
Number mwL, 1, 0!00010000
Number lr, 1, 0!01011
Number mb, 1, 0!01000000
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00100011
Number wq, 1, 0!00000000
Number wo, 1, 0!01101000
Number wa, 1, 0!00011101
Number wf, 1, 0!01001000
Number lf, 1, 0!00010110
Number bf, 1, 0!00000101
Number l2, 1, 0!00000000
Number l3, 1, 0!00001101
Number b2, 1, 0!01000000
Number b3, 1, 0!10000000
Number rS1, 1, 0!01000
Number rS2, 1, 0!00100
Number qs, 1, 3!1110011
Number qf, 1, 3!0111111
Number bw, 1, 0!10000
Number rT, 1, 0!01010000
Number mwT, 1, 0!11111111
Number mt, 1, 0!110
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00000000
Number mwG, 1, 0!10111111

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
