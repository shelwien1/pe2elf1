#  dtsdpack's scl family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/scl_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The scale factors, against the one the audio's RMS makes (where the WAV is bound), else the last.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_scl
Debug 1
Const 0

Index a
 a_kd: kd, 1!001
 a_pk: pk, 1!1
 a_dp: dp, 1!1100110

Index b
 b_kd: kd, 1!100
 b_pk: pk, 1!1
 b_pn: pn, 1!1101000
 b_dp: dp, 1!1101010
 b_pl: pl, 1!001000001100010

Index c
 c_kd: kd, 1!000
 c_pk: pk, 1!1
 c_ab: ab, 1!001100000001010000000000100

Index d
 d_kd: kd, 1!000
 d_pk: pk, 1!1
 d_lp: lp, 1!101110011

Index e
 e_kd: kd, 1!000
 e_pk: pk, 1!1
 e_hm: hm, 1!01

Index h
 h_kd: kd, 1!101
 h_pk: pk, 1!1
 h_pn: pn, 1!1001101
 h_ab: ab, 1!101111111110010000000000100

Index i
 i_kd: kd, 1!001
 i_pk: pk, 1!1
 i_pm: pm, 1!1
 i_pn: pn, 1!0110111

Index j
 j_kd: kd, 1!100
 j_pk: pk, 1!1
 j_bd: bd, 1!0011110110110001011100100010001
 j_cc: cc, 1!10
 j_nb: nb, 1!000010011

Index k
 k_kd: kd, 1!000
 k_pk: pk, 1!1
 k_lp: lp, 1!111100011
 k_pn: pn, 1!1010001

Index l
 l_kd: kd, 1!001
 l_pk: pk, 1!1
 l_hm: hm, 1!01
 l_ab: ab, 1!000000010111011001100101100

Index s
 s_kd: kd, 1!101
 s_pk: pk, 1!1
 s_pn: pn, 1!1000001
 s_dp: dp, 1!1101010
 s_cc: cc, 1!10

Index f
 f_kd: kd, 1!011
 f_pk: pk, 1!1
 f_pl: pl, 1!001010110000110

Index m
 m_kd: kd, 1!000
 m_pk: pk, 1!1
 m_dp: dp, 1!1010011

Index w
 w_pn: pn, 1!0000000
 w_pl: pl, 1!100000000000000

Index t
 t_kd: kd, 1!001
 t_pk: pk, 1!1

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_kd: kd, 1!111

Index g
 g_kd: kd, 1!111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!00110111
Number rB, 1, 0!11111100
Number mwB, 1, 0!10001010
Number rC, 1, 0!11011101
Number mwC, 1, 0!10001101
Number rD, 1, 0!11110101
Number mwD, 1, 0!10011111
Number rE, 1, 0!11001010
Number mwE, 1, 0!11111000
Number rH, 1, 0!11100100
Number mwH, 1, 0!00000000
Number rI, 1, 0!11111011
Number mwI, 1, 0!00000000
Number rJ, 1, 0!01000000
Number mwJ, 1, 0!00000100
Number rK, 1, 0!00000000
Number mwK, 1, 0!11110010
Number rL, 1, 0!00000000
Number mwL, 1, 0!01111000
Number lr, 1, 0!01111
Number mb, 1, 0!00100111
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00110101
Number wq, 1, 0!00000110
Number wo, 1, 0!01000000
Number wa, 1, 0!00000100
Number wf, 1, 0!01001111
Number lf, 1, 0!00011111
Number bf, 1, 0!00000001
Number l2, 1, 0!00000000
Number l3, 1, 0!00011000
Number b2, 1, 0!10000000
Number b3, 1, 0!00010001
Number rS1, 1, 0!10000
Number rS2, 1, 0!00101
Number qs, 1, 3!0000001
Number qf, 1, 3!0010001
Number bw, 1, 0!01000
Number rT, 1, 0!10000000
Number mwT, 1, 0!01100000
Number mt, 1, 0!110
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00001000
Number mwG, 1, 0!00010010

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
