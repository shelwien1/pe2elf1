#  dtsdpack's scl family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/scl_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The scale factors, against the one the audio's RMS makes (where the WAV is bound), else the last.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_scl
Debug 1
Const 0

Index a
 a_kd: kd, 1!000
 a_pk: pk, 1!1
 a_dp: dp, 1!1110011

Index b
 b_kd: kd, 1!111
 b_pk: pk, 1!1
 b_pn: pn, 1!0111010
 b_dp: dp, 1!1110111
 b_pl: pl, 1!111000001111010

Index c
 c_kd: kd, 1!100
 c_pk: pk, 1!1
 c_ab: ab, 1!000100001101111011010011000

Index d
 d_kd: kd, 1!001
 d_pk: pk, 1!1
 d_lp: lp, 1!011100011

Index e
 e_kd: kd, 1!001
 e_pk: pk, 1!1
 e_hm: hm, 1!01

Index h
 h_kd: kd, 1!001
 h_pk: pk, 1!1
 h_pn: pn, 1!1001011
 h_ab: ab, 1!101001001010001101000000000

Index i
 i_kd: kd, 1!011
 i_pk: pk, 1!1
 i_pm: pm, 1!1
 i_pn: pn, 1!0010011

Index j
 j_kd: kd, 1!110
 j_pk: pk, 1!1
 j_bd: bd, 1!0000000010000010001000100110011
 j_cc: cc, 1!10
 j_nb: nb, 1!000111101

Index k
 k_kd: kd, 1!110
 k_pk: pk, 1!1
 k_lp: lp, 1!101011101
 k_pn: pn, 1!0011100

Index l
 l_kd: kd, 1!101
 l_pk: pk, 1!1
 l_hm: hm, 1!01
 l_ab: ab, 1!011100110011010000111111100

Index s
 s_kd: kd, 1!110
 s_pk: pk, 1!1
 s_pn: pn, 1!1000101
 s_dp: dp, 1!1101111
 s_cc: cc, 1!11

Index f
 f_kd: kd, 1!111
 f_pk: pk, 1!1
 f_pl: pl, 1!111110100001010

Index m
 m_kd: kd, 1!010
 m_pk: pk, 1!1
 m_dp: dp, 1!0001110

Index w
 w_pn: pn, 1!0000000
 w_pl: pl, 1!000100000000101

Index t
 t_kd: kd, 1!111
 t_pk: pk, 1!1

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_kd: kd, 1!111

Index g
 g_kd: kd, 1!111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!01111111
Number rB, 1, 0!11000011
Number mwB, 1, 0!00001001
Number rC, 1, 0!00100110
Number mwC, 1, 0!11110100
Number rD, 1, 0!00000000
Number mwD, 1, 0!11110000
Number rE, 1, 0!00000010
Number mwE, 1, 0!11111001
Number rH, 1, 0!11111100
Number mwH, 1, 0!00000011
Number rI, 1, 0!01000000
Number mwI, 1, 0!00000001
Number rJ, 1, 0!11111110
Number mwJ, 1, 0!00000100
Number rK, 1, 0!00101000
Number mwK, 1, 0!11100111
Number rL, 1, 0!00000000
Number mwL, 1, 0!01011111
Number lr, 1, 0!01111
Number mb, 1, 0!01111000
Number rS1, 1, 0!10000
Number rS2, 1, 0!01000
Number qs, 1, 3!1001101
Number qf, 1, 3!0010001
Number bw, 1, 0!01000
Number rT, 1, 0!00000100
Number mwT, 1, 0!00110001
Number mt, 1, 0!110
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00100000
Number mwG, 1, 0!00001100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
