#  dtsdpack's scl family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/scl_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The scale factors, against the one the audio's RMS makes (where the WAV is bound), else the last.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_scl
Debug 1
Const 0

Index a
 a_kd: kd, 1!000
 a_pk: pk, 1!1
 a_dp: dp, 1!1010110

Index b
 b_kd: kd, 1!111
 b_pk: pk, 1!1
 b_pn: pn, 1!0100000
 b_dp: dp, 1!1100110
 b_pl: pl, 1!100000011100110

Index c
 c_kd: kd, 1!000
 c_pk: pk, 1!1
 c_ab: ab, 1!001100100000000001110000100

Index d
 d_kd: kd, 1!000
 d_pk: pk, 1!1
 d_lp: lp, 1!010101000

Index e
 e_kd: kd, 1!010
 e_pk: pk, 1!1
 e_hm: hm, 1!01

Index h
 h_kd: kd, 1!001
 h_pk: pk, 1!1
 h_pn: pn, 1!1001011
 h_ab: ab, 1!101001101010010101000000000

Index i
 i_kd: kd, 1!011
 i_pk: pk, 1!1
 i_pm: pm, 1!1
 i_pn: pn, 1!0010011

Index j
 j_kd: kd, 1!010
 j_pk: pk, 1!1
 j_bd: bd, 1!0000000010100000011000100010011
 j_cc: cc, 1!10
 j_nb: nb, 1!000010001

Index k
 k_kd: kd, 1!000
 k_pk: pk, 1!1
 k_lp: lp, 1!111011111
 k_pn: pn, 1!1011101

Index l
 l_kd: kd, 1!101
 l_pk: pk, 1!1
 l_hm: hm, 1!01
 l_ab: ab, 1!011000110111000000111100000

Index s
 s_kd: kd, 1!110
 s_pk: pk, 1!1
 s_pn: pn, 1!1000101
 s_dp: dp, 1!1101110
 s_cc: cc, 1!11

Index f
 f_kd: kd, 1!001
 f_pk: pk, 1!1
 f_pl: pl, 1!001010000000010

Index m
 m_kd: kd, 1!010
 m_pk: pk, 1!1
 m_dp: dp, 1!1000011

Index w
 w_pn: pn, 1!0000000
 w_pl: pl, 1!100000001001100

Index t
 t_kd: kd, 1!011
 t_pk: pk, 1!1

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_kd: kd, 1!111

Index g
 g_kd: kd, 1!111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!01111111
Number rB, 1, 0!11011111
Number mwB, 1, 0!01001010
Number rC, 1, 0!00011001
Number mwC, 1, 0!11111110
Number rD, 1, 0!00000000
Number mwD, 1, 0!11111110
Number rE, 1, 0!00000000
Number mwE, 1, 0!11111111
Number rH, 1, 0!11111111
Number mwH, 1, 0!00000011
Number rI, 1, 0!01001101
Number mwI, 1, 0!00000000
Number rJ, 1, 0!11111101
Number mwJ, 1, 0!00000100
Number rK, 1, 0!00000000
Number mwK, 1, 0!11101111
Number rL, 1, 0!00000000
Number mwL, 1, 0!01011110
Number lr, 1, 0!01111
Number mb, 1, 0!01111001
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
Number wp, 1, 0!00110101
Number wq, 1, 0!00000011
Number wo, 1, 0!01000000
Number wa, 1, 0!00001100
Number wf, 1, 0!01011111
Number lf, 1, 0!00010000
Number bf, 1, 0!00010000
Number l2, 1, 0!00000000
Number l3, 1, 0!00010000
Number rS1, 1, 0!10000
Number rS2, 1, 0!00100
Number qs, 1, 3!1000101
Number qf, 1, 3!0010011
Number bw, 1, 0!01000
Number rT, 1, 0!00000100
Number mwT, 1, 0!00100101
Number mt, 1, 0!110
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00100000
Number mwG, 1, 0!00001000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
