#  dtsdpack's vqr family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/vqr_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The ranks of the ADPCM predictors and the HF VQ vectors among the code books' entries, in the
#  order of the encoder's searches on the audio (where the WAV is bound).
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_vqr
Debug 1
Const 0

Index a
 a_kd: kd, 1!000
 a_mg: mg, 1!100000001000
 a_nc: nc, 1!011010
 a_ml: ml, 1!011111101000101
 a_gr: gr, 1!1100010

Index b
 b_kd: kd, 1!110
 b_mg: mg, 1!101100110001
 b_gn: gn, 1!111100001000000

Index c
 c_kd: kd, 1!111
 c_bd: bd, 1!1000010000000011100001100000111
 c_mg: mg, 1!010010000011

Index d
 d_kd: kd, 1!000
 d_lh: lh, 1!10
 d_mg: mg, 1!010010000000
 d_gr: gr, 1!1101000

Index e
 e_kd: kd, 1!101
 e_cc: cc, 1!10
 e_bd: bd, 1!0000011110100000000000000011111

Index h
 h_kd: kd, 1!101
 h_gn: gn, 1!111111010000000
 h_lh: lh, 1!11

Index i
 i_kd: kd, 1!010
 i_mg: mg, 1!101000000001
 i_lh: lh, 1!11
 i_gn: gn, 1!100111010000000

Index j
 j_kd: kd, 1!101
 j_bd: bd, 1!1100000000000000000000000011001
 j_lh: lh, 1!10

Index k
 k_kd: kd, 1!111
 k_cc: cc, 1!11
 k_mg: mg, 1!111110100001

Index l
 l_mq: mq, 1!01110110
 l_kd: kd, 1!010
 l_gn: gn, 1!000010110000000

Index s
 s_kd: kd, 1!111
 s_mg: mg, 1!101011000001

Index f
 f_kd: kd, 1!111
 f_nc: nc, 1!111111
 f_ml: ml, 1!111111111111111

Index m
 m_mq: mq, 1!10110101
 m_kd: kd, 1!110

Index w
 w_mg: mg, 1!000100000000
 w_ml: ml, 1!000011010100100

Index t
 t_kd: kd, 1!111

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_kd: kd, 1!111

Index g
 g_kd: kd, 1!111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11111110
Number mwA, 1, 0!00000010
Number rB, 1, 0!11111101
Number mwB, 1, 0!00000110
Number rC, 1, 0!01111111
Number mwC, 1, 0!00000000
Number rD, 1, 0!11111111
Number mwD, 1, 0!00010000
Number rE, 1, 0!10111111
Number mwE, 1, 0!10111110
Number rH, 1, 0!10110101
Number mwH, 1, 0!11111111
Number rI, 1, 0!11110011
Number mwI, 1, 0!01111011
Number rJ, 1, 0!11110011
Number mwJ, 1, 0!11011100
Number rK, 1, 0!00101100
Number mwK, 1, 0!01110011
Number rL, 1, 0!00011111
Number mwL, 1, 0!11111100
Number lr, 1, 0!00111
Number mb, 1, 0!01101011
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), each mixer's in the final one (wf)
Number wp, 1, 0!00011000
Number wq, 1, 0!00001000
Number wo, 1, 0!01000000
Number wf, 1, 0!01010100
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!0101111
Number qf, 1, 3!1111010
Number bw, 1, 0!10000
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!10111100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
