#  dtsdpack's vqr family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/vqr_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The ranks of the ADPCM predictors and the HF VQ vectors among the code books' entries, in the
#  order of the encoder's searches on the audio (where the WAV is bound).
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_vqr
Debug 1
Const 0

Index a
 a_kd: kd, 1!010
 a_mg: mg, 1!101110010000

Index b
 b_kd: kd, 1!111
 b_mg: mg, 1!101101100101
 b_gn: gn, 1!111111000000000

Index c
 c_kd: kd, 1!111
 c_bd: bd, 1!0010000000000010000001100000111
 c_mg: mg, 1!111110010001

Index d
 d_kd: kd, 1!101
 d_lh: lh, 1!00
 d_mg: mg, 1!000000001000

Index e
 e_kd: kd, 1!111
 e_cc: cc, 1!11
 e_bd: bd, 1!0000000001101000000001111101111

Index h
 h_kd: kd, 1!010
 h_gn: gn, 1!100110010110000
 h_lh: lh, 1!11

Index i
 i_kd: kd, 1!011
 i_mg: mg, 1!010010100000
 i_lh: lh, 1!11
 i_gn: gn, 1!101111000000000

Index j
 j_kd: kd, 1!101
 j_bd: bd, 1!1000000000000000000000000010001
 j_lh: lh, 1!00

Index k
 k_kd: kd, 1!111
 k_cc: cc, 1!11
 k_mg: mg, 1!101101101111

Index l
 l_kd: kd, 1!000
 l_gn: gn, 1!000011010110000

Index s
 s_kd: kd, 1!111
 s_mg: mg, 1!101011000001

Index f
 f_kd: kd, 1!111
 f_gn: gn, 1!111111100011000

Index m
 m_kd: kd, 1!110

Index w
 w_mg: mg, 1!010100000011

Index t
 t_kd: kd, 1!111

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_kd: kd, 1!111

Index g
 g_kd: kd, 1!111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00101011
Number mwA, 1, 0!00101000
Number rB, 1, 0!11111110
Number mwB, 1, 0!00000000
Number rC, 1, 0!10111011
Number mwC, 1, 0!00000000
Number rD, 1, 0!11010111
Number mwD, 1, 0!10101110
Number rE, 1, 0!10101010
Number mwE, 1, 0!00000000
Number rH, 1, 0!11101000
Number mwH, 1, 0!10000010
Number rI, 1, 0!11011101
Number mwI, 1, 0!00000000
Number rJ, 1, 0!11001001
Number mwJ, 1, 0!01110010
Number rK, 1, 0!11111110
Number mwK, 1, 0!00000010
Number rL, 1, 0!11001100
Number mwL, 1, 0!10011111
Number lr, 1, 0!00111
Number mb, 1, 0!01101111
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!0010011
Number qf, 1, 3!1111010
Number bw, 1, 0!10000
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!10111100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
