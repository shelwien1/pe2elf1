#  dtsdpack's vqr family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/vqr_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The ranks of the ADPCM predictors and the HF VQ vectors among the code books' entries, in the
#  order of the encoder's searches on the audio (where the WAV is bound).
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_vqr
Debug 1
Const 0

Index a
 a_kd: kd, 1!01
 a_mg: mg, 1!111111111111

Index b
 b_kd: kd, 1!01
 b_mg: mg, 1!000000000000
 b_gn: gn, 1!000100000000000

Index c
 c_kd: kd, 1!11
 c_bd: bd, 1!0010000100001000100000010000011
 c_mg: mg, 1!111111111111

Index d
 d_kd: kd, 1!11
 d_lh: lh, 1!11
 d_mg: mg, 1!111111111111

Index e
 e_kd: kd, 1!01
 e_cc: cc, 1!11
 e_bd: bd, 1!1110101000100110010010000010111

Index h
 h_kd: kd, 1!01
 h_gn: gn, 1!000100000000000
 h_lh: lh, 1!00

Index i
 i_kd: kd, 1!10
 i_mg: mg, 1!111111111111
 i_lh: lh, 1!11
 i_gn: gn, 1!110010000000000

Index j
 j_kd: kd, 1!11
 j_bd: bd, 1!1011101101111011100101000100111
 j_lh: lh, 1!00

Index k
 k_kd: kd, 1!11
 k_cc: cc, 1!11
 k_mg: mg, 1!111111111111

Index l
 l_kd: kd, 1!00
 l_gn: gn, 1!000001000000000

Index s
 s_kd: kd, 1!10
 s_mg: mg, 1!111111111111

Index f
 f_kd: kd, 1!11
 f_gn: gn, 1!111010000000000

Index m
 m_kd: kd, 1!00

Index w
 w_mg: mg, 1!000000000000

Index t
 t_kd: kd, 1!11

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_kd: kd, 1!11

Index g
 g_kd: kd, 1!11

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!01101100
Number mwA, 1, 0!11101110
Number rB, 1, 0!01111101
Number mwB, 1, 0!11110001
Number rC, 1, 0!10001010
Number mwC, 1, 0!00000000
Number rD, 1, 0!01111011
Number mwD, 1, 0!11011010
Number rE, 1, 0!11111011
Number mwE, 1, 0!00000000
Number rH, 1, 0!11111110
Number mwH, 1, 0!10001111
Number rI, 1, 0!11111111
Number mwI, 1, 0!11011010
Number rJ, 1, 0!01100011
Number mwJ, 1, 0!00000010
Number rK, 1, 0!01001101
Number mwK, 1, 0!00000010
Number rL, 1, 0!10011011
Number mwL, 1, 0!10010101
Number lr, 1, 0!01111
Number mb, 1, 0!00110101
Number rS1, 1, 0!00000
Number rS2, 1, 0!01000
Number qs, 1, 3!0010010
Number qf, 1, 3!0111110
Number bw, 1, 0!01100
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!10111100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
