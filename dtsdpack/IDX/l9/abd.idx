#  dtsdpack's abd family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/abd_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A decoded WAV's bit allocations (ABITS: abt's until format 118), against the last ones, the
#  subband below's, and the audio's energy (where the scale factor search or the bit allocation
#  search shows the WAV decoded).
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_abd
Debug 1
Const 0

Index a
 a_bd: bd, 1!0000000000000000000101010110000
 a_es: es, &01110000

Index b
 b_la: la, 1!001100110110000000101010000
 b_lb: lb, 1!101110001101010000000000000

Index c
 c_sn: sn, 1!101111111111101110110111000
 c_la: la, 1!111010111111001110011010000

Index d
 d_sn: sn, 1!101000001001000000000010100
 d_sd: sd, 1!01
 d_de: de, 1!101010010
 d_sc: sc, 1!10100000001100
 d_sm: sm, 1!1000000001000000
 d_bg: bg, 1!0000000
 d_ag: ag, 1!0110
 d_sx: sx, 1!00010

Index e
 e_bd: bd, 1!1110100000000000000100100011100
 e_sn: sn, 1!101110010111110110001101000

Index h
 h_lb: lb, 1!011110000011100111101000000
 h_es: es, &01111111
 h_bd: bd, 1!0101100000100110110010001000000

Index i
 i_es: es, &00111111
 i_nb: nb, 1!000001110
 i_la: la, 1!110000000001001010100100000

Index j
 j_es: es, &00000000
 j_de: de, 1!000000000
 j_pm: pm, 1!0

Index k
 k_sn: sn, 1!111100100100000010000100000
 k_nn: nn, 1!000000000000000
 k_sc: sc, 1!10010000000000
 k_eq: eq, 1!0001
 k_sm: sm, 1!0000110110010101
 k_bg: bg, 1!0000000
 k_ag: ag, 1!0110
 k_sx: sx, 1!10001

Index l
 l_bd: bd, 1!1001011110010111111110100000001
 l_cc: cc, 1!10
 l_la: la, 1!000000000000000000000000000

Index s
 s_sn: sn, 1!010011111110000001010000000
 s_sd: sd, 1!10
 s_nn: nn, 1!000000000000000
 s_sc: sc, 1!11111111100000
 s_sm: sm, 1!1000001010000001
 s_bg: bg, 1!0000000
 s_ag: ag, 1!1000
 s_sx: sx, 1!10000

Index f
 f_es: es, &01111000

Index m
 m_nn: nn, 1!000011100001000

Index w
 w_st: st, 1!010000011

Index t
 t_bd: bd, 1!0100000000000000000000001100000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_la: la, 1!111111111111111111111111111

Index g
 g_bd: bd, 1!1111111111111111111111111111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11110100
Number mwA, 1, 0!10011001
Number rB, 1, 0!11000101
Number mwB, 1, 0!10000001
Number rC, 1, 0!11011100
Number mwC, 1, 0!00000011
Number rD, 1, 0!10110000
Number mwD, 1, 0!00000010
Number rE, 1, 0!00000000
Number mwE, 1, 0!10000000
Number rH, 1, 0!11101010
Number mwH, 1, 0!00100000
Number rI, 1, 0!00000000
Number mwI, 1, 0!10001000
Number rJ, 1, 0!00000000
Number mwJ, 1, 0!10000000
Number rK, 1, 0!11111111
Number mwK, 1, 0!01000000
Number rL, 1, 0!01000111
Number mwL, 1, 0!10000000
Number lr, 1, 0!10110
Number mb, 1, 0!01000000
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00011111
Number wq, 1, 0!00001111
Number wo, 1, 0!01000001
Number wa, 1, 0!00011100
Number wf, 1, 0!01101100
Number lf, 1, 0!00010100
Number bf, 1, 0!00000000
Number l2, 1, 0!10000000
Number l3, 1, 0!00011010
Number b2, 1, 0!00000111
Number b3, 1, 0!00010000
Number rS1, 1, 0!00010
Number rS2, 1, 0!00110
Number qs, 1, 3!1001111
Number qf, 1, 3!0010101
Number bw, 1, 0!01100
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00000101
Number mwG, 1, 0!00110111

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
