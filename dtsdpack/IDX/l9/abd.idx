#  dtsdpack's abd family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/abd_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A decoded WAV's bit allocations (ABITS: abt's until format 118), against the last ones, the
#  subband below's, and the audio's energy (where the scale factor search or the bit allocation
#  search shows the WAV decoded).
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_abd
Debug 1
Const 0

Index a
 a_bd: bd, 1!0000000000000000000001000010110
 a_es: es, &01110000

Index b
 b_la: la, 1!001100111100000001100000000
 b_lb: lb, 1!100111100001011001000000000

Index c
 c_sn: sn, 1!101111101110101001111111000
 c_la: la, 1!101110111101100011000000000

Index d
 d_sn: sn, 1!000100001000000000000000001
 d_sd: sd, 1!11
 d_de: de, 1!100011000
 d_sc: sc, 1!00100100001001
 d_sm: sm, 1!1000000000000000
 d_bg: bg, 1!0000000
 d_ag: ag, 1!0110
 d_sx: sx, 1!00110

Index e
 e_bd: bd, 1!1110100000000000001100100100000
 e_sn: sn, 1!101101010100100010011110101

Index h
 h_lb: lb, 1!011111011111000000100000000
 h_es: es, &01011111
 h_bd: bd, 1!0100100111010010100101111110000

Index i
 i_es: es, &01010111
 i_nb: nb, 1!000100100
 i_la: la, 1!111110101000010001111100000

Index j
 j_es: es, &00000000
 j_de: de, 1!000000000
 j_pm: pm, 1!0

Index k
 k_sn: sn, 1!111010000111110011111110100
 k_nn: nn, 1!000000000000001
 k_sc: sc, 1!01111000000010
 k_eq: eq, 1!0000
 k_sm: sm, 1!0000100001000000
 k_bg: bg, 1!0000000
 k_ag: ag, 1!0000
 k_sx: sx, 1!00010

Index l
 l_bd: bd, 1!0000000100000111000000100011101
 l_cc: cc, 1!10
 l_la: la, 1!010010010000000111100110000

Index s
 s_sn: sn, 1!110111111110011000100100110
 s_sd: sd, 1!10
 s_nn: nn, 1!000000000000000
 s_sc: sc, 1!11111110110000
 s_sm: sm, 1!1000001100011011
 s_bg: bg, 1!0000000
 s_ag: ag, 1!1000
 s_sx: sx, 1!00000

Index f
 f_es: es, &01100000

Index m
 m_nn: nn, 1!000011000000010

Index w
 w_st: st, 1!000000001

Index t
 t_bd: bd, 1!1110100000000000000010110011000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_la: la, 1!111111111111111111111111111

Index g
 g_bd: bd, 1!1111111111111111111111111111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00001110
Number mwA, 1, 0!11011000
Number rB, 1, 0!11010101
Number mwB, 1, 0!11000011
Number rC, 1, 0!11100110
Number mwC, 1, 0!00000001
Number rD, 1, 0!10010110
Number mwD, 1, 0!00000001
Number rE, 1, 0!00000000
Number mwE, 1, 0!10000000
Number rH, 1, 0!10010011
Number mwH, 1, 0!10001000
Number rI, 1, 0!01110100
Number mwI, 1, 0!11000001
Number rJ, 1, 0!00000000
Number mwJ, 1, 0!10001111
Number rK, 1, 0!11000111
Number mwK, 1, 0!00000110
Number rL, 1, 0!10010100
Number mwL, 1, 0!10010110
Number lr, 1, 0!10111
Number mb, 1, 0!01000100
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00011111
Number wq, 1, 0!00001111
Number wo, 1, 0!01000000
Number wa, 1, 0!00001010
Number wf, 1, 0!01101101
Number lf, 1, 0!00010011
Number bf, 1, 0!00000011
Number l2, 1, 0!00000000
Number l3, 1, 0!00010000
Number b2, 1, 0!00010111
Number b3, 1, 0!00010000
Number rS1, 1, 0!01000
Number rS2, 1, 0!00100
Number qs, 1, 3!1001101
Number qf, 1, 3!0011000
Number bw, 1, 0!01000
Number rT, 1, 0!10001010
Number mwT, 1, 0!00010100
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00000101
Number mwG, 1, 0!00100100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
