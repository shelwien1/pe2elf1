#  dtsdpack's hid family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/hid_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A decoded WAV's subband samples' and LFE samples' index misses (hit's until format 132: where
#  the scale factor search or the bit allocation search shows the WAV decoded): whether the index
#  is the audio's (an LFE sample's), the one on the other side of the rounding boundary, near it.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_hid
Debug 1
Const 0

Index a
 a_nr: nr, 1!000000000000000
 a_nl: nl, 1!000000000000000

Index b
 b_nr: nr, 1!000001011111111
 b_nl: nl, 1!111111011110100
 b_pm: pm, 1!11

Index c
 c_nr: nr, 1!110000110000000
 c_hm: hm, 1!10

Index d
 d_nl: nl, 1!000000000000000
 d_hm: hm, 1!11

Index e
 e_nr: nr, 1!000000000000000
 e_ab: ab, 1!010000001111111111100100010

Index h
 h_nl: nl, 1!100000110000011
 h_ab: ab, 1!010011101110101100010000000

Index i
 i_nr: nr, 1!000000001100100
 i_nl: nl, 1!101101000001000
 i_hm: hm, 1!01

Index j
 j_nr: nr, 1!100000000000001
 j_ql: ql, 1!111111000000110000000

Index k
 k_nl: nl, 1!100001000001000
 k_ql: ql, 1!111110111110011000000
 k_pm: pm, 1!11

Index l
 l_nr: nr, 1!000110000010111
 l_nl: nl, 1!111111101010101
 l_ab: ab, 1!000000010111111101000000001

Index s
 s_nr: nr, 1!100000000001011
 s_nl: nl, 1!010111110111101

Index f
 f_nr: nr, 1!000000000000010
 f_nl: nl, 1!000000011010100

Index m
 m_nl: nl, 1!100000000010000

Index w
 w_nr: nr, 1!000000000000001

Index t
 t_pm: pm, 1!11

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_pm: pm, 1!11

Index g
 g_pm: pm, 1!11

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!10111110
Number rB, 1, 0!11111111
Number mwB, 1, 0!00000000
Number rC, 1, 0!00000000
Number mwC, 1, 0!01111101
Number rD, 1, 0!00000010
Number mwD, 1, 0!00001111
Number rE, 1, 0!10000001
Number mwE, 1, 0!00000000
Number rH, 1, 0!00000000
Number mwH, 1, 0!00100110
Number rI, 1, 0!11111101
Number mwI, 1, 0!00000010
Number rJ, 1, 0!00011010
Number mwJ, 1, 0!00000111
Number rK, 1, 0!10100001
Number mwK, 1, 0!00000000
Number rL, 1, 0!11111111
Number mwL, 1, 0!00000001
Number lr, 1, 0!01010
Number mb, 1, 0!00100001
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00011000
Number wq, 1, 0!00001000
Number wo, 1, 0!01000000
Number wa, 1, 0!00000100
Number wf, 1, 0!01010011
Number lf, 1, 0!00010000
Number bf, 1, 0!00000000
Number l2, 1, 0!00110010
Number l3, 1, 0!00010000
Number b2, 1, 0!00000010
Number b3, 1, 0!00010000
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!0110010
Number qf, 1, 3!0011111
Number bw, 1, 0!10000
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!10111100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
