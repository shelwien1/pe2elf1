#  dtsdpack's abt family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/abt_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The bit allocations (ABITS), against the last ones, the subband below's, and the audio's energy.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_abt
Debug 1
Const 0

Index a
 a_bd: bd, 1!1111111111111111111111111111111
 a_es: es, &11111111

Index b
 b_la: la, 1!111111111111111111111111111
 b_lb: lb, 1!111111111111111111111111111

Index c
 c_sn: sn, 1!111111111111111111111111111
 c_la: la, 1!111111111111111111111111111

Index d
 d_sn: sn, 1!111111111111111111111111111
 d_sd: sd, 1!11
 d_de: de, 1!111111111

Index e
 e_bd: bd, 1!1111111111111111111111111111111
 e_sn: sn, 1!111111111111111111111111111

Index h
 h_lb: lb, 1!111111111111111111111111111
 h_es: es, &11111111
 h_bd: bd, 1!1111111111111111111111111111111

Index i
 i_es: es, &11111111
 i_nb: nb, 1!111111111
 i_la: la, 1!111111111111111111111111111

Index j
 j_es: es, &11111111
 j_de: de, 1!111111111
 j_pm: pm, 1!1

Index k
 k_sn: sn, 1!111111111111111111111111111
 k_nn: nn, 1!111111111111111

Index l
 l_bd: bd, 1!1111111111111111111111111111111
 l_cc: cc, 1!11
 l_la: la, 1!111111111111111111111111111

Index s
 s_sn: sn, 1!111111111111111111111111111
 s_sd: sd, 1!11
 s_nn: nn, 1!111111111111111

Index f
 f_es: es, &11111111

Index m
 m_nn: nn, 1!111111111111111

Index w
 w_st: st, 1!111111111

Index t
 t_bd: bd, 1!1111111111111111111111111111111

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_la: la, 1!111111111111111111111111111

Index g
 g_bd: bd, 1!1111111111111111111111111111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!11111101
Number mwA, 1, 0!00100000
Number rB, 1, 0!11111111
Number mwB, 1, 0!00000100
Number rC, 1, 0!10110001
Number mwC, 1, 0!00000000
Number rD, 1, 0!11111111
Number mwD, 1, 0!00000000
Number rE, 1, 0!11111111
Number mwE, 1, 0!00000000
Number rH, 1, 0!11111110
Number mwH, 1, 0!00001001
Number rI, 1, 0!11111100
Number mwI, 1, 0!00000010
Number rJ, 1, 0!11111010
Number mwJ, 1, 0!00011101
Number rK, 1, 0!11111111
Number mwK, 1, 0!00000100
Number rL, 1, 0!11111110
Number mwL, 1, 0!00000001
Number lr, 1, 0!01111
Number mb, 1, 0!01100000
Number rS1, 1, 0!00000
Number rS2, 1, 0!01000
Number qs, 1, 3!0000000
Number qf, 1, 3!0011111
Number bw, 1, 0!01100
Number rT, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!10111100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
