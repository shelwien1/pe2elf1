#  dtsdpack's abt family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/abt_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The bit allocations (ABITS), against the last ones, the subband below's, and the audio's energy.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_abt
Debug 1
Const 0

Index a
 a_bd: bd, 1!1111111110111111110010101110000
 a_es: es, &01111110

Index b
 b_la: la, 1!001000000100000100000000000
 b_lb: lb, 1!010100000001000000000000100

Index c
 c_sn: sn, 1!001111101101111110110101100
 c_la: la, 1!001100100111111011010000100

Index d
 d_sn: sn, 1!001000000100000000000000100
 d_sd: sd, 1!01
 d_de: de, 1!100101011
 d_sc: sc, 1!00000100000000
 d_sm: sm, 1!1111111111111111

Index e
 e_bd: bd, 1!1100000000100011111100000000000
 e_sn: sn, 1!010101011111100000001011100

Index h
 h_lb: lb, 1!000000100111111101110000000
 h_es: es, &01011111
 h_bd: bd, 1!0101111111100011001101000000000

Index i
 i_es: es, &00111010
 i_nb: nb, 1!000000100
 i_la: la, 1!001011111111111111111111000

Index j
 j_es: es, &00000000
 j_de: de, 1!000000000
 j_pm: pm, 1!1

Index k
 k_sn: sn, 1!100000000000100000000000000
 k_nn: nn, 1!100110111100111
 k_sc: sc, 1!10000000000000
 k_eq: eq, 1!0001
 k_sm: sm, 1!1111111111111111

Index l
 l_bd: bd, 1!0000011100111000000101011010000
 l_cc: cc, 1!11
 l_la: la, 1!001000010110000101110100000

Index s
 s_sn: sn, 1!101111111110000000000000000
 s_sd: sd, 1!10
 s_nn: nn, 1!000000000000001
 s_sc: sc, 1!11100100001100
 s_sm: sm, 1!1111111111111111

Index f
 f_es: es, &01111000

Index m
 m_nn: nn, 1!001011100000010

Index w
 w_st: st, 1!100001001

Index t
 t_bd: bd, 1!0001000000000000000000000110000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_la: la, 1!111111111111111111111111111

Index g
 g_bd: bd, 1!1111111111111111111111111111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!11101011
Number rB, 1, 0!00000000
Number mwB, 1, 0!10010001
Number rC, 1, 0!11111100
Number mwC, 1, 0!00111011
Number rD, 1, 0!11111110
Number mwD, 1, 0!00000010
Number rE, 1, 0!00000000
Number mwE, 1, 0!11010100
Number rH, 1, 0!11001100
Number mwH, 1, 0!01000100
Number rI, 1, 0!10000011
Number mwI, 1, 0!11111111
Number rJ, 1, 0!00000000
Number mwJ, 1, 0!10000010
Number rK, 1, 0!11111110
Number mwK, 1, 0!00000101
Number rL, 1, 0!10100111
Number mwL, 1, 0!11010101
Number lr, 1, 0!10000
Number mb, 1, 0!01001100
Number rS1, 1, 0!01000
Number rS2, 1, 0!00111
Number qs, 1, 3!1101111
Number qf, 1, 3!0011011
Number bw, 1, 0!01011
Number rT, 1, 0!00000100
Number mwT, 1, 0!00001101
Number mt, 1, 0!010
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11010000
Number mwG, 1, 0!01110101

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
