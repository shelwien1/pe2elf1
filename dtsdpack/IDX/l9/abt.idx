#  dtsdpack's abt family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/abt_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The bit allocations (ABITS), against the last ones, the subband below's, and the audio's energy.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_abt
Debug 1
Const 0

Index a
 a_bd: bd, 1!1111011110101111100010111001000
 a_es: es, &01111111

Index b
 b_la: la, 1!001000110011100000010100100
 b_lb: lb, 1!100010110001011100110101100

Index c
 c_sn: sn, 1!111101111111100001110111001
 c_la: la, 1!101110111101100001000000000

Index d
 d_sn: sn, 1!010000001000000000000000000
 d_sd: sd, 1!01
 d_de: de, 1!000000000
 d_sc: sc, 1!10000000000000
 d_sm: sm, 1!0011010010111100
 d_bg: bg, 1!1001000
 d_ag: ag, 1!0111

Index e
 e_bd: bd, 1!0011100000000000001100000100000
 e_sn: sn, 1!111111001000100011011111011

Index h
 h_lb: lb, 1!000000000111111110001011100
 h_es: es, &00011111
 h_bd: bd, 1!0001001100001110000000000000100

Index i
 i_es: es, &00001110
 i_nb: nb, 1!001100010
 i_la: la, 1!101110100100011111011101000

Index j
 j_es: es, &00000000
 j_de: de, 1!000000000
 j_pm: pm, 1!0

Index k
 k_sn: sn, 1!111000000010100001011110011
 k_nn: nn, 1!000000000000001
 k_sc: sc, 1!11110000000111
 k_eq: eq, 1!0000
 k_sm: sm, 1!0110100011110000
 k_bg: bg, 1!1100010
 k_ag: ag, 1!0100

Index l
 l_bd: bd, 1!1000010000000000000000001010000
 l_cc: cc, 1!10
 l_la: la, 1!100000000100000000010100100

Index s
 s_sn: sn, 1!010111111110000000000000010
 s_sd: sd, 1!10
 s_nn: nn, 1!000000000000000
 s_sc: sc, 1!11111111110000
 s_sm: sm, 1!1101100011001000
 s_bg: bg, 1!1011100
 s_ag: ag, 1!0000

Index f
 f_es: es, &01100000

Index m
 m_nn: nn, 1!000011000010000

Index w
 w_st: st, 1!000000001

Index t
 t_bd: bd, 1!1011100000000000000000000001000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_la: la, 1!111111111111111111111111111

Index g
 g_bd: bd, 1!1111111111111111111111111111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00001111
Number mwA, 1, 0!11101010
Number rB, 1, 0!11111101
Number mwB, 1, 0!10011111
Number rC, 1, 0!01101001
Number mwC, 1, 0!00101011
Number rD, 1, 0!11110101
Number mwD, 1, 0!00000001
Number rE, 1, 0!00000000
Number mwE, 1, 0!10000110
Number rH, 1, 0!10111010
Number mwH, 1, 0!01011101
Number rI, 1, 0!11111111
Number mwI, 1, 0!10110101
Number rJ, 1, 0!00000000
Number mwJ, 1, 0!10000010
Number rK, 1, 0!11001010
Number mwK, 1, 0!00000100
Number rL, 1, 0!11111101
Number mwL, 1, 0!11011000
Number lr, 1, 0!10111
Number mb, 1, 0!01000000
Number rS1, 1, 0!01000
Number rS2, 1, 0!00110
Number qs, 1, 3!1101111
Number qf, 1, 3!0011000
Number bw, 1, 0!01000
Number rT, 1, 0!00011000
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00010000
Number mwG, 1, 0!00100011

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
