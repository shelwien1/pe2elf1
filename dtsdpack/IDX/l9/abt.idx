#  dtsdpack's abt family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/abt_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The bit allocations (ABITS), against the last ones, the subband below's, and the audio's energy.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_abt
Debug 1
Const 0

Index a
 a_bd: bd, 1!1111111110011111110010111010000
 a_es: es, &01111100

Index b
 b_la: la, 1!001000000100000100000100100
 b_lb: lb, 1!010100000001000000000000100

Index c
 c_sn: sn, 1!011111111111111111111011100
 c_la: la, 1!001111111111111111110111100

Index d
 d_sn: sn, 1!001000000000000000000000000
 d_sd: sd, 1!01
 d_de: de, 1!101111011
 d_sc: sc, 1!10101100000000
 d_sm: sm, 1!101010101101

Index e
 e_bd: bd, 1!1100101100100010110111010000000
 e_sn: sn, 1!011101011111101110011011000

Index h
 h_lb: lb, 1!000000100111111101110000000
 h_es: es, &01011111
 h_bd: bd, 1!0111111101101011000111100100000

Index i
 i_es: es, &01111110
 i_nb: nb, 1!000000010
 i_la: la, 1!001011111111111111111111000

Index j
 j_es: es, &00000000
 j_de: de, 1!010000111
 j_pm: pm, 1!0

Index k
 k_sn: sn, 1!100000000000100000000000100
 k_nn: nn, 1!100110110100111
 k_sc: sc, 1!00000000000000
 k_eq: eq, 1!0001
 k_sm: sm, 1!011010111010

Index l
 l_bd: bd, 1!1111101111111100000101001000000
 l_cc: cc, 1!01
 l_la: la, 1!011011011110010101111101100

Index s
 s_sn: sn, 1!001111111110000000000000100
 s_sd: sd, 1!10
 s_nn: nn, 1!000000000000001
 s_sc: sc, 1!11100100001100
 s_sm: sm, 1!110101110111

Index f
 f_es: es, &01111100

Index m
 m_nn: nn, 1!110011100000011

Index w
 w_st: st, 1!100000001

Index t
 t_bd: bd, 1!0001000000000000000000000110000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_la: la, 1!111111111111111111111111111

Index g
 g_bd: bd, 1!1111111111111111111111111111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00001001
Number mwA, 1, 0!11101011
Number rB, 1, 0!00000000
Number mwB, 1, 0!10101001
Number rC, 1, 0!11111101
Number mwC, 1, 0!00101110
Number rD, 1, 0!11110101
Number mwD, 1, 0!00000010
Number rE, 1, 0!00000100
Number mwE, 1, 0!11000000
Number rH, 1, 0!01111101
Number mwH, 1, 0!01111100
Number rI, 1, 0!11111100
Number mwI, 1, 0!01111001
Number rJ, 1, 0!00000000
Number mwJ, 1, 0!10101001
Number rK, 1, 0!11111111
Number mwK, 1, 0!00000110
Number rL, 1, 0!10101101
Number mwL, 1, 0!11011100
Number lr, 1, 0!10000
Number mb, 1, 0!01001101
Number rS1, 1, 0!01000
Number rS2, 1, 0!00110
Number qs, 1, 3!1101111
Number qf, 1, 3!0011010
Number bw, 1, 0!01011
Number rT, 1, 0!00000100
Number mwT, 1, 0!00001100
Number mt, 1, 0!010
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11010000
Number mwG, 1, 0!11111111

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
