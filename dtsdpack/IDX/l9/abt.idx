#  dtsdpack's abt family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/abt_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The bit allocations (ABITS), against the last ones, the subband below's, and the audio's energy.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_abt
Debug 1
Const 0

Index a
 a_bd: bd, 1!1111111111011111111111111110000
 a_es: es, &11111111

Index b
 b_la: la, 1!001011000100000010000011100
 b_lb: lb, 1!010010110100000001100000000

Index c
 c_sn: sn, 1!001111111111111111111111000
 c_la: la, 1!101111111111111111111111000

Index d
 d_sn: sn, 1!001111101110000000000000000
 d_sd: sd, 1!11
 d_de: de, 1!111111111
 d_sc: sc, 1!11111111111111

Index e
 e_bd: bd, 1!1111101011111101111111111110000
 e_sn: sn, 1!011111111111111111111111100

Index h
 h_lb: lb, 1!000000000000000000001000100
 h_es: es, &01111111
 h_bd: bd, 1!1111100000000000000111111100000

Index i
 i_es: es, &11111111
 i_nb: nb, 1!000000000
 i_la: la, 1!011111111111111101101110000

Index j
 j_es: es, &00000000
 j_de: de, 1!111001110
 j_pm: pm, 1!0

Index k
 k_sn: sn, 1!100000000000000000000000000
 k_nn: nn, 1!100111011111110
 k_sc: sc, 1!11111111111111

Index l
 l_bd: bd, 1!1111100011011011000111111110000
 l_cc: cc, 1!11
 l_la: la, 1!011111111111011110111111000

Index s
 s_sn: sn, 1!101011001110100000000000000
 s_sd: sd, 1!01
 s_nn: nn, 1!100000101101100
 s_sc: sc, 1!10000010001000

Index f
 f_es: es, &01111011

Index m
 m_nn: nn, 1!011011100000011

Index w
 w_st: st, 1!000000001

Index t
 t_bd: bd, 1!0000000000000010000100000000000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_la: la, 1!111111111111111111111111111

Index g
 g_bd: bd, 1!1111111111111111111111111111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00000000
Number mwA, 1, 0!00000001
Number rB, 1, 0!01000101
Number mwB, 1, 0!01100001
Number rC, 1, 0!10111101
Number mwC, 1, 0!00010001
Number rD, 1, 0!10001110
Number mwD, 1, 0!00000100
Number rE, 1, 0!11100110
Number mwE, 1, 0!00000001
Number rH, 1, 0!00000000
Number mwH, 1, 0!00000111
Number rI, 1, 0!11111101
Number mwI, 1, 0!00000110
Number rJ, 1, 0!11111101
Number mwJ, 1, 0!00101011
Number rK, 1, 0!11110100
Number mwK, 1, 0!00111110
Number rL, 1, 0!10000010
Number mwL, 1, 0!00000011
Number lr, 1, 0!10100
Number mb, 1, 0!01000000
Number rS1, 1, 0!01000
Number rS2, 1, 0!00100
Number qs, 1, 3!1111011
Number qf, 1, 3!0011111
Number bw, 1, 0!01110
Number rT, 1, 0!00000100
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00010100
Number mwG, 1, 0!10100001

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
