#  dtsdpack's abt family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/abt_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The bit allocations (ABITS), against the last ones, the subband below's, and the audio's energy.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_abt
Debug 1
Const 0

Index a
 a_bd: bd, 1!1111110110111011110011000110101
 a_es: es, &01111111

Index b
 b_la: la, 1!100000000100100000010100100
 b_lb: lb, 1!100010010010000000100100100

Index c
 c_sn: sn, 1!110101111111111110100111000
 c_la: la, 1!011111111111111111010010000

Index d
 d_sn: sn, 1!010000000100000000000000010
 d_sd: sd, 1!11
 d_de: de, 1!000000010
 d_sc: sc, 1!10000000000000
 d_sm: sm, 1!1011010010110100
 d_bg: bg, 1!0001000
 d_ag: ag, 1!0111

Index e
 e_bd: bd, 1!1011100001000000001100100001001
 e_sn: sn, 1!111111001001010011010110111

Index h
 h_lb: lb, 1!011000000111101001011001100
 h_es: es, &00111111
 h_bd: bd, 1!0001111111110110001000000110101

Index i
 i_es: es, &00101110
 i_nb: nb, 1!000000000
 i_la: la, 1!111011110100010100111111100

Index j
 j_es: es, &00000000
 j_de: de, 1!000000000
 j_pm: pm, 1!0

Index k
 k_sn: sn, 1!100011000001110000001000011
 k_nn: nn, 1!000011100110111
 k_sc: sc, 1!11000000000000
 k_eq: eq, 1!0000
 k_sm: sm, 1!1110100011110000
 k_bg: bg, 1!0000000
 k_ag: ag, 1!1100

Index l
 l_bd: bd, 1!0000010000000000000000010111000
 l_cc: cc, 1!00
 l_la: la, 1!110000000100000000000000100

Index s
 s_sn: sn, 1!001111111110000000000000111
 s_sd: sd, 1!10
 s_nn: nn, 1!000000000000000
 s_sc: sc, 1!11111111110000
 s_sm: sm, 1!1101100011001000
 s_bg: bg, 1!0011100
 s_ag: ag, 1!1011

Index f
 f_es: es, &01110000

Index m
 m_nn: nn, 1!110011000001000

Index w
 w_st: st, 1!100001001

Index t
 t_bd: bd, 1!0011100000000000000000000001000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_la: la, 1!111111111111111111111111111

Index g
 g_bd: bd, 1!1111111111111111111111111111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00011111
Number mwA, 1, 0!11101010
Number rB, 1, 0!11111011
Number mwB, 1, 0!10011101
Number rC, 1, 0!11001101
Number mwC, 1, 0!00100010
Number rD, 1, 0!11111110
Number mwD, 1, 0!00000001
Number rE, 1, 0!00000000
Number mwE, 1, 0!10000111
Number rH, 1, 0!11111111
Number mwH, 1, 0!01011011
Number rI, 1, 0!11110110
Number mwI, 1, 0!10101100
Number rJ, 1, 0!00000000
Number mwJ, 1, 0!10001010
Number rK, 1, 0!11001100
Number mwK, 1, 0!00000111
Number rL, 1, 0!11111110
Number mwL, 1, 0!10001010
Number lr, 1, 0!10111
Number mb, 1, 0!01000000
Number rS1, 1, 0!01000
Number rS2, 1, 0!00110
Number qs, 1, 3!1101111
Number qf, 1, 3!0011011
Number bw, 1, 0!01000
Number rT, 1, 0!11111010
Number mwT, 1, 0!00000000
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!10000010
Number mwG, 1, 0!00000100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
