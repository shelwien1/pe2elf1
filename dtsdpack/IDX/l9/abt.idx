#  dtsdpack's abt family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/abt_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The bit allocations (ABITS), against the last ones, the subband below's, and the audio's energy.
#  (The counters', mixers' and APMs' parameters start as ac3pack's sid family's.)

Prefix D9_abt
Debug 1
Const 0

Index a
 a_bd: bd, 1!1110010110000000000000001000110
 a_es: es, &01110000

Index b
 b_la: la, 1!001010111110111001010000100
 b_lb: lb, 1!101110100000000101000000100

Index c
 c_sn: sn, 1!101111111110100001111111001
 c_la: la, 1!011110111101001001000010100

Index d
 d_sn: sn, 1!110000001000000000000000000
 d_sd: sd, 1!01
 d_de: de, 1!000000000
 d_sc: sc, 1!10000101000000
 d_sm: sm, 1!1011000011010000
 d_bg: bg, 1!1001000
 d_ag: ag, 1!0111
 d_sx: sx, 1!11001

Index e
 e_bd: bd, 1!0011100000000000001000100100000
 e_sn: sn, 1!101111001100100001001111011

Index h
 h_lb: lb, 1!000000010110111101100101100
 h_es: es, &00011111
 h_bd: bd, 1!0000000001100110000000000000000

Index i
 i_es: es, &00001011
 i_nb: nb, 1!101100010
 i_la: la, 1!000110000100001011100100000

Index j
 j_es: es, &00000000
 j_de: de, 1!000000000
 j_pm: pm, 1!0

Index k
 k_sn: sn, 1!101000000011110001010110101
 k_nn: nn, 1!000000000000001
 k_sc: sc, 1!11110000000010
 k_eq: eq, 1!0000
 k_sm: sm, 1!1100100010100000
 k_bg: bg, 1!0001000
 k_ag: ag, 1!1000
 k_sx: sx, 1!01000

Index l
 l_bd: bd, 1!1000110000000000000000000011000
 l_cc: cc, 1!10
 l_la: la, 1!100000011000000000110010100

Index s
 s_sn: sn, 1!010111111110000000000000011
 s_sd: sd, 1!10
 s_nn: nn, 1!000000000000000
 s_sc: sc, 1!11111111110000
 s_sm: sm, 1!0100100111001000
 s_bg: bg, 1!1010100
 s_ag: ag, 1!1000
 s_sx: sx, 1!01000

Index f
 f_es: es, &01100000

Index m
 m_nn: nn, 1!000011000010000

Index w
 w_st: st, 1!000000101

Index t
 t_bd: bd, 1!1111000000000000000000000011000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_la: la, 1!111111111111111111111111111

Index g
 g_bd: bd, 1!1111111111111111111111111111111

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00001111
Number mwA, 1, 0!11111011
Number rB, 1, 0!11101100
Number mwB, 1, 0!10010110
Number rC, 1, 0!11111101
Number mwC, 1, 0!00101001
Number rD, 1, 0!11111110
Number mwD, 1, 0!00000001
Number rE, 1, 0!00000000
Number mwE, 1, 0!10000001
Number rH, 1, 0!11111011
Number mwH, 1, 0!01111110
Number rI, 1, 0!11111101
Number mwI, 1, 0!10110100
Number rJ, 1, 0!00000000
Number mwJ, 1, 0!10001110
Number rK, 1, 0!10100100
Number mwK, 1, 0!00000111
Number rL, 1, 0!10110001
Number mwL, 1, 0!11011111
Number lr, 1, 0!10111
Number mb, 1, 0!01000100
Number rS1, 1, 0!01000
Number rS2, 1, 0!00101
Number qs, 1, 3!1101111
Number qf, 1, 3!0011000
Number bw, 1, 0!01000
Number rT, 1, 0!00001000
Number mwT, 1, 0!00000101
Number mt, 1, 0!100
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!00000100
Number mwG, 1, 0!00100111

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
