#  dtsdpack's smn family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/smn_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The subband samples' quantization indexes of a channel the WAV doesn't bind, as their residuals
#  from the least-squares fit of its decoded values (model_smp.inc's code_q(); smp's or smd's
#  before format 159), against the residuals' spread and how far the fit's value lies from its
#  index.  Its parameters start as smd's, tuned on 9 streams' dumps without their WAVs.

Prefix D9_smn
Debug 1
Const 0

Index a
 a_pk: pk, 1!0
 a_nr: nr, 1!000000000000100
 a_nl: nl, 1!000010100000000

Index b
 b_pk: pk, 1!1
 b_ab: ab, 1!010111011111001101111110000
 b_ql: ql, 1!001111111111111111111

Index c
 c_pk: pk, 1!0
 c_nr: nr, 1!000000000000100
 c_hm: hm, 1!11

Index d
 d_pk: pk, 1!1
 d_ab: ab, 1!001001110111110011100110000
 d_m1: m1, 1!0011111111011000100000

Index e
 e_pk: pk, 1!1
 e_ab: ab, 1!010101001010000000100001000
 e_m1: m1, 1!0101111111110111000000
 e_m2: m2, 1!0111111111111010000000

Index h
 h_pk: pk, 1!0
 h_ab: ab, 1!011111110111100010101111000
 h_nr: nr, 1!000000000000111

Index i
 i_pk: pk, 1!1
 i_ab: ab, 1!010100111111001111100000000
 i_hw: hw, 1!010
 i_pm: pm, 1!0

Index j
 j_pk: pk, 1!1
 j_ab: ab, 1!011011111111111010100001000
 j_bd: bd, 1!1111111010100101011111111110111

Index k
 k_pk: pk, 1!0
 k_nr: nr, 1!000000000000111
 k_pm: pm, 1!0

Index l
 l_pk: pk, 1!1
 l_nl: nl, 1!101101000011110
 l_ab: ab, 1!000110010111110101010110000

Index s
 s_pk: pk, 1!0
 s_nr: nr, 1!000000000000111
 s_nl: nl, 1!000010110101011

Index f
 f_pk: pk, 1!1
 f_nl: nl, 1!101001100000001
 f_nr: nr, 1!000000000000111

Index m
 m_pk: pk, 1!0
 m_nr: nr, 1!000010000000000

Index w
 w_nl: nl, 1!000000000010100

Index t
 t_ab: ab, 1!000000011111000000000000000

Index n
#  Frozen: the mantissa mixer it is for mixes only by a hint, and nothing gives this family one.
! n_ab: ab, 1!111111111111111111111111111

Index g

#  The counters' limits (r: up to 255 counts) and margins (mw: in 64ths of 1/1024)
Number rA, 1, 0!00001111
Number mwA, 1, 0!10100000
Number rB, 1, 0!11111101
Number mwB, 1, 0!00000000
Number rC, 1, 0!11111111
Number mwC, 1, 0!11111111
Number rD, 1, 0!11111111
Number mwD, 1, 0!01111111
Number rE, 1, 0!11111011
Number mwE, 1, 0!00111011
Number rH, 1, 0!11111110
Number mwH, 1, 0!10000000
Number rI, 1, 0!11111111
Number mwI, 1, 0!11000000
Number rJ, 1, 0!11111011
Number mwJ, 1, 0!00000000
Number rK, 1, 0!11111111
Number mwK, 1, 0!11010111
Number rL, 1, 0!11111111
Number mwL, 1, 0!01111111
Number lr, 1, 0!10000
Number mb, 1, 0!00000011
#  the mixers' initial weights, in 256ths (format 112): each counter's two probabilities' in the
#  first three (wp, wq), the outside prediction's there (wo), A's APM refinement's (wa, format
#  113), each mixer's in the final one (wf); and the final mixer's rate and boost, in 16ths of the
#  others' (lf, bf, format 113), mixer 2's and 3's rates, in 16ths of mixer 1's (l2, l3, format 114)
#  and boosts (b2, b3, format 115)
Number wp, 1, 0!00110000
Number wq, 1, 0!00000001
Number wo, 1, 0!01000000
Number wa, 1, 0!00000000
Number wf, 1, 0!01011000
Number lf, 1, 0!00001000
Number bf, 1, 0!00000000
Number l2, 1, 0!00000101
Number l3, 1, 0!00001000
Number b2, 1, 0!00010000
Number b3, 1, 0!01110000
Number rS1, 1, 0!10000
Number rS2, 1, 0!01000
Number qs, 1, 3!0000011
Number qf, 1, 3!1111100
Number bw, 1, 0!01110
Number rT, 1, 0!10110010
Number mwT, 1, 0!10001101
Number mt, 1, 0!110
#  the mantissa mixer's rates: frozen (Index n)
! Number lrm, 1, 0!11111
! Number mbm, 1, 0!00011001
Number rG, 1, 0!11111111
Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
