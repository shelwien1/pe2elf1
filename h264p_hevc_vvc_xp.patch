diff --git a/h264p_src/recon.inc b/h264p_src/recon.inc
index 40699b5..1153ed6 100644
--- a/h264p_src/recon.inc
+++ b/h264p_src/recon.inc
@@ -2738,6 +2738,55 @@ struct ReconT : MbDecoder<K> {
     prx_ok = true;
