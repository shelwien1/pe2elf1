   }
+#ifdef XP_CCLM
+  // XP: the chroma proxy from the macroblock's decoded luma (VVC's CCLM):
+  // 1 a linear model fitted on the samples around the macroblock, applied
+  // to its luma; 2 the proxy corrected by its luma's miss, the slope fitted
+  // on the proxy; 3 the same, the slope fitted around the macroblock
+  void proxy_cclm(int mode) {
+    if (!act() || !prx_ok) return;
+    int w = cur->w, cw = stride(1);
+    const uint8_t* Y = mb_px(mb_addr, 0);
+    int lds[64], pds[64];
+    for (int j = 0; j < 8; j++)
+      for (int i = 0; i < 8; i++) {
+        const uint8_t* p = Y + 2 * j * w + 2 * i;
+        lds[j * 8 + i] = (p[0] + p[1] + p[w] + p[w + 1] + 2) >> 2;
+        const uint8_t* q = prx_y + 2 * j * 16 + 2 * i;
+        pds[j * 8 + i] = (q[0] + q[1] + q[16] + q[17] + 2) >> 2;
+      }
+    bool top = above_done(), left = left_done();
+    for (int c = 0; c < 2; c++) {
+      uint8_t* P = prx_c[c];
+      const uint8_t* C = mb_px(mb_addr, 1 + c);
+      double n = 0, sx = 0, sy = 0, sxx = 0, sxy = 0;
+      auto add = [&](double x, double y) { n++, sx += x, sy += y, sxx += x * x, sxy += x * y; };
+      if (mode == 2) {
+        for (int k = 0; k < 64; k++) add(pds[k], P[k]);
+      } else {
+        if (top)
+          for (int i = 0; i < 8; i++) {
+            const uint8_t* p = Y - 2 * w + 2 * i;
+            add((p[0] + p[1] + p[w] + p[w + 1] + 2) >> 2, C[-cw + i]);
+          }
+        if (left)
+          for (int j = 0; j < 8; j++) {
+            const uint8_t* p = Y + 2 * j * w - 2;
+            add((p[0] + p[1] + p[w] + p[w + 1] + 2) >> 2, C[j * cw - 1]);
+          }
+      }
+      if (n < 4) continue;
+      double den = n * sxx - sx * sx, a = den > 0 ? (n * sxy - sx * sy) / den : 0, b = (sy - a * sx) / n;
+      if (a > 4) a = 4;
+      if (a < -4) a = -4;
+      for (int k = 0; k < 64; k++) {
+        double v = mode == 1 ? a * lds[k] + b : P[k] + a * (lds[k] - pds[k]);
+        int iv = (int)(v + 0.5);
+        P[k] = (uint8_t)(iv < 0 ? 0 : iv > 255 ? 255 : iv);
+      }
+    }
+  }
+#endif
   // how far the luma of the current macroblock decoded so far is from the
   // proxy: 4 x the mean absolute difference; -1 none decoded or no proxy
   int proxy_acc() const {
@@ -2781,6 +2830,107 @@ struct ReconT : MbDecoder<K> {
       if (mb_done8 >> b8 & 1) add((b8 & 1) * 8, (b8 >> 1) * 8, 8);
     return cnt ? sum * 4 / cnt : -1;
   }
+#ifdef XP_ITMP
+  // XP: ECM's intra template matching (IntraTMP) as the intra proxy: the
+  // block of the current picture, decoded already, whose template (4 rows
+  // above, 4 columns left) best matches the macroblock's; full samples
+  static constexpr int IT_T = 4;
+  int itmp_cost(const uint8_t* Y, int w, int x0, int y0, int cx, int cy, int best) const {
+    int c = 0;
+    for (int j = -IT_T; j < 0; j++) {
+      const uint8_t *a = Y + (y0 + j) * w + x0 - IT_T, *b = Y + (cy + j) * w + cx - IT_T;
+      for (int i = 0; i < 16 + IT_T; i++) c += abs(a[i] - b[i]);
+      if (c >= best) return c;
+    }
+    for (int j = 0; j < 16; j++) {
+      const uint8_t *a = Y + (y0 + j) * w + x0 - IT_T, *b = Y + (cy + j) * w + cx - IT_T;
+      for (int i = 0; i < IT_T; i++) c += abs(a[i] - b[i]);
+      if (c >= best) return c;
+    }
+    return c;
+  }
+  bool itmp_search(int& bx, int& by, int& bc) const {
+    if (!act()) return false;
+    int w = cur->w, x0 = mb_x(mb_addr), y0 = mb_y(mb_addr);
+    if (x0 < IT_T || y0 < IT_T || !above_done() || !left_done()) return false;
+    const uint8_t* Y = cur->y.data();
+    bc = INT_MAX;
+    for (int cy = Max(IT_T, y0 - XP_ITMP); cy <= y0; cy++)
+      for (int cx = Max(IT_T, x0 - XP_ITMP); cx <= Min(w - 16, x0 + XP_ITMP); cx++) {
+        if (cy + 16 > y0 && cx + 16 > x0) continue;  // not decoded yet
+        int c = itmp_cost(Y, w, x0, y0, cx, cy, bc);
+        if (c < bc) bc = c, bx = cx, by = cy;
+      }
+    return bc < INT_MAX;
+  }
+  // the same template's cost for the proxy picture at the vector mv (full samples)
+  int ref_tcost(const int* mv) const {
+    const RPic* P = proxy_pic();
+    int w = cur->w, x0 = mb_x(mb_addr), y0 = mb_y(mb_addr);
+    if (!P || x0 < IT_T || y0 < IT_T) return INT_MAX;
+    int cx = clip3(IT_T, w - 16, x0 + ((mv[0] + 2) >> 2)), cy = clip3(IT_T, P->h - 16, y0 + ((mv[1] + 2) >> 2));
+    const uint8_t *Y = cur->y.data(), *R = P->y.data();
+    int c = 0;
+    for (int j = -IT_T; j < 16; j++) {
+      const uint8_t *a = Y + (y0 + j) * w + x0 - IT_T, *b = R + (cy + j) * w + cx - IT_T;
+      for (int i = 0; i < (j < 0 ? 16 + IT_T : IT_T); i++) c += abs(a[i] - b[i]);
+    }
+    return c;
+  }
+  void itmp_build(int bx, int by) {
+    int w = cur->w, cw = w / 2;
+    for (int j = 0; j < 16; j++) memcpy(prx_y + j * 16, cur->y.data() + (by + j) * w + bx, 16);
+    for (int c = 0; c < 2; c++) {
+      const uint8_t* C = (c ? cur->v : cur->u).data();
+      for (int j = 0; j < 8; j++) memcpy(prx_c[c] + j * 8, C + (by / 2 + j) * cw + bx / 2, 8);
+    }
+    prx_ok = true;
+  }
+#endif
+#ifdef XP_LIC
+  // XP: ECM's local illumination compensation as an estimate of an inter
+  // macroblock's chroma DC: the decoded samples above and left of the
+  // macroblock less the same samples of its reference displaced by its
+  // vector, averaged per 4x4 block over the template parts next to it,
+  // as the 2x2 DC transform's levels (quarters); q how far the top and
+  // left templates disagree
+  bool lic_dc(int c, int l, int r, int mvx, int mvy, int qp, int* lv, int& q) const {
+    if (!act() || r < 0 || r >= nlist[l] || !list[l][r]) return false;
+    const RPic* P = list[l][r];
+    if (P->w != cur->w || P->h != cur->h) return false;
+    bool top = above_done(), left = left_done();
+    if (!top && !left) return false;
+    int cw = stride(c), cx = mb_x(mb_addr) / 2, cy = mb_y(mb_addr) / 2;
+    const uint8_t* C = mb_px(mb_addr, c);
+    uint8_t rt[64], rl[64];
+    int dt[8] = {}, dl[8] = {}, st = 0, sl = 0;
+    if (top) {
+      mc_chroma(P, c - 1, cx, cy - 1, 8, 1, mvx, mvy, rt);
+      for (int i = 0; i < 8; i++) dt[i] = C[-cw + i] - rt[i], st += dt[i];
+    }
+    if (left) {
+      mc_chroma(P, c - 1, cx - 1, cy, 1, 8, mvx, mvy, rl);
+      for (int j = 0; j < 8; j++) dl[j] = C[j * cw - 1] - rl[j * 8], sl += dl[j];
+    }
+    q = top && left ? abs(st - sl) : 0;
+    int d[4], f[4];
+    for (int by = 0; by < 2; by++)
+      for (int bx = 0; bx < 2; bx++) {
+        int sum = 0, n = 0;
+        if (top) for (int i = 0; i < 4; i++) sum += dt[bx * 4 + i], n++;
+        if (left) for (int j = 0; j < 4; j++) sum += dl[by * 4 + j], n++;
+        d[by * 2 + bx] = n ? sum * 16 / n : 0;
+      }
+    static const int mf0[6] = {13107, 11916, 10082, 9362, 8192, 7282};
+    int qb = 15 + qp / 6;
+    hadamard2x2(d, f);
+    for (int k = 0; k < 4; k++) {
+      int v = (int)(((int64_t)abs(f[k]) * mf0[qp % 6]) >> (qb - 1));
+      lv[k] = f[k] < 0 ? -v : v;
+    }
+    return true;
+  }
+#endif
   const RPic* proxy_pic() const {
     const RPic* P = nlist[0] > 0 && list[0][0] ? list[0][0] : !dpb.empty() ? dpb.back() : nullptr;
     return P && P->w == cur->w && P->h == cur->h ? P : nullptr;
