#  tsvcomp's cls model: its context indices and its tunable parameters.
#
#  One module per family -- IDX/IDX-FORMAT.md is the specification, and sec.7
#  is why there are six of these rather than one file.  Every name here is
#  relative to the family: the prefix below puts `cls_` back, so the index `a`
#  is TC_cls_a and the threshold `a_band` is TC_cls_a_band, which is what
#  IDX/opt.pl finds in the executable and what an export.!!! is keyed by.
#
#  ../mk.sh regenerates MOD/tsvcomp-cls_h.inc and MOD/tsvcomp-cls_p.inc from
#  this file and tsvcomp-cls.inc; ./mk.sh check proves the tuning and shipping
#  builds of all six code identically.
#
#  A factor whose pattern is all zeroes contributes one bucket and costs
#  nothing, which is how a variable that was tried and did not pay stays
#  visible -- and how the optimizer is given somewhere to go.

Prefix TC_cls
Debug 1
Const 0
#  ---------------------------------------------------------------------------
#  Residue classes: the class before it (-15.13% on its own, measured in
#  TSVTRANS.md) and the class the same partition had one packet ago.
#
#  As in tsvcomp-flr.idx, every line here was frozen and both APMs were empty.
#  The partition, the same partition last packet and the next one are worth
#  429 bytes of class over four files.  Unfrozen now.

Index a
  a_rno:  rno,   1!1
  a_band: band,  1!000010100010000
  a_prev: prev,  1!0100001
  a_t1:   t1,    1!0001111
  a_blk:  blk,   1!1
  a_tn:   tn,    1!000
  a_prev2: prev2, 1!110
  a_pq:   pq,    1!00000000000000000000000000000000

Index b
  b_rno:  rno,   1!0
  b_band: band,  1!010111111110000
  b_prev: prev,  1!100111000000000
  b_t1:   t1,    1!011
  b_blk:  blk,   1!1
  b_tn:   tn,    1!001
  b_prev2: prev2, 1!001
  b_pq:   pq,    1!00000000000000000000000100000000

Index c
  c_band: band,  1!101
  c_prev: prev,  1!101
  c_t1:   t1,    1!111
  c_tn:   tn,    1!100
  c_prev2: prev2, 1!110
  c_pq:   pq,    1!00000010000000010011100010000000

Index d
  d_band: band,  1!010
  d_prev: prev,  1!111
  d_t1:   t1,    1!101
  d_tn:   tn,    1!100
  d_prev2: prev2, 1!000
  d_pq:   pq,    1!00000000000000001001000000000000

Index s
  s_band: band, 1!111
  s_prev: prev,  1!000
  s_t1: t1, 1!000
  s_tn: tn, 1!111
  s_prev2: prev2, 1!101
  s_pq:   pq,    1!00000001000000000011000000000001

Index f
  f_band: band, 1!000
  f_prev: prev,  1!000
  f_t1: t1, 1!000
  f_tn: tn, 1!000
  f_prev2: prev2, 1!000
  f_pq:   pq,    1!00000000000000000000000000000000

Index m
  m_band: band,  1!001
  m_prev: prev,  1!101
  m_t1:   t1,    1!1
  m_tn:   tn,    1!000
  m_prev2: prev2, 1!000
  m_pq:   pq,    1!00000110001100100000000000000000

Index t
  t_band: band,  1!100
  t_prev: prev,  1!011
  t_t1:   t1,    1!101
  t_tn:   tn,    1!011
  t_prev2: prev2, 1!000
  t_pq:   pq,    1!00000000000001100000000000000000

Number rA, 1, 0!01101010
Number rB, 1, 0!00011110
Number rC, 1, 0!00100010
Number rD, 1, 0!00000100
Number rT, 1, 0!00000000
Number rS1, 1, 0!00100
Number rS2, 1, 0!00101
Number lr, 1, 0!10000
Number lrm, 1, 0!11111
Number mbm, 1, 0!11111100
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00100000
Number mwD, 1, 0!10010110
Number mwT, 1, 0!00100011
Number bw, 1, 0!10000
Number qs, 1, 3!0001001
Number qf, 1, 3!0111110
Number mb, 1, 0!00100010


Index n
  n_band: band,  1!111
  n_prev: prev,  1!000
  n_t1:   t1,    1!001
  n_tn:   tn,    1!001
  n_prev2: prev2, 1!000
  n_pq:   pq,    1!00000000001000000001001000111110

Index g
#  No factors: fam_cls codes a class through `code`, which never reaches a
#  sign, so there is no sign counter here to give a context to.
