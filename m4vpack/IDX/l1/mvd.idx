#  m4vpack's mvd family at level -1: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l1/mvd_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A motion vector difference in units of the VLC code (code(): nodes 0-12) and the f_code residual
#  bits below them (nodes 13-18).

Prefix M1_mvd
Debug 1
Const 0

Index a
 a_kind: kind, 1!11101
 a_comp: comp, 1!1
 a_dz: dz, 1!01111001000000100
 a_ds: ds, 1!11

Index b
 b_kind: kind, 1!11100
 b_comp: comp, 1!0
 b_sp: sp, 1!11110110010001010

Index c
 c_kind: kind, 1!00011
 c_comp: comp, 1!0
 c_rs: rs, 1!11110000000000000

Index d
 d_kind: kind, 1!00011
 d_comp: comp, 1!1
 d_lq: lq, 1!11110001100000010
 d_aq: aq, 1!11100000010000010

Index m
 m_kind: kind, 1!10001
 m_comp: comp, 1!0

Index t
 t_kind: kind, 1!11111
 t_comp: comp, 1!0

Index n
 n_kind: kind, 1!00000

Index g

Number rA, 1, 0!11111111
Number mwA, 1, 0!00000100
Number rB, 1, 0!11111111
Number mwB, 1, 0!00010000
Number rC, 1, 0!11111111
Number mwC, 1, 0!00101111
Number rD, 1, 0!11111111
Number mwD, 1, 0!00010100
Number lr, 1, 0!01111
Number mb, 1, 0!00100100
Number rT, 1, 0!00000011
Number mwT, 1, 0!01000000
Number mt, 1, 0!110
Number lrm, 1, 0!11111
Number mbm, 1, 0!00100000

#  Frozen: what mvd never reads, which live would only take opt.pl's trials.
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
