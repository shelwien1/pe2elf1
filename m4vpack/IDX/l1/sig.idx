#  m4vpack's sig family at level -1: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l1/sig_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The significance (node 0) and "last" (node 1) flags of a block's coefficients, in scan order.

Prefix M1_sig
Debug 1
Const 0

Index a
 a_cls: cls, &101
 a_rnz: rnz, 1!11100100001000100
 a_xm: xm, 1!110001010
 a_pos: pos, &100000

Index b
 b_cls: cls, &111
 b_fp: fp, &11111
 b_pos: pos, &111111

Index c
 c_cls: cls, &000
 c_pos: pos, &111111
 c_h16: h16, &1111111101101111

Index d
 d_cls: cls, &110
 d_nz: nz, 1!11111111
 d_pos: pos, &000000

Index m
 m_cls: cls, &110
 m_pos: pos, &111000

Index t

Index n

Index g

Number rA, 1, 0!11111111
Number mwA, 1, 0!00000001
Number rB, 1, 0!11111111
Number mwB, 1, 0!00010000
Number rC, 1, 0!11111110
Number mwC, 1, 0!00000100
Number rD, 1, 0!11111111
Number mwD, 1, 0!00000010
Number lr, 1, 0!01111
Number mb, 1, 0!01000001

#  Frozen: what sig never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10100
! Number hD, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
