#  m4vpack's mbt family at level -1: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l1/mbt_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The macroblock's kind and flags, a decision a node (famvars.inc).

Prefix M1_mbt
Debug 1
Const 0

Index a
 a_st: st, 1!010
 a_rt: rt, 1!101
 a_c4: c4, 1!1001

Index b
 b_st: st, 1!000
 b_rc: rc, 1!1111000000
 b_cl: cl, 1!11

Index c
 c_st: st, 1!001
 c_rc: rc, 1!1011000000

Index d
 d_st: st, 1!000
 d_cl: cl, 1!11
 d_c4: c4, 1!1111

Index m
 m_st: st, 1!000

Index t

Index n

Index g

Number rA, 1, 0!01000111
Number mwA, 1, 0!00100110
Number rB, 1, 0!11111101
Number mwB, 1, 0!00000100
Number rC, 1, 0!00000000
Number mwC, 1, 0!10000010
Number rD, 1, 0!11111111
Number mwD, 1, 0!01101010
Number lr, 1, 0!01101
Number mb, 1, 0!00101100

#  Frozen: what mbt never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
