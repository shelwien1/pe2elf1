#  m4vpack's mvg family at level -1: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l1/mvg_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The sign of a nonzero motion vector difference.

Prefix M1_mvg
Debug 1
Const 0

Index a
 a_kind: kind, 1!00000
 a_comp: comp, 1!1
 a_ds: ds, 1!11
 a_mag: mag, 1!0110000010000000

Index b
 b_kind: kind, 1!11110
 b_comp: comp, 1!1
 b_ds: ds, 1!01
 b_dz: dz, 1!01101001000100010

Index c
 c_kind: kind, 1!01110
 c_comp: comp, 1!0
 c_ds: ds, 1!11
 c_hm: hm, 1!111

Index d
 d_kind: kind, 1!10110
 d_comp: comp, 1!1
 d_ls: ls, 1!11
 d_as: as, 1!11

Index m
 m_kind: kind, 1!10001
 m_comp: comp, 1!0

Index t

Index n

Index g

Number rA, 1, 0!10100001
Number mwA, 1, 0!00000010
Number rB, 1, 0!00010011
Number mwB, 1, 0!01000000
Number rC, 1, 0!01000000
Number mwC, 1, 0!00000001
Number rD, 1, 0!10000101
Number mwD, 1, 0!00000100
Number lr, 1, 0!01111
Number mb, 1, 0!00000000

#  Frozen: what mvg never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
