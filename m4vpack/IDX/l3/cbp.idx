#  m4vpack's cbp family at level -3: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l3/cbp_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A bit of the coded block pattern, the 8x8 block its node (0-5).

Prefix M3_cbp
Debug 1
Const 0

Index a
 a_c3: c3, 1!11
 a_rbit: rbit, 1!11
 a_cnt: cnt, 1!11101

Index b
 b_c3: c3, 1!00
 b_rbit: rbit, 1!11
 b_lu: lu, 1!11111110

Index c
 c_c3: c3, 1!10
 c_frac: frac, 1!1111

Index d
 d_c3: c3, 1!01
 d_lu: lu, 1!11011110
 d_lq: lq, 1!11

Index e
 e_c3: c3, 1!01
 e_pat: pat, &11111

Index h
 h_c3: c3, 1!11
 h_lu: lu, 1!11110111
 h_mvc: mvc, 1!11111001000001010

Index m
 m_c3: c3, 1!00

Index t

Index n

Index g

Number rA, 1, 0!11111111
Number mwA, 1, 0!00000110
Number rB, 1, 0!11111111
Number mwB, 1, 0!00100000
Number rC, 1, 0!11111110
Number mwC, 1, 0!00010000
Number rD, 1, 0!11111111
Number mwD, 1, 0!01000000
Number rE, 1, 0!10000000
Number mwE, 1, 0!01000000
Number rH, 1, 0!11111111
Number mwH, 1, 0!01000000
Number lr, 1, 0!01100
Number mb, 1, 0!00010011

#  Frozen: what cbp never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
