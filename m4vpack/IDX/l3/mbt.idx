#  m4vpack's mbt family at level -3: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l3/mbt_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The macroblock's kind and flags, a decision a node (famvars.inc).

Prefix M3_mbt
Debug 1
Const 0

Index a
 a_st: st, 1!111
 a_rc: rc, 1!1111111111
 a_cl: cl, 1!11

Index b
 b_st: st, 1!111
 b_rc: rc, 1!1111111111

Index c
 c_st: st, 1!111
 c_cl: cl, 1!11
 c_c4: c4, 1!1111

Index d
 d_st: st, 1!111
 d_cd: cd, 1!11
 d_cl: cl, 1!11

Index e
 e_st: st, 1!111
 e_rt: rt, 1!111
 e_c4: c4, 1!1111

Index h
 h_st: st, 1!111
 h_cl: cl, 1!11
 h_rt: rt, 1!111

Index m
 m_st: st, 1!111

Index t

Index n

Index g

Number rA, 1, 0!11111100
Number mwA, 1, 0!00001011
Number rB, 1, 0!11111111
Number mwB, 1, 0!00010000
Number rC, 1, 0!11111101
Number mwC, 1, 0!00000011
Number rD, 1, 0!10001101
Number mwD, 1, 0!00010001
Number rE, 1, 0!01100111
Number mwE, 1, 0!00001010
Number rH, 1, 0!11111010
Number mwH, 1, 0!00010000
Number lr, 1, 0!01111
Number mb, 1, 0!00011011

#  Frozen: what mbt never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
