#  m4vpack's sgn family at level -3: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l3/sgn_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The sign of a nonzero coefficient, in scan order.

Prefix M3_sgn
Debug 1
Const 0

Index a
 a_cls: cls, &111
 a_flu: flu, 1!11111111
 a_flu2: flu2, 1!11111111

Index b
 b_cls: cls, &111
 b_fdlu: fdlu, 1!11111111111111111111111111
 b_pb: pos, 1!1010010001000000000010000000000000000000000000000000000000000000

Index c
 c_cls: cls, &111
 c_xs: xs, 1!11
 c_pos: pos, &111111

Index d
 d_cls: cls, &111
 d_gh: gh, 1!11111111111111111111111111
 d_pb: pos, 1!1010010001000000000010000000000000000000000000000000000000000000

Index e
 e_cls: cls, &111
 e_lsa: lsa, 1!11111111
 e_pb: pos, 1!1010010001000000000010000000000000000000000000000000000000000000

Index h
 h_cls: cls, &111
 h_lam: lam, 1!111111111111111111111111
 h_pb: pos, 1!1010010001000000000010000000000000000000000000000000000000000000

Index m
 m_cls: cls, &111
 m_pb: pos, 1!1010010001000000000010000000000000000000000000000000000000000000

Index t

Index n

Index g

Number rA, 1, 0!10111101
Number mwA, 1, 0!00100000
Number rB, 1, 0!11111110
Number mwB, 1, 0!00001110
Number rC, 1, 0!11111111
Number mwC, 1, 0!00011101
Number rD, 1, 0!00000000
Number mwD, 1, 0!10000011
Number rE, 1, 0!10011111
Number mwE, 1, 0!00000100
Number rH, 1, 0!11111110
Number mwH, 1, 0!00000010
Number lr, 1, 0!01111
Number mb, 1, 0!10000000

#  Frozen: what sgn never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
