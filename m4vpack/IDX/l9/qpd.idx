#  m4vpack's qpd family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/qpd_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  dquant: nonzero? and which (P-VOPs), nonzero? and its sign (B-VOPs).

Prefix M9_qpd
Debug 1
Const 0

Index a
 a_c3: c3, 1!11
 a_pdq: pdq, 1!1

Index b
 b_c3: c3, 1!11
 b_qs: qs, 1!00000010000000000000000000000000

Index c
 c_c3: c3, 1!00

Index d
 d_pdq: pdq, 1!1
 d_qs: qs, 1!00001010100000000000000000000000

Index e
 e_c3: c3, 1!11
 e_pdq: pdq, 1!1
 e_qs: qs, 1!00001010100000000000000000000000

Index h
 h_pdq: pdq, 1!1

Index i
 i_qs: qs, 1!00001010100000000000000000000000

Index j

Index k
 k_c3: c3, 1!11
 k_pdq: pdq, 1!1

Index l
 l_c3: c3, 1!11
 l_qs: qs, 1!00001000100100000000000000000000

Index s
 s_c3: c3, 1!00

Index f
 f_c3: c3, 1!00

Index m
 m_c3: c3, 1!11

Index w
 w_pdq: pdq, 1!1

#  (frozen: what qpd never reads; see the parameters below)
Index t

#  (frozen: what qpd never reads; see the parameters below)
Index n

#  (frozen: what qpd never reads; see the parameters below)
Index g

Number rA, 1, 0!01011110
Number rB, 1, 0!10110111
Number rC, 1, 0!11110011
Number rD, 1, 0!00000000
Number rE, 1, 0!01010001
Number rH, 1, 0!10100011
Number rI, 1, 0!00000010
Number rJ, 1, 0!10100110
Number rK, 1, 0!11001001
Number rL, 1, 0!00000000
Number rS1, 1, 0!01000
Number rS2, 1, 0!00100
Number lr, 1, 0!11101
Number mwA, 1, 0!00010101
Number mwB, 1, 0!00001011
Number mwC, 1, 0!00000111
Number mwD, 1, 0!00001010
Number mwE, 1, 0!00001001
Number mwH, 1, 0!10000100
Number mwI, 1, 0!00000000
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!10000010
Number mwL, 1, 0!00000000
Number bw, 1, 0!01000
Number qs, 1, 3!0000101
Number qf, 1, 3!0111001
Number mb, 1, 0!00001111

#  Frozen: what qpd never reads, which live would only take opt.pl's trials:
#  no mantissa (rT, mwT, mt, index t); no hint and its mixer (lrm, mbm, index n); no signs of its own (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
