#  m4vpack's mvd family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/mvd_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A motion vector difference in units of the VLC code (code(): nodes 0-12) and the f_code residual
#  bits below them (nodes 13-18).

Prefix M9_mvd
Debug 1
Const 0

Index a
 a_kind: kind, 1!00000
 a_comp: comp, 1!0
 a_ns: ns, 1!0000100000000000

Index b
 b_kind: kind, 1!00110
 b_comp: comp, 1!1
 b_oth: oth, 1!11001000100000010

Index c
 c_kind: kind, 1!01011
 c_comp: comp, 1!0
 c_rs: rs, 1!11101000000000000

Index d
 d_kind: kind, 1!11101
 d_comp: comp, 1!1
 d_dz: dz, 1!11101000100000010
 d_ds: ds, 1!11

Index e
 e_kind: kind, 1!10000
 e_comp: comp, 1!0
 e_sp: sp, 1!11101000100000010

Index h
 h_kind: kind, 1!01011
 h_comp: comp, 1!1
 h_lq: lq, 1!11101000100000010
 h_aq: aq, 1!11101000100000010

Index i
 i_kind: kind, 1!11111
 i_comp: comp, 1!1
 i_fc: fc, 1!111111

Index j
 j_kind: kind, 1!00100
 j_comp: comp, 1!0
 j_rbi: rbi, 1!11111
 j_rsame: rsame, 1!11

Index k
 k_kind: kind, 1!10100
 k_comp: comp, 1!1
 k_ns: ns, 1!1100100000000000
 k_oth: oth, 1!11100000100000010

Index l
 l_kind: kind, 1!00000
 l_comp: comp, 1!1
 l_tz: tz, 1!11101000100000010
 l_ts: ts, 1!11

Index s
 s_kind: kind, 1!00000
 s_comp: comp, 1!0
 s_oth: oth, 1!00100000000000010

Index f
 f_kind: kind, 1!00011
 f_comp: comp, 1!1
 f_ns: ns, 1!1010000010000000

Index m
 m_kind: kind, 1!01010
 m_comp: comp, 1!0
 m_tz: tz, 1!11101000100000010

Index w
 w_kind: kind, 1!11011
 w_comp: comp, 1!1
 w_oth: oth, 1!11001000000000010

Index t
 t_kind: kind, 1!11110
 t_comp: comp, 1!0

Index n
 n_kind: kind, 1!11000

#  (frozen: what mvd never reads; see the parameters below)
Index g

Number rA, 1, 0!01111010
Number rB, 1, 0!00000000
Number rC, 1, 0!11111111
Number rD, 1, 0!11110100
Number rE, 1, 0!11111110
Number rH, 1, 0!11111110
Number rI, 1, 0!11111101
Number rJ, 1, 0!00100101
Number rK, 1, 0!11111110
Number rL, 1, 0!11111100
Number rS1, 1, 0!01000
Number rS2, 1, 0!00111
Number lr, 1, 0!01111
Number mwA, 1, 0!11111101
Number mwB, 1, 0!10000000
Number mwC, 1, 0!00011110
Number mwD, 1, 0!00000011
Number mwE, 1, 0!00010001
Number mwH, 1, 0!00011100
Number mwI, 1, 0!00000111
Number mwJ, 1, 0!00100000
Number mwK, 1, 0!00111101
Number mwL, 1, 0!00010000
Number bw, 1, 0!01100
Number qs, 1, 3!0000000
Number qf, 1, 3!0011111
Number mb, 1, 0!00110100
Number rT, 1, 0!00000000
Number mwT, 1, 0!01011100
Number mt, 1, 0!110
Number lrm, 1, 0!11111
Number mbm, 1, 0!00101010

#  Frozen: what mvd never reads, which live would only take opt.pl's trials:
#  no signs of its own (rG, mwG, index g).
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
