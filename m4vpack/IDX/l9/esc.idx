#  m4vpack's esc family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/esc_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  Which escape a coefficient took where it is not the usual one (rare).

Prefix M9_esc
Debug 1
Const 0

Index a
 a_dm: dm, 1!110

Index b

Index c
 c_dm: dm, 1!110

Index d

Index e
 e_dm: dm, 1!100

Index h

Index i
 i_dm: dm, 1!010

Index j

Index k
 k_dm: dm, 1!111

Index l

Index s
 s_dm: dm, 1!110

Index f

Index m
 m_dm: dm, 1!110

Index w
 w_dm: dm, 1!110

#  (frozen: what esc never reads; see the parameters below)
Index t

#  (frozen: what esc never reads; see the parameters below)
Index n

#  (frozen: what esc never reads; see the parameters below)
Index g

Number rA, 1, 0!11111110
Number rB, 1, 0!11111111
Number rC, 1, 0!11000111
Number rD, 1, 0!11101111
Number rE, 1, 0!11101010
Number rH, 1, 0!11110110
Number rI, 1, 0!00000000
Number rJ, 1, 0!11110101
Number rK, 1, 0!00010100
Number rL, 1, 0!11110111
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!11000
Number mwA, 1, 0!00010101
Number mwB, 1, 0!00001100
Number mwC, 1, 0!00001100
Number mwD, 1, 0!11100001
Number mwE, 1, 0!00001010
Number mwH, 1, 0!01000000
Number mwI, 1, 0!00100001
Number mwJ, 1, 0!00100000
Number mwK, 1, 0!11110011
Number mwL, 1, 0!10011011
Number bw, 1, 0!00011
Number qs, 1, 3!0100011
Number qf, 1, 3!0100010
Number mb, 1, 0!00001111

#  Frozen: what esc never reads, which live would only take opt.pl's trials:
#  no mantissa (rT, mwT, mt, index t); no hint and its mixer (lrm, mbm, index n); no signs of its own (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
