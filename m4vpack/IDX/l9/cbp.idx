#  m4vpack's cbp family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/cbp_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A bit of the coded block pattern, the 8x8 block its node (0-5).

Prefix M9_cbp
Debug 1
Const 0

Index a
 a_c3: c3, 1!10
 a_lu: lu, 1!10010110

Index b
 b_c3: c3, 1!10
 b_mvc: mvc, 1!00000000000000010

Index c
 c_c3: c3, 1!11
 c_rbit: rbit, 1!11
 c_cnt: cnt, 1!11101

Index d
 d_c3: c3, 1!00
 d_frac: frac, 1!1111

Index e
 e_c3: c3, 1!11
 e_qs: qs, 1!00110011101100000000000000000000
 e_cnt: cnt, 1!11000

Index h
 h_c3: c3, 1!01
 h_pat: pat, &11111

Index i
 i_c3: c3, 1!01
 i_lu: lu, 1!11011110
 i_lq: lq, 1!11

Index j
 j_c3: c3, 1!11
 j_lu: lu, 1!11111111
 j_mvc: mvc, 1!11111001000011010

Index k
 k_c3: c3, 1!00
 k_rbit: rbit, 1!11
 k_lu: lu, 1!11111011

Index l
 l_c3: c3, 1!10
 l_ie: ie, 1!01110101000001000
 l_tq: tq, 1!0100010000000100010110000000000000000000000000000000000000000000
 l_tx: tx, 1!011111111010000000000000
 l_em: em, 1!101010001000000000000000

Index s
 s_c3: c3, 1!00
 s_lu: lu, 1!00000000

Index f
 f_c3: c3, 1!11

Index m
 m_c3: c3, 1!11
 m_em: em, 1!010100100000011001010000

Index w
 w_c3: c3, 1!10
 w_lu: lu, 1!11100100

#  (frozen: what cbp never reads; see the parameters below)
Index t

#  (frozen: what cbp never reads; see the parameters below)
Index n

#  (frozen: what cbp never reads; see the parameters below)
Index g

Number rA, 1, 0!10001011
Number rB, 1, 0!00110000
Number rC, 1, 0!11111111
Number rD, 1, 0!11111111
Number rE, 1, 0!11111001
Number rH, 1, 0!11111110
Number rI, 1, 0!11111111
Number rJ, 1, 0!11111010
Number rK, 1, 0!11111111
Number rL, 1, 0!11111110
Number rS1, 1, 0!01000
Number rS2, 1, 0!10000
Number lr, 1, 0!01111
Number mwA, 1, 0!11111111
Number mwB, 1, 0!00000110
Number mwC, 1, 0!00000110
Number mwD, 1, 0!00111100
Number mwE, 1, 0!01101100
Number mwH, 1, 0!01000000
Number mwI, 1, 0!01111111
Number mwJ, 1, 0!01101001
Number mwK, 1, 0!00111100
Number mwL, 1, 0!00000100
Number bw, 1, 0!01111
Number qs, 1, 3!1100100
Number qf, 1, 3!1000000
Number mb, 1, 0!00011111

#  Frozen: what cbp never reads, which live would only take opt.pl's trials:
#  no mantissa (rT, mwT, mt, index t); no hint and its mixer (lrm, mbm, index n); no signs of its own (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
