#  m4vpack's dcs family at level -9: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9/dcs_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  An intra block's DC difference: its magnitude (code(): nodes 0-12), then its sign (node 13).

Prefix M9_dcs
Debug 1
Const 0

Index a
 a_lc: lc, 1!1
 a_prev: prev, 1!0000000000000
 a_es: es, 1!11

Index b
 b_lc: lc, 1!1
 b_ls: ls, 1!11111001100000
 b_as: as, 1!11111010100000

Index c
 c_lc: lc, 1!0
 c_coded: coded, 1!1
 c_qs: qs, 1!00001000001000000000000000000000

Index d
 d_lc: lc, 1!0
 d_lbn: lbn, 1!11100100000000010
 d_abn: abn, 1!11000100000000010

Index e
 e_lc: lc, 1!1
 e_ls2: ls2, 1!11
 e_as2: as2, 1!11
 e_psg: psg, 1!11

Index h
 h_lc: lc, 1!1
 h_sz: sz, 1!111111111111
 h_psg: psg, 1!11

Index i
 i_lc: lc, 1!1
 i_prev: prev, 1!1111111000000
 i_coded: coded, 1!1

Index j
 j_lc: lc, 1!1
 j_ls: ls, 1!01110110000000
 j_prev: prev, 1!0010111000000

Index k
 k_lc: lc, 1!1
 k_as: as, 1!01110100100000
 k_prev: prev, 1!0101011000000

Index l
 l_lc: lc, 1!0
 l_ie: ie, 1!10100010001000100010000000
 l_tq: tq, 1!0000000100010000000000010000000101000000000000000000000000000000

Index s
 s_lc: lc, 1!1
 s_prev: prev, 1!0000100000000

Index f
 f_lc: lc, 1!1

Index m
 m_lc: lc, 1!0
 m_coded: coded, 1!1

Index w
 w_lc: lc, 1!1
 w_psg: psg, 1!11

Index t
 t_lc: lc, 1!0
 t_prev: prev, 1!0000000000000

Index n
 n_lc: lc, 1!0

#  (frozen: what dcs never reads; see the parameters below)
Index g

Number rA, 1, 0!11010011
Number rB, 1, 0!11111111
Number rC, 1, 0!11111111
Number rD, 1, 0!11111111
Number rE, 1, 0!10010100
Number rH, 1, 0!11111110
Number rI, 1, 0!11111010
Number rJ, 1, 0!11101000
Number rK, 1, 0!11110000
Number rL, 1, 0!11111110
Number rS1, 1, 0!01000
Number rS2, 1, 0!00000
Number lr, 1, 0!11111
Number mwA, 1, 0!10000001
Number mwB, 1, 0!00001000
Number mwC, 1, 0!01010111
Number mwD, 1, 0!00010111
Number mwE, 1, 0!01001111
Number mwH, 1, 0!01000000
Number mwI, 1, 0!01110000
Number mwJ, 1, 0!01011111
Number mwK, 1, 0!00101110
Number mwL, 1, 0!00000100
Number bw, 1, 0!10000
Number qs, 1, 3!1100001
Number qf, 1, 3!0000000
Number mb, 1, 0!00100000
Number rT, 1, 0!11110111
Number mwT, 1, 0!00000000
Number mt, 1, 0!000

#  The hint's mixer (the intra estimate's DC difference is the magnitude's hint).
Number lrm, 1, 0!11000
Number mbm, 1, 0!10000000

#  Frozen: what dcs never reads, which live would only take opt.pl's trials:
#  no signs of its own (rG, mwG, index g).
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
