#  m4vpack's sig family at level -5: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l5/sig_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The significance (node 0) and "last" (node 1) flags of a block's coefficients, in scan order.

Prefix M5_sig
Debug 1
Const 0

Index a
 a_cls: cls, &101
 a_nc: nc, 1!10111110000000000
 a_qs: qs, 1!00110111010000000000000000000000
 a_pos: pos, &000000

Index b
 b_cls: cls, &111
 b_kb: kb, 1!0000000000000100
 b_pos: pos, &111111

Index c
 c_cls: cls, &100
 c_nz: nz, 1!11110111
 c_pos: pos, &000000

Index d
 d_cls: cls, &111
 d_past: past, 1!11111101
 d_qs: qs, 1!00000110100000000000000000000000
 d_pos: pos, &111111

Index e
 e_cls: cls, &111
 e_run: run, 1!1110100111111110
 e_pos: pos, &111111

Index h
 h_cls: cls, &010
 h_fp: fp, &11111
 h_pos: pos, &111111

Index i
 i_cls: cls, &111
 i_mvc: mvc, 1!110110001001100001111110000000
 i_pos: pos, &111111

Index j
 j_cls: cls, &101
 j_rnz: rnz, 1!11100100001000100
 j_xm: xm, 1!110001010
 j_pos: pos, &000000

Index k
 k_cls: cls, &111
 k_h8: h8, &11111111
 k_pos: pos, &111111

Index l
 l_cls: cls, &000
 l_pos: pos, &111111
 l_h16: h16, &1111111101111011

Index m
 m_cls: cls, &101
 m_pos: pos, &110000

Index t

Index n

Index g

Number rA, 1, 0!11111111
Number mwA, 1, 0!01110011
Number rB, 1, 0!11111111
Number mwB, 1, 0!10000000
Number rC, 1, 0!11111111
Number mwC, 1, 0!00111111
Number rD, 1, 0!11010110
Number mwD, 1, 0!00001110
Number rE, 1, 0!11111110
Number mwE, 1, 0!00000001
Number rH, 1, 0!11111111
Number mwH, 1, 0!00100111
Number rI, 1, 0!11111111
Number mwI, 1, 0!01011111
Number rJ, 1, 0!11111111
Number mwJ, 1, 0!00000001
Number rK, 1, 0!11111110
Number mwK, 1, 0!00101001
Number rL, 1, 0!11111101
Number mwL, 1, 0!00001010
Number lr, 1, 0!01100
Number mb, 1, 0!01000000

#  Frozen: what sig never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10100
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
