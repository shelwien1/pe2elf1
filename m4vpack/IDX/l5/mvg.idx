#  m4vpack's mvg family at level -5: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l5/mvg_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The sign of a nonzero motion vector difference.

Prefix M5_mvg
Debug 1
Const 0

Index a
 a_kind: kind, 1!10101
 a_comp: comp, 1!1
 a_ls: ls, 1!11
 a_as: as, 1!11

Index b
 b_kind: kind, 1!11110
 b_comp: comp, 1!1
 b_ds: ds, 1!01
 b_dz: dz, 1!01101001001000000

Index c
 c_kind: kind, 1!00000
 c_comp: comp, 1!1
 c_mag: mag, 1!0000100000000000

Index d
 d_kind: kind, 1!10001
 d_comp: comp, 1!0
 d_hm: hm, 1!000

Index e
 e_kind: kind, 1!01101
 e_comp: comp, 1!0
 e_ds: ds, 1!11
 e_hm: hm, 1!111

Index h
 h_kind: kind, 1!10011
 h_comp: comp, 1!1
 h_ls: ls, 1!11

Index i
 i_kind: kind, 1!10110
 i_comp: comp, 1!1
 i_as: as, 1!00

Index j
 j_kind: kind, 1!00000
 j_comp: comp, 1!1
 j_ds: ds, 1!11
 j_mag: mag, 1!0110000010000000

Index k
 k_kind: kind, 1!01111
 k_ls: ls, 1!00
 k_as: as, 1!11
 k_ds: ds, 1!00

Index l
 l_kind: kind, 1!00010
 l_comp: comp, 1!1

Index m
 m_kind: kind, 1!10111
 m_comp: comp, 1!0

Index t

Index n

Index g

Number rA, 1, 0!10000010
Number mwA, 1, 0!00100100
Number rB, 1, 0!00011000
Number mwB, 1, 0!01000000
Number rC, 1, 0!00000000
Number mwC, 1, 0!01000000
Number rD, 1, 0!00000001
Number mwD, 1, 0!01000000
Number rE, 1, 0!01000000
Number mwE, 1, 0!00000001
Number rH, 1, 0!11110111
Number mwH, 1, 0!00000001
Number rI, 1, 0!01111010
Number mwI, 1, 0!00101000
Number rJ, 1, 0!10000000
Number mwJ, 1, 0!00000010
Number rK, 1, 0!11100010
Number mwK, 1, 0!01100011
Number rL, 1, 0!00000000
Number mwL, 1, 0!01000001
Number lr, 1, 0!01011
Number mb, 1, 0!10000000

#  Frozen: what mvg never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
