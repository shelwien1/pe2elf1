#  m4vpack's mvg family at level -5: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l5/mvg_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The sign of a nonzero motion vector difference.

Prefix M5_mvg
Debug 1
Const 0

Index a
 a_kind: kind, 1!01101
 a_comp: comp, 1!1
 a_ls: ls, 1!11
 a_as: as, 1!11

Index b
 b_kind: kind, 1!11100
 b_comp: comp, 1!1
 b_ds: ds, 1!11
 b_dz: dz, 1!00101111111010100

Index c
 c_kind: kind, 1!01010
 c_comp: comp, 1!1
 c_mag: mag, 1!0010000000000000

Index d
 d_kind: kind, 1!10110
 d_comp: comp, 1!0
 d_hm: hm, 1!100

Index e
 e_kind: kind, 1!01101
 e_comp: comp, 1!0
 e_ds: ds, 1!11
 e_hm: hm, 1!111

Index h
 h_kind: kind, 1!10101
 h_comp: comp, 1!0
 h_ls: ls, 1!11

Index i
 i_kind: kind, 1!00000
 i_comp: comp, 1!1
 i_as: as, 1!11

Index j
 j_kind: kind, 1!00110
 j_comp: comp, 1!1
 j_ds: ds, 1!11
 j_mag: mag, 1!0111000010000000

Index k
 k_kind: kind, 1!01001
 k_ls: ls, 1!11
 k_as: as, 1!11
 k_ds: ds, 1!11

Index l
 l_kind: kind, 1!01011
 l_comp: comp, 1!1

Index m
 m_kind: kind, 1!00111
 m_comp: comp, 1!0

Index t

Index n

Index g

Number rA, 1, 0!11111101
Number mwA, 1, 0!00011111
Number rB, 1, 0!00000000
Number mwB, 1, 0!01011100
Number rC, 1, 0!00000000
Number mwC, 1, 0!01111111
Number rD, 1, 0!10000111
Number mwD, 1, 0!00000000
Number rE, 1, 0!11001110
Number mwE, 1, 0!00000000
Number rH, 1, 0!00101100
Number mwH, 1, 0!01000000
Number rI, 1, 0!11110101
Number mwI, 1, 0!11111110
Number rJ, 1, 0!10000000
Number mwJ, 1, 0!00000000
Number rK, 1, 0!11100001
Number mwK, 1, 0!01100110
Number rL, 1, 0!00000000
Number mwL, 1, 0!01101011
Number lr, 1, 0!10000
Number mb, 1, 0!10000000

#  Frozen: what mvg never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
