#  m4vpack's mvd family at level -5: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l5/mvd_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A motion vector difference in units of the VLC code (code(): nodes 0-12) and the f_code residual
#  bits below them (nodes 13-18).

Prefix M5_mvd
Debug 1
Const 0

Index a
 a_kind: kind, 1!11111
 a_comp: comp, 1!1
 a_ns: ns, 1!1110100010000000

Index b
 b_kind: kind, 1!11111
 b_comp: comp, 1!1
 b_oth: oth, 1!11101000100000010

Index c
 c_kind: kind, 1!11111
 c_comp: comp, 1!1
 c_rs: rs, 1!11101000100000010

Index d
 d_kind: kind, 1!11111
 d_comp: comp, 1!1
 d_dz: dz, 1!11101000100000010
 d_ds: ds, 1!11

Index e
 e_kind: kind, 1!11111
 e_comp: comp, 1!1
 e_sp: sp, 1!11101000100000010

Index h
 h_kind: kind, 1!11111
 h_comp: comp, 1!1
 h_lq: lq, 1!11101000100000010
 h_aq: aq, 1!11101000100000010

Index i
 i_kind: kind, 1!11111
 i_comp: comp, 1!1
 i_fc: fc, 1!111111

Index j
 j_kind: kind, 1!11111
 j_comp: comp, 1!1
 j_rbi: rbi, 1!11111
 j_rsame: rsame, 1!11

Index k
 k_kind: kind, 1!11111
 k_comp: comp, 1!1
 k_ns: ns, 1!1110100010000000
 k_oth: oth, 1!11101000100000010

Index l
 l_kind: kind, 1!11111
 l_comp: comp, 1!1

Index m
 m_kind: kind, 1!11111
 m_comp: comp, 1!1

Index t
 t_kind: kind, 1!11111
 t_comp: comp, 1!1

Index n
 n_kind: kind, 1!11111

Index g

Number rA, 1, 0!11111111
Number mwA, 1, 0!00001001
Number rB, 1, 0!00000000
Number mwB, 1, 0!10000000
Number rC, 1, 0!11111100
Number mwC, 1, 0!00000101
Number rD, 1, 0!11111001
Number mwD, 1, 0!00100101
Number rE, 1, 0!11111111
Number mwE, 1, 0!00000011
Number rH, 1, 0!11111111
Number mwH, 1, 0!00001110
Number rI, 1, 0!11011010
Number mwI, 1, 0!00000110
Number rJ, 1, 0!10110001
Number mwJ, 1, 0!01000000
Number rK, 1, 0!11100101
Number mwK, 1, 0!00111001
Number rL, 1, 0!01100010
Number mwL, 1, 0!00001110
Number lr, 1, 0!01111
Number mb, 1, 0!00101101
Number rT, 1, 0!00011100
Number mwT, 1, 0!00001001
Number mt, 1, 0!110
Number lrm, 1, 0!11111
Number mbm, 1, 0!00100010

#  Frozen: what mvd never reads, which live would only take opt.pl's trials.
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
