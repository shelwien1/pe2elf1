#  m4vpack's mvd family at level -5: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l5/mvd_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A motion vector difference in units of the VLC code (code(): nodes 0-12) and the f_code residual
#  bits below them (nodes 13-18).

Prefix M5_mvd
Debug 1
Const 0

Index a
 a_kind: kind, 1!00110
 a_comp: comp, 1!1
 a_ns: ns, 1!0000100010000010

Index b
 b_kind: kind, 1!00000
 b_comp: comp, 1!1
 b_oth: oth, 1!01100000000100110

Index c
 c_kind: kind, 1!01011
 c_comp: comp, 1!1
 c_rs: rs, 1!11110101010000000

Index d
 d_kind: kind, 1!11101
 d_comp: comp, 1!1
 d_dz: dz, 1!01110101000001000
 d_ds: ds, 1!11

Index e
 e_kind: kind, 1!00000
 e_comp: comp, 1!0
 e_sp: sp, 1!11111101011000110

Index h
 h_kind: kind, 1!00011
 h_comp: comp, 1!1
 h_lq: lq, 1!11100110000000010
 h_aq: aq, 1!11100110000001010

Index i
 i_kind: kind, 1!01001
 i_comp: comp, 1!1
 i_fc: fc, 1!000010

Index j
 j_kind: kind, 1!00011
 j_comp: comp, 1!0
 j_rbi: rbi, 1!11111
 j_rsame: rsame, 1!11

Index k
 k_kind: kind, 1!00100
 k_comp: comp, 1!1
 k_ns: ns, 1!0000100000000010
 k_oth: oth, 1!11101001000000110

Index l
 l_kind: kind, 1!00100
 l_comp: comp, 1!1

Index m
 m_kind: kind, 1!01011
 m_comp: comp, 1!0

Index t
 t_kind: kind, 1!01100
 t_comp: comp, 1!0

Index n
 n_kind: kind, 1!00000

Index g

Number rA, 1, 0!11111111
Number mwA, 1, 0!11111100
Number rB, 1, 0!11000111
Number mwB, 1, 0!10111110
Number rC, 1, 0!01111111
Number mwC, 1, 0!10010011
Number rD, 1, 0!11000000
Number mwD, 1, 0!00011111
Number rE, 1, 0!11111111
Number mwE, 1, 0!00011111
Number rH, 1, 0!10000001
Number mwH, 1, 0!10000000
Number rI, 1, 0!11111111
Number mwI, 1, 0!11011101
Number rJ, 1, 0!00000000
Number mwJ, 1, 0!11101000
Number rK, 1, 0!11000000
Number mwK, 1, 0!01000000
Number rL, 1, 0!11111111
Number mwL, 1, 0!01110010
Number lr, 1, 0!10101
Number mb, 1, 0!00001011
Number rT, 1, 0!00001110
Number mwT, 1, 0!10000000
Number mt, 1, 0!110
Number lrm, 1, 0!11111
Number mbm, 1, 0!00000000

#  Frozen: what mvd never reads, which live would only take opt.pl's trials.
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
