#  m4vpack's qpd family at level -5: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l5/qpd_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  dquant: nonzero? and which (P-VOPs), nonzero? and its sign (B-VOPs).

Prefix M5_qpd
Debug 1
Const 0

Index a
 a_c3: c3, 1!11
 a_pdq: pdq, 1!1

Index b
 b_c3: c3, 1!11
 b_qs: qs, 1!00101010100100001000000100000000

Index c
 c_c3: c3, 1!11

Index d
 d_pdq: pdq, 1!1
 d_qs: qs, 1!00101010100100001000000100000000

Index e
 e_c3: c3, 1!11
 e_pdq: pdq, 1!1
 e_qs: qs, 1!00101010100100001000000100000000

Index h
 h_pdq: pdq, 1!1

Index i
 i_qs: qs, 1!00101010100100001000000100000000

Index j

Index k
 k_c3: c3, 1!11
 k_pdq: pdq, 1!1

Index l
 l_c3: c3, 1!11
 l_qs: qs, 1!00101010100100001000000100000000

Index m
 m_c3: c3, 1!11

Index t

Index n

Index g

Number rA, 1, 0!11111111
Number mwA, 1, 0!00010111
Number rB, 1, 0!11111111
Number mwB, 1, 0!00001100
Number rC, 1, 0!11111100
Number mwC, 1, 0!00001111
Number rD, 1, 0!11111111
Number mwD, 1, 0!11100000
Number rE, 1, 0!11101010
Number mwE, 1, 0!00001000
Number rH, 1, 0!11110110
Number mwH, 1, 0!01000000
Number rI, 1, 0!10000010
Number mwI, 1, 0!00100000
Number rJ, 1, 0!11111110
Number mwJ, 1, 0!00100010
Number rK, 1, 0!11011101
Number mwK, 1, 0!00110001
Number rL, 1, 0!11110100
Number mwL, 1, 0!00010001
Number lr, 1, 0!11000
Number mb, 1, 0!00001111

#  Frozen: what qpd never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
