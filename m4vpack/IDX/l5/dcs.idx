#  m4vpack's dcs family at level -5: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l5/dcs_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  An intra block's DC difference: its magnitude (code(): nodes 0-12), then its sign (node 13).

Prefix M5_dcs
Debug 1
Const 0

Index a
 a_lc: lc, 1!0
 a_prev: prev, 1!0001110000000

Index b
 b_lc: lc, 1!1
 b_ls: ls, 1!00101100100000
 b_as: as, 1!01111111100000

Index c
 c_lc: lc, 1!0
 c_coded: coded, 1!0
 c_qs: qs, 1!00111001000000000000000000000000

Index d
 d_lc: lc, 1!0
 d_lbn: lbn, 1!11010001000000110
 d_abn: abn, 1!11101010000100110

Index e
 e_lc: lc, 1!1
 e_ls2: ls2, 1!11
 e_as2: as2, 1!11
 e_psg: psg, 1!11

Index h
 h_lc: lc, 1!1
 h_sz: sz, 1!011111110000
 h_psg: psg, 1!01

Index i
 i_lc: lc, 1!1
 i_prev: prev, 1!1111110100000
 i_coded: coded, 1!1

Index j
 j_lc: lc, 1!1
 j_ls: ls, 1!01111000001000
 j_prev: prev, 1!0111100000000

Index k
 k_lc: lc, 1!1
 k_as: as, 1!00000010001000
 k_prev: prev, 1!0000011000000

Index l
 l_lc: lc, 1!1

Index m
 m_lc: lc, 1!1
 m_coded: coded, 1!1

Index t
 t_lc: lc, 1!1
 t_prev: prev, 1!0001100100000

Index n
 n_lc: lc, 1!1

Index g

Number rA, 1, 0!01001011
Number mwA, 1, 0!11111010
Number rB, 1, 0!11111101
Number mwB, 1, 0!00000000
Number rC, 1, 0!00000000
Number mwC, 1, 0!10100000
Number rD, 1, 0!11111111
Number mwD, 1, 0!00011101
Number rE, 1, 0!00111010
Number mwE, 1, 0!01010100
Number rH, 1, 0!11111111
Number mwH, 1, 0!10000000
Number rI, 1, 0!11111111
Number mwI, 1, 0!01100100
Number rJ, 1, 0!00011111
Number mwJ, 1, 0!00100000
Number rK, 1, 0!00000000
Number mwK, 1, 0!11000001
Number rL, 1, 0!10000001
Number mwL, 1, 0!00100000
Number lr, 1, 0!10001
Number mb, 1, 0!00100000
Number rT, 1, 0!00110000
Number mwT, 1, 0!10000000
Number mt, 1, 0!011

#  Frozen: what dcs never reads, which live would only take opt.pl's trials.
! Number lrm, 1, 0!11000
! Number mbm, 1, 0!10000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
