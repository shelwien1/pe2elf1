#  m4vpack's esc family at level -5: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l5/esc_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  Which escape a coefficient took where it is not the usual one (rare).

Prefix M5_esc
Debug 1
Const 0

Index a
 a_dm: dm, 1!110

Index b

Index c
 c_dm: dm, 1!110

Index d

Index e
 e_dm: dm, 1!100

Index h

Index i
 i_dm: dm, 1!111

Index j

Index k
 k_dm: dm, 1!110

Index l

Index m
 m_dm: dm, 1!110

Index t

Index n

Index g

Number rA, 1, 0!00000000
Number mwA, 1, 0!11001010
Number rB, 1, 0!10111111
Number mwB, 1, 0!11110101
Number rC, 1, 0!10000101
Number mwC, 1, 0!00001000
Number rD, 1, 0!01100011
Number mwD, 1, 0!00000100
Number rE, 1, 0!00001100
Number mwE, 1, 0!00001000
Number rH, 1, 0!01110110
Number mwH, 1, 0!10011001
Number rI, 1, 0!00000000
Number mwI, 1, 0!11111111
Number rJ, 1, 0!11110110
Number mwJ, 1, 0!11110111
Number rK, 1, 0!00000000
Number mwK, 1, 0!10000101
Number rL, 1, 0!10111111
Number mwL, 1, 0!10101001
Number lr, 1, 0!11000
Number mb, 1, 0!01001001

#  Frozen: what esc never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
