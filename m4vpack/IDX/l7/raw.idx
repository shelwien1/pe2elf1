#  m4vpack's raw family at level -7: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l7/raw_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The bytes of a chunk kept as bytes, a bit at a time by its place in the byte's binary tree
#  (nodes 1-255).

Prefix M7_raw
Debug 1
Const 0

Index a

Index b
 b_c1: c1, &11111111

Index c
 c_c1: c1, &11111111
 c_c2: c2, &00001111

Index d
 d_code: code, 1!10111110000

Index e
 e_code: code, 1!11010110000
 e_at: at, 1!01100101011

Index h
 h_c1: c1, &00011111
 h_at: at, 1!00001111010

Index i
 i_c1: c1, &00100111
 i_code: code, 1!11000101000

Index j
 j_at: at, 1!01110111011

Index k
 k_c2: c2, &11111110

Index l
 l_c2: c2, &11110111
 l_code: code, 1!10101101000

Index m
 m_at: at, 1!01110011001

Index w
 w_code: code, 1!11001110000

Index s
 s_code: code, 1!11010110000

Index f

Index t

Index n

Index g

Number rA, 1, 0!11101010
Number mwA, 1, 0!11111111
Number rB, 1, 0!00101001
Number mwB, 1, 0!00000000
Number rC, 1, 0!00000000
Number mwC, 1, 0!00000000
Number rD, 1, 0!11110111
Number mwD, 1, 0!11111111
Number rE, 1, 0!11110110
Number mwE, 1, 0!00000000
Number rH, 1, 0!11100010
Number mwH, 1, 0!00000010
Number rI, 1, 0!11101110
Number mwI, 1, 0!00000000
Number rJ, 1, 0!11101100
Number mwJ, 1, 0!11110001
Number rK, 1, 0!10001110
Number mwK, 1, 0!11001110
Number rL, 1, 0!00110011
Number mwL, 1, 0!01111111
Number lr, 1, 0!11111
Number mb, 1, 0!00010110
Number rS1, 1, 0!01000
Number rS2, 1, 0!10000
Number qs, 1, 3!0001011
Number qf, 1, 3!0010000
Number bw, 1, 0!10000

#  Frozen: what raw never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10100
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
