#  m4vpack's dcs family at level -7: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l7/dcs_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  An intra block's DC difference: its magnitude (code(): nodes 0-12), then its sign (node 13).

Prefix M7_dcs
Debug 1
Const 0

Index a
 a_lc: lc, 1!0
 a_prev: prev, 1!0000000100000

Index b
 b_lc: lc, 1!1
 b_ls: ls, 1!11111111100000
 b_as: as, 1!11111111100000

Index c
 c_lc: lc, 1!1
 c_coded: coded, 1!1
 c_qs: qs, 1!00010111100000000000000000000000

Index d
 d_lc: lc, 1!1
 d_lbn: lbn, 1!11000110000100010
 d_abn: abn, 1!11100110000000110

Index e
 e_lc: lc, 1!1
 e_ls2: ls2, 1!11
 e_as2: as2, 1!11
 e_psg: psg, 1!11

Index h
 h_lc: lc, 1!1
 h_sz: sz, 1!011110110000
 h_psg: psg, 1!11

Index i
 i_lc: lc, 1!1
 i_prev: prev, 1!0110110100000
 i_coded: coded, 1!1

Index j
 j_lc: lc, 1!1
 j_ls: ls, 1!01111111100000
 j_prev: prev, 1!0011111100000

Index k
 k_lc: lc, 1!0
 k_as: as, 1!11111100000000
 k_prev: prev, 1!0000000000000

Index l
 l_lc: lc, 1!1

Index m
 m_lc: lc, 1!0
 m_coded: coded, 1!1

Index w
 w_lc: lc, 1!1
 w_psg: psg, 1!10

Index s
 s_lc: lc, 1!1
 s_prev: prev, 1!1111111100000

Index f
 f_lc: lc, 1!1

Index t
 t_lc: lc, 1!1
 t_prev: prev, 1!1000111100000

Index n
 n_lc: lc, 1!0

Index g

Number rA, 1, 0!00000000
Number mwA, 1, 0!10001101
Number rB, 1, 0!11111110
Number mwB, 1, 0!00000000
Number rC, 1, 0!11111100
Number mwC, 1, 0!01000001
Number rD, 1, 0!11111101
Number mwD, 1, 0!00010000
Number rE, 1, 0!10000110
Number mwE, 1, 0!01000000
Number rH, 1, 0!11111101
Number mwH, 1, 0!01000010
Number rI, 1, 0!11111111
Number mwI, 1, 0!01111111
Number rJ, 1, 0!11111001
Number mwJ, 1, 0!01001011
Number rK, 1, 0!11111110
Number mwK, 1, 0!00101100
Number rL, 1, 0!00111111
Number mwL, 1, 0!10000000
Number lr, 1, 0!11100
Number mb, 1, 0!00100000
Number rT, 1, 0!11111110
Number mwT, 1, 0!10000000
Number mt, 1, 0!110
Number rS1, 1, 0!01000
Number rS2, 1, 0!00000
Number qs, 1, 3!1101010
Number qf, 1, 3!0000000
Number bw, 1, 0!10000

#  Frozen: what dcs never reads, which live would only take opt.pl's trials.
! Number lrm, 1, 0!11000
! Number mbm, 1, 0!10000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
