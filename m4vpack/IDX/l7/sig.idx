#  m4vpack's sig family at level -7: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l7/sig_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The significance (node 0) and "last" (node 1) flags of a block's coefficients, in scan order.

Prefix M7_sig
Debug 1
Const 0

Index a
 a_cls: cls, &000
 a_nc: nc, 1!00000000000000000
 a_qs: qs, 1!00001000001000000000000000000000
 a_pos: pos, &000000

Index b
 b_cls: cls, &111
 b_kb: kb, 1!0000000000000000
 b_pos: pos, &001100

Index c
 c_cls: cls, &010
 c_nz: nz, 1!11111111
 c_pos: pos, &000000

Index d
 d_cls: cls, &111
 d_past: past, 1!11111101
 d_qs: qs, 1!00000000000000000000000000000000
 d_pos: pos, &111111

Index e
 e_cls: cls, &110
 e_run: run, 1!1110100010000000
 e_pos: pos, &111111

Index h
 h_cls: cls, &001
 h_fp: fp, &11111
 h_pos: pos, &111111

Index i
 i_cls: cls, &111
 i_mvc: mvc, 1!111010001000000101111111100000
 i_pos: pos, &111111

Index j
 j_cls: cls, &101
 j_rnz: rnz, 1!11100100001000000
 j_xm: xm, 1!110000010
 j_pos: pos, &000000

Index k
 k_cls: cls, &111
 k_h8: h8, &11111111
 k_pos: pos, &111111

Index l
 l_cls: cls, &000
 l_pos: pos, &111111
 l_h16: h16, &1111111101111011

Index m
 m_cls: cls, &010
 m_pos: pos, &111110

Index w
 w_cls: cls, &100
 w_kb: kb, 1!1000010000000000
 w_qs: qs, 1!00000000000000000000000000000000

Index s
 s_cls: cls, &001
 s_sl: sl, 1!01000100000000010
 s_sa: sa, 1!10100100000000010
 s_pb: pos, 1!0010000000000000000010000000000000000000000000000000000000000000

Index f
 f_cls: cls, &111
 f_pos: pos, &111111

Index t

Index n

Index g

Number rA, 1, 0!00000011
Number mwA, 1, 0!00000011
Number rB, 1, 0!11111111
Number mwB, 1, 0!10000000
Number rC, 1, 0!11111111
Number mwC, 1, 0!00101110
Number rD, 1, 0!11111100
Number mwD, 1, 0!00000101
Number rE, 1, 0!11111110
Number mwE, 1, 0!00000001
Number rH, 1, 0!11111110
Number mwH, 1, 0!00010011
Number rI, 1, 0!11111111
Number mwI, 1, 0!00100000
Number rJ, 1, 0!11111111
Number mwJ, 1, 0!00000100
Number rK, 1, 0!11111111
Number mwK, 1, 0!00100000
Number rL, 1, 0!11111110
Number mwL, 1, 0!00000100
Number lr, 1, 0!01100
Number mb, 1, 0!01000010
Number rS1, 1, 0!10000
Number rS2, 1, 0!00000
Number qs, 1, 3!1000011
Number qf, 1, 3!0000000
Number bw, 1, 0!10000

#  Frozen: what sig never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10100
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
