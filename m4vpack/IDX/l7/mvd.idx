#  m4vpack's mvd family at level -7: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l7/mvd_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  A motion vector difference in units of the VLC code (code(): nodes 0-12) and the f_code residual
#  bits below them (nodes 13-18).

Prefix M7_mvd
Debug 1
Const 0

Index a
 a_kind: kind, 1!00000
 a_comp: comp, 1!0
 a_ns: ns, 1!0001111111011110

Index b
 b_kind: kind, 1!00110
 b_comp: comp, 1!1
 b_oth: oth, 1!01010011010100110

Index c
 c_kind: kind, 1!11011
 c_comp: comp, 1!0
 c_rs: rs, 1!11110010000010000

Index d
 d_kind: kind, 1!11101
 d_comp: comp, 1!1
 d_dz: dz, 1!01111001000000100
 d_ds: ds, 1!11

Index e
 e_kind: kind, 1!11100
 e_comp: comp, 1!0
 e_sp: sp, 1!11110101010001010

Index h
 h_kind: kind, 1!01111
 h_comp: comp, 1!1
 h_lq: lq, 1!11111111100000110
 h_aq: aq, 1!11101100001000010

Index i
 i_kind: kind, 1!11110
 i_comp: comp, 1!1
 i_fc: fc, 1!011000

Index j
 j_kind: kind, 1!00100
 j_comp: comp, 1!0
 j_rbi: rbi, 1!11111
 j_rsame: rsame, 1!11

Index k
 k_kind: kind, 1!00000
 k_comp: comp, 1!1
 k_ns: ns, 1!1101100000000100
 k_oth: oth, 1!11110010000000010

Index l
 l_kind: kind, 1!00000
 l_comp: comp, 1!1

Index m
 m_kind: kind, 1!00000
 m_comp: comp, 1!0

Index w
 w_kind: kind, 1!10011
 w_comp: comp, 1!0
 w_oth: oth, 1!11001000000000010

Index s
 s_kind: kind, 1!00001
 s_comp: comp, 1!1
 s_oth: oth, 1!10100000000000010

Index f
 f_kind: kind, 1!10011
 f_comp: comp, 1!1
 f_ns: ns, 1!1010000100000000

Index t
 t_kind: kind, 1!11100
 t_comp: comp, 1!1

Index n
 n_kind: kind, 1!00000

Index g

Number rA, 1, 0!00000000
Number mwA, 1, 0!10110010
Number rB, 1, 0!00000000
Number mwB, 1, 0!10000001
Number rC, 1, 0!11111111
Number mwC, 1, 0!00011111
Number rD, 1, 0!11111111
Number mwD, 1, 0!00000101
Number rE, 1, 0!11111111
Number mwE, 1, 0!00010010
Number rH, 1, 0!11111100
Number mwH, 1, 0!00010100
Number rI, 1, 0!11111111
Number mwI, 1, 0!00000111
Number rJ, 1, 0!00101110
Number mwJ, 1, 0!00100000
Number rK, 1, 0!11111001
Number mwK, 1, 0!00111111
Number rL, 1, 0!11111101
Number mwL, 1, 0!01101011
Number lr, 1, 0!01111
Number mb, 1, 0!00100101
Number rT, 1, 0!00000011
Number mwT, 1, 0!01001111
Number mt, 1, 0!110
Number lrm, 1, 0!11111
Number mbm, 1, 0!00101000
Number rS1, 1, 0!01000
Number rS2, 1, 0!00111
Number qs, 1, 3!1111110
Number qf, 1, 3!0011111
Number bw, 1, 0!01100

#  Frozen: what mvd never reads, which live would only take opt.pl's trials.
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
