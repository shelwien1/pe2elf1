#  m4vpack's mbt family at level -7: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l7/mbt_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The macroblock's kind and flags, a decision a node (famvars.inc).

Prefix M7_mbt
Debug 1
Const 0

Index a
 a_st: st, 1!000
 a_cl: cl, 1!10
 a_rt: rt, 1!110

Index b
 b_st: st, 1!110
 b_c4: c4, 1!0001
 b_rt: rt, 1!111

Index c
 c_st: st, 1!111
 c_rc: rc, 1!1010100000

Index d
 d_st: st, 1!100
 d_cd: cd, 1!11
 d_cl: cl, 1!10

Index e
 e_st: st, 1!000
 e_intra: intra, 1!1
 e_cl: cl, 1!10

Index h
 h_st: st, 1!110
 h_fsn: fsn, 1!111

Index i
 i_st: st, 1!111
 i_cl: cl, 1!11
 i_c4: c4, 1!1111

Index j
 j_st: st, 1!100
 j_rc: rc, 1!1111111111
 j_cl: cl, 1!11

Index k
 k_st: st, 1!110
 k_rt: rt, 1!101
 k_c4: c4, 1!1110

Index l
 l_st: st, 1!100

Index m
 m_st: st, 1!000

Index w
 w_st: st, 1!100
 w_rt: rt, 1!111

Index s
 s_st: st, 1!111
 s_cl: cl, 1!11

Index f
 f_st: st, 1!111

Index t

Index n

Index g

Number rA, 1, 0!11111111
Number mwA, 1, 0!10111011
Number rB, 1, 0!00000000
Number mwB, 1, 0!00011110
Number rC, 1, 0!00000000
Number mwC, 1, 0!00011001
Number rD, 1, 0!11111101
Number mwD, 1, 0!10000000
Number rE, 1, 0!11111111
Number mwE, 1, 0!11111111
Number rH, 1, 0!11111100
Number mwH, 1, 0!11010110
Number rI, 1, 0!11111011
Number mwI, 1, 0!00100110
Number rJ, 1, 0!11111111
Number mwJ, 1, 0!00000000
Number rK, 1, 0!11111111
Number mwK, 1, 0!00100000
Number rL, 1, 0!11111110
Number mwL, 1, 0!11001001
Number lr, 1, 0!01110
Number mb, 1, 0!00011111
Number rS1, 1, 0!01000
Number rS2, 1, 0!00011
Number qs, 1, 3!1011000
Number qf, 1, 3!0111110
Number bw, 1, 0!10000

#  Frozen: what mbt never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
