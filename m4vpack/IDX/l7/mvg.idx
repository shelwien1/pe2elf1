#  m4vpack's mvg family at level -7: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l7/mvg_h.inc and _p.inc from
#  this file and family.inc.  famvars.inc says what each variable is.
#
#  The sign of a nonzero motion vector difference.

Prefix M7_mvg
Debug 1
Const 0

Index a
 a_kind: kind, 1!11100
 a_comp: comp, 1!1
 a_ls: ls, 1!11
 a_as: as, 1!11

Index b
 b_kind: kind, 1!11111
 b_comp: comp, 1!1
 b_ds: ds, 1!11
 b_dz: dz, 1!11101000100000010

Index c
 c_kind: kind, 1!01010
 c_comp: comp, 1!1
 c_mag: mag, 1!0110000000000000

Index d
 d_kind: kind, 1!11100
 d_comp: comp, 1!0
 d_hm: hm, 1!100

Index e
 e_kind: kind, 1!01101
 e_comp: comp, 1!0
 e_ds: ds, 1!11
 e_hm: hm, 1!111

Index h
 h_kind: kind, 1!01100
 h_comp: comp, 1!0
 h_ls: ls, 1!11

Index i
 i_kind: kind, 1!00000
 i_comp: comp, 1!0
 i_as: as, 1!01

Index j
 j_kind: kind, 1!00111
 j_comp: comp, 1!1
 j_ds: ds, 1!11
 j_mag: mag, 1!0110000010000000

Index k
 k_kind: kind, 1!01110
 k_ls: ls, 1!11
 k_as: as, 1!11
 k_ds: ds, 1!10

Index l
 l_kind: kind, 1!00011
 l_comp: comp, 1!1

Index m
 m_kind: kind, 1!00111
 m_comp: comp, 1!0

Index w
 w_kind: kind, 1!11010
 w_comp: comp, 1!0
 w_ls: ls, 1!10
 w_as: as, 1!10

Index s
 s_kind: kind, 1!00000
 s_comp: comp, 1!0
 s_ds: ds, 1!11

Index f
 f_kind: kind, 1!11101

Index t

Index n

Index g

Number rA, 1, 0!11111111
Number mwA, 1, 0!00011001
Number rB, 1, 0!00000000
Number mwB, 1, 0!01000100
Number rC, 1, 0!00000000
Number mwC, 1, 0!01001101
Number rD, 1, 0!01001111
Number mwD, 1, 0!00000101
Number rE, 1, 0!11111111
Number mwE, 1, 0!00000000
Number rH, 1, 0!11111110
Number mwH, 1, 0!10001110
Number rI, 1, 0!11111011
Number mwI, 1, 0!11111110
Number rJ, 1, 0!10011101
Number mwJ, 1, 0!00000000
Number rK, 1, 0!11111000
Number mwK, 1, 0!01101111
Number rL, 1, 0!00000000
Number mwL, 1, 0!01001110
Number lr, 1, 0!10000
Number mb, 1, 0!10000001
Number rS1, 1, 0!01000
Number rS2, 1, 0!01000
Number qs, 1, 3!0000000
Number qf, 1, 3!1001111
Number bw, 1, 0!01101

#  Frozen: what mvg never reads, which live would only take opt.pl's trials.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is direct, one that
#  does not is hashed into 2^h rows and contexts share them.  Frozen: left live these only grow.
! Number hA, 1, 0!10110
! Number hB, 1, 0!10110
! Number hC, 1, 0!10110
! Number hD, 1, 0!10110
! Number hE, 1, 0!10110
! Number hH, 1, 0!10110
! Number hI, 1, 0!10110
! Number hJ, 1, 0!10110
! Number hK, 1, 0!10110
! Number hL, 1, 0!10110
! Number hM, 1, 0!10110
! Number hT, 1, 0!10110
! Number hN, 1, 0!10110
! Number hS, 1, 0!10110
! Number hF, 1, 0!10110
