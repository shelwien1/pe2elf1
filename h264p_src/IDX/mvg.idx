#  h264p's mvg family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/mvg_h.inc and
#  MOD/mvg_p.inc from this file and mvg.inc.
#
#  The sign of a nonzero mvd component, knowing its magnitude. comp is the
#  component, lst the list; ts the template match's vector less the
#  predicted one: 3 x its sign (sgn3) + how the magnitude compares with its
#  (0 equal, 1 less, 2 more), 9 none; zs the same for the vector that would
#  make the motion zero (minus the predicted one), ds for the mvs
#  family's temporal vector (its pd) less the predicted one (9 none); sa/sb the signs of the mvd of A and B (sgn3), mag the magnitude
#  (tc_qlog), tq how well the template matched (0 none), ox for the second
#  component the sign of the first (sgn3; 3 for the first), ns 3 + how
#  many of the vectors of A, B and C are above the predicted one in the
#  component less how many are below, es which way
#  the mvds of A and B were from their template matches', summed (sgn3; 3
#  none).

Prefix H_mvg
Debug 1
Const 0

Index a
 a_comp: comp, 1!1
 a_ts: ts, 1!001001000
 a_mag: mag, 1!1111111

Index b
 b_zs: zs, 1!11111111
 b_mag: mag, 1!1111111
 b_comp: comp, 1!1

Index c
 c_ts: ts, 1!111111111
 c_zs: zs, 1!11111111

Index d
 d_ds: ds, 1!111111111
 d_mag: mag, 1!1111111

Index e
 e_sa: sa, 1!11
 e_sb: sb, 1!11
 e_comp: comp, 1!1
 e_ns: ns, 1!111111

Index h
 h_ts: ts, 1!111111111
 h_tq: tq, 1!011111001110
 h_es: es, 1!111

Index i
 i_ts: ts, 1!111111111
 i_zs: zs, 1!11111111
 i_ds: ds, 1!111111111

Index j
 j_comp: comp, 1!1
 j_lst: lst, 1!1
 j_ox: ox, 1!111
 j_ns: ns, 1!111111

Index k
 k_mag: mag, 1!1111111
 k_ts: ts, 1!111111111
 k_sa: sa, 1!11

Index l
 l_zs: zs, 1!11111111
 l_ds: ds, 1!111111111
 l_sb: sb, 1!11

Index s
 s_ts: ts, 1!111111111
 s_mag: mag, 1!1111111

Index f
 f_comp: comp, 1!1
 f_ts: ts, 1!111111111

Index m
 m_ts: ts, 1!111111111

Index w
 w_zs: zs, 1!11111111
 w_ts: ts, 1!111111111

Index t
 t_comp: comp, 1!0

Index n
 n_comp: comp, 1!0

Index g
 g_comp: comp, 1!0

Number rA, 1, 0!11101011
Number rB, 1, 0!11001101
Number rC, 1, 0!00000011
Number rE, 1, 0!01000000
Number rH, 1, 0!01000000
Number rI, 1, 0!01000000
Number rJ, 1, 0!11100000
Number rK, 1, 0!01000000
Number rL, 1, 0!11101011
Number rD, 1, 0!01101111
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00011101
Number mwB, 1, 0!00010000
Number mwC, 1, 0!00000000
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00100000
Number mwI, 1, 0!00000000
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!00000000
Number mwL, 1, 0!00000010
Number mwD, 1, 0!00011111
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01110
Number mt, 1, 0!110
Number qs, 1, 3!0000000
Number qf, 1, 3!1111010
Number mb, 1, 0!10100000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
