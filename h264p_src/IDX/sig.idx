#  h264p's sig family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/sig_h.inc and
#  MOD/sig_p.inc from this file and sig.inc.
#
#  The significance map, given the number of nonzero coefficients: whether
#  the coefficient at each scan position is nonzero, until none remain. cg
#  is the block's ctxBlockCat, pos the scan position, rem the nonzero
#  coefficients still to come and zl the zero ones (tc_qlog), tot all
#  nonzero ones (tc_qlog), nc CAVLC's nC (class), fld field scan, q6 QP/6.

Prefix H_sig
Debug 1
Const 0

Index a
 a_cg: cg, 1!1111111111111
 a_pos: pos, 1!111111111111111111111111111111111111111111111111111111111111111
 a_rem: rem, 1!1111111111

Index b
 b_cg: cg, 1!1111111111111
 b_pos: pos, 1!111111111111111111111111111111111111111111111111111111111111111
 b_md: md, 1!1111111111111111111

Index c
 c_cg: cg, 1!1111111111111
 c_pos: pos, 1!111111111111111111111111111111111111111111111111111111111111111
 c_q6: q6, 1!11111111
 c_fld: fld, 1!1
 c_pg: pg, 1!1111111111111111

Index d
 d_cg: cg, 1!1111111111111
 d_rem: rem, 1!1111111111
 d_zl: zl, 1!1111111111

Index s
 s_cg: cg, 1!1111111111111
 s_rem: rem, 1!1111111111

Index f
 f_cg: cg, 1!1111111111111
 f_nc: nc, 1!11111

Index m
 m_cg: cg, 1!1111111111111
 m_pos: pos, 1!100100001
 m_rem: rem, 1!1110000000

Index t
 t_cg: cg, 1!0

Index n
 n_cg: cg, 1!0

Index g
 g_cg: cg, 1!0

Number rA, 1, 0!01000000
Number rB, 1, 0!00010000
Number rC, 1, 0!01000000
Number rD, 1, 0!11111111
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000000
Number mwD, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01000
Number qs, 1, 3!0010000
Number qf, 1, 3!0010000
Number mb, 1, 0!00000101

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
