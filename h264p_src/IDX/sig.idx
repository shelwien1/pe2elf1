#  h264p's sig family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/sig_h.inc and
#  MOD/sig_p.inc from this file and sig.inc.
#
#  The significance map, given the number of nonzero coefficients: whether
#  the coefficient at each scan position is nonzero, until none remain. cg
#  is the block's ctxBlockCat, pos the scan position, rem the nonzero
#  coefficients still to come and zl the zero ones (tc_qlog), tot all
#  nonzero ones (tc_qlog), nc CAVLC's nC (class), fld field scan, q6 QP/6,
#  tz the magnitude at the position in the block of the cbf family's tn (1 +
#  up to 3; 5 + where the vector moves it; 0 none), sn whether it is nonzero
#  in the blocks A and B (3 x A + B: 0 none, 1 zero, 2 not), hv which way
#  the texture of the block's prediction runs (4 + log2 of its differences
#  along rows over those along columns, -3 to 3; 0 flat or none), pf for an
#  inter block the prediction's own level at the position (its transform
#  quantized as a residual would be: 1 + tc_qlog of quarter levels, 0 none).

Prefix H_sig
Debug 1
Const 0

Index a
 a_cg: cg, 1!1111111111111
 a_pos: pos, 1!111111111111111111111111111111111111111111111111111111111111111
 a_rem: rem, 1!0101111100

Index b
 b_cg: cg, 1!1111111111111
 b_pos: pos, 1!111110011011110011111111101010111000101110001010011010101010010
 b_md: md, 1!1111111101110111100
 b_hb: hb, 1!

Index c
 c_cg: cg, 1!1101100000000
 c_pos: pos, 1!111111111111111111111111111111111111111111111111111111111111111
 c_q6: q6, 1!11111111
 c_pg: pg, 1!1111111111111111
 c_ft: ft, 1!11111111

Index d
 d_cg: cg, 1!1011000000000
 d_rem: rem, 1!0101100110
 d_zl: zl, 1!0011101010
 d_em: em, 1!1111111111111111
 d_hb: hb, 1!

Index e
 e_cg: cg, 1!1111111111111
 e_pos: pos, 1!111111111111111111111111111111111111111111111111111111111111111
 e_ps: ps, 1!1111111
 e_tz: tz, 1!11111111
 e_pq: pq, 1!111111111111111111111111
 e_pr: pr, 1!0001001

Index h
 h_cg: cg, 1!1101100000000
 h_pos: pos, 1!111111111111111111111111111111111111111111111111111111111111111
 h_ps: ps, 1!1110100
 h_rem: rem, 1!0111111011
 h_tz: tz, 1!11111111
 h_h3: h3, 1!11111111111111

Index i
 i_cg: cg, 1!1111111111111
 i_pos: pos, 1!111111111111111111111111111111111111111111111111111111111111111
 i_pr: pr, 1!1111111
 i_ps: ps, 1!0011000
 i_hv: hv, 1!1111111

Index j
 j_cg: cg, 1!1111111111111
 j_pos: pos, 1!000000100111000010000011100011110000011011101010010110011110010
 j_ft: ft, 1!11111111
 j_h3: h3, 1!10000001000000
 j_nc: nc, 1!00000

Index k
 k_cg: cg, 1!1111111111111
 k_pos: pos, 1!111111111111111111111111111111111111111111111111111111111111111
 k_rem: rem, 1!1111111111
 k_h3: h3, 1!11111111111111
 k_sn: sn, 1!11111111
 k_hv: hv, 1!1111111

Index l
 l_cg: cg, 1!1111111111111
 l_pos: pos, 1!111111111111111111111111111111111111111111111111111111111111111
 l_pe: pe, 1!111111111111111
 l_pr: pr, 1!1111111
 l_sn: sn, 1!11111111
 l_pf: pf, 1!11111111111

Index s
 s_cg: cg, 1!0000000000000
 s_pe: pe, 1!011000100000100
 s_pr: pr, 1!1111111

Index f
 f_cg: cg, 1!1100000000000
 f_nc: nc, 1!11111

Index m
 m_cg: cg, 1!1111111111111
 m_pos: pos, 1!100100001
 m_rem: rem, 1!1110000000

Index w
 w_cg: cg, 1!1011000000000
 w_rem: rem, 1!0101100110
 w_zl: zl, 1!0111100101
 w_em: em, 1!1111111111111111

Index t
 t_cg: cg, 1!0

Index n
 n_cg: cg, 1!0

Index g
 g_cg: cg, 1!0

Number rA, 1, 0!11101100
Number rB, 1, 0!00001000
Number rC, 1, 0!01110100
Number rE, 1, 0!11100000
Number rH, 1, 0!11100000
Number rI, 1, 0!01000000
Number rJ, 1, 0!01000000
Number rK, 1, 0!01000000
Number rL, 1, 0!01000000
Number rD, 1, 0!11111111
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00011
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000000
Number mwB, 1, 0!10000001
Number mwC, 1, 0!00000000
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00000010
Number mwI, 1, 0!00000000
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!00000000
Number mwL, 1, 0!01100000
Number mwD, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!10000
Number mt, 1, 0!110
Number qs, 1, 3!0000000
Number qf, 1, 3!0010000
Number mb, 1, 0!01110000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!10101
! Number hE, 1, 0!10101
! Number hH, 1, 0!10100
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!10101
! Number hL, 1, 0!10101
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
