#  h264p's skp family at level -7: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l7/skp_h.inc and MOD/l7/skp_p.inc from this file and family.inc.
#
#  Whether a macroblock is skipped (node 0), whether the slice ends after it
#  (node 1), mb_field_decoding_flag (node 2). st is the slice type and
#  reference status; a3/b3 the macroblocks A and B (0 none, 1 skipped, 2
#  coded); col the same macroblock in the previous picture of the type, c9
#  the skipped ones in its 3x3 window, cd the skipped ones of C and D, run the
#  skipped macroblocks just before; cnt the macroblocks of the slice so far
#  and eq how that compares with the previous slice (0 fewer, 1 as many, 2
#  more); lf/af the field flags of the left and above pairs (0 none); td how
#  much the macroblock changed between the last two pictures decoded (1 +
#  tc_qlog, 0 not known); in B slices, c1 the same macroblock in list 1's
#  first reference, where that is the last picture of its kind (0 none, 1
#  skipped, 2 coded), and k9 the skipped ones in its 3x3 window (10 none);
#  tx the texture of the skip prediction, per sample, against the
#  quantizer's step (1 + tc_qlog, 0 not known).

Prefix H7_skp
Debug 1
Const 0

Index a
 a_st: st, 1!000000000
 a_a3: a3, 1!10
 a_b3: b3, 1!10
 a_col: col, 1!01
 a_c9: c9, 1!110101001
 a_eq: eq, 1!10
 a_lf: lf, 1!00
 a_af: af, 1!00

Index b
 b_st: st, 1!001000000
 b_a3: a3, 1!11
 b_b3: b3, 1!11
 b_cd: cd, 1!11
 b_cnt: cnt, 1!000000011001101
 b_c1: c1, 1!11

Index c
 c_st: st, 1!010000000
 c_col: col, 1!11
 c_c9: c9, 1!110111111
 c_run: run, 1!010000100
 c_en: en, 1!01111100100001

Index d
 d_st: st, 1!000000000
 d_a3: a3, 1!10
 d_b3: b3, 1!11
 d_td: td, 1!1000000000000000
 d_c1: c1, 1!01
 d_k9: k9, 1!1011111111

Index e
 e_st: st, 1!010000000
 e_td: td, 1!1101000001001001
 e_en: en, 1!01010000101000
 e_sm: sm, 1!0100110100010000
 e_tx: tx, 1!01110101001001

Index h
 h_st: st, 1!010000000
 h_tm: tm, 1!0110101010100000
 h_sm: sm, 1!0111010100100010
 h_bd: bd, 1!1101011101010000

Index i
 i_st: st, 1!011000000
 i_sm: sm, 1!0000000000000000
 i_en: en, 1!01010100001000
 i_a3: a3, 1!00

Index j
 j_st: st, 1!011000000
 j_c9: c9, 1!101000000
 j_qc: qc, 1!00111111100010100

Index k
 k_st: st, 1!000000000
 k_td: td, 1!1100000000000010
 k_tm: tm, 1!0001010101000000
 k_b3: b3, 1!11

Index l
 l_st: st, 1!011000000
 l_bd: bd, 1!1110010010101000
 l_col: col, 1!00
 l_cd: cd, 1!00

Index s
 s_st: st, 1!010000000
 s_bd: bd, 1!1100000100000100

Index m
 m_st: st, 1!010000000
 m_col: col, 1!01
 m_td: td, 1!0100

Index w
 w_st: st, 1!011000000
 w_a3: a3, 1!11
 w_b3: b3, 1!11
 w_td: td, 1!0001000010100001

#  (frozen: see the parameters below)
Index t
! t_st: st, 1!0

Index n
! n_st: st, 1!0

Index g
! g_st: st, 1!0

Number rA, 1, 0!11111111
Number rB, 1, 0!11111110
Number rC, 1, 0!11111110
Number rE, 1, 0!11111110
Number rH, 1, 0!11111101
Number rI, 1, 0!11111111
Number rJ, 1, 0!11111111
Number rK, 1, 0!11100100
Number rL, 1, 0!11111111
Number rD, 1, 0!11111110
Number lr, 1, 0!01111
Number mwA, 1, 0!10000000
Number mwB, 1, 0!00010001
Number mwC, 1, 0!00000001
Number mwE, 1, 0!00010000
Number mwH, 1, 0!00000111
Number mwI, 1, 0!00000100
Number mwJ, 1, 0!00111011
Number mwK, 1, 0!00011110
Number mwL, 1, 0!00010000
Number mwD, 1, 0!00000011
Number mb, 1, 0!00011000

#  Frozen: what skp never reads, which live would only take opt.pl's trials.
#  It codes decisions with bit() alone: no mantissa (rT, mwT, mt, index t),
#  no hint and its mixer (lrm, mbm, index n), no signs (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
