#  h264p's lvl family at level -7: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l7/lvl_h.inc and MOD/l7/lvl_p.inc from this file and family.inc.
#
#  coeff_abs_level_minus1, in reverse scan order as CABAC codes it. cg is the
#  ctxBlockCat, g1/e1 the levels coded so far above 1 and equal to 1, nc the
#  block's nC (class), pos the scan position (class), sa/sb the magnitude at
#  the same position in the blocks A and B (class, 0 zero or none), q6 QP/6,
#  tot the nonzero coefficients of the block (class), tz as the sig
#  family's, hv as the sig family's and fq whether the position is a
#  horizontal (1) or vertical (2) frequency, or both (3), or DC (0).

Prefix H7_lvl
Debug 1
Const 0

Index a
 a_cg: cg, 1!1011000000000
 a_g1: g1, 1!0101
 a_e1: e1, 1!1000
 a_nc: nc, 1!00000

Index b
 b_cg: cg, 1!1111100000000
 b_pe: pe, 1!000010100000000
 b_pos: pos, 1!01101
 b_tot: tot, 1!0111111
 b_hv: hv, 1!1001100
 b_fq: fq, 1!111

Index c
 c_cg: cg, 1!1011100000000
 c_sa: sa, 1!111
 c_sb: sb, 1!111
 c_q6: q6, 1!11111100
 c_lh: lh, 1!1010101110101000110001110011110010000000000000000000011111101110

Index d
 d_cg: cg, 1!1010100000000
 d_g1: g1, 1!0000
 d_md: md, 1!0110000000000101111
 d_pg: pg, 1!0000000000000010
 d_lt: lt, 1!1111010

Index e
 e_cg: cg, 1!0000000000000
 e_g1: g1, 1!0000
 e_e1: e1, 1!0000
 e_pl: pl, 1!01111101011
 e_tz: tz, 1!01111111
 e_pq: pq, 1!000000100000000100101101

Index h
 h_cg: cg, 1!1101100000000
 h_pos: pos, 1!11001
 h_pl: pl, 1!10110110100
 h_pe: pe, 1!010101001000000
 h_tz: tz, 1!11111111

Index i
 i_cg: cg, 1!0001100000000
 i_pl: pl, 1!00010101101
 i_ls: ls, 1!0000000000000
 i_g1: g1, 1!0000

Index j
 j_cg: cg, 1!1100000000000
 j_lt: lt, 1!1111101
 j_lh: lh, 1!1111010100000000000000000000000000000111110100010000000000000000
 j_pos: pos, 1!11111

Index k
 k_cg: cg, 1!0010100000000
 k_pos: pos, 1!10000
 k_pl: pl, 1!10101010010
 k_g1: g1, 1!0000

Index l
 l_cg: cg, 1!0000000000000
 l_sa: sa, 1!111
 l_sb: sb, 1!111
 l_lh: lh, 1!0001100111010001101010101111010110111101001101011011111000011101

Index s
 s_cg: cg, 1!1011000000000
 s_g1: g1, 1!0100
 s_pm: pm, 1!1000
 s_em: em, 1!1000011110000010
 s_ls: ls, 1!1000010010001

Index m
 m_cg: cg, 1!0000000000000
 m_g1: g1, 1!0

Index w
 w_cg: cg, 1!1011100000000
 w_g1: g1, 1!1001
 w_md: md, 1!0110000010000000100
 w_pg: pg, 1!0000000000010001

Index t
 t_cg: cg, 1!1000000000000

Index n
 n_cg: cg, 1!1010100000000

#  (frozen: see the parameters below)
Index g
! g_cg: cg, 1!0

Number rA, 1, 0!11111011
Number rB, 1, 0!11111111
Number rC, 1, 0!11111110
Number rE, 1, 0!11111111
Number rH, 1, 0!11111110
Number rI, 1, 0!10000000
Number rJ, 1, 0!11111110
Number rK, 1, 0!11111110
Number rL, 1, 0!11111111
Number rD, 1, 0!11111111
Number rT, 1, 0!10000000
Number lr, 1, 0!01111
Number lrm, 1, 0!10111
Number mbm, 1, 0!10000000
Number mwA, 1, 0!01011111
Number mwB, 1, 0!00000100
Number mwC, 1, 0!00001000
Number mwE, 1, 0!00010000
Number mwH, 1, 0!00100000
Number mwI, 1, 0!00000100
Number mwJ, 1, 0!00010001
Number mwK, 1, 0!00000001
Number mwL, 1, 0!00110110
Number mwD, 1, 0!00100000
Number mwT, 1, 0!00000000
Number mt, 1, 0!000
Number mb, 1, 0!00011111

#  Frozen: what lvl never reads, which live would only take opt.pl's trials.
#  It codes with code(), without signs: no sign counters (rG, mwG, index g).
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!10000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
