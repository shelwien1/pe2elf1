#  h264p's nal family at level -7: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l7/nal_h.inc and MOD/l7/nal_p.inc from this file and nal.inc.
#
#  NAL unit fields: the field id (fld) is a dense factor and the rest is the
#  field's own recent history (p1, p2) and a context the coder gives (ctx).

Prefix H7_nal
Debug 1
Const 0

Index a
 a_fld: fld, 1!1111000000000101000000000000000
 a_ctx: ctx, 1!101000001000000
 a_p1: p1, 1!000010000000000

Index b
 b_fld: fld, 1!1101100100000001000000000000000
 b_p1: p1, 1!100001
 b_p2: p2, 1!111

Index c
 c_fld: fld, 1!1101001100000001000000000000000
 c_ctx: ctx, 1!1010011000000000000000000000000

Index d
 d_fld: fld, 1!0111101100000001000000000000000

Index e
 e_fld: fld, 1!0110000110000001000000000000000
 e_p2: p2, 1!001

Index h
 h_fld: fld, 1!1111000000000101000000000000000
 h_ctx: ctx, 1!1100011010000000000000000000000

Index i
 i_ctx: ctx, 1!1010000110000000000000000000000
 i_p1: p1, 1!000001000000000

Index j
 j_fld: fld, 1!1011101100000001000000000000000
 j_p2: p2, 1!111
 j_p1: p1, 1!011001000000000

Index k
 k_fld: fld, 1!1101001110000001000000000000000
 k_ctx: ctx, 1!1001010000000000000000000000000

Index l
 l_p1: p1, 1!001001000000000
 l_p2: p2, 1!011

Index s
 s_fld: fld, 1!0111000000000001000000000000000

Index m
 m_fld: fld, 1!0111001100000000000000000000000

Index w
 w_fld: fld, 1!0111001110000101000000000000000

Index t
 t_fld: fld, 1!0000000000000000000000000000000

Index n
 n_fld: fld, 1!0000000000000000000000000000000

Index g
 g_fld: fld, 1!0000000000000000000000000000000
 g_ctx: ctx, 1!000

Number rA, 1, 0!11111000
Number rB, 1, 0!00000000
Number rC, 1, 0!11110000
Number rE, 1, 0!00011111
Number rH, 1, 0!11011100
Number rI, 1, 0!11111000
Number rJ, 1, 0!10110001
Number rK, 1, 0!11111000
Number rL, 1, 0!11111110
Number rD, 1, 0!00000000
Number rT, 1, 0!11111100
Number rG, 1, 0!00000000
Number lr, 1, 0!11111
Number lrm, 1, 0!00000
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000001
Number mwB, 1, 0!00001100
Number mwC, 1, 0!00000100
Number mwE, 1, 0!10000000
Number mwH, 1, 0!00000101
Number mwI, 1, 0!00010011
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!00001101
Number mwL, 1, 0!10101000
Number mwD, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number mt, 1, 0!100
Number mb, 1, 0!01011011

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
