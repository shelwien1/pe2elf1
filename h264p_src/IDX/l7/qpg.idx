#  h264p's qpg family at level -7: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l7/qpg_h.inc and MOD/l7/qpg_p.inc from this file and qpg.inc.
#
#  The sign of a nonzero mb_qp_delta, knowing its magnitude. as is the
#  delta adaptive quantization's line asks for: 3 x its sign (sgn3) + how
#  the magnitude compares with its (0 equal, 1 less, 2 more), 9 none; cs
#  the same for the QP of the same macroblock in the previous picture of
#  the type less the predicted one, bs for macroblock B's (9 none); ls the
#  sign of the last nonzero delta (sgn3), rs that of how far the last
#  picture of the kind was from its line where the macroblock's content
#  was (sgn3, 3 none), mag the magnitude (tc_qlog), cls the class of the
#  macroblock, st the slice type and reference status, ss as as for the
#  slice's QP less the predicted one, xe the qpd family's energy class, lq
#  as as for the QP of the last macroblock of the kind and class (qpd's
#  lq), bk for B's where it is of the kind (qpd's bc).

Prefix H7_qpg
Debug 1
Const 0

Index a
 a_as: as, 1!000000000
 a_mag: mag, 1!0000100
 a_ss: ss, 1!000001010
 a_xe: xe, 1!100001011000001011
 a_lq: lq, 1!001101101

Index b
 b_as: as, 1!001101000
 b_ls: ls, 1!10

Index c
 c_as: as, 1!000001011
 c_cs: cs, 1!001011101

Index d
 d_bs: bs, 1!001011111
 d_mag: mag, 1!0110100
 d_bk: bk, 1!000000001

Index e
 e_cs: cs, 1!000001011
 e_rs: rs, 1!001
 e_ss: ss, 1!001111110

Index h
 h_as: as, 1!001110000
 h_rs: rs, 1!111
 h_ls: ls, 1!11

Index i
 i_as: as, 1!000111001
 i_cs: cs, 1!001101110
 i_bs: bs, 1!001111111

Index j
 j_cls: cls, 1!00111110
 j_st: st, 1!011000000
 j_ls: ls, 1!00

Index k
 k_mag: mag, 1!0110000
 k_as: as, 1!001001111
 k_cls: cls, 1!00000110

Index l
 l_cs: cs, 1!001111110
 l_bs: bs, 1!001111100
 l_ls: ls, 1!01

Index s
 s_as: as, 1!001011111
 s_mag: mag, 1!0101010

Index m
 m_as: as, 1!000000000

Index w
 w_as: as, 1!000011000
 w_cs: cs, 1!001011101

Index t
 t_st: st, 1!0

Index n
 n_st: st, 1!0

Index g
 g_st: st, 1!0

Number rA, 1, 0!11111111
Number rB, 1, 0!01011100
Number rC, 1, 0!00000010
Number rE, 1, 0!01000100
Number rH, 1, 0!11001110
Number rI, 1, 0!11110010
Number rJ, 1, 0!11101111
Number rK, 1, 0!11111110
Number rL, 1, 0!11111110
Number rD, 1, 0!11111101
Number rT, 1, 0!00000000
Number rG, 1, 0!00000000
Number lr, 1, 0!01110
Number lrm, 1, 0!00000
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000111
Number mwB, 1, 0!01000001
Number mwC, 1, 0!11000010
Number mwE, 1, 0!00010001
Number mwH, 1, 0!10000001
Number mwI, 1, 0!00101110
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!00000100
Number mwL, 1, 0!01000010
Number mwD, 1, 0!00000011
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number mt, 1, 0!000
Number mb, 1, 0!10000010

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
