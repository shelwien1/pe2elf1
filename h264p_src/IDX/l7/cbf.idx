#  h264p's cbf family at level -7: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l7/cbf_h.inc and MOD/l7/cbf_p.inc from this file and cbf.inc.
#
#  The number of nonzero coefficients of a block, 0 for none (kn 0), or
#  less 1 where the block is known to have one (kn 1: CABAC 8x8 blocks
#  without coded_block_flag). cat is the block's ctxBlockCat; na/nb the
#  nonzero coefficients of the blocks A and B (9 for none), intra the
#  macroblock is intra, q6 QP/6, np the nonzero blocks so far in its 8x8
#  block (for chroma: in the macroblock), pos the block's place in its 8x8
#  block, crcb for a Cr block the Cb block (0 none, 1 zero, 2 not), col the
#  same block in the previous picture of the type (2 none), nc CAVLC's nC
#  (class), tn for a luma block of a P picture the nonzero coefficients of
#  the block its vector points at in its reference, where that is the
#  last picture of a kind (1 + up to 4; 6 + where the vector moves it; 0
#  none); ds for an inter luma 4x4 block of a P or B slice, 1 + the score
#  of x264's decimation its 8x8 block still owes after the blocks before it
#  (4, or 6 for the macroblock's only coded 8x8 block, less theirs; 0 not
#  applicable); hv as the sig family's; ly for a 4:2:0 chroma block the
#  coefficients of the luma under it (its 8x8 block; for DC the
#  macroblock's), 1 + tc_qlog (0 luma); dq for a 4:2:0 chroma AC block
#  its DC, from the chroma DC levels' 2x2 transform, for an Intra16x16
#  luma AC block from the luma DC levels' 4x4 one (1 + tc_qlog, 0 not such
#  a block).

Prefix H7_cbf
Debug 1
Const 0

Index a
 a_cat: cat, 1!1100000000000
 a_na: na, 1!000000011
 a_nb: nb, 1!000101010
 a_intra: intra, 1!0
 a_ly: ly, 1!1101111010

Index b
 b_cat: cat, 1!1111100000000
 b_np: np, 1!110
 b_pos: pos, 1!011
 b_crcb: crcb, 1!11
 b_kn: kn, 1!0
 b_em: em, 1!1000010101010000
 b_dq: dq, 1!00101100

Index c
 c_cat: cat, 1!1111000000000
 c_q6: q6, 1!00111000
 c_col: col, 1!11
 c_kn: kn, 1!1
 c_en: en, 1!10000000100010
 c_ch: ch, 1!111110111010000

Index d
 d_cat: cat, 1!1011000000000
 d_nc: nc, 1!00001
 d_md: md, 1!1110000000000111101
 d_kn: kn, 1!1
 d_pg: pg, 1!0000010010010000

Index e
 e_cat: cat, 1!1111000000000
 e_pz: pz, 1!1110110100000000
 e_na: na, 1!110000100
 e_nb: nb, 1!110010000
 e_tn: tn, 1!0001100001

Index h
 h_cat: cat, 1!1011100000000
 h_pg: pg, 1!0101001101100101
 h_md: md, 1!1101100100110100110
 h_q6: q6, 1!11111100
 h_hv: hv, 1!0110010

Index i
 i_cat: cat, 1!1111100000000
 i_pz: pz, 1!1111010010100001
 i_pq: pq, 1!000000000100000000001010
 i_np: np, 1!101
 i_ds: ds, 1!1111100

Index j
 j_cat: cat, 1!1011000000000
 j_em: em, 1!1011000010101001
 j_pg: pg, 1!0110100101001010
 j_na: na, 1!000100001

Index k
 k_cat: cat, 1!1000100000000
 k_na: na, 1!000000000
 k_nb: nb, 1!000000000
 k_pz: pz, 1!1001101001000100

Index l
 l_cat: cat, 1!1111100000000
 l_col: col, 1!00
 l_np: np, 1!000
 l_md: md, 1!0000000000000000000

Index s
 s_cat: cat, 1!0000000000000
 s_kn: kn, 1!0
 s_pq: pq, 1!000000000000000000000001

Index m
 m_cat: cat, 1!1111000000000
 m_kn: kn, 1!1

Index w
 w_cat: cat, 1!1011000000000
 w_nc: nc, 1!11010
 w_md: md, 1!0010000010000000100
 w_kn: kn, 1!1

Index t
 t_cat: cat, 1!1011100000000

Index n
 n_cat: cat, 1!1111100000000

Index g
 g_cat: cat, 1!0

Number rA, 1, 0!11111111
Number rB, 1, 0!11111101
Number rC, 1, 0!11111111
Number rE, 1, 0!11111101
Number rH, 1, 0!11111110
Number rI, 1, 0!11111110
Number rJ, 1, 0!11111111
Number rK, 1, 0!00000000
Number rL, 1, 0!10111110
Number rD, 1, 0!11111111
Number rT, 1, 0!00010000
Number rG, 1, 0!00000000
Number lr, 1, 0!01100
Number lrm, 1, 0!11111
Number mbm, 1, 0!00100000
Number mwA, 1, 0!01000000
Number mwB, 1, 0!00000001
Number mwC, 1, 0!00100000
Number mwE, 1, 0!00111111
Number mwH, 1, 0!00000001
Number mwI, 1, 0!00001001
Number mwJ, 1, 0!00100010
Number mwK, 1, 0!01111111
Number mwL, 1, 0!00100000
Number mwD, 1, 0!01000000
Number mwT, 1, 0!00100000
Number mwG, 1, 0!00000000
Number mt, 1, 0!010
Number mb, 1, 0!10000010

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!10001
! Number hC, 1, 0!11000
! Number hE, 1, 0!10000
! Number hH, 1, 0!10000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
