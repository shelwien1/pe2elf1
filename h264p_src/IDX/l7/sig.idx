#  h264p's sig family at level -7: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l7/sig_h.inc and MOD/l7/sig_p.inc from this file and sig.inc.
#
#  The significance map, given the number of nonzero coefficients: whether
#  the coefficient at each scan position is nonzero, until none remain. cg
#  is the block's ctxBlockCat, pos the scan position, rem the nonzero
#  coefficients still to come and zl the zero ones (tc_qlog), tot all
#  nonzero ones (tc_qlog), nc CAVLC's nC (class), fld field scan, q6 QP/6,
#  tz the magnitude at the position in the block of the cbf family's tn (1 +
#  up to 3; 5 + where the vector moves it; 0 none), sn whether it is nonzero
#  in the blocks A and B (3 x A + B: 0 none, 1 zero, 2 not), hv which way
#  the texture of the block's prediction runs (4 + log2 of its differences
#  along rows over those along columns, -3 to 3; 0 flat or none), pf for an
#  inter block the prediction's own level at the position (its transform
#  quantized as a residual would be: 1 + tc_qlog of quarter levels, 0 none).

Prefix H7_sig
Debug 1
Const 0

Index a
 a_cg: cg, 1!1111100000000
 a_pos: pos, 1!111111111111110010010011000111000100011010011001100010111101110
 a_rem: rem, 1!0110101010

Index b
 b_cg: cg, 1!1111100000000
 b_pos: pos, 1!101001011111111101010001110100000000001001000001010110001110010
 b_md: md, 1!1111111101110111100
 b_hb: hb, 1!

Index c
 c_cg: cg, 1!1111100000000
 c_pos: pos, 1!101011010101111010101011110101110100011010011111111110111001000
 c_q6: q6, 1!10111110
 c_pg: pg, 1!0011011101111011
 c_ft: ft, 1!10111111

Index d
 d_cg: cg, 1!1101100000000
 d_rem: rem, 1!0101100100
 d_zl: zl, 1!0011100110
 d_em: em, 1!0000010001000100
 d_hb: hb, 1!

Index e
 e_cg: cg, 1!0000000000000
 e_pos: pos, 1!000000000000000000000100000000000000000000000000000000000011010
 e_ps: ps, 1!1101110
 e_tz: tz, 1!11011000
 e_pq: pq, 1!000000000000000000000001
 e_pr: pr, 1!0101101

Index h
 h_cg: cg, 1!1011100000000
 h_pos: pos, 1!000001101111110001111101111111101011101101011110011100001111010
 h_ps: ps, 1!0010011
 h_rem: rem, 1!0101010110
 h_tz: tz, 1!11111110
 h_h3: h3, 1!00000000000000

Index i
 i_cg: cg, 1!0011100000000
 i_pos: pos, 1!111110111011111011010011011110101000001010001010010111001001100
 i_pr: pr, 1!1011110
 i_ps: ps, 1!0011001
 i_hv: hv, 1!1101110

Index j
 j_cg: cg, 1!0000000000000
 j_pos: pos, 1!000000000000000000001010010000101100101101101010001111101010010
 j_ft: ft, 1!00111111
 j_h3: h3, 1!10000000000000
 j_nc: nc, 1!00000

Index k
 k_cg: cg, 1!1111100000000
 k_pos: pos, 1!111111111111110110110111111111101111011111111010011111111011100
 k_rem: rem, 1!0110101000
 k_h3: h3, 1!01011101101011
 k_sn: sn, 1!10000000
 k_hv: hv, 1!1011101

Index l
 l_cg: cg, 1!1111100000000
 l_pos: pos, 1!000000001110010110011100110000110011110110000101110010101110000
 l_pe: pe, 1!000000000000000
 l_pr: pr, 1!1010100
 l_sn: sn, 1!10011111
 l_pf: pf, 1!10110101011

Index s
 s_cg: cg, 1!0000000000000
 s_pe: pe, 1!000000000000000
 s_pr: pr, 1!1001000

Index m
 m_cg: cg, 1!1111100000000
 m_pos: pos, 1!111110011
 m_rem: rem, 1!0110010001

Index w
 w_cg: cg, 1!0011100000000
 w_rem: rem, 1!0001100100
 w_zl: zl, 1!0101001011
 w_em: em, 1!1010000000010000

Index t
 t_cg: cg, 1!0

Index n
 n_cg: cg, 1!0

Index g
 g_cg: cg, 1!0

Number rA, 1, 0!11111111
Number rB, 1, 0!10011001
Number rC, 1, 0!11100000
Number rE, 1, 0!11111111
Number rH, 1, 0!11110110
Number rI, 1, 0!11111111
Number rJ, 1, 0!11111111
Number rK, 1, 0!11101111
Number rL, 1, 0!10110011
Number rD, 1, 0!11110100
Number rT, 1, 0!00000000
Number rG, 1, 0!00000000
Number lr, 1, 0!01111
Number lrm, 1, 0!00000
Number mbm, 1, 0!00000000
Number mwA, 1, 0!01011101
Number mwB, 1, 0!10000000
Number mwC, 1, 0!00001000
Number mwE, 1, 0!00000100
Number mwH, 1, 0!00100010
Number mwI, 1, 0!00110000
Number mwJ, 1, 0!10000000
Number mwK, 1, 0!00000111
Number mwL, 1, 0!00100000
Number mwD, 1, 0!00100101
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number mt, 1, 0!000
Number mb, 1, 0!01001001

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!10101
! Number hC, 1, 0!11000
! Number hE, 1, 0!10101
! Number hH, 1, 0!10100
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!10101
! Number hL, 1, 0!10101
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
