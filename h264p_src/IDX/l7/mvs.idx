#  h264p's mvs family at level -7: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l7/mvs_h.inc and MOD/l7/mvs_p.inc from this file and family.inc.
#
#  Motion: sub_mb_type (kind 0 P, 1 B, as a binary tree), ref_idx (kind 2) and
#  the components of mvd (kind 3; the sign is the mvg family's). comp is the
#  component, lst the list, ma/mb the magnitudes of the components of A and
#  B (classes), oth the class of the other component already coded, ps the
#  partition size (0 16x16 .. 3 4x4), rf the ref_idx of the partition (or of
#  A for ref_idx), pi the partition's place in the macroblock, nr the
#  references of the list; for mvd pd the vector of the same partition in the
#  previous picture of the type (scaled by the POC distance of the
#  partition's reference against that of its own; in B slices the one
#  temporal direct would give, where list 1's first reference has one)
#  less the predicted vector, sp how far the
#  vectors of the neighbours A, B, C are from the predicted one (1 + tc_qlog,
#  0 none), for ref_idx pd the ref_idx in the previous picture; tv for mvd
#  the template match's vector less the predicted one (1 + sq2, 0 none),
#  for ref_idx 1 + the reference it matches best; tq how well it matched
#  (mvd), how much better than on the first reference (ref_idx); rt the
#  texture of the reference (for ref_idx, the first) at the predicted
#  vector (for mvd, across the component), per sample, against the
#  quantizer's step (1 + tc_qlog, 0 none); ea/eb for mvd how far the mvds
#  of A and B were from their template matches' (1 + tc_qlog up to 5, 0
#  none); ta the vector the template search found second best of its
#  starts, less the predicted one (1 + sq2, 0 none).

Prefix H7_mvs
Debug 1
Const 0

Index a
 a_kind: kind, 1!111
 a_comp: comp, 1!1
 a_ma: ma, 1!0110000
 a_mb: mb, 1!0110000
 a_oth: oth, 1!11110
 a_sp: sp, 1!10010010
 a_rt: rt, 1!01000000110001

Index b
 b_kind: kind, 1!001
 b_comp: comp, 1!1
 b_lst: lst, 1!1
 b_ps: ps, 1!111
 b_rf: rf, 1!111
 b_zd: zd, 1!101111111111

Index c
 c_kind: kind, 1!101
 c_comp: comp, 1!0
 c_pd: pd, 1!11101101
 c_sp: sp, 1!11101101
 c_zd: zd, 1!101010101001

Index d
 d_kind: kind, 1!001
 d_comp: comp, 1!0
 d_pd: pd, 1!11110111
 d_ma: ma, 1!0000000
 d_nr: nr, 1!111

Index e
 e_kind: kind, 1!101
 e_comp: comp, 1!0
 e_sp: sp, 1!00000000
 e_rt: rt, 1!11001111001010

Index h
 h_kind: kind, 1!011
 h_comp: comp, 1!0
 h_oth: oth, 1!00000

Index i
 i_kind: kind, 1!011
 i_comp: comp, 1!1
 i_zd: zd, 1!100000011000

Index j
 j_kind: kind, 1!011
 j_comp: comp, 1!0
 j_ma: ma, 1!1111101
 j_mb: mb, 1!1111101
 j_cq: cq, 1!011111001

Index k
 k_kind: kind, 1!011
 k_comp: comp, 1!0
 k_pd: pd, 1!11110010
 k_sp: sp, 1!01101001
 k_ps: ps, 1!111

Index l
 l_kind: kind, 1!010
 l_comp: comp, 1!0
 l_oth: oth, 1!11001
 l_rf: rf, 1!110

Index s
 s_kind: kind, 1!111
 s_comp: comp, 1!1

Index m
 m_kind: kind, 1!110
 m_comp: comp, 1!0
 m_pd: pd, 1!10011

Index w
 w_kind: kind, 1!011
 w_comp: comp, 1!1
 w_pd: pd, 1!11000101
 w_ma: ma, 1!1101010
 w_nr: nr, 1!011

Index t
 t_kind: kind, 1!001
 t_comp: comp, 1!1

Index n
 n_kind: kind, 1!000

#  (frozen: see the parameters below)
Index g
! g_kind: kind, 1!000
! g_ma: ma, 1!0
! g_oth: oth, 1!0

Number rA, 1, 0!11111111
Number rB, 1, 0!00000000
Number rC, 1, 0!11111111
Number rE, 1, 0!11111111
Number rH, 1, 0!01001100
Number rI, 1, 0!10001011
Number rJ, 1, 0!11111111
Number rK, 1, 0!11111111
Number rL, 1, 0!11111110
Number rD, 1, 0!11111010
Number rT, 1, 0!00011011
Number lr, 1, 0!01111
Number lrm, 1, 0!00000
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00001000
Number mwB, 1, 0!00111111
Number mwC, 1, 0!00010011
Number mwE, 1, 0!00010000
Number mwH, 1, 0!00000100
Number mwI, 1, 0!00000100
Number mwJ, 1, 0!01000101
Number mwK, 1, 0!10000000
Number mwL, 1, 0!00010011
Number mwD, 1, 0!00100000
Number mwT, 1, 0!01000000
Number mt, 1, 0!110
Number mb, 1, 0!00011101

#  Frozen: what mvs never reads, which live would only take opt.pl's trials.
#  It codes with code(), without signs: no sign counters (rG, mwG, index g).
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!10000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!10000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
