#  h264p's sgn family at level -9: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l9/sgn_h.inc and MOD/l9/sgn_p.inc from this file and family.inc.
#
#  The sign of a nonzero coefficient. cg is the ctxBlockCat, pos the scan
#  position (class), sa/sb the sign at the same position in the blocks A and
#  B (0 zero, 1 positive, 2 negative, 3 none), scb for Cr DC the sign of Cb
#  at the same position, mag the magnitude (class), md the block's prediction
#  (as the other residual families); for the signs predicted from the samples
#  around the block (luma), pp the predicted sign (1 positive, 2 negative, 0
#  not predicted) and mg how much worse the other sign fits (1 + tc_qlog of
#  quarter samples); ts the sign at the position in the block of the cbf
#  family's tn (1 + sgn3; 4 + where the vector moves it; 0 none); dm for an
#  inter luma block, the sign its residual would have were it a small shift
#  of its prediction (the levels of the prediction's gradients), the shift
#  fitted to the coefficients whose signs are known so far (1 +, 2 -; 2 or 4
#  more as the level that gives reaches a quarter of the coefficient's, or
#  all of it; 0 none).

Prefix H9_sgn
Debug 1
Const 0

Index a
 a_cg: cg, 1!1100000000000
 a_pos: pos, 1!101
 a_sa: sa, 1!111
 a_sb: sb, 1!111
 a_gh: gh, 1!00000000

Index b
 b_cg: cg, 1!0011100000000
 b_scb: scb, 1!111
 b_pos: pos, 1!100

Index c
 c_cg: cg, 1!1001100000000
 c_mag: mag, 1!00
 c_md: md, 1!0000001000101111000

Index d
 d_cg: cg, 1!1101100000000
 d_pp: pp, 1!11
 d_mg: mg, 1!011010001001010

Index e
 e_cg: cg, 1!1111000000000
 e_pp: pp, 1!00
 e_mg: mg, 1!101010110111001
 e_mag: mag, 1!00

Index h
 h_cg: cg, 1!0111100000000
 h_pos: pos, 1!110
 h_ez: ez, 1!01111
 h_pp: pp, 1!11
 h_ts: ts, 1!011111
 h_pq: pq, 1!100100001001100000001011
 h_dm: dm, 1!011111

Index i
 i_cg: cg, 1!0010100000000
 i_ez: ez, 1!01111
 i_se: se, 1!1111000
 i_mag: mag, 1!00

Index j
 j_cg: cg, 1!1111100000000
 j_sa: sa, 1!111
 j_sb: sb, 1!111
 j_gh: gh, 1!11101011
 j_pos: pos, 1!111

Index k
 k_cg: cg, 1!0011000000000
 k_pp: pp, 1!11
 k_mg: mg, 1!000000100010001
 k_ez: ez, 1!11111

Index l
 l_cg: cg, 1!1111000000000
 l_pos: pos, 1!111
 l_ts: ts, 1!111111
 l_gh: gh, 1!10000000

Index s
 s_cg: cg, 1!0000000000000
 s_pp: pp, 1!11
 s_se: se, 1!1001101

Index f
 f_cg: cg, 1!0000000000000

Index m
 m_cg: cg, 1!0010100000000
 m_pp: pp, 1!00

Index w
 w_cg: cg, 1!1111100000000
 w_pp: pp, 1!00
 w_mg: mg, 1!100100010100101

#  (frozen: see the parameters below)
Index t
! t_cg: cg, 1!0

Index n
! n_cg: cg, 1!0

Index g
! g_cg: cg, 1!0

Number rA, 1, 0!11111110
Number rB, 1, 0!10011111
Number rC, 1, 0!00000000
Number rE, 1, 0!11111111
Number rH, 1, 0!10111101
Number rI, 1, 0!11101010
Number rJ, 1, 0!11111110
Number rK, 1, 0!11111111
Number rL, 1, 0!11111110
Number rD, 1, 0!11111111
Number rS1, 1, 0!10000
Number rS2, 1, 0!00000
Number lr, 1, 0!01111
Number mwA, 1, 0!00001000
Number mwB, 1, 0!00000100
Number mwC, 1, 0!10000011
Number mwE, 1, 0!00010100
Number mwH, 1, 0!00100000
Number mwI, 1, 0!00000000
Number mwJ, 1, 0!00001110
Number mwK, 1, 0!00011101
Number mwL, 1, 0!00000010
Number mwD, 1, 0!00011111
Number bw, 1, 0!10000
Number qs, 1, 3!0000001
Number qf, 1, 3!0000000
Number mb, 1, 0!10000000

#  Frozen: what sgn never reads, which live would only take opt.pl's trials.
#  It codes decisions with bit() alone: no mantissa (rT, mwT, mt, index t),
#  no hint and its mixer (lrm, mbm, index n), no signs (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
