#  h264p's sgn family at level -9: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l9/sgn_h.inc and MOD/l9/sgn_p.inc from this file and sgn.inc.
#
#  The sign of a nonzero coefficient. cg is the ctxBlockCat, pos the scan
#  position (class), sa/sb the sign at the same position in the blocks A and
#  B (0 zero, 1 positive, 2 negative, 3 none), scb for Cr DC the sign of Cb
#  at the same position, mag the magnitude (class), md the block's prediction
#  (as the other residual families); for the signs predicted from the samples
#  around the block (luma), pp the predicted sign (1 positive, 2 negative, 0
#  not predicted) and mg how much worse the other sign fits (1 + tc_qlog of
#  quarter samples); ts the sign at the position in the block of the cbf
#  family's tn (1 + sgn3; 4 + where the vector moves it; 0 none); dm for an
#  inter luma block, the sign its residual would have were it a small shift
#  of its prediction (the levels of the prediction's gradients), the shift
#  fitted to the coefficients whose signs are known so far (1 +, 2 -; 2 or 4
#  more as the level that gives reaches a quarter of the coefficient's, or
#  all of it; 0 none).

Prefix H9_sgn
Debug 1
Const 0

Index a
 a_cg: cg, 1!1111111111111
 a_pos: pos, 1!111
 a_sa: sa, 1!111
 a_sb: sb, 1!111
 a_gh: gh, 1!11111111

Index b
 b_cg: cg, 1!1111111111111
 b_scb: scb, 1!111
 b_pos: pos, 1!111

Index c
 c_cg: cg, 1!1111111111111
 c_mag: mag, 1!10
 c_md: md, 1!1100110000010101100

Index d
 d_cg: cg, 1!1111111111111
 d_pp: pp, 1!11
 d_mg: mg, 1!111111111111111

Index e
 e_cg: cg, 1!1011000000000
 e_pp: pp, 1!00
 e_mg: mg, 1!111111111111111
 e_mag: mag, 1!00

Index h
 h_cg: cg, 1!1111111111111
 h_pos: pos, 1!111
 h_ez: ez, 1!11111
 h_pp: pp, 1!11
 h_ts: ts, 1!111111
 h_pq: pq, 1!111111111111111111111111
 h_dm: dm, 1!111111

Index i
 i_cg: cg, 1!1111111111111
 i_ez: ez, 1!11111
 i_se: se, 1!1111111
 i_mag: mag, 1!00

Index j
 j_cg: cg, 1!1111111111111
 j_sa: sa, 1!111
 j_sb: sb, 1!111
 j_gh: gh, 1!11111111
 j_pos: pos, 1!100

Index k
 k_cg: cg, 1!1111111111111
 k_pp: pp, 1!11
 k_mg: mg, 1!111111111111111
 k_ez: ez, 1!11111

Index l
 l_cg: cg, 1!1111111111111
 l_pos: pos, 1!111
 l_ts: ts, 1!011111
 l_gh: gh, 1!11111111

Index s
 s_cg: cg, 1!0100000000000
 s_pp: pp, 1!11
 s_se: se, 1!1111111

Index f
 f_cg: cg, 1!0011100000000

Index m
 m_cg: cg, 1!1111111111111
 m_pp: pp, 1!00

Index w
 w_cg: cg, 1!1111111111111
 w_pp: pp, 1!00
 w_mg: mg, 1!111111111111111

Index t
 t_cg: cg, 1!0

Index n
 n_cg: cg, 1!0

Index g
 g_cg: cg, 1!0

Number rA, 1, 0!11101001
Number rB, 1, 0!11001101
Number rC, 1, 0!00000011
Number rE, 1, 0!01000000
Number rH, 1, 0!01000000
Number rI, 1, 0!01000000
Number rJ, 1, 0!11100000
Number rK, 1, 0!11100000
Number rL, 1, 0!11101011
Number rD, 1, 0!11110110
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00011101
Number mwB, 1, 0!00000101
Number mwC, 1, 0!00000000
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00100000
Number mwI, 1, 0!00000000
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!00000000
Number mwL, 1, 0!00000000
Number mwD, 1, 0!00011111
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01110
Number mt, 1, 0!110
Number qs, 1, 3!0000000
Number qf, 1, 3!1111010
Number mb, 1, 0!10100000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
