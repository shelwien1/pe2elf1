#  h264p's qpd family at level -9: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l9/qpd_h.inc and MOD/l9/qpd_p.inc from this file and family.inc.
#
#  mb_qp_delta. lnz: the previous macroblock had a nonzero delta (CABAC's
#  context); pc the luma bits of the coded_block_pattern, cc its chroma part,
#  cls the class; dc and db the QP of the same macroblock in the previous
#  picture of the type and of macroblock B, relative to the predicted QP
#  (4 equal); lz the last nonzero delta (3 for none); st the slice type; ae
#  the delta adaptive quantization would give, from the energy of the
#  macroblock in the last picture decoded against that of the one that set
#  the predicted QP (7 none); aq the delta the line of QP against energy
#  gives (7 + the delta, 0 none), ac how far the last picture of the kind
#  was from its line where the macroblock's content was; td how much the
#  macroblock changed between the last two pictures decoded (1 + tc_qlog, 0
#  not known), for the macroblock tree's lower QP where pictures stay; sq
#  the slice's QP less the predicted one (7 + that, -6 to 6): an encoder's
#  QPs keep near the slice's; xe the class of the energy the line takes
#  (1 + log2, up to 18; 0 none), for an encoder whose QP is no line of it
#  (flat below an energy, then rising); lq the QP of the picture's last
#  macroblock of the kind (inter, I_NxN, other) and energy class less the
#  predicted one (7 + that, -6 to 6; 0 none): the rate control's QP plus
#  what the class adds; bc B's QP less the predicted one where B is coded
#  and of the same kind (7 + that, -6 to 6; 0 not), cl and kc the same for
#  col and C.  The
#  magnitude has the line's delta as code()'s hint; the sign is the qpg
#  family's.

Prefix H9_qpd
Debug 1
Const 0

Index a
 a_lnz: lnz, 1!0
 a_pc: pc, 1!1100
 a_cc: cc, 1!11
 a_cls: cls, 1!00000100
 a_sq: sq, 1!0101110110101

Index b
 b_dc: dc, 1!00000000
 b_aq: aq, 1!1000000000001
 b_ae: ae, 1!0010011110010
 b_lq: lq, 1!1101110101101

Index c
 c_lz: lz, 1!001110
 c_st: st, 1!010100000
 c_db: db, 1!11011010
 c_bc: bc, 1!1111010010101

Index d
 d_st: st, 1!011010000
 d_aq: aq, 1!0010010110101
 d_ac: ac, 1!1001000100011

Index e
 e_lnz: lnz, 1!0
 e_aq: aq, 1!0100110110100
 e_cls: cls, 1!00001010
 e_sq: sq, 1!0010001000010
 e_xe: xe, 1!111000110000100101

Index h
 h_ae: ae, 1!1100101010001
 h_dc: dc, 1!11110110
 h_pc: pc, 1!1001

Index i
 i_aq: aq, 1!1101001101001
 i_ac: ac, 1!1010010000001
 i_cls: cls, 1!00100110
 i_td: td, 1!1010010001001000

Index j
 j_st: st, 1!011000000
 j_dc: dc, 1!10100110
 j_db: db, 1!10000010
 j_lnz: lnz, 1!0
 j_td: td, 1!0100000000000110
 j_lq: lq, 1!1001111010001

Index k
 k_aq: aq, 1!1010010010010
 k_lnz: lnz, 1!0
 k_pc: pc, 1!1100
 k_kc: kc, 1!1101110110101

Index l
 l_ac: ac, 1!1000010000000
 l_db: db, 1!11100110
 l_st: st, 1!010000000
 l_cl: cl, 1!1011111111111

Index s
 s_lnz: lnz, 1!1
 s_aq: aq, 1!0010010010000

Index f
 f_st: st, 1!011010000

Index m
 m_lnz: lnz, 1!0
 m_aq: aq, 1!0000000000000

Index w
 w_st: st, 1!010010000
 w_aq: aq, 1!0100101100100
 w_ac: ac, 1!1000000001000

Index t
 t_lnz: lnz, 1!0

Index n
 n_lnz: lnz, 1!0

#  (frozen: see the parameters below)
Index g
! g_lz: lz, 1!000000
! g_aq: aq, 1!0000000000000

Number rA, 1, 0!11111111
Number rB, 1, 0!11111111
Number rC, 1, 0!11111100
Number rE, 1, 0!11101010
Number rH, 1, 0!11110110
Number rI, 1, 0!10000010
Number rJ, 1, 0!11111110
Number rK, 1, 0!11011101
Number rL, 1, 0!11110100
Number rD, 1, 0!11111111
Number rT, 1, 0!00100000
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!11000
Number lrm, 1, 0!11111
Number mbm, 1, 0!00010100
Number mwA, 1, 0!00010111
Number mwB, 1, 0!00001100
Number mwC, 1, 0!00001111
Number mwE, 1, 0!00001000
Number mwH, 1, 0!01000000
Number mwI, 1, 0!00100000
Number mwJ, 1, 0!00100010
Number mwK, 1, 0!00110001
Number mwL, 1, 0!00010001
Number mwD, 1, 0!11100000
Number mwT, 1, 0!00000000
Number bw, 1, 0!01010
Number mt, 1, 0!010
Number qs, 1, 3!0000001
Number qf, 1, 3!0110001
Number mb, 1, 0!00001111

#  Frozen: what qpd never reads, which live would only take opt.pl's trials.
#  It codes with code(), without signs: no sign counters (rG, mwG, index g).
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!10000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
