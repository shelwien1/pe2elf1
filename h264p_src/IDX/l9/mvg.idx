#  h264p's mvg family at level -9: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l9/mvg_h.inc and MOD/l9/mvg_p.inc from this file and family.inc.
#
#  The sign of a nonzero mvd component, knowing its magnitude. comp is the
#  component, lst the list; ts the template match's vector less the
#  predicted one: 3 x its sign (sgn3) + how the magnitude compares with its
#  (0 equal, 1 less, 2 more), 9 none; zs the same for the vector that would
#  make the motion zero (minus the predicted one), ds for the mvs
#  family's temporal vector (its pd) less the predicted one (9 none); sa/sb the signs of the mvd of A and B (sgn3), mag the magnitude
#  (tc_qlog), tq how well the template matched (0 none), ox for the second
#  component the sign of the first (sgn3; 3 for the first), ns 3 + how
#  many of the vectors of A, B and C are above the predicted one in the
#  component less how many are below, es which way
#  the mvds of A and B were from their template matches', summed (sgn3; 3
#  none), as as ts for the template search's second best start (mvs's
#  ta).

Prefix H9_mvg
Debug 1
Const 0

Index a
 a_comp: comp, 1!1
 a_ts: ts, 1!001011011
 a_mag: mag, 1!0110001

Index b
 b_zs: zs, 1!00111111
 b_mag: mag, 1!0001101
 b_comp: comp, 1!1

Index c
 c_ts: ts, 1!001011101
 c_zs: zs, 1!00111110
 c_as: as, 1!001111111

Index d
 d_ds: ds, 1!001111111
 d_mag: mag, 1!0001001

Index e
 e_sa: sa, 1!11
 e_sb: sb, 1!11
 e_comp: comp, 1!1
 e_ns: ns, 1!011110

Index h
 h_ts: ts, 1!001111110
 h_tq: tq, 1!011111001011
 h_es: es, 1!111

Index i
 i_ts: ts, 1!001001001
 i_zs: zs, 1!00000000
 i_ds: ds, 1!001001010

Index j
 j_comp: comp, 1!0
 j_lst: lst, 1!1
 j_ox: ox, 1!111
 j_ns: ns, 1!011110

Index k
 k_mag: mag, 1!0100100
 k_ts: ts, 1!001111011
 k_sa: sa, 1!11

Index l
 l_zs: zs, 1!00111111
 l_ds: ds, 1!001011011
 l_sb: sb, 1!00

Index s
 s_ts: ts, 1!000001110
 s_mag: mag, 1!0101010

Index f
 f_comp: comp, 1!1
 f_ts: ts, 1!001111111

Index m
 m_ts: ts, 1!000000000

Index w
 w_zs: zs, 1!00111111
 w_ts: ts, 1!000000000

#  (frozen: see the parameters below)
Index t
! t_comp: comp, 1!0

Index n
! n_comp: comp, 1!0

Index g
! g_comp: comp, 1!0

Number rA, 1, 0!11101101
Number rB, 1, 0!00000000
Number rC, 1, 0!11111110
Number rE, 1, 0!11111111
Number rH, 1, 0!11111111
Number rI, 1, 0!01011000
Number rJ, 1, 0!10000001
Number rK, 1, 0!11111011
Number rL, 1, 0!11111110
Number rD, 1, 0!11111101
Number rS1, 1, 0!00101
Number rS2, 1, 0!00111
Number lr, 1, 0!01100
Number mwA, 1, 0!00001110
Number mwB, 1, 0!01000101
Number mwC, 1, 0!01001101
Number mwE, 1, 0!01000110
Number mwH, 1, 0!00000001
Number mwI, 1, 0!00111011
Number mwJ, 1, 0!00001011
Number mwK, 1, 0!00000111
Number mwL, 1, 0!00011010
Number mwD, 1, 0!00001010
Number bw, 1, 0!01100
Number qs, 1, 3!0000000
Number qf, 1, 3!0011110
Number mb, 1, 0!10000001

#  Frozen: what mvg never reads, which live would only take opt.pl's trials.
#  It codes decisions with bit() alone: no mantissa (rT, mwT, mt, index t),
#  no hint and its mixer (lrm, mbm, index n), no signs (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
