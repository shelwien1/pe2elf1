#  h264p's hdr family at level -9: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l9/hdr_h.inc and MOD/l9/hdr_p.inc from this file and hdr.inc.
#
#  Header syntax elements (SPS, PPS, SEI, slice headers), coded as the
#  difference to the last value of the same element at the same place in
#  its group (up to 15) and row in a run of it (up to 15), in the same kind
#  of slice (frame_num and pic_order_cnt_lsb modulo their range, as they
#  wrap): tag is the element (a
#  dense id), fld the value's place in its group, p1/p2 the last two values,
#  pos how many values in a row the tag has had, p1r the low bits of the last
#  value, sty the slice type of the current slice, pr whether the slice
#  before was a reference (frame_num grows after one; 2 none, 3 not in a
#  slice).

Prefix H9_hdr
Debug 1
Const 0

Index a
 a_tag: tag, &00011111
 a_fld: fld, 1!100
 a_p1: p1, 1!1100110
 a_sty: sty, 1!011010000
 a_pr: pr, 1!100

Index b
 b_tag: tag, &00111101
 b_p1r: p1r, &11111111

Index c
 c_tag: tag, &01110111
 c_fld: fld, 1!101100110000001

Index d
 d_tag: tag, &00100000
 d_p1: p1, 1!110101101011101
 d_p2: p2, 1!1111111

Index e
 e_tag: tag, &01000000
 e_pos: pos, 1!010

Index h
 h_tag: tag, &00110111
 h_sty: sty, 1!011010000

Index i
 i_tag: tag, &01011110

Index j
 j_fld: fld, 1!100
 j_p2: p2, 1!1000101

Index k
 k_tag: tag, &01111111
 k_fld: fld, 1!111011111111111

Index l
 l_tag: tag, &01010101
 l_pos: pos, 1!101

Index s
 s_tag: tag, &01111011

Index f
 f_tag: tag, &01111111

Index m
 m_tag: tag, &00000000

Index w
 w_tag: tag, &00111111

Index t
 t_tag: tag, &00011110

Index n
 n_tag: tag, &00000000

Index g
 g_p1: p1, 1!1111110
 g_pos: pos, 1!000

Number rA, 1, 0!00000000
Number rB, 1, 0!00000000
Number rC, 1, 0!00000000
Number rE, 1, 0!00000000
Number rH, 1, 0!00101011
Number rI, 1, 0!01000010
Number rJ, 1, 0!10001011
Number rK, 1, 0!10110111
Number rL, 1, 0!00000000
Number rD, 1, 0!11111100
Number rT, 1, 0!00000100
Number rG, 1, 0!01000000
Number rS1, 1, 0!00110
Number rS2, 1, 0!01000
Number lr, 1, 0!11111
Number lrm, 1, 0!00000
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000001
Number mwB, 1, 0!00000101
Number mwC, 1, 0!00100000
Number mwE, 1, 0!00000001
Number mwH, 1, 0!00000001
Number mwI, 1, 0!00000001
Number mwJ, 1, 0!00000001
Number mwK, 1, 0!00000000
Number mwL, 1, 0!11101100
Number mwD, 1, 0!00000110
Number mwT, 1, 0!00000010
Number mwG, 1, 0!00000000
Number bw, 1, 0!01100
Number mt, 1, 0!000
Number qs, 1, 3!0010111
Number qf, 1, 3!0010001
Number mb, 1, 0!00100000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
