#  h264p's sig family at level -9: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l9/sig_h.inc and MOD/l9/sig_p.inc from this file and sig.inc.
#
#  The significance map, given the number of nonzero coefficients: whether
#  the coefficient at each scan position is nonzero, until none remain. cg
#  is the block's ctxBlockCat, pos the scan position, rem the nonzero
#  coefficients still to come and zl the zero ones (tc_qlog), tot all
#  nonzero ones (tc_qlog), nc CAVLC's nC (class), fld field scan, q6 QP/6,
#  tz the magnitude at the position in the block of the cbf family's tn (1 +
#  up to 3; 5 + where the vector moves it; 0 none), sn whether it is nonzero
#  in the blocks A and B (3 x A + B: 0 none, 1 zero, 2 not), hv which way
#  the texture of the block's prediction runs (4 + log2 of its differences
#  along rows over those along columns, -3 to 3; 0 flat or none), pf for an
#  inter block the prediction's own level at the position (its transform
#  quantized as a residual would be: 1 + tc_qlog of quarter levels, 0 none).

Prefix H9_sig
Debug 1
Const 0

Index a
 a_cg: cg, 1!1111100000000
 a_pos: pos, 1!111111111111110001111101111111010011011010010101001100001111110
 a_rem: rem, 1!0101101110

Index b
 b_cg: cg, 1!1001100000000
 b_pos: pos, 1!011010001111111111111101110001111100001111111111101110010110110
 b_md: md, 1!1111111111110111100
 b_hb: hb, 1!

Index c
 c_cg: cg, 1!1101100000000
 c_pos: pos, 1!101000000000110011001001110101111100011111101011101110111001100
 c_q6: q6, 1!01111110
 c_pg: pg, 1!0101011101101111
 c_ft: ft, 1!11111111

Index d
 d_cg: cg, 1!0000100000000
 d_rem: rem, 1!0101100101
 d_zl: zl, 1!0101111110
 d_em: em, 1!1000000000100100
 d_hb: hb, 1!

Index e
 e_cg: cg, 1!0000000000000
 e_pos: pos, 1!000000000000000000011010000110100110001111001010011010110111010
 e_ps: ps, 1!1111101
 e_tz: tz, 1!11011000
 e_pq: pq, 1!010000000010100000000010
 e_pr: pr, 1!0011101

Index h
 h_cg: cg, 1!1111100000000
 h_pos: pos, 1!000111111110110010101110010011101101001000011001111001101100100
 h_ps: ps, 1!1000110
 h_rem: rem, 1!0101001011
 h_tz: tz, 1!11111110
 h_h3: h3, 1!10111111111001

Index i
 i_cg: cg, 1!1111100000000
 i_pos: pos, 1!111111111011010011010010111110101000001100001000110100001110110
 i_pr: pr, 1!0001100
 i_ps: ps, 1!0011001
 i_hv: hv, 1!1001110

Index j
 j_cg: cg, 1!0000000000000
 j_pos: pos, 1!000000000000000000000000000000000000000000000000000000000001100
 j_ft: ft, 1!01111101
 j_h3: h3, 1!10000000000000
 j_nc: nc, 1!00000

Index k
 k_cg: cg, 1!1111100000000
 k_pos: pos, 1!111111111111111111111111111111111111011011111110011111001011000
 k_rem: rem, 1!0110110010
 k_h3: h3, 1!01001100101010
 k_sn: sn, 1!00100000
 k_hv: hv, 1!1011101

Index l
 l_cg: cg, 1!1111100000000
 l_pos: pos, 1!000000000000000000000000000010100111100110000110010010100000000
 l_pe: pe, 1!000000000000000
 l_pr: pr, 1!1100100
 l_sn: sn, 1!01111111
 l_pf: pf, 1!11110110101

Index s
 s_cg: cg, 1!0000000000000
 s_pe: pe, 1!000000000000001
 s_pr: pr, 1!1000000

Index f
 f_cg: cg, 1!0000000000000
 f_nc: nc, 1!00000

Index m
 m_cg: cg, 1!1111100000000
 m_pos: pos, 1!101000001
 m_rem: rem, 1!0010010001

Index w
 w_cg: cg, 1!0011000000000
 w_rem: rem, 1!0101001100
 w_zl: zl, 1!0110101101
 w_em: em, 1!0010001000010000

Index t
 t_cg: cg, 1!0

Index n
 n_cg: cg, 1!0

Index g
 g_cg: cg, 1!0

Number rA, 1, 0!11111110
Number rB, 1, 0!01111011
Number rC, 1, 0!11111010
Number rE, 1, 0!11111111
Number rH, 1, 0!11111000
Number rI, 1, 0!11111110
Number rJ, 1, 0!11111101
Number rK, 1, 0!11000100
Number rL, 1, 0!11110011
Number rD, 1, 0!11111111
Number rT, 1, 0!00000000
Number rG, 1, 0!00000000
Number rS1, 1, 0!00010
Number rS2, 1, 0!00000
Number lr, 1, 0!01100
Number lrm, 1, 0!00000
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00011111
Number mwB, 1, 0!10000000
Number mwC, 1, 0!00000100
Number mwE, 1, 0!00000100
Number mwH, 1, 0!00111111
Number mwI, 1, 0!00100001
Number mwJ, 1, 0!01000001
Number mwK, 1, 0!00000111
Number mwL, 1, 0!00100000
Number mwD, 1, 0!01000000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!10000
Number mt, 1, 0!000
Number qs, 1, 3!0000001
Number qf, 1, 3!0000000
Number mb, 1, 0!01011000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!10101
! Number hC, 1, 0!11000
! Number hE, 1, 0!10101
! Number hH, 1, 0!10100
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!10101
! Number hL, 1, 0!10101
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
