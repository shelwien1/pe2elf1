#  h264p's qpg family at level -9: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l9/qpg_h.inc and MOD/l9/qpg_p.inc from this file and family.inc.
#
#  The sign of a nonzero mb_qp_delta, knowing its magnitude. as is the
#  delta adaptive quantization's line asks for: 3 x its sign (sgn3) + how
#  the magnitude compares with its (0 equal, 1 less, 2 more), 9 none; cs
#  the same for the QP of the same macroblock in the previous picture of
#  the type less the predicted one, bs for macroblock B's (9 none); ls the
#  sign of the last nonzero delta (sgn3), rs that of how far the last
#  picture of the kind was from its line where the macroblock's content
#  was (sgn3, 3 none), mag the magnitude (tc_qlog), cls the class of the
#  macroblock, st the slice type and reference status, ss as as for the
#  slice's QP less the predicted one, xe the qpd family's energy class, lq
#  as as for the QP of the last macroblock of the kind and class (qpd's
#  lq), bk for B's where it is of the kind (qpd's bc).

Prefix H9_qpg
Debug 1
Const 0

Index a
 a_as: as, 1!001001000
 a_mag: mag, 1!0100100
 a_ss: ss, 1!001001000
 a_xe: xe, 1!001000010100100011
 a_lq: lq, 1!001001001

Index b
 b_as: as, 1!001101001
 b_ls: ls, 1!00

Index c
 c_as: as, 1!000000000
 c_cs: cs, 1!001111100

Index d
 d_bs: bs, 1!001111111
 d_mag: mag, 1!0101100
 d_bk: bk, 1!000000001

Index e
 e_cs: cs, 1!000001010
 e_rs: rs, 1!001
 e_ss: ss, 1!001111110

Index h
 h_as: as, 1!001110000
 h_rs: rs, 1!111
 h_ls: ls, 1!10

Index i
 i_as: as, 1!000110001
 i_cs: cs, 1!001111110
 i_bs: bs, 1!001111010

Index j
 j_cls: cls, 1!00011110
 j_st: st, 1!011100000
 j_ls: ls, 1!11

Index k
 k_mag: mag, 1!0111010
 k_as: as, 1!001001111
 k_cls: cls, 1!00100110

Index l
 l_cs: cs, 1!001001101
 l_bs: bs, 1!001101100
 l_ls: ls, 1!10

Index s
 s_as: as, 1!000010111
 s_mag: mag, 1!0111100

Index f
 f_as: as, 1!000001111
 f_st: st, 1!010100000

Index m
 m_as: as, 1!000000000

Index w
 w_as: as, 1!001111000
 w_cs: cs, 1!000000001

#  (frozen: see the parameters below)
Index t
! t_st: st, 1!0

Index n
! n_st: st, 1!0

Index g
! g_st: st, 1!0

Number rA, 1, 0!11000110
Number rB, 1, 0!01111011
Number rC, 1, 0!00000111
Number rE, 1, 0!01000001
Number rH, 1, 0!11101011
Number rI, 1, 0!10110101
Number rJ, 1, 0!10000110
Number rK, 1, 0!11110000
Number rL, 1, 0!11101001
Number rD, 1, 0!11110100
Number rS1, 1, 0!00110
Number rS2, 1, 0!01000
Number lr, 1, 0!01111
Number mwA, 1, 0!00000100
Number mwB, 1, 0!00010101
Number mwC, 1, 0!00111100
Number mwE, 1, 0!00001001
Number mwH, 1, 0!00011111
Number mwI, 1, 0!01111111
Number mwJ, 1, 0!01000010
Number mwK, 1, 0!00000010
Number mwL, 1, 0!00101011
Number mwD, 1, 0!00000000
Number bw, 1, 0!01101
Number qs, 1, 3!1000110
Number qf, 1, 3!0100000
Number mb, 1, 0!00111111

#  Frozen: what qpg never reads, which live would only take opt.pl's trials.
#  It codes decisions with bit() alone: no mantissa (rT, mwT, mt, index t),
#  no hint and its mixer (lrm, mbm, index n), no signs (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
