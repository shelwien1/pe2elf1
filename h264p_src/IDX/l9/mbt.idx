#  h264p's mbt family at level -9: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l9/mbt_h.inc and MOD/l9/mbt_p.inc from this file and family.inc.
#
#  mb_type as a binary tree over its value, the node being the position in the
#  tree. st is the slice type and reference status, ca/cb/cc the classes of
#  macroblocks A, B and of the same one in the previous picture of the type
#  (0 none, 1 skip, 2 direct, 3 16x16, 4 16x8/8x16, 5 8x8, 6 I_NxN, 7 I16,
#  8 PCM), nsk the skipped ones of A, B, C and D; for Intra16x16 (from its
#  coded_block_pattern on), im 1 + the mode that does best in the proxy (0
#  none) and ig by how much it beats the next; in B slices, c1 1 + the class
#  of the same macroblock in list 1's first reference (0 none); tx the
#  skip family's.

Prefix H9_mbt
Debug 1
Const 0

Index a
 a_st: st, 1!000010000
 a_ca: ca, 1!10000000
 a_cb: cb, 1!10000110
 a_en: en, 1!01010100100010

Index b
 b_st: st, 1!011000000
 b_cc: cc, 1!01100100
 b_nsk: nsk, 1!0000
 b_td: td, 1!0100000000000001
 b_c1: c1, 1!101110110

Index c
 c_st: st, 1!000000000
 c_ca: ca, 1!10000000
 c_cc: cc, 1!00000000
 c_im: im, 1!0111
 c_ig: ig, 1!010000010001

Index d
 d_st: st, 1!011000000
 d_sm: sm, 1!0000000000000101
 d_tm: tm, 1!0000000010101110

Index e
 e_st: st, 1!010010000
 e_ca: ca, 1!11100110
 e_td: td, 1!0000000010000000
 e_sm: sm, 1!1110110010000100
 e_tx: tx, 1!01000100110011

Index h
 h_st: st, 1!001000000
 h_dh: dh, 1!111111111
 h_tb: tb, 1!0100100010100000
 h_nsk: nsk, 1!0101
 h_bd: bd, 1!1111110100010001

Index i
 i_st: st, 1!011000000
 i_tb: tb, 1!1001000010001010
 i_en: en, 1!11001001010101
 i_ca: ca, 1!00100010

Index j
 j_st: st, 1!000000000
 j_sm: sm, 1!0111111000010000
 j_dh: dh, 1!111111111
 j_cb: cb, 1!11110110

Index k
 k_st: st, 1!000000000
 k_tm: tm, 1!0011110101100000
 k_nsk: nsk, 1!1100
 k_cc: cc, 1!00111110

Index l
 l_st: st, 1!000000000
 l_bd: bd, 1!0100110011100000
 l_ca: ca, 1!11010110
 l_cb: cb, 1!11111110

Index s
 s_st: st, 1!000000000
 s_tb: tb, 1!0000010001000000
 s_dh: dh, 1!111000111

Index f
 f_st: st, 1!000000000
 f_ca: ca, 1!10000110
 f_qc: qc, 1!01110101100011000
 f_im: im, 1!0111

Index m
 m_st: st, 1!011010000
 m_bd: bd, 1!1100110000100000

Index w
 w_st: st, 1!000000000
 w_sm: sm, 1!1111110010100010
 w_tm: tm, 1!0101000100100100

#  (frozen: see the parameters below)
Index t
! t_st: st, 1!0

Index n
! n_st: st, 1!0

Index g
! g_st: st, 1!0

Number rA, 1, 0!11111010
Number rB, 1, 0!00000000
Number rC, 1, 0!11111111
Number rE, 1, 0!11111110
Number rH, 1, 0!11000100
Number rI, 1, 0!11111101
Number rJ, 1, 0!11111100
Number rK, 1, 0!01100111
Number rL, 1, 0!11110001
Number rD, 1, 0!10001101
Number rS1, 1, 0!01000
Number rS2, 1, 0!00011
Number lr, 1, 0!01111
Number mwA, 1, 0!00010000
Number mwB, 1, 0!00011101
Number mwC, 1, 0!00010000
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00000001
Number mwI, 1, 0!00000011
Number mwJ, 1, 0!00001011
Number mwK, 1, 0!00001010
Number mwL, 1, 0!01000000
Number mwD, 1, 0!00010001
Number bw, 1, 0!01101
Number qs, 1, 3!0011000
Number qf, 1, 3!0010110
Number mb, 1, 0!00011011

#  Frozen: what mbt never reads, which live would only take opt.pl's trials.
#  It codes decisions with bit() alone: no mantissa (rT, mwT, mt, index t),
#  no hint and its mixer (lrm, mbm, index n), no signs (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!01111
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
