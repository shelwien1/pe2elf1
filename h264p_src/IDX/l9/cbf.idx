#  h264p's cbf family at level -9: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l9/cbf_h.inc and MOD/l9/cbf_p.inc from this file and cbf.inc.
#
#  The number of nonzero coefficients of a block, 0 for none (kn 0), or
#  less 1 where the block is known to have one (kn 1: CABAC 8x8 blocks
#  without coded_block_flag). cat is the block's ctxBlockCat; na/nb the
#  nonzero coefficients of the blocks A and B (9 for none), intra the
#  macroblock is intra, q6 QP/6, np the nonzero blocks so far in its 8x8
#  block (for chroma: in the macroblock), pos the block's place in its 8x8
#  block, crcb for a Cr block the Cb block (0 none, 1 zero, 2 not), col the
#  same block in the previous picture of the type (2 none), nc CAVLC's nC
#  (class), tn for a luma block of a P picture the nonzero coefficients of
#  the block its vector points at in its reference, where that is the
#  last picture of a kind (1 + up to 4; 6 + where the vector moves it; 0
#  none); ds for an inter luma 4x4 block of a P or B slice, 1 + the score
#  of x264's decimation its 8x8 block still owes after the blocks before it
#  (4, or 6 for the macroblock's only coded 8x8 block, less theirs; 0 not
#  applicable); hv as the sig family's; ly for a 4:2:0 chroma block the
#  coefficients of the luma under it (its 8x8 block; for DC the
#  macroblock's), 1 + tc_qlog (0 luma); dq for a 4:2:0 chroma AC block
#  its DC, from the chroma DC levels' 2x2 transform, for an Intra16x16
#  luma AC block from the luma DC levels' 4x4 one (1 + tc_qlog, 0 not such
#  a block).

Prefix H9_cbf
Debug 1
Const 0

Index a
 a_cat: cat, 1!1111100000000
 a_na: na, 1!110100010
 a_nb: nb, 1!110100010
 a_intra: intra, 1!1
 a_ly: ly, 1!0101111010

Index b
 b_cat: cat, 1!0110000000000
 b_np: np, 1!111
 b_pos: pos, 1!111
 b_crcb: crcb, 1!11
 b_kn: kn, 1!1
 b_em: em, 1!1010001100100100
 b_dq: dq, 1!10101010

Index c
 c_cat: cat, 1!1101000000000
 c_q6: q6, 1!00111000
 c_col: col, 1!11
 c_kn: kn, 1!0
 c_en: en, 1!10100000001010
 c_ch: ch, 1!111110000011000

Index d
 d_cat: cat, 1!1111100000000
 d_nc: nc, 1!00101
 d_md: md, 1!0111101000010101100
 d_kn: kn, 1!0
 d_pg: pg, 1!0100100100101010

Index e
 e_cat: cat, 1!1011000000000
 e_pz: pz, 1!0000100100000000
 e_na: na, 1!000000000
 e_nb: nb, 1!000000000
 e_tn: tn, 1!1001110001

Index h
 h_cat: cat, 1!1011100000000
 h_pg: pg, 1!0010011010010001
 h_md: md, 1!1100000100100100101
 h_q6: q6, 1!11111100
 h_hv: hv, 1!1110010

Index i
 i_cat: cat, 1!1111100000000
 i_pz: pz, 1!0111010001010000
 i_pq: pq, 1!110010000101100000001010
 i_np: np, 1!100
 i_ds: ds, 1!1111100

Index j
 j_cat: cat, 1!1011000000000
 j_em: em, 1!1100100011010001
 j_pg: pg, 1!0001001101000100
 j_na: na, 1!000000101

Index k
 k_cat: cat, 1!0000000000000
 k_na: na, 1!000000001
 k_nb: nb, 1!000000000
 k_pz: pz, 1!1111001000100000

Index l
 l_cat: cat, 1!1011100000000
 l_col: col, 1!01
 l_np: np, 1!000
 l_md: md, 1!0000000010000010000

Index s
 s_cat: cat, 1!1011000000000
 s_kn: kn, 1!1
 s_pq: pq, 1!000100000000101000000001

Index f
 f_cat: cat, 1!0000000000000
 f_intra: intra, 1!0

Index m
 m_cat: cat, 1!0000000000000
 m_kn: kn, 1!0

Index w
 w_cat: cat, 1!1000100000000
 w_nc: nc, 1!11011
 w_md: md, 1!1000000010001000110
 w_kn: kn, 1!0

Index t
 t_cat: cat, 1!1011100000000

Index n
 n_cat: cat, 1!1111100000000

Index g
 g_cat: cat, 1!0

Number rA, 1, 0!11111111
Number rB, 1, 0!11111100
Number rC, 1, 0!11111111
Number rE, 1, 0!00000000
Number rH, 1, 0!11111111
Number rI, 1, 0!11111110
Number rJ, 1, 0!11111011
Number rK, 1, 0!11111100
Number rL, 1, 0!11111110
Number rD, 1, 0!11111101
Number rT, 1, 0!00100000
Number rG, 1, 0!00000000
Number rS1, 1, 0!00111
Number rS2, 1, 0!00000
Number lr, 1, 0!01100
Number lrm, 1, 0!11111
Number mbm, 1, 0!00010100
Number mwA, 1, 0!00101010
Number mwB, 1, 0!00000010
Number mwC, 1, 0!00001000
Number mwE, 1, 0!01100000
Number mwH, 1, 0!00000100
Number mwI, 1, 0!00001100
Number mwJ, 1, 0!10000000
Number mwK, 1, 0!01000001
Number mwL, 1, 0!01000000
Number mwD, 1, 0!01000000
Number mwT, 1, 0!00000111
Number mwG, 1, 0!00000000
Number bw, 1, 0!10000
Number mt, 1, 0!010
Number qs, 1, 3!0000000
Number qf, 1, 3!0000000
Number mb, 1, 0!10000010

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!10001
! Number hC, 1, 0!11000
! Number hE, 1, 0!10000
! Number hH, 1, 0!10000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
