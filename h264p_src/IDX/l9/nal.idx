#  h264p's nal family at level -9: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l9/nal_h.inc and MOD/l9/nal_p.inc from this file and family.inc.
#
#  NAL unit fields: the field id (fld) is a dense factor and the rest is the
#  field's own recent history (p1, p2) and a context the coder gives (ctx).

Prefix H9_nal
Debug 1
Const 0

Index a
 a_fld: fld, 1!01110000000001010
 a_ctx: ctx, 1!001000001000000
 a_p1: p1, 1!000011000000000

Index b
 b_fld: fld, 1!00010101100000010
 b_p1: p1, 1!100001
 b_p2: p2, 1!111

Index c
 c_fld: fld, 1!11110011100010010
 c_ctx: ctx, 1!0100001010000000000000000000000

Index d
 d_fld: fld, 1!01110111000000010

Index e
 e_fld: fld, 1!01000010101000010
 e_p2: p2, 1!100

Index h
 h_fld: fld, 1!11100001000000010
 h_ctx: ctx, 1!0100010000000000000000000000000

Index i
 i_ctx: ctx, 1!1100001110000000000000000000000
 i_p1: p1, 1!110110000000000

Index j
 j_fld: fld, 1!00100001100000010
 j_p2: p2, 1!011
 j_p1: p1, 1!011011000000000

Index k
 k_fld: fld, 1!11111001000000010
 k_ctx: ctx, 1!0100010010000000000000000000000

Index l
 l_p1: p1, 1!011111000000000
 l_p2: p2, 1!011

Index s
 s_fld: fld, 1!01110000000000010

Index f
 f_fld: fld, 1!11110011000000010

Index m
 m_fld: fld, 1!01000001100101010

Index w
 w_fld: fld, 1!01110001000101010

Index t
 t_fld: fld, 1!00000000000000000

#  (frozen: see the parameters below)
Index n
! n_fld: fld, 1!00000000000000000

Index g
! g_fld: fld, 1!00000000000000000
! g_ctx: ctx, 1!000

Number rA, 1, 0!00000000
Number rB, 1, 0!11100000
Number rC, 1, 0!01101100
Number rE, 1, 0!11111100
Number rH, 1, 0!00000000
Number rI, 1, 0!10000010
Number rJ, 1, 0!00000000
Number rK, 1, 0!00100110
Number rL, 1, 0!00100111
Number rD, 1, 0!01000100
Number rT, 1, 0!11111100
Number rS1, 1, 0!01000
Number rS2, 1, 0!10000
Number lr, 1, 0!11111
Number mwA, 1, 0!00010111
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000001
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00000000
Number mwI, 1, 0!10000100
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!00000010
Number mwL, 1, 0!00101001
Number mwD, 1, 0!00010100
Number mwT, 1, 0!00000000
Number bw, 1, 0!00011
Number mt, 1, 0!010
Number qs, 1, 3!1110110
Number qf, 1, 3!0010000
Number mb, 1, 0!00011110

#  Frozen: what nal never reads, which live would only take opt.pl's trials.
#  It codes with code(), without a hint or signs: no hint's mixer (lrm, mbm,
#  index n), no signs (rG, mwG, index g).
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
