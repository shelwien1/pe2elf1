#  h264p's cbp family at level -9: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l9/cbp_h.inc and MOD/l9/cbp_p.inc from this file and family.inc.
#
#  coded_block_pattern, one decision at a time: the luma bits of the four 8x8
#  blocks (nodes 0-3), chroma not 0 (4), chroma 2 (5), and
#  transform_size_8x8_flag (6). inc is CABAC's ctxIdxInc of the decision, pc
#  the luma bits set so far, cls the class of the macroblock, col the
#  decision's value in the same macroblock of the previous picture of the
#  type (1 + the value, 0 none; for a luma block of an inter macroblock of
#  a P picture whose reference is the last picture of a kind, 3 + the 4x4
#  blocks with coefficients under where its vector puts it there, 8 +
#  where the vector moves it), q6 QP/6, st the slice type.

Prefix H9_cbp
Debug 1
Const 0

Index a
 a_inc: inc, 1!101
 a_pc: pc, 1!1101
 a_cls: cls, 1!00111100
 a_st: st, 1!011100000

Index b
 b_inc: inc, 1!000
 b_col: col, 1!110100011010
 b_q6: q6, 1!10101110
 b_pq: pq, 1!010100

Index c
 c_cls: cls, 1!00110100
 c_col: col, 1!011100100000
 c_pc: pc, 1!1010
 c_pg: pg, 1!0001010010011011

Index d
 d_inc: inc, 1!000
 d_em: em, 1!0100101011110011
 d_cls: cls, 1!00100000

Index e
 e_inc: inc, 1!001
 e_pg: pg, 1!1000100001001001
 e_cls: cls, 1!00000000
 e_tp: tp, 1!0110000010001000

Index h
 h_inc: inc, 1!000
 h_td: td, 1!1001000001000001
 h_en: en, 1!01010010010110
 h_q6: q6, 1!11110010

Index i
 i_inc: inc, 1!000
 i_pq: pq, 1!111001
 i_cls: cls, 1!00000100
 i_q6: q6, 1!10010000

Index j
 j_inc: inc, 1!000
 j_tp: tp, 1!1100010100110000
 j_em: em, 1!1110010101001000
 j_st: st, 1!011010000

Index k
 k_inc: inc, 1!000
 k_pg: pg, 1!0000001001100100
 k_col: col, 1!011000011100
 k_cls: cls, 1!00100100

Index l
 l_inc: inc, 1!111
 l_pc: pc, 1!1101
 l_en: en, 1!00011000001001
 l_q6: q6, 1!00011100

Index s
 s_inc: inc, 1!001
 s_tp: tp, 1!1101001001000100
 s_pq: pq, 1!011010

Index f
 f_cls: cls, 1!00100100

Index m
 m_inc: inc, 1!000

Index w
 w_inc: inc, 1!111
 w_em: em, 1!1101010010100000
 w_cls: cls, 1!00100100

#  (frozen: see the parameters below)
Index t
! t_st: st, 1!0

Index n
! n_st: st, 1!0

Index g
! g_st: st, 1!0

Number rA, 1, 0!11111110
Number rB, 1, 0!11111101
Number rC, 1, 0!11111101
Number rE, 1, 0!11111111
Number rH, 1, 0!11111101
Number rI, 1, 0!11110001
Number rJ, 1, 0!11111110
Number rK, 1, 0!11111000
Number rL, 1, 0!11011110
Number rD, 1, 0!11111110
Number rS1, 1, 0!01000
Number rS2, 1, 0!00000
Number lr, 1, 0!01111
Number mwA, 1, 0!00000010
Number mwB, 1, 0!00001000
Number mwC, 1, 0!00000010
Number mwE, 1, 0!00010011
Number mwH, 1, 0!00010000
Number mwI, 1, 0!01000000
Number mwJ, 1, 0!00000100
Number mwK, 1, 0!00001011
Number mwL, 1, 0!00100000
Number mwD, 1, 0!00111001
Number bw, 1, 0!01111
Number qs, 1, 3!0110100
Number qf, 1, 3!0001010
Number mb, 1, 0!00010001

#  Frozen: what cbp never reads, which live would only take opt.pl's trials.
#  It codes decisions with bit() alone: no mantissa (rT, mwT, mt, index t),
#  no hint and its mixer (lrm, mbm, index n), no signs (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
