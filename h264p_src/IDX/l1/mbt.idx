#  h264p's mbt family at level -1: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l1/mbt_h.inc and MOD/l1/mbt_p.inc from this file and family.inc.
#
#  mb_type as a binary tree over its value, the node being the position in the
#  tree. st is the slice type and reference status, ca/cb/cc the classes of
#  macroblocks A, B and of the same one in the previous picture of the type
#  (0 none, 1 skip, 2 direct, 3 16x16, 4 16x8/8x16, 5 8x8, 6 I_NxN, 7 I16,
#  8 PCM), nsk the skipped ones of A, B, C and D; for Intra16x16 (from its
#  coded_block_pattern on), im 1 + the mode that does best in the proxy (0
#  none) and ig by how much it beats the next; in B slices, c1 1 + the class
#  of the same macroblock in list 1's first reference (0 none); tx the
#  skip family's.

Prefix H1_mbt
Debug 1
Const 0

Index a
 a_st: st, 1!010010000
 a_ca: ca, 1!11110110
 a_cb: cb, 1!11110110

Index b
 b_st: st, 1!011100000
 b_cc: cc, 1!01110110
 b_nsk: nsk, 1!0001

Index c
 c_st: st, 1!000000000
 c_ca: ca, 1!10000000
 c_cb: cb, 1!10000100

Index d
 d_st: st, 1!011000000

Index m
 m_st: st, 1!000000000

#  (frozen: see the parameters below)
Index t
! t_st: st, 1!0

Index n
! n_st: st, 1!0

Index g
! g_st: st, 1!0

Number rA, 1, 0!11111110
Number rB, 1, 0!11110110
Number rC, 1, 0!00000000
Number rD, 1, 0!11111011
Number lr, 1, 0!01100
Number mwA, 1, 0!00000101
Number mwB, 1, 0!00001111
Number mwC, 1, 0!00110011
Number mwD, 1, 0!00000000
Number mb, 1, 0!00100111

#  Frozen: what mbt never reads, which live would only take opt.pl's trials.
#  It codes decisions with bit() alone: no mantissa (rT, mwT, mt, index t),
#  no hint and its mixer (lrm, mbm, index n), no signs (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
