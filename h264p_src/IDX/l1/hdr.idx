#  h264p's hdr family at level -1: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l1/hdr_h.inc and MOD/l1/hdr_p.inc from this file and family.inc.
#
#  Header syntax elements (SPS, PPS, SEI, slice headers), coded as the
#  difference to the last value of the same element at the same place in
#  its group (up to 15) and row in a run of it (up to 15), in the same kind
#  of slice (frame_num and pic_order_cnt_lsb modulo their range, as they
#  wrap): tag is the element (a
#  dense id), fld the value's place in its group, p1/p2 the last two values,
#  pos how many values in a row the tag has had, p1r the low bits of the last
#  value, sty the slice type of the current slice, pr whether the slice
#  before was a reference (frame_num grows after one; 2 none, 3 not in a
#  slice).

Prefix H1_hdr
Debug 1
Const 0

Index a
 a_tag: tag, &01011111
 a_fld: fld, 1!111
 a_p1: p1, 1!1100110
 a_sty: sty, 1!011100000
 a_pr: pr, 1!110

Index b
 b_tag: tag, &01100111
 b_p1r: p1r, &11111110

Index c
 c_tag: tag, &00011111
 c_fld: fld, 1!111111110000001

Index d
 d_tag: tag, &01111111
 d_p1: p1, 1!111110110010000
 d_p2: p2, 1!1111111

Index m
 m_tag: tag, &00000000

Index t
 t_tag: tag, &00011110

#  (frozen: see the parameters below)
Index n
! n_tag: tag, &00000000

Index g
 g_p1: p1, 1!1111110
 g_pos: pos, 1!000

Number rA, 1, 0!11000101
Number rB, 1, 0!00000000
Number rC, 1, 0!00000000
Number rD, 1, 0!11101100
Number rT, 1, 0!00000100
Number rG, 1, 0!01000000
Number lr, 1, 0!11111
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000111
Number mwC, 1, 0!00000100
Number mwD, 1, 0!00000100
Number mwT, 1, 0!00001000
Number mwG, 1, 0!00000000
Number mt, 1, 0!000
Number mb, 1, 0!01100100

#  Frozen: what hdr never reads, which live would only take opt.pl's trials.
#  It codes with codes(), without a hint: no hint's mixer (lrm, mbm, index
#  n).
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
