#  h264p's qpd family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/qpd_h.inc and
#  MOD/qpd_p.inc from this file and qpd.inc.
#
#  mb_qp_delta. lnz: the previous macroblock had a nonzero delta (CABAC's
#  context); pc the luma bits of the coded_block_pattern, cc its chroma part,
#  cls the class; dc and db the QP of the same macroblock in the previous
#  picture of the type and of macroblock B, relative to the predicted QP
#  (4 equal); lz the last nonzero delta (3 for none); st the slice type; ae
#  the delta adaptive quantization would give, from the energy of the
#  macroblock in the last picture decoded against that of the one that set
#  the predicted QP (7 none).

Prefix H_qpd
Debug 1
Const 0

Index a
 a_lnz: lnz, 1!1
 a_pc: pc, 1!1111
 a_cc: cc, 1!11
 a_cls: cls, 1!11111111

Index b
 b_lnz: lnz, 1!0
 b_dc: dc, 1!11111111
 b_ae: ae, 1!1111111111111

Index c
 c_lz: lz, 1!111111
 c_st: st, 1!111111111
 c_db: db, 1!11111111

Index d
 d_lnz: lnz, 1!1
 d_ae: ae, 1!1111111111111

Index e
 e_lnz: lnz, 1!1
 e_ae: ae, 1!1111111111111
 e_cls: cls, 1!11111111

Index h
 h_ae: ae, 1!1111111111111
 h_dc: dc, 1!11111111
 h_pc: pc, 1!1111

Index s
 s_lnz: lnz, 1!1
 s_ae: ae, 1!1111111111111

Index f
 f_st: st, 1!111111111

Index m
 m_lnz: lnz, 1!1
 m_ae: ae, 1!1111111111111

Index t
 t_lnz: lnz, 1!0

Index n
 n_lnz: lnz, 1!0

Index g
 g_lz: lz, 1!111111

Number rA, 1, 0!01000000
Number rB, 1, 0!00010000
Number rC, 1, 0!01000000
Number rE, 1, 0!01000000
Number rH, 1, 0!01000000
Number rD, 1, 0!11111111
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000000
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00000000
Number mwD, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01000
Number qs, 1, 3!0010000
Number qf, 1, 3!0111000
Number mb, 1, 0!00000101

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
