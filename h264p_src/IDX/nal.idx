#  h264p's nal family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/nal_h.inc and
#  MOD/nal_p.inc from this file and nal.inc.
#
#  NAL unit fields: the field id (fld) is a dense factor and the rest is the
#  field's own recent history (p1, p2) and a context the coder gives (ctx).

Prefix H_nal
Debug 1
Const 0

Index a
 a_fld: fld, 1!0111000000000001000000000000000
 a_ctx: ctx, 1!111111111111111
 a_p1: p1, 1!000000000000000

Index b
 b_fld: fld, 1!1111111111111111111111111111111
 b_p1: p1, 1!111111
 b_p2: p2, 1!111

Index c
 c_fld: fld, 1!1111111111111111111111111111111
 c_ctx: ctx, 1!0000001010000000000000000000000

Index d
 d_fld: fld, 1!1111111111111111111111111111111

Index e
 e_fld: fld, 1!1111000000000001000000000000000
 e_p2: p2, 1!111

Index h
 h_fld: fld, 1!1111000000000001000000000000000
 h_ctx: ctx, 1!0100000010000000000000000000000

Index i
 i_ctx: ctx, 1!1111111111111111111111111111111
 i_p1: p1, 1!111111111111111

Index j
 j_fld: fld, 1!1111111111111111111111111111111
 j_p2: p2, 1!111
 j_p1: p1, 1!111111111111111

Index k
 k_fld: fld, 1!1111111111111111111111111111111
 k_ctx: ctx, 1!1111111111111111111111111111111

Index l
 l_p1: p1, 1!111111111111111
 l_p2: p2, 1!111

Index s
 s_fld: fld, 1!1011000001000001000000000000000

Index f
 f_fld: fld, 1!1111111111111111111111111111111

Index m
 m_fld: fld, 1!0001001001000000000000000000000

Index w
 w_fld: fld, 1!1111111111111111111111111111111

Index t
 t_fld: fld, 1!1111111111111111111111111111111

Index n
 n_fld: fld, 1!1111111111111111111111111111111

Index g
 g_fld: fld, 1!1111111111111111111111111111111
 g_ctx: ctx, 1!111

Number rA, 1, 0!11000000
Number rB, 1, 0!00000000
Number rC, 1, 0!01000000
Number rE, 1, 0!01000000
Number rH, 1, 0!01000000
Number rI, 1, 0!01000000
Number rJ, 1, 0!01000000
Number rK, 1, 0!01000000
Number rL, 1, 0!01000000
Number rD, 1, 0!01100000
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00100
Number lr, 1, 0!11110
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!10000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000000
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00000000
Number mwI, 1, 0!00000000
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!00000000
Number mwL, 1, 0!00000000
Number mwD, 1, 0!00000100
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01000
Number qs, 1, 3!0011000
Number qf, 1, 3!0010000
Number mb, 1, 0!00000101

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
