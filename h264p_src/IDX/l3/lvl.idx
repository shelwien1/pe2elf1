#  h264p's lvl family at level -3: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l3/lvl_h.inc and MOD/l3/lvl_p.inc from this file and family.inc.
#
#  coeff_abs_level_minus1, in reverse scan order as CABAC codes it. cg is the
#  ctxBlockCat, g1/e1 the levels coded so far above 1 and equal to 1, nc the
#  block's nC (class), pos the scan position (class), sa/sb the magnitude at
#  the same position in the blocks A and B (class, 0 zero or none), q6 QP/6,
#  tot the nonzero coefficients of the block (class), tz as the sig
#  family's, hv as the sig family's and fq whether the position is a
#  horizontal (1) or vertical (2) frequency, or both (3), or DC (0).

Prefix H3_lvl
Debug 1
Const 0

Index a
 a_cg: cg, 1!1111000000000
 a_g1: g1, 1!0000
 a_e1: e1, 1!0110
 a_nc: nc, 1!11110

Index b
 b_cg: cg, 1!1111100000000
 b_pos: pos, 1!01101
 b_tot: tot, 1!0111111
 b_fq: fq, 1!111

Index c
 c_cg: cg, 1!1011100000000
 c_sa: sa, 1!111
 c_sb: sb, 1!111
 c_q6: q6, 1!11111100
 c_lh: lh, 1!1111111111111111111111111111111111111101111111111111111011111111

Index d
 d_cg: cg, 1!0000000000000
 d_g1: g1, 1!0000
 d_md: md, 1!0110000100010101101
 d_lt: lt, 1!0111101

Index e
 e_cg: cg, 1!1100000000000
 e_g1: g1, 1!1010
 e_e1: e1, 1!1000

Index h
 h_cg: cg, 1!0000000000000
 h_pos: pos, 1!10001

Index i
 i_cg: cg, 1!0011000000000
 i_g1: g1, 1!0101

Index j
 j_cg: cg, 1!1101100000000
 j_lt: lt, 1!1111111
 j_lh: lh, 1!1111111111111111111111111111111111101111111111011111111111011111
 j_pos: pos, 1!11111

Index k
 k_cg: cg, 1!1111100000000
 k_pos: pos, 1!11111
 k_g1: g1, 1!1111

Index l
 l_cg: cg, 1!1000000000000
 l_sa: sa, 1!111
 l_sb: sb, 1!111
 l_lh: lh, 1!0000000000001000100000000111000000000010001100000000000000000000

Index s
 s_cg: cg, 1!1010000000000
 s_g1: g1, 1!0000
 s_pm: pm, 1!1010

Index m
 m_cg: cg, 1!0000000000000
 m_g1: g1, 1!1

Index w
 w_cg: cg, 1!1011100000000
 w_g1: g1, 1!1001
 w_md: md, 1!1111111101000101111

Index t
 t_cg: cg, 1!0000000000000

Index n
 n_cg: cg, 1!0000000000000

#  (frozen: see the parameters below)
Index g
! g_cg: cg, 1!0

Number rA, 1, 0!11111101
Number rB, 1, 0!11111111
Number rC, 1, 0!11111111
Number rE, 1, 0!01100001
Number rH, 1, 0!11111010
Number rI, 1, 0!01001001
Number rJ, 1, 0!11111110
Number rK, 1, 0!11111010
Number rL, 1, 0!11111111
Number rD, 1, 0!11111110
Number rT, 1, 0!10000000
Number lr, 1, 0!01101
Number lrm, 1, 0!00000
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00111111
Number mwB, 1, 0!00000100
Number mwC, 1, 0!00000100
Number mwE, 1, 0!10000100
Number mwH, 1, 0!00001110
Number mwI, 1, 0!01000000
Number mwJ, 1, 0!00001010
Number mwK, 1, 0!01001010
Number mwL, 1, 0!00101101
Number mwD, 1, 0!00100000
Number mwT, 1, 0!00101111
Number mt, 1, 0!000
Number mb, 1, 0!00011111

#  Frozen: what lvl never reads, which live would only take opt.pl's trials.
#  It codes with code(), without signs: no sign counters (rG, mwG, index g).
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!10000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
