#  h264p's sig family at level -3: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l3/sig_h.inc and MOD/l3/sig_p.inc from this file and family.inc.
#
#  The significance map, given the number of nonzero coefficients: whether
#  the coefficient at each scan position is nonzero, until none remain. cg
#  is the block's ctxBlockCat, pos the scan position, rem the nonzero
#  coefficients still to come and zl the zero ones (tc_qlog), tot all
#  nonzero ones (tc_qlog), nc CAVLC's nC (class), fld field scan, q6 QP/6,
#  tz the magnitude at the position in the block of the cbf family's tn (1 +
#  up to 3; 5 + where the vector moves it; 0 none), sn whether it is nonzero
#  in the blocks A and B (3 x A + B: 0 none, 1 zero, 2 not), hv which way
#  the texture of the block's prediction runs (4 + log2 of its differences
#  along rows over those along columns, -3 to 3; 0 flat or none), pf for an
#  inter block the prediction's own level at the position (its transform
#  quantized as a residual would be: 1 + tc_qlog of quarter levels, 0 none).

Prefix H3_sig
Debug 1
Const 0

Index a
 a_cg: cg, 1!1011100000000
 a_pos: pos, 1!010011111111110111111111111111011111011101010110011100101111110
 a_rem: rem, 1!0101101110

Index b
 b_cg: cg, 1!1011100000000
 b_pos: pos, 1!001011011111111111111111111001111111011100011111101111101010110
 b_md: md, 1!1111111111110111110
 b_hb: hb, 1!

Index c
 c_cg: cg, 1!1000100000000
 c_pos: pos, 1!100000000000010011000001110001111000001110001010010010111001010
 c_q6: q6, 1!01111110
 c_ft: ft, 1!11101101

Index d
 d_cg: cg, 1!1110100000000
 d_rem: rem, 1!0111010010
 d_zl: zl, 1!0111111100
 d_hb: hb, 1!

Index e
 e_cg: cg, 1!0000000000000
 e_pos: pos, 1!100000000000000011110100000100000001000000000001000001100000110

Index h
 h_cg: cg, 1!1101100000000
 h_pos: pos, 1!000110011111110010110010011111011100110111101010111011001011100
 h_rem: rem, 1!0010010011
 h_h3: h3, 1!10100010000000

Index i
 i_cg: cg, 1!1111100000000
 i_pos: pos, 1!011011111111110101001100000110111010011101001011000000001111110

Index j
 j_cg: cg, 1!0000000000000
 j_pos: pos, 1!000000000000000000001011000100101100101010001110001110101111100
 j_ft: ft, 1!00111101
 j_h3: h3, 1!10000000000000
 j_nc: nc, 1!00000

Index k
 k_cg: cg, 1!1111100000000
 k_pos: pos, 1!001111111111110110010110001011111011011011111011110000110000100
 k_rem: rem, 1!0111111000
 k_h3: h3, 1!11111101101111
 k_sn: sn, 1!01011111

Index l
 l_cg: cg, 1!1110100000000
 l_pos: pos, 1!001111111111111111111011101111110111101111010101010101111111010
 l_sn: sn, 1!00011111

Index s
 s_cg: cg, 1!0100000000000

Index m
 m_cg: cg, 1!1111100000000
 m_pos: pos, 1!111111101
 m_rem: rem, 1!0110010010

Index w
 w_cg: cg, 1!0000100000000
 w_rem: rem, 1!0100100101
 w_zl: zl, 1!0101001101

#  (frozen: see the parameters below)
Index t
! t_cg: cg, 1!0

Index n
! n_cg: cg, 1!0

Index g
! g_cg: cg, 1!0

Number rA, 1, 0!11100000
Number rB, 1, 0!11111101
Number rC, 1, 0!11111110
Number rE, 1, 0!10011101
Number rH, 1, 0!00000000
Number rI, 1, 0!01111011
Number rJ, 1, 0!11111111
Number rK, 1, 0!11111101
Number rL, 1, 0!11111101
Number rD, 1, 0!11111110
Number lr, 1, 0!01010
Number mwA, 1, 0!00111111
Number mwB, 1, 0!00001001
Number mwC, 1, 0!01000011
Number mwE, 1, 0!01010000
Number mwH, 1, 0!01111111
Number mwI, 1, 0!01011111
Number mwJ, 1, 0!01001100
Number mwK, 1, 0!00010110
Number mwL, 1, 0!01100000
Number mwD, 1, 0!01000000
Number mb, 1, 0!01111010

#  Frozen: what sig never reads, which live would only take opt.pl's trials.
#  It codes decisions with bit() alone: no mantissa (rT, mwT, mt, index t),
#  no hint and its mixer (lrm, mbm, index n), no signs (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!10101
! Number hC, 1, 0!11000
! Number hE, 1, 0!10101
! Number hH, 1, 0!10100
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!10101
! Number hL, 1, 0!10101
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
