#  h264p's pcm family at level -3: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l3/pcm_h.inc and MOD/l3/pcm_p.inc from this file and family.inc.
#
#  I_PCM samples, as the difference to the sample to the left (above, in the
#  first column). pl is the plane, dp the bit depth above 8, pd/pd2 the last
#  two differences (class).

Prefix H3_pcm
Debug 1
Const 0

Index a
 a_pl: pl, 1!11
 a_dp: dp, 1!111111
 a_pd: pd, 1!111111111111111

Index b
 b_pl: pl, 1!11
 b_pd: pd, 1!1111111
 b_pd2: pd2, 1!1111111

Index c
 c_pl: pl, 1!11

Index d
 d_dp: dp, 1!111111

Index e
 e_pl: pl, 1!11
 e_pd: pd, 1!111111111111111
 e_pd2: pd2, 1!1111111

Index h
 h_pl: pl, 1!11
 h_dp: dp, 1!111111

Index i
 i_pl: pl, 1!11
 i_pd: pd, 1!111111111111111

Index j
 j_pl: pl, 1!11
 j_dp: dp, 1!111111
 j_pd2: pd2, 1!1111111

Index k
 k_pl: pl, 1!11
 k_pd2: pd2, 1!1111111

Index l
 l_pl: pl, 1!11
 l_pd: pd, 1!111111111111111
 l_dp: dp, 1!111111

Index s
 s_pl: pl, 1!11

Index m
 m_pl: pl, 1!11

Index w
 w_dp: dp, 1!111111

Index t
 t_pl: pl, 1!11
 t_dp: dp, 1!111111

#  (frozen: see the parameters below)
Index n
! n_pl: pl, 1!11

Index g
 g_pl: pl, 1!11
 g_pd: pd, 1!111

Number rA, 1, 0!01000000
Number rB, 1, 0!00010000
Number rC, 1, 0!01000000
Number rE, 1, 0!01000000
Number rH, 1, 0!01000000
Number rI, 1, 0!01000000
Number rJ, 1, 0!01000000
Number rK, 1, 0!01000000
Number rL, 1, 0!01000000
Number rD, 1, 0!11111111
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number lr, 1, 0!01100
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000000
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00000000
Number mwI, 1, 0!00000000
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!00000000
Number mwL, 1, 0!00000000
Number mwD, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number mt, 1, 0!000
Number mb, 1, 0!00000101

#  Frozen: what pcm never reads, which live would only take opt.pl's trials.
#  It codes with codes(), without a hint: no hint's mixer (lrm, mbm, index
#  n).
! Number lrm, 1, 0!01100
! Number mbm, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
