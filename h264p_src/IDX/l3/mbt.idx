#  h264p's mbt family at level -3: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l3/mbt_h.inc and MOD/l3/mbt_p.inc from this file and family.inc.
#
#  mb_type as a binary tree over its value, the node being the position in the
#  tree. st is the slice type and reference status, ca/cb/cc the classes of
#  macroblocks A, B and of the same one in the previous picture of the type
#  (0 none, 1 skip, 2 direct, 3 16x16, 4 16x8/8x16, 5 8x8, 6 I_NxN, 7 I16,
#  8 PCM), nsk the skipped ones of A, B, C and D; for Intra16x16 (from its
#  coded_block_pattern on), im 1 + the mode that does best in the proxy (0
#  none) and ig by how much it beats the next; in B slices, c1 1 + the class
#  of the same macroblock in list 1's first reference (0 none); tx the
#  skip family's.

Prefix H3_mbt
Debug 1
Const 0

Index a
 a_st: st, 1!000000000
 a_ca: ca, 1!11101110
 a_cb: cb, 1!11101110

Index b
 b_st: st, 1!001000000
 b_cc: cc, 1!11101110
 b_nsk: nsk, 1!0000
 b_c1: c1, 1!101010110

Index c
 c_st: st, 1!010100000
 c_ca: ca, 1!10111110
 c_cc: cc, 1!00110110

Index d
 d_st: st, 1!000010000

Index e
 e_st: st, 1!000000000
 e_ca: ca, 1!10000110

Index h
 h_st: st, 1!010000000
 h_nsk: nsk, 1!0000

Index i
 i_st: st, 1!001100000
 i_ca: ca, 1!10000000

Index j
 j_st: st, 1!000000000
 j_cb: cb, 1!11010110

Index k
 k_st: st, 1!011010000
 k_nsk: nsk, 1!1111
 k_cc: cc, 1!01010110

Index l
 l_st: st, 1!010100000
 l_ca: ca, 1!11110110
 l_cb: cb, 1!11110110

Index s
 s_st: st, 1!010000000

Index m
 m_st: st, 1!011100000

Index w
 w_st: st, 1!000000000

#  (frozen: see the parameters below)
Index t
! t_st: st, 1!0

Index n
! n_st: st, 1!0

Index g
! g_st: st, 1!0

Number rA, 1, 0!11111101
Number rB, 1, 0!11111010
Number rC, 1, 0!11111011
Number rE, 1, 0!10000110
Number rH, 1, 0!10111010
Number rI, 1, 0!00000000
Number rJ, 1, 0!11111110
Number rK, 1, 0!10100000
Number rL, 1, 0!11111110
Number rD, 1, 0!01110111
Number lr, 1, 0!01000
Number mwA, 1, 0!00100001
Number mwB, 1, 0!00000111
Number mwC, 1, 0!00111010
Number mwE, 1, 0!01011101
Number mwH, 1, 0!00000000
Number mwI, 1, 0!00100001
Number mwJ, 1, 0!10000000
Number mwK, 1, 0!00000010
Number mwL, 1, 0!00000000
Number mwD, 1, 0!01000111
Number mb, 1, 0!01000000

#  Frozen: what mbt never reads, which live would only take opt.pl's trials.
#  It codes decisions with bit() alone: no mantissa (rT, mwT, mt, index t),
#  no hint and its mixer (lrm, mbm, index n), no signs (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!01111
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
