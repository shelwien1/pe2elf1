#  h264p's skp family at level -3: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l3/skp_h.inc and MOD/l3/skp_p.inc from this file and skp.inc.
#
#  Whether a macroblock is skipped (node 0), whether the slice ends after it
#  (node 1), mb_field_decoding_flag (node 2). st is the slice type and
#  reference status; a3/b3 the macroblocks A and B (0 none, 1 skipped, 2
#  coded); col the same macroblock in the previous picture of the type, c9
#  the skipped ones in its 3x3 window, cd the skipped ones of C and D, run the
#  skipped macroblocks just before; cnt the macroblocks of the slice so far
#  and eq how that compares with the previous slice (0 fewer, 1 as many, 2
#  more); lf/af the field flags of the left and above pairs (0 none); td how
#  much the macroblock changed between the last two pictures decoded (1 +
#  tc_qlog, 0 not known); in B slices, c1 the same macroblock in list 1's
#  first reference, where that is the last picture of its kind (0 none, 1
#  skipped, 2 coded), and k9 the skipped ones in its 3x3 window (10 none);
#  tx the texture of the skip prediction, per sample, against the
#  quantizer's step (1 + tc_qlog, 0 not known).

Prefix H3_skp
Debug 1
Const 0

Index a
 a_st: st, 1!000000000
 a_a3: a3, 1!10
 a_b3: b3, 1!11
 a_col: col, 1!01
 a_c9: c9, 1!101111110
 a_eq: eq, 1!10
 a_lf: lf, 1!00
 a_af: af, 1!00

Index b
 b_st: st, 1!001000000
 b_a3: a3, 1!11
 b_b3: b3, 1!01
 b_cd: cd, 1!11
 b_cnt: cnt, 1!000000011111111
 b_c1: c1, 1!11

Index c
 c_st: st, 1!011000000
 c_col: col, 1!11
 c_c9: c9, 1!100101101
 c_run: run, 1!001100001

Index d
 d_st: st, 1!000000000
 d_a3: a3, 1!10
 d_b3: b3, 1!11
 d_c1: c1, 1!11
 d_k9: k9, 1!1101010110

Index e
 e_st: st, 1!011000000

Index h
 h_st: st, 1!011000000

Index i
 i_st: st, 1!000000000
 i_a3: a3, 1!00

Index j
 j_st: st, 1!011000000
 j_c9: c9, 1!010000001
 j_qc: qc, 1!11100001111000000

Index k
 k_st: st, 1!010000000
 k_b3: b3, 1!10

Index l
 l_st: st, 1!000000000
 l_col: col, 1!01
 l_cd: cd, 1!10

Index s
 s_st: st, 1!000000000

Index m
 m_st: st, 1!010000000
 m_col: col, 1!01

Index w
 w_st: st, 1!011000000
 w_a3: a3, 1!11
 w_b3: b3, 1!11

Index t
 t_st: st, 1!0

Index n
 n_st: st, 1!0

Index g
 g_st: st, 1!0

Number rA, 1, 0!11111110
Number rB, 1, 0!11111111
Number rC, 1, 0!11111111
Number rE, 1, 0!11111111
Number rH, 1, 0!11111110
Number rI, 1, 0!00000000
Number rJ, 1, 0!11111101
Number rK, 1, 0!01000000
Number rL, 1, 0!11110110
Number rD, 1, 0!11111111
Number rT, 1, 0!00000000
Number rG, 1, 0!00000000
Number lr, 1, 0!01110
Number lrm, 1, 0!00000
Number mbm, 1, 0!00000000
Number mwA, 1, 0!01000110
Number mwB, 1, 0!00010000
Number mwC, 1, 0!00111110
Number mwE, 1, 0!00010111
Number mwH, 1, 0!11110001
Number mwI, 1, 0!10001101
Number mwJ, 1, 0!00000100
Number mwK, 1, 0!00000000
Number mwL, 1, 0!01000110
Number mwD, 1, 0!00000001
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number mt, 1, 0!000
Number mb, 1, 0!00001111

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
