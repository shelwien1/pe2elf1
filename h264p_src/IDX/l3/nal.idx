#  h264p's nal family at level -3: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l3/nal_h.inc and MOD/l3/nal_p.inc from this file and family.inc.
#
#  NAL unit fields: the field id (fld) is a dense factor and the rest is the
#  field's own recent history (p1, p2) and a context the coder gives (ctx).

Prefix H3_nal
Debug 1
Const 0

Index a
 a_fld: fld, 1!11110000000001010
 a_ctx: ctx, 1!101001101000000
 a_p1: p1, 1!000000000000000

Index b
 b_fld: fld, 1!01010111000000010
 b_p1: p1, 1!000001
 b_p2: p2, 1!011

Index c
 c_fld: fld, 1!11000001000000010
 c_ctx: ctx, 1!1000111010000000000000000000000

Index d
 d_fld: fld, 1!01100001100000010

Index e
 e_fld: fld, 1!01100001100001010
 e_p2: p2, 1!001

Index h
 h_fld: fld, 1!01110000000001010
 h_ctx: ctx, 1!0100000000000000000000000000000

Index i
 i_ctx: ctx, 1!1000100110000000000000000000000
 i_p1: p1, 1!100100000000000

Index j
 j_fld: fld, 1!10010101000000010
 j_p2: p2, 1!111
 j_p1: p1, 1!011001000000000

Index k
 k_fld: fld, 1!11010011000000010
 k_ctx: ctx, 1!1001010100000000000000000000000

Index l
 l_p1: p1, 1!100001000000000
 l_p2: p2, 1!111

Index s
 s_fld: fld, 1!01110000001000010

Index m
 m_fld: fld, 1!01110011100001010

Index w
 w_fld: fld, 1!01100000000000010

Index t
 t_fld: fld, 1!00000000000000000

#  (frozen: see the parameters below)
Index n
! n_fld: fld, 1!00000000000000000

Index g
! g_fld: fld, 1!00000000000000000
! g_ctx: ctx, 1!000

Number rA, 1, 0!11111100
Number rB, 1, 0!00000000
Number rC, 1, 0!11110000
Number rE, 1, 0!11000000
Number rH, 1, 0!00000000
Number rI, 1, 0!11110001
Number rJ, 1, 0!11110000
Number rK, 1, 0!01100100
Number rL, 1, 0!00111000
Number rD, 1, 0!00000000
Number rT, 1, 0!11111100
Number lr, 1, 0!11011
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00010100
Number mwC, 1, 0!00011011
Number mwE, 1, 0!11111001
Number mwH, 1, 0!00000100
Number mwI, 1, 0!10011001
Number mwJ, 1, 0!00100000
Number mwK, 1, 0!00001101
Number mwL, 1, 0!11100110
Number mwD, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mt, 1, 0!010
Number mb, 1, 0!10011111

#  Frozen: what nal never reads, which live would only take opt.pl's trials.
#  It codes with code(), without a hint or signs: no hint's mixer (lrm, mbm,
#  index n), no signs (rG, mwG, index g).
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
