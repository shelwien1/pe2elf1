#  h264p's hdr family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/hdr_h.inc and
#  MOD/hdr_p.inc from this file and hdr.inc.
#
#  Header syntax elements (SPS, PPS, SEI, slice headers), coded as the
#  difference to the last value of the same element: tag is the element (a
#  dense id), fld the value's place in its group, p1/p2 the last two values,
#  pos how many values in a row the tag has had, p1r the low bits of the last
#  value and sty the slice type of the current slice.

Prefix H_hdr
Debug 1
Const 0

Index a
 a_tag: tag, &01011111
 a_fld: fld, 1!111
 a_p1: p1, 1!1111111
 a_sty: sty, 1!111111111

Index b
 b_tag: tag, &00101111
 b_p1r: p1r, &00001111

Index c
 c_tag: tag, &11111111
 c_fld: fld, 1!100101110000000

Index d
 d_tag: tag, &11111111
 d_p1: p1, 1!111001010010011
 d_p2: p2, 1!1111111

Index e
 e_tag: tag, &01001110
 e_pos: pos, 1!111

Index h
 h_tag: tag, &01011111
 h_sty: sty, 1!111111111

Index s
 s_tag: tag, &11111111

Index f
 f_tag: tag, &11111111

Index m
 m_tag: tag, &00000000

Index t
 t_tag: tag, &11111111

Index n
 n_tag: tag, &11111111

Index g
 g_p1: p1, 1!1111111
 g_pos: pos, 1!111

Number rA, 1, 0!10000000
Number rB, 1, 0!00000000
Number rC, 1, 0!00000000
Number rE, 1, 0!01000000
Number rH, 1, 0!01000000
Number rD, 1, 0!11111111
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000000
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00000000
Number mwD, 1, 0!10000000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01000
Number qs, 1, 3!0010000
Number qf, 1, 3!0010000
Number mb, 1, 0!11100010

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
