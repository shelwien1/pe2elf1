#  h264p's sgn family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/sgn_h.inc and
#  MOD/sgn_p.inc from this file and sgn.inc.
#
#  The sign of a nonzero coefficient. cg is the ctxBlockCat, pos the scan
#  position (class), sa/sb the sign at the same position in the blocks A and
#  B (0 zero, 1 positive, 2 negative, 3 none), scb for Cr DC the sign of Cb
#  at the same position, mag the magnitude (class), md the block's prediction
#  (as the other residual families); for the signs predicted from the samples
#  around the block (luma), pp the predicted sign (1 positive, 2 negative, 0
#  not predicted) and mg how much worse the other sign fits (1 + tc_qlog of
#  quarter samples).

Prefix H_sgn
Debug 1
Const 0

Index a
 a_cg: cg, 1!1111111111111
 a_pos: pos, 1!111
 a_sa: sa, 1!111
 a_sb: sb, 1!111

Index b
 b_cg: cg, 1!1111111111111
 b_scb: scb, 1!111
 b_pos: pos, 1!111

Index c
 c_cg: cg, 1!1111111111111
 c_mag: mag, 1!10
 c_md: md, 1!1100110000010101100

Index d
 d_cg: cg, 1!1111111111111
 d_pp: pp, 1!11
 d_mg: mg, 1!111111111111111

Index e
 e_cg: cg, 1!1111111111111
 e_pp: pp, 1!00
 e_mg: mg, 1!111111111111111
 e_mag: mag, 1!00

Index h
 h_cg: cg, 1!1111111111111
 h_pos: pos, 1!111
 h_ez: ez, 1!11111
 h_pp: pp, 1!11
 h_ts: ts, 1!111

Index s
 s_cg: cg, 1!0100000000000
 s_pp: pp, 1!11

Index f
 f_cg: cg, 1!0011000000000

Index m
 m_cg: cg, 1!1111111111111
 m_pp: pp, 1!00

Index w
 w_cg: cg, 1!1111111111111
 w_pp: pp, 1!00
 w_mg: mg, 1!111111111111111

Index t
 t_cg: cg, 1!0

Index n
 n_cg: cg, 1!0

Index g
 g_cg: cg, 1!0

Number rA, 1, 0!11101011
Number rB, 1, 0!00010000
Number rC, 1, 0!00000011
Number rE, 1, 0!01000000
Number rH, 1, 0!01000000
Number rD, 1, 0!01101111
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000001
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000000
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00000000
Number mwD, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01110
Number qs, 1, 3!0010000
Number qf, 1, 3!1111010
Number mb, 1, 0!10101000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
