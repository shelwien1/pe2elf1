#  h264p's ipm family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/ipm_h.inc and
#  MOD/ipm_p.inc from this file and ipm.inc.
#
#  Intra prediction modes: the actual Intra4x4/8x8 mode as a binary tree (nodes
#  1-15), intra_chroma_pred_mode in truncated unary (nodes 16-18). k8 is 0
#  for 4x4, 1 for 8x8 blocks, 2 for chroma; ma/mb the modes of the blocks A
#  and B (9 for DC by rule, 10 none) -- for chroma the modes of the
#  macroblocks A and B (4 none) --, mp the most probable mode, blk the
#  block, pv the previous block's mode (9 none), col the same block in the
#  previous picture of the type (9 none); dm the strongest edge direction
#  next to the macroblock at the block's place (DIMD, 9 none) and ds the
#  strength of the edges (0 none).

Prefix H_ipm
Debug 1
Const 0

Index a
 a_k8: k8, 1!11
 a_ma: ma, 1!1111111111
 a_mb: mb, 1!1111111111

Index b
 b_k8: k8, 1!11
 b_mp: mp, 1!111111111
 b_pv: pv, 1!111111111

Index c
 c_k8: k8, 1!11
 c_mp: mp, 1!111111111
 c_col: col, 1!111111111

Index d
 d_k8: k8, 1!11
 d_mp: mp, 1!111111111
 d_dm: dm, 1!111111111
 d_ds: ds, 1!111111111

Index s
 s_k8: k8, 1!11
 s_dm: dm, 1!111111111

Index f
 f_k8: k8, 1!11
 f_dm: dm, 1!111111111

Index m
 m_k8: k8, 1!00
 m_ma: ma, 1!0000000000
 m_mb: mb, 1!0000000011

Index t
 t_k8: k8, 1!0

Index n
 n_k8: k8, 1!0

Index g
 g_k8: k8, 1!0

Number rA, 1, 0!11010010
Number rB, 1, 0!00010001
Number rC, 1, 0!00000000
Number rD, 1, 0!11111111
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00001010
Number mwC, 1, 0!00000000
Number mwD, 1, 0!11100000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01000
Number qs, 1, 3!0010000
Number qf, 1, 3!0010000
Number mb, 1, 0!00000101

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
