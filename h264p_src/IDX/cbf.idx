#  h264p's cbf family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/cbf_h.inc and
#  MOD/cbf_p.inc from this file and cbf.inc.
#
#  The number of nonzero coefficients of a block, 0 for none (kn 0), or
#  less 1 where the block is known to have one (kn 1: CABAC 8x8 blocks
#  without coded_block_flag). cat is the block's ctxBlockCat; na/nb the
#  nonzero coefficients of the blocks A and B (9 for none), intra the
#  macroblock is intra, q6 QP/6, np the nonzero blocks so far in its 8x8
#  block (for chroma: in the macroblock), pos the block's place in its 8x8
#  block, crcb for a Cr block the Cb block (0 none, 1 zero, 2 not), col the
#  same block in the previous picture of the type (2 none), nc CAVLC's nC
#  (class).

Prefix H_cbf
Debug 1
Const 0

Index a
 a_cat: cat, 1!1111111111111
 a_na: na, 1!110100101
 a_nb: nb, 1!111111111
 a_intra: intra, 1!1

Index b
 b_cat: cat, 1!1111111111111
 b_np: np, 1!111
 b_pos: pos, 1!111
 b_crcb: crcb, 1!11
 b_kn: kn, 1!1
 b_em: em, 1!1111111111111111

Index c
 c_cat: cat, 1!1111111111111
 c_q6: q6, 1!11111111
 c_col: col, 1!11
 c_kn: kn, 1!1
 c_en: en, 1!11111111111111

Index d
 d_cat: cat, 1!1111111111111
 d_nc: nc, 1!11111
 d_md: md, 1!0110000000000100100
 d_kn: kn, 1!1
 d_pg: pg, 1!1111111111111111

Index e
 e_cat: cat, 1!1111111111111
 e_pz: pz, 1!11111
 e_na: na, 1!111111111
 e_nb: nb, 1!111111111
 e_tn: tn, 1!11111

Index h
 h_cat: cat, 1!1111111111111
 h_pg: pg, 1!1111111111111111
 h_md: md, 1!1111001101110111100
 h_q6: q6, 1!11111111

Index s
 s_cat: cat, 1!1111111111111
 s_kn: kn, 1!1

Index f
 f_cat: cat, 1!1111111111111
 f_intra: intra, 1!1

Index m
 m_cat: cat, 1!1111000000000
 m_kn: kn, 1!1

Index t
 t_cat: cat, 1!1111111111111

Index n
 n_cat: cat, 1!1111111111111

Index g
 g_cat: cat, 1!0

Number rA, 1, 0!01000000
Number rB, 1, 0!00010000
Number rC, 1, 0!01000000
Number rE, 1, 0!01000000
Number rH, 1, 0!01000000
Number rD, 1, 0!11110010
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000000
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00000000
Number mwD, 1, 0!00000000
Number mwT, 1, 0!00001000
Number mwG, 1, 0!00000000
Number bw, 1, 0!10000
Number qs, 1, 3!0000000
Number qf, 1, 3!0010000
Number mb, 1, 0!10000010

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
