#  h264p's cbf family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/cbf_h.inc and
#  MOD/cbf_p.inc from this file and cbf.inc.
#
#  The number of nonzero coefficients of a block, 0 for none (kn 0), or
#  less 1 where the block is known to have one (kn 1: CABAC 8x8 blocks
#  without coded_block_flag). cat is the block's ctxBlockCat; na/nb the
#  nonzero coefficients of the blocks A and B (9 for none), intra the
#  macroblock is intra, q6 QP/6, np the nonzero blocks so far in its 8x8
#  block (for chroma: in the macroblock), pos the block's place in its 8x8
#  block, crcb for a Cr block the Cb block (0 none, 1 zero, 2 not), col the
#  same block in the previous picture of the type (2 none), nc CAVLC's nC
#  (class), tn for a luma block of a P picture on its first reference the
#  nonzero coefficients of the block its vector points at in the last
#  picture of the type (1 + up to 4; 6 + where the vector moves it; 0
#  none); ds for an inter luma 4x4 block of a P or B slice, 1 + the score
#  of x264's decimation its 8x8 block still owes after the blocks before it
#  (4, or 6 for the macroblock's only coded 8x8 block, less theirs; 0 not
#  applicable); hv as the sig family's.

Prefix H_cbf
Debug 1
Const 0

Index a
 a_cat: cat, 1!1111111111111
 a_na: na, 1!110100101
 a_nb: nb, 1!111111111
 a_intra: intra, 1!1

Index b
 b_cat: cat, 1!1111111111111
 b_np: np, 1!111
 b_pos: pos, 1!111
 b_crcb: crcb, 1!11
 b_kn: kn, 1!1
 b_em: em, 1!1111111111111111

Index c
 c_cat: cat, 1!1000000000000
 c_q6: q6, 1!11111111
 c_col: col, 1!11
 c_kn: kn, 1!1
 c_en: en, 1!11111111111111
 c_ch: ch, 1!111111111111111

Index d
 d_cat: cat, 1!1111111111111
 d_nc: nc, 1!11111
 d_md: md, 1!0110000000000100100
 d_kn: kn, 1!1
 d_pg: pg, 1!1111111111111111

Index e
 e_cat: cat, 1!1111111111111
 e_pz: pz, 1!1011100000000000
 e_na: na, 1!111111111
 e_nb: nb, 1!111111111
 e_tn: tn, 1!1111111111

Index h
 h_cat: cat, 1!1111111111111
 h_pg: pg, 1!1111111111111111
 h_md: md, 1!1100000110110100100
 h_q6: q6, 1!11111111
 h_hv: hv, 1!1111111

Index i
 i_cat: cat, 1!1111111111111
 i_pz: pz, 1!1111111111111111
 i_pq: pq, 1!100000000000100000000011
 i_np: np, 1!111
 i_ds: ds, 1!1111111

Index j
 j_cat: cat, 1!1111111111111
 j_em: em, 1!1111111111111111
 j_pg: pg, 1!1111111111111111
 j_na: na, 1!111111111

Index k
 k_cat: cat, 1!1111111111111
 k_na: na, 1!111111111
 k_nb: nb, 1!111111111
 k_pz: pz, 1!1111111111111111

Index l
 l_cat: cat, 1!1111111111111
 l_col: col, 1!01
 l_np: np, 1!000
 l_md: md, 1!1111111111111111111

Index s
 s_cat: cat, 1!1111111111111
 s_kn: kn, 1!1
 s_pq: pq, 1!011000011000100000001001

Index f
 f_cat: cat, 1!1111111111111
 f_intra: intra, 1!1

Index m
 m_cat: cat, 1!1111000000000
 m_kn: kn, 1!1

Index w
 w_cat: cat, 1!1111111111111
 w_nc: nc, 1!11011
 w_md: md, 1!0110000000000100100
 w_kn: kn, 1!1

Index t
 t_cat: cat, 1!1111111111111

Index n
 n_cat: cat, 1!1111111111111

Index g
 g_cat: cat, 1!0

Number rA, 1, 0!01000000
Number rB, 1, 0!01011010
Number rC, 1, 0!01000000
Number rE, 1, 0!01000000
Number rH, 1, 0!01000000
Number rI, 1, 0!01000000
Number rJ, 1, 0!11000111
Number rK, 1, 0!01000000
Number rL, 1, 0!01000000
Number rD, 1, 0!11110010
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000000
Number mwE, 1, 0!00010010
Number mwH, 1, 0!00000000
Number mwI, 1, 0!00100100
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!00000000
Number mwL, 1, 0!00000000
Number mwD, 1, 0!11001000
Number mwT, 1, 0!00001000
Number mwG, 1, 0!00000000
Number bw, 1, 0!10000
Number mt, 1, 0!110
Number qs, 1, 3!0000000
Number qf, 1, 3!0010000
Number mb, 1, 0!10000010

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hE, 1, 0!10000
! Number hH, 1, 0!10000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
