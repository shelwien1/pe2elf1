#  h264p's cbf family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/cbf_h.inc and
#  MOD/cbf_p.inc from this file and cbf.inc.
#
#  Whether a block of coefficients has a nonzero one. cat is the block's
#  ctxBlockCat; na/nb the nonzero coefficients of the blocks A and B (5 for
#  none), intra the macroblock is intra, q6 QP/6, np the nonzero blocks so far
#  in its 8x8 block (for chroma: in the macroblock), pos the block's place in
#  its 8x8 block, crcb for a Cr block the Cb block (0 none, 1 zero, 2 not), col
#  the same block in the previous picture of the type (2 none).

Prefix H_cbf
Debug 1
Const 0

Index a
 a_cat: cat, 1!1111111111111
 a_na: na, 1!11111
 a_nb: nb, 1!11111
 a_intra: intra, 1!1

Index b
 b_cat: cat, 1!1111111111111
 b_np: np, 1!111
 b_pos: pos, 1!111
 b_crcb: crcb, 1!11

Index c
 c_cat: cat, 1!1111111111111
 c_q6: q6, 1!11111111
 c_col: col, 1!11

Index d
 d_cat: cat, 1!1111111111111

Index s
 s_cat: cat, 1!1111111111111

Index f
 f_cat: cat, 1!1111111111111
 f_intra: intra, 1!1

Index m
 m_cat: cat, 1!1111111111111

Index t
 t_cat: cat, 1!0

Index n
 n_cat: cat, 1!0

Index g
 g_cat: cat, 1!0

Number rA, 1, 0!01000000
Number rB, 1, 0!00010000
Number rC, 1, 0!01000000
Number rD, 1, 0!11111111
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000000
Number mwD, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01000
Number qs, 1, 3!0010000
Number qf, 1, 3!0010000
Number mb, 1, 0!00000101

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
