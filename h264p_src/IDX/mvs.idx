#  h264p's mvs family: its context indices and its tunable parameters.
#  IDX/IDX-FORMAT.md is the format; ../mk.sh regenerates MOD/mvs_h.inc and
#  MOD/mvs_p.inc from this file and mvs.inc.
#
#  Motion: sub_mb_type (kind 0 P, 1 B, as a binary tree), ref_idx (kind 2) and
#  the components of mvd (kind 3; the sign has its own counters). comp is the
#  component, lst the list, ma/mb the magnitudes of the components of A and
#  B (classes), oth the class of the other component already coded, ps the
#  partition size (0 16x16 .. 3 4x4), rf the ref_idx of the partition (or of
#  A for ref_idx), pi the partition's place in the macroblock, nr the
#  references of the list; for mvd pd the vector of the same partition in the
#  previous picture of the type less the predicted vector, sp how far the
#  vectors of the neighbours A, B, C are from the predicted one (1 + tc_qlog,
#  0 none), for ref_idx pd the ref_idx in the previous picture.

Prefix H_mvs
Debug 1
Const 0

Index a
 a_kind: kind, 1!011
 a_comp: comp, 1!1
 a_ma: ma, 1!1111000
 a_mb: mb, 1!1111100
 a_oth: oth, 1!11111
 a_sp: sp, 1!11111111

Index b
 b_kind: kind, 1!111
 b_comp: comp, 1!1
 b_lst: lst, 1!1
 b_ps: ps, 1!111
 b_rf: rf, 1!111
 b_pi: pi, 1!111

Index c
 c_kind: kind, 1!111
 c_comp: comp, 1!1
 c_pd: pd, 1!11101101
 c_sp: sp, 1!11111111

Index d
 d_kind: kind, 1!111
 d_comp: comp, 1!0
 d_pd: pd, 1!11111111
 d_ma: ma, 1!1111111
 d_nr: nr, 1!111

Index s
 s_kind: kind, 1!111
 s_comp: comp, 1!1
 s_pd: pd, 1!10100011

Index f
 f_kind: kind, 1!111
 f_comp: comp, 1!1
 f_sp: sp, 1!11111111

Index m
 m_kind: kind, 1!111
 m_comp: comp, 1!0
 m_pd: pd, 1!11111

Index t
 t_kind: kind, 1!111
 t_comp: comp, 1!1

Index n
 n_kind: kind, 1!111

Index g
 g_kind: kind, 1!111
 g_ma: ma, 1!0
 g_oth: oth, 1!0

Number rA, 1, 0!01000000
Number rB, 1, 0!00000010
Number rC, 1, 0!01000000
Number rD, 1, 0!11111111
Number rT, 1, 0!00110111
Number rG, 1, 0!01011010
Number rS1, 1, 0!00110
Number rS2, 1, 0!00110
Number lr, 1, 0!01100
Number lrm, 1, 0!01100
Number mbm, 1, 0!00000000
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00001000
Number mwC, 1, 0!10111000
Number mwD, 1, 0!00000000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01100
Number qs, 1, 3!0010000
Number qf, 1, 3!0010000
Number mb, 1, 0!01101100

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hD, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
