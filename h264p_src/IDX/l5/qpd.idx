#  h264p's qpd family at level -5: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l5/qpd_h.inc and MOD/l5/qpd_p.inc from this file and family.inc.
#
#  mb_qp_delta. lnz: the previous macroblock had a nonzero delta (CABAC's
#  context); pc the luma bits of the coded_block_pattern, cc its chroma part,
#  cls the class; dc and db the QP of the same macroblock in the previous
#  picture of the type and of macroblock B, relative to the predicted QP
#  (4 equal); lz the last nonzero delta (3 for none); st the slice type; ae
#  the delta adaptive quantization would give, from the energy of the
#  macroblock in the last picture decoded against that of the one that set
#  the predicted QP (7 none); aq the delta the line of QP against energy
#  gives (7 + the delta, 0 none), ac how far the last picture of the kind
#  was from its line where the macroblock's content was; td how much the
#  macroblock changed between the last two pictures decoded (1 + tc_qlog, 0
#  not known), for the macroblock tree's lower QP where pictures stay; sq
#  the slice's QP less the predicted one (7 + that, -6 to 6): an encoder's
#  QPs keep near the slice's; xe the class of the energy the line takes
#  (1 + log2, up to 18; 0 none), for an encoder whose QP is no line of it
#  (flat below an energy, then rising); lq the QP of the picture's last
#  macroblock of the kind (inter, I_NxN, other) and energy class less the
#  predicted one (7 + that, -6 to 6; 0 none): the rate control's QP plus
#  what the class adds; bc B's QP less the predicted one where B is coded
#  and of the same kind (7 + that, -6 to 6; 0 not), cl and kc the same for
#  col and C.  The
#  magnitude has the line's delta as code()'s hint; the sign is the qpg
#  family's.

Prefix H5_qpd
Debug 1
Const 0

Index a
 a_lnz: lnz, 1!0
 a_pc: pc, 1!1100
 a_cc: cc, 1!01
 a_cls: cls, 1!00000100
 a_sq: sq, 1!0101111010101

Index b
 b_dc: dc, 1!01011010
 b_aq: aq, 1!1000000100000
 b_ae: ae, 1!1010111110010
 b_lq: lq, 1!0001101010010

Index c
 c_lz: lz, 1!101110
 c_st: st, 1!010010000
 c_db: db, 1!11110100
 c_bc: bc, 1!1101000100101

Index d
 d_st: st, 1!011100000
 d_aq: aq, 1!0010101110101
 d_ac: ac, 1!1010000100001

Index e
 e_lnz: lnz, 1!0
 e_aq: aq, 1!0101011011010
 e_cls: cls, 1!00100110
 e_sq: sq, 1!0110001101010
 e_xe: xe, 1!001001100000001001

Index h
 h_ae: ae, 1!1111100001101
 h_dc: dc, 1!00000000
 h_pc: pc, 1!0000

Index i
 i_aq: aq, 1!1101011110101
 i_ac: ac, 1!1010010001000
 i_cls: cls, 1!00000110
 i_td: td, 1!1001000001001000

Index j
 j_st: st, 1!010010000
 j_dc: dc, 1!00000000
 j_db: db, 1!10100010
 j_lnz: lnz, 1!1
 j_td: td, 1!0001000000000100
 j_lq: lq, 1!1101011101101

Index k
 k_aq: aq, 1!1010100001101
 k_lnz: lnz, 1!1
 k_pc: pc, 1!1001
 k_kc: kc, 1!1101110010101

Index l
 l_ac: ac, 1!1000000010000
 l_db: db, 1!01100110
 l_st: st, 1!010100000
 l_cl: cl, 1!1001011111100

Index m
 m_lnz: lnz, 1!0
 m_aq: aq, 1!0000000000000

Index t
 t_lnz: lnz, 1!0

Index n
 n_lnz: lnz, 1!0

#  (frozen: see the parameters below)
Index g
! g_lz: lz, 1!000000
! g_aq: aq, 1!0000000000000

Number rA, 1, 0!11100100
Number rB, 1, 0!11111110
Number rC, 1, 0!11111000
Number rE, 1, 0!11110101
Number rH, 1, 0!01001010
Number rI, 1, 0!01010000
Number rJ, 1, 0!11111110
Number rK, 1, 0!01101110
Number rL, 1, 0!11101001
Number rD, 1, 0!11111000
Number rT, 1, 0!00010000
Number lr, 1, 0!01111
Number lrm, 1, 0!11111
Number mbm, 1, 0!00011000
Number mwA, 1, 0!01000000
Number mwB, 1, 0!00100000
Number mwC, 1, 0!01000001
Number mwE, 1, 0!00001000
Number mwH, 1, 0!00000110
Number mwI, 1, 0!00100111
Number mwJ, 1, 0!10000000
Number mwK, 1, 0!00100011
Number mwL, 1, 0!01100001
Number mwD, 1, 0!10000100
Number mwT, 1, 0!00000111
Number mt, 1, 0!010
Number mb, 1, 0!00011011

#  Frozen: what qpd never reads, which live would only take opt.pl's trials.
#  It codes with code(), without signs: no sign counters (rG, mwG, index g).
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!10000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
