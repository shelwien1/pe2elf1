#  h264p's sig family at level -5: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l5/sig_h.inc and MOD/l5/sig_p.inc from this file and sig.inc.
#
#  The significance map, given the number of nonzero coefficients: whether
#  the coefficient at each scan position is nonzero, until none remain. cg
#  is the block's ctxBlockCat, pos the scan position, rem the nonzero
#  coefficients still to come and zl the zero ones (tc_qlog), tot all
#  nonzero ones (tc_qlog), nc CAVLC's nC (class), fld field scan, q6 QP/6,
#  tz the magnitude at the position in the block of the cbf family's tn (1 +
#  up to 3; 5 + where the vector moves it; 0 none), sn whether it is nonzero
#  in the blocks A and B (3 x A + B: 0 none, 1 zero, 2 not), hv which way
#  the texture of the block's prediction runs (4 + log2 of its differences
#  along rows over those along columns, -3 to 3; 0 flat or none), pf for an
#  inter block the prediction's own level at the position (its transform
#  quantized as a residual would be: 1 + tc_qlog of quarter levels, 0 none).

Prefix H5_sig
Debug 1
Const 0

Index a
 a_cg: cg, 1!1011100000000
 a_pos: pos, 1!000010011011110000011010010111000001011000010100001100101101110
 a_rem: rem, 1!0101111110

Index b
 b_cg: cg, 1!1101100000000
 b_pos: pos, 1!110100001111110011110101100000100000001110000000000110100101010
 b_md: md, 1!1111111101110111100
 b_hb: hb, 1!

Index c
 c_cg: cg, 1!1111100000000
 c_pos: pos, 1!100000000000000111000001100000111100011110001010010110111001100
 c_q6: q6, 1!01111100
 c_pg: pg, 1!0101011110101011
 c_ft: ft, 1!11111111

Index d
 d_cg: cg, 1!1010100000000
 d_rem: rem, 1!0111100110
 d_zl: zl, 1!0111111010
 d_em: em, 1!1000101010101011
 d_hb: hb, 1!

Index e
 e_cg: cg, 1!1111100000000
 e_pos: pos, 1!011011001111110010011100010110100100010111010101011010111110100
 e_tz: tz, 1!00000000

Index h
 h_cg: cg, 1!1111100000000
 h_pos: pos, 1!110111111111110010110101111011111011001111110111011100001011110
 h_rem: rem, 1!0100110010
 h_tz: tz, 1!11111110
 h_h3: h3, 1!01011100101010

Index i
 i_cg: cg, 1!1101100000000
 i_pos: pos, 1!111111111111011011011110111111101100101111011010111010111001000
 i_hv: hv, 1!1101110

Index j
 j_cg: cg, 1!0000000000000
 j_pos: pos, 1!000000000000000000000000000000001001101010001010110011000000000
 j_ft: ft, 1!00111101
 j_h3: h3, 1!10000000000000
 j_nc: nc, 1!00000

Index k
 k_cg: cg, 1!1111110110110
 k_pos: pos, 1!100111111111110111111111111111101111011111111111111111111011111
 k_rem: rem, 1!0111110010
 k_h3: h3, 1!11101111101111
 k_sn: sn, 1!00001101
 k_hv: hv, 1!1011101

Index l
 l_cg: cg, 1!1111100000000
 l_pos: pos, 1!000000001110110110011111010110110111110111010101111010110010000
 l_sn: sn, 1!00010110
 l_pf: pf, 1!10110110101

Index m
 m_cg: cg, 1!0111100000000
 m_pos: pos, 1!100000001
 m_rem: rem, 1!0010001000

Index t
 t_cg: cg, 1!0

Index n
 n_cg: cg, 1!0

Index g
 g_cg: cg, 1!0

Number rA, 1, 0!11111111
Number rB, 1, 0!11011001
Number rC, 1, 0!11111101
Number rE, 1, 0!11111100
Number rH, 1, 0!10001011
Number rI, 1, 0!11111111
Number rJ, 1, 0!10000000
Number rK, 1, 0!11111111
Number rL, 1, 0!10101000
Number rD, 1, 0!11101110
Number rT, 1, 0!00000000
Number rG, 1, 0!00000000
Number lr, 1, 0!01100
Number lrm, 1, 0!00000
Number mbm, 1, 0!00000000
Number mwA, 1, 0!10000000
Number mwB, 1, 0!10000000
Number mwC, 1, 0!00001010
Number mwE, 1, 0!10011110
Number mwH, 1, 0!01100011
Number mwI, 1, 0!00110001
Number mwJ, 1, 0!01111101
Number mwK, 1, 0!00001000
Number mwL, 1, 0!00100000
Number mwD, 1, 0!01000000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number mt, 1, 0!000
Number mb, 1, 0!01000001

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!10101
! Number hC, 1, 0!11000
! Number hE, 1, 0!10101
! Number hH, 1, 0!10100
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!10101
! Number hL, 1, 0!10101
! Number hD, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
