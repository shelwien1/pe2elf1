#  h264p's hdr family at level -5: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l5/hdr_h.inc and MOD/l5/hdr_p.inc from this file and family.inc.
#
#  Header syntax elements (SPS, PPS, SEI, slice headers), coded as the
#  difference to the last value of the same element at the same place in
#  its group (up to 15) and row in a run of it (up to 15), in the same kind
#  of slice (frame_num and pic_order_cnt_lsb modulo their range, as they
#  wrap): tag is the element (a
#  dense id), fld the value's place in its group, p1/p2 the last two values,
#  pos how many values in a row the tag has had, p1r the low bits of the last
#  value, sty the slice type of the current slice, pr whether the slice
#  before was a reference (frame_num grows after one; 2 none, 3 not in a
#  slice).

Prefix H5_hdr
Debug 1
Const 0

Index a
 a_tag: tag, &01011111
 a_fld: fld, 1!111
 a_p1: p1, 1!1100110
 a_sty: sty, 1!011000000
 a_pr: pr, 1!100

Index b
 b_tag: tag, &01111111
 b_p1r: p1r, &11111111

Index c
 c_tag: tag, &01111111
 c_fld: fld, 1!101001010000001

Index d
 d_tag: tag, &00111111
 d_p1: p1, 1!111000001001000
 d_p2: p2, 1!1111101

Index e
 e_tag: tag, &00010101
 e_pos: pos, 1!010

Index h
 h_tag: tag, &00111110
 h_sty: sty, 1!011011000

Index i
 i_tag: tag, &01111011

Index j
 j_fld: fld, 1!100
 j_p2: p2, 1!1000101

Index k
 k_tag: tag, &01111111
 k_fld: fld, 1!111111111111111

Index l
 l_tag: tag, &00000000
 l_pos: pos, 1!010

Index m
 m_tag: tag, &00000000

Index t
 t_tag: tag, &00011110

#  (frozen: see the parameters below)
Index n
! n_tag: tag, &00000000

Index g
 g_p1: p1, 1!1111110
 g_pos: pos, 1!000

Number rA, 1, 0!11000000
Number rB, 1, 0!01000111
Number rC, 1, 0!00000000
Number rE, 1, 0!00000000
Number rH, 1, 0!01110011
Number rI, 1, 0!01001001
Number rJ, 1, 0!01000100
Number rK, 1, 0!01000101
Number rL, 1, 0!11111100
Number rD, 1, 0!11111101
Number rT, 1, 0!00000010
Number rG, 1, 0!01000000
Number lr, 1, 0!10100
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000100
Number mwC, 1, 0!00001010
Number mwE, 1, 0!10100011
Number mwH, 1, 0!00000011
Number mwI, 1, 0!10001001
Number mwJ, 1, 0!00100000
Number mwK, 1, 0!00000000
Number mwL, 1, 0!00000000
Number mwD, 1, 0!00000101
Number mwT, 1, 0!00000111
Number mwG, 1, 0!00000000
Number mt, 1, 0!000
Number mb, 1, 0!11110010

#  Frozen: what hdr never reads, which live would only take opt.pl's trials.
#  It codes with codes(), without a hint: no hint's mixer (lrm, mbm, index
#  n).
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
