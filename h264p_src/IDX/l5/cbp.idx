#  h264p's cbp family at level -5: its context indices and its tunable
#  parameters.  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates
#  MOD/l5/cbp_h.inc and MOD/l5/cbp_p.inc from this file and family.inc.
#
#  coded_block_pattern, one decision at a time: the luma bits of the four 8x8
#  blocks (nodes 0-3), chroma not 0 (4), chroma 2 (5), and
#  transform_size_8x8_flag (6). inc is CABAC's ctxIdxInc of the decision, pc
#  the luma bits set so far, cls the class of the macroblock, col the
#  decision's value in the same macroblock of the previous picture of the
#  type (1 + the value, 0 none; for a luma block of an inter macroblock of
#  a P picture whose reference is the last picture of a kind, 3 + the 4x4
#  blocks with coefficients under where its vector puts it there, 8 +
#  where the vector moves it), q6 QP/6, st the slice type.

Prefix H5_cbp
Debug 1
Const 0

Index a
 a_inc: inc, 1!101
 a_pc: pc, 1!1101
 a_cls: cls, 1!00111100
 a_st: st, 1!010010000

Index b
 b_inc: inc, 1!000
 b_col: col, 1!011100011000
 b_q6: q6, 1!11000000

Index c
 c_cls: cls, 1!00100100
 c_col: col, 1!011100011000
 c_pc: pc, 1!1010
 c_pg: pg, 1!0000100010010011

Index d
 d_inc: inc, 1!111
 d_em: em, 1!1110101010010101
 d_cls: cls, 1!00100100

Index e
 e_inc: inc, 1!000
 e_pg: pg, 1!1001010000100100
 e_cls: cls, 1!00100000
 e_tp: tp, 1!1000100010110000

Index h
 h_inc: inc, 1!000
 h_td: td, 1!1000010000100001
 h_en: en, 1!10001001000100
 h_q6: q6, 1!01111100

Index i
 i_inc: inc, 1!000
 i_cls: cls, 1!00000100
 i_q6: q6, 1!10000010

Index j
 j_inc: inc, 1!000
 j_tp: tp, 1!1100001001001000
 j_em: em, 1!1101010101101000
 j_st: st, 1!011100000

Index k
 k_inc: inc, 1!111
 k_pg: pg, 1!0000001001001100
 k_col: col, 1!011110100000
 k_cls: cls, 1!00110100

Index l
 l_inc: inc, 1!001
 l_pc: pc, 1!1100
 l_en: en, 1!11110000101001
 l_q6: q6, 1!10010000

Index m
 m_inc: inc, 1!000

#  (frozen: see the parameters below)
Index t
! t_st: st, 1!0

Index n
! n_st: st, 1!0

Index g
! g_st: st, 1!0

Number rA, 1, 0!11111110
Number rB, 1, 0!11011011
Number rC, 1, 0!11111001
Number rE, 1, 0!11111111
Number rH, 1, 0!11101100
Number rI, 1, 0!01111111
Number rJ, 1, 0!11011100
Number rK, 1, 0!11111110
Number rL, 1, 0!00000000
Number rD, 1, 0!11111011
Number lr, 1, 0!01010
Number mwA, 1, 0!00010000
Number mwB, 1, 0!00001101
Number mwC, 1, 0!00000000
Number mwE, 1, 0!00001101
Number mwH, 1, 0!00010000
Number mwI, 1, 0!00100000
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!00000100
Number mwL, 1, 0!10000001
Number mwD, 1, 0!01001001
Number mb, 1, 0!00001111

#  Frozen: what cbp never reads, which live would only take opt.pl's trials.
#  It codes decisions with bit() alone: no mantissa (rT, mwT, mt, index t),
#  no hint and its mixer (lrm, mbm, index n), no signs (rG, mwG, index g).
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000

#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows and contexts share
#  them.  31 is "never hashed".  Frozen: left live these only grow.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hD, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
