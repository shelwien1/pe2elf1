// sym_list.inc -- the symbol list: the alphabet, its weights, and the search that
// codes one symbol of it.

struct FreqRec {
  union {
    uint16_t w[8];
    struct {
      uint16_t _w0to6[7];
      uint8_t b14;
      uint8_t b15;
    };
  };

  // Seed this record for one live selector pair: an escape weight that halves
  // with the level, a floor at sixty-four times it, and the weight added to
  // both of the pair's slots.  Answers whether the pair is live, which the
  // caller counts.
  //
  // Written out in both `unmodel_plane_slow` and `model_plane`, ten lines
  // apiece.  One read the level from the local it had just stored into `b14`
  // and cast it to `uint8_t`; the other read it back out of `b14`, which is a
  // `uint8_t` member, so the cast and the read-back are the same value.
  bool seed_pair(int32_t lo, int32_t hi, int32_t alphabet_lvl) {
    if( !w[lo]||!w[hi]||b14>alphabet_lvl )
      return false;
    const int16_t weight = (uint8_t)(1<<((5-b14)&31));
    b15 = weight;
    w[6] = weight<<6;
    w[lo] += weight;
    w[hi] += b15;
    resum();
    return true;
  }

  // Which of the five levels `target` falls in, and the cumulative weight to
  // the end of it.  Five slots walked in order.
  //
  // Both decoders wrote this as a five-deep nest of `if`/`else`, twenty-three
  // lines, with the level a literal in each of the six arms -- a linear search
  // with its loop unrolled and its counter written out as constants.
  int32_t find_level(int32_t target, int32_t& cum) const {
    int32_t lvl = 0;
    cum = w[0];
    while( lvl<4&&cum<=target )
      cum += w[++lvl];
    return lvl;
  }

  // Add `b15` to one level and to the total, rescaling the record first if it
  // has outgrown the escape floor in `w[6]` or passed 0x4000.
  //
  // Three sites wrote this out.  Two of the three called `rescale`; the third
  // had it inlined as well, thirty-eight lines, holding the floor, the level
  // and the increment in `nb_sym[0]`, `nb_sym[2]` and `nb_sym[3]` -- three
  // slots of the pixel's *neighbour table* used as scratch.
  //
  // That third copy also wrote `b15` unconditionally where `rescale` writes it
  // only when it is raising it.  The value is the same either way: the branch
  // it sits in has already taken the maximum of the old `b15` and 15.
  void bump(int32_t lvl) {
    const uint16_t floor_ = w[6];
    uint16_t total = w[5];
    uint8_t kick = b15;
    if( total>floor_&&(w[lvl]+kick+8<total||w[5]>0x4000u) )
      total = rescale(floor_, kick);
    w[5] = kick+total;
    w[lvl] += kick;
  }

  // Blend `src` into this record.  The five selector weights this record has
  // are kept, scaled by `src`'s `b15`; `src`'s weights take their place; each
  // then gets 21 parts in `src`'s total added back, rounded up; and the total
  // is re-summed.  `b14` is multiplied by eight on the way through.
  //
  // `code_pixel` and `decode_pixel` each wrote this out, twenty-three lines
  // apiece, holding four of the five scaled weights in `nb_sym[0..3]` -- four
  // slots of the thirty-two-entry *neighbour table*, borrowed as scratch
  // because that is where MSVC had spare stack.  Reading either body, those
  // four lines look like the neighbourhood being written and they are not.
  //
  // The fifth scaled weight was an `int16_t` in both copies where the other
  // four were `int32_t`, and `b15 * w[1]` reaches 16.7 million, so that
  // truncation is real.  It is also invisible: the value is only ever added to
  // and stored into a `uint16_t`, and the two agree modulo 65536.
  void blend_from(const FreqRec& src) {
    const int32_t scale = src.b15;
    int32_t kept[5];
    for( int32_t i = 0; i<5; ++i )
      kept[i] = scale*w[i];
    *this = src;
    b14 *= 8;
    const int32_t total = w[5];
    for( int32_t i = 0; i<5; ++i )
      w[i] = (uint16_t)(kept[i]+(21*w[i]+total-1)/total);
    resum();
  }

  // `w[5]` is the total of the five selector weights.  Three places compute it:
  // this, and the two `init_tables` bodies that seed a record -- and those two
  // spelled the five terms in the order 0, 4, 3, 2, 1.
  uint16_t resum() {
    uint16_t sum = (uint16_t)(w[0]+w[1]+w[2]+w[3]+w[4]);
    w[5] = sum;
    return sum;
  }

  // Halve the five selector weights and re-sum them into `w[5]`, raising the
  // escape floor and the increment if the halving left them too small.
  //
  // The two pixel bodies wrote this out, thirty lines each, with the five
  // halvings interleaved against each other and three of the locals spilled
  // through the frame -- `frame.sym[0..2]` held `w[6]`, the level and `b15`
  // across the middle of it.  Both copies also re-read `w[5]` afterwards to add
  // `b15`, which is why this returns the new sum instead of only storing it.
  uint16_t rescale(uint16_t escape_floor, uint8_t& kick) {
    halve_counts(w, 5);
    const uint16_t sum = resum();
    if( escape_floor<256&&!b14 ) {
      escape_floor = 256;
      w[6] = 256;
    }
    if( sum>escape_floor&&kick<15 ) {
      kick = 15;
      b15 = kick;
    }
    return sum;
  }
};

#pragma pack(push, 1)
struct SymEntry {
  uint16_t sym;
  uint8_t cnt;
  void set(uint32_t s, uint32_t c) {
    sym = (uint16_t)s;
    cnt = (uint8_t)c;
  }
};
#pragma pack(pop)

struct SymList {
  uint32_t n;
  uint32_t live;
  uint32_t tot;
  uint32_t since_rescale;
  uint32_t rescale_at;
  SymEntry* ent;
  bool rescale(int32_t count) {
    int32_t last_cnt;
    uint32_t n_left, running, since, due = rescale_at;
    SymEntry *back;
    if( count<=251&&due>=since_rescale )
      return false;
    n_left = live;
    int32_t bias = due<20*n;
    SymEntry *cur = ent-1;
    SymEntry *prev = cur;
    do {
      prev = cur;
      ++cur;
      int32_t half = (bias+(uint32_t)cur->cnt)>>1;
      cur->cnt = half;
      if( cur!=ent ) {
        SymEntry *up = cur-1;
        int32_t up_cnt = up->cnt;
        if( half>up_cnt ) {
          uint16_t keep = cur->sym;
          cur->set(up->sym, up_cnt);
          if( up!=ent ) {
            do {
              back = up-1;
              int32_t back_cnt = back->cnt;
              if( half<=back_cnt )
                break;
              up->set(back->sym, back_cnt);
              --up;
            } while( back!=ent );
          }
          up->set(keep, half);
        }
      }
      --n_left;
    } while( n_left );
    running = tot;
    if( !cur->cnt ) {
      do {
        ++n_left;
        tot = ++running;
        last_cnt = prev->cnt;
        --prev;
      } while( !last_cnt );
      live -= n_left;
    }
    since = since_rescale;
    tot = halve_up(running);
    since_rescale = halve_up(since);
    return true;
  }

  // Move `p` up past every entry it now outranks, and return the count it
  // settles at -- which is what decides whether the list rescales.  A
  // move-to-front over a list kept in count order.
  //
  // An earlier round found this walk written out twice, here and in
  // `decode_symbol_list`, identical down to the `goto` back into the
  // `p == ent` arm that both used to leave the inner loop; four returns say the
  // same four exits and the label went with them.
  //
  // It was written out a *third* time, in the live branch of `add_weight`, and
  // that spelling hid it well enough to survive that round: it assigns a
  // `count` at four points where this returns, it reuses `p` for the trailing
  // cursor this calls `r`, and its terminal case reads `q->cnt` where this
  // reads `r->cnt` -- the same entry, because the `--q` between them made it
  // so.  Both early exits and both terminal cases were diffed before the two
  // were made one.
  //
  // What genuinely differs between the callers is the increment, 4 against
  // `add_weight`'s argument, and whether the answer is returned or handed to
  // `rescale`.  Both stay with the callers.
  int32_t move_up(SymEntry* p) {
    if( p==ent )
      return p->cnt;
    uint16_t s_a = p->sym;
    uint8_t c_a = p->cnt;
    SymEntry* q = p-1;
    *p = *q;
    q->set(s_a, c_a);
    if( q==ent )
      return q->cnt;
    while( 1 ) {
      int32_t top = q->cnt;
      SymEntry* r = q-1;
      if( top<=r->cnt )
        return top;
      uint16_t s_b = q->sym;
      uint8_t c_b = q->cnt;
      *q = *r;
      r->set(s_b, c_b);
      --q;
      if( r==ent )
        return r->cnt;
    }
  }

  int32_t promote(SymEntry* p) {
    p->cnt += 4;
    since_rescale += 4;
    return move_up(p);
  }

  int32_t code_symbol(int32_t want) {
    int32_t enc_cum, enc_high, enc_tot;
    int32_t c, c2;
    uint32_t i;
    int8_t gen = exclusion_gen;
    uint32_t left = live;
    SymEntry *p = ent-1;
    int32_t cum = 0;
    while( 1 ) {
      ++p;
      int32_t s = p->sym;
      if( exclusion_mask[s]!=exclusion_gen ) {
        c = p->cnt;
        cum += c;
        if( s==want )
          break;
      }
      // The last live symbol, which needs no code of its own: every other one
      // is excluded and the decoder can name it.  A guard with nothing after it
      // in the loop, so it says `continue` and the fourteen lines it held come
      // out a level.
      if( --left )
        continue;
      if( !cum )
        return 0;
      enc_cum = cum;
      enc_tot = tot+cum;
      enc_high = enc_tot;
      do {
        exclusion_mask[p->sym] = gen;
        --p;
      } while( p>=ent );
      // `result = 0;` and a braced block around the two lines below it, the
      // block being where the decompiler put a `goto`'s landing.  There is one
      // value and it is a literal.
      rc.encode(enc_cum, enc_high, enc_tot);
      return 0;
    }
    enc_high = cum;
    uint32_t rest = left-1;
    enc_cum = cum-c;
    if( rest ) {
      for( i = 0; i<rest; ++i ) {
        if( exclusion_mask[p[i+1].sym]==exclusion_gen )
          c2 = 0;
        else
          c2 = p[i+1].cnt;
        cum += c2;
      }
    }
    enc_tot = tot+cum;
    rescale(promote(p));
    rc.encode(enc_cum, enc_high, enc_tot);
    return 1;
  }

  void add_weight(int32_t want, uint32_t add) {
    int32_t recycled;
    SymEntry* list = ent;
    uint32_t n_live = live;
    SymEntry *p = list;
    // Find `want` among the live entries.  Running out of them is what "not in
    // the list" means, and an empty list is that same answer reached without a
    // step -- which is why the recovered walk jumped out of itself into the
    // empty-list arm's block rather than falling anywhere.
    uint32_t left = n_live;
    while( left&&p->sym!=want ) {
      ++p;
      --left;
    }
    if( left ) {
      p->cnt += add;
      since_rescale += add;
      // `head` was `ent` read back at three points across a walk that does not
      // move the list.  The walk is `move_up`.
      rescale(move_up(p));
      return;
    }
    // Not in the list, so it joins it -- over the least-counted entry when the
    // list is already `n` long, which is what the entry the walk left behind
    // is.  `full` was assigned the same comparison twice, once before the
    // length test and once inside it, with nothing between that moves either
    // side.
    const bool full = n_live==n;
    if( n_live>=n&&add<=1 )
      return;
    if( full ) {
      live = --n_live;
      recycled = list[n_live].cnt;
    } else {
      recycled = 1;
    }
    list += n_live;
    live = n_live+1;
    tot = recycled+tot+1;
    list->cnt = 2;
    list->sym = want;
    since_rescale += 4;
    if( list!=ent ) {
      uint16_t s3 = list->sym;
      uint8_t c3 = list->cnt;
      *list = list[-1];
      list[-1].set(s3, c3);
    }
  }
  void init(int32_t n_syms, int32_t dense) {
    uint32_t result;
    const uint32_t n_u = (uint32_t)n_syms;
    n = n_syms;
    SymEntry* buf = (SymEntry*)bmf_new(3*n_syms);
    ent = buf;
    if( dense ) {
      tot = 0;
      live = n_u;
      since_rescale = 12*n_u;
      rescale_at = 8*n_u;
      for( result = 0; result<live; ++result ) {
        ent[result].sym = result;
        ent[result].cnt = 1;
      }
    } else {
      tot = 2;
      rescale_at = 20*n_u;
      live = 0;
      since_rescale = 18*n_u;
      memset(buf, 0, 3*n_u);
    }
    return;
  }
  // The decode half of `code_symbol`, in `sym_list_decode.inc`.  It was a free
  // function taking the list as its first parameter until `uncopy.py` folded
  // an `owner = syms` alias away and left the parameter reaching nothing but
  // members, which is what `methodise.py` looks for.
  int32_t decode_symbol_list();
};

// Sixteen lists with nothing in them.  The two alphabet walks each open with
// this, and each wrote the loop over eight with the two halves of every pair
// spelled out -- one unrolling, not two different things.  Only `ent` is
// cleared: the rest of each list is written by `init` before anything reads
// it, and these sixteen live on the stack.
static inline void clear_sym_lists(SymList* lists) {
  for( int32_t k = 0; k<16; ++k )
    lists[k].ent = nullptr;
}

struct SymListBlock {
  uint32_t n;
  SymList list[0];
  static uint32_t bytes(uint32_t n) {
    return __builtin_offsetof(SymListBlock, list)+sizeof(SymList)*n;
  }
};

// One block of `n` empty symbol lists, or nothing if the allocation failed.
//
// Four copies -- two in `expand_alphabet`, two in `model_plane`'s allocation --
// eleven lines apiece, and the two pairs did not look alike: one pair walked
// the lists with a cursor and a countdown, `for( i = list_a; wt; --wt )
// (list_a++)->ent = nullptr;`, leaving the *cursor* in the variable the caller
// then reads, and the other indexed.  Both mean "clear them all", and the
// countdown pair also consumed the count it was given, which is why each of
// those two had to re-read `blk->alphabet` for the next one.
static SymList* new_sym_lists(uint32_t n) {
  SymListBlock* block = (SymListBlock*)bmf_new(SymListBlock::bytes(n));
  if( !block )
    return nullptr;
  block->n = n;
  for( uint32_t i = 0; i<n; ++i )
    block->list[i].ent = nullptr;
  return block->list;
}

static inline void free_sym_entries(SymList* list, uint32_t n) {
  while( n-- )
    free(list[n].ent);
}

// One 256-symbol list per byte position and carry, four to a byte.  The wide
// alphabet is coded a byte at a time with the carry out of the byte below
// choosing which of that position's four lists codes it, which is what the
// `4*k + carry` index says; both halves of the coder open with this loop.
static inline void init_byte_lists(SymList* list, uint32_t nbytes) {
  for( uint32_t k = 0; k<4*nbytes; ++k )
    list[k].init(256, 1);
}

static inline SymListBlock*sym_list_block(SymList* list) {
  return (SymListBlock*)((uint8_t*)list-__builtin_offsetof(SymListBlock, list));
}

static inline uint32_t sym_list_count(const SymList* list) {
  return sym_list_block((SymList*)list)->n;
}

static inline bool sym_in_top(const SymEntry* ent, int32_t n, int32_t sym) {
  while( n-- )
    if( ent[n].sym==sym )
      return true;
  return false;
}

// The decode half of `SymList::code_symbol`.  It was a file of its own,
// `sym_list_decode.inc`, included nine files further down -- and nothing made it
// one: it reaches `rc.decode` and `rc.get_freq` and otherwise only this class's
// own members, and `rc.inc` comes two includes *before* this file.  The split
// was the size and the frame, and the note below is what happened to both.
//
// It was carrying its own copies
// of two things that half already had as methods: the sort-up after a hit
// (`promote`, 25 lines) and the halving pass (`rescale`, 55).  Both are called
// here now, which is also what emptied the frame this used to run on.
//
// That frame was a `union` of the candidate array with a struct of eight spill
// slots, each 4-byte member padded out to a pointer so it sat over one entry
// of the array.  The two arms are a sequence rather than an overlap: the last
// read of the array is the exclusion walk in the escape branch, and the first
// spill write is the line after it.  Of the eight, one was the return value,
// five were the two shared methods' locals, one was a save/restore pair of a
// variable nothing else reads -- a register spill the decompiler kept with
// nothing behind it -- and one was never used at all.
inline int32_t SymList::decode_symbol_list() {
  // One pointer per symbol still in play, and a null terminator.
  //
  // `no_symbol+1` is the alphabet ceiling this program enforces, so this
  // cannot be overrun by any `SymList` it builds -- which the old `[8192]`
  // was one short of, and got away with because the eight bytes after it were
  // the frame's trailing pad.
  //
  // What reaches here is far narrower.  The three call sites pass lists built
  // by `init(256, 1)`, by `init(mask-n_syms+2, 1)` on a path where `mask` is
  // at most 255, and by `init(99, 0)` and `init(33, 0)`; so 257 is the bound,
  // and 257 is what an instrumented build measures as the high-water mark over
  // the corpus -- `live = 256` on a 256-symbol list, plus the terminator.  The
  // array is a plain local now, which is what would let ASan say so if that
  // stopped being true.
  //
  // It is still **64 KiB of stack per call** -- 8193 pointers -- against 257
  // that are ever written.  That is a deliberate keep, not an oversight: the
  // bound the array is declared with is the one the format enforces, while 257
  // is a fact about the three call sites, and sizing a buffer from the narrower
  // of the two is how the `[8192]` this replaced came to be one short.  Worth
  // stating because it is a per-call stack cost nothing else in the program
  // comes close to, and because the recursion depth here is one:
  // `decode_symbol_list` calls nothing that calls it back.
  SymEntry* list[no_symbol+1];
  SymEntry *q;
  SymEntry** w, ** rd, ** rd2;
  int32_t c;
  // `live`, `ent` and `tot` were copied into locals of the same name, which is
  // what the parameter form left behind and what made this a method's three
  // shadowed members.  The two counts are `uint32_t` here and were `int32_t`
  // there; the alphabet ceiling this file argues for above is 257, so the two
  // readings of every comparison below agree, and the casts say which one the
  // binary made.
  w = list;
  uint32_t gen = (uint8_t)exclusion_gen;
  int32_t cum = 0;
  // The candidates: every live symbol the encoder has not already offered and
  // had rejected, with their counts summed.
  for( int32_t i = 0; i<(int32_t)live; ++i ) {
    if( (uint8_t)exclusion_mask[ent[i].sym]==gen ) {
      c = 0;
    } else {
      SymEntry *e = &ent[i];
      c = e->cnt;
      *w++ = e;
    }
    cum += c;
  }
  if( !cum )
    return -1;
  *w = nullptr;
  // One total, which the frame spelled twice: `cum + tot` went into two slots
  // and the escape path read one while the hit path read the other.
  int32_t tot_all = cum+(int32_t)tot;
  int32_t target = rc.get_freq(tot_all);
  SymEntry *p = list[0];
  rd = &list[1];
  SymEntry *first = list[0];
  uint32_t cum_lo = 0;
  while( 1 ) {
    cum_lo += p->cnt;
    if( cum_lo>(uint32_t)target )
      break;
    p = *rd++;
    if( !p ) {
      // Past the last candidate: the escape.  Stamp every one of them with
      // this generation so the next list does not offer them again.
      int8_t gen_b = (int8_t)gen;
      q = first;
      rd2 = &list[1];
      do {
        exclusion_mask[q->sym] = gen_b;
        q = *rd2++;
      } while( q );
      rc.decode(cum_lo, tot_all, tot_all);
      return -1;
    }
  }
  // The interval, taken before `promote` moves the entry and changes its
  // count.  This order is the original's: the list is updated and only then is
  // the decode committed, which is why the two bounds and the total were three
  // of the frame's spill slots.
  int32_t result = p->sym;
  uint32_t sym_cum = cum_lo-p->cnt;
  this->rescale(this->promote(p));
  rc.decode(sym_cum, cum_lo, tot_all);
  return result;
}

// bitctr.inc -- the binary counters -- one context bit, coded and decoded, and the
// pair rescale behind them.

struct CounterNode {
  uint16_t total;
  uint16_t c[7];

  // Code one symbol against this node.  Defined out of line in sym_code.inc,
  // beside the tree coder it calls; `alt_p1_encode_symbol` and
  // `alt_p1_decode_symbol` are the two instantiations under their callers'
  // names.
  template<int32_t f_DEC> int32_t code_symbol(int32_t ctx, int32_t sym);

  // One counter bumped, with the node's total kept in step.  119 sites in
  // `alt_p1_block`'s `update_model` wrote both halves out, and the increment --
  // one of nine constants, 2 to 17 -- is what that function is *about*: which
  // counters a coded symbol moves, and by how much.
  //
  // The two halves have to move together, because the coder divides by the
  // total; a site that bumped one and not the other would be a defect no type
  // could catch.  As a method there is one place that can be wrong.
  void bump(int32_t slot, uint32_t n) {
    c[slot] += n;
    total += n;
  }

  // One bit of the escape's strip index: 0 when this slot holds at most half
  // the node's mass, **+64** when it holds more.
  //
  // The comment here read "-64 when it does not", and both halves of that were
  // wrong.  The arithmetic is unsigned -- `(uint32_t)c[slot]` makes it so --
  // so `2*c[slot] > (total&0x7FFF) + c[0]` *wraps* rather than going negative,
  // `>>25` is a logical shift giving 127 rather than a sign test giving -1,
  // and `&0xFFFFFFC0` clears the low six bits of 127 to leave 64.  The
  // condition is inverted as well: the wrap is the case where the slot is
  // *over* half, which the old sentence gave to the 0.
  //
  // The call sites settle it without needing the shift read at all.  Every one
  // of the four adds this to `ctx + 128*(slot&1)` and hands the sum to
  // `model_strip`, which indexes 1024 strips; -64 as a `uint32_t` is
  // 0xFFFFFFC0 and the sum would leave the table on the first escape whose
  // slot was over half.  One of them then tests `key & 0x38`, which reads bits
  // 3..5 of a small non-negative number.  It is a context bit, and it is set
  // high.
  //
  // So it is written as the comparison it is.  Every caller adds the 0-or-64
  // into a strip index where 64 is bit 6, so a `bool` under `bit<6>` is what
  // they want and the two spellings meet there.  `alt_p1_block` spelled the
  // shift out four times, twice reading `total` from a local holding the value
  // just stored into it.
  bool escape_high(int32_t slot) const {
    return 2u*c[slot]>(total&0x7FFFu)+c[0];
  }
};

// The tree slot a folded code takes: itself below 5, then slot 5 for odd codes
// and 6 for even ones.  Two independent spellings of one mapping --
// `CounterNode::code_symbol` writes it this way round and
// `AltP1Block::update_model` computes it twice, once per fold direction.
//
// `update_model` also re-read `fold[(uint8_t)(sym - pred)]` to get the low case
// rather than reusing the `code_f` it had just computed from the same
// expression.  Passing the code in removes that second table read.
static inline int32_t sym_slot(int32_t code) {
  return code<5 ? code : 6-(code&1);
}

struct SymPair {
  uint16_t last;
  uint16_t prev;
};

struct FreqPair {
  uint16_t f[2];
};

static inline FreqPair*bit_tree(uint16_t* freq, int32_t lvl) {
  return (FreqPair*)&freq[2*level_geom[lvl].tbl_base+8];
}

// One binary counter with a parent to fall back on, and a three-state life:
// unseen, seeded, live.  Read against `bcdr.cpp`'s `BIN_CODER`, which is the
// same counter with the same states written by hand -- the two agree line for
// line and only the constants differ, so the names below are that file's.
//
//   BIN_CODER::s[2]     n[2]        the two counts
//   BIN_CODER::MaxFreq  limit       the total at which they are halved
//   STEP = 10           kStep = 8   what a coded bit adds
//   scaleRare()         scale_rare()
//   initChild(bc)       seed_from(parent)
//   process(rc,bc,..)   code_context_bit<f_DEC>(parent, bit)
//
// The one structural difference is where the "seen once" mark lives.
// `BIN_CODER` marks itself unseeded with `MaxFreq == 0` and remembers the
// first bit in `s[1]`; this remembers it in `n[0]` as `bit + 1` and reads
// `n[1] == 0` as "not seeded yet".  Same machine, one slot over -- which is
// worth knowing, because `n[0]` is a *count* in the live state and a
// *remembered bit* before it, and nothing in the decompilation said so.
struct BitCtr {
  uint16_t n[2];
  uint16_t limit;

  // BIN_CODER's STEP, 8 here against its 10, and the same three uses: what a
  // coded bit adds, half of it as the seeding bump, and the ceiling below
  // which the parent is bumped too.
  static const uint32_t kStep = 8;
  static const uint32_t kSeedBump = 4;
  static const uint32_t kSeedLimit = 512;
  static const uint32_t kLimitStep = 64;
  static const uint32_t kMaxLimit = 0x4000;
  static const uint32_t kParentBump = 0x88;

  uint32_t summ() const {
    return n[0]+n[1];
  }

  // `BIN_CODER::initParent`: both sides at half a step, under a low ceiling,
  // so the first few bits move it a long way.  What `esc_ctr[0]` and every
  // `run_ctr[]` start as.
  void init_parent() {
    n[0] = n[1] = kStep/2;
    limit = 72;
  }

  // A root of the escape tree, which does not start even: 40 against 16 is
  // five to two toward "no", at the same ceiling `seed_from` hands a child.
  void init_root() {
    n[0] = 40;
    n[1] = 16;
    limit = kSeedLimit;
  }

  // And the third state has no initialiser at all: a counter is *unseen* when
  // it is all zeroes, which is why `bit_node[]` and `esc_ctr[1..]` are simply
  // memset.  bcdr does the same with `memset(BCdr2, 0, sizeof(BCdr2))`.

  // `BIN_CODER::scaleRare`.  Halve both counts and let the limit climb, so a
  // counter that keeps being right is allowed to get more confident before it
  // is cut back again.  `rescale_counter_pair` is this, called from the run
  // coder, and is now the same code rather than a second copy of it.
  int32_t scale_rare() {
    halve_counts(n, 2);
    if( limit<kMaxLimit )
      limit += kLimitStep;
    return limit;
  }

  // `BIN_CODER::initChild`.  A counter seen once takes its parent's shape
  // scaled to 64 -- `(64 * (parent - 1) + total) / total` on each side, which
  // is bcdr's formula with 32 -- bumps the side the first bit went, and takes
  // the parent's confidence down by 3 for having handed it over.
  void seed_from(BitCtr* parent) {
    const int32_t first = n[0]-1;
    const int32_t par0 = parent->n[0];
    const int32_t par_tot = par0+parent->n[1];
    n[0] = (par_tot+(par0<<6)-64)/par_tot;
    n[1] = ((parent->n[1]<<6)+par_tot-64)/par_tot;
    n[first] += kSeedBump;
    limit = kSeedLimit;
    const int32_t par_n = parent->n[first];
    parent->n[first] = par_n-3*(par_n>3);
  }

  // The two returns are not the same value and that is not a merge artefact:
  // the encoder returned the counter it had just bumped and the decoder
  // returns the bit.  Nothing reads the encoder's, both call sites drop it,
  // and it is kept anyway -- a merge is not the place to decide that a return
  // value is dead.
  template<int32_t f_DEC>
  int32_t code_context_bit(BitCtr* parent, int32_t bit) {
    int32_t result;
    if( n[0] ) {
      if( !n[1] )
        seed_from(parent);
      const uint32_t tot = summ();
      if constexpr( f_DEC )
        bit = rc.decode_bit(n[0], n[1]);
      else
        rc.encode_bit(n[0], n[1], bit);
      if( tot>limit )
        scale_rare();
      result = n[bit]+kStep;
      n[bit] = result;
      // `BIN_CODER`'s "kinda partial update": while this counter is still
      // cheap to be wrong about, the parent hears about the bit as well.
      parent->n[bit] += tot<kParentBump;
    } else {
      // Unseen.  The parent codes the bit, and this keeps it as `bit + 1` so
      // the next visit knows which side to bump when it seeds.
      const uint32_t p_tot = parent->summ();
      if constexpr( f_DEC )
        bit = rc.decode_bit(parent->n[0], parent->n[1]);
      else
        rc.encode_bit(parent->n[0], parent->n[1], bit);
      if( p_tot>parent->limit )
        parent->scale_rare();
      result = parent->n[bit]+kStep;
      parent->n[bit] = result;
      n[0] = bit+1;
    }
    return f_DEC ? bit : result;
  }

  int32_t encode_context_bit(BitCtr* parent, int32_t bit) {
    return code_context_bit<0>(parent, bit);
  }

  int32_t decode_context_bit(BitCtr* parent) {
    return code_context_bit<1>(parent, 0);
  }
};

CounterNode*init_counter_node(CounterNode* node) {
  node->c[0] = 8;
  node->c[1] = 2;
  node->c[2] = 2;
  node->c[3] = 2;
  node->c[4] = 2;
  node->c[5] = 3;
  node->c[6] = 3;
  node->total = 22;
  return node;
}

// alt_p1_block.inc -- the alternate model for predictor 1: its block, its context
// and its counters.  "p1" is `plane_predictor == 1` and says nothing about depth --
// measured, this codes t24's and t32's *eight-bit* planes.  MODELS.md section 6.

// The near-lossless drift control, and the whole of what makes these two
// models lossy.  Fold the residual between the source byte and the prediction
// into a symbol, reconstruct from it, and measure how far that pulls the byte
// already standing in the output buffer.  Past sixteen either way the
// approximation is refused: `*dst` takes the source byte unchanged and the
// symbol comes from the high fold instead.  Answers the symbol to code.
//
// Three copies -- the generic-depth arm of the p1 encoder and both of the p2
// encoder's -- and no two spelled it alike.  One wrote `*(fold[resid]+unfold)`
// for the inverse lookup, one indexed `fold_hi` with the residual recomputed
// from scratch rather than with the name three lines above it, and one took
// the drift before naming the symbol while the others did it after.
//
// It lives here, ahead of both blocks, because both call it; `unfold` is
// `uint8_t` in the p1 block and `int8_t` in the p2 one, which is what the
// template parameter is for.  The sum is narrowed to a byte either way, so the
// signedness cannot reach the output.
//
// The two `encode_sample` methods make a *different* decision that looks like
// this one, and the difference is worth stating: there the source byte and the
// buffer byte are the same byte, read twice around the context step, so the
// reconstruction they compare against is not this one.
template<class Unfold>
static inline uint8_t fold_or_refuse(uint8_t* dst, int32_t src, int32_t pred,
                                     const uint8_t* fold,
                                     const uint8_t* fold_hi,
                                     const Unfold* unfold) {
  const int32_t resid = (uint8_t)(src-pred);
  const uint8_t recon = unfold[fold[resid]]+pred;
  const int32_t drift = *dst-(uint8_t)(recon+*dst-src);
  if( drift<-16||drift>16 ) {
    *dst = (uint8_t)src;
    return fold_hi[resid];
  }
  *dst = recon;
  return fold[resid];
}

struct CtxWeight {
  int32_t sel;
  uint32_t w[3];
};

// The two ways a row of weights is summed into a context index.  Each weight is
// a table entry *pre-scaled* by its feature's stride, so what these return is a
// mixed-radix number whose digits were multiplied out at set-up -- which is why
// the result stays a sum and only the bits below it become fields.
//
// `mixer_fwd` reads every feature's live weight.  `mixer_rev` reads each one
// the other way round, `w[2 - sel]`, except slot 0, which reads `w[1]` in both
// directions.  That asymmetry is not an accident of one call site:
// `update_selector` takes the same pair as a parameter, and slot 0 names
// `w[0]`/`w[1]` there where the other eight name `w[1]`/`w[2 - sel]`.
//
// Four places spelled one of these out -- two nine-tap and two five-tap, two
// running up the row and two down it.  The terms are `uint32_t` and the sum is
// unsigned, so the direction was never load-bearing.
static inline uint32_t mixer_fwd(const CtxWeight* cw, int32_t n) {
  uint32_t sum = 0;
  for( int32_t k = 0; k<n; ++k )
    sum += cw[k].w[cw[k].sel];
  return sum;
}

static inline uint32_t mixer_rev(const CtxWeight* cw, int32_t n) {
  uint32_t sum = cw[0].w[1];
  for( int32_t k = 1; k<n; ++k )
    sum += cw[k].w[2-cw[k].sel];
  return sum;
}

// A signed value cut into three, with an optional dead zone: below `-dead` is
// 0, inside the band is 1, above `dead` is 2.  Seven of `ctx_of`'s nine
// selectors are this, and they arrived as seven interleaved copies of
// `!is_neg + (!is_neg && !is_zero)` -- five of them reusing two `bool` locals
// that the scheduler had woven through the other two.
//
// `dead == 0` collapses the two comparisons to `(v >= 0) + (v > 0)`, which is
// the plain sign, so the two variants are one function rather than two.
static inline int32_t tri_sign(int32_t v, int32_t dead = 0) {
  return (v>=-dead)+(v>dead);
}

struct P1Ctx {
  uint8_t sym;
  uint8_t mag;
};

// Two shapes `ctx_of` builds from a *neighbouring plane's* row, each of which
// it used in more than one of its three arms.
//
//   `cross_grad`  this plane's west-minus-prediction plus that plane's own
//                 gradient over its last two samples.
//   `nb_resid`    that plane's residual at the sample to the west.
static inline int32_t cross_grad(int32_t here, int32_t guess, const AltP1Block* nb);
static inline int32_t nb_resid(const AltP1Block* nb);

// As `AltP2Block`, one file over: the pool holds these by value so it cannot
// come before the class, and `alt_p1_free` gives one back from inside it.
struct AltP1Block;
static void p1_block_give(AltP1Block* p);

struct AltP1Block {
  // How far a cursor sits into its row, and how far past the last sample the
  // row-end mirror reaches.  Both are load-bearing and neither was written
  // down: `ring_advance(buf, cursor, 4)` put the 4 in a call argument, the 10
  // sat in the allocation, and the relationship between them -- that a row is
  // margin plus samples plus tail -- was nowhere.
  //
  // The margin is what makes `cur[-4]` defined.  Stage 2 Section 12.11 is
  // right that the negative subscripts are fine and that nothing said why;
  // this is the why.  The deepest subscript the p1 sources reach is exactly
  // -4, measured, and the tail is the six records `advance_row` mirrors past
  // the right edge.
  static const int32_t kRowMargin = 4;
  static const int32_t kRowTail = 6;

  int32_t width;
  int32_t height;
  int32_t pred;
  int32_t ctx[5];
  CtxWeight ctx_w[9];
  P1Ctx* buf[5];
  P1Ctx* cursor[5];
  uint8_t level_of[512];
  uint8_t slot_of[256];
  uint8_t fold[256];
  uint8_t fold_hi[256];
  uint8_t unfold[256];
  int32_t group_of[512];
  // 629856 = 8 levels * 2 flatness bits * 3^9 -- the activity level in the low
  // three bits, two flags over it, and nine ternary features above those,
  // which is what `mixer_fwd` sums into.  The loop that seeds it counted to
  // `0x99C60`, the same number in hex, so the two spellings had to be matched
  // by conversion to see they were one bound.
  static const int32_t kP1CounterCount = 629856;
  CounterNode counters[kP1CounterCount];
  // Start a row: mirror the last six records past the right edge, rotate the
  // five row buffers by one, reseat the five cursors, carry the last record of
  // the row above into the left margin, mirror three records back from it, and
  // rebuild the two activity sums the context reads.
  //
  // Twenty-five lines, written out three times -- here, in `alt_p1_code.inc`
  // and in `alt_p1.inc` -- because in the decompilation each of the three
  // callers had its own copy of the loop.
  //
  // The two activity sums that follow it are `seed_activity` below, which took
  // a parameter rather than a fourth copy: the three callers do not agree on
  // how two of the twenty magnitudes are read.  The question this comment used
  // to leave open -- whether that difference can ever show -- is answered
  // there, with the measurement.
  void advance_row() {
    {
      P1Ctx*const here = cursor[0];
      for( int32_t k = 0; k<6; ++k )
        here[k] = here[-1-k];
    }
    ring_advance(buf, cursor, kRowMargin);
    cursor[0][-4] = cursor[1][3];
    {
      P1Ctx*const here = cursor[0];
      P1Ctx*const up = cursor[1];
      for( int32_t i = 0; i<3; ++i ) here[-3+i] = up[2-i];
    }
  }

  // The two activity sums the context reads at the start of a row: ten
  // neighbour magnitudes each, taken from rows 2 and 4 -- even offsets for
  // `ctx[3]`, odd for `ctx[4]` -- plus two from the row being written.
  //
  // Three callers wrote this out, and the third is not quite the same as the
  // other two: the generic `alt_model_p1` reads the two *mirrored* magnitudes,
  // the ones `advance_row` copied back past the left edge, through `(int8_t)`
  // where `d8_body` and the decoder it now shares with read the `uint8_t`
  // they are declared.  `advance_row`'s comment left that difference standing
  // as a question about how large a residual magnitude gets.
  //
  // It is answered, and the answer is that the difference is exercised and
  // still does not show.  `mag` is `abs32(val - pred)` of two bytes, so it
  // reaches 255 and the two readings then differ by 256; instrumented over the
  // corpus, the generic coder runs this **18,224** times and **1,212** of those
  // calls read at least one `mag` at or above 128.  Dropping the casts moves no
  // stream even so, because these two sums are read in exactly one place --
  // `ctx[3 + ctx[2]] == 0` -- and are only ever tested against zero.
  //
  // Those two numbers said 3,216 and 70 for as long as the sentence existed,
  // and both were stale by more than 5x.  A measurement written into a comment
  // is a claim with a date on it and nothing here checks this one, which is the
  // same defect `pairshare.py` was built for one directory over; re-measured by
  // counting calls and operands over all nineteen images.  The conclusion is
  // unchanged and was never close -- the sums are compared against zero, so any
  // count above zero settles it identically.
  //
  // So the casts stay as the binary has them and the parameter says which
  // coder is asking, rather than one of the three being quietly changed to
  // agree with the other two.
  void seed_activity(bool signed_mirror) {
    const P1Ctx *const row0 = cursor[0], *const row2 = cursor[2],
                *const row4 = cursor[4];
    ctx[2] = 0;
    for( int32_t lane = 0; lane<2; ++lane ) {
      const int32_t mirror = lane-2;
      int32_t sum = signed_mirror
                  ? (int8_t)row2[mirror].mag+(int8_t)row4[mirror].mag
                  : row2[mirror].mag+row4[mirror].mag;
      for( int32_t k = 0; k<3; ++k )
        sum += row2[lane+2*k].mag+row4[lane+2*k].mag;
      ctx[3+lane] = sum+row0[lane-4].mag+row0[lane-2].mag;
    }
  }

  // Code one sample with the near-lossless drift control, and answer with the
  // value the model should record: fold the residual against the prediction,
  // reconstruct it, and if the reconstruction has drifted more than sixteen
  // from the byte already in the buffer, send the sample through `fold_hi`
  // instead and leave that byte alone.
  //
  // Four copies in `alt_model_p1`, one per plane, and the same shape as
  // `AltP2Block::encode_sample`.  One of the four carried the code under a
  // second name, `code1x`; one computed the drift inline and the byte it
  // compares against afterwards, as a `uint8_t` where the others used an
  // `int32_t` -- the store truncates either way.
  int32_t encode_sample(uint8_t* dst, int32_t at, int32_t cur) {
    const int32_t p = (uint8_t)pred;
    const int32_t resid = (uint8_t)(cur-p);
    int32_t code = fold[resid];
    const int32_t recon = (uint8_t)(unfold[code]+p);
    const int32_t out = (uint8_t)(recon+dst[at]-cur);
    if( dst[at]-out<-16||dst[at]-out>16 ) {
      code = fold_hi[resid];
    } else {
      cur = recon;
      dst[at] = out;
    }
    alt_p1_encode_symbol(&counters[ctx[0]], ctx[1], code);
    return cur;
  }

  // The decode half of `encode_sample`: take the symbol and unfold it against
  // the prediction.  Four copies in `alt_model_p1`, one per plane, and shorter
  // than the encode half by exactly the near-lossless drift control -- the
  // decoder is told which fold was used.
  int32_t decode_sample() {
    const int32_t code = alt_p1_decode_symbol(&counters[ctx[0]], ctx[1]);
    return (uint8_t)((uint8_t)pred+unfold[code]);
  }

  // Record one coded sample: store it and its residual magnitude, roll that
  // magnitude into the activity sum for this parity, flip the parity, let the
  // counter bank rescale if it has room, and step the five cursors.
  //
  // Six copies -- four in `alt_model_p1`, one in `d8_body`, one in
  // `alt_model_p1_d8_decode`.  Four wrote the activity update as
  // `- (a - b) - (c - d)` and two as `- (a - b + c - d)`, which is the same
  // sum; one hoisted `ctx[0]` into a local across the parity flip, which does
  // not touch it.
  void record_sample(int32_t val) {
    cursor[0]->sym = val;
    cursor[0]->mag = abs32(val-pred);
    ctx[3+ctx[2]] += cursor[0]->mag-cursor[0][-4].mag
                    -(cursor[4][-2].mag-cursor[4][6].mag)
                    -(cursor[2][-2].mag-cursor[2][6].mag);
    ctx[2] = ctx[2]==0;
    if( counters[ctx[0]].total<0x4000u )
      update_model();
    for( int32_t k = 0; k<5; ++k )
      ++cursor[k];
  }

  int32_t ctx_of(AltP1Block* nb0, AltP1Block* nb1) {
    bool pick;
    int32_t act_all;
    uint32_t quiet;
    P1Ctx *cursor1 = cursor[1];
    int32_t guess = cursor1->sym;
    P1Ctx *cur = cursor[0];
    int32_t west = cur[-1].sym;
    int32_t northwest = cursor1[-1].sym;
    if( west<guess ) {
      if( northwest>=west ) {
        int32_t plane_b = guess+west-northwest;
        pick = northwest<guess;
        guess = cur[-1].sym;
        if( pick )
          guess = plane_b;
      }
    } else if( northwest<=west ) {
      int32_t plane_a = guess+west-northwest;
      pick = northwest<=guess;
      guess = cur[-1].sym;
      if( !pick )
        guess = plane_a;
    }
    pred = guess;
    P1Ctx *cursor2 = cursor[2];
    int32_t act = cursor1[-1].mag+cur[-3].mag+3*(cursor1[1].mag+cursor2->mag)+6*cur[-1].mag+4*(cursor1->mag+cur[-2].mag)+2*(cursor2[2].mag+cursor1[2].mag+cur[-4].mag);
    // The five selectors below this point are the ones that depend on how many
    // *other planes* this one has to look at -- two, one, or none.  The three
    // arms are genuinely three formulas and not one formula three times, but
    // four shapes recur across them and are named here rather than spelled out
    // seven times between them.
    //
    // `west_grad` and `north_grad` are computed unconditionally: both are pure
    // reads of this plane's own row, and each appeared in two of the three
    // arms.
    const int32_t west_grad = 2*cur[-1].sym-cur[-2].sym-(uint32_t)guess;
    const int32_t north_grad = -guess-cursor1->sym+cursor1[1].sym+cur[-1].sym;
    if( nb0 ) {
      const P1Ctx* r0 = nb0->cursor[0];
      if( nb1 ) {
        const P1Ctx* r1 = nb1->cursor[0];
        act_all = act+2*(r1[-1].mag+r0[-1].mag);
        ctx_w[5].sel = cursor1->sym-(uint32_t)guess+r0[-1].sym-nb0->cursor[1][-1].sym;
        ctx_w[6].sel = cross_grad(cur[-1].sym, guess, nb0);
        ctx_w[7].sel = cross_grad(cur[-1].sym, guess, nb1);
        ctx_w[8].sel = nb_resid(nb1);
        ctx_w[3].sel = nb_resid(nb0);
        quiet = (r1[-1].mag+r0[-1].mag<16);
      } else {
        act_all = cursor1[3].mag+act+3*r0[-1].mag;
        ctx_w[5].sel = west_grad;
        ctx_w[6].sel = west_grad;
        ctx_w[7].sel = north_grad;
        ctx_w[8].sel = cross_grad(cur[-1].sym, guess, nb0);
        ctx_w[3].sel = nb_resid(nb0);
        quiet = (r0[-1].mag<8);
      }
    } else {
      P1Ctx *cursor4 = cursor[4];
      act_all = cursor4->mag+cursor2[-2].mag+cursor1[3].mag+act+cursor4[2].mag;
      ctx_w[5].sel = west_grad;
      ctx_w[6].sel = 2*cursor1->sym-cursor2->sym-(uint32_t)guess;
      ctx_w[7].sel = north_grad;
      ctx_w[8].sel = -3*(cur[-2].sym-cur[-1].sym)+cur[-3].sym-(uint32_t)guess;
      ctx_w[3].sel = cursor1[2].sym-(uint32_t)guess;
      quiet = cur->mag+cursor4->mag+cursor[3]->mag+cursor2->mag+cursor1->mag==0;
    }
    int32_t act_q = (act_all+7)>>4;
    int32_t act_lvl = level_of[act_q];
    int32_t step = p1_level_step[(uint32_t)act_lvl];
    ctx[0] = act_lvl;
    ctx[1] = group_of[act_q]+slot_of[(uint32_t)guess];
    // The same expression twice in the decompilation, once into the slot and
    // Nine selectors, each written over the value the arms above left in it or
    // computed fresh from the row.  Seven are `tri_sign`; slot 0 is a pair of
    // fixed thresholds on the prediction rather than a sign, and slots 4 and 5
    // carry `step` as their dead zone.
    //
    // The decompilation had these interleaved -- slot 4 computed between slot
    // 3's two `bool`s and slot 3's own result, slots 6 and 7 splitting their
    // halves across the next slot's reads -- and carried a second copy of each
    // value in `s0..s8` because `ctx_w[N].sel` is read again below.  Nothing
    // here reads another slot, so the schedule was the register allocator's and
    // the `sN` are the slots themselves.
    ctx_w[0].sel = (guess>216)+(guess>22);
    ctx_w[1].sel = tri_sign(cursor1[-1].sym-cursor1->sym);
    ctx_w[2].sel = tri_sign(cursor1[-1].sym-cur[-1].sym);
    ctx_w[3].sel = tri_sign(ctx_w[3].sel);
    ctx_w[4].sel = tri_sign(cursor1[1].sym-guess, step);
    ctx_w[5].sel = tri_sign(ctx_w[5].sel, step);
    // The last three are the same line three times, which is what naming the
    // shape made visible: `reroll.py` found the run the moment `tri_sign`
    // existed.  Slot 3 is the fourth of them and stays in place, because moving
    // it up here to make the run four long would put it after slots 4 and 5 for
    // no reason but the loop's convenience.
    for( int32_t k = 6; k<=8; ++k )
      ctx_w[k].sel = tri_sign(ctx_w[k].sel);
    // The activity level in the low three bits, two flatness flags over it, and
    // the nine ternary features above bit 5.
    //
    // `act_lvl` is `level_of[]`, which `alt_p1_alloc` fills by walking the
    // seven edges of `p1_level_edges` -- so eight levels, three bits, and the
    // width is a fact about that table rather than a guess.  `quiet` is a
    // comparison at all three of the places that set it, and the other flag is
    // the one bit that survives the two activity sums of `seed_activity`.
    //
    // The nine weights stay a sum and cannot be anything else: `CtxWeight::w`
    // holds each feature's three values *pre-scaled* to `32 * 3^k`, so the
    // stride lives in the table and what is written here is nine lookups added.
    // That is a mixed-radix number whose digits were multiplied out at set-up,
    // which `digit<>` cannot say and `raw` can -- see `mixer_fwd`.
    int32_t result = CtxIdx{}.bits<0, 3>(act_lvl)
                             .bit<3>(ctx[3+ctx[2]]==0)
                             .bit<4>(quiet)
                             .raw(mixer_fwd(ctx_w, 9));
    ctx[0] = result;
    return result;
  }

  // One plane of an eight-bit image, in whichever direction the caller is
  // going.  The mirror of `AltP2Block::alt_p2_d8_body`, and merged for the
  // same reason: the row walk, the row seed and the per-sample context are one
  // skeleton and only the middle three lines differ.
  //
  // The encode half was a method here and the decode half was written out
  // inside `alt_model_p1_d8_decode` in `alt_p1.inc`, which is why
  // `pairshare.py` measured that pair at 3 shared lines of 34: it was
  // comparing a four-line wrapper against a twenty-six-line one, and the
  // twenty-two lines they really share were on the wrong side of a call.
  //
  // The decoder walked its rows with `y < height` signed where the encoder
  // cast both to `uint32_t`.  `height` is `int32_t` and the `if` above has
  // already established it is positive, so the two readings agree; the
  // encoder's is kept.
  template<int32_t f_DEC>
  void d8_body(uint8_t* src, uint8_t* out) {
    if constexpr( f_DEC )
      rc_begin_decode();
    else
      rc_begin_encode();
    // The same bare block as `alt_model_p1`'s, around the same loop.
    for( int32_t y = 0; y<height; ++y ) {
      advance_row();
      seed_activity(false);
      {
        uint8_t* q = out;
        for( int32_t x = 0; x<width; ++x ) {
          ctx_of(nullptr, nullptr);
          if constexpr( f_DEC ) {
            const int32_t code = alt_p1_decode_symbol(&counters[ctx[0]],
                                                      ctx[1]);
            *q = (uint8_t)((uint8_t)pred+unfold[(uint8_t)code]);
          } else {
            const int32_t code = fold_or_refuse(q, *src, (uint8_t)pred, fold,
                                                fold_hi, unfold);
            alt_p1_encode_symbol(&counters[ctx[0]], ctx[1], code);
            ++src;
          }
          record_sample((uint8_t)*q);
          ++q;
        }
        out = q;
      }
    }
    if constexpr( f_DEC )
      rc_end_decode();
    else
      rc_end_encode();
  }

  // One selector's counters, and there are nine of them -- `ctx_w[0]` through
  // `ctx_w[8]`.  The decompilation wrote all nine out, which is why
  // `update_model` was 406 lines: about 360 of them are these forty, nine
  // times over, differing only in which `ctx_w` they read and which locals
  // they spelled the intermediate values into.
  //
  // `sel` names which of the three weights is the live one.  At `sel == 1` the
  // update walks the other two symmetrically.  Otherwise it walks three
  // counters: the opposite weight, the middle one, and an alternate context
  // built from two of the three -- and *which* two is the one thing across the
  // nine that is not uniform.  Slot 0 names `w[0]` and `w[1]` where the other
  // eight name `w[1]` and `w[2-sel]`.
  //
  // That is the same one-weight shift `ctx_alt` shows: its slot-0 term reads
  // `w[1]` where every other term reads `w[2-sel]`.  So the pair is a
  // parameter, not a special case invented to make the loop close.
  void update_selector(int32_t k, int32_t slot_f, int32_t slot_r,
                       uint32_t ctx_alt, int32_t alt_lo, int32_t alt_hi) {
    const CtxWeight& cw = ctx_w[k];
    const int32_t sel = cw.sel;
    // Every block re-read `ctx[0]` after each pair of bumps, into a local of
    // its own -- `ctx0`, `ctx1`, ... `ctx8`, which is where those names came
    // from.  Nothing here writes `ctx`; the re-reads are MSVC spilling a
    // register, and the ninth of them was the value the function returned.
    const int32_t here = ctx[0];
    if( sel==1 ) {
      int32_t mid = here-cw.w[1];
      CounterNode *lo = &counters[mid+cw.w[0]];
      CounterNode *hi = &counters[cw.w[2]+mid];
      lo[0].bump(slot_f, 6);
      hi[0].bump(slot_f, 6);
      if( (here&7)!=7 ) {
        lo[1].bump(slot_f, 4);
        hi[1].bump(slot_f, 4);
      }
      if( here&7 ) {
        lo[-1].bump(slot_f, 3);
        hi[-1].bump(slot_f, 3);
      }
    } else {
      counters[cw.w[2-sel]+here-cw.w[sel]].bump(slot_f, 7);
      CounterNode *mid = &counters[cw.w[1]+here-cw.w[sel]];
      CounterNode *alt = &counters[ctx_alt+cw.w[alt_lo]-cw.w[alt_hi]];
      mid[0].bump(slot_f, 6);
      alt[0].bump(slot_r, 4);
      if( (here&7)!=7 ) {
        mid[1].bump(slot_f, 4);
        alt[1].bump(slot_r, 2);
      }
      if( here&7 ) {
        mid[-1].bump(slot_f, 3);
        alt[-1].bump(slot_r, 2);
      }
    }
  }

  // Returned `ctx[0]` -- or, if the ninth selector's last branch ran, a counter
  // it had just bumped.  All five call sites discard it.
  void update_model() {
    // `*(index + fold)` twice, which is `fold[index]`: the pointer addition
    // was the decompiler's, and the wraparound cast on the *index* is semantic
    // and stays.
    const uint32_t code_f = fold[(uint8_t)(cursor[0]->sym-(uint8_t)pred)];
    const int32_t code_r = fold[(uint8_t)((uint8_t)pred-cursor[0]->sym)];
    const int32_t tree_sym = (int32_t)(code_f-5)>>1;
    const int32_t slot_f = sym_slot(code_f);
    const int32_t slot_r = sym_slot(code_r);
    // `ctx_w[1].sel` and `ctx_w[2].sel` were read into `sel1_top`/`sel2_top`
    // eight lines above this sum, which made two of its nine terms look unlike
    // The alternate context: the low five bits of the live one -- the activity
    // level and the two flatness flags of `ctx_of`, kept -- with all nine
    // features read the other way round above them.  `&0x1F` is that field, and
    // saying so is what makes the boundary between "kept" and "mirrored"
    // visible; `AltP2Block` builds its own the same way over five features and
    // six bits.
    uint32_t ctx_alt = CtxIdx{}.bits<0, 5>(ctx[0]).raw(mixer_rev(ctx_w, 9));
    CounterNode *node_alt = &counters[ctx_alt];
    node_alt[0].bump(slot_r, 17);
    const int32_t result = ctx[0];
    if( (result&7)!=7 ) {
      CounterNode *node_up = &counters[result];
      uint32_t ctx_up = ((ctx[1]&7)<7)+ctx[1];
      node_up[1].bump(slot_f, 11);
      if( slot_f>=5 )
        update_binary_pair(model_strip(CtxIdx{}.bit<7>(slot_f&1)
                                              .bit<6>(node_up[1].escape_high(slot_f))
                                              .raw(ctx_up)),
                           (int32_t)(code_f-5)>>1);
    }
    if( result&7 ) {
      CounterNode *node_dn = &counters[result];
      int32_t ctx_dn = ctx[1]-((ctx[1]&7)!=0);
      node_dn[-1].bump(slot_f, 13);
      if( slot_f>=5 )
        update_binary_pair(model_strip(CtxIdx{}.bit<7>(slot_f&1)
                                              .bit<6>(node_dn[-1].escape_high(slot_f))
                                              .raw(ctx_dn)),
                           tree_sym);
    }
    // A counter that has seen enough does not get its neighbours nudged --
    // a guard with nothing after it, holding twenty-four lines.
    if( counters[result].total>=kCounterNudgeLimit )
      return;
    if( (result&7u)<7 ) {
      node_alt[1].bump(slot_r, 7);
    }
    if( result&7 ) {
      node_alt[-1].bump(slot_r, 5);
    }
    if( slot_f>=5 ) {
      // `key + 8` and `key - 8`: the two strips one context step either side
      // of this one, the same "train the neighbours" the other two arms do.
      // The first was written out longhand as
      // `128*(slot_f&1) + ctx[1] + bias + 8`, which is `key` re-derived three
      // terms at a time beside the `key` on the line above it.
      const uint32_t key = CtxIdx{}.bit<7>(slot_f&1)
                                   .bit<6>(counters[result].escape_high(slot_f))
                                   .raw(ctx[1]);
      if( (key&0x38)>=0x38||(update_binary_pair(model_strip(key+8), tree_sym), (key&0x38)!=0) ) {
        update_binary_pair(model_strip(key-8), tree_sym);
      }
    }
    // The nine selectors.  `update_selector` is what the decompilation
    // wrote out nine times.
    update_selector(0, slot_f, slot_r, ctx_alt, 0, 1);
    for( int32_t k = 1; k<9; ++k )
      update_selector(k, slot_f, slot_r, ctx_alt, 1, 2-ctx_w[k].sel);
  }

  AltP1Block*alt_p1_alloc(int32_t img_w, int32_t img_h, int32_t plane) {
    uint32_t ctr = 0;
    width = img_w;
    height = img_h;
    do
      init_counter_node(&counters[ctr++]);
    while( ctr<kP1CounterCount );
    pred = 0;
    int32_t lvl = 0;
    int32_t grp = 0;
    int32_t k = 0;
    // `group_of` and `slot_of` are the two halves of the strip index `ctx[1]`,
    // and they are built to sit beside each other without overlapping:
    //
    //   bits 0..2   the activity group, 0..7 -- `p1_group_edges` has seven
    //               live entries, so eight groups
    //   bits 3..5   the predicted-value slot, the same shape over
    //               `p1_slot_edges`, which is why `slot_of` holds `8 * slot`
    //   bit  6      whether the escaping node's slot holds over half its mass
    //   bit  7      the escape's parity
    //   bits 8+     the plane
    //
    // The two coding sites supply bits 6 and 7; these two loops supply the
    // rest.  Bits 3..5 being the slot is what `key & 0x38` reads in
    // `update_model`, and why the `key +- 8` there steps that field by one.
    //
    // The plane was hoisted into `plane_hi = plane << 8` and then written
    // `plane_hi | grp` on one line and `grp1 | plane_hi` on the next -- the
    // same value, twice, in two orders.
    for( k = 0; k<0x100; ++k ) {
      level_of[2*k] = lvl;
      const int32_t lvl1 = (2*k==p1_level_edges[lvl])+lvl;
      group_of[2*k] = CtxIdx{}.above<8>(plane).bits<0, 3>(grp);
      level_of[2*k+1] = lvl1;
      const int32_t odd = 2*k+1;
      const int32_t grp1 = (2*k==p1_group_edges[grp])+grp;
      lvl = (odd==p1_level_edges[lvl1])+lvl1;
      group_of[2*k+1] = CtxIdx{}.above<8>(plane).bits<0, 3>(grp1);
      grp = (odd==p1_group_edges[grp1])+grp1;
    }
    // The same walk `alt_p2_block` makes over its own edge table, and it was
    // spelled the same way: `2*pair+++1`, a post-increment inside the
    // comparison that decides the next slot, with the answer parked in a
    // `bump` the next line adds.
    int32_t slot = 0;
    for( uint32_t pair = 0; pair<0x80; ++pair ) {
      slot_of[2*pair] = CtxIdx{}.above<3>(slot);
      const int32_t slot1 = (2*pair==p1_slot_edges[slot])+slot;
      slot_of[2*pair+1] = CtxIdx{}.above<3>(slot1);
      slot = (2*pair+1==p1_slot_edges[slot1])+slot1;
    }
    // The nine weights `alt_p1_context` sums, one per selector.  This was
    // twenty-seven assignments in scheduler order with `uint32_t row = 0;`
    // dropped into the middle of them, and none of the three sequences was
    // readable through the interleaving: the middle weight triples from one
    // context to the next, the top weight is twice the middle, and the bottom
    // weight is zero.  The numbers 32 .. 419904 are that formula run out.
    for( int32_t c = 0, w1 = 32; c<9; ++c, w1 *= 3 ) {
      ctx_w[c].w[0] = 0;
      ctx_w[c].w[1] = w1;
      ctx_w[c].w[2] = 2*w1;
    }
    // The ring points into the block's own storage.  A row is at most
    // `kMaxWidth + kRowMargin + kRowTail` records however wide the image is,
    // and `ring_advance` only ever permutes these five pointers -- so the
    // rotation still works and there is nothing to free.
    for( int32_t row = 0; row<5; ++row )
      buf[row] = row_store[row];
    alt_init_tables(fold, (int8_t*)unfold);
    // `width + 10` is never negative, so the `> -10` guard the `do` needed is
    // gone with it, and `wid = width` inside the body was a member re-read.
    for( int32_t r = 0; r<width+10; ++r ) {
      for( int32_t i = 0; i<5; ++i ) buf[4-i][r].sym = 72;
      for( int32_t i = 0; i<5; ++i ) buf[4-i][r].mag = 0;
    }
    for( int32_t i = 0; i<5; ++i ) cursor[i] = buf[i]+width+4;
    return this;
  }

  // Returns nothing.  The original returned `this` -- a compiler's habit of
  // leaving the object pointer in the return register, not a value anyone
  // wanted -- and after the `free(this)` above it is a dangling pointer that
  // g++ reports under `-Wuse-after-free`.  All three call sites discarded it;
  // the one that did not, `alt_model_p1_d8_decode`, only passed it on to
  // another caller that did.
  void alt_p1_free() {
    p1_block_give(this);
  }

  // The five rows the ring above points into.  Last in the struct so that no
  // member's offset moves: what the ring holds is five pointers, and where they
  // point is not something any of this program's layout contracts is about.
  //
  // 2 bytes to the record and 65545 records to the row, so 655 KB for the five
  // -- against five `bmf_new` calls and five `free`s per plane, four planes
  // deep.  A row's size is `kMaxWidth` and not the image's, which is the trade:
  // a 16-pixel-wide image now carries the same rows a 65535-pixel one does.
  P1Ctx row_store[5][kMaxWidth+kRowMargin+kRowTail];
};

// The four blocks this model can have live at once.  `alt_model_p1` allocates
// one per plane and `plane_count` is at most 4; instrumented over the corpus
// both directions the high-water mark is 4, reached by `t32` and `med32`.
//
// **Not zeroed, and that was measured rather than assumed.**  `bmf_new` handed
// back whatever malloc had, so a block arrived uninitialised and
// `alt_p1_alloc` is what makes it a block.  A pool hands back a *reused* slot
// instead, which is a different kind of garbage -- so the question is whether
// anything reads a byte `alt_p1_alloc` does not write.  Filling every slot with
// 0xA5 on take leaves all 111 checks passing, and so does filling it with zero,
// which says nothing is read before it is written and the choice does not
// matter.  It is left not-zeroing because that is what `bmf_new` did.
//
// 9.61 MB apiece, 38.5 MB of `.bss` -- the largest single thing in this
// program's image, and the reason the out-of-memory ladder in `test.sh` starts
// where it does.
static BlockPool<AltP1Block, 4> p1_blocks;

static AltP1Block* p1_block_take() {
  return p1_blocks.take(false);
}

static void p1_block_give(AltP1Block* p) {
  p1_blocks.give(p);
}

static inline int32_t cross_grad(int32_t here, int32_t guess, const AltP1Block* nb) {
  const P1Ctx* r = nb->cursor[0];
  return here-(uint32_t)guess+r[-1].sym-r[-2].sym;
}

static inline int32_t nb_resid(const AltP1Block* nb) {
  return nb->cursor[0][-1].sym-nb->pred;
}

// alt_p2_block.inc -- the alternate model for predictor 2: its counters, its frequency
// records and the block they live in.

struct P2Count {
  int8_t rate;
  uint8_t b1;
  int16_t weighted;
};

struct P2Freq {
  uint16_t step;
  uint16_t f[3];
  uint32_t rescale_three_way() {
    // `cut` is read before the halving because the halving consumes it:
    // `f[2] -= f[2] >> 1` is `f[2] -= cut`.  It is also the return value on the
    // branch below that does not overwrite it.
    uint32_t cut = f[2]>>1;
    halve_counts(f, 3);
    uint32_t budget = step;
    if( budget<=0x100 ) {
      // `((16 - budget) >> 30) & 0xFFFFFFFE` on the guarded range, which is a
      // decompiled branchless select and not an idiom: the unsigned wrap makes
      // `16 - budget` reach 2^30 exactly when `budget > 16`, the shift turns
      // that into 3, and the mask into 2.  Below 17 it is 0.
      if( step<=0x20u )
        cut = budget>16 ? 2 : 0;
      else
        cut = 32;
      step = budget-cut;
    } else {
      step >>= 1;
    }
    return cut;
  }

  // One symbol of the deep model's three-way counter, and then the tree.  The
  // encoder is handed a symbol and picks the slot it names; the decoder is
  // handed a point in the range and finds the slot containing it.  They agree
  // on `idx = slot - base`, which is what makes the tail one piece of code:
  // slot 0 is the symbol, and slots 1 and 2 escape into the level tree with
  // `idx & 1` choosing the context and `idx` the parity of what comes back.
  //
  // The encoder said `ctx_pair[sym & 1]` and `(sym - 1) >> 1` where this says
  // `ctx_pair[idx & 1]`; they are the same, because `idx` is 1 for odd symbols
  // and 2 for even ones above zero.
  //
  // Named apart from `SymList::code_symbol`, which is a different coder in a
  // different model.  Two methods with one name is not an error the compiler
  // can see, and it made `unstale.py` measure the wrong one.
  template<int32_t f_DEC>
  int32_t code_three_way(const uint32_t* ctx_pair, int32_t sym) {
    uint32_t cum;
    uint16_t st, *slot;
    uint16_t down;
    uint16_t *base = &f[0];
    int32_t c01 = f[1]+f[0];
    uint32_t tot = c01+f[2];
    if constexpr( f_DEC ) {
      int32_t target = rc.get_freq(tot);
      cum = f[0];
      if( (uint32_t)target>=cum ) {
        if( target>=c01 ) {
          cum = c01;
          slot = &f[2];
        } else {
          slot = &f[1];
        }
      } else {
        cum = 0;
        slot = &f[0];
      }
    } else {
      cum = c01;
      if( sym ) {
        if( sym&1 ) {
          cum = f[0];
          slot = &f[1];
        } else {
          slot = &f[2];
        }
      } else {
        cum = 0;
        slot = &f[0];
      }
    }
    uint32_t tot_1 = cum+*slot;
    if constexpr( f_DEC )
      rc.decode(cum, tot_1, tot);
    else
      rc.encode(cum, tot_1, tot);
    uint16_t f_before = *slot;
    if( *slot>0x4000u ) {
      halve_counts(f, 3);
      st = step;
      if( st<=256 ) {
        // The same branchless select as `rescale_three_way`'s.
        if( st<=32 )
          down = st>16 ? 2 : 0;
        else
          down = 32;
        st = st-down;
        step = st;
        f_before = *slot;
      } else {
        st = (uint32_t)st>>1;
        step = st;
        f_before = *slot;
      }
    } else {
      st = step;
    }
    *slot = st+f_before;
    int32_t idx = slot-base;
    if( idx )
      return idx+2*code_symbol_tree<f_DEC>(model_strip(ctx_pair[idx&1]), (sym-1)>>1);
    return 0;
  }

  void encode_symbol(const uint32_t* ctx_pair, int32_t sym) {
    code_three_way<0>(ctx_pair, sym);
  }

  int32_t decode_symbol(const uint32_t* ctx_pair) {
    return code_three_way<1>(ctx_pair, 0);
  }
};

// A rounding arithmetic shift right, and the two `&31` masks it was written
// with are dead.
//
// `rate` is `P2Count::rate`.  `alt_p2_alloc` seeds every one of the 163,840
// counters to 5, and exactly one other line writes it -- `code_banks`'s
// `node0->rate = b0n` -- which only fires while `(uint8_t)rate < 8`.  So
// `rate` is in [5, 8] always, and on that range `(rate+31)&31` is `rate-1` and
// `rate&31` is `rate`.
//
// Not mmax's `uint32_t{1u} << ...`: that makes the whole expression unsigned and
// turns the arithmetic shift into a logical one.  `weighted` is `int16_t`-stored
// and routinely negative, so it would change the prediction.  The shift count is
// 4..7 and never 31, so the UB that fix is aimed at is unreachable.
static inline int32_t p2_pred(int32_t weighted, int32_t rate) {
  BMF_ASSUME(rate>=5&&rate<=8);
  return (weighted+(1<<(rate-1)))>>rate;
}

static inline int16_t p2_bump(int32_t w2, int32_t err, int32_t shift) {
  // `1u << (shift - 1)` is the rounding term, and the shift is 1, 2 or 3:
  // every caller is `p2_update`, `p2_update_into` or `p2_nudge`, and between
  // them they pass 1 once, 2 four times and 3 eight, plus three `p2_nudge`
  // calls taking the default 2.  Nothing here bounds it, which is what the
  // assert is for -- a comment saying "and this cannot happen because" that
  // can be run.
  //
  // It was written `>= 2` first, on the plan's word that the shift is 2 or 3,
  // and the `BMF_ASSERTS` leg failed 15 checks on the spot.  The 1 is real and
  // it is *new*: unfolding `code_banks`'s comma chain into statements turned an
  // expression that spelled its own `+1` and `>>1` into `p2_update(p, res, 1)`.
  // An invariant taken from a document rather than from the callers, checked by
  // a leg that runs.
  BMF_ASSUME(shift>=1&&shift<=3);
  const uint32_t kick = 32u*(uint32_t)((err>deadzone_hi)-(err<deadzone_lo));
  return (int16_t)((uint32_t)w2+((kick+(uint32_t)err+(1u<<(shift-1)))>>shift));
}

// One counter update: predict from the weight, bump it by how wrong that was.
// All but two of `alt_p2_model`'s 118 `p2_bump` sites are this; the two that
// are not sit inside the comma expression of an `if`, where the update's own
// result decides the branch and a call cannot say it.
//
// Eight of them read the rate as `*(uint8_t*)&p->rate`, and `rate` is
// `int8_t` -- so they took the byte unsigned where this takes it signed.  That
// is the same value here and only here: `p2_pred` uses the rate as two shift
// counts and masks both with `&31`, and the two readings differ by 256, which
// is a multiple of 32.
static inline void p2_update(P2Count* p, int32_t res, int32_t shift) {
  const int32_t w = p->weighted;
  p->weighted = p2_bump(w, res-p2_pred(w, p->rate), shift);
}

// The same step with the residual kept.  `p2_update` cannot be used at the two
// sites this replaces: they subtract the bank's prediction *into* the caller's
// residual, which the caller reads again below, so a helper taking it by value
// would drop that write.  Both spelled it out with a temporary of their own,
// `wm0400z` and `wm0400x`.
static inline void p2_update_into(P2Count* p, int32_t& res, int32_t shift) {
  const int32_t w = p->weighted;
  res -= p2_pred(w, p->rate);
  p->weighted = p2_bump(w, res, shift);
}

// The rescale on its own.  Two of `alt_p2_model`'s fifty sites compute the
// increment and then add it *conditionally*, so the add cannot move into the
// helper; the guard still can.
static inline void p2_rescale(P2Freq* r) {
  if( r->f[0]+r->f[1]+r->f[2]>kP2FreqRescaleTotal )
    r->rescale_three_way();
}

// One count of a three-way record, bumped by `num` sixteenths of the record's
// step, with the rescale that keeps the three counts from overflowing.  35 of
// the 41 sites in `alt_p2_model` wrote both steps out.
//
// It takes the numerator rather than the increment because `rescale_three_way`
// steps `step` down as well as halving the counts, and the bump reads `step`
// *after* it.  Passing a computed increment would read it before.
//
// The increments in the file are 2, 3, 4, 5, 6, 7, 10 and 13 sixteenths and
// nothing else, which is only visible once they are written as sixteenths:
// `(step&0xFFFC)>>2` and `(step&0xFFF8)>>3` are `(4*step)>>4` and `(2*step)>>4`,
// the masks clearing bits the shift discards anyway.
static inline void p2_freq_add(P2Freq* r, int32_t slot, uint32_t num) {
  p2_rescale(r);
  r->f[slot] += (num*(uint32_t)r->step)>>4;
}

// The record either side of a group's, each touched only where the magnitude
// context leaves room: level 15 has no record above it, and the level at the
// bottom has none below.  Where that bottom is differs -- one of the two
// selector shapes in `bump_selector` stops at 2 rather than 0 -- so the low
// bound is a parameter and not a normalization.
//
// The `sel == 1` arm of `bump_selector` is this shape with a *second* bump on
// the next group's record wedged between the two, inside the upper branch.  It
// stays written out: hoisting that bump out would run it unconditionally, and
// moving it after the lower one would reorder two `p2_freq_add`s whose records
// are only distinct because two weight-table entries happen to differ by more
// than two.  That is a fact about the tables, not about the code, and it is not
// worth resting a byte-identical stream on.
static inline void p2_bump_sides(P2Freq* group, int32_t ctx15, int32_t lo,
                                 int32_t slot, uint32_t up, uint32_t dn) {
  if( ctx15<15 )
    p2_freq_add(&group[1], slot, up);
  if( ctx15>lo )
    p2_freq_add(&group[-1], slot, dn);
}

// The same counter, updated in place and *without* `p2_bump`'s dead-zone kick.
// 22 sites in the decompilation folded it into one `+=` on the next counter in
// the bank; the rounding term is the only thing they share with `p2_update`,
// and folding the two together would put the kick where the original has none.
//
// Four call sites now, three of them inside loops, plus one that used to be a
// comma term in the middle of an `if`.
static inline void p2_nudge(P2Count* p, int32_t res, int32_t shift) {
  // Sixteen bits in and sixteen bits out, through `uint16_t` so that the
  // wrap is defined rather than signed overflow.
  //
  // The shift defaults to 2 because 21 of the original 22 sites wanted 2, and
  // three of the four that are left still do; the odd one is a mirror counter
  // at 3.  The default is declared in `decls.inc` and cannot be repeated here,
  // which is worth knowing before looking for it.
  p->weighted = (int16_t)((uint16_t)p->weighted+((uint32_t)(res-p2_pred(p->weighted, p->rate)+(1<<(shift-1)))>>shift));
}

struct P2Ctx {
  int16_t val;
  int16_t dval;
  int16_t err;
  int16_t aerr;
  int16_t dleft;
  int16_t dup;
  int16_t dupleft;
  int16_t dupright;
  uint8_t sign;
  uint8_t mag;
};

// `alt_p2_context` reached ten of these fields by byte offset off a `uint8_t*`
// -- `cx2p[107]`, `cx2p[89]`, `*(cx2p-19)` and so on, for `c2[5].mag` down to
// `c2[-3].mag` -- plus a `*(int16_t*)((uint8_t*)nb0-18)` for `c0[-1].val` and
// two first-member punnings of a `P2Ctx*` to `int16_t*` for `c2->val`.  Every
// one of them is arithmetic on this layout, so the layout is asserted rather
// than left as a fact about whichever offsets happened to be typed in.
//
// These are not restating a struct definition for its own sake: 107 is
// `5*18 + 17`, and both numbers have to be right for the old spelling and the
// new one to name the same byte.
static_assert(sizeof(P2Ctx) == 18, "the byte offsets in alt_p2_context assume 18");
static_assert(offsetof(P2Ctx, val) == 0 && offsetof(P2Ctx, mag) == 17,
              "alt_p2_context reached `val` at +0 and `mag` at +17");

// One row of the neighbour-weight bank.
//
// Lines 0..6 are the filter taps, 7..13 the running mean square of each tap's
// input -- which is what makes it *normalised* least mean squares -- and 14
// three scalars the two halves share.  Line 15 is a count of the samples this
// row has seen, and the original kept it in the first of that line's four
// `float` slots.
//
// It was a `float[16][4]` and the count was reached by casting: through a
// `uint32_t*` at one site and an `int32_t*` at the other, which is two answers
// to what the type is.  A `memcpy` accessor made that defined; a member makes
// it unnecessary.  Same 256 bytes, same offsets, and `-Wstrict-aliasing` has
// nothing left to say about it.
struct NbRow {
  float w[15][4];
  uint32_t uses;
  uint32_t _pad[3];
  int32_t predict(float (*nb)[4], CtxWeights* sets, int32_t mode);
};

static_assert(sizeof(NbRow) == 16*4*sizeof(float),
              "NbRow replaces a float[16][4] and has to be the same size");
static_assert(offsetof(NbRow, uses) == 15*4*sizeof(float),
              "the use count is the first slot of line 15");

// `bmf_p2_coef` and `bmf_p2_rate` read like tuning constants and are not: for
// the length of one image the model borrows them.  Rows 4..6 of the
// coefficients -- the cross-plane terms -- fold into rows 0..2 and are zeroed,
// three rate rows go to the reset value, and all of it goes back at the end.
//
// Both directions do it, in the same six lines each, 300 lines apart from the
// six that undo them.  Filing the two tables with the genuine constants would
// make the non-d8 path's behaviour inexplicable, so they are named as what
// they are: a session, folded at the top of an image and restored at the
// bottom.  Explicitly, not by a destructor -- the restore sits before the
// plane-freeing loop in both callers and stays exactly there.
struct P2Coef {
  float saved_coef[7][4];
  float saved_rate[3][4];

  void fold() {
    __builtin_memcpy(saved_coef, bmf_p2_coef, sizeof saved_coef);
    __builtin_memcpy(saved_rate, bmf_p2_rate[4], sizeof saved_rate);
    for( int32_t k = 0; k<4; ++k ) {
      for( int32_t i = 0; i<3; ++i ) bmf_p2_coef[i][k] += bmf_p2_coef[4+i][k];
      for( int32_t i = 0; i<3; ++i ) bmf_p2_coef[4+i][k] = 0;
      for( int32_t i = 0; i<3; ++i ) bmf_p2_rate[4+i][k] = bmf_p2_rate_reset;
    }
  }

  void restore() {
    __builtin_memcpy(bmf_p2_coef, saved_coef, sizeof saved_coef);
    __builtin_memcpy(bmf_p2_rate[4], saved_rate, sizeof saved_rate);
  }
};

// The pool below the class hands these out, and `alt_p2_free` gives one back
// from inside it -- so the name has to exist before the class and the storage
// cannot, since the pool holds `AltP2Block` by value.
struct AltP2Block;
static void p2_block_give(AltP2Block* p);

struct AltP2Block {
  // The same pair as `AltP1Block::kRowMargin` and for the same reason: the 8
  // was a `ring_advance` argument and the 13 an allocation, with nothing
  // saying they are two ends of one row.  The deepest subscript the p2 sources
  // reach is exactly -8, measured, which is the margin; the tail is what the
  // right-edge mirror and the `c1[5]` lookahead need.
  static const int32_t kRowMargin = 8;
  static const int32_t kRowTail = 5;

  NbRow nb_weights[1088];
  // This was a union of `p2_row` with a struct whose first 112 bytes were
  // `p2_row0_head[15]` and `_u0_0_4[97]` -- 112 being `sizeof p2_row`, so the
  // union existed only to pin everything after it at the original's offsets.
  // The one overlap ever exercised is a partial clear of the first fifteen
  // bytes of `p2_row` at three sites, which is what `p2_row0_head` was for and
  // is written as that now.
  //
  // Fifteen, not sixteen: three and three-quarter floats.  The original very
  // likely cleared a differently-shaped structure that started here, and
  // rounding it up to a whole element would change what the model sees on the
  // first sample of a plane, so it is preserved rather than tidied.
  float p2_row[7][4];
  // `bias` has to follow `p2_row`, and that is not decoration: `NbRow::predict`
  // is handed `p2_row` as its `nb` and writes `nb[7][0]`, `nb[7][1]` and
  // `nb[7][2]` -- one row past the end of a `[7][4]`, which lands here.  Those
  // three floats are how it returns the centre, the mixed prediction and its
  // own; `alt_p2_model` reads `bias[0..2]` and no other slot.  So the filter
  // returns an `int32_t` and three floats, and the second half of that is
  // invisible at both the call site and the signature.
  //
  // The union this pair came out of guaranteed the adjacency by construction.
  // Sequential members do not, so it is asserted below -- the one place in this
  // tree where an `offsetof` check is not restating the layout, because here
  // the code depends on it.
  float bias[4];
  NbRow* nb_cur;
  NbRow** row0;
  NbRow** row1;
  NbRow** cur;
  NbRow** above;
  int32_t bank_ctx[5];
  int32_t _pad0;
  uint16_t pred_prev;
  uint8_t _pad2[2];
  uint32_t ctx;
  uint32_t ctx_pair[2];
  int32_t nb_id_used;
  int32_t band_lo;
  int32_t band_hi;
  uint32_t plane_idx;
  int32_t has_ref;
  P2Ctx* cursor[5];
  P2Ctx* buf[5];
  CtxWeight ctx_w[5];
  uint8_t _pad1[48];
  int32_t nb_sum[10];
  int32_t ctx_delta[260];
  uint8_t fold[256];
  uint8_t fold_hi[256];
  int8_t unfold[256];
  uint8_t nb_ctx[120];
  // 6 bands * 320.  Declared `[1916]` with the four entries after it split off
  // as `uint8_t _pad2[8]` -- the recovery could not see them indexed, and the
  // index reaches them: `63 + 64*gA + 320*band` with `gA` 0..4 and `band` 0..5
  // is 1919 at its largest, which eight of the seventeen corpus images hit on
  // every run.  The overrun landed in the padding and stopped there, exactly,
  // because four `int16_t` is eight bytes.  Same size, same offsets, and the
  // accesses are in bounds now.  CONTEXT-INDEX.md section 1.
  int16_t nb_id[1920];
  // Five banks of 32768, which `slot()` is the index arithmetic for.  The
  // seeding loop counted to `0x28000` and this said 163840; the same number.
  static const int32_t kP2CounterCount = 5*32768;
  P2Count p2_ctr[kP2CounterCount];

  // The four `_padN` arrays above are the decompilation's record of gaps in
  // MSVC's frame, and a filler array is a layout contract written in a form
  // nothing checks.  Stage 2 Section 10 asks for the contract to travel with
  // the declaration instead, which is what these are: the offset of the member
  // *after* each pad, which is the only thing the pad exists to produce.
  //
  // They matter more than the usual `offsetof` restatement because this struct
  // is 1,064,560 bytes of model state, one slot of `p2_blocks`, and
  // because two of its members are already load-bearing on adjacency -- `bias`
  // one row past `p2_row`, asserted below, and `nb_id` whose last four entries
  // were a separate `_pad2[8]` until an index reached them.

  // Counter `ctx` of bank `k`.  Five banks of 32768, so the bank is a digit at
  // that stride and the context is the fifteen bits under it -- which is a
  // width the construction proves rather than one asserted here: a bank context
  // sets no bit above 25 and is then shifted down by 11.
  //
  // Nine sites indexed this array and they did it two ways.  `alt_p2_model`
  // wrote `32768*bank + bctx` in a loop over the five; `alt_p2_context` walks
  // them straight through and wrote the stride out as five literals -- `bank1 +
  // 32768`, `bank2 + 65536`, `bank3 + 98304`, `bank4 + 131072` -- so which bank
  // a line touches had to be recovered by dividing.  They are the same index
  // and now say so.
  static uint32_t slot(int32_t bank, int32_t ctx) {
    return CtxIdx{}.bits<0, 15>(ctx).digit<32768, 5>(bank);
  }

  // The prediction bank `bank` makes in context `ctx`.  `alt_p2_context` builds
  // five of these, one per stage of the cascade, and each of the five evaluated
  // `slot()` twice -- once for the weight and once for the rate -- because the
  // decompilation had the two loads as separate expressions.  `slot` is a pure
  // static, so folding them is exact.
  //
  // Two of the five did not call `p2_pred` at all: they spelled its shift out,
  // with the `&31` masks that are dead for the reason the helper's comment
  // gives.  Those two are the same call as the other three.

  // The weight row this neighbourhood slot uses, found or minted.
  //
  // A slot seen before names a row, and that row is stepped toward the sample
  // first: predict with it, take the error against `c0[-1].val`, and walk all
  // twenty-eight taps.  A slot seen for the first time takes the next row and
  // is not stepped -- it has nothing to step from, and `NbRow::predict` seeds
  // it from the mixture on its first call instead.
  //
  // Lifted out of `alt_p2_context` because it is a stage of that function
  // rather than a step in it: fifty-five lines between the slot number and the
  // filter inputs, doing one thing that has a name.  What it needs from the
  // caller is the slot and the row cursor whose sample the error is measured
  // against; `p2_row`, `bias`, `nb_id` and `nb_cur` are all members.
  void seat_nb_row(int32_t nb_slot, const P2Ctx* c0) {
    const int32_t at = nb_id[nb_slot];
    if( !at ) {
      // **The counter is not bounded and the array it indexes is.**  `nb_slot`
      // names 1920 slots -- `320*band + 64*gA + 16*gB + 4*gC + gD`, and every
      // one of the five is a nested count of threshold crossings, so every one
      // of its values is reachable -- while `nb_weights` holds 1088 rows, of
      // which row 0 is the no-history row `alt_p2_alloc` seeds and
      // `row0`/`row1` start pointing at.  So 1087 distinct slots in one plane
      // is the most this can allocate, and the 1088th writes past the array
      // into `p2_row`, `bias` and `nb_cur` -- the last of which is a pointer
      // the next sample follows.
      //
      // Nothing here or anywhere else checks it, and the sizing is not
      // obviously wrong: instrumented, the nineteen corpus images reach a
      // high-water mark of 593 (`x_ep`; the next are `t8g` and `t8p` at 473),
      // and a montage built to spread activity, gradient direction and noise
      // across 2500 independently-parameterised tiles reaches 980.  The *union*
      // over all twenty is 1034 distinct slots -- 53 short of the bound.  That
      // margin is small enough that 1088 looks measured rather than guessed,
      // and small enough that no input found so far crosses it.
      //
      // It is left as it is: a clamp would change the model on exactly the
      // inputs in question and no corpus stream would move to say so.  The
      // `BMF_ASSUME` is the honest instrument -- a comment under the default
      // build and a check under `BMF_ASSERTS=1`, which is a build leg.
      //
      // The three statements this replaced carried a `next_id` that was
      // `nb_id_used` before, during and after the increment, and an `(int16_t)`
      // on the last read that matched the width the store narrows to and cannot
      // bite below 32768.
      nb_id[nb_slot] = ++nb_id_used;
      BMF_ASSUME(nb_id_used<1088);
      nb_cur = &nb_weights[nb_id_used];
      return;
    }
    NbRow*const wrow = &nb_weights[at];
    nb_cur = wrow;
    const float err = ((float)c0[-1].val-(nb_dot(wrow->w, p2_row)+bias[0]))*2.0999999f;
    const float floor_ = 7744.0f*wrow->w[14][2];
    for( int32_t j = 0; j<7; ++j )
      for( int32_t k = 0; k<4; ++k )
        nlms_step(wrow, j, k, p2_row[j][k], err, bmf_p2_ms_rate, floor_);
  }

  int32_t p2_pred_at(int32_t bank, int32_t bctx) {
    const P2Count& c = p2_ctr[slot(bank, bctx)];
    return p2_pred(c.weighted, c.rate);
  }

  // One stage of the five-bank cascade.  The context word's top bits name the
  // bank slot, the counter there predicts, and that prediction accumulates onto
  // the running one, which is what the next stage's word is built against.
  //
  // The two `nb_sum` slots per bank are the pair `alt_p2_model` reads back: the
  // running total at `2*bank` -- the residual is taken against it -- and the
  // stage's own prediction at `2*bank + 1`, which the second arm folds into the
  // residual again.  That indexing is why this is one function and not five: the
  // even/odd convention was spelled out ten times, with the two stores in one
  // order for banks 0, 2, 3 and 4 and the other order for bank 1, so which slot
  // held which could only be read off by matching each literal to its neighbour.
  //
  // `word>>11` drops the eleven low bits the `bit_of<>` chains fill and is the
  // same shift at all five sites.  The parameter is `word` rather than `ctx`
  // because `AltP2Block::ctx` is a member and a parameter of that name shadows
  // it -- which the `BMF_WARN=1` leg says and the default build does not.  It takes the word unsigned because that is
  // what `CtxIdx` converts to and what banks 3 and 4 shifted -- banks 0, 1 and 2
  // went through an `int32_t` local first and shifted arithmetically, which is
  // the same value for a word whose highest field is bit 25 but not the same
  // spelling.  One spelling now, and the three locals are `uint32_t`.
  //
  // Bank 0's `run_in` is the filter output rather than a previous stage; the
  // other four chain.
  int32_t step_bank(int32_t bank_no, uint32_t word, int32_t run_in) {
    const int32_t bank = (int32_t)(word>>11);
    bank_ctx[bank_no] = bank;
    const int32_t pred = p2_pred_at(bank_no, bank);
    nb_sum[2*bank_no+1] = pred;
    const int32_t run = pred+run_in;
    nb_sum[2*bank_no] = run;
    return run;
  }
  // 15552 = 16 magnitude levels * 972, the mixed-radix span the five ternary
  // selectors reach through `mixer_fwd`.  Seeded by a loop that counted to
  // `0x3CC0`.
  static const int32_t kP2FreqCount = 15552;
  P2Freq freq[kP2FreqCount];
  uint8_t _pad3[8];
  // Defined out of line, in alt_p2_context.inc and alt_p2_model.inc.  They are
  // 400 and 1100 lines and belong in their own files, which is what the split
  // is for; every other method in this tree is defined in its class body
  // because every other method fits there.  They were free functions taking
  // the block as a first argument, which is what a method is.

  // The NLMS filter, in two halves, and each was a bare braced block inside
  // `alt_p2_model`'s 674 lines.
  //
  // The row's shape is `NbRow` above: lines 0..6 the taps, 7..13 the running
  // mean square of each tap's input -- which is what makes this *normalised*
  // least mean squares, each tap's step divided by the energy it has been
  // seeing -- and line 14 three scalars the two halves share.
  //
  // Both halves are written as `[7][4]` nests rather than 28 scalars because
  // that is the shape the original's SSE was in; keeping it is what lets a
  // compiler put it back.

  // One tap of a normalised least-mean-squares step: move the tap's running
  // mean square toward `x*x` at `ms_rate`, then move the weight by the error
  // scaled by `x` and divided by that mean square.  Dividing by the running
  // power is the whole of what "normalised" means here.
  //
  // Written out three times -- twice below for the fast and slow rows and once
  // in `alt_p2_context` -- differing only in the rate and the floor, so what
  // the three had in common was invisible.  It takes `j` and `k` rather than a
  // `float&` because the mean square it updates is the same row seven lines
  // down: `w[j]` and `w[7 + j]` are one tap.
  void nlms_step(NbRow* row, int32_t j, int32_t k, float x, float err,
                 float ms_rate, float floor_) {
    const float ms = row->w[7+j][k]+(x*x-row->w[7+j][k])*ms_rate;
    row->w[7+j][k] = ms;
    row->w[j][k] += bmf_p2_rate[j][k]*err*x/(ms+floor_);
  }

  // Track the input energy and step both rows' weights toward their own error.
  // Two rows, not one: `fast` adapts against this sample and `slow` against the
  // confidence-scaled one, and the pair is the mixer.
  void nlms_track_two_rows(NbRow* fast, NbRow* slow,
                           float err_fast, float err_slow, float conf) {
    const float floor_fast = 26896.0f*fast->w[14][2];
    const float floor_slow = 5041.0f*slow->w[14][2];
    const float rate_slow = 0.013f*conf;
    for( int32_t j = 0; j<7; ++j )
      for( int32_t k = 0; k<4; ++k ) {
        const float x = p2_row[j][k];
        nlms_step(fast, j, k, x, err_fast, 0.05f, floor_fast);
        nlms_step(slow, j, k, x, err_slow, rate_slow, floor_slow);
      }
  }

  // Predict this sample from the fast row, then step that row toward the error
  // it just made.  `w[14][2]` decays toward 10 and scales the step floor, so
  // the filter starts cautious and loosens; `uses` counts the samples this
  // row has seen.
  void nlms_predict_and_correct(NbRow* row, float sample, float bias0) {
    const float err = sample-(bias0+nb_dot(row->w, p2_row));
    const float ms_scale = row->w[14][2];
    for( int32_t j = 0; j<7; ++j )
      for( int32_t k = 0; k<4; ++k )
        row->w[j][k] += bmf_p2_rate[j][k]*err*p2_row[j][k]/(row->w[7+j][k]+ms_scale*529.0f);
    ++row->uses;
    row->w[14][2] = ms_scale+((10.0f-ms_scale)*0.00019999999f);
  }

  // The two reference planes' rows as `alt_p2_context` reads them: three
  // cursors each, one record back from where the ring points.  All six are null
  // when this plane has no references, which is what `refa` being null means and
  // what the arms downstream test for.
  //
  // A struct rather than six out-parameters because they are one thing -- the
  // reference neighbourhood -- and because six `P2Ctx**` in a signature is six
  // chances to pass them in the wrong order.
  //
  struct P2RefRows {
    P2Ctx *r0, *r1, *r2;
  };

  struct P2Refs {
    P2RefRows a, b;
  };

  // Rows 0, 1 and 2 of a reference plane's ring, each one record back from where
  // it points.  Both reference planes are read identically and that `-1` had
  // been spelled out six times, which is the kind of offset that wants one home.
  //
  // A named factory over an aggregate rather than a constructor.  The
  // constructor was written first and `covered.py` reported the type as an
  // undescribed function while `deadcheck.py` read `r2(ring[2]-1)` in its
  // initialiser list as a call to something nothing defines -- a member
  // initialiser list being a construct nothing else in this tree uses.  Two
  // tools could have been taught it, but a function with a name that says what
  // it returns is the better of the two spellings on its own merits, so the
  // construct went instead of the parsers.
  //
  // It takes the ring rather than the block so that it does not depend on a
  // type it is declared inside.
  static P2RefRows ref_rows(P2Ctx* const* ring) {
    return {ring[0]-1, ring[1]-1, ring[2]-1};
  }

  P2Refs fill_row_inputs(AltP2Block* refa, AltP2Block* refb);

  int32_t seat_symbol_context(int32_t run4, const P2Refs& refs);

  void code_banks(int32_t sample16);

  // One pass over a bank's eleven context bits, doing to each what the arm it
  // was reached by says: bump the direct counter at shift 2, the rotated one
  // at 3, optionally nudge the record after the direct one, bump the record
  // before it, and bump the mirrored one with the residual negated.
  //
  // The second and third arms of `code_banks` differ in one line of the five:
  // whether that nudge happens.  `direct[0]` and `rot[0]` are bumped before
  // the branch that chooses between them and `mirror[10]` after the two join,
  // which is why this skips both ends.
  void walk_bank_bits(P2Count*const* direct, P2Count*const* mirror,
                      P2Count*const* rot, int32_t res, bool nudge) {
    for( int32_t k = 0; k<11; ++k ) {
      if( k ) {
        p2_update(direct[k], res, 2);
        p2_update(rot[k], res, 3);
      }
      if( nudge )
        p2_nudge(&direct[k][1], res);
      p2_update(&direct[k][-1], res, 3);
      if( k<10 )
        p2_update(mirror[k], -res, 3);
    }
  }

  // Bank `k`, bumped.  Its selector picks one of two shapes: a selector of 1
  // bumps the group's record, the one after it, the first record of the next
  // group and the one before -- four counts at 3, 4, 2 and 6 sixteenths -- and
  // any other selector bumps three, at 7, 5 and 6.  The bank the step came
  // from is bumped first either way, at 4 or 7.
  //
  // Written out five times in `alt_p2_model`, thirty-six lines apiece, over
  // `ctx_w[0]` through `ctx_w[4]` with a fresh set of temporaries in each --
  // `frec3`/`frec4b`/`frec5`/`frec4c` for the first record, `idx0`/`rec_idx`
  // for the next group, `grp`/`frec_step`/`gtop` for the group.  Nothing else
  // differed, and not one of those names outlived the copy it was written in.
  // Round nine made the five a loop over `k`; this makes the loop's body a
  // name, which is what took the model's deepest nesting off eight.
  void bump_bank(int32_t k, uint32_t step_v, int32_t ctx15, int32_t fold_sel,
                 int32_t is_dec) {
    const int32_t sel = ctx_w[k].sel;
    if( sel==1 ) {
      p2_freq_add(&freq[ctx_w[k].w[0]+step_v-ctx_w[k].w[1]], fold_sel, 4);
      const uint32_t off = ctx-ctx_w[k].w[1];
      P2Freq*const group = &freq[off+ctx_w[k].w[0]];
      const uint32_t next_group = ctx_w[k].w[2]+off;
      p2_freq_add(&group[0], is_dec, 3);
      if( ctx15<15 ) {
        p2_freq_add(&group[1], is_dec, 4);
        p2_freq_add(&freq[next_group+1], is_dec, 2);
      }
      if( ctx15>2 )
        p2_freq_add(&group[-1], is_dec, 6);
    } else {
      p2_freq_add(&freq[step_v+ctx_w[k].w[1]-ctx_w[k].w[2-sel]], fold_sel, 7);
      P2Freq*const group = &freq[ctx_w[k].w[1]+(ctx-ctx_w[k].w[sel])];
      p2_freq_add(&group[0], is_dec, 7);
      p2_bump_sides(group, ctx15, 0, is_dec, 5, 6);
    }
  }

  template<int32_t f_DEC>
  void alt_p2_d8_body(uint8_t* src, uint8_t* out,
                      int32_t width, int32_t height);
  int32_t alt_p2_context(AltP2Block* refa, AltP2Block* refb);
  uint32_t alt_p2_model(int32_t sample_in, uint8_t a4, int32_t resid_in);

  // Code one sample of this plane, with the near-lossless drift control: fold
  // the residual against the prediction, reconstruct it, and if the
  // reconstruction has drifted more than sixteen from the byte already in the
  // buffer, send the sample through `fold_hi` instead and leave that byte
  // alone.
  //
  // Four copies in `alt_model_p2_encode`, one per plane, twelve lines apiece,
  // differing in the block, the two reference planes and the output offset.
  // The fourth spelled the reconstruction twice instead of naming it.
  //
  // `out[at]` is read twice on purpose, as the copies did: once before
  // `alt_p2_context` and once after.
  void encode_sample(uint8_t* out, int32_t at, AltP2Block* refa, AltP2Block* refb) {
    int32_t sample = out[at];
    const int32_t pred = alt_p2_context(refa, refb);
    const int32_t resid = (uint8_t)(sample-pred);
    int32_t code = fold[resid];
    const int32_t was = out[at];
    const int32_t clean = (uint8_t)(pred+unfold[code]);
    const int32_t recon = (uint8_t)(clean+was-sample);
    if( was-recon<-16||was-recon>16 ) {
      code = fold_hi[resid];
    } else {
      sample = clean;
      out[at] = recon;
    }
    freq[ctx].encode_symbol(ctx_pair, code);
    alt_p2_model(sample, code, sample-pred);
  }

  // The decode half of `encode_sample`: predict, take the symbol, unfold it,
  // write the byte, and step the model.  Four copies in `alt_model_p2_decode`,
  // one per plane.
  //
  // Shorter than the encoder by exactly the near-lossless drift control, which
  // is the asymmetry the header of alt_p2.inc records: the decoder is told
  // which fold was used and has nothing to decide.
  void decode_sample(uint8_t* out, int32_t at, AltP2Block* refa, AltP2Block* refb) {
    const int32_t pred = alt_p2_context(refa, refb);
    const int32_t code = freq[ctx].decode_symbol(ctx_pair);
    const int32_t sample = (uint8_t)(pred+unfold[code]);
    alt_p2_model(sample, code, sample-pred);
    out[at] = sample;
  }

  // One sample, in whichever direction the caller is going.  `alt_model_p2`
  // is one template over both and this is the only line of its inner loop that
  // differs between them; four planes make four such lines, which is what kept
  // the two 90-line bodies apart.
  template<int32_t f_DEC>
  void code_sample(uint8_t* out, int32_t at, AltP2Block* refa, AltP2Block* refb) {
    if constexpr( f_DEC )
      decode_sample(out, at, refa, refb);
    else
      encode_sample(out, at, refa, refb);
  }

  // Seed the three spare history rows from the row just coded: mirror its last
  // record five forward past the right edge, mirror eight back from the start
  // of the row above it, and copy the whole row into rows 1, 2 and 3.
  //
  // Three copies -- `alt_p2_d8_body` after its first row, and both of
  // `alt_model_p2_encode` and `alt_model_p2_decode` -- with the width spelled
  // as `width`, `first` and `back`, one of them negated at the call site.
  // The three history rows seeded from row 0, which both seeds end with.
  // `18*width + 234` is `sizeof(P2Ctx) * (width + 13)` -- a whole row, margins
  // included -- and written that way it is a layout declared rather than
  // multiplied out.
  void copy_row0_down(int32_t width) {
    static_assert(sizeof(P2Ctx) == 18, "a row is eighteen bytes to the record");
    const int32_t row_bytes = sizeof(P2Ctx)*(width+kRowMargin+kRowTail);
    for( int32_t i = 0; i<3; ++i )
      memcpy(buf[1+i], buf[0], row_bytes);
  }

  void seed_history(int32_t width) {
    P2Ctx*const here = cursor[0];
    for( int32_t i = 0; i<5; ++i )
      here[i] = here[-1];
    P2Ctx*const up = cursor[0]-width;
    for( int32_t i = 0; i<8; ++i )
      up[-1-i] = up[i];
    copy_row0_down(width);
  }

  // The neutral record every row 0 starts from, and the five cursors seated
  // past it.  Written out in both coders, twelve lines apiece for the record
  // and one re-rolled loop each for the copies and the cursors.
  void seed_row0(int32_t width) {
    for( int32_t x = 0; x<width+13; ++x ) {
      P2Ctx&rec = buf[0][x];
      rec.val = 256;
      rec.dval = 256;
      rec.err = -16;
      rec.sign = 1;
      rec.mag = 3;
      rec.aerr = 512;
      rec.dupright = 512;
      rec.dupleft = 512;
      rec.dup = 1024;
      rec.dleft = 256;
    }
    copy_row0_down(width);
    for( int32_t i = 0; i<5; ++i )
      cursor[i] = buf[i]+width+8;
  }

  // Roll the four bias accumulators forward by the record just coded: thirty-two
  // times each of its four difference fields.
  //
  // Eight copies, four in each coder, and the two coders do not agree on where
  // the total lives.  The decoder keeps it in `ctx_bias` and adds to it after
  // every plane, which is the form that reads.  The encoder carries it in four
  // locals -- `at0`, `seed0`, `off0`, `want0` -- and writes `ctx_bias` back from
  // them one plane late, so plane 2's contribution reaches `ctx_bias` only if
  // there is a plane 3 to need it.  That delay is MSVC's scheduling and not the
  // model: `alt_p2_context` is the only reader, and by the time it could see the
  // difference the next sample has already reloaded `ctx_bias` from the total.
  void add_bias(int32_t* acc) const {
    const P2Ctx&rec = cursor[0][-1];
    acc[0] += 32*rec.dupleft;
    acc[1] += 32*rec.dupright;
    acc[2] += 32*rec.dleft;
    acc[3] += 32*rec.dup;
  }

  // Roll this plane forward by one row: carry the last neighbour of the row
  // just finished into both seams of the next, swap the two neighbour rows and
  // step them past their margins, clear the filter's row and its four biases,
  // and rotate the five context rings so the oldest becomes the new row.
  //
  // Three copies of this, forty-seven lines apiece.  `alt_p2_model` had it on
  // its own members; `alt_model_p2_encode` and `alt_model_p2_decode` each had
  // it written out on `blk_r->`, with the ring rotation spelled through five
  // named temporaries rather than the `ring_advance` next door -- which is why
  // the three did not look alike at a glance even though they are one thing.
  void start_row() {
    NbRow*const last = cur[-1];
    cur[1] = last;
    cur[0] = last;
    NbRow**const was_row0 = row0;
    row0 = row1;
    row1 = was_row0;
    cur = row0+2;
    above = row1+2;
    cur[-1] = *above;
    cur[-2] = *above;
    memset(p2_row, 0, 15);
    for( int32_t i = 0; i<4; ++i ) bias[i] = 0.0f;
    __builtin_memset(p2_row, 0, sizeof p2_row);
    {
      P2Ctx*const here = cursor[0];
      for( int32_t i = 0; i<5; ++i ) here[i] = here[-1-i];
    }
    ring_advance(buf, cursor, kRowMargin);
    cursor[0][-1] = cursor[1][0];
    {
      P2Ctx*const here = cursor[0];
      P2Ctx*const up = cursor[1];
      for( int32_t i = 0; i<7; ++i ) here[-2-i] = up[1+i];
    }
    cursor[0]->dval = 0;
  }

  AltP2Block*alt_p2_alloc(int32_t img_w, int32_t plane) {
    uint32_t done;
    uint32_t j, p, n;
    plane_idx = plane;
    // One pass, not two 2x-unrolled ones.  The original walked the 163,840
    // counters twice -- once zeroing `weighted`, once seeding `rate` and `b1`
    // -- with each loop doing two records an iteration.  This runs once per
    // plane, and the difference is not measurable: 9.7s either way on `x_ep`.
    for( j = 0; j<(uint32_t)kP2CounterCount; ++j ) {
      p2_ctr[j].weighted = 0;
      p2_ctr[j].rate = 5;
      p2_ctr[j].b1 = 2;
    }
    for( uint32_t e = 0; e<(uint32_t)kP2FreqCount; ++e ) {
      freq[e].f[0] = 2048;
      freq[e].f[1] = 2816;
      freq[e].f[2] = 2816;
      freq[e].step = 4096;
    }
    // See `alt_init_tables`: this is the second of the three reads of a
    // quantiser nothing in this build sets above zero.
    BMF_ASSUME(near_lossless_q==0);
    int32_t dz = 4*near_lossless_q+1;
    int32_t band = 16*near_lossless_q;
    has_ref = (plane_desc[plane_desc[plane_idx].src_plane].flags&desc_has_refs)!=0;
    deadzone_hi = dz;
    deadzone_lo = -dz;
    band_lo = -band-7;
    band_hi = band+8;
    // Two rows of weight-set pointers, one per column plus the four the
    // margins need.  `img_w + 4` is at most `kMaxWidth + 4`, so they are
    // members like the record rows below.
    row0 = row0_store;
    nb_weights[0].w[14][2] = 1.0f;
    row1 = row1_store;
    cur = row0+img_w+2;
    if( img_w>-4 ) {
      uint32_t pairs = (img_w+4)/2;
      if( pairs ) {
        for( p = 0; p<pairs; ++p ) {
          row1[2*p] = &nb_weights[0];
          row0[2*p] = &nb_weights[0];
          row1[2*p+1] = &nb_weights[0];
          row0[2*p+1] = &nb_weights[0];
        }
        done = 2*p+1;
      } else {
        done = 1;
      }
      if( (uint32_t)(img_w+4)>(done-1) ) {
        row1[done-1] = &nb_weights[0];
        row0[done-1] = &nb_weights[0];
      }
    }
    uint32_t row = 0;
    // `18*width + 234` is `sizeof(P2Ctx) * (width + 13)`, which is the same
    // margin-plus-samples-plus-tail as the line above spells directly.  It is
    // kept in the decompilation's form because `kP2RowPad` is what the original
    // added and the two readings are worth having side by side.
    static_assert(kP2RowPad == sizeof(P2Ctx)*(kRowMargin+kRowTail),
                  "the row pad is the two margins");
    int32_t row_bytes = 18*max32(img_w, 3)+kP2RowPad;
    // The ring points into the block, as `AltP1Block`'s does.  `row_bytes` is
    // still what the memsets and the row copies use -- only the storage moved.
    //
    // A `for` and not the `do` that was here: writing it `buf[row++] =
    // row_store[row]` reads `row` and increments it in one expression, which
    // g++ reports as `-Wsequence-point` and C++17 only makes well-defined by a
    // rule about which side of an assignment is evaluated first.  The
    // `BMF_CONV=1` leg counted it the moment it was written.
    for( row = 0; row<5; ++row )
      buf[row] = row_store[row];
    memset(buf[0], 0, row_bytes);
    // Four independent stores the decompiler left in the order MSVC scheduled
    // them, counting down with an unrelated initialisation dropped in the
    // middle.
    for( int32_t i = 0; i<4; ++i )
      ctx_bias[i] = 0;
    int32_t lvl = 0;
    cursor[0] = buf[0]+8;
    // `2*pair+++1` -- a post-increment inside the comparison that decides the
    // next level, with the answer parked in a `bump` the next line adds.  The
    // `nb_ctx` walk three lines below does the same thing in a `for` with
    // neither, and this is that shape.
    for( uint32_t pair = 0; pair<0x82; ++pair ) {
      // The plane from bit 8 up and the run level as a four-bit field at 4.
      // The level is bounded by its own table -- `p2_ctx_edges` has sixteen
      // entries and `lvl` indexes it -- so the width is a fact rather than a
      // guess, and `bits<4, 4>` states it.
      //
      // The plane is `above<8>` and not `bits<8, 2>`, which is the distinction
      // those two methods exist to draw.  `plane_count` is
      // `((depth & 0x3F) + 7) >> 3`, which is two bits only because the header
      // check rejects depths above 32 -- a width that rests on a test in
      // another file is not a width to assert here, and a mask that turns out
      // too narrow drops the top of the value silently.  That is what moved
      // three streams when `gA` was written as `bits<6, 2>`.  `above<8>` says
      // where the fields below it end and claims nothing else.
      ctx_delta[2*pair] = CtxIdx{}.above<8>(plane_idx).bits<4, 4>(lvl);
      const int32_t lvl1 = (2*pair==p2_ctx_edges[lvl])+lvl;
      ctx_delta[2*pair+1] = CtxIdx{}.above<8>(plane_idx).bits<4, 4>(lvl1);
      lvl = (2*pair+1==p2_ctx_edges[lvl1])+lvl1;
    }
    int32_t len = 0;
    for( n = 0; n<0x3C; ++n ) {
      nb_ctx[2*n] = len;
      int32_t len1 = (2*n==p2_len_edges[len])+len;
      nb_ctx[2*n+1] = len1;
      len = (2*n+1==p2_len_edges[len1])+len1;
    }
    ctx = 15;
    alt_init_tables(fold, unfold);
    // The same three sequences as `AltP1Block`'s, five contexts instead of
    // nine and starting at 64 instead of 32: the middle weight triples, the
    // top is twice the middle, the bottom is zero.  Fifteen assignments in
    // scheduler order did not say that.
    for( int32_t c = 0, w1 = 64; c<5; ++c, w1 *= 3 ) {
      ctx_w[c].w[0] = 0;
      ctx_w[c].w[1] = w1;
      ctx_w[c].w[2] = 2*w1;
    }
    return this;
  }

  // Returns nothing, and takes nothing.  It returned `this` *after*
  // `bmf_page_free(this)` -- a dangling pointer, which g++ reports under
  // `-Wuse-after-free` -- and the `do_free` flag it tested is 1 at every call
  // site in the tree.  Fourth of its kind here, after `alt_p1_free`,
  // `alt_model_p1_d8_decode` and `ModelBlock::free_workspace`: the decompiler
  // writes the register that happened to hold `this` as a return value wherever
  // MSVC left it there, and a `do_free` nobody clears is the same artefact one
  // level up.
  //
  // The plan asks for "release workspace" and "release object" to be split.
  // There is nothing to split: no caller wants the workspace freed and the
  // object kept, which is what the always-1 flag says.
  void alt_p2_free() {
    p2_block_give(this);
  }

  // The rows the three cursors above point into, last in the struct so that no
  // member's offset moves.  18 bytes to the record and 65548 records to the row
  // -- 5.9 MB for the ring -- plus two pointer rows of 65539 each.
  //
  // That is 7.9 MB a block against 1.02, and four blocks live, so this is where
  // most of the program's `.bss` comes from.  What it buys is seven allocations
  // and seven frees per plane gone, and a model whose working set is a
  // compile-time constant.
  P2Ctx row_store[5][kMaxWidth+kRowMargin+kRowTail];
  NbRow* row0_store[kMaxWidth+4];
  NbRow* row1_store[kMaxWidth+4];
};

// The four blocks this model can have live at once, in the data segment.  One
// per plane and `plane_count` is at most 4, which `expand_image` enforces and
// the corpus reaches: instrumented both directions, `x_ep`, `xform2` and
// `med32` all hit four.
//
// Zeroed on take, and that `true` is load-bearing rather than tidy: the page
// allocator this replaces memset what it returned, and filling these slots with
// 0xA5 instead fails 15 of 111 checks.  Which is also what makes the *other* two
// pools' `false` an answer and not an omission -- the same poison leaves them
// green.  1.02 MB apiece, 4.1 MB of `.bss`.
static BlockPool<AltP2Block, 4> p2_blocks;

static AltP2Block* p2_block_take() {
  return p2_blocks.take(true);
}

static void p2_block_give(AltP2Block* p) {
  p2_blocks.give(p);
}

// Whether the plane that plane `k` references carries a colour transform, and
// so whether the sample it is seeded from has to be mixed from its references
// or is zero.
//
// Three of these open each coder, under six names between them -- `xf0`, `np`
// and `y` in the encoder, `xf0`, `dc_flag` and `xf4` in the decoder -- none of
// which says which plane it is about.
static bool ref_transformed(int32_t k) {
  return (plane_desc[plane_desc[k].src_plane].flags&desc_has_refs)!=0;
}

// Every plane made ready for the next row.  Row 0 seeds the neutral record and
// seats the cursors; row 1 seeds the three history rows from what row 0 left
// behind; every row after that only rolls forward.
//
// Both coders wrote this out, fifteen lines each, and both spelled the row
// index twice -- `src1`/`xf4` in the encoder, `src2`/`first` in the decoder --
// because MSVC saved it around the loop and read it back after.  The decoder
// spelled the width twice as well, `i` and `i_1`.
//
// The width goes to `seed_history` unnegated.  Both call sites read
// `seed_history(-first)` where `first` was itself `-width`, and writing the
// obvious `seed_history(-width)` here cost eight of the 110 checks -- which is
// the one thing a double negative spelled through a named local is good at.
static void alt_p2_start_row(AltP2Block** plane, int32_t row, int32_t width) {
  for( int32_t k = 0; k<plane_count; ++k ) {
    if( row==0 )
      plane[k]->seed_row0(width);
    else if( row==1 )
      plane[k]->seed_history(width);
    plane[k]->start_row();
  }
}

// The planes both directions of the p2 model work through.  Each of
// `alt_model_p2_encode` and `alt_model_p2_decode` opened with the first of
// these and closed with the second, written out, and the closing one is the
// longer of the two duplicated blocks left in this pair after `start_row` came
// out -- thirteen lines that re-read `plane_count` from the global on every
// turn of a loop it is also the bound of.  Nothing in `alt_p2_alloc` or
// `alt_p2_free` writes `plane_count`, which is what makes the re-read say
// nothing and the `for` say the same thing as the `do`.
static void alt_p2_planes_alloc(AltP2Block** plane, int32_t width) {
  for( int32_t pl = 0; pl<plane_count; ++pl ) {
    AltP2Block* page = p2_block_take();
    plane[pl] = page->alt_p2_alloc(width, pl);
  }
}

static int32_t alt_p2_planes_free(AltP2Block** plane) {
  for( int32_t pl = 0; pl<plane_count; ++pl )
    plane[pl]->alt_p2_free();
  return plane_count;
}

// `NbRow::predict` writes `nb[7][0..2]` where `nb` is `p2_row`, a `[7][4]`.
// That is `bias`, and this says so in a form the compiler checks.
// Both widths, for the reason the `ModelBlock` set gives: the block holds
// pointers -- `cursor[5]`, `cur`, `above`, `nb_cur` and the row buffers -- so
// every offset past them moves, by 20 here and by 64 once the five cursors and
// the three weight-row pointers have gone by.
#if UINTPTR_MAX > 0xFFFFFFFFu
static_assert(offsetof(AltP2Block, pred_prev) == 278720, "_pad0 sizes the gap");
static_assert(offsetof(AltP2Block, ctx) == 278724, "_pad2 sizes the gap");
static_assert(offsetof(AltP2Block, nb_sum) == 278968, "_pad1 sizes the gap");
// `sizeof` no longer answers this: the row storage is appended to the record,
// so what pins `_pad3` is where that storage starts.  The number is the same
// one -- the decompiled record still ends at 1064560 -- and saying it this way
// also says that everything past it is this tree's and not the binary's.
static_assert(offsetof(AltP2Block, row_store) == 1064560, "_pad3 closes the record");
#else
static_assert(offsetof(AltP2Block, pred_prev) == 278700, "_pad0 sizes the gap");
static_assert(offsetof(AltP2Block, ctx) == 278704, "_pad2 sizes the gap");
static_assert(offsetof(AltP2Block, nb_sum) == 278904, "_pad1 sizes the gap");
static_assert(offsetof(AltP2Block, row_store) == 1064496, "_pad3 closes the record");
#endif

static_assert(offsetof(AltP2Block, bias)
              == offsetof(AltP2Block, p2_row)+sizeof(AltP2Block::p2_row),
              "NbRow::predict returns three floats by writing one row past "
              "p2_row, which has to be bias");

// The six weight sets `NbRow::predict` mixes, in the order `bmf_p2_mix[mode]`
// weights them -- so the order is the model's and not a choice.  In cursor
// terms, with `cur` and `above` both pointing at this pixel's column and both
// advanced one slot per pixel:
//
//     row[0] = cur[-1]     one to the left, this row
//     row[1] = above[1]    one to the right, the row above
//     row[2] = above[2]    two to the right, the row above
//     row[3] = cur[-2]     two to the left, this row
//     row[4] = above[0]    directly above
//     row[5] = cur[0]      this column's slot, which this row has not written
//                          yet -- the two row buffers alternate, so it still
//                          holds what was put there when this buffer was last
//                          the current row
//
// `f0` was the name, which is an offset and not a role: the member sits at
// zero and the decompiler said so.
struct CtxWeights {
  NbRow* row[6];
};

// model.inc -- the main model.  One pixel in and one pixel out are the two largest
// bodies in the program, and they are methods of the block they read.

struct PixRec {
  union {
    struct {
      uint16_t sym;
      uint8_t match[6];
    };
    // The same eight bytes as two words.  `match2345` was already named; the
    // low word had only `_head[4]` and eleven sites reached it as
    // `*(uint32_t*)rec`, which is the punning this union exists to make
    // unnecessary.
    struct {
      uint32_t head4;
      uint32_t match2345;
    };
  };
};

// How many of `n` consecutive records matched their neighbour on `lane`, less
// `n` -- so 0 when every one of them did and `-n` when none did.  That is what
// each of the four gradients is seeded with at the start of a row, and `sig1`
// tests each of the four for zero.
//
// Ten copies between `code_pixel`, `decode_pixel`, `model_plane` and
// `unmodel_plane`, every one of them written out term by term with the terms
// in scheduler order.
//
// Three of the eight terms in one of them were cast to `int8_t`, and the casts
// say nothing: every write to a `match` byte in this program is a comparison,
// an `&` of two of those, a copy of another record's byte, or the `0x01010101`
// two sites store through the union -- so the byte is 0 or 1 and the two
// readings agree.
static int32_t match_seed(const PixRec* first, int32_t n, int32_t lane = 0) {
  int32_t hits = 0;
  for( int32_t i = 0; i<n; ++i )
    hits += first[i].match[lane];
  return hits-n;
}

// `grad[0]`'s five records are not consecutive: -3, -2, 2, 3, 4, stepping over
// the three around the one being coded.  Both pixel coders spell them out
// through a handful of `uint8_t` locals -- five in one and four in the other,
// with a `g_ab` that is two of them added early -- and none of those locals is
// read anywhere else.
static int32_t match_seed_split(const PixRec* at) {
  return at[-3].match[0]+at[-2].match[0]
        +at[2].match[0]+at[3].match[0]+at[4].match[0]-5;
}

// The four neighbours both pixel coders rank a symbol against, in rank order:
// north, west, north-east, north-west.
//
// They lived in the candidate array until this round -- `nb_sym[8]`, `[10]`,
// `[6]`, `[5]` in the encoder and `[0]`, `[1]`, `[3]`, `[2]` in the decoder,
// two arbitrary sets of slots for one set of values, which is why the two
// coders' openings did not look alike and why a `rank` written against one set
// could not be called from the other.
//
// The round that wrote `neighbour_rank` left this alone for a reason it
// recorded: `code_pixel` was borrowing eleven of those slots for unrelated
// values, two of them (`nb_sym[5] = run_bucket[nb_sym[4]]`, `nb_sym[6] =
// run_hit`) among the four, so "the four slots still hold the four neighbours"
// was a claim about paths rather than about the text, and it was settled by
// instrumenting -- 9,144,286 calls over three images, all four intact.  The
// round after that gave those eleven borrowed slots their own names, which
// removed the hazard and left the note behind: **between the four stores and
// the last read of them there is now no write to `nb_sym` at all in either
// body.**  So the four are four locals, by construction, and the note was
// describing a tree that no longer existed.
struct Neighbours {
  int32_t up, left, up_next, upleft;

  // Where a symbol sits among them: 1..4 for the four, 0 -- the escape -- for
  // anything else.  Five chains between the two coders ran this, each spelling
  // the four literals of its own scale into the arms.
  int32_t rank(int32_t sym) const {
    if( sym==up )
      return 1;
    if( sym==left )
      return 2;
    if( sym==up_next )
      return 3;
    if( sym==upleft )
      return 4;
    return 0;
  }
};

// The cumulative weight below a level, as the arms of those chains spell it.
// Level 4 takes it as the total less the top weight rather than summing the
// four below, and level 3 sums in the order 0, 2, 1; the weights are
// `uint16_t` widened to `int`, so no ordering of the same terms differs.
static inline int32_t cum_below(const uint16_t* w, int32_t lvl) {
  switch( lvl ) {
  case 1: return w[0];
  case 2: return w[0]+w[1];
  case 3: return w[0]+w[2]+w[1];
  case 4: return w[5]-w[4];
  }
  return 0;
}

// The six folds a context group's flag word carries: which of the five
// selector weights share a weight with which.  `tables.inc` names the bits and
// gives the order the folds compose in.
//
// Both halves of the model hoist all six out of the two loops that apply them,
// as the original does, and both spelled the six out.  The encoder's names were
// these; the decoder's were `y0`, `f_b1`, `f_b4`, `f_b0`, `f_b5`, `f_b3` -- bit
// numbers, which say where a bit is and not what it does, in the decompiler's
// declaration order rather than the order they compose in.  What the two loops
// do with the six is genuinely different, so this is the six and not the loop.
struct GroupFolds {
  int32_t w3_double, w4_to_w2, w3_to_w2, w4_to_w1, w3_to_w1, w2_to_w1;

  explicit GroupFolds(int32_t flags)
      : w3_double(flags&ctx_w3_double),
        w4_to_w2(flags&ctx_w4_to_w2),
        w3_to_w2(flags&ctx_w3_to_w2),
        w4_to_w1(flags&ctx_w4_to_w1),
        w3_to_w1(flags&ctx_w3_to_w1),
        w2_to_w1(flags&ctx_w2_to_w1) {}
};

struct ModelBlock {
  uint32_t width;
  int32_t height;
  uint32_t depth;
  uint32_t depth_raw;
  uint32_t alphabet;
  uint32_t ctx_id1_used;
  uint32_t ctx_id2_used;
  uint32_t ctx_id3_used;
  uint32_t hit;
  uint32_t ctx_state_seen;
  // The same margin pair as the two alternate blocks.  Here the deepest static
  // subscript is `row[-8]` in `record_sample` while the margin is 7, and the
  // two are not in conflict: that read happens after the five `++row_cur[k]`,
  // so the cursor has already stepped at least one record into the row.  A
  // margin that has to be reasoned about together with a cursor bump is
  // exactly the kind of thing Stage 2 Section 12.11 says nothing documents.
  //
  // The runtime side of it is ASan, which walks all nineteen images clean;
  // what these add is the *name*, so the 7 in `ring_advance` and the 16 in the
  // allocation stop being two unrelated numbers.
  static const int32_t kRowMargin = 7;
  static const int32_t kRowTail = 9;

  uint32_t bucket_idx;
  uint32_t sym_pos;
  uint32_t ctr_fallback;
  uint32_t ctr_node;
  PixRec* row_cur[10];
  // The frequency grid: 349 buckets of 188 records, plus the 111 the
  // `id2 + kFreqTableOffset` reads below reach past the last bucket's base.
  // `65723` is what the decompilation had and it is not a round number in any
  // base; the two readings that produce it are written here so the next reader
  // does not have to find one.
  static const int32_t kFreqTableOffset = 188;
  static const int32_t kFreqGridCount = 65723;
  FreqRec grid[kFreqGridCount];
  uint8_t _pad1051664[16];
  BitCtr bit_root[16];
  BitCtr bit_node[4096];
  BitCtr esc_ctr[257];
  BitCtr run_ctr[48];
  uint8_t _pad16[2];
  SymList escape;
  SymList* sel1_list;
  SymList* sel0_list;
  SymList* sel[2];
  SymList* escape_list;
  uint8_t _pad22[4];
  SymList** sel_cur;
  uint16_t* sym_word;
  uint32_t* sym_code;
  uint8_t ctx_state[64];
  uint8_t ctx_bucket[375];
  uint8_t _pad25[1];

  // Which bucket a (group, last rank, previous rank) triple names.  Three
  // digits of a mixed-radix number: fifteen context groups, and five values
  // each for the two ranks, because `Neighbours::rank` answers 1..4 for the
  // four neighbours and 0 for anything else.  15 * 5 * 5 = 375, which is the
  // size of the array above -- so the radices are not a description of this
  // index, they are what makes it fit.
  //
  // One place, because there are three sites: the two seeding walks and the
  // read in `context_ids`.  Written inline the two walks became identical for
  // three more lines than they had been and `dupblock.py` went 39 -> 42; a
  // helper is shorter than the chain it replaces, so the ratchet went back to
  // 39 and the 15/5/5 fact stopped being written twice.
  static uint32_t bucket_slot(int32_t group, int32_t last, int32_t prev) {
    return CtxIdx{}.digit<1, 15>(group).digit<15, 5>(last).digit<75, 5>(prev);
  }

  // Seat `bucket` at that slot and hand back its frequency record.  Both
  // seeding walks open their innermost loop with these two lines and diverge on
  // the next one -- one sets the five weights out, the other loops over four of
  // them -- so this is the whole of what they share and it is worth exactly
  // what it removes.
  FreqRec* seat_bucket(int32_t group, int32_t last, int32_t prev,
                       int32_t bucket) {
    ctx_bucket[bucket_slot(group, last, prev)] = (uint8_t)bucket;
    return &grid[bucket];
  }
  uint8_t* run_bucket;
  uint8_t* alpha_map;
  uint8_t grad[4];
  uint16_t sym_ctr[524288];
  SymPair group_ctr[15][65536];
  uint16_t* sym_cache;
  SymPair* pix_cur;
  uint16_t sym_rev[8192];
  uint16_t ctx_id1[192512];
  uint16_t ctx_id2[108800];
  uint16_t ctx_id3[712000];
  // The pair AltP1Block and AltP2Block already have as methods: one lays the
  // workspace out over a fresh allocation and returns `this`, the other gives
  // it back.  Defined out of line in model_workspace.inc.
  ModelBlock*layout_workspace(int32_t img_w, int32_t img_h, int32_t img_depth);
  void free_workspace();

  int32_t pixel_context(uint32_t* nb) {
    int32_t band;
    int32_t pos = sym_pos;
    uint32_t result = (nb)[pos];
    if( exclusion_mask[result]==exclusion_gen )
      return -1;
    bool near = false;
    for( band = 11; band<16; ++band )
      near |= result==nb[band];
    bool far = false;
    for( band = 16; band<32; ++band )
      far |= result==nb[band];
    // Three bits of one context word, written as a multiply chain by the
    // decompiler: whether the symbol is the immediate neighbour, whether it
    // is in bands 11..15, and whether it is in 16..31.
    int32_t near_hit = CtxIdx{}.bit<6>(result==nb[10]).bit<5>(near);
    int32_t far_hit = CtxIdx{}.bit<4>(far);
    int32_t ctx0 = far_hit+near_hit;
    // `ctr_node = ctx0;` was here, `ctr_node = ctx1;` four lines down, and
    // `ctr_fallback = fallback;` in the last `else` -- three stores on the way
    // through, of which only the pair in the taken arm below is ever read.
    // `offer_candidates` is the only caller, and it `continue`s on a negative
    // return without touching either member; the next turn calls back in here,
    // which overwrites both before anything looks at them.
    //
    // Shown rather than argued, because the argument is easy to get wrong.  The
    // three lines execute 601k, 582k and 133k times on `t8g` alone, so a silent
    // gate is not an unexercised one; setting each to 0 in turn leaves all 110
    // checks green, and the same edit on the *live* store below fails 10 of
    // them.
    //
    // The control matters more than it looks.  `ctr_node ^= 1` on the live
    // store is *also* byte-identical, and that proves nothing: `^ 1` is a
    // permutation of `bit_node[4096]`, every entry of which starts memset to
    // zero, so it relabels the whole table and each counter still sees the
    // sequence some counter saw before.  `+ 128` does move four checks -- by
    // pushing the index past 4095 and corrupting the block, which is not
    // observability either.  A perturbation of a counter index is only evidence
    // when it is neither injective nor out of bounds, which is what `&= ~1` is.
    if( (far_hit+near_hit==0)&&pos>6 )
      return -1;
    SymList* sel0 = sel0_list;
    int32_t ctx1 = CtxIdx{}.bit<3>(sym_in_top((sel0[mode_symbol[1]].ent), 10, result)).raw(ctx0);
    SymEntry *list_prev = sel0[mode_symbol[2]].ent;
    SymEntry *list_sym = sel0[result].ent;
    // The low three bits: is the symbol near the top of the previous
    // symbol's list, of its own, and of the one before that.
    int32_t fallback = CtxIdx{}.bit<2>(sym_in_top(list_prev, 4, result))
                               .bit<1>(sym_in_top(list_sym, 10, mode_symbol[2]))
                               .bit<0>(sym_in_top((sel0[mode_symbol[3]].ent), 6, result));
    int32_t ctx2 = fallback+ctx1;
    if( pos<=14||(ctx2&0xB)!=0 ) {
      ctr_node = CtxIdx{}.above<7>(pos).raw(ctx2);
      ctr_fallback = CtxIdx{}.bit<3>(pos>9).raw(fallback);
    } else {
      return -1;
    }
    return result;
  }

  int32_t init_tables() {
    SymList** cur;
    bool promoted;
    SymList* list, ** prev;
    int32_t recycled, hit1;
    uint32_t hit0 = hit;
    if( !hit0 ) {
      if( sel==sel_cur ) {
        if( sel[0] ) {
          sel0_list[mode_symbol[1]].add_weight(row_cur[5]->sym, 3u);
          sel0_list[row_cur[5]->sym].add_weight(mode_symbol[2], 2u);
          sel1_list[mode_symbol[1]].add_weight(row_cur[5]->sym, 4u);
          sel1_list[row_cur[5]->sym].add_weight(mode_symbol[1], 2u);
        } else {
          sel0_list[mode_symbol[2]].add_weight(row_cur[5]->sym, (sym_pos>3)+2);
        }
      } else {
        sel0_list[mode_symbol[1]].add_weight(row_cur[5]->sym, 3u);
        sel0_list[row_cur[5]->sym].add_weight(mode_symbol[2], 2u);
        sel0_list[row_cur[5]->sym].add_weight(mode_symbol[1], 1u);
        sel1_list[row_cur[5]->sym].add_weight(mode_symbol[1], 2u);
        cur = sel_cur;
        do {
          prev = cur-1;
          sel_cur = prev;
          list = *prev;
          uint16_t want = row_cur[5]->sym;
          uint32_t n_live = list->live;
          SymEntry *ent = list->ent;
          if( n_live==list->n ) {
            list->live = --n_live;
            recycled = list->ent[n_live].cnt;
          } else {
            recycled = 1;
          }
          SymEntry *slot = &ent[n_live];
          list->live = n_live+1;
          list->tot = recycled+list->tot+1;
          slot->set(want, 2);
          list->since_rescale += 4;
          if( slot!=list->ent ) {
            uint16_t sym = slot->sym;
            uint8_t cnt = slot->cnt;
            slot[0] = slot[-1];
            slot[-1].set(sym, cnt);
          }
          cur = sel_cur;
        } while( cur!=sel );
      }
      if( exclusion_gen==-1 ) {
        exclusion_gen = 1;
        uint8_t *buf = (uint8_t*)exclusion_mask;
        uint32_t blocks = (alphabet+15)>>4;
        do {
          bmf_zero16(buf);
          buf += 16;
          --blocks;
        } while( blocks );
        hit1 = hit;
      } else {
        ++exclusion_gen;
        hit1 = hit;
      }
      promoted = hit1&&hit1<=2;
    } else {
      promoted = hit0<=2;
      if( !promoted&&mode_symbol[3]!=mode_symbol[4] ) {
        sel0_list[mode_symbol[2]].add_weight(row_cur[5]->sym, 1u);
        hit1 = hit;
        promoted = hit1&&hit1<=2;
      }
    }
    if( !promoted ) {
      // Move-to-front over the eight-entry symbol cache: find the symbol just
      // coded, slide everything above it down one, and put it at the front.
      //
      // This was an eight-deep `if`/`else` nest with the slide unrolled into
      // every arm -- a linear search with its loop written out and its counter
      // spelled as the depth of the nesting, which is what put this body at
      // nesting depth 9.  Seven arms named the entry they had just read (`c0`
      // to `c6`) and `cache` was a second name for `sym_cache`, used
      // interchangeably between the two halves of the same arm.
      //
      // Only slots 1..6 are searched, which is the original's reach and not a
      // simplification: nothing tests slot 7.  A miss therefore lands on 7,
      // and the deepest arm's `cache[7] = c6` is exactly the store the slide
      // makes for `k == 7` -- so not-found is found-at-the-end and needs no
      // arm of its own.
      //
      // The slide runs downward because the turns touch the same places; the
      // three arms that had it as a loop already said so.
      int32_t just = row_cur[5]->sym;
      if( just!=sym_cache[0] ) {
        int32_t k = 7;
        for( int32_t i = 1; i<7; ++i )
          if( just==sym_cache[i] ) {
            k = i;
            break;
          }
        for( int32_t i = k; i>0; --i )
          sym_cache[i] = sym_cache[i-1];
        sym_cache[0] = just;
      }
    }
    pix_cur->prev = pix_cur->last;
    pix_cur->last = row_cur[5]->sym;
    {
      PixRec*const here = row_cur[5];
      PixRec*const up = row_cur[6];
      here->match[0] = here->sym==up->sym;
      here->match[1] = here->sym==here[-1].sym;
      here->match[2] = here->sym==up[1].sym;
      here->match[3] = here->sym==up[-1].sym;
      here->match[4] = here->sym==up[2].sym;
      here->match[5] = here->sym==up[3].sym;
    }
    // Five cursors stepped by one.  Three of the five were written as an alias
    // created, incremented and stored back -- `up1`, `up2`, `row` -- because
    // MSVC needed the incremented value in a register for the reads below; the
    // other two were already `++row_cur[k]`.
    ++row_cur[5];
    ++row_cur[6];
    ++row_cur[7];
    ++row_cur[8];
    ++row_cur[9];
    PixRec *const row = row_cur[5];
    PixRec *const up1 = row_cur[6];
    PixRec *const up2 = row_cur[7];
    grad[0] += up1[4].match[0]-up1[-4].match[0];
    grad[1] += up2[4].match[0]-up2[-4].match[0];
    grad[2] += row[-1].match[1]-row[-5].match[1];
    int32_t result = row[-1].match[0]-row[-8].match[0];
    grad[3] += result;
    return result;
  }

  // The two lists a pixel is searched through, loaded, and where that search
  // resumes.  `sel_cur` walks `sel` and is left wherever the last pixel
  // stopped, so both coders reload the pair before every search -- the same
  // three lines in `code_pixel` and `decode_pixel`, and the last thing the two
  // still had in common.
  SymList** load_selectors() {
    sel[0] = &sel0_list[mode_symbol[2]];
    sel[1] = &sel1_list[mode_symbol[1]];
    return sel_cur;
  }

  // Start a row: rotate the five record rows by one, reseat the five cursors
  // seven records into the rows they now point at, and seed the six `match`
  // bytes the first samples of the row would otherwise read from the row
  // before it.
  //
  // Written out in both `model_plane` and `unmodel_plane`, and the eleven
  // lines of the rotation are `ring_advance` -- the same template the p1 and
  // p2 rings use, here over `row_cur[0..4]` with `row_cur[5..9]` as its
  // cursors.  The copies spelled it through five named temporaries, which is
  // what hid the shape: `row_cur[5]` is `row_cur[0] + 7` and so on down.
  void start_row() {
    row_cur[5]->match[1] = row_cur[5][-1].sym==0;
    row_cur[5]->match[3] = row_cur[6][-1].sym==0;
    ring_advance(row_cur, row_cur+5, kRowMargin);
    uint8_t zero = row_cur[6][1].sym==0;
    row_cur[5]->match[2] = zero;
    row_cur[5][-1].match[4] = zero;
    row_cur[5][-2].match[5] = zero;
    zero = row_cur[6][2].sym==0;
    row_cur[5]->match[4] = zero;
    row_cur[5][-1].match[5] = zero;
    row_cur[5]->match[5] = row_cur[6][3].sym==0;
  }

  // The twenty-two neighbours the escape context is built from, in the order
  // `pixel_context` reads them: rows 5 to 8 of the workspace at fixed offsets
  // from the sample being coded, and one from row 9.  Slots 0 and 1 are the
  // two most recent symbols seen at this position and 2..9 the symbol cache;
  // those stay at the call sites, which hold them under different names.
  //
  // `code_pixel` and `decode_pixel` each wrote the twenty-two out a line
  // apiece over the same four rows under different names -- `up5` against
  // `r6`, `r8c` against `r7` -- which is why nothing comparing text could see
  // they were the same table.
  //
  // The decompilation had them interleaved with the twenty-four loads that
  // feed them, each load under a name of its own, `h10` through `h31`, because
  // MSVC scheduled them that way.  Every one was used exactly once, and
  // nothing here writes `row_cur`, so the order is free.
  // The 32 candidate symbols this pixel is coded against, in slot order: 0 and
  // 1 the two most recent at this context, 2..9 the move-to-front cache, and
  // 10..31 the spatial neighbours widening outward.
  //
  // Both pixel coders fill it and both reached the same two members through a
  // local of their own -- `pixr` and `wq` for `pix_cur`, `cache` for
  // `sym_cache` -- and the encoder then spelled the first two slots into `w6d`
  // and `wq1` before storing them.  Six names for three members.
  // The 32 candidates offered one at a time.  Each valid one costs a single
  // context bit -- is this the symbol? -- and a hit ends the pixel; a miss
  // stamps the candidate excluded so no later list offers it again.  Answers
  // the symbol, or -1 when all 32 miss.
  //
  // The decoder stores the candidate into the record before it reads the bit
  // and the encoder reads the record to make the bit; that is the whole of the
  // difference, and it is why this answers the symbol rather than storing it.
  // On a full miss both leave the *last* valid candidate sitting in the record,
  // which the escape path below then overwrites.
  //
  // `sym_pos` is a member because `pixel_context` indexes the candidate list by
  // it, and it is still live after this returns -- `update_selector` reads
  // `sym_pos > 3`.  A hit leaves it at the hit's index and a full miss at 32,
  // which is what the two `do`/`while`s left.
  template<int32_t f_DEC>
  int32_t offer_candidates(int32_t* nb_sym) {
    for( sym_pos = 0; sym_pos<32; ++sym_pos ) {
      const int32_t sym = pixel_context((uint32_t*)nb_sym);
      if( sym<0 )
        continue;
      // `is_sym` and not `hit`: `hit` is a member of this block, carrying an
      // answer from the stage-one coder to three other methods.
      int32_t is_sym;
      if constexpr( f_DEC ) {
        is_sym = bit_node[ctr_node].decode_context_bit(&bit_root[ctr_fallback]);
        row_cur[5]->sym = sym;
      } else {
        is_sym = sym==row_cur[5]->sym;
        bit_node[ctr_node].encode_context_bit(&bit_root[ctr_fallback], is_sym);
      }
      if( is_sym )
        return sym;
      exclusion_mask[sym] = exclusion_gen;
    }
    return -1;
  }

  // The four symbols the stage-one coder already offered, and the escape,
  // stamped with this generation so the candidate walk below does not offer
  // any of them again.
  //
  // Both coders spelled `exclusion_gen` into a local and three of the four
  // `mode_symbol` slots into three more -- `msym3`, `msym2`/`excl_sym_a`,
  // `msym1`/`excl_sym_b` -- while reading the fourth straight out of the
  // table.  Eight names for five stores of one value, which is also why the
  // order does not matter: every one of them writes `exclusion_gen`.
  // The two context ids this pixel is coded in, and the bucket they hang off.
  // `sig1` is four "is this gradient flat" bits, two "did four rows above all
  // match" bits, the bucket from 10 up and `nb2`'s four underneath; `sig2`
  // narrows the interned `id1` with three more bits taken from records the
  // intern miss may have just reloaded.  Answers `id2`, and leaves the bucket
  // in `bucket_idx` where the frequency table is picked off it.
  //
  // Both pixel coders build this and the decompilation gave every value in it
  // a different name on each side: `r8`/`r1` and `r7`/`r2` for `row_cur[8]`
  // and `row_cur[7]`, `row`/`cur5` for the row cursor, `up_m0`/`up_match0`
  // for the borrowed slot, `match1` for a `cur6->match[1]` the other read
  // directly.  The decoder also named `all_up` -- the bucket and the two run
  // bits -- and folded it in with a `raw`, where the encoder wrote one chain.
  // `CtxIdx` adds rather than ORs and the terms do not overlap, so the two
  // orders are the same sum.
  //
  // The encoder cast the two run bits to `uint8_t` and the decoder did not.
  // Every `match` byte in this program is a comparison, an `&` of two of
  // those, a copy of another record's byte, or the `0x01010101` two sites
  // store through the union -- so the byte is 0 or 1, the `&` chain is 0 or 1,
  // and the two readings agree.
  //
  // The reload of the row cursor inside the miss is dead and kept: `row` and
  // `cur5` are both `row_cur[5]` on entry, nothing between reassigns either,
  // and neither is read after this returns.
  int32_t context_ids(int32_t state, int32_t cap) {
    PixRec *const cur6 = row_cur[6];
    PixRec *const r8 = row_cur[8];
    PixRec *const r7 = row_cur[7];
    PixRec *const up9 = row_cur[9];
    PixRec *const row = row_cur[5];
    const int32_t bucket_at = ctx_bucket[state+cap];
    bucket_idx = bucket_at;
    const int32_t up_m0 = cur6->match[0];
    const uint32_t nb2 = CtxIdx{}.bit<3>(row[-2].match[2])
                                 .bit<2>(row[-2].match[5])
                                 .bit<1>(row[-2].match[4])
                                 .bit<0>(row[-1].match[1]);
    const uint32_t sig1 =
        CtxIdx{}.bit<7>(grad[3]==0).bit<6>(grad[2]==0)
                .bit<5>(grad[1]==0).bit<4>(grad[0]==0)
                .bit<9>(up9->match[0]&r8->match[0]&up_m0&r7->match[0])
                .bit<8>(up9->match[1]&r8->match[1]&r7->match[1]&cur6->match[1])
                .above<10>(bucket_at).raw(nb2);
    // Both coders reloaded three things on the intern miss -- the row-6
    // cursor into a second name, the row-5 cursor, and `up_m0` -- and all
    // three are re-reads of values the intern cannot have moved: `ctx_id1` is
    // a `uint16_t` table and `row_cur` is an array of pointers beside it, so
    // the store to `ctx_id1[sig1]` reaches neither.  What the decompiler is
    // showing is the compiler reloading across a store it could not prove
    // did not alias.  The seventeen streams say the same.
    int32_t id1;
    intern_ctx(ctx_id1, sig1, ctx_id1_used, id1);
    const uint32_t sig2 = CtxIdx{}.bit<2>(cur6[1].match[3]).bit<1>(up_m0)
                                  .bit<0>(row[-1].match[5]).above<3>(id1);
    int32_t id2;
    intern_ctx(ctx_id2, sig2, ctx_id2_used, id2);
    return id2;
  }

  // Intern a context signature: a dense id per distinct signature, minted in
  // first-seen order, with `0xFFFF` the empty slot.  Answers whether the
  // signature had *not* been seen, which the two `sig1` sites need -- they
  // reload two row cursors and a neighbour slot on exactly that path.
  //
  // Four sites, two per pixel coder.  Every one of them read the table back
  // after storing rather than using the value it had just stored; that is what
  // the decompilation makes of a store followed by a reload, and it is why the
  // four looked like six lines instead of three.
  static bool intern_ctx(uint16_t* tbl, int32_t sig, uint32_t& used,
                         int32_t& id) {
    const bool minted = tbl[sig]==0xFFFF;
    if( minted )
      tbl[sig] = used++;
    id = tbl[sig];
    return minted;
  }

  // How far the north row's "matched" flags run on from here, capped by the
  // rest of the row, and the AND of the north-north row's `match[0]` over that
  // run.  Answers the length.
  //
  // Both pixel coders scan it.  `run` trails the counter by a turn -- it is the
  // last index whose flags were tested, which is what the escape context below
  // indexes with -- and the encoder mirrored the counter into a slot of the
  // candidate table at all three exits where the decoder just used its own
  // counter.  Each also reached the tail through a `goto run_copied` out of
  // the loop, which a `return` is.
  int32_t run_scan(const PixRec* up1, const PixRec* up2, int32_t limit,
                   int32_t& m_up0, int32_t& run) {
    m_up0 = up2[0].match[0];
    if( limit<=1 ) {
      run = 1;
      return 1;
    }
    int32_t n = 1;
    while( 1 ) {
      run = n;
      if( !(up1[n+2].match[1]&up1[n+2].match[0]) )
        return n;
      m_up0 = (uint8_t)(up2[run].match[0]&m_up0);
      if( ++n>=limit ) {
        run = n;
        return n;
      }
    }
  }

  void exclude_stage_one() {
    const int8_t gen = exclusion_gen;
    for( int32_t k = 1; k<5; ++k )
      exclusion_mask[mode_symbol[k]] = gen;
    exclusion_mask[no_symbol] = gen;
  }

  // The four ranked neighbours of the pixel at the cursor, and the four
  // `mode_symbol` slots that carry them for the rest of the pixel.  Both pixel
  // coders open with exactly this; they spelled it with two different sets of
  // `nb_sym` slots and so it did not read as one thing.
  Neighbours rank_neighbours() {
    const PixRec* up = row_cur[6];
    const PixRec* west = row_cur[5];
    const Neighbours n = { up->sym, west[-1].sym, up[1].sym, up[-1].sym };
    mode_symbol[1] = n.up;
    mode_symbol[2] = n.left;
    mode_symbol[3] = n.up_next;
    mode_symbol[4] = n.upleft;
    return n;
  }

  // Six match flags of the four named neighbours, as six bits.
  //
  // The decoder folded two of the six into one `raw` term, `N.match[1] +
  // 4*(NE == NW)`, which is the same word only because `match[1]` is 0 or 1 --
  // and it is: the two places that write it write a comparison.
  uint32_t match_context(const Neighbours& n, const PixRec* up,
                         const PixRec* west) const {
    return CtxIdx{}.bit<5>(west[-1].match[2]).bit<4>(west[-1].match[4])
                   .bit<3>(up[1].match[1]).bit<2>(n.up_next==n.upleft)
                   .bit<1>(west[-1].match[0]).bit<0>(up->match[1]);
  }

  // The key into the symbol-pair tables: the north neighbour's reverse-table
  // entry less whichever of the other three first disagrees with it, and less
  // the second neighbour west when all four agree.
  //
  // Both coders wrote this as a nest of three `if`s with the disagreements
  // tested inside out, so the run of "first one that differs" was spelled
  // backwards; one of them widened the table entry through an `int16_t` and
  // the other through a `uint16_t`, which the cast at the end makes the same
  // sixteen bits either way.
  uint16_t pair_key(const Neighbours& n, const PixRec* west) const {
    if( n.up!=n.left )
      return (uint16_t)(sym_rev[n.up]-n.left);
    if( n.up!=n.up_next )
      return (uint16_t)(sym_rev[n.up]-n.up_next);
    if( n.up!=n.upleft )
      return (uint16_t)(sym_rev[n.up]-n.upleft);
    return (uint16_t)(sym_rev[n.up]-west[-2].sym);
  }

  // Everything both pixel coders work out before they part: the four ranked
  // neighbours, the six-bit match context, the pair key, the context state,
  // the symbol pair, and the second-level context id -- with a third level
  // lazily allocated under it when the alphabet is small enough to want one.
  //
  // The encoder then asks where a known symbol ranks and the decoder asks
  // which rank holds a target.  *That* is where the two genuinely diverge, and
  // everything above it was these twenty-eight lines written twice.  They did
  // not read as one thing because the four neighbours sat in two arbitrary
  // sets of scratch slots; once those became `Neighbours`, what was left
  // between the two copies was three spellings -- a `bool` one of them tested
  // twice, an extra name for `sig3`'s masked form in the other, and two of the
  // six match bits folded into one `raw` term.
  //
  // `nb4` comes back by reference because both bodies rank against it again
  // further down; everything else here is a member or is dead at the return.
  int32_t open_pixel(Neighbours& nb4, const PixRec* up, const PixRec* west) {
    nb4 = rank_neighbours();
    const int32_t nb = match_context(nb4, up, west);
    const int32_t key = pair_key(nb4, west);
    // The key's row of the eight-entry cache: the key from bit 3 up, and the
    // three bits under it are the slot within the row that `sym_cache[0..7]`
    // then walks.
    sym_cache = &sym_ctr[CtxIdx{}.above<3>(key)];
    const int32_t state = ctx_state[nb];
    ctx_state_seen = state;
    SymPair*const pair = &group_ctr[state][key];
    pix_cur = pair;
    // The pair's two symbols ranked against the four neighbours, at fifteen
    // and seventy-five to the rank.  Five chains between the two coders
    // spelled the four literals of their own scale into the arms; one of them
    // reached rank 4 through an `else` that sets 60 and then takes it back,
    // and another through a `bool` it had finished with eighteen lines above.
    const int32_t cap = 15*nb4.rank(pair->last)+75*nb4.rank(pair->prev);
    int32_t id2 = context_ids(state, cap);
    if( (int32_t)alphabet<32 ) {
      // A third level under the second: four bits of the west neighbour's
      // symbol beneath the id, with the id for that pair allocated the first
      // time it is seen.  Past `kCtxId3Limit` ids the four bits are forced to
      // 15, which
      // merges those sixteen contexts into one rather than allocating past the
      // table.
      int32_t id3_used = ctx_id3_used;
      int32_t sig3 = CtxIdx{}.bits<0, 4>(nb4.left).above<4>(id2);
      uint16_t* id3p = &ctx_id3[sig3];
      id2 = *id3p;
      if( id2==0xFFFF ) {
        if( id3_used>kCtxId3Limit )
          sig3 |= 0xF;
        id3p = &ctx_id3[sig3];
        id2 = *id3p;
      }
      if( id2>=id3_used ) {
        *id3p = id3_used;
        ++ctx_id3_used;
        id2 = *id3p;
      }
    }
    return id2;
  }

  // The records a coded run covers, each taking the symbol, the head word and
  // the flag word of the one before it.
  //
  // The decoder wrote one record a turn.  The encoder's half was unrolled by
  // two, and the second copy of the three stores went through `pixp`, a second
  // name for a `pix_cur` the first copy had not moved -- so the pair loop
  // wrote the same `prev` twice and advanced the row cursor twice, which is
  // two turns of this.
  void fill_run(int32_t sym, uint32_t head_word, uint32_t flags_word,
                uint32_t n) {
    for( uint32_t k = 0; k<n; ++k ) {
      pix_cur->prev = sym;
      row_cur[5]->head4 = head_word;
      row_cur[5]->match2345 = flags_word;
      ++row_cur[5];
    }
  }

  // The four gradient seeds and the two match flags a coded run leaves behind.
  // Both pixel coders write these eight lines, and each wrapped them in a spill
  // of an unrelated local -- `idx_s` in the decoder and `runlen` in the encoder
  // -- saved above and loaded back below with nothing between touching either.
  void seed_after_run(PixRec* cur, int32_t sym) {
    PixRec*const r4 = row_cur[6];
    PixRec*const up3 = row_cur[7];
    grad[0] = match_seed_split(r4);
    grad[1] = match_seed(up3-3, 8);
    grad[2] = match_seed(cur-4, 2, 1);
    grad[3] = match_seed(cur-7, 4);
    cur[-1].match[4] = sym==r4[1].sym;
    row_cur[5][-1].match[5] = sym==row_cur[6][2].sym;
  }

  void seed_candidates(int32_t* nb_sym) {
    nb_sym[0] = pix_cur->last;
    nb_sym[1] = pix_cur->prev;
    for( int32_t c = 0; c<8; ++c )
      nb_sym[2+c] = sym_cache[c];
    load_neighbours(nb_sym);
  }

  void load_neighbours(int32_t* nb_sym) {
    const PixRec *const r5 = row_cur[5], *const r6 = row_cur[6],
                 *const r7 = row_cur[7], *const r8 = row_cur[8];
    nb_sym[10] = r5[-2].sym;
    nb_sym[11] = r6[2].sym;
    nb_sym[12] = r7[1].sym;
    nb_sym[13] = r7->sym;
    nb_sym[14] = r6[-2].sym;
    nb_sym[15] = r7[-1].sym;
    nb_sym[16] = r5[-3].sym;
    nb_sym[17] = r6[3].sym;
    nb_sym[18] = r6[4].sym;
    nb_sym[19] = r5[-4].sym;
    nb_sym[20] = r6[-3].sym;
    nb_sym[21] = r7[2].sym;
    nb_sym[22] = r8->sym;
    nb_sym[23] = r7[-2].sym;
    nb_sym[24] = r5[-5].sym;
    nb_sym[25] = r8[1].sym;
    nb_sym[26] = r6[5].sym;
    nb_sym[27] = row_cur[9]->sym;
    nb_sym[28] = r5[-7].sym;
    nb_sym[29] = r8[-1].sym;
    nb_sym[30] = r6[7].sym;
    nb_sym[31] = r7[3].sym;
  }

  // Both selector lists, one entry per symbol of the alphabet.  Written out at
  // the end of `expand_alphabet` and again in `model_plane`'s allocation, the
  // same seven lines with the same two capacities: 99 for the list that walks
  // by weight and 33 for the one that walks by symbol.
  void init_symbol_lists() {
    for( uint32_t s = 0; s<alphabet; ++s ) {
      sel1_list[s].init(99, 0);
      sel0_list[s].init(33, 0);
    }
  }

  // Everything a block needs before its first pixel that depends on the
  // alphabet: the per-symbol exclusion map seeded to one, the escape list, the
  // selector cursor, and the two selector lists.  Both plane coders wrote this
  // out; the decoder's copy read the same object under two more names.
  void seed_alphabet() {
    BMF_ASSUME(alphabet>0&&alphabet<=no_symbol+1);
    uint8_t* map = alpha_map_store;
    alpha_map = map;
    memset(map, 1, alphabet);
    escape_list = &escape;
    escape.init(alphabet, 1);
    sel_cur = sel;
    sel1_list = new_sym_lists(alphabet);
    sel0_list = new_sym_lists(alphabet);
    init_symbol_lists();
  }

  void expand_alphabet() {
    SymList lists[16];
    int32_t left2, left;
    uint32_t n_syms, j, carry;
    uint32_t bits = depth;
    uint32_t mask = 0xFFFFFFFF>>(-(uint8_t)depth&31);
    uint32_t nbytes = (bits+7)>>3;
    clear_sym_lists(lists);
    uint32_t cap = mask+1;
    if( bits>8 )
      cap = no_symbol+1;
    uint32_t n_1 = rc_decode_flat(cap);
    alphabet = n_1+1;
    if( (int32_t)(n_1+1)<=0x2000 ) {
      void* codes = sym_code_store;
      // `n_syms` was re-read from `alphabet` at four points of this body, and
      // `codes_p` from `sym_code` at two more, across loops that touch
      // neither.  One read of each.
      n_syms = alphabet;
      sym_code = (uint32_t*)codes;
      for( j = 0; j<n_syms; ++j )
        sym_code[j] = j;
      if( (int32_t)depth>8 ) {
        init_byte_lists(lists, nbytes);
        if( n_syms ) {
          // Guarded by `if( alphabet )` above.
          carry = 0;
          for( uint32_t s = 0; s<alphabet; ++s ) {
            sym_code[s] = 0;
            for( uint32_t b = 0; b<nbytes; ++b ) {
              uint32_t piece = lists[4*b+carry].decode_symbol_list();
              carry = piece>>6;
              sym_code[s] += piece<<((8*b)&31);
            }
            carry = (uint8_t)sym_code[s]>>7;
          }
        }
      } else if( n_syms<=mask ) {
        lists[0].init(mask-n_syms+2, 1);
        lists[0].rescale_at = 19*lists[0].n;
        if( alphabet ) {
          int32_t run = 0;
          for( uint32_t s2 = 0; s2<alphabet; ++s2 ) {
            int32_t gap = lists[0].decode_symbol_list();
            sym_code[s2] = gap+run;
            run += gap+1;
          }
        }
      }
      for( left = 15; left>=0; --left )
        free(lists[left].ent);
    } else {
      depth = 8;
      height = height*nbytes;
      expand_alphabet();
      for( left2 = 15; left2>=0; --left2 )
        free(lists[left2].ent);
    }
  }

  // One decoded row written out, at whatever width the stream is: four arms
  // chosen by `nbytes` and then, for the narrowest, by `depth`.  Answers where
  // the next row starts.
  //
  // The decompilation reached the arms with `goto list_ready` out of the row
  // loop and four `goto next_list` back into it, and the two places that write
  // a row are the two calls below -- the second reached only by the `break`
  // that a zero-width image takes, where every arm's `row_w > 0` guard is
  // false and the whole of it is a no-op.  That is why both sites can be the
  // same call: the arm `nbytes` selects there writes nothing either way.
  //
  // `row_w` is the guard the four carried and it is kept rather than dropped.
  // It is `width` re-read after the pixel loop, so on every path that decodes
  // anything it is `width` and non-zero; on the one path where it is zero it
  // is what makes this do nothing.
  // One row of symbols out at a fixed store width.  Three of `write_row`'s
  // four arms are this walk with a different cursor type -- `uint32_t`,
  // `uint16_t`, `uint8_t` -- and the narrowest of the three was the only one
  // that spelled the cast the other two make implicitly.
  template<class T>
  uint8_t* write_row_at(uint8_t* out_at) {
    // `row_cur[0][i+++8]` is `row_cur[0][(i++) + 8]`; the increment is the
    // loop's own and belongs on a line of its own.  The `do` stays a `do`:
    // `write_row`'s guard is `row_w`, not `width`, and the comment above says
    // the two are equal on every path that decodes anything -- which is a claim
    // about the caller, not something to rest a first-iteration difference on.
    T* out = (T*)out_at;
    uint32_t i = 0;
    do {
      *out++ = (T)sym_code[row_cur[0][i+8].sym];
      ++i;
    } while( i<width );
    return (uint8_t*)out;
  }

  uint8_t* write_row(uint8_t* out_at, uint32_t nbytes, uint32_t row_w) {
    if( row_w<=0 )
      return out_at;
    if( nbytes==4 )
      return write_row_at<uint32_t>(out_at);
    if( nbytes==3 ) {
      // Guarded by `row_w <= 0` at the top, so the `do` had nothing to carry.
      // `x6` and `x7` were MSVC's two registers for `sym_code` and the symbol
      // it indexes -- the table is a member and the symbol is one subscript.
      SymEntry *out_ent = (SymEntry*)out_at;
      for( uint32_t step = 0; step<width; ++step, ++out_ent ) {
        const uint32_t code = sym_code[row_cur[0][step+8].sym];
        out_ent->set((uint16_t)code, (uint8_t)(code>>16));
      }
      return (uint8_t*)out_ent;
    }
    if( nbytes==2 )
      return write_row_at<uint16_t>(out_at);
    if( depth==8 )
      return write_row_at<uint8_t>(out_at);
    // Sub-byte depths, packed high bits first.  `out_bits` starts one byte
    // *before* the row and the first symbol's `bits < 0` moves it on, which is
    // why the pre-increment is on the store and not on the cursor.
    // `(8-bpp)&31` and `bits&31` are dead masks: this path is reached only for
    // sub-byte depths, so `bpp` is 1, 2 or 4 and both counts are under 8.
    int32_t bits = 0;
    uint8_t *out_bits = out_at;
    const int32_t bpp = depth;
    for( uint32_t x = 0; x<width; ++x ) {
      const uint32_t code = sym_code[row_cur[0][x+8].sym];
      bits -= bpp;
      if( bits<0 ) {
        bits = 8-bpp;
        *++out_bits = code<<(8-bpp);
      } else {
        *out_bits |= code<<bits;
      }
    }
    return out_bits;
  }

  // Open a row: advance the five cursors past the margin `start_row` reseated
  // them at, and rebuild the two gradient seeds the context reads from the two
  // rows above.
  //
  // Both plane coders open every row with exactly these nine lines.  They were
  // not visible as one thing while each spelled the cursor bumps as
  // load-modify-store through a local of its own -- `up1`/`up2` on one side and
  // `lists`/`t` on the other -- and normalising the two row walks in Phase 2 is
  // what put them side by side.
  // Every pixel of a row, in whichever direction.  Both coders answer how many
  // pixels they consumed -- a run takes several -- so the step is the body's.
  //
  // Four lines, and the fifteenth `template<int32_t f_DEC>` pair in this tree.
  // They became a visible copy of each other in Phase 2: while one was a
  // `do`/`while` on `x2` and the other the same loop with its counter written
  // through `y`, nothing lined them up.
  template<int32_t f_DEC>
  void code_row_pixels() {
    for( uint32_t x2 = 0; x2<width; ) {
      x2 += f_DEC ? decode_pixel(x2) : code_pixel(x2);
      init_tables();
    }
  }

  void begin_row() {
    start_row();
    ++row_cur[5];
    ++row_cur[6];
    ++row_cur[7];
    ++row_cur[8];
    ++row_cur[9];
    grad[0] = match_seed(row_cur[6], 5);
    grad[1] = match_seed(row_cur[7], 5);
    grad[2] = 0;
    grad[3] = 0;
  }

  // One plane through the main model, encoding.  The mirror of
  // `unmodel_plane_slow` above, and it was written out inside `model_plane`
  // where its inverse was a call -- 130 lines of `blk->` against
  // `blk->unmodel_plane_slow(out)`.
  //
  // That asymmetry is the same one `AltP1Block::d8_body` had, and it has the
  // same effect on the measurement: `pairshare.py` was comparing a body
  // against a call and reporting what the two *wrappers* share.  With both
  // sides named, the pair is 4 of 146 -- and those four are the allocation
  // and the free, which is where the two genuinely agree.  The bodies do not:
  // the encoder seeds fifteen context groups and the alphabet before its row
  // walk, and the decoder reads all of that back off the stream.
  void model_plane_slow(uint8_t* pixels) {
    int16_t w1;
    int32_t w3, w4, y;
    uint16_t w2;
    rc_begin_encode();
    reduce_alphabet(this, pixels);
    int32_t bucket = 0;
    // Fifteen groups, five ranks, five ranks -- constant bounds, so the `do`'s
    // guaranteed first turn was never carrying anything.
    for( int32_t g = 0; g<15; ++g ) {
      int32_t flags = ctx_group_flags[g];
      ctx_state[flags] = g;
      // Hoisted out of the two loops below, as the original has it.
      const GroupFolds fold(flags);
      for( int32_t lo = 0; lo<5; ++lo ) {
        for( int32_t hi = 0; hi<5; ++hi ) {
          FreqRec* rec = seat_bucket(g, lo, hi, bucket);
          int32_t alpha = alphabet;
          w1 = 2;
          rec->w[0] = 2;
          w2 = 2;
          w3 = 2;
          w4 = 2;
          if( fold.w3_double ) {
            w3 = 4;
            w4 = 0;
          }
          if( fold.w4_to_w2 ) {
            w2 = w4+2;
            w4 = 0;
          }
          if( fold.w3_to_w2 ) {
            w2 = w3+w2;
            w3 = 0;
          }
          if( fold.w4_to_w1 ) {
            w1 = w4+2;
            w4 = 0;
            rec->w[4] = 0;
          } else {
            rec->w[4] = w4;
          }
          if( fold.w3_to_w1 ) {
            w1 += w3;
            w3 = 0;
            rec->w[3] = 0;
          } else {
            rec->w[3] = w3;
          }
          if( fold.w2_to_w1 ) {
            rec->w[1] = w2+w1;
            w2 = 0;
            rec->w[2] = 0;
          } else {
            rec->w[2] = w2;
            rec->w[1] = w1;
          }
          int32_t has3 = w3!=0;
          int32_t has4 = w4!=0;
          if( w2 )
            w2 = 1;
          int32_t lvl = has4+has3+w2+2;
          if( lvl<=alpha ) {
            rec->b14 = lvl;
          } else {
            rec->b14 = has4+has3+w2+1;
            rec->w[0] = 0;
          }
          bucket += rec->seed_pair(lo, hi, alpha);
        }
      }
      // `gctr` rather than `group_ctr`: as a free function this read
      // `blk->group_ctr[g]` and the local could take the member's name.
      SymPair* gctr = group_ctr[g];
      for( uint32_t gi = 0; gi<0x10000; ++gi ) {
        gctr[gi].last = 0x2000;
        gctr[gi].prev = 0x2000;
      }
    }
    seed_alphabet();
    {
      // `y1 = y + 1` and two `y = y1` were the counter written through a second
      // name, and `row_w = width` inside the pixel loop re-read a member the
      // body never writes -- three dead stores per row.  The `if( height > 0 )`
      // and the two `if( row_w > 0 )` guards go with the `do`s they protected.
      //
      // The four load-modify-store bumps -- `up1 = row_cur[6]; ++up1;
      // row_cur[6] = up1;` -- are `++row_cur[6]` with the cursor read back
      // after, which is what `match_seed` wants.
      uint16_t* word = sym_word;
      for( y = 0; y<height; ++y ) {
        begin_row();
        for( uint32_t x = 0; x<width; ++x )
          row_cur[5][x].sym = word[x];
        word += width;
        // `code_pixel` answers how many pixels it consumed -- a run takes
        // several -- so the step is the body's and not the header's.
        code_row_pixels<0>();
      }
    }
    rc_end_encode();
  }

  void unmodel_plane_slow(uint8_t* dst) {
    uint8_t* row[19];
    uint8_t *out_at, *expand_buf;
    int32_t g0, done;
    int32_t lo, w3, w4, w2, lvl_n, n_pix, q2, n_pix2;
    uint8_t *dst_base = &dst[-(depth<8)];
    rc_begin_decode();
    expand_alphabet();
    int32_t g1 = 0;
    // The encoder's nest, mirrored -- and the decompiler gave each level two
    // names, incrementing one and testing the other: `g`/`g0`, `lo`/`lo1`.
    // `g0 = g` at the top and `g = g0 + 1` at the bottom is one counter, and
    // `lo1` was a copy of `lo` that `tools/uncopy.py` reported the moment the
    // loop headers stopped hiding it.
    for( int32_t g = 0; g<15; ++g ) {
      int32_t flags = ctx_group_flags[g];
      ctx_state[flags] = g;
      g0 = g;
      // The same six folds `model_plane` hoists.
      const GroupFolds fold(flags);
      for( lo = 0; lo<5; ++lo ) {
        for( int32_t k = 0; k<5; ++k ) {
          FreqRec *rec = seat_bucket(g, lo, k, g1);
          int32_t m5 = alphabet;
          for( int32_t n = 0; n<4; ++n ) rec->w[1+n] = 2;
          if( fold.w3_double ) {
            w3 = (uint16_t)(rec->w[4]+rec->w[3]);
            rec->w[3] = w3;
            w4 = 0;
            rec->w[4] = 0;
          } else {
            w3 = rec->w[3];
            w4 = rec->w[4];
          }
          if( fold.w4_to_w2 ) {
            w2 = (uint16_t)(w4+rec->w[2]);
            rec->w[2] = w2;
            w4 = 0;
            rec->w[4] = 0;
          } else {
            w2 = rec->w[2];
          }
          if( fold.w3_to_w2 ) {
            w2 = (uint16_t)(w3+w2);
            rec->w[2] = w2;
            w3 = 0;
            rec->w[3] = 0;
          }
          if( fold.w4_to_w1 ) {
            rec->w[1] += w4;
            w4 = 0;
            rec->w[4] = 0;
          }
          if( fold.w3_to_w1 ) {
            rec->w[1] += w3;
            w3 = 0;
            rec->w[3] = 0;
          }
          if( fold.w2_to_w1 ) {
            rec->w[1] += w2;
            w2 = 0;
            rec->w[2] = 0;
          }
          lvl_n = (w3!=0)+(w2!=0)+(w4!=0)+2;
          if( lvl_n<=m5 ) {
            rec->b14 = lvl_n;
            rec->w[0] = 2;
          } else {
            lvl_n = lvl_n-1;
            rec->b14 = lvl_n;
            rec->w[0] = 0;
          }
          g1 += rec->seed_pair(lo, k, m5);
        }
      }
      SymPair* gctr = group_ctr[g0];
      for( int32_t gi = 0; gi<0x10000; ++gi ) {
        gctr[gi].last = no_symbol;
        gctr[gi].prev = no_symbol;
      }
    }
    uint8_t *dst_buf = dst_base;
    seed_alphabet();
    uint32_t jj = depth;
    if( jj==depth_raw ) {
      expand_buf = nullptr;
    } else {
      dst_buf = (uint8_t*)bmf_new(height*width+3);
      jj = depth;
      expand_buf = dst_buf;
    }
    uint32_t nbytes = (jj+7)>>3;
    if( height>0 ) {
      // The encoder's row walk, mirrored, and it carried the same three
      // artefacts: `row_w = width` restated three times inside a body that
      // never writes `width`, the four cursor bumps as load-modify-store
      // through a local, and the counter tested in the `while` with a
      // pre-increment on it.
      out_at = dst_buf;
      for( int32_t bucket = 0; bucket<height; ++bucket ) {
        begin_row();
        code_row_pixels<1>();
        out_at = write_row(out_at, nbytes, width);
      }
    }
    rc_end_decode();
    int32_t bpp_raw = depth_raw;
    // The plane was coded at its own depth, so there is nothing to unpack:
    // a guard with nothing after it, holding thirty-nine lines.
    if( (uint32_t)bpp_raw==depth )
      return;
    int32_t nchunk = (bpp_raw+7)>>3;
    if( nchunk<=0 ) {
      n_pix = height*width;
    } else {
      done = 0;
      n_pix = height*width;
      int32_t chunk = n_pix/nchunk;
      {
        // Five rows a turn while five fit, then one at a time.  Both walks
        // set `row[k] = &expand_buf[chunk*k]`; the unrolled one spells the
        // first of each five through a running cursor and the other four
        // through the subscript, which is why they did not look like one
        // thing.
        int32_t q5 = 0;
        uint8_t *row_at = expand_buf;
        for( ; q5<=nchunk-6; q5 += 5, row_at += 5*chunk ) {
          row[q5] = row_at;
          for( int32_t n = 0; n<4; ++n ) row[q5+1+n] = &expand_buf[chunk*(q5+1+n)];
        }
        done = nchunk>=6 ? q5 : 0;
      }
      for( int32_t q1 = done; q1<nchunk; ++q1 )
        row[q1] = &expand_buf[chunk*q1];
    }
    {
      // `n_pix2 = height*width` was re-read inside the loop; neither factor
      // moves.
      uint8_t *interleave_at = dst;
      n_pix2 = height*width;
      q2 = 0;
      for( int32_t written = 0; written<n_pix2; ++written ) {
        uint8_t *p = row[q2];
        *interleave_at++ = *p;
        row[q2] = p+1;
        if( ++q2==nchunk )
          q2 = 0;
      }
    }
    free(expand_buf);
  }

  // The run's length, one bit per bucket level from the top down.  A bit is
  // coded only at a level that could still belong to a run shorter than `cap`,
  // and `seen` says whether this is the first bit at a level: `bucket` counts
  // *down*, so `bucket == top` is "this is the first turn" and not the
  // tautology it reads as.
  //
  // Both coders wrote this out and they differ in where the bit comes from and
  // in nothing else, down to the order of the rescale against the counter
  // bump.  The decoder counted `bucket` itself down and the encoder kept a
  // second name for it -- `bucket_at` beside `bucket`, with a comment in each
  // body explaining that the comparison of the two is not a tautology -- and
  // both spelled every value in here through a slot of the candidate table.
  //
  // The encoder's `first |= run_bit` accumulated the mask rather than the bit
  // and its counter bump then wrote `n[run_bit != 0]`; with the bit normalised
  // the two arms are the same three lines.  The return is the decoder's
  // answer; the encoder's caller already holds the length and drops it.
  template<int32_t f_DEC>
  int32_t code_run_length(int32_t bucket, int32_t cap, int32_t len) {
    const int32_t top = bucket;
    int32_t idx = 0;
    int32_t mask = 1<<(bucket&31);
    int32_t seen = 0;
    do {
      if( (mask|seen)<cap ) {
        BitCtr *ctr = &run_ctr[CtxIdx{}.bits<0, 4>(bucket)
                                .digit<16, 3>((seen==0)+(bucket==top))];
        const uint32_t bin_tot = ctr->n[0]+ctr->n[1];
        int32_t run_bit;
        if constexpr( f_DEC ) {
          run_bit = rc.decode_bit(ctr->n[0], ctr->n[1]);
        } else {
          run_bit = (len&mask)!=0;
          rc.encode_bit(ctr->n[0], ctr->n[1], run_bit);
        }
        if( ctr->limit<bin_tot )
          ctr->scale_rare();
        ctr->n[run_bit] += 8;
        if( run_bit )
          idx |= mask;
        seen |= idx&mask;
      }
      --bucket;
      mask >>= 1;
    } while( mask );
    return idx;
  }

  // Stage one missed, so the symbol is looked for among the candidates and then
  // down the selector lists.  `idx_s` is how far the run reached -- zero when
  // there was no run -- and every answer here is one past it.
  //
  // Two paths reach this and both were a `goto pixel_done`: the run coder when
  // it decoded a run but not the pixel that follows it, and stage one when its
  // level came back zero.  The label was the last of the tree's, and it forced
  // the stage-one block that sits between the two into a scope of its own,
  // because a jump may cross a scope but not an initialisation inside the
  // label's.
  int32_t decode_stage_two(int32_t* nb_sym, int32_t idx_s) {
    exclude_stage_one();
    sel[0] = nullptr;
    // The 32 candidate symbols `pixel_context` walks, in slot order.  Slots 0
    // and 1 are the two most recent symbols at this exact context, 2..9 the
    // move-to-front cache, and 10..31 the spatial neighbours widening outward.
    seed_candidates(nb_sym);
    if( offer_candidates<1>(nb_sym)>=0 )
      return idx_s+1;
    SymList **sel_p = load_selectors();
    while( 1 ) {
      if( sel_p>&escape_list )
        bmf_fatal(bmf_read_error);
      if( (*sel_p)->live ) {
        int32_t lsym = (*sel_p)->decode_symbol_list();
        row_cur[5]->sym = lsym;
        if( lsym>=0 )
          return idx_s+1;
        sel_p = sel_cur;
      }
      sel_cur = ++sel_p;
    }
  }

  int32_t decode_pixel(int32_t x) {
    // The neighbour list `pixel_context` indexes by `sym_pos`.  BMF.exe fills
    // it one slot at a time, so Hex-Rays gave each slot a member, and an
    // earlier round recovered the array beside them.  The frame struct is what
    // was left over: this array, four bytes of gap and thirty-two of trailing
    // pad, no other member, and nothing reading either.  `pixel_context`
    // indexes 0..31 and no further, so the pad held nothing back.
    alignas(16) int32_t nb_sym[32];
    uint32_t lvl_a;
    int32_t m_up0, run, bit, idx_s;
    PixRec *cur6 = row_cur[6];
    PixRec *row = row_cur[5];
    Neighbours nb4;
    int32_t id2 = open_pixel(nb4, cur6, row);
    if( row_cur[5][-1].match[1]&row_cur[5][-1].match[0] ) {
      PixRec *up1 = row_cur[6];
      PixRec *up2 = row_cur[7];
      if( (uint8_t)(up2[2].match[1]&up2[1].match[1]&up2[0].match[1]&up1[3].match[1]&up1[2].match[1]&up1[1].match[1]&up1[0].match[1]&up1[0].match[0]&(int8_t)up1[-1].match[1])&up2[3].match[1] ) {
        const int32_t idx1 = run_scan(up1, up2, width-x, m_up0, run);
        int32_t bucket = run_bucket[idx1];
        // Four fields and a plus-one: the bucket from bit 3 up, then
        // three bits of neighbour agreement.  The `+1` is an offset
        // into `esc_ctr` and not a field, which is why it is a `raw`.
        int32_t esc_at = CtxIdx{}.above<3>(bucket)
                                 .bit<2>(up2[run+3].match[1]&up2[run+2].match[1])
                                 .bit<1>(m_up0)
                                 .bit<0>(alpha_map[nb4.up])
                                 .raw(1);
        bit = esc_ctr[esc_at].decode_context_bit(esc_ctr);
        int32_t msym1c = mode_symbol[1];
        hit = bit;
        *(((uint8_t*)alpha_map)+msym1c) = bit;
        // `hit_a` is `hit`, and nothing between here and the end of this block
        // writes either: `hit` is a member of this record and the only writes
        // to it in the tree are this line and the two `hit = lvl` in the stage
        // -one coders.  The two `hit_a = hit` further down were the same value
        // fetched again after a spill, and one of them was the whole reason
        // the `goto` below could skip a line.
        const int32_t hit_a = hit;
        // A run of one is already decoded: the escape bit said so and the
        // length needs no bits.  That was a `goto` past the walk *and* past the
        // two lines below it -- both of which are no-ops when `idx_s` is zero,
        // which it is on exactly this path.
        idx_s = hit_a ? idx1
              : idx1>1 ? code_run_length<1>(bucket, idx1, 0)
              : 0;
        if( idx_s )
          row_cur[5][idx_s-1].sym = row_cur[5][-1].sym;
        if( idx_s>hit_a ) {
          row_cur[6] = row_cur[6]+idx_s-hit_a;
          PixRec *r8b = row_cur[8];
          PixRec *r7b = row_cur[7]+idx_s;
          row_cur[7] = r7b-hit_a;
          row_cur[8] = r8b+idx_s-hit_a;
          PixRec *rec = row_cur[5];
          row_cur[9] = row_cur[9]+idx_s-hit_a;
          rec->match2345 = 0x01010101;
          row_cur[5]->head4 = 0x01010101;
          SymPair *pixp = pix_cur;
          // The symbol, the head word and the flag word the run replicates.
          // The first two went into two slots of the candidate table and came
          // back out through `s1c`, `s3c`, `s3d` -- and `s1d` eighteen lines
          // below the block, which is what makes slot 1 more than scratch and
          // is why the run's symbol needs a name rather than a deletion.
          const int32_t run_sym = mode_symbol[1];
          pixp->prev = pixp->last;
          row_cur[5]->sym = (uint16_t)run_sym;
          pix_cur->last = (uint16_t)run_sym;
          const int32_t flags_word = row_cur[5]->match2345;
          const int32_t head_word = row_cur[5]->head4;
          ++row_cur[5];
          // The records the run covers, each taking the symbol, head word and
          // flag word of the one before it.  The original unrolled this by two
          // and carried the odd one in a tail: a pair count in a third slot,
          // `2*pairs+1` in `done`, and a tail that runs exactly when `fill` is
          // odd -- so the two paths together are `fill` turns.  `hit_a` and
          // `idx_s` were saved and restored around the pair loop, which
          // touches neither.
          //
          // Unsigned, as the tail's own comparison was; the guard above is
          // what keeps `fill` off zero.
          fill_run(run_sym, head_word, flags_word, idx_s-hit_a-1);
          seed_after_run(row_cur[5], run_sym);
        }
        if( hit_a )
          return idx_s;
        // The run was coded but the pixel was not, so what follows is the
        // second stage with `idx_s` carrying how far the run reached.  The
        // recovery jumped past the whole of stage one to say that.
        return decode_stage_two(nb_sym, idx_s);
      }
    }
    FreqRec *freq = &grid[bucket_idx];
    FreqRec *freq_tbl = &grid[id2+kFreqTableOffset];
    {
    // Decode the stage-one symbol against one record: take the target, find
    // which of its five levels holds it, let the record grow, and leave the
    // level in `hit` for the callers that read it.  Both arms below run this
    // and differ only in which record, and in what they then do to the other
    // one -- so the two wrote it out with a private name for every value in
    // it, `cum2`, `target2`, `lvl_b`, and a `freq2` that is `freq`.
    auto decode_against = [&](FreqRec* rec) {
      const int32_t total = rec->w[5];
      int32_t cum;
      const int32_t lvl = rec->find_level(rc.get_freq(total), cum);
      // Before the bump, which is what moves `w[lvl]`.
      const int32_t low = cum-rec->w[lvl];
      rec->bump(lvl);
      rc.decode(low, cum, total);
      hit = lvl;
      return lvl;
    };
    const int32_t tot = freq_tbl->w[5];
    if( tot ) {
      // `tot` was re-read after the blend for the sake of `arg_tot`, which
      // reads `w[5]` itself now.
      if( tot==1 )
        freq_tbl->blend_from(*freq);
      lvl_a = decode_against(freq_tbl);
      if( freq_tbl->b14 ) {
        --freq_tbl->b14;
        ++freq->w[5];
        ++freq->w[lvl_a];
      }
    } else {
      lvl_a = decode_against(freq);
      freq_tbl->w[5] = freq_tbl->w[lvl_a]++!=0;
    }
    }
    if( lvl_a ) {
      row_cur[5]->sym = mode_symbol[lvl_a];
      return 1;
    }
    return decode_stage_two(nb_sym, 0);
  }

  int32_t code_pixel(int32_t x) {
    // The neighbour list `pixel_context` indexes by `sym_pos`.  BMF.exe fills
    // it one slot at a time, so Hex-Rays gave each slot a member, and an
    // earlier round recovered the array beside them.  The frame struct is what
    // was left over: this array, four bytes of gap and thirty-two of trailing
    // pad, no other member, and nothing reading either.  `pixel_context`
    // indexes 0..31 and no further, so the pad held nothing back.
    alignas(16) int32_t nb_sym[32];
    uint32_t done;
    int32_t m_up0, run, amap, runlen, lvl_a;
    PixRec* cur6c, * up2;
    PixRec* cur6 = row_cur[6];
    PixRec *cur5 = row_cur[5];
    Neighbours nb4;
    int32_t id2 = open_pixel(nb4, cur6, cur5);
    PixRec *cur2 = cur5;
    PixRec* row = row_cur[5];
    int32_t m_w1b = row[-1].match[1];
    int32_t m_w0 = row[-1].match[0];
    PixRec *rowp = row;
    if( (m_w1b&m_w0)!=0&&(cur6c = row_cur[6], up2 = row_cur[7], ((uint8_t)(up2[2].match[1]&up2[1].match[1]&up2[0].match[1]&cur6c[3].match[1]&cur6c[2].match[1]&cur6c[1].match[1]&cur6c[0].match[1]&cur6c[0].match[0]&cur6c[-1].match[1])&up2[3].match[1])!=0) ) {
      const int32_t run_len = run_scan(cur6c, up2, width-x, m_up0, run);
      int32_t run_pair = (uint8_t)(up2[run+3].match[1]&up2[run+2].match[1]);
      const int32_t bucket = run_bucket[run_len];
      amap = CtxIdx{}.bit<2>(run_pair).bit<1>(m_up0)
                     .above<3>(bucket).bit<0>(alpha_map[nb4.up]);
      runlen = 0;
      if( rowp->sym==nb4.up ) {
        do
          ++runlen;
        while( runlen<run_len&&rowp[runlen].sym==nb4.up );
      }
      const int32_t run_hit = runlen==run_len;
      if( runlen>run_hit ) {
        row_cur[6] = &cur6c[runlen-run_hit];
        row_cur[7] = &up2[runlen-run_hit];
        PixRec *row_cur9 = row_cur[9];
        row_cur[8] = row_cur[8]+runlen-run_hit;
        row_cur[9] = row_cur9+runlen-run_hit;
        rowp->match2345 = 0x01010101;
        row_cur[5]->head4 = 0x01010101;
        pix_cur->prev = pix_cur->last;
        uint16_t wp = nb4.up;
        row_cur[5]->sym = wp;
        pix_cur->last = wp;
        PixRec *r3 = row_cur[5];
        uint32_t rec_word = *(uint32_t*)r3;
        // The record's flag word, saved into a slot of the candidate table and
        // read back twice below across walks that do not touch it.
        const int32_t flag_word = r3->match2345;
        cur2 = r3+1;
        row_cur[5] = r3+1;
        if( runlen-run_hit!=1 ) {
          int32_t run_left = runlen-run_hit-1;
          uint32_t half = run_left/2;
          if( run_left/2 ) {
            // `run_left` and `amap` were saved into two slots of the
            // candidate table and read straight back below, across a walk that
            // touches neither -- register spills with names.
            fill_run(nb4.up, rec_word, flag_word, 2*half);
            cur2 = row_cur[5];
            done = 2*half+1;
          } else {
            done = 1;
          }
          if( (uint32_t)run_left>(done-1) ) {
            pix_cur->prev = nb4.up;
            row_cur[5]->head4 = rec_word;
            row_cur[5]->match2345 = flag_word;
            PixRec *cur5p1b = row_cur[5]+1;
            row_cur[5] = cur5p1b;
            cur2 = cur5p1b;
          }
        }
        seed_after_run(cur2, nb4.up);
      }
      (&esc_ctr[(amap+1)])->encode_context_bit(esc_ctr, run_hit);
      int32_t msym1 = mode_symbol[1];
      uint8_t *amap_at = (uint8_t*)alpha_map;
      hit = run_hit;
      amap_at[msym1] = run_hit;
      if( !run_hit&&run_len!=1 )
        code_run_length<0>(bucket, run_len, runlen);
      if( hit )
        return runlen;
    } else {
      FreqRec *binp = &grid[bucket_idx];
      FreqRec *frec = &grid[id2+kFreqTableOffset];
      // The mirror of `decode_pixel`'s `decode_against`: rank the symbol among
      // the four neighbours, take the interval below that rank, let the record
      // grow, and leave the rank in `hit`.  The second arm reached the same
      // record through `grid[bucket_idx].w`, cast to the union's other member,
      // so the two chains did not look like one.
      auto code_against = [&](FreqRec* rec) {
        const int32_t lvl = nb4.rank(rowp->sym);
        const int32_t cum = cum_below(rec->w, lvl);
        const uint32_t total = rec->w[5];
        // Before the bump, which is what moves `w[lvl]`.
        const uint32_t high = rec->w[lvl]+cum;
        rec->bump(lvl);
        rc.encode(cum, high, total);
        hit = lvl;
        return lvl;
      };
      const uint32_t grid_kind = frec->w[5];
      if( grid_kind ) {
        if( grid_kind==1 ) {
          // `ip = (int32_t*)&grid[bucket_idx]` ten lines up, cast straight
          // back here and used as nothing else in between.
          frec->blend_from(*binp);
          rowp = row_cur[5];
        }
        lvl_a = code_against(frec);
        if( frec->b14 ) {
          --frec->b14;
          ++binp->w[5];
          ++binp->w[lvl_a];
        }
      } else {
        lvl_a = code_against(binp);
        frec->w[5] = frec->w[lvl_a]++!=0;
      }
      if( lvl_a )
        return 1;
      runlen = 0;
    }
    exclude_stage_one();
    sel[0] = nullptr;
    // The same 32 candidates as `decode_pixel`'s, in slot order: 0 and 1 the
    // two most recent symbols at this context, 2..9 the move-to-front cache,
    // 10..31 the spatial neighbours widening outward.  The decompilation
    // interleaved the stores with the loads and named every load.
    seed_candidates(nb_sym);
    if( offer_candidates<0>(nb_sym)>=0 )
      return runlen+1;
    SymList **sel_p = load_selectors();
    while( 1 ) {
      if( (*sel_p)->live ) {
        if( (*sel_p)->code_symbol(row_cur[5]->sym) )
          return runlen+1;
        sel_p = sel_cur;
      }
      sel_cur = ++sel_p;
    }
  }

  // Three more of this block's buffers, bounded and so members.  `alphabet` is
  // at most `no_symbol + 1` -- the decoder refuses anything above 0x2000
  // outright -- and a run bucket is one byte per column plus one.  8 KB, 32 KB
  // and 64 KB against three `bmf_new` calls and three `free`s an image.
  uint8_t alpha_map_store[no_symbol+1];
  uint32_t sym_code_store[no_symbol+1];
  uint8_t run_bucket_store[kMaxWidth+1];

  // The five rows both cursor sets point into, last in the struct so that no
  // member's offset moves.  8 bytes to the record and `kMaxWidth + 16` records
  // to the row: 2.6 MB, against five `bmf_new` calls and five `free`s an image.
  PixRec row_store[5][kMaxWidth+kRowMargin+kRowTail];
};

// The one block the main model needs.  `code_plane` allocates it, runs a plane
// through it and frees it, and nothing nests: instrumented over the corpus both
// directions the high-water mark is 1.
//
// Not zeroed, matching the `bmf_new` this replaces, and on the same measurement
// as the p1 pool -- 0xA5 in every byte of the slot on take leaves all 111
// checks passing, so `layout_workspace` writes everything anything reads.
//
// 7.73 MB of `.bss`.
static BlockPool<ModelBlock, 1> model_blocks;

// The four `_padN` arrays in `ModelBlock` are the decompilation's record of
// gaps in the original's frame, and a filler array is a layout contract in a
// form nothing checks.  Stage 2 Section 10 asks for the contract to travel with
// the declaration; these are it -- the offset of the member *after* each pad,
// which is the only thing the pad exists to produce.
//
// This is the larger of the two: one allocation, and a `grid[65723]` whose
// bound is not round in any base.  If a pad is ever mis-sized in an edit these
// say so at compile time rather than at the first stream that reads a counter
// one record over.
//
// **All four depend on the pointer width and were written at 64 only**, which
// broke `BMF_BITS=32 ./build.sh` for three rounds without anybody noticing --
// the leg is documented in build.sh and nothing was running it.  `SymList`
// carries pointers and `ModelBlock` holds several before `bit_root`, so every
// offset here moves: 40 bytes by `bit_root`, still 40 by `escape`, 72 by
// `sel_cur` once six more pointers have gone past, and 104 by the end.
//
// The 32-bit numbers are the more faithful pair: `_pad22` and `_pad25` are the
// decompilation's record of a 32-bit x86 frame, and the widths they were
// measured at are the widths they describe.  Both are written down because a
// contract that holds at one width and is silent at the other is not a
// contract, it is a build that happens to pass.
#if UINTPTR_MAX > 0xFFFFFFFFu
static_assert(offsetof(ModelBlock, bit_root) == 1051720, "_pad1051664 sizes the gap");
static_assert(offsetof(ModelBlock, escape) == 1078224, "_pad16 sizes the gap");
static_assert(offsetof(ModelBlock, sel_cur) == 1078304, "_pad22 sizes the gap");
static_assert(offsetof(ModelBlock, alpha_map_store) == 8102552, "_pad25 closes the record");
#else
static_assert(offsetof(ModelBlock, bit_root) == 1051680, "_pad1051664 sizes the gap");
static_assert(offsetof(ModelBlock, escape) == 1078184, "_pad16 sizes the gap");
static_assert(offsetof(ModelBlock, sel_cur) == 1078232, "_pad22 sizes the gap");
static_assert(offsetof(ModelBlock, alpha_map_store) == 8102448, "_pad25 closes the record");
#endif

// bmp.inc -- the BMP file, as this program holds it in memory.

// The two decision bytes, one enum each.  They are adjacent in the header and
// they both use 0x40, for two unrelated things -- packed rows in one, a grey
// ramp in the other -- so an 0x40 left to stand on its own says which field it
// came from and nothing else.  Grouping them also puts each byte on the page
// as a byte: what bits exist, and which are holes.
//
// `depth` is a width in its low six bits and two statements about the palette
// in its top two.
enum : uint8_t {
  depth_bits    = 0x3F,   // bits per pixel
  depth_grey    = 0x40,   // the palette is a grey ramp
  depth_palette = 0x80,   // a palette follows the pixels

  // One eight-bit greyscale plane, which is what a header describing a single
  // plane of a colour image says.  Both sides of the planar path copy the real
  // header, overwrite `depth` with this, and hand the copy to the model; both
  // wrote it as `72`.
  depth_one_plane = depth_grey|8,
};

// `flags` is the same byte in memory and on disk: `compress_image` builds its
// header as a `BmfImage` and writes the sixteen bytes out, `expand_image` reads
// them back into one.  Two bits describe the image, four describe the stream
// that follows it, and one says whether anything sits between the two.
//
// Bit 0 is unused.  `flags_packed` is written by `alloc_image` and read by
// nothing -- in this program or in the file -- which is a fact about BMF 2.01
// rather than about the decompilation, and it is kept and named because a bit
// the encoder sets is part of the format whether or not the decoder consults
// it.
enum : uint8_t {
  flags_transposed  = 0x02, // width and height are swapped
  flags_slow        = 0x04, // coded in -S mode; this build decodes no other
  flags_planar      = 0x08, // each plane coded alone, interleaved afterwards
  flags_descriptors = 0x10, // a plane descriptor per plane heads the stream
  flags_coded       = 0x20, // the data is a coded stream, not raw pixels
  flags_packed      = 0x40, // rows are packed sub-byte
  flags_tail        = 0x80, // a `CodedTail` sits between header and data
};

// A BMP palette entry is four bytes -- blue, green, red, and a zero reserved
// byte -- so little-endian makes the word `0x00RRGGBB`.  The image carries its
// own palette as three-byte BGR triples in that same order, so writing one out
// is a widening by one zero byte, and the shift chains at the call sites showed
// that rather than saying it.
//
// Taking the three channels by name is the point: `(pal[2]<<16)|*(uint16_t*)&pal[0]`
// reads as a two-byte load with a byte on top, and which byte is which is left
// to the reader.
static inline uint32_t bmp_palette_entry(uint8_t b, uint8_t g, uint8_t r) {
  return (uint32_t)r<<16|(uint32_t)g<<8|b;
}

// One 32-bit value into a byte buffer at an arbitrary offset.  A BMP's palette
// starts at byte 54, so no entry in it is four-aligned and none of the six
// sites that write one could be a `uint32_t*` store -- they were
// `*(uint32_t*)&out_buf[4*slot+54]`, which is the store the binary makes and a
// misaligned access as C++.  `memcpy` is the same store with the alignment
// told truthfully; every compiler this builds under folds it to one `mov`.
static inline void put_u32(uint8_t* at, uint32_t v) {
  memcpy(at, &v, sizeof v);
}

// One level of a grey ramp: the same value in all three channels.
static inline uint32_t bmp_grey_entry(uint8_t level) {
  return bmp_palette_entry(level, level, level);
}

// The sixteen-byte member header, on disk and in memory: `write_member_head`
// puts this record out with `fwrite(head, 1, 0x10, fp)` and `expand_image`
// reads it back the same way, so the field offsets below *are* the format.
struct BmfImage {
  uint16_t width;
  uint16_t height;
  // Sixteen bits, and the two bytes it gave up are pad.
  //
  // It was `uint32_t` and every read masked it to sixteen -- seven sites -- and
  // every write truncated first.  Seven unexplained masks are a format limit
  // nobody wrote down, so this writes it down: a row is at most 65535 bytes.
  // `read_bmp` already refuses a wider one (`width * ((bpp+7)>>3) > 0xFFFF`);
  // `expand_image` did not, and 11.3 is that gap -- `width` is `uint16_t`, so a
  // crafted header at 16384 by 32 bits asks for a 262140-byte row, and the
  // truncation made it 0 rather than an error.  The check is there now.
  //
  // The two bytes move into `_pad8` rather than shrinking the record, because
  // the record is the format.  On every stream this program has ever written
  // they were the high half of a stride below 65536, which is to say zero.
  uint16_t stride;
  uint8_t _pad8[4];
  uint8_t depth;
  uint8_t flags;
  uint32_t data_size;
  uint8_t pixels[0];

  // The palette, when `depth & 0x80` says there is one: it sits immediately
  // after the pixels.  Four sites spelled this `(uint8_t*)img + data_size+16`,
  // where the 16 is `sizeof(BmfImage)` -- the header this same block starts
  // with, so `pixels` already is it.
  uint8_t* palette() { return pixels+data_size; }
  const uint8_t* palette() const { return pixels+data_size; }

  // `n` bytes from `at` are inside this image's pixels.  Both run-length
  // readers spelled the two bounds into a pair of locals at the top and
  // compared against them four times between them, which is the same sentence
  // written four ways.
  bool holds(const uint8_t* at, int32_t n) const {
    return at>=pixels&&at+n<=pixels+data_size;
  }

  // Every header field of `src` but `flags`, which the two callers set
  // differently: `compress_image` writes the member header twice, once at the
  // top and once after `search_filter`, which may have transposed the image
  // under it.
  //
  // `_pad8[2]`, `depth` and `flags` are four consecutive bytes at offset 8, and
  // both copies moved them as one `uint32_t` -- then the second recovered
  // `flags` from the top of the saved word twenty lines later.  Member copies
  // say it without the layout.  Each copy also spelled the stride into a local
  // of its own, `row_bytes` and `img_stride`, read once on the next line but
  // one.
  // The first byte of row `y`, counting from the bottom -- which is where a
  // BMP's rows start.  Both run-length arms of `read_bmp` compute it when an
  // end-of-line opcode sends them up a row, and both took the stride through a
  // `uint16_t` to match the stores that made it.  The field is sixteen bits
  // now, so the cast is gone from here and from the six other read sites.
  uint8_t* row(int32_t y) { return pixels+y*stride; }

  // All four pad bytes, not two.  Two of them used to be the high half of a
  // 32-bit stride and were carried by the `stride` copy; with a sixteen-bit
  // field nothing else moves them, and they are part of a header that goes to
  // disk byte for byte.
  void header_from(const BmfImage* src) {
    width = src->width;
    height = src->height;
    stride = src->stride;
    for( int32_t k = 0; k<4; ++k )
      _pad8[k] = src->_pad8[k];
    depth = src->depth;
    data_size = src->data_size;
  }
};

// The format, asserted where the fields are declared.  `write_member_head`
// writes 0x10 bytes of this and `expand_image` reads 0x10 back, so a change to
// any offset below is a change to the container.
static_assert(sizeof(BmfImage) == 16, "the member header is sixteen bytes");
static_assert(offsetof(BmfImage, width) == 0 && offsetof(BmfImage, height) == 2
           && offsetof(BmfImage, stride) == 4 && offsetof(BmfImage, _pad8) == 6
           && offsetof(BmfImage, depth) == 10 && offsetof(BmfImage, flags) == 11
           && offsetof(BmfImage, data_size) == 12,
              "member header field offsets are the on-disk layout");

// Transpose the header.  The loop at each call site has already moved the
// pixels; this swaps the two dimensions that describe them, recomputes the
// stride, and flips `flags_transposed`, which is the record that it happened.
//
// Open-coded at five sites, in two spellings that are not obviously the same
// store: three wrote `*(uint16_t*)&img->stride`, which leaves the top half of
// the 32-bit field alone, and two assigned the whole word.  What makes them
// one function is that the *value* is sixteen bits wide at all five -- it goes
// through a `uint16_t` or `int16_t` temporary before the store every time, and
// the reads on these paths are `(uint16_t)img->stride` to match.  A stride
// that did not fit in sixteen bits would already be wrong here in the
// original; given that it fits, zeroing the top half and leaving it alone are
// the same thing, and the whole-word store is the one that says so.
static inline void transpose_image_in_place(BmfImage* img, int32_t planes) {
  uint16_t w = img->width;
  img->width = img->height;
  img->height = w;
  img->flags ^= flags_transposed;
  img->stride = img->width*planes;
}

// And the loop that has to run before it: the pixels themselves, column-major.
// A copy goes aside and comes back so that pixel (x, y) lands at (y, x), all
// `planes` bytes of it moving together.
//
// Open-coded at four sites -- three in `search_filter` and one in
// `compress_image` -- each identical down to the shape of its three nested
// `do`/`while`s, and each needing one value the loop cannot recompute: the
// `planes*(height-1)` the destination advances by per column.  All three in
// `search_filter` kept it in a frame slot, two of them in the same slot, which
// is most of what that frame was for.
//
// The inner `do`/`while`s ran at least once whatever the count, so a zero
// width or a zero plane count would have wrapped; `for` is the shape that says
// what the bounds are.  Neither is reachable -- `search_filter` returns early
// below four columns and `plane_count` is 1..4 -- so this is the same walk on
// every input either can see.
static void transpose_image(BmfImage* img, int32_t planes) {
  uint8_t* copy = (uint8_t*)bmf_new(img->data_size);
  memcpy(copy, img->pixels, img->data_size);
  const int32_t step = planes*(img->height-1);
  const uint8_t* src = copy;
  for( int32_t y = 0; y<img->height; ++y ) {
    uint8_t* dst = img->pixels+planes*y;
    for( int32_t x = 0; x<img->width; ++x ) {
      for( int32_t k = 0; k<planes; ++k )
        *dst++ = *src++;
      dst += step;
    }
  }
  transpose_image_in_place(img, planes);
  free(copy);
}

// The allocation is one block: a sixteen-byte `BmfImage`, the pixels, and the
// palette after them if there is one.
//
// It used to build the header's `(pad, pad, depth, flags)` word by arithmetic
// -- `bpp<<16` for `depth`, `0x40000000` for `flags_packed`, `0x00800000` for
// `depth_palette` -- and store it through `result[2]`, because the original
// wrote it as one store.  The two decision bytes are written as themselves
// now, which is also what let the return type stop being `int32_t*`.
BmfImage*alloc_image(int32_t img_w, int32_t img_h, int32_t bpp, int32_t palette, int32_t packed) {
  int32_t row_pack, row_bytes, pal_bytes;
  bool sub_byte_rows = false;
  uint16_t row16 = img_w;
  int32_t bits = bpp;
  if( bpp>=5&&bpp<=7 ) {
    row_bytes = row16;
  } else {
    if( bpp==3 )
      bits = 4;
    else if( !packed )
      bits = max32(bpp, 4);
    bool byte_rows = bpp!=3&&bits>=8;
    if( !packed ) {
      if( !byte_rows&&bits==4 )
        row16 = ((img_w+7)>>1)&0xFFFC;
      else
        row16 = (uint16_t)(((bits+7)>>3)*img_w);
      row_bytes = row16;
    } else if( byte_rows ) {
      row16 = (uint16_t)(((bits+7)>>3)*img_w);
      row_bytes = row16;
    } else {
      if( bits==1 ) {
        row_pack = (int32_t)(((uint32_t)((img_w+7)>>2)>>29)+img_w+7)>>3;
      } else if( bits==2 ) {
        row_pack = (int32_t)(((uint32_t)((img_w+3)>>1)>>30)+img_w+3)>>2;
      } else {
        row_pack = (int32_t)(img_w+((uint32_t)(img_w+1)>>31)+1)>>1;
      }
      sub_byte_rows = true;
      row_bytes = (uint16_t)row_pack;
    }
  }
  int32_t data_bytes = row_bytes*img_h;
  bool has_palette = false;
  if( palette&&bpp<=8 ) {
    pal_bytes = 3<<(bpp&31);
    has_palette = true;
  } else {
    pal_bytes = 0;
  }
  // 19, not 16: three bytes of slop past the header, pixels and palette, which
  // the original allocated and this keeps.
  BmfImage* img = (BmfImage*)bmf_new(data_bytes+pal_bytes+19);
  if( !img )
    return nullptr;
  img->width = img_w;
  img->height = img_h;
  img->stride = row_bytes;
  for( int32_t k = 0; k<4; ++k )
    img->_pad8[k] = 0;
  img->depth = (uint8_t)(bpp|(has_palette ? depth_palette : 0));
  img->flags = sub_byte_rows ? flags_packed : 0;
  img->data_size = data_bytes;
  // The clear used to be guarded by `depth & 0x80`, with a `nullptr` for the
  // other arm -- and reaching it needed `pal_bytes` non-zero, which is exactly
  // when that bit was just set.  The guard could not be false and the `nullptr`
  // could not be passed to `memset`.
  if( pal_bytes )
    memset(img->palette(), 0, pal_bytes);
  return img;
}

// The BMP header's own constants, which are Windows' rather than BMF's.
// `bfType` is the two letters `BM` little-endian; `biSize` is the size of the
// second half of the header, which is what distinguishes the only version
// either side here handles from OS/2's twelve-byte one and Windows' later
// longer ones; and `biCompression` is a three-value enum both `read_bmp` and
// `write_bmp` were spelling 0, 1 and 2.
enum : uint32_t {
  bmp_magic   = 'B'|'M'<<8,   // 0x4D42
  bmp_hdr_v3  = 40,           // BITMAPINFOHEADER, and no other
  bmp_rgb     = 0,            // rows as they are
  bmp_rle8    = 1,            // run-length, one byte per pixel
  bmp_rle4    = 2,            // run-length, one nibble per pixel
};

#pragma pack(push, 1)
struct BmpHeader {
  uint16_t bfType;
  uint32_t bfSize;
  uint16_t bfReserved1;
  uint16_t bfReserved2;
  uint32_t bfOffBits;
  uint32_t biSize;
  int32_t biWidth;
  int32_t biHeight;
  uint16_t biPlanes;
  uint16_t biBitCount;
  uint32_t biCompression;
  uint32_t biSizeImage;
  int32_t biXPelsPerMeter;
  int32_t biYPelsPerMeter;
  uint32_t biClrUsed;
  uint32_t biClrImportant;
};
#pragma pack(pop)

static inline int32_t bmf_pixels(const BmfImage* img) {
  return img->width*img->height;
}

// file.inc -- the file at each end: one image out, one image in.
//
// This was an archive.  The donor put several images in one file -- its command
// line took a list and appended each to the archive named by `-o` -- and the
// reader walked the members until one failed to parse.  `bmf c in.bmp out`
// writes one image and `bmf d in out.bmp` reads one, so the walk, the append
// point it existed to find, and the member count are all gone.  What is left is
// the handle and the two ways of opening it.

// Each member of a BMF file opens with a four-byte tag: two signature bytes,
// then the version as two ASCII digits.  Two signatures exist -- one introduces
// an image and the other introduces a member `expand_image` skips by the length
// in its eight-byte header -- and this build reads and writes 2.0 only.
//
// The version arithmetic was `((major<<8)-12288)|(minor-48)` tested against
// 512, which is three constants for one idea: 12288 is `'0'<<8`, 48 is `'0'`,
// and 512 is `2<<8`.  It reads the two digits and packs them into a byte each.
//
// The tag is handled as a word at both ends -- the reader `fread`s four bytes
// into a `uint32_t` and masks, and `bmf_tag` builds the same word for the
// writer -- so the signature is the low half on a little-endian host and this
// says nothing useful on any other.  That is the whole program's assumption,
// not this pair's.
enum : uint16_t {
  bmf_sig_image = 0x8A81,
  bmf_sig_other = 0x9081,
};

// `2<<8`, the only version this build accepts.
static constexpr int32_t bmf_version_20 = 2<<8;

static inline int32_t bmf_tag_version(uint32_t tag) {
  return (((uint8_t)(tag>>16)-'0')<<8)|((uint8_t)(tag>>24)-'0');
}

static inline uint32_t bmf_tag(uint16_t sig, char major, char minor) {
  return sig|((uint32_t)(uint8_t)major<<16)|((uint32_t)(uint8_t)minor<<24);
}

struct BmfFile {
  FILE* fp;
  // Both returns were the same constant -- `nullptr` on the branch that
  // closes, and `f` on the branch where `f` is already null -- and the one
  // caller discarded it.  It also left `fp` pointing at a closed `FILE`, which
  // was harmless only because that caller frees the struct immediately.
  // Close the input and give up.  Eleven sites in `image_expand` wrote
  // `fclose(arc->fp); arc->fp = 0; return nullptr;` out, which is eleven places
  // a reader had to check the file was actually closed.
  BmfImage* fail() {
    close();
    return nullptr;
  }

  // Stage-2 11.5.  The `fseek(fp, 0, SEEK_END)` that stood here answered no
  // format requirement -- one member per file, written front to back, and the
  // position after `fclose` is not a thing anyone can read.
  void close() {
    if( fp ) {
      fclose(fp);
      fp = nullptr;
    }
  }
};

// Same shape as `AltP2Block::alt_p2_free`: it returned `arc` after `free(arc)`
// and tested a `do_free` its one caller always passes as 1.
void bmf_close_file(BmfFile* arc) {
  arc->close();
  free(arc);
}

// One record in, one record out, or the answer is no.
//
// Six `fread`/`fwrite` results went unread.  A codec reading untrusted input
// cannot do that: a short read leaves the destination holding whatever was
// there before, and the four in `read_bmp` were filling a palette, an RLE
// absolute run and a 32-bit mask from stale scratch.  `(void)` on the result
// would compile and would be worse than the warning.
//
// Two shapes, because the callers have two.  Where the function already has a
// failure path -- `read_rle8` and `read_rle4` return false, `expand_image`
// calls `arc_in->fail()` -- the read answers a bool and the caller takes its
// own path.  Where there is none, the write is fatal: `compress_image`'s
// palette write is the last thing it does and a partial archive is not
// something to return success for.
static inline bool read_exact(void* dst, size_t n, FILE* fp) {
  return n==0||fread(dst, n, 1u, fp)==1;
}

static inline void write_all(const void* src, size_t n, FILE* fp) {
  if( n&&fwrite(src, 1u, n, fp)!=n )
    bmf_fatal(bmf_write_error);
}

static uint32_t bytes_left(FILE* fp) {
  long here = ftell(fp);
  if( here<0||fseek(fp, 0, SEEK_END)!=0 )
    return 0;
  long end = ftell(fp);
  if( end<0||fseek(fp, here, SEEK_SET)!=0 )
    return 0;
  return (uint32_t)(end-here);
}

BmfFile*bmf_open_file(BmfFile* out, char* path, int32_t read_only) {
  // `wb` to write and `rb` to read.  The donor opened `a+b` -- read *and*
  // append -- because it had members already there to walk past; there is one
  // image in a file now, so writing never reads and reading never writes.
  out->fp = fopen(path, read_only ? "rb" : "wb");
  if( !out->fp )
    bmf_fatal(bmf_no_open, path);
  return out;
}

// rc_io.inc -- the range coder's file ends -- what it writes before a stream and what
// it reads after one.  The coder itself is rc.inc.

uint32_t rc_decode_flat(uint32_t tot) {
  uint32_t sym = rc.get_freq(tot);
  rc.decode(sym, sym+1, tot);
  return sym;
}

// Give back what `begin_plane_stream` took.  This is the model layer's, not
// the coder's -- `rc_end` was doing both jobs and only one of them is range
// coding.
// Nothing to give back: the table is `model_table_store`, and what this used to
// do was `free(model_tables)`.  The function stays because the two ends of a
// plane stream being named is what the comment above is about, and because
// `begin_plane_stream` still has work on the other side of the flag.
static void end_plane_stream() {
}

// The two ends differ in one call: the encoder flushes what it still holds and
// the decoder reads to the marker.  Everything after is the same tear-down.
template<int32_t f_DEC>
void rc_end() {
  if constexpr( f_DEC )
    rc.finish();
  else
    rc.flush();
  end_plane_stream();
}

void rc_end_decode() {
  rc_end<1>();
}

void rc_end_encode() {
  rc_end<0>();
}

// Back the output cursor off the packer's partial word.
//
// The packer writes 32 bits at a time and the coder starts at a byte, so
// whatever whole bytes the last word did not need are given back here, one at
// a time, and `stream.pk.free_bits` is left holding what is still owed.  It goes
// transiently negative on the way, which is the thing to know about it.
static void packer_rewind() {
  if( stream.cur==(uint8_t*)stream.pk.word )
    return;
  int32_t bits = stream.pk.free_bits-8;
  if( bits<0 ) {
    stream.pk.free_bits = bits;
    return;
  }
  // The guard above makes the first turn certain, so the `do` and the `while`
  // are the same walk; this one says its bound before it takes a step.
  uint8_t* at = stream.cur;
  while( bits>=0 ) {
    --at;
    bits -= 8;
  }
  stream.cur = at;
  stream.pk.free_bits = bits;
}

// Everything an alternate model needs before its first symbol: the residual
// alphabet's two limits, the symbol tree's level geometry, and 1024 seeded
// frequency strips.  None of it is range coding -- `rc_begin` was doing this
// and the coder's own init in one function, which is why it was 90 lines.
static uint16_t* begin_plane_stream() {
  if( plane_predictor==pred_p2 ) {
    alt_freq_init = 8;
    alt_freq_limit = 8;
  } else {
    alt_freq_limit = 16;
    alt_freq_init = 64;
  }
  // Six levels of a binary symbol tree, laid out end to end.  Level `lvl`
  // holds `2^(lvl-2)` pairs, starts at `first`, and its frequency table
  // starts at `first - lvl` -- except level 2, whose base is 0 rather than
  // -2, and levels 2 and 3, whose `first` the original wrote as constants
  // because the recurrence has not started yet.  `model_geometry[i]` is the
  // level that owns slot `i`.
  //
  // The decompilation wrote all six out, with `at4`..`at7` naming the running
  // offset at four of them and the other two folded into constants.
  model_geometry[0] = 0;
  model_geometry[1] = 1;
  level_geom[2].half = 1;
  level_geom[2].first = 2;
  level_geom[2].tbl_base = 0;
  memset(&model_geometry[2], 2, 2);
  int32_t slot = 4;
  for( int32_t lvl = 3; lvl<8; ++lvl ) {
    level_geom[lvl].half = 1<<(lvl-2);
    level_geom[lvl].first = (uint8_t)slot;
    level_geom[lvl].tbl_base = (uint8_t)slot-lvl;
    memset(&model_geometry[slot], lvl, 2*level_geom[lvl].half);
    slot += 2*level_geom[lvl].half;
  }
  // The model's frequency tables, one allocation.  `0x7F000` is 520192 bytes
  // and the shape behind it is `model_geometry`'s: it is a byte count in the
  // decompilation and stays one, because nothing here divides it by an
  // element size.
  uint16_t* tbl = model_table_store;
  if( tbl ) {
    int32_t k = 0;
    uint16_t *row = tbl;
    // The ten numbers every row starts from.  They were ten stores in
    // scheduler order with `row[0]` last and spelled `*row`, one row at a
    // time, a thousand and twenty-four times; the values are unrelated to each
    // other, so this is a table and not a loop, and index order is the only
    // thing that lets it be read against the model it seeds.
    const uint16_t seed_row[10] = {
      635, (uint16_t)(24*alt_freq_limit), 205, 124, 147, 83, 48, 16, 8, 4,
    };
    for( k = 0; k<0x400; ++k, row += 254 ) {
      memcpy(row, seed_row, sizeof seed_row);
      FreqPair* seed = (FreqPair*)&row[10];
      for( uint32_t i = 0; i<0x7A; ++i ) {
        seed[i].f[0] = 60;
        seed[i].f[1] = 36;
      }
    }
  }
  model_tables = tbl;
  return tbl;
}

// The two heads of a stream, and the three steps are three functions now: give
// the packer's spare bytes back, set the model up if the header named one, and
// start the coder.
//
// Three things are genuinely one-sided and each is under `f_DEC`: the encoder
// flushes the packer's accumulator into the stream first, the encoder's counter
// runs forward and the decoder's back, and the coder is initialised for the
// direction it is about to run in.
//
// It used to return `tbl` *uninitialised* when `plane_alt_model` was clear,
// with a comment that the one caller reads it only under the same flag.  It
// returns null there instead: that is what the caller behaves as if it got,
// and it is not undefined.
template<int32_t f_DEC>
uint16_t*rc_begin() {
  if constexpr( !f_DEC )
    *stream.pk.word = stream.pk.acc;
  packer_rewind();
  uint16_t* tbl = plane_alt_model ? begin_plane_stream() : nullptr;
  if constexpr( f_DEC )
    rc.dec_init();
  else
    rc.enc_init();
  return tbl;
}

uint16_t*rc_begin_encode() {
  return rc_begin<0>();
}

void rc_begin_decode() {
  rc_begin<1>();
}

static uint32_t packer_word() {
  if( stream.cur+4>stream.buf+stream.size )
    bmf_fatal(bmf_read_error);
  uint32_t w = *(uint32_t*)stream.cur;
  stream.cur += 4;
  return w;
}

// Rewind the packer to the start of the coded buffer.  `search_filter` encodes
// the same tile once per candidate flag and measures the bytes each time, so it
// does this between every trial; seven sites wrote all five lines out, and the
// fifth -- `hist_scratch`, which is a *different* buffer's cursor that happens
// to live at the far end of this one -- is the one a reader has to remember is
// part of the reset.
static void packer_reset() {
  stream.pk.free_bits = 0;
  stream.pk.acc = 0;
  stream.cur = stream.buf;
  stream.pk.word = (uint32_t*)stream.buf;
  hist_scratch = stream.buf+stream.size-4096;
}

// A coded buffer for an image of `data_size` bytes, with the packer rewound
// onto it.  128K of headroom past the pixels, which is what the three encoding
// entry points allocate: the size is written into `stream.size` first because
// `packer_reset` reads it back to place `hist_scratch` at the far end.
static void stream_open(uint32_t data_size) {
  stream.size = data_size+0x20000;
  stream.buf = (uint8_t*)bmf_new(stream.size);
  packer_reset();
}

// The other half of `packer_reset`: put the accumulator's last, partial word
// where the next spill would have put it, so that `stream.cur - stream.buf` is
// the byte count of everything coded.  Eight sites wrote it out as
// `*(uint32_t*)stream.pk.word = stream.pk.acc;` -- seven of them in
// `search_filter`, which measures a trial encode and flushes after each -- and
// the cast is to the type `pk.word` already has, so it said nothing at all.
static void packer_flush() {
  *stream.pk.word = stream.pk.acc;
}

// The header's bit stream: the per-plane descriptors, a few bits at a time,
// through a 32-bit accumulator that spills to `stream.pk.word` when it fills.
//
// `compress_image` wrote this out six times and `expand_image` its mirror six
// times, at widths 4, 6 and 8.  What made the six copies look unlike each other
// was the count: it was kept in `bits_left`, `free_bits` or `stream.pk.free_bits`
// depending on the site, and every spill branch read the guard variable in one
// place and `stream.pk.free_bits` in another.  They agreed because the line before
// each block assigned one from the other; here there is one name and nothing to
// keep in step.
//
// The order below is the one thing to preserve when reading this against the
// original: the spill branch's `stream.pk.acc` is computed from the count *before*
// the count moves on.  Writing the count first would shift the carry-out by the
// width.
static void pack_bits(uint32_t word, int32_t n) {
  if( stream.pk.free_bits<n ) {
    *stream.pk.word = stream.pk.acc|(2*(word<<((31-stream.pk.free_bits)&31)));
    stream.pk.word = (uint32_t*)stream.cur;
    stream.cur += 4;
    stream.pk.acc = word>>(stream.pk.free_bits&31);
    stream.pk.free_bits += 32-n;
  } else {
    stream.pk.acc |= word<<(-stream.pk.free_bits&31);
    stream.pk.free_bits -= n;
  }
}

static uint32_t unpack_bits(int32_t n) {
  const uint32_t mask = (1u<<n)-1;
  uint32_t v;
  stream.pk.free_bits -= n;
  if( stream.pk.free_bits<0 ) {
    const uint32_t w = packer_word();
    v = stream.pk.acc|((w<<((stream.pk.free_bits+n)&31))&mask);
    stream.pk.acc = w>>(-stream.pk.free_bits&31);
    stream.pk.free_bits += 32;
  } else {
    v = stream.pk.acc&mask;
    stream.pk.acc = stream.pk.acc>>n;
  }
  return v;
}

// sym_code.inc -- the symbol trees: a symbol through a tree of binary counters, both
// ways, for both models.

// One symbol out of a level's tree.  The two directions meet at `lvl`, the slot
// in the level frequencies: the encoder is handed a symbol and looks its level
// up in `model_geometry`, the decoder walks the same frequencies until it
// passes the point the coder gave it.  From there the rescale, the escape
// counter and the walk down the binary tree are the same code.
//
// The guard on the walk reads `lvl >= 2` for both, where the encoder said
// `sym >= 2`.  They are the same test: `model_geometry` is 0 at 0, 1 at 1 and
// 2 or more everywhere above -- rc_begin lays it out that way -- so a symbol
// below two has its own index as its level, which is also what the decoder
// returns for those two.
//
// The rescale halves freq[2..9] and leaves the sum in *freq, and the two bodies
// did it with the loads and stores interleaved differently and different
// intermediates -- acc6/acc8/h9 against sum6/h6/h8, some int16_t and some
// uint16_t.  It is the same sum: every intermediate is 16 bits wide and the
// result is stored through a uint16_t, so the orderings agree in the low 16
// bits, which is all of them that survive.  The encoder's spellings are kept.
// Both counts of a bit-tree pair halved, answering the one the walk took.  Two
// sites wrote it out, each with a temporary for `f[1]` -- `f[0]` is halved in
// place first, and the temporary is how the original kept `f[1]` in a register
// across that store.  That is a scheduling record, not a dependency: the two
// counts are independent, and the halving is `halve_counts` like every other
// counter pair in the program.
//
// The two sites differ only in the limit that triggers them -- 0x4000 where the
// coder reads it and 0x2000 where the cost estimator does -- so the limit stays
// at the call and the halving is here.
static inline uint32_t halve_pair(FreqPair* pair, int32_t go) {
  halve_counts(pair->f, 2);
  return pair->f[go];
}

template<int32_t f_DEC>
int32_t code_symbol_tree(uint16_t* freq, int32_t sym) {
  uint16_t add;
  uint32_t cum, j;
  int32_t lvl, result, go, span;
  uint16_t fq, *slot;
  uint16_t *f0 = freq+2;
  uint32_t tot = freq[0];
  if constexpr( f_DEC ) {
    uint32_t target = rc.get_freq(tot);
    slot = f0;
    lvl = 0;
    cum = f0[0];
    if( cum<=target ) {
      do {
        ++slot;
        ++lvl;
        cum += *slot;
      } while( cum<=target );
    }
    rc.decode(cum-*slot, cum, tot);
  } else {
    lvl = model_geometry[sym];
    cum = 0;
    for( j = 0; j<(uint32_t)lvl; j++ )
      cum += f0[j];
    slot = &f0[lvl];
    uint32_t cum_hi = cum+*slot;
    result = rc.encode(cum, cum_hi, tot);
  }
  if( freq[0]>0x4000u ) {
    // The eight level counts halved, and their new total.  Twenty-six lines
    // until the `*(freq+K)` spellings became subscripts and the shape showed:
    // `freq[k] -= freq[k]>>1` for k in 2..9, with a running sum landing in
    // `freq[0]`.  That is `halve_up`, which this file's four siblings already
    // call through `halve_counts` -- `P2Freq` halves three the same way twice
    // over, `BitCtr::scale_rare` two, `halve_pair` a bit-tree pair.
    //
    // The unrolling carried six accumulators (`h2`, `acc`, `h4`, `sum4`,
    // `acc6`, `acc8`, `h9`) that are one running total interleaved with the
    // stores in the order the registers came free, and one of them was
    // `int16_t` where the rest are `uint16_t`.  That only matters above 32767,
    // where the signed one would go negative and sign-extend into the next
    // term; the assert is what says it cannot.  Instrumented over the corpus
    // the total reaches 16431 and the `int16_t` partial 16396 -- the rescale
    // fires at 16384, which is what bounds both.
    halve_counts(freq+2, 8);
    uint16_t total = 0;
    for( int32_t k = 2; k<10; ++k )
      total += freq[k];
    BMF_ASSUME(total<0x8000u);
    int32_t esc = freq[1];
    freq[0] = total;
    if( esc<=4*alt_freq_limit ) {
      result = 4*(esc>alt_freq_limit);
      add = esc-result;
      freq[1] = add;
    } else {
      add = esc-16;
      freq[1] = add;
    }
  } else {
    add = freq[1];
  }
  *slot += add;
  freq[0] += freq[1];
  if( lvl<2 )
    return lvl;
  int32_t mask = level_geom[lvl].half;
  // The bits the encoder still has to send.  The decoder has none, and every
  // read of this is inside a branch `if constexpr` discards there -- so the 0
  // is never observed and exists only so the declaration can sit here, at the
  // one place the value is produced, rather than in the frame at the top.
  int32_t path = 0;
  if constexpr( !f_DEC )
    path = sym-level_geom[lvl].first;
  int32_t node = 0;
  for( span = 1;; span *= 2 ) {
    FreqPair *pair = bit_tree(freq, lvl)+span+node;
    int32_t f1 = pair->f[1];
    int32_t fa = pair->f[0];
    if constexpr( f_DEC ) {
      go = rc.decode_bit(fa, f1);
    } else {
      go = (mask&path)!=0;
      result = rc.encode_bit(fa, f1, go);
    }
    fq = pair->f[go];
    if( fq>0x4000u )
      fq = halve_pair(pair, go);
    pair->f[go] = alt_freq_init+fq;
    mask >>= 1;
    node = go+2*node;
    if( !mask )
      return node+level_geom[lvl].first;
  }
}

void encode_symbol_tree(uint16_t* freq, int32_t sym) {
  code_symbol_tree<0>(freq, sym);
}

int32_t decode_symbol_tree(uint16_t* freq) {
  return code_symbol_tree<1>(freq, 0);
}

// One symbol of the one-bit model's alphabet.  The two directions meet at the
// slot: the encoder is given a symbol, maps it to a slot and sums the
// frequencies below it; the decoder is given a point in the range and walks the
// same frequencies until it passes it.  Everything after -- the rescale at
// 0x2000, the +32 on the slot and the total, the escape into the binary tree
// for slots 5 and up -- is the same code, and was written twice.
//
// `slot` is `cur - base` in both, which is why the tail can be shared: the
// encoder's `cur = &base[slot]` and the decoder's walk leave it in the same
// place.  The decoder folds the tree's answer back into the slot; the encoder
// sends it and has nothing to fold.
//
// The two bodies differed in a handful of casts as well -- `(uint16_t)freq[1]`
// against `freq[1]`, `int16_t tot_new` against `int32_t result`.  None of them
// is a difference: `freq` is `uint16_t *`, so the casts are the promotion that
// was already happening, and the two totals agree in the low 16 bits that
// `*freq` and `& 0x7FFF` keep.  The encoder's spellings are the ones kept.
template<int32_t f_DEC>
int32_t CounterNode::code_symbol(int32_t ctx, int32_t sym) {
  uint32_t cum;
  int32_t slot;
  uint16_t *cur = c;
  const uint32_t tot = total&0x7FFF;
  if constexpr( f_DEC ) {
    sym = rc.get_freq(tot);
    cum = c[0];
    while( cum<=(uint32_t)sym )
      cum += *++cur;
    rc.decode(cum-*cur, cum, tot);
  } else {
    slot = sym_slot(sym);
    cum = 0;
    for( int32_t k = 0; k<slot; k++ )
      cum += c[k];
    cur = &c[slot];
    rc.encode(cum, cum+*cur, tot);
  }
  // Halve or third every counter once the total passes 0x2000, and start the
  // new total at 0x8000 -- the top bit is the flag `tot` masks off above.
  //
  // The decompilation wrapped this in two comparisons and a `done` flag:
  // `freq+7 < base` and `freq+7 >= base` with `base = freq+1`, which are
  // `false` and `true` for any pointer.  Both loops always ran; the flag was
  // MSVC's register for a branch it had already decided.
  if( tot>0x2000 ) {
    total = 0x8000;
    int32_t lo = 256;
    for( int32_t k = 6; k>=0; --k )
      if( c[k]<lo )
        lo = c[k];
    for( int32_t k = 6; k>=0; --k ) {
      const uint16_t nf = lo<=1 ? c[k]-(c[k]>>1) : (c[k]+2)/3;
      c[k] = nf;
      total += nf;
    }
  }
  *cur += 32;
  const int32_t result = total+32;
  total = result;
  slot = cur-c;
  if( slot>=5 ) {
    // The same three fields `alt_p1_block` builds -- the escape's parity at bit
    // 7, "this slot holds more than half" at bit 6, the caller's context under
    // both -- and *not* `CounterNode::escape_high`, which is the same test
    // without the `+ 96`.  Ninety-six is three of the 32s a coded symbol adds,
    // and whether it belongs here or there is not answerable from the source;
    // the binary has it on this side only, so this keeps its own comparison and
    // says why rather than sharing a method that would be wrong by 96.
    //
    // Written as `((c[0] + tot + 96 - 2*c[slot]) >> 25) & 0xFFFFFFC0`: an
    // unsigned wrap, a logical shift to 127, and a mask down to 64.  That is
    // this comparison, and it is worth having on the page as one.
    uint16_t*const strip = model_strip(
        CtxIdx{}.bit<7>(slot&1)
                .bit<6>(2u*c[slot]>c[0]+(uint32_t)(result&0x7FFF)+96)
                .raw((uint32_t)ctx));
    if constexpr( f_DEC )
      slot += 2*decode_symbol_tree(strip);
    else
      encode_symbol_tree(strip, (sym-5)>>1);
  }
  return slot;
}

// The donor pushed a third argument neither body reads.  `tools/deadparam.py`
// took it and the two it was forwarded from.
void alt_p1_encode_symbol(CounterNode* node, int32_t ctx, int32_t sym) {
  node->code_symbol<0>(ctx, sym);
}

int32_t alt_p1_decode_symbol(CounterNode* node, int32_t ctx) {
  return node->code_symbol<1>(ctx, 0);
}



int32_t update_binary_pair(uint16_t* _this, int32_t symbol) {
  int32_t node;
  uint32_t step, f;
  int32_t tot = _this[0];
  if( (uint32_t)tot<=0x8000 ) {
    int32_t lvl = model_geometry[symbol];
    step = (_this[1]>>2)&0xFFFFFFE0;
    if( plane_predictor==pred_p2 )
      step = 15*(_this[1]>>5);
    _this[lvl+2] += step+4;
    tot = _this[0]+step+4;
    _this[0] = tot;
    if( symbol>=2 ) {
      int32_t mask = level_geom[lvl].half;
      int32_t path = symbol-level_geom[lvl].first;
      node = 0;
      FreqPair *tbl = bit_tree(_this, lvl);
      int32_t span = 1;
      do {
        FreqPair *pair = tbl+node+span;
        int32_t go = (mask&path)!=0;
        f = pair->f[go];
        if( f>0x2000 )
          f = halve_pair(pair, go);
        span *= 2;
        mask >>= 1;
        node = go+2*node;
        pair->f[go] = f+((alt_freq_init*((uint32_t)(plane_predictor==pred_p2)+5))>>3);
      } while( mask );
      return 0;
    }
  }
  return tot;
}

// The histogram's entropy, in bits, as one number:
//
//     (N*ln N - sum of n_i*ln n_i) * log2(e)
//
// which is `N * H(p)` -- the total cost of coding N symbols with these
// frequencies, not the per-symbol cost.  Both decision bodies compare
// candidates through this and nothing else.
//
// The two accumulators over even and odd bins are the original's pairing, for
// a two-lane SSE add that is not here any more.  `dupblock.py` reports the two
// halves as copy, and they stay: floating-point addition is not associative, so
// `(a + c) + (b + d)` and `((a + b) + c) + d` are different sums of the same
// four numbers, and this one feeds a comparison that decides a filter.
//
// **It is declined with a measurement rather than on principle.**  Rolling the
// two lanes into one loop passes all 110 checks over all seventeen images --
// no stream moves.  That makes it corpus-verified rather than true by
// construction, which is not the same thing: the next image is not in the
// corpus.  The same rule kept `neighbour_rank` reading its own four slots for
// a round.
// `n` is a count of bins and not of bytes.  The parameter was `uint8_t *` with
// the cast to `const int32_t *` on the first line, and the byte pointer reached
// back into every caller: two histogram arrays were *declared* `uint8_t[2048]`
// and written through `*(uint32_t *)&buf[4*bin]` because that is what fits a
// byte pointer, and the thirteen that were declared as counters all the way
// through had to cast to hand one over.
int32_t estimate_cost(const int32_t* bin, int32_t n) {
  double sum_even = 0.0, sum_odd = 0.0, ent_even = 0.0, ent_odd = 0.0;
  int32_t i;
  for( i = 0; i+1<n; i += 2 ) {
    if( bin[i] ) {
      sum_even += (double)bin[i];
      ent_even += (double)bin[i]*log((double)bin[i]);
    }
    if( bin[i+1] ) {
      sum_odd += (double)bin[i+1];
      ent_odd += (double)bin[i+1]*log((double)bin[i+1]);
    }
  }
  double entropy = ent_even+ent_odd;
  double total = sum_even+sum_odd;
  for(; i<n; i++ )
    if( bin[i] ) {
      total += (double)bin[i];
      entropy += (double)bin[i]*log((double)bin[i]);
    }
  if( total!=0.0 )
    total = total*log(total);
  return (int32_t)((total-entropy)*1.442695040888963);
}

// model_workspace.inc -- the main model's workspace: how it is laid out and how it is given
// back.

// One bank of symbol lists, and the block behind it.  Written out twice, once
// for each of the two banks, ten lines apart.
static void free_sym_lists(SymList* lists) {
  if( !lists )
    return;
  uint32_t n = sym_list_count(lists);
  for( SymList* p = &lists[n]; p>lists; )
    free((--p)->ent);
  free(sym_list_block(lists));
}

// Returns nothing, and takes nothing.  It returned `(void**)this` -- after
// `free(this)` on the path that takes it, so the value was a dangling pointer
// -- and neither of the two callers reads it.  The `do_free` flag it tested is
// 1 at every call site of all four functions in this family (`alt_p1_free`,
// `alt_model_p1_d8_decode`, `alt_p2_free` and this), which is the same
// artefact one level up: the decompiler writes the register that happened to
// hold `this` as a return value wherever MSVC left it there, and a flag whose
// false arm no caller takes as a parameter.
void ModelBlock::free_workspace() {
  free(sym_word);
  free_sym_lists(sel1_list);
  free_sym_lists(sel0_list);
  free(escape.ent);
  model_blocks.give(this);
}

// A block on the heap, laid out for one image.  Both plane coders wrote the
// allocation out and each guarded it the same way: call `layout_workspace` on
// the raw pointer if `bmf_new` returned one, and hand back null otherwise --
// which the caller then dereferenced unconditionally.  That is the binary's
// behaviour and it stays; the guard is one place now rather than two.
ModelBlock* new_model_block(int32_t img_w, int32_t img_h, int32_t img_depth) {
  void* raw = model_blocks.take(false);
  return ((ModelBlock*)raw)->layout_workspace(img_w, img_h, img_depth);
}

ModelBlock*ModelBlock::layout_workspace(int32_t img_w, int32_t img_h, int32_t img_depth) {
  int32_t j;
  uint32_t k, m, s, n;
  exclusion_gen = 1;
  width = img_w;
  height = img_h;
  depth = img_depth;
  depth_raw = img_depth;
  escape.ent = nullptr;
  sym_code = nullptr;
  for( j = 0; j<5; ++j ) {
    // The block's own storage, as the two alternate models' rings are.  Both
    // cursor sets point into it -- `row_cur[j]` at the start and `row_cur[j+5]`
    // one past the left margin -- and neither is ever freed now.
    PixRec* buf = row_store[j];
    row_cur[j] = buf;
    // The second cursor set starts one past the margin, and `start_row` then
    // reseats it *at* the margin -- so the 8 here and the 7 there are the same
    // edge approached from two sides, which is why they differ by one.
    row_cur[j+5] = buf+ModelBlock::kRowMargin+1;
    // `width + 16` is never negative -- `width` is a `uint16_t` field -- so the
    // `> -16` guard the `do` needed to be safe is gone with it, and so is the
    // `w = width` the loop re-did on every record.  The 16 is the two margins:
    // `ModelBlock::kRowMargin` on the left, which is what makes `row[-8]`
    // defined once the cursor has stepped, and `kRowTail` on the right.
    //
    // `w` itself is gone too: it was `img_w` at the top and `width` here, and
    // its last reader was the `bmf_new(w + 1)` that `run_bucket_store` replaced.
    for( uint32_t r = 0; r<width+(uint32_t)(ModelBlock::kRowMargin+ModelBlock::kRowTail); ++r ) {
      row_cur[j][r].sym = 0;
      for( int32_t i = 0; i<6; ++i ) row_cur[j][r].match[5-i] = 1;
    }
  }
  BMF_ASSUME(width<=(uint32_t)kMaxWidth);
  uint8_t* runs = run_bucket_store;
  run_bucket = runs;
  *runs = 0;
  {
    // The post-increment inside the subscript -- `run_bucket[x+++1]` -- is the
    // one shape Phase 2 asks to be pulled out: it reads as `x + 1` and is
    // `(x++) + 1`.
    uint8_t bucket = 0;
    for( uint32_t x = 0; x<width; ++x ) {
      bucket += x==2u<<(bucket&31);
      run_bucket[x+1] = bucket;
    }
  }
  __builtin_memset(sym_rev, 0, sizeof sym_rev);
  for( k = 0; k<0x2000; ++k ) {
    uint16_t rev = sym_rev[k];
    int32_t bits = k;
    for( m = 0; m<0xD; ++m ) {
      rev += rev+(bits&1);
      bits >>= 1;
    }
    sym_rev[k] = rev;
  }
  for( s = 0; s<0x2000; ++s )
    sym_rev[s] *= 8;
  memset(&grid[188], 0, 0x100000);
  ctx_id3_used = 0;
  ctx_id2_used = 0;
  ctx_id1_used = 0;
  memset(ctx_id1, 255, sizeof ctx_id1);
  memset(ctx_id2, 255, sizeof ctx_id2);
  memset(ctx_id3, 255, sizeof ctx_id3);
  memset(exclusion_mask, 0, sizeof exclusion_mask);
  sel[0] = nullptr;
  sel[1] = nullptr;
  escape_list = nullptr;
  for( n = 0; n<0x40000; ++n ) {
    sym_ctr[2*n] = no_symbol;
    sym_ctr[2*n+1] = no_symbol;
  }
  for( uint32_t k8 = 0; k8<8; ++k8 ) {
    bit_root[2*k8].init_root();
    bit_root[2*k8+1].init_root();
  }
  memset(bit_node, 0, sizeof bit_node);
  sym_word = (uint16_t*)bmf_new(2*height*width);
  esc_ctr[0].init_parent();
  memset(&esc_ctr[1], 0, 1536);
  for( uint32_t k24 = 0; k24<0x18; ++k24 ) {
    run_ctr[2*k24].init_parent();
    run_ctr[2*k24+1].init_parent();
  }
  return this;
}

// sym_reduce.inc -- drop the symbols an image does not use, and renumber what is left.

// One node of the wide arm's search tree: a symbol value and its two children,
// in the eight bytes MSVC gave each of them.
//
// The recovery had this as two arrays.  The value was `buf[8*node]` read
// through a `uint32_t *` and the children were `kids[node]`, a `uint16_t[4]`,
// and the two *interleave*: `kids` begins four bytes after `buf` and both
// stride by eight, so `kids[n]`'s first two entries are the children of the
// value at `buf[8*n]` and its last two are the next value.  That is one array
// of one record written as two, and the only reason for `[127]` is that 127
// was as far as the recovery could see it indexed.
//
// How many there are is not a guess either: `memset(buf, 0, 0x10000)` clears
// 65536 bytes, which is 8192 of these, and the tree gives up at 0x2000 nodes.
// `_pad0[64504]` was the difference between the 127 and the 8192.
struct ReduceNode {
  uint32_t val;
  uint16_t kid[2];
};

static_assert(sizeof(ReduceNode) == 8,
              "the tree strides by eight bytes per node");

// Eight bits or fewer, where a symbol is a byte (or a packed field of one) and
// the whole alphabet fits in a 256-entry flag table.  Count the distinct
// symbols, code the count, then code the gaps between the ones that occur and
// renumber the image through the same table.
//
// The wide arm below does none of this -- it builds a binary search tree over
// multi-byte symbols -- and the two shared nothing but a frame and 350 lines.
static void reduce_narrow_alphabet(SymList* lists, ModelBlock* blk1, uint8_t* src,
                                   uint32_t mask) {
  int32_t n_distinct, y, bits, shift, prev, s, s_next;
  uint32_t n_syms3, sym_flag[256];
  // The flag table, one entry per symbol, and then the renumbering: the same
  // 1024 bytes hold a 0/1 flag while the alphabet is being counted and the new
  // symbol number afterwards.  It was `(uint32_t *)&kids_i` -- the frame's
  // node array read from four bytes before it -- because the two arms of
  // `reduce_alphabet` share one stack area and MSVC gave them one slot.  Only
  // one of the two ever runs, so this arm can own its table.
  memset(sym_flag, 0, sizeof sym_flag);
  bool packed = blk1->depth<8;
  int32_t height = blk1->height;
  blk1->alphabet = 0;
  if( packed ) {
    n_distinct = 0;
    if( height ) {
      // `at` and `y` were `at_spill` and `y_spill`, two more slots in that
      // shared area, written at the bottom of the row loop and read back at
      // the top of the next -- which is what a local does.  `bits_spill` was
      // narrower still: assigned `shift` and read back four lines later.
      // `row_w = blk1->width` was restated inside the pixel loop, and the
      // `break` above tested it -- a member nothing in either body writes, so
      // the test is the same answer on every row and the `for` below carries
      // it.  `shift & 31` is a dead mask: this path is sub-byte only, so `bpp`
      // is 1, 2 or 4 and the shift is under 8.
      const uint8_t* p = src-1;
      int32_t at = 0;
      const int32_t bpp = blk1->depth;
      for( y = 0; y<blk1->height; ++y ) {
        bits = 0;
        for( uint32_t x = 0; x<blk1->width; ++x, ++at ) {
          shift = bits-bpp;
          if( shift<0 ) {
            ++p;
            shift = 8-bpp;
          }
          const uint32_t sym = mask&(*p>>shift);
          blk1->alphabet += sym_flag[sym]==0;
          sym_flag[sym] = 1;
          bits = shift;
          blk1->sym_word[at] = sym;
        }
      }
      n_distinct = blk1->alphabet;
    }
  } else if( height&&blk1->width ) {
    const uint8_t *q = src;
    const uint32_t n_pix = blk1->height*blk1->width;
    for( uint32_t idx = 0; idx<n_pix; ++idx ) {
      const int32_t sym2 = *q++;
      blk1->alphabet += sym_flag[sym2]==0;
      sym_flag[sym2] = 1;
      blk1->sym_word[idx] = sym2;
    }
    n_distinct = blk1->alphabet;
  } else {
    n_distinct = 0;
  }
  rc.encode(n_distinct-1, n_distinct, mask+1);
  uint32_t n_syms = blk1->alphabet;
  if( n_syms<=mask ) {
    lists[0].init(mask-n_syms+2, 1);
    lists[0].rescale_at = 19*lists[0].n;
    n_syms3 = blk1->alphabet;
    if( n_syms3 ) {
      prev = 0;
      s = 0;
      uint32_t next_id = 0;
      do {
        if( sym_flag[s] ) {
          lists[0].code_symbol(s-prev);
          n_syms3 = blk1->alphabet;
          sym_flag[s] = next_id;
          s_next = s+1;
          prev = s+1;
          ++next_id;
        } else {
          s_next = s+1;
        }
        s = s_next;
      } while( next_id<n_syms3 );
    }
    {
      // Every pixel through the reduced alphabet.  The `if` was the `do`'s
      // guaranteed first turn being made safe for an empty image.
      const uint32_t n_pix = blk1->height*blk1->width;
      for( uint32_t m = 0; m<n_pix; ++m )
        blk1->sym_word[m] = sym_flag[blk1->sym_word[m]];
    }
    free_sym_entries(lists, 16);
  } else {
    free_sym_entries(lists, 16);
  }
}

// Find `val` in the tree, hanging a new leaf off the side the walk fell out
// of when it is not there.  Returns the node holding `val` afterwards, or -1
// when that insert took the alphabet past the 0x2000 the tree gives up at.
//
// This was the deepest thing in the file: a `while( 1 )` inside an `if` inside
// an `if` inside a `while( 1 )`, with a `goto` out of the middle of it to a
// label six lines below the outer loop's bottom.  The jump and the label are
// the same statement said twice -- "the node for `val` is settled, go record
// it" -- which is what a return is.
//
// `mode_symbol[1]` is the side the leaf was hung on, and it is read by the
// caller's caller rather than here, so it stays a global write.
static int32_t tree_place(ReduceNode* tree, ModelBlock* blk, uint32_t val) {
  int32_t node = 0, side;
  uint16_t* kidp;
  while( 1 ) {
    side = tree[node].val<val;
    kidp = tree[node].kid;
    node = kidp[side];
    if( !node )
      break;
    if( val==tree[node].val ) {
      mode_symbol[1] = side;
      return node;
    }
  }
  int32_t alphabet = blk->alphabet;
  mode_symbol[1] = side;
  node = (uint16_t)alphabet;
  int32_t alpha = alphabet+1;
  kidp[side] = node;
  blk->alphabet = alpha;
  if( alpha>0x2000 )
    return -1;
  tree[node].val = val;
  return node;
}

// The wide arm: symbols too big for a flag table, so the distinct values go
// into a binary search tree and the image is renumbered through it.
//
// This was the last reconstructed stack frame in the tree, and every one of its
// members turned out to be one of three things.  `zero_base[15]` was 60 bytes
// nothing read.  `slot0`..`slot11` were spills: MSVC keeps `blk1`, `n_kids`,
// `srcp`, `p` and `written` in registers, drops them to the stack across a call
// or an inner loop, and reads them back, so `frame.slot9 = n_kids;` twelve
// lines above `n_kids = frame.slot9;` says nothing that `n_kids` does not.
// What is left is `out`, and that one is real: the same eight bytes hold the
// source cursor's spill early on and an output cursor later, which is what the
// union recorded and why the slots could not simply be renamed apart.
void reduce_alphabet(ModelBlock* blk, uint8_t* src) {
  ReduceNode tree[8192];
  SymList lists[16];
  // `out[1]` is the buffer the plane is de-interleaved into and `out[2 + k]`
  // walks component `k` of it.  Nineteen entries because that is how wide the
  // slot was; a depth the header admits is at most 32 bits, so at most four
  // components, so nothing past `out[5]` is ever touched.
  uint8_t* out[19];
  uint32_t alpha_n, done;
  int32_t node, carry;
  uint32_t word, k;
  uint8_t *rp;
  uint32_t sym_bits = blk->depth;
  uint32_t mask = 0xFFFFFFFF>>(-sym_bits&31);
  uint32_t n_kids = (sym_bits+7)>>3;
  // One symbol's bytes as a word.  `p` walks by `n_kids`, which is 2, 3 or 4
  // here, so two of the three strides leave these loads *unaligned* -- and
  // `*(uint32_t*)p` on an unaligned address is the aliasing violation the
  // `-fno-strict-aliasing` build has been carrying rather than the alignment
  // fault it would be elsewhere.
  //
  // `memcpy` is the standard-sanctioned spelling and compiles to the same
  // unaligned load at -O2.  Not `std::bit_cast` over a `std::array` (kimi's
  // suggestion): that works but goes the long way round, and `hist_bump` next
  // door already uses `memcpy` for exactly this.
  auto load32 = [](const uint8_t* at) {
    uint32_t v;
    memcpy(&v, at, sizeof v);
    return v;
  };
  clear_sym_lists(lists);
  if( sym_bits<=8 ) {
    reduce_narrow_alphabet(lists, blk, src, mask);
  } else {
    memset(tree, 0, sizeof tree);
    blk->alphabet = 1;
    tree[0].val = mask&load32(src);
    blk->sym_word[0] = 0;
    if( (uint32_t)(blk->height*blk->width)>1 ) {
      uint8_t *p = src;
      node = 0;
      uint32_t written = 1;
      while( 1 ) {
        p += n_kids;
        uint32_t val = mask&load32(p);
        // `node = 0` makes `tree[node]` the root, so the second test is the
        // first one again with the walk restarted -- and the overflow check
        // can sit beside it rather than one level in, because a value that is
        // the root's is node 0 and never negative.
        if( val!=tree[node].val ) {
          node = 0;
          if( val!=tree[0].val )
            node = tree_place(tree, blk, val);
          if( node<0 )
            break;
        }
        blk->sym_word[written++] = node;
        if( written>=(uint32_t)(blk->height*blk->width) )
          break;
      }
    }
    // Both exits of the loop above jumped here past this line, which is the
    // line they set `alpha_n` from.  Leaving the loop runs it.
    alpha_n = blk->alphabet;
    rc.encode(alpha_n-1, alpha_n, 0x2001u);
    if( blk->alphabet>0x2000 ) {
      out[1] = (uint8_t*)bmf_new(blk->height*n_kids*blk->width);
      int32_t img_w = blk->width;
      int32_t img_h = blk->height;
      uint32_t plane_size;
      if( n_kids ) {
        plane_size = img_h*img_w;
        if( n_kids>>1 ) {
          // `2*pairs++*plane_size` is the post-increment-in-an-expression
          // Phase 2 asks for by name: it reads as `2 * pairs * plane_size`.
          uint8_t *half = out[1]+img_h*img_w;
          uint32_t pairs = 0;
          for( ; pairs<n_kids>>1; ++pairs ) {
            const uint32_t slot_a = 2*pairs;
            const uint32_t off = 2*pairs*plane_size;
            out[slot_a+2] = out[1]+off;
            out[slot_a+3] = &half[off];
          }
          done = 2*pairs+1;
        } else {
          done = 1;
        }
        if( n_kids>(done-1) )
          out[done+1] = out[1]+img_h* -img_w+plane_size*done;
      } else {
        plane_size = img_h*img_w;
      }
      if( plane_size ) {
        // Deinterleave: each turn scatters `n_kids` consecutive source bytes
        // to the `n_kids` component cursors, one byte each, `plane_size`
        // turns.
        //
        // This was two `while( 1 )`s, a `goto` out of both and a `break` that
        // lands in the same place, and the shape of it was an unrolling by
        // *two*: an inner pair loop over `n_kids >> 1` and then a single extra
        // component for an odd count.  Which loop carried the turn counter
        // depended on the parity -- for an even `n_kids` the inner one broke
        // at once and the outer counted, for an odd one the inner never broke
        // and counted itself -- so the two increments are one increment and
        // the two loops are one loop.
        //
        // The pair loop's `j` reached `out[2*j+2]` and `out[2*j+3]` from
        // `rp[2*j]` and `rp[2*j+1]`, and the odd tail reached `out[2*n+2]`
        // from `rp[2*n]`: `out[c + 2]` takes `rp[c]` in both, which is the
        // line below.
        rp = src;
        if( n_kids ) {
          for( uint32_t moved = 0; moved<plane_size; ++moved ) {
            for( uint32_t c = 0; c<n_kids; ++c )
              *out[c+2]++ = rp[c];
            rp += n_kids;
          }
        }
      }
      uint16_t* old_words = blk->sym_word;
      blk->height = n_kids*img_h;
      blk->depth = 8;
      free(old_words);
      void *newbuf = bmf_new(2*blk->height*blk->width);
      blk->sym_word = (uint16_t*)newbuf;
      reduce_alphabet(blk, out[1]);
      free(out[1]);
    } else {
      // `alpha_m` was re-read from `blk->alphabet` after the list setup and
      // again inside the loop below as `si_end`, across walks that touch
      // neither -- the same spilling `expand_alphabet` does on its side.  One
      // read.  `word` likewise: the byte loop shifts it down and the line after
      // reloads it, and the only thing the reload feeds is the carry, which
      // wants the *low* byte.
      init_byte_lists(lists, n_kids);
      const int32_t alpha_m = blk->alphabet;
      if( alpha_m ) {
        carry = 0;
        for( uint32_t si = 0; si<(uint32_t)alpha_m; ++si ) {
          word = tree[si].val;
          for( k = 0; k<n_kids; ++k ) {
            lists[4*k+carry].code_symbol((uint8_t)word);
            carry = (uint8_t)word>>6;
            word >>= 8;
          }
          carry = (uint8_t)tree[si].val>>7;
        }
      }
    }
    free_sym_entries(lists, 16);
  }
}

// alt_p1.inc -- the predictor-1 model, around its block.

// The residual codes: `unfold[]` runs 0, -1, +1, -2, +2, ... so a small residual
// of either sign gets a small code, and `fold[]` is its inverse.
//
// The buckets are `2*near_lossless_q + 1` wide, which is the near-lossless
// quantiser: at `E = 0` that is one and the mapping is the plain zigzag above.
//
// **`near_lossless_q` is a knob no path in this build can turn.**  Four places
// assign it and all four assign 0 -- `read_plane_descs`, `expand_coded`,
// `write_plane_descs`, `code_image_body` -- and `main` parses `c`/`d` and two
// paths and nothing else, despite the banner's "always with -S -Q9".  So the
// bucket width here is always 1, the deadzone in `alt_p2_alloc` always +-1 and
// the band always 0.
//
// Stage 2 Phase 8 asks for one of two things: wire it to a flag, or fold the
// constants.  Both are declined and the reason is the same one:
//
//   * Folding deletes the only description this tree has of how BMF 2.01's
//     near-lossless mode works.  The mode is reachable in the donor binary --
//     that is what `-Q` is -- and Section 9.5 of ALGORITHM_v2.md is written
//     from exactly this arithmetic.  Deleting it makes that section
//     unverifiable against anything.
//   * Wiring a flag adds a mode the gate cannot check.  Every reference stream
//     in `testfiles/` was taken at `q = 0`; a `-Q` path would ship untested,
//     and a refactoring tree whose premise is byte-identical output is the
//     wrong place to grow a feature.
//
// So it stays, and what changes is that the claim is checked rather than
// commented: `BMF_ASSUME(near_lossless_q == 0)` at each of the three places
// that read it, under the `BMF_ASSERTS=1` leg.  A knob no path can turn, and a
// build that says so.
uint32_t alt_init_tables(uint8_t* fold, int8_t* unfold) {
  uint8_t even, odd;
  uint32_t done;
  int32_t in_bucket, bucket;
  uint8_t half;
  uint32_t i, b;
  BMF_ASSUME(near_lossless_q==0);
  int32_t bucket_size = 2*near_lossless_q+1;
  unfold[0] = 0;
  unfold[255] = 0x80;
  for( i = 0; i<0x3F; ++i ) {
    // `unfold` is `int8_t*` and these four stores punned it to `uint8_t*` so
    // that the two negative entries could be written as bytes.  The values fit
    // an `int8_t` -- `i` runs to 62, so the magnitudes stop at 126 -- and the
    // signed spelling is the one the table is read back as.
    unfold[4*i+2] = (int8_t)(2*i+1);
    unfold[4*i+1] = (int8_t)(-2*i-1);
    unfold[4*i+4] = (int8_t)(2*i+2);
    unfold[4*i+3] = (int8_t)(-2*i-2);
  }
  unfold[254] = 127;
  unfold[253] = -127;
  fold[0] = 0;
  uint32_t lo = 1;
  fold[128] = (uint8_t)-1;
  {
    uint32_t span = 128-lo;
    uint32_t pairs = (128-lo)/2;
    half = 0;
    in_bucket = 1;
    {
      // `pos[2*k+++1]` reads as `pos[2*k + 1]` and is `pos[2*(k++) + 1]`; the
      // increment is the loop's own.  `(fold)[lo]` had parentheses round a
      // plain array name.
      uint32_t k = 0;
      int32_t ofs = 0;
      uint8_t *pos = &fold[lo];
      uint8_t *neg = fold-lo;
      for( ; k<pairs; ++k, ofs -= 2 ) {
        bucket = bucket_size;
        int32_t bucket_1 = in_bucket-1;
        if( bucket_1 )
          bucket = bucket_1;
        else
          ++half;
        even = 2*half;
        pos[2*k] = even;
        odd = 2*half-1;
        in_bucket = bucket-1;
        neg[ofs+256] = odd;
        if( bucket==1 ) {
          in_bucket = bucket_size;
          even = 2*++half;
          odd = 2*half-1;
        }
        pos[2*k+1] = even;
        neg[ofs+255] = odd;
      }
      // `done = 1` when `pairs` is zero, which is what the `else` arm this
      // replaces assigned: `k` never moves, so `2*k + 1` is already 1.
      done = 2*k+1;
    }
    if( (done-1)<span ) {
      if( in_bucket==1 )
        half = half+1;
      fold[lo-1+done] = 2*half;
      fold[257-lo-done] = 2*half-1;
    }
  }
  for( b = 0; b<0x80; ++b ) {
    (fold)[(uint8_t)((uint8_t*)unfold)[2*b]+256] = 2*b;
    (fold)[(uint8_t)((uint8_t*)unfold)[2*b+1]+256] = 2*b+1;
  }
  return b;
}

// One p1 block, allocated for one plane, and the whole of what the two
// eight-bit entry points do besides naming a direction.  The body they share
// is `AltP1Block::d8_body<f_DEC>`; the decode half used to be written out
// here, twenty-six lines against the encoder's four.
static AltP1Block* alt_p1_block_alloc(int32_t width, int32_t height) {
  AltP1Block* raw = p1_block_take();
  return raw ? raw->alt_p1_alloc(width, height, 0) : nullptr;
}

template<int32_t f_DEC>
static void alt_model_p1_d8(uint8_t* src, int32_t width, int32_t height,
                            uint8_t* out) {
  AltP1Block *blk = alt_p1_block_alloc(width, height);
  blk->d8_body<f_DEC>(src, out);
  if( blk )
    blk->alt_p1_free();
}

void alt_model_p1_d8_encode(uint8_t* src, int32_t i, int32_t height, uint8_t* out) {
  alt_model_p1_d8<0>(src, i, height, out);
}

void alt_model_p1_d8_decode(uint8_t* out, int32_t i, int32_t height) {
  alt_model_p1_d8<1>(nullptr, i, height, out);
}

// alt_p1_code.inc -- the predictor-1 model, both directions.
//
// The two bodies this replaces were 263 and 212 lines and shared 134 of them,
// in three runs that carry most of the function: the header parse and the
// per-plane block allocation, the 57 lines of per-row rotation -- five buffers
// moved round, five cursors reseated, the two context sums rebuilt from the
// rows above -- and the teardown.  None of that has a direction.
//
// `buf` is the encoder's `src` and the decoder's `out`: the same walk over the
// interleaved planes, read in one direction and written in the other.
//
// What is one-sided is the near-lossless drift control and the side the colour
// transform falls on.  The encoder takes a sample, subtracts the transform,
// folds the residual, reconstructs it, and if the reconstruction has drifted
// more than sixteen it re-sends through `fold_hi` and leaves the original byte
// in `buf`.  The decoder is told which code was used, and adds the transform
// back after the fact -- which is why its stores sit one plane behind, between
// a plane's cursor advance and the next plane's context.
//
// Two spellings differed and are the same value, and both are `abs32` now.
// The encoder wrote a plane's magnitude as `(BYTE4(err) ^ err) - BYTE4(err)`
// over an `int64_t` -- the sign of `err` broadcast into byte 4, exclusive-ored
// and subtracted, which is `|err|` in the low eight bits and nothing in the
// rest -- and the decoder as `abs32(val - pred)`.  `P1Ctx::mag` is a
// `uint8_t`, so eight bits is all either of them keeps.  The `int64_t` went
// with the macro: the width existed so that a byte 4 existed to read.  And the
// decoder held `blk->ctx[0]` in a local across the `ctx[2]` update, which
// cannot change it -- they are different elements.

// A plane's cross-plane prediction: the weighted sum, in 128ths, of the planes
// already coded at this pixel.  `weight0` goes with plane 0, `weight1` with
// plane 1, `weight2` with plane 2.
//
// Two of them because the original's two sites are not the same expression,
// and the differences are load-bearing:
//
//   * the rounding bias is 40 for two planes and 64 for three.  64 is half of
//     128 and rounds to nearest; 40 does not, and biases low by 24/128 of a
//     level.  Both are what BMF.exe does.
//   * the two-plane form's second term is cast to `uint32_t`, which makes the
//     whole sum unsigned and the `>>7` a logical shift.  The three-plane form
//     stays signed and shifts arithmetically.  With a negative weight the two
//     give different answers, so they cannot be one function with a bias
//     parameter, which is what the first attempt at this was.
//
// The three-plane form reads its operands as `p[-3]`, `p[-2]`, `p[-1]`: the
// planes are interleaved, so the three bytes before this one are planes 0, 1
// and 2 of the same pixel.
//
// And that is the same expression `PlaneTransform::blend` computes in
// `plane_predict.inc` -- same weights, same operands, same shift -- with one
// difference nobody would predict: **blend rounds the three-plane form with 63
// and this rounds it with 64.**  The two-plane forms agree at 40.  So the same
// reference prediction is a level apart depending on whether the plane is being
// coded planar (through `code_colour_plane`) or interleaved (through here).
//
// Left alone deliberately, and noted here because the obvious tidy -- one blend
// helper called from both -- silently changes the output of every four-plane
// image.  Both constants are in BMF.exe.  `plane_mix3` is entered by `altp1`,
// `med32` and `t32` in the corpus, so neither side is a path the program never
// takes; counted by instrumenting both and running all nineteen images.
static inline uint32_t plane_mix2(const PlaneDesc& d, const uint8_t* p0, const uint8_t* p1) {
  return (d.weight0**p0+d.weight1*(uint32_t)*p1+40)>>7;
}

static inline int32_t plane_mix3(const PlaneDesc& d, const uint8_t* p) {
  return (d.weight1*p[-2]+d.weight0*p[-3]+d.weight2*p[-1]+64)>>7;
}

template<int32_t f_DEC>
int32_t alt_model_p1(BmfImage* hdr, uint8_t* buf) {
  // `void* plane[4]` with three `AltP1Block*&` aliases onto slots 1..3 -- the
  // decompiler's way of saying that a `void*` array is read as blocks.  It is
  // an array of blocks.
  AltP1Block* plane[4];
  int32_t cur0, cur1, cur3;
  int32_t want2;
  int32_t width = hdr->width;
  int32_t height = hdr->height;
  for( int32_t k = 0; k<plane_count; ++k ) {
    AltP1Block *raw = p1_block_take();
    plane[k] = raw->alt_p1_alloc(width, height, k);
  }
  int32_t src1 = plane_desc[1].src_plane;
  int32_t src2 = plane_desc[2].src_plane;
  int32_t src3 = plane_desc[3].src_plane;
  uint8_t fl1 = plane_desc[src1].flags;
  uint8_t fl2 = plane_desc[src2].flags;
  uint8_t fl3 = plane_desc[src3].flags;
  int32_t dc2 = plane_desc[src2].dc;
  int32_t dc1 = plane_desc[src1].dc;
  int32_t xf1 = fl1&8;
  int8_t dc3 = plane_desc[src3].dc;
  int32_t xf2 = fl2&8;
  int32_t xf3 = fl3&8;
  if constexpr( f_DEC )
    rc_begin_decode();
  else
    rc_begin_encode();
  // A bare braced block held all eighty-eight lines below, declaring
  // nothing and scoping nothing -- where the decompiler put a jump's
  // landing.
  // `n_planes = plane_count` and `w = width` were restated six times between
  // them inside bodies that write neither -- MSVC reloading two globals it
  // could not prove unchanged across the calls that sit between the reads.
  for( uint32_t y = 0; y<(uint32_t)height; ++y ) {
    for( int32_t p = 0; p<plane_count; ++p ) {
      plane[p]->advance_row();
      plane[p]->seed_activity(true);
    }
    {
      // One plane's sample, coded either way: its context built from the
      // planes beside it, the sample itself, and the record it leaves.  All
      // four planes do exactly this and all four wrote it out, each with a
      // `blkN` of its own that no line outside the four uses.
      auto code_sample = [&](int32_t n, AltP1Block* a, AltP1Block* b,
                             int32_t off, int32_t val) {
        AltP1Block*const blk = plane[n];
        blk->ctx_of(a, b);
        val = f_DEC ? blk->decode_sample()
                    : blk->encode_sample(buf, off, val);
        blk->record_sample(val);
        return val;
      };
      // The residual the encoder hands the coder, and the pixel the decoder
      // writes back -- the pixel less the DC and less what the planes before
      // it predict, and the same sum put back.  Four planes do each, and all
      // eight were written out: three of the four spelled the intermediate
      // into a name of its own (`want1`, `val1x`, `val3x`) and the fourth put
      // the sum in the store.
      //
      // Three of the four residuals were narrowed to a byte on their way to
      // the coder -- two through a `uint8_t` temporary and one through a
      // cast -- and the fourth is a plane that is never transformed, so its
      // value is a byte already.  The casts are at the calls.
      //
      // `mix` is evaluated at the call whether or not the plane is
      // transformed, which the four sites did not do.  It is a pure read of
      // the pixels beside this one either way -- the encoder's from the
      // image and the decoder's from what it has already put back, which are
      // the same bytes at this point, and that is what makes the codec work.
      auto fold_from = [&](int32_t off, int32_t xf, int32_t dc, int32_t mix) {
        const int32_t v = buf[off];
        return xf ? v-dc-mix : v;
      };
      auto unfold_to = [&](int32_t off, int32_t xf, int32_t dc, int32_t mix,
                           int32_t val) {
        if( xf )
          val += dc+mix;
        buf[off] = val;
      };
      for( uint32_t x = 0; x<(uint32_t)width; ++x ) {
        int32_t off0 = plane_desc[0].src_plane;
        if constexpr( !f_DEC )
          cur0 = fold_from(off0, 0, 0, 0);
        // `keep0` was a third name for `cur0`: assigned from it in both arms
        // and again beside it when the drift check keeps the reconstruction.
        cur0 = code_sample(0, nullptr, nullptr, off0, cur0);
        int32_t off1 = plane_desc[1].src_plane;
        if constexpr( f_DEC )
          unfold_to(off0, 0, 0, 0, cur0);
        else
          // Narrowed to a byte, as the `uint8_t want1` this replaces was:
          // the residual reaches the coder eight bits wide.
          cur1 = (uint8_t)fold_from(off1, xf1, dc1, buf[off0]);
        cur1 = code_sample(1, plane[0], nullptr, off1, cur1);
        int32_t off2 = plane_desc[2].src_plane;
        if constexpr( f_DEC )
          unfold_to(off1, xf1, dc1, buf[off0], cur1);
        else
          want2 = (uint8_t)fold_from(off2, xf2, dc2,
                                     plane_mix2(plane_desc[off2], buf+off0, buf+off1));
        want2 = code_sample(2, plane[1], plane[0], off2, want2);
        if constexpr( f_DEC )
          unfold_to(off2, xf2, dc2,
                    plane_mix2(plane_desc[off2], buf+off0, buf+off1), want2);
        if( plane_count>=4 ) {
          int32_t off3 = plane_desc[3].src_plane;
          if constexpr( !f_DEC )
            cur3 = (uint8_t)fold_from(off3, xf3, dc3,
                                      plane_mix3(plane_desc[off3], buf+off3));
          cur3 = code_sample(3, plane[2], plane[1], off3, cur3);
          if constexpr( f_DEC )
            unfold_to(off3, xf3, dc3,
                      plane_mix3(plane_desc[off3], buf+off3), cur3);
        }
        buf += plane_count;
      }
    }
  }
  if constexpr( f_DEC )
    rc_end_decode();
  else
    rc_end_encode();
  // `bmf_new` is fatal, so every slot is populated -- the `if( q )` was the
  // same dead null check 11.1 removed from the p2 side.
  for( int32_t f = 0; f<plane_count; ++f )
    plane[f]->alt_p1_free();
  return plane_count;
}

int32_t alt_model_p1_encode(BmfImage* hdr, uint8_t* src) {
  return alt_model_p1<0>(hdr, src);
}

int32_t alt_model_p1_decode(BmfImage* hdr, uint8_t* out) {
  return alt_model_p1<1>(hdr, out);
}

// alt_p2.inc -- the predictor-2 model around its block: the filter, and the two
// directions of its eight-bit body.

// Predict one sample from the seven neighbourhood vectors, and answer with
// three numbers rather than one.  `nb[7][0..2]` receive the centre, this row's
// own prediction and the mixed one; the return value is what the coder uses.
// That third row is one past the `[7][4]` the caller passes -- see the
// `offsetof` assertion beside `p2_row` in alt_p2_block.inc, which is what pins
// the two together.
//
// The first call on a row has no weights of its own to predict with, so it
// seeds them from the mixture instead and returns the mixed prediction
// unchanged.  `uses` is what tells the two apart.
inline int32_t NbRow::predict(float (*nb)[4], CtxWeights* sets, int32_t mode) {
  const float* mix = bmf_p2_mix[mode];
  float mixed[7][4], centre, prediction, own;
  int32_t i, j, k;
  centre = nb_dot(bmf_p2_coef, nb);
  nb[7][0] = centre;
  for( j = 0; j<7; j++ )
    for( k = 0; k<4; k++ )
      nb[j][k] -= centre;
  for( j = 0; j<7; j++ )
    for( k = 0; k<4; k++ ) {
      mixed[j][k] = mix[0]*sets->row[0]->w[j][k];
      for( i = 1; i<6; i++ )
        mixed[j][k] += mix[i]*sets->row[i]->w[j][k];
    }
  prediction = nb_dot(mixed, nb)+centre;
  nb[7][2] = prediction;
  if( uses ) {
    own = centre+nb_dot(w, nb);
    nb[7][1] = own;
    return (int32_t)(prediction+((own-prediction)*w[14][0])/w[14][1]);
  }
  for( j = 0; j<7; j++ )
    for( k = 0; k<4; k++ ) {
      w[j][k] = mixed[j][k]*bmf_p2_decay;
      w[j+7][k] = sets->row[0]->w[j+7][k]*bmf_p2_seed;
    }
  w[14][0] = 47.0f;
  w[14][1] = 169.2f;
  w[14][2] = 1.0f;
  nb[7][1] = prediction;
  return (int32_t)prediction;
}

// One plane of eight-bit samples, coded either way.  Of the two bodies this
// replaces, about ninety lines were the same: the first row's record update,
// the mirrors written past both ends of the row, the three memcpys that seed
// the history buffers, and the whole of the per-row rotation -- five buffers
// and two weight rows moved round, the biases cleared, eight records copied
// down from the row above.  None of that has a direction.
//
// Both loops index off `blk->cursor[0]`, which is what lets them share the
// context: the encoder called it `rec` and the decoder `prev`, and the
// decoder's `pix[-1]` and the encoder's `rec[-1]` are the same record.  So the
// quantiser, the context pair and the frequency record are computed once, for
// both, and only the symbol is one-sided.
//
// What is genuinely one-sided is the near-lossless drift control.  The encoder
// folds the residual, reconstructs it, and if the reconstruction has drifted
// more than sixteen from the source it sends the sample through `fold_hi`
// instead and writes the original byte out.  The decoder has none of that --
// it is told which code was used -- and that asymmetry is the reason these two
// were written separately in the first place.
template<int32_t f_DEC>
void AltP2Block::alt_p2_d8_body(uint8_t* src, uint8_t* out,
                                int32_t width, int32_t height) {
  int32_t j, code0, code;
  uint8_t *outp, code2;
  uint32_t k;
  uint8_t *src_end = src;
  if constexpr( f_DEC )
    rc_begin_decode();
  else
    rc_begin_encode();
  P2Ctx *pix = cursor[0];
  if( width>0 ) {
    uint8_t* p = src;
    for( j = 0; j<width; ++j ) {
      P2Ctx *rec = cursor[0];
      int32_t q2 = rec[-1].val>>4;
      ctx_pair[0] = ctx+ctx_delta[q2+4];
      ctx_pair[1] = ctx+ctx_delta[q2];
      P2Freq&fr = freq[ctx+ctx_w[3].w[(rec[-1].val<=rec[-2].val)+(rec[-1].val<rec[-2].val)]+ctx_w[2].w[rec[-2].sign]+ctx_w[1].w[rec[-1].sign]+ctx_w[0].w[(q2<115)+(q2<17)]+ctx_w[4].w[1]];
      if constexpr( f_DEC ) {
        *out = (uint8_t)(((uint16_t)rec[-1].val>>4)+(uint8_t)unfold[fr.decode_symbol(ctx_pair)]);
      } else {
        code0 = fold_or_refuse(out, *p, (uint16_t)rec[-1].val>>4, fold,
                               fold_hi, unfold);
        fr.encode_symbol(ctx_pair, code0);
        ++p;
      }
      int32_t val = 16*(uint8_t)*out;
      cursor[0]->val = val;
      cursor[0]->dval = val;
      ++out;
      int32_t err = (int16_t)(rec->val-rec[-1].val);
      rec->err = err;
      // The signed difference goes to `err`, its magnitude to the four
      // difference fields.  It arrived as a partial store -- the magnitude
      // written over `err`'s low word after `rec->err` had taken the signed
      // value -- and every one of the five destinations is sixteen bits wide,
      // so the upper half the store preserved was never read.
      int32_t adiff = abs32(err);
      cursor[0]->aerr = adiff;
      cursor[0]->dupright = adiff;
      cursor[0]->dupleft = adiff;
      cursor[0]->dup = adiff;
      cursor[0]->dleft = (uint32_t)cursor[0]->dup>>1;
      cursor[0]->mag = 2;
      cursor[0]->sign = (cursor[0]->err<=0)+(cursor[0]->err<0);
      pix = cursor[0]+1;
      cursor[0] = pix;
    }
    if constexpr( !f_DEC )
      src_end = p;
  }
  seed_history(width);
  if( height>1 ) {
    uint32_t* pair = ctx_pair;
    outp = out;
    for( uint32_t y = 0; y<(uint32_t)(height-1); ++y ) {
      uint8_t *srcp = src_end;
      start_row();
      // A zero-width plane has no pixels in the row, and the guard held the
      // whole of the row body with nothing after it.  `start_row()` above it
      // still runs for every row, which is why this is a `continue` and not
      // a test hoisted out of the loop.
      if( width<=0 )
        continue;
      for( k = 0; k<(uint32_t)width; ++k ) {
        int32_t pred = alt_p2_context(nullptr, nullptr);
        if constexpr( f_DEC ) {
          code2 = code = freq[ctx].decode_symbol(pair);
          outp[k] = (uint8_t)(pred+(unfold[code]));
        } else {
          code = fold_or_refuse(&outp[k], srcp[k], pred, fold, fold_hi,
                                unfold);
          code2 = code;
          freq[ctx].encode_symbol(pair, code);
        }
        alt_p2_model(outp[k], code2, outp[k]-pred);
      }
      if constexpr( !f_DEC )
        src_end = &srcp[width];
      outp = &outp[width];
    }
  }
  if constexpr( f_DEC )
    rc_end_decode();
  else
    rc_end_encode();
}

// One block allocated, one body run, one block freed.  Only the middle line
// differs, and the two bodies take their arguments in different orders --
// which is the decompiler's record of two call sites, not two intentions.
template<int32_t f_DEC>
void alt_model_p2_d8(uint8_t* src, int32_t i, int32_t height, uint8_t* out) {
  AltP2Block *blk;
  AltP2Block *raw = p2_block_take();
  if( raw )
    blk = raw->alt_p2_alloc(i, 0);
  else
    blk = nullptr;
  if constexpr( f_DEC )
    blk->alt_p2_d8_body<1>(nullptr, out, i, height);
  else
    blk->alt_p2_d8_body<0>(src, out, i, height);
  if( blk )
    blk->alt_p2_free();
}

void alt_model_p2_d8_encode(uint8_t* src, int32_t i, int32_t height, uint8_t* out) {
  alt_model_p2_d8<0>(src, i, height, out);
}

void alt_model_p2_d8_decode(uint8_t* out, int32_t i, int32_t height) {
  alt_model_p2_d8<1>(nullptr, i, height, out);
}

// alt_p2_context.inc -- the predictor-2 model's context: which of its counters the next
// sample is coded against.

// The two low fields of every bank context: the running prediction quantised
// against three thresholds into bits 13-14, and the activity sum against three
// more into bits 11-12.  Six of these, and the thresholds are the model --
// what is not the model is the shape around them, written out six times.
//
// Two of the six spelled the sum's three tests `(uint32_t)(K-sum)>>31`, which
// is the sign bit of `K-sum`, which is `sum > K`.  The same predicate as the
// other four, in the form MSVC left when it compiled a comparison one way here
// and another way there.  The identity is exact for the values these take --
// `sum_all` is a sum of magnitudes and `K` is at most 58, so `K-sum` cannot
// overflow -- and it was checked against the other spelling before the two
// were written as one.
static inline int32_t ctx_quant(int32_t run, int32_t r0, int32_t r1, int32_t r2,
                                int32_t sum, int32_t s0, int32_t s1, int32_t s2) {
  // Two two-bit counts, at 13 and 11: how many of the three run
  // thresholds the run passes, and how many of the three sum thresholds
  // the sum does.  Each is a sum of three comparisons, so 0..3 exactly.
  return CtxIdx{}.bits<13, 2>((run>r0)+(run>r1)+(run>r2))
                 .bits<11, 2>((sum>s0)+(sum>s1)+(sum>s2));
}

// How many of a run of thresholds a value clears: `n > scale * t[k]`, for `k`
// from `hi` down to `lo`.  Four counts at the head of `alt_p2_context` --
// thirteen comparisons between them, every one written out -- and the two
// shapes are the same one: `gA` and `gB` compare against the threshold and
// `gC` and `gD` against a multiple of it, so the scale is a parameter and is
// 1 for the first two.
static inline int32_t over_thresholds(int32_t n, const int32_t* t,
                                      int32_t lo, int32_t hi, int32_t scale) {
  int32_t over = 0;
  for( int32_t k = hi; k>=lo; --k )
    over += n>scale*t[k];
  return over;
}

// The five ratios that put a sample's activity in one of six bands.  These
// were five literals inside five comparisons, which is where a table goes when
// nobody writes it down.
static const int32_t p2_band_edges[5] = { 43, 17, 9, 5, 2 };

// The gradient predictor: this sample's neighbour plus that one's, less the
// sample between them.  Forty-four of the sixty filter inputs below are this
// shape over three of eleven cursors, and spelled out they are indexed
// subscripts three to a line -- which is exactly the form in which two arms of
// the block can be textually different and numerically the same.  Two of them
// were: the fourth input of the no-reference arm and the third of the
// single-plane one differ only in a pair of parentheses the register allocator
// left behind.
static inline int32_t grad(int32_t a, int32_t b, int32_t c) {
  return a+b-c;
}

// A row cursor bound to the field this block reads it through, so that a filter
// input is `grad(v0(-2), a1(2), a1(0))` and not three subscripts with a field
// name repeated on each.  Sixty inputs times three of those is what the block
// was.
//
// Fifteen of these are needed -- five rows by `dval` and by `val` and the two
// reference planes' three each -- and fifteen lambdas is a run `dupblock.py`
// reports as copy, correctly: the bodies differ only in a cursor.  Two functors
// would not help either; written out, a `dval` one and a `val` one differ in a
// field name and nothing else.  A field is what a member-pointer parameter is
// for.
template<int16_t P2Ctx::*Field>
struct RowOf {
  const P2Ctx* row;
  int32_t operator()(int32_t i) const { return row[i].*Field; }
};

using DvalRow = RowOf<&P2Ctx::dval>;
using ValRow = RowOf<&P2Ctx::val>;

// The filter's 28 inputs, and the reference cursors the rest of
// `alt_p2_context` reads.  One stage of that function rather than a step in it:
// a hundred and twenty lines that put `p2_row` together and touch nothing else
// of the frame except the six cursors, which is what it hands back.
//
// The four variants of rows 4..6 stay side by side deliberately.  They are one
// block per reference count -- plane 1, plane 2 and up, plane 0 with
// references, and no references at all -- and being able to diff them against
// each other by eye is the whole reason the sixty subscripts were named `d0`,
// `v1` and so on in the first place.  Four small functions would each read
// better alone and the set of them would read worse, so the seam is drawn
// around all four and not between them.
AltP2Block::P2Refs AltP2Block::fill_row_inputs(AltP2Block* refa, AltP2Block* refb) {
  P2Ctx *const c0 = cursor[0], *const c1 = cursor[1], *const c2 = cursor[2],
        *const c3 = cursor[3], *const c4 = cursor[4];
  const DvalRow d0{c0}, d1{c1}, d2{c2}, d3{c3};
  const ValRow v0{c0}, v1{c1}, v2{c2}, v3{c3}, v4{c4};
  // The filter's 28 inputs, four to a row.  Rows 0..3 are differences of `dval`
  // -- the second difference of the plane -- at widening offsets from the
  // current pixel: row 0 the four nearest, row 1 the next ring, rows 2 and 3
  // the ones two and three records out.  Rows 4..6 are the cross-plane terms
  // and are only filled when this plane has references; without them the
  // filter sees this plane alone.
  //
  // Written out one subscript at a time because that is what the original did,
  // and left that way: the offsets are not a pattern a loop could generate --
  // `c0[-1] + c1->dval - c1[-1]` and `c1[-2] + c1->dval - c2[-2]` are
  // different shapes -- so a table of offsets would be 28 rows of data plus a
  // loop, which is the same information one indirection further away.
  p2_row[0][0] = (float)d1(0);
  p2_row[0][1] = (float)d1(1);
  p2_row[0][2] = (float)grad(d0(-1), d1(0), d1(-1));
  p2_row[0][3] = (float)grad(d0(-2), d1(0), d1(-2));
  p2_row[1][0] = (float)grad(d1(-1), d1(0), d2(-1));
  p2_row[1][1] = (float)(-3*(d2(0)-d1(0))+d3(0));
  p2_row[1][2] = (float)grad(d0(-1), d1(2), d1(1));
  p2_row[1][3] = (float)grad(d0(-2), d1(1), d1(-1));
  p2_row[2][0] = (float)(2*d0(-1)-d0(-2));
  p2_row[2][1] = (float)grad(d0(-3), d1(0), d1(-3));
  p2_row[2][2] = (float)grad(d2(0), d1(1), d3(1));
  p2_row[2][3] = (float)d0(-3);
  p2_row[3][0] = (float)grad(d1(-2), d1(0), d2(-2));
  p2_row[3][1] = (float)grad(d0(-2), d1(-1), d1(-3));
  p2_row[3][2] = (float)grad(d1(1), (d1(2)+d1(0))>>1, d2(2));
  p2_row[3][3] = (float)d3(0);
  if( refa ) {
    const P2Refs refs{ref_rows(refa->cursor), ref_rows(refb->cursor)};
    P2Ctx *const ra0 = refs.a.r0, *const ra1 = refs.a.r1, *const ra2 = refs.a.r2;
    P2Ctx *const rb0 = refs.b.r0, *const rb1 = refs.b.r1, *const rb2 = refs.b.r2;
    const ValRow a0{ra0}, a1{ra1}, a2{ra2}, b0{rb0}, b1{rb1}, b2{rb2};
    // `no_ref = has_ref == 0;` was written twice, thirty lines apart, with
    // nothing between the two touching `has_ref`.  `const` is the proof rather
    // than the claim: the second write does not compile now.  It was a reload
    // of a spilled flag, and with the block a function of its own the two
    // assignments finally sat close enough together to be seen as one.
    const bool no_ref = has_ref==0;
    if( !no_ref ) {
      const float bias_l = (float)c0->dval;
      for( int32_t j = 0; j<4; ++j )
        for( int32_t k = 0; k<4; ++k )
          p2_row[j][k] += bias_l;
    }
    const int32_t plane = (int32_t)plane_idx;
    if( plane ) {
      if( plane==1 ) {
        p2_row[4][0] = (float)(d0(0)+d1(3));
        p2_row[4][1] = (float)grad(v0(-2), a1(2), a1(0));
        p2_row[4][2] = (float)grad(v1(1), a0(-1), a1(0));
        p2_row[4][3] = (float)grad(v0(-1), a1(0), a1(-1));
        p2_row[5][0] = (float)grad(v1(1), b1(2), b2(3));
        p2_row[5][1] = (float)grad(v0(-2), b0(0), b0(-2));
        p2_row[5][2] = (float)grad(v1(0), b0(0), b1(0));
        p2_row[5][3] = (float)(v0(-2)+ra0->err);
        if( no_ref ) {
          p2_row[6][0] = (float)grad(v0(-2), a0(0), a0(-2));
          p2_row[6][1] = (float)grad(v2(0), a0(0), a2(0));
          p2_row[6][2] = (float)(grad(a2(0), a0(0), v2(0))+2*(v1(0)-a1(0)));
          p2_row[6][3] = (float)(v0(-1)+v1(-1)+a1(-2)+a0(0)-a0(-1)-a1(-1)-v1(-2));
        } else {
          p2_row[6][0] = (float)v1(0);
          p2_row[6][1] = (float)v0(-3);
          p2_row[6][2] = (float)grad(v0(-1), a0(-1), a0(-2));
          p2_row[6][3] = (float)grad(v0(-3), v0(-1), v0(-4));
        }
      } else {
        p2_row[4][0] = (float)grad(v0(-3), v0(-1), v0(-4));
        p2_row[4][1] = (float)grad(v0(-1), a0(-1), a0(-2));
        p2_row[4][2] = (float)grad(v1(1), a1(0), a2(1));
        p2_row[4][3] = (float)grad(v0(-2), a1(2), a1(0));
        p2_row[5][0] = (float)grad(v1(0), a0(-2), a1(-2));
        p2_row[5][1] = (float)grad(v1(0), a0(0), a1(0));
        p2_row[5][2] = (float)grad(v0(-2), a0(0), a0(-2));
        p2_row[5][3] = (float)grad(v0(-2), b0(0), b0(-2));
        p2_row[6][0] = (float)grad(v2(0), b0(0), b2(0));
        p2_row[6][1] = (float)(grad(b0(-2), b0(0), v0(-2))+2*(v0(-1)-b0(-1)));
        p2_row[6][2] = (float)(v0(-2)+rb0->err);
        p2_row[6][3] = (float)(v2(0)+ra0->err);
      }
    } else {
      p2_row[4][0] = (float)grad(v0(-3), v0(-1), v0(-4));
      p2_row[4][1] = (float)grad(v0(-5), v1(0), v1(-5));
      p2_row[4][2] = (float)grad(v0(-4), v1(0), v1(-4));
      p2_row[4][3] = (float)((v2(0)+3*v1(1)-4*v2(1))-(((v1(2)-v1(0)-(v3(2)-v3(0)))>>1)-v3(1)));
      p2_row[5][0] = (float)grad(v0(-2), a0(0), a0(-2));
      p2_row[5][1] = (float)grad(v1(1), a1(1), a2(2));
      p2_row[5][2] = (float)grad(v1(-2), a1(2), a2(0));
      p2_row[5][3] = (float)(grad(a0(-2), a0(0), v0(-2))+2*(v0(-1)-a0(-1)));
      p2_row[6][0] = (float)grad(v2(1), b0(0), b2(1));
      p2_row[6][1] = (float)grad(v0(-2), b0(0), b0(-2));
      p2_row[6][2] = (float)grad(v0(-1), b1(1), b1(0));
      p2_row[6][3] = (float)grad(v1(1), b1(2), b2(3));
    }
    return refs;
  } else {
    p2_row[4][0] = (float)grad(v1(3), v1(0), v2(3));
    p2_row[4][1] = (float)grad(v0(-4), v1(0), v1(-4));
    // The same expression as `p2_row[4][3]` of the no-plane arm above, which
    // spelled its inner difference `a - b - (c - d)` where this one has
    // `(a - b) - (c - d)`.  One pair of parentheses, no value: they are now
    // written the same and can be seen to be.
    p2_row[4][2] = (float)((v2(0)+3*v1(1)-4*v2(1))-(((v1(2)-v1(0)-(v3(2)-v3(0)))>>1)-v3(1)));
    p2_row[4][3] = (float)grad(v2(-1), v1(1), v3(0));
    p2_row[5][0] = (float)grad(v3(1), v1(0), v4(1));
    p2_row[5][1] = (float)v1(3);
    p2_row[5][2] = (float)grad(v0(-3), v0(-1), v0(-4));
    p2_row[5][3] = (float)grad(v0(-1), v3(0), v3(-1));
    p2_row[6][0] = (float)grad(v0(-5), v1(0), v1(-5));
    p2_row[6][1] = (float)v4(0);
    p2_row[6][2] = (float)grad(v0(-5), v0(-1), v0(-6));
    p2_row[6][3] = (float)v1(-6);
    return {};
  }
}

// The symbol context this sample is coded in, and the level index that goes
// with it.  The last stage of `alt_p2_context`: everything above it produces
// `run4`, the cascade's running prediction, and this turns that plus the
// neighbourhood's magnitudes into the five ternary selectors, the two flatness
// bits and the sixteen-way magnitude class.
//
// Ninety lines, and what it needs from the caller is `run4` and the reference
// rows -- `ctx_w`, `ctx`, `ctx_pair`, `band_lo`, `band_hi`, `has_ref`,
// `plane_idx` and the five cursors are all members.  It writes `ctx_w[].sel`,
// `ctx` and `ctx_pair[]` and answers with the level index.
int32_t AltP2Block::seat_symbol_context(int32_t run4, const P2Refs& refs) {
  P2Ctx *const c0 = cursor[0], *const c1 = cursor[1], *const c2 = cursor[2],
        *const c3 = cursor[3], *const c4 = cursor[4];
  int32_t flat_a, flat_b;
  int32_t magsum_own = c1[5].mag+c1[4].mag+c1[-3].mag+c1[-4].mag+3*(c1[2].mag+c2[1].mag)+7*c1->mag+6*c1[1].mag+c0[-6].mag+c0[-7].mag+c0[-8].mag+8*c0[-1].mag+c4[2].mag+c4[1].mag+c4->mag+c4[-1].mag+c0[-4].mag+c0[-5].mag+(c3[2].mag+c3[1].mag+c3[-1].mag+c3[-2].mag+c4[-2].mag+c2[5].mag+c2[4].mag+c2[3].mag+c2[-2].mag+c2[-3].mag)+4*(c1[-1].mag+c0[-2].mag+c2[0].mag)+2*(c1[-2].mag+c1[3].mag+c0[-3].mag+c3->mag+c2[-1].mag+c2[2].mag);
  // The two band edges, read once.  They were read one at a time between the
  // selector stores, which is where the scheduler wanted the loads and not an
  // order anything depends on: nothing here writes either member.
  const int32_t lo_band = band_lo, hi_band = band_hi;
  ctx_w[0].sel = (run4<1840)+(run4<272);
  ctx_w[1].sel = (run4-c1->val<=hi_band)+(run4-c1->val<lo_band);
  int32_t d_run4 = run4-c0[-1].val;
  bool in_band = d_run4<=hi_band;
  ctx_w[2].sel = in_band+(d_run4<lo_band);
  ctx_w[3].sel = c1->sign;
  ctx_w[4].sel = c0[-1].sign;
  int32_t magsum = magsum_own;
  int32_t magu = c2[0].mag+c1->mag;
  int32_t magl = c0[-1].mag+c0[-2].mag;
  if( refs.a.r0 ) {
    int32_t mag = refs.b.r0->mag;
    int32_t mag_ref1 = refs.b.r1->mag+refs.a.r1->mag;
    int32_t mag_ref0 = mag+refs.a.r0->mag;
    magsum = mag_ref1+magsum_own+4*mag_ref0+2*(refs.a.r0[-1].mag+refs.b.r0[-1].mag);
    flat_a = mag_ref0+magl+refs.b.r0[-2].mag+refs.b.r0[-1].mag+refs.a.r0[-2].mag+refs.a.r0[-1].mag;
    if( has_ref ) {
      // The second difference was written back over `run4`, which is a
      // register reused and not a value updated: nothing downstream wants the
      // overwritten one, and the level index below recomputed `run3 + pred4`
      // rather than reading it -- the original saying so in its own way.  With
      // its own name `run4` is written once and the index is just `run4`.
      const int32_t d_run4b = run4-c1->dval-c0[0].dval;
      if( d_run4b<lo_band||d_run4b>hi_band ) {
        const int32_t d_run4c = run4-c0[-1].dval-c0[0].dval;
        flat_b = d_run4c>=lo_band&&hi_band>=d_run4c;
      } else {
        flat_b = 1;
      }
    } else {
      flat_b = mag_ref1+mag_ref0+magu+refs.b.r2->mag+refs.a.r2->mag;
    }
    // `magsum_own = magsum;` above each of these and `magsum = magsum_own;` three
    // lines down was MSVC spilling the register `magsum` was in across the
    // reads below it and loading it straight back.  Nothing between the two
    // touches it, in either arm.  What is left of that name is `magsum_own` --
    // this plane's own sum, which is the base both arms add to and not a spill
    // of anything.
    if( plane_idx==1 ) {
      int32_t d_ra_ra1 = refs.a.r0->val-refs.a.r1->val;
      ctx_w[3].sel = (d_ra_ra1<=hi_band)+(d_ra_ra1<lo_band);
      int32_t d_ra_left = refs.a.r0->val-refs.a.r0[-1].val;
      ctx_w[4].sel = (d_ra_left<=hi_band)+(d_ra_left<lo_band);
    } else if( (int32_t)plane_idx>1 ) {
      int32_t d_rb_rb1 = refs.b.r0->val-refs.b.r1->val;
      ctx_w[3].sel = (d_rb_rb1<=hi_band)+(d_rb_rb1<lo_band);
      int32_t d_rb_left = refs.b.r0->val-refs.b.r0[-1].val;
      in_band = d_rb_left<=hi_band;
      ctx_w[4].sel = in_band+(d_rb_left<lo_band);
      int32_t ra0_val = refs.a.r0->val;
      int32_t d_ra_ra1b = ra0_val-(refs.a.r1)->val;
      in_band = lo_band<=d_ra_ra1b;
      if( in_band&&d_ra_ra1b<=hi_band ) {
        flat_a = 1;
      } else {
        int32_t d_ra_leftb = ra0_val-refs.a.r0[-1].val;
        flat_a = d_ra_leftb>=lo_band&&d_ra_leftb<=hi_band;
      }
    }
  } else {
    flat_a = magl+c0[-3].mag+c0[-4].mag+c0[-5].mag;
    flat_b = c4->mag+c3->mag+magu+c0[0].mag;
  }
  // The magnitude class, and the two arms that set it wrote `ctx15` and `ctx`
  // to the same value apiece -- four stores for one number.
  //
  // The `ctx` half of them was dead: nothing between here and the `ctx = ...`
  // at the end of this function reads the member, and that assignment is
  // unconditional.  Proved rather than argued, because a member is not
  // something `deadstore.py` follows: 12345 stored here leaves all 111 checks
  // passing, and added to the assignment at the end it fails twenty.
  const int32_t ctx15 = magsum>=960 ? 15 : nb_ctx[magsum>>3];
  const int32_t ctx_idx = clamp32((run4+7)>>4, 0, 255);
  // The magnitude context in the low nibble, under a `ctx_delta` entry that
  // occupies bits 4 and up -- the run level as `bits<4, 4>` and the plane
  // `above<8>`, built once in `alt_p2_alloc`.  `ctx15` is `nb_ctx[]`, whose
  // values run 0..15 because `p2_len_edges` has fifteen live entries, so the
  // nibble is exactly the room the entry leaves and the two cannot overlap.
  //
  // The pair is the same index four `ctx_idx` apart, which is one step of the
  // level field.
  ctx_pair[0] = CtxIdx{}.bits<0, 4>(ctx15).raw(ctx_delta[ctx_idx+4]);
  ctx_pair[1] = CtxIdx{}.bits<0, 4>(ctx15).raw(ctx_delta[ctx_idx]);
  // The magnitude context in the low nibble, two flatness bits at 4 and 5 over
  // it, and the five weight-table contributions added on top.  Those five are
  // values rather than fields -- each is a table entry pre-scaled the way
  // `AltP1Block`'s nine are -- so they stay a sum and only the rest becomes
  // fields.
  // It was written out with the terms running down from index 4, which is the
  // order the registers came free in.
  ctx = CtxIdx{}.bits<0, 4>(ctx15).bit<4>(flat_a==0).bit<5>(flat_b==0)
                .raw(mixer_fwd(ctx_w, 5));
  return ctx_idx;
}

int32_t AltP2Block::alt_p2_context(AltP2Block* refa, AltP2Block* refb) {
  CtxWeights weights;
  int32_t nb_slot;
  uint32_t ctx0, ctx1, ctx2;
  uint32_t ctx0_lo;
  // The five row cursors, read once.
  //
  // This function reached them through sixteen names bound in five places:
  // `row0p`, `cursor1`, `sub0_row` at the top; `nb0`, `nb1`, `row2c`, `nb3`
  // and `nb2` (a second name for `row2c`) interleaved with the filter inputs;
  // `nb2x`, `nb3x`, `nb4` in the no-reference arm; `cx0`..`cx4` before the
  // bank contexts.  `nb0`/`nb1` were reassigned after the bias loop and `cx2`
  // was assigned identically in both arms of the reference test, so the
  // sixteen names sat over five rows: cursor 2 alone answered to `sub0_row`,
  // `row2c`, `nb2`, `nb2x` and `cx2`.  Reading the body as if `nb2` and
  // `nb2x` were different rows is the mistake that spelling invites.
  //
  // They are safe to hoist because nothing here advances a cursor:
  // `alt_p2_model` does that, after this returns.  Checked by grep before the
  // rewrite, and by the gate after it.
  //
  // The negative subscripts stay.  `c0[-3].val` is a sliding window over a row
  // with margins, which is what the model reads; what goes is the aliasing.
  P2Ctx *const c0 = cursor[0], *const c1 = cursor[1], *const c2 = cursor[2],
        *const c3 = cursor[3], *const c4 = cursor[4];
  //
  // `DvalRow` and `ValRow` used to be built here too, for the sixty filter
  // inputs; those went to `fill_row_inputs` and the accessors went with them.
  // What is left reads `.dupleft`, `.dupright`, `.dleft`, `.dup`, `.val`,
  // `.err` and `.mag`, which is seven fields and not the two an accessor pays
  // for.
  int32_t sum_ul = 21*c2[-1].dupleft+12*c1[3].dupleft+16*c1[2].dupleft+22*c1[1].dupleft+(23*c0[-1].dupleft)+20*c1->dupleft+ctx_bias[0]+14*c0[-2].dupleft;
  int32_t sum_ur = 17*c2[-2].dupright+21*c1[2].dupright+15*c1[1].dupright+25*c1->dupright+9*c1[-1].dupright+22*c0[-1].dupright+ctx_bias[1]+19*c0[-2].dupright;
  int32_t sum4 = 17*c1[3].dleft+15*c1[2].dleft+21*c1[1].dleft+18*c1->dleft+16*c1[-1].dleft+22*c0[-1].dleft+ctx_bias[2]+19*c0[-2].dleft;
  int32_t sum_u = 14*c1[3].dup+23*c1[1].dup+19*c1->dup+25*c0[-1].dup+ctx_bias[3]+17*c0[-2].dup+15*(c3->dup+c2->dup);
  int32_t sum_all = sum4+sum_u+sum_ul+sum_ur;
  int32_t band = over_thresholds(8*sum4, p2_band_edges, 0, 4, sum_u);
  int32_t den_d = 2*c0[-2].val+2*c0[-1].val;
  int32_t num_b = c1[1].val+(c1->val+2*c0[-1].val);
  int32_t num_d = 16*(c2[2].val+c2->val+c1[1].val+c2[-1].val);
  int32_t gA = over_thresholds(sum_all, bmf_p2_thresholds[band], 9, 12, 1);
  int32_t gB = over_thresholds(num_b, bmf_p2_thresholds[band], 6, 8, 1);
  int32_t gC = over_thresholds(16*sum_ur, bmf_p2_thresholds[band], 3, 5, sum_ul);
  int32_t gD = over_thresholds(num_d, bmf_p2_thresholds[band], 0, 2, den_d);
  // Mixed radix, and only three of the five terms are bit fields.  `gB`, `gC`
  // and `gD` each sum three comparisons, so each is 0..3 and each is two bits.
  // `gA` sums *four*, so it is 0..4 -- five values with a stride of 64 -- and
  // `band` sums five, so it is 0..5 with a stride of 320, which is 5 * 64.
  // Neither is a field however it is written: `bits<6, 2>(gA)` was tried, and
  // the one neighbourhood in the corpus that reaches `gA == 4` landed in slot
  // 0 instead of 256.  Three streams moved and the gate said so.
  //
  // So they are digits, with their radices written down, and `320 * 6 = 1920`
  // is what `nb_id[]` is sized for.
  nb_slot = CtxIdx{}.bits<4, 2>(gB).bits<2, 2>(gC).bits<0, 2>(gD)
                    .digit<64, 5>(gA).digit<320, 6>(band);
  seat_nb_row(nb_slot, c0);
  // The six cursors come back rather than being read again here: they are one
  // record back from the ring, which is a thing to get right once.
  const P2Refs refs = fill_row_inputs(refa, refb);
  P2Ctx *const ra0 = refs.a.r0, *const ra1 = refs.a.r1, *const ra2 = refs.a.r2;
  P2Ctx *const rb0 = refs.b.r0, *const rb1 = refs.b.r1, *const rb2 = refs.b.r2;
  // The six weight sets `NbRow::predict` mixes: three from this row's cursor
  // and three from the row above.  `cur_l` and `up_row` were `cur` and `above`
  // read into locals so the six loads could be scheduled against each other,
  // and neither cursor moves until `alt_p2_model` advances it.
  weights.row[0] = cur[-1];
  weights.row[1] = above[1];
  weights.row[2] = above[2];
  weights.row[3] = cur[-2];
  weights.row[4] = above[0];
  weights.row[5] = cur[0];
  // Which of the four directional activity sums is smallest, once each is
  // scaled by its own weight.  The weights are model parameters and stay named
  // candidates rather than going inline.
  //
  // The original walked it with two running minima and three `if`s, and the tie
  // rule is the part that has to survive: `16*sum4 <= 14*sum_u` sends a tie to
  // mode 0, which `best01 == a` reproduces because `min32` returns `a` on
  // equality.  Checked over all 43,046,721 quadruples in [-40,40]^4 -- 0
  // disagreements -- rather than at the three boundaries by hand.
  const int32_t a = 16*sum4, b = 14*sum_u, c = 13*sum_ur, d = 11*sum_ul;
  const int32_t best01 = min32(a, b);
  int32_t mode = (best01==a) ? 0 : 1;
  if( best01>c )
    mode = 2;
  if( min32(best01, c)>d )
    mode = 3;
  const int32_t filt = nb_cur->predict((float (*)[4]) p2_row, &weights, mode);
  // A 32-bit store at `&pred_prev`, which is a `uint16_t` followed by two
  // bytes of padding: the original wrote the whole word and the top half
  // landed in the pad, which nothing reads.  So it is the low half.
  pred_prev = (uint16_t)filt;
  int32_t g3pair = c0[-1].aerr+c1->aerr;
  if( refa )
    g3pair += (rb0->aerr+ra0->aerr)>>1;
  int32_t g3sum = c1[3].aerr+c1[-1].aerr+c0[-1].aerr+c0[-3].aerr+c0[-4].aerr+c0[-2].aerr;
  // Four of the five masks are a sign test the types prove: a sum of `w` of
  // these `int16_t` members is under `w * 2^15`, so every bit from
  // `15 + ceil(log2 w)` up is a copy of the sign.  Those four are `bit<>`.
  //
  // The fifth is a sign too, and for a reason from outside that rule -- the
  // cast makes it bit 15 of a *sixteen-bit* value -- so it says `bit_of<15>`
  // instead: the bit where it is, with no claim about the rest.  Same code as
  // the mask it replaces, and the position is now the thing that generates the
  // mask rather than a hex literal beside it.  tools/ctxidx.py.
  ctx0_lo = CtxIdx{}.bit<19>(c1[1].err+c1->err+c1[-1].err+c0[-1].err < 0)
            .bit<18>(c3->err+c0[-2].err+2*c0[-4].err < 0)
            .bit<17>(c1[-3].err+c0[-3].err+c0[-5].err+c0[-7].err < 0)
            .bit<16>(c0[-1].err < 0)
            .bit_of<15>((uint16_t)c0[-3].err)
            .bits<13, 2>((filt>3536)+(filt>720)+(filt>288))
            .bits<11, 2>(((g3pair+g3sum)>752)+((g3pair+g3sum)>400)+((g3pair+g3sum)>240));
  // `bank_ctx[0] = ctx0_lo;` was here, overwritten nine lines down by the bank
  // the finished word names and read by nothing in between.  Proved rather than
  // argued: storing 12345 here leaves all 111 checks passing, and storing it at
  // the surviving assignment fails 12 of them, so the slot is live and this
  // write to it is not.
  if( refa ) {
    ctx0 = CtxIdx{}.bit<25>(rb0[-1].err < 0)
           .bit<24>(rb0->err < 0)
           .bit<23>(ra0[-1].err < 0)
           .bit<22>(rb0->err+rb0[-2].err < 0)
           .bit<21>(ra0[-2].err+ra0->err < 0)
           .bit<20>(c0[-2].err < 0)
           .raw(ctx0_lo);
  } else {
    ctx0 = CtxIdx{}.bit<25>(c1[3].err+c0[-3].err+c0[-7].err+c0[-5].err < 0)
           .bit<24>(c2[1].err+c2->err+c0[-4].err+c0[-8].err < 0)
           .bit<23>(c0[-4].err+c0[-6].err < 0)
           .bit<22>(c0[-4].err < 0)
           .bit<21>(c0[-5].err < 0)
           .bit<20>(c0[-7].err < 0)
           .raw(ctx0_lo);
  }
  const int32_t run0 = step_bank(0, ctx0, filt);
  int32_t nb4_4 = c4[4].val;
  sum_all = ((g3pair<<9)+sum_all)>>13;
  int32_t d_run0 = c0[-5].val-run0;
  int32_t d_up = nb4_4-run0;
  int32_t up5 = c1[5].val;
  int32_t d_up5 = up5-run0;
  // The six words below -- two spellings of `ctx1`, two of `ctx2`, and `ctx3`
  // and `ctx4` after them -- are `bit_of<>` almost throughout, and this is the
  // measurement that says they have to be.
  //
  // Every `expr & <one bit>` is a sign test *if* `|expr|` stays under that bit,
  // and `bit<k>(expr < 0)` is how a word says so.  These do not qualify.  Every
  // term carries a `run` -- each is the stage before it plus that stage's own
  // prediction, which `step_bank` accumulates -- and that is a prediction with
  // no type bound, while the masks reach as low as bit 15.
  //
  // Instrumented over the corpus, four of them are *not* sign tests at all:
  //
  //   ctx1  bit 15  `d_run0`                           reaches 36157
  //   ctx3  bit 15  `run2-c0[-3].val`                  reaches 35550
  //   ctx3  bit 24  `... - ((uint32_t)(...)>>1) ...`   is unsigned throughout
  //   ctx4  bit 15  `(uint16_t)run3 - ...`             reaches 69572 as an int
  //
  // and twelve more come within a factor of four of their bit, which makes them
  // sign tests by how the corpus happened to run and not by anything the code
  // says.  Rewriting any of these as `< 0` would change what the program
  // computes.  Exactly one term across the six is provable, and it is the
  // `bit<24>` in the first arm.
  //
  // So `bit_of<Pos>` is the spelling: it keeps the bit where it is and claims
  // nothing further, which is the same code the mask was and a strictly better
  // record of it.  These were `(expr) & 0x2000000` with a `// bit 25` beside
  // them, sixty-six times -- a hex literal to count out by hand and a label
  // nothing checked.  The position now *generates* the mask, so the two cannot
  // disagree, and the eleven fields of a word can be read off the chain.
  //
  // What has not changed is which terms are believed and which are proven:
  // `bit<>` and `bit_of<>` sit side by side and say which is which.
  // `tools/ctxidx.py --list` reports the split; it is 1 of 66.
  if( refa ) {
    int32_t dv_now = c0[0].dval;
    ctx1 = CtxIdx{}.bit_of<25>(c0[-1].val+ra0->val-ra0[-1].val-run0)
           .bit<24>(ra2->dval+ra1->dval-2*ra0->dval < 0)
           .bit_of<23>(dv_now+c0[-3].dval-run0-(c1[2].dval-c1[5].dval))
           .bit_of<22>(dv_now+c0[-5].dval-run0)
           .bit_of<21>(dv_now+c1->dval+rb1[2].dval-rb2[2].dval-run0)
           .bit_of<20>(dv_now+c0[-1].dval+rb0->dval-rb0[-1].dval-run0)
           .bit_of<19>(c2[-1].dval+dv_now+ra0->dval-ra2[-1].dval-run0)
           .bit_of<18>(dv_now+c1[2].dval+ra0->dval-ra1[2].dval-run0)
           .bit_of<17>(d_up5)
           .bit_of<16>(d_up)
           .bit_of<15>(d_run0)
           .raw(ctx_quant(run0, 2256, 1056, 144, sum_all, 55, 10, 24));
  } else {
    int32_t d_run0b = run0-c0[-3].val;
    ctx1 = CtxIdx{}.bit_of<25>(nb4_4-c3->val+run0-c1[4].val)
           .bit_of<24>(c1[-5].val-c1[-2].val+d_run0b)
           .bit_of<23>(d_run0b+c1[2].val-up5)
           .bit_of<22>(c4[3].val-c2[2].val+run0-c2[1].val)
           .bit_of<21>(c4[-1].val-c3->val+run0-c1[-1].val)
           .bit_of<20>(c1->val-c1[2].val+run0-c0[-2].val)
           .bit_of<19>(-d_up5)
           .bit_of<18>(-d_up)
           .bit_of<17>(run0-c4[2].val)
           .bit_of<16>(run0-c4[-3].val)
           .bit_of<15>(-d_run0)
           .raw(ctx_quant(run0, 2400, 1024, 240, sum_all, 39, 24, 11));
  }
  const int32_t run1 = step_bank(1, ctx1, run0);
  int32_t cx2_val0 = c2->val;
  int32_t cx1_val = c1->val;
  int32_t dvsum2 = c0[-2].val-run1;
  int32_t lap = c0[-2].val+run1-2*c0[-1].val;
  int32_t dtop2 = cx2_val0-run1;
  if( refa ) {
    int32_t dv1 = c1[1].dval;
    int32_t d_ra = ra0->val-run1;
    ctx2 = CtxIdx{}.bit_of<25>(c0[0].dval+c1[-1].dval-run1-(c2->dval-dv1))
           .bit_of<24>(c0[0].dval+c0[-1].dval-run1-(c1->dval-dv1))
           .bit_of<23>(rb0->val-run1+cx2_val0-rb2->val)
           .bit_of<22>(d_ra+cx2_val0-ra2->val)
           .bit_of<21>(d_ra+c1[-1].val-ra1[-1].val)
           .bit_of<20>(c0[0].dval-c0[-2].dval+2*c0[-1].dval-run1)
           .bit_of<19>(2*cx1_val-run1-cx2_val0)
           .bit_of<18>(-lap)
           .bit_of<17>(dtop2)
           .bit_of<16>(dvsum2)
           .bit_of<15>(208-rb0->val)
           .raw(ctx_quant(run1, 2576, 1280, 640, sum_all, 33, 12, 4));
  } else {
    ctx2 = CtxIdx{}.bit_of<25>(run1+3*(cx2_val0-cx1_val)-c3->val)
           .bit_of<24>(run1+c4->val-(c2[2].val+c2[-2].val))
           .bit_of<23>(c3[2].val-c2[-1].val+run1-c1[3].val)
           .bit_of<22>(c3[1].val-c1[1].val-dtop2)
           .bit_of<21>(c3->val-cx1_val-dtop2)
           .bit_of<20>(lap)
           .bit_of<19>(run1-c4[3].val)
           .bit_of<18>(c3[1].val-run1)
           .bit_of<17>(run1-c4->val)
           .bit_of<16>(run1-c3[-2].val)
           .bit_of<15>(-dvsum2)
           .raw(ctx_quant(run1, 2464, 1216, 688, sum_all, 58, 25, 13));
  }
  const int32_t run2 = step_bank(2, ctx2, run1);
  int32_t run_dv3 = run2-c0[0].dval;
  // `sum_all = -sum_all` was here, and the six thresholds below read `< -K`
  // because of it.  Nothing else used the negated value: it existed so that
  // `q9`, `q39` and `q10` -- computed from the positive one, before this line
  // -- could be added to comparisons made after it.  Those are written out
  // now, so the negation and the six sign flips cancel.
  const uint32_t ctx3 = CtxIdx{}.bit_of<25>(3*(c0[-2].val-c0[-1].val)+run2-c0[-3].val)
                    .bit_of<24>(c2[1].dval-((uint32_t)(c1[1].dval+c1[2].dval+c1[-1].dval+c1->dval)>>1)+run_dv3)
                    .bit_of<23>(c2[-3].val-c1[-2].val+run2-c1[-1].val)
                    .bit_of<22>(-(c2[2].val+run2-2*c1[1].val))
                    .bit_of<21>(c1[-2].dval-c0[-2].val+run2-c1->dval)
                    .bit_of<20>(run2-c1[3].val)
                    .bit_of<19>(run_dv3-c2[1].dval)
                    .bit_of<18>(run2-c3->val)
                    .bit_of<17>(2*run2-c1->dval-(c1->val+c0[0].dval))
                    .bit_of<16>(run2-c0[-1].dval-c0[0].dval)
                    .bit_of<15>(run2-c0[-3].val)
                    .raw(ctx_quant(run2, 2896, 1568, 592, sum_all, 37, 19, 9));
  const int32_t run3 = step_bank(3, ctx3, run2);
  int32_t dv_now4 = c0[0].dval;
  int32_t run_dv4 = run3-dv_now4;
  int32_t run_up4 = run3+c3->val;
  const uint32_t ctx4 = CtxIdx{}.bit_of<25>(run3-((uint32_t)(c1[1].val+c1[-1].val+2*c1->val)>>2))
                    .bit_of<24>(run_up4-c0[-2].val-(c3[2].dval+dv_now4))
                    .bit_of<23>(run3-2*c0[-2].dval-(dv_now4-c0[-4].dval))
                    .bit_of<22>(run3-c0[-3].dval-dv_now4-(c1->val-c1[-3].val))
                    .bit_of<21>(run_up4-dv_now4-(c1[1].val+c2[-1].dval))
                    .bit_of<20>(c2[-2].val+run3-2*c1[-1].val)
                    .bit_of<19>(c2->dval-2*c1->dval+run_dv4)
                    .bit_of<18>((run3-c0[-1].val)-(c1->val-c1[-1].val))
                    .bit_of<17>(run_dv4-c1[4].dval)
                    .bit_of<16>(run_dv4-c1[-2].dval)
                    .bit_of<15>((uint16_t)run3-(uint16_t)c0[-4].dval-(uint16_t)dv_now4)
                    .raw(ctx_quant(run3, 3056, 1952, 368, sum_all, 39, 21, 10));
  const int32_t run4 = step_bank(4, ctx4, run3);
  return seat_symbol_context(run4, refs);
}

// alt_p2_model.inc -- the predictor-2 model itself, and the largest body in the program.
// "p2" is `plane_predictor == 2`; it is not about depth.  t8g is a single eight-bit
// plane and codes here.  MODELS.md section 7.

// The per-bank counter walk: five banks of context counters, each stepped
// toward this sample's residual, and the mirror and rotate neighbours of each
// stepped with it at lighter weights.
//
// 321 lines inside `alt_p2_model`, and the reason first recorded for leaving
// them there -- "threading about thirty locals through a signature" -- was a
// guess.  What the loop actually needs from the enclosing scope is small and
// nothing it touches is read after it; the compiler was asked rather than a
// regex, twice, because the regex undercounted both times.
void AltP2Block::code_banks(int32_t sample16) {
  // This function opened with a declaration of thirteen `int32_t`, a `bool` and
  // a `uint8_t` -- MSVC's frame, in the order it allocated the slots.  Five of
  // them existed only to carry a value across a comma in the middle of an `if`
  // (`go`, `w1`, `e1`, `w_top3`, `b_top3`) and three more were one residual
  // under four names; with those gone the rest declare where they are first
  // written, which is inside the bank loop, one block in.
  for( uint32_t bank = 0; bank<5; ++bank ) {
    const int32_t bctx = bank_ctx[bank];
    const int32_t res = sample16-nb_sum[2*bank];
    P2Count* node0 = &p2_ctr[slot(bank, bctx)];
    const int32_t w0 = res+(uint16_t)node0->weighted;
    node0->weighted = w0;
    int32_t countdown = node0->b1;
    // Two guards, both of which have nothing after them: the counter is out of
    // its count, or the alphabet was reduced.  They were nested `if`s holding
    // the rest of the function five levels in.
    if( !countdown )
      continue;
    const int32_t w0b = w0+4*((res>deadzone_hi)-(res<deadzone_lo));
    node0->weighted = w0b;
    uint32_t ctxw = bctx;
    // The rate ladder: a counter that keeps seeing a small residual counts
    // down, and at zero its rate steps up and its accumulator doubles --
    // unless it is already at the top of the ladder, where it stays at zero
    // and re-arms nothing.
    //
    // Two of the three arms stored the same thing.  `b1` is `uint8_t` and
    // `countdown` is a copy of it guarded non-zero above, so after the
    // decrement it is 0..254 and `(uint8_t)--countdown` tests the value the
    // decrement produced; the cast was the decompiler recording the byte
    // compare.  Written as a decrement and a test, the "count is not out"
    // arm and the "count is out but the rate is capped" arm are one line.
    if( (int32_t)abs32(res)<38 ) {
      --countdown;
      if( !countdown&&(uint8_t)node0->rate<8u ) {
        // `b0n - 1` is the rate this counter is stepping *from*, and the
        // table starts at rate 5, which is the lowest any counter holds.
        const int32_t from = node0->rate;
        node0->rate = (uint8_t)(from+1);
        node0->b1 = p2_b1_reload[from-5];
        node0->weighted = 2*w0b;
      } else {
        node0->b1 = countdown;
      }
    }
    if( alphabet_reduced )
      continue;
    // The mirrored context: the same counter with the top bits of its
    // index flipped, which is the model's guess at what a symmetric
    // neighbourhood would have used.
    //
    // This was `mir_top`, a `uint16_t*` walking `P2Count` two words at a
    // time -- `[0]` the rate byte, `[1]` the weight, `[2]`/`[3]` the next
    // record's, `[-2]`/`[-1]` the previous one's.  It is a `P2Count*`, and
    // the name is reused a hundred lines below for a `uint16_t*` that
    // genuinely does walk a `P2Freq` as words, which is why one name did
    // two jobs.
    //
    // The decompilation also had `prefetch(&mir_top)` *before* the
    // assignment, which asks for the cache line holding a local the
    // function is about to write anyway.  Every other prefetch below is of
    // the counter the next few lines will read; this one is now too.
    P2Count *mir = &p2_ctr[slot(bank, ctxw^kBankMirrorMask)];
    __builtin_prefetch(mir, 0, 1);
    // The bank's residual with its mirror correction added, and the
    // only value the rest of this block works from.  It reached the three
    // counter walks below through three more names -- `res_c` assigned
    // from it here, `res_s` from `res_c` at the top of the branch,
    // `res_c` from `res_s` again inside it, and `res_t` in the third walk
    // -- with no write to any of them in between.  One name, and `const`
    // says there is no second value to look for.
    const int32_t res2 = nb_sum[2*bank+1]+res;
    // The record after the bank's counter is bumped on three of the four
    // low-bit values and the record before it on three others, and the
    // two sets are not the same three.  That is all this is.
    //
    // It arrived as one `if` with a five-term comma expression in the
    // right half of an `||`: the bump itself was written inside the
    // condition, with a `go` set mid-chain and read as the chain's value
    // two terms later so that the short circuit did double duty as the
    // second guard.  `lowbits >= 3` skips the chain, which is why the
    // first bump does not happen there; `!go` is `lowbits > 0`, which is
    // why the second one does not happen at zero.
    //
    // Written out it is `p2_update` twice, at shifts 1 and 2 -- the first
    // of this file's counter updates the helper could not reach, because
    // a call has no value to hand back to an `||`.
    int32_t lowbits = ctxw&3;
    if( lowbits<3 )
      p2_update(&node0[1], res2, 1);
    if( lowbits )
      p2_update(&node0[-1], res2, 2);
    // Three update blocks follow, one per branch, and each walks these
    // eleven bits in order doing four or five things to each: bump the
    // direct counter at shift 2, the rotated one at 3, nudge the record
    // after the direct one, bump the record before it, and bump the
    // mirrored one with the residual negated.  Which of the five, and at
    // which bit, is the whole of what separates the three.
    //
    // For several rounds this said they were **not** rolled into loops,
    // "a decision rather than an omission", and listed four exceptions at
    // k = 0, 4, 9 and 10.  Every one of the four has since dissolved, and
    // none of them dissolved by being argued with:
    //
    //   * "k = 0's nudge and k = 4's and k = 9's mirror bumps are written
    //     longhand" -- they were, and they are `p2_nudge` and `p2_update`
    //     now.  Two of the three had already been converted; the last two
    //     went when `p2_nudge` learned its shift instead of fixing it
    //     at 2.
    //   * "k = 4 subtracts into the residual variable itself" -- it does,
    //     through `p2_update_into`, and *nothing reads the residual
    //     afterwards*.  A write-back nobody reads is `p2_update`.
    //   * "k = 9 in the third block uses `res_t`, a different residual" --
    //     it was assigned from the block's residual two lines above and
    //     back into it two lines below.  It is the same residual under a
    //     spill's name, which is what the `const` below now says of all
    //     four.
    //   * "k = 10's mirror bump straddles the join and happens once" --
    //     true, and both arms reach it with the negated residual, so
    //     it is one line
    //     after the join rather than a name each arm has to set.
    //
    // What settled it was said to be that "hoisting the longhand cases
    // out of their place reorders counter updates against each other" --
    // `direct`, `mirror` and `rot` index one bank and can name the same
    // record for different k, so the order is not free.  That is true and
    // it is why nothing is hoisted: each loop below does the same five
    // things in the same order the unrolled text did, and the only lines
    // that moved are the four negated residuals under four names.
    P2Count* bankp = &p2_ctr[slot(bank, 0)];
    // The eleven context bits this counter bank tracks, and the three
    // counters each one names: `direct` at the context with that bit
    // flipped, `mirror` at the same one with the top bits flipped as
    // well, and `rot` at the context with its low nibble rotated by
    // `p2_ctx_rotate`.
    //
    // Sixty-three lines, thirty-three names -- `direct[0]`, `mirror[0]`,
    // `rot[0]`, `direct[1]` and so on down -- and eleven of the thirty-three
    // indices were written as a hex constant apiece: `ctxw^0x3FF0`,
    // `ctxw^0x5FF0`, `ctxw^0x77F0`.  Every one of those eleven is
    // `ctxw ^ bit ^ kBankMirrorMask`, which is what "the top bits
    // flipped" means
    // and what none of the constants said.  The last two were spelled a
    // third way again, through `x0020` and `x0010`.
    //
    // The prefetches were interleaved through the thirty-three
    // declarations in the order MSVC scheduled the loads; they are hints
    // and their order is not observable.
    static const uint32_t p2_bank_bits[11] = {
      0x4000, 0x2000, 0x1000, 0x800, 0x400, 0x200, 0x100, 0x80, 0x40,
      0x20, 0x10,
    };
    P2Count *direct[11], *mirror[11], *rot[11];
    for( int32_t k = 0; k<11; ++k ) {
      const uint32_t x = ctxw^p2_bank_bits[k];
      direct[k] = &bankp[x];
      mirror[k] = &bankp[x^kBankMirrorMask];
      rot[k] = &bankp[p2_ctx_rotate[(x>>2)&3]+(x&0xFFFFFFF3)];
      __builtin_prefetch(direct[k], 0, 1);
      __builtin_prefetch(mirror[k], 0, 1);
      __builtin_prefetch(rot[k], 0, 1);
    }
    // The nine prefetches that stood between these lines -- indices 8, 9
    // and 10 of each of the three arrays, interleaved one per statement --
    // asked for cache lines the loop above has already asked for.  They
    // were the tail of MSVC's schedule after the thirty-three loads were
    // hoisted, and re-rolling those loads into the loop left the second
    // set behind.  A hint issued twice is a hint; nine of them are noise
    // between the lines that do the work.
    const int32_t neg = -res2;
    const int32_t w_top = mir[0].weighted;
    const int32_t e_top = neg-p2_pred(w_top, (uint8_t)mir[0].rate);
    // `e_top > deadzone_hi`, which is what the five siblings of this line
    // in this file already say.  It arrived as the x86 flags the compare
    // sets -- `!(lt ^ of | zf)` over `__OFSUB__` -- because signed
    // less-than *is* `SF != OF`, so `(e_top-deadzone_hi<0) ^ overflow` is
    // the less-than, and not-less-and-not-equal is greater.
    const int32_t bump = 32*((e_top>deadzone_hi)-(e_top<deadzone_lo));
    uint32_t w_new = bump+e_top+2;
    // The partial store this was written as -- `LOWORD(w_new) = w_top +
    // (w_new>>2)` -- kept a high half that the next line throws away.
    // Sixteen bits in and sixteen bits out.
    mir[0].weighted = (int16_t)(w_top+(w_new>>2));
    // The same shape as the `||` above and the same unfolding: the
    // record after the mirrored counter is nudged whenever `lowbits < 3`,
    // and *then* the low bits choose between the two walks.  The chain
    // set `go` from `lowbits <= 0` in its middle and returned it at its
    // end, so the branch this reads was decided four terms before the
    // `if` could see it.
    //
    // `res_c = res_s` was the third term; both arms opened with it as
    // well, and with one name for the residual it says nothing at all.
    if( lowbits<3 )
      p2_nudge(&mir[1], -res2);
    if( lowbits<=0 ) {
      // The first arm owns both ends and never touches the record
      // before the direct counter, so it is its own loop.
      for( int32_t k = 0; k<11; ++k ) {
        p2_update(direct[k], res2, 2);
        p2_update(rot[k], res2, 3);
        p2_nudge(&direct[k][1], res2);
        p2_update(mirror[k], -res2, 3);
      }
    } else {
      p2_nudge(&mir[-1], -res2, 3);
      p2_update(direct[0], res2, 2);
      p2_update(rot[0], res2, 3);
      // `lowbits < 3` was assigned into `go` twice on the way here and
      // read once.  This arm runs at `lowbits` of 1, 2 or 3, so the flag
      // is "not the last value", and it is the one line of five that
      // separates the two passes `walk_bank_bits` can make.
      walk_bank_bits(direct, mirror, rot, res2, lowbits<3);
      // The one counter whose update straddles the join.  Both arms
      // reached it with the negated residual under a name of their own.
      p2_update(mirror[10], -res2, 3);
    }
  }
}

uint32_t AltP2Block::alt_p2_model(int32_t sample_in, uint8_t code, int32_t resid_in) {
  int32_t ctx_lo = ctx&0xF;
  int32_t sample16 = 16*sample_in;
  // This row's record and the one above it, read once.  Nothing below
  // advances a cursor until the five `++cursor[k]` a dozen lines down, and
  // the decompilation had a `cursor0` alias for two of the sixteen reads
  // and the member expression for the other fourteen.
  P2Ctx *const c0 = cursor[0];
  P2Ctx *const c1 = cursor[1];
  c0->val = 16*sample_in;
  c0->dval = c0->val-c0->dval;
  c0[1].dval = 0;
  // The deadzone half-width for this context, and where the residual falls
  // against it.  `dead` climbs 0, 1, 2, 4 with the context's low nibble;
  // `sign` is 2 below the band, 1 inside or below the top, 0 above -- a
  // three-way split written as two comparisons summed.
  //
  // The decompilation had `dead` computed twice, both times as three sign
  // shifts of `(K-ctx_lo)`, and negated the unsigned sum before casting it to
  // `int32_t` -- which is `-dead` only because the conversion is
  // implementation-defined in the way gcc happens to define it.
  const int32_t dead = (ctx_lo>6)+(ctx_lo>4)+2*(ctx_lo>9);
  c0->sign = (resid_in<=dead)+(resid_in< -dead);
  c0->mag = abs32(resid_in);
  float sample = (float)sample16;
  int32_t dl = sample16-c0[-1].val;
  c0->dleft = abs32(dl);
  int32_t du = sample16-c1->val;
  c0->dup = abs32(du);
  int32_t dul = sample16-c1[-1].val;
  c0->dupleft = abs32(dul);
  int32_t dur = sample16-c1[1].val;
  c0->dupright = abs32(dur);
  int32_t resid = (int16_t)(sample16-pred_prev);
  c0->err = resid;
  c0->aerr = abs32(resid);
  NbRow *wrow_cur = nb_cur;
  NbRow *wrow_b = cur[-1];
  // `NbRow::predict` answers with three floats through `bias[0..2]`: the centre
  // the filter's features are measured against, the *mixed* prediction of the
  // six weight sets, and this set's *own*.  They arrived as `n2_bias`, `bias1`
  // and `bias2`, which say where they were fetched from and not what they are.
  const float centre = bias[0];
  const float mixed = bias[1];
  const float own = bias[2];
  const float err_own = sample-own;
  const float d_pred = mixed-own;
  // The confidence that reconciles the two predictions, and the reason row 14
  // exists.  `cov` follows the covariance between the sample's distance from
  // this set's own prediction and the two predictions' disagreement; `var`
  // follows the variance of that disagreement.  Both are running averages at a
  // rate of 0.001, and `var` carries a floor of 1e-4 -- `ms1`, computed nine
  // lines above its use -- so the ratio below cannot divide by a variance that
  // has decayed away.
  //
  // `cov` is then clamped into `[0.1 * var, var]` before it is stored, which is
  // what stops the ratio running away in either direction, and `conf` lands in
  // [0, 2].  It scales both the correction fed to `nlms_track_two_rows` and the
  // step that call takes, so a set whose disagreement with the mix carries no
  // information about the error is corrected less rather than more.
  //
  // The three were `ms_a`, `ms_b` and `ms_b10` -- the last of which is not
  // `0.1 * ms_b` by the time it is stored, only where it starts.  The
  // parenthesisation is preserved exactly: float addition is not associative
  // and the gate is the only thing that would have said so.
  const float cov = (((err_own*d_pred)-wrow_cur->w[14][0])*0.001f)+wrow_cur->w[14][0];
  const float var = (wrow_cur->w[14][1]+0.000099999997f)+(((d_pred*d_pred)-wrow_cur->w[14][1])*0.001f);
  wrow_cur->w[14][1] = var;
  // **Not a min, and the one `fminf` in the program sits inside it.**  Stage 2
  // Section 1.6 asks for this said out loud, because the shape invites the
  // rewrite: the false branch keeps `0.1f * var` rather than either operand, so
  // `clamp(cov, 0.1f*var, var)` is what it *does* and `min(var, cov)` is not.
  // Written as a clamp it would read better and mean the same thing; written as
  // a min it would be wrong.  It is left in the source's own shape.
  float cov_kept = 0.1f*var;
  if( cov_kept<=cov )
    cov_kept = fminf(var, cov);
  wrow_cur->w[14][0] = cov_kept;
  const float conf = (1.0f-(cov_kept/(var+576.0f)))*2.0f;
  nlms_track_two_rows(wrow_cur, wrow_b, (sample-mixed)*2.5999999f, err_own*conf, conf);
  nlms_predict_and_correct(wrow_cur, sample, centre);
  *cur = nb_cur;
  ++cur;
  ++above;
  code_banks(sample16);
  int32_t ctx_l = ctx;
  ++cursor[0];
  P2Freq *frec = &freq[ctx_l];
  ++cursor[1];
  ++cursor[2];
  ++cursor[3];
  ++cursor[4];
  // The step of the record this sample was coded against.  Below 17 the context
  // has settled far enough that none of the updates below run, and the whole
  // body was that test's `then` arm -- one `if` around ninety lines, three deep
  // before anything happened.  As an early return the rest is one level out,
  // and the three values that one local carried are three names.
  const uint32_t step0 = frec[0].step;
  if( step0<=0x10 )
    return step0;
  int32_t is_dec = code&1;
  int32_t ctx15 = ctx_l&0xF;
  uint32_t pair_ctx = ctx_pair[code&1];
  // One neighbouring record nudged: rescale it, then add a fraction of its
  // own step to the side `is_dec` names -- or to side 0 when this symbol
  // carried no residual.  `num/16` is that fraction.
  //
  // This was a label and a backward `goto`, and the comment above it said a
  // structured form needed a loop and a flag to say which way the block had
  // been entered.  It needs neither.  The residual coder below runs on every
  // path that gets this far, and the only thing the two entries disagreed
  // about is whether the record *below* the context had been nudged first --
  // which is `ctx15 > 0`, the condition already sitting under the jump.  The
  // two nudges are the same six lines twice over, differing in which
  // neighbour and in the fraction.
  auto nudge = [&](int32_t at, uint32_t num, uint32_t pair_at) {
    // `bin` is the record this nudge moves.  It was `mir_top` -- a
    // `uint16_t*` over a `P2Freq`, where index 1 is `f[0]` and `3 - is_dec`
    // is `f[2]` or `f[1]` -- declared at the top of the function and assigned
    // thirteen times, each with a `P2Freq*` cast written on it.  Twelve of
    // those thirteen are now `p2_freq_add` and `p2_bump_sides`; this is the
    // survivor, and it is a local.
    P2Freq*const bin = &frec[at];
    p2_rescale(bin);
    const uint32_t step10 = (num*(uint32_t)frec[at].step)>>4;
    if( code ) {
      bin->f[2-is_dec] += step10;
      update_binary_pair(model_strip(pair_at), (code-1)>>1);
    } else {
      bin->f[0] += step10;
    }
  };
  if( ctx15<15 )
    nudge(1, 10, pair_ctx+1);
  if( ctx15>0 )
    nudge(-1, 13, pair_ctx-1);
  // The reload of `frec` that stood between the two nudges was `&freq[ctx]`,
  // which is what it already held: `ctx` is written in `code_banks` and in
  // the table set-up, both above this, and nothing between the two nudges
  // touches it.
  if( freq[ctx].step<=0x1Au )
    return ctx;
  int32_t fold_sel = 2-(fold[(uint8_t)-resid_in]&1);
  if( !fold[(uint8_t)-resid_in] )
    fold_sel = fold[(uint8_t)-resid_in];
  // The alternate context: the low six bits of the live one, with all five
  // features read the other way round above it.  `AltP1Block::update_model`
  // builds its own the same way over nine features and five bits.
  //
  // The weights stay a sum for the reason they do there -- each is a table
  // entry already scaled by its feature's stride -- and the parentheses round
  // the last two terms were the register allocator's, not a grouping.
  const uint32_t step_ctx = CtxIdx{}.bits<0, 6>(ctx).raw(mixer_rev(ctx_w, 5));
  P2Freq *frec_step = &freq[step_ctx];
  // The record after the step's and the record before it, each bumped when
  // the level leaves room for it.  This was one `if` with an empty `else`, a
  // `goto` out of its middle to a label below the second bump, and the second
  // bump reached by falling past that label -- three ways of saying two
  // independent conditions, which is what `p2_bump_sides` is.
  p2_bump_sides(frec_step, ctx15, 0, fold_sel, 4, 4);
  if( code ) {
    int32_t n2_half = (code-1)>>1;
    int32_t hi_nibble = (uint8_t)pair_ctx&0xF0;
    if( hi_nibble>=0xF0||(update_binary_pair(model_strip(pair_ctx+16), n2_half), hi_nibble>0) ) {
      update_binary_pair(model_strip(pair_ctx-16), n2_half);
    }
  }
  P2Freq *prec0 = &frec_step[0];
  p2_freq_add(prec0, fold_sel, 6);
  if( !plane_idx||freq[ctx].step>0x100u ) {
    // The mirrored side of the three-way counter -- 0 and 2 swap, 1 stays --
    // or side 0 when the symbol carried no residual.  `sel_alt` was a temporary
    // that held the answer for one line before `is_dec` took it.
    is_dec = code ? 2-is_dec : 0;
    // The five context banks, bumped.  `bump_bank` is one bank's worth; the
    // five were written out in full, thirty-six lines apiece, and its comment
    // says what they had in common.
    for( int32_t k = 0; k<5; ++k )
      bump_bank(k, step_ctx, ctx15, fold_sel, is_dec);
  }
  return step_ctx;
}

// alt_p2_code.inc -- the predictor-2 model at depths other than eight, both
// directions.
//
// `P2Coef` in alt_p2_block.inc is the coefficient-table borrow both directions
// do for the length of one image.  This file's header used to say the encoder
// did it and the decoder did not; the decoder does, in the same six lines, and
// the two are one object now.
//
// The two halves were 86 and 89 lines in two files and `pairshare.py` measured
// them at 34 shared of 153 -- the largest share of the five pairs bmf.cpp's
// table declined, and declined on the argument that what they share is
// scaffolding rather than algorithm.  Read line by line that turned out not to
// hold here: outside the four coding calls they are the same body, and the
// differences are eight spellings and one deliberate near-miss.
//
//   * `rc_begin_*` and `rc_end_*`, two lines;
//   * `encode_sample` against `decode_sample`, four lines, which is
//     `AltP2Block::code_sample<f_DEC>`;
//   * plane 3's output offset -- the decoder stores to `out[3]` where the
//     encoder and all three other planes use `plane_desc[3].src_plane`.  That
//     is what the binary does and it stays, as the only `f_DEC` in the body
//     that is not about direction;
//   * the rest were spellings.  The row-zero bias loop counted up in one and
//     down in the other over four slots it sets to zero; the sample loop was a
//     `for` in one and a `do`/`while` in the other; and both saved the row
//     index into a second local across a loop that does not touch it -- `xf4`
//     in the encoder, `first` and `i_1` in the decoder -- which is a register
//     spill and not a value.
//
// The gate is the one the other nine merges used: the fifteen streams byte for
// byte at both pointer widths, and both instantiations entered.
template<int32_t f_DEC>
static int32_t alt_model_p2(BmfImage* p_i, uint8_t* out) {
  AltP2Block* plane[4];
  P2Coef p2_coef;
  p2_coef.fold();
  const int32_t width = p_i->width;
  const int32_t height = p_i->height;
  alt_p2_planes_alloc(plane, width);
  const bool ref1_mixed = ref_transformed(1);
  const bool ref2_mixed = ref_transformed(2);
  const bool ref3_mixed = ref_transformed(3);
  if constexpr( f_DEC )
    rc_begin_decode();
  else
    rc_begin_encode();
  int32_t nplanes = plane_count;
  for( int32_t y = 0; y<height; ++y ) {
    if( nplanes>0 ) {
      alt_p2_start_row(plane, y, width);
      nplanes = plane_count;
    }
    // Each row starts the bias accumulators at zero.  They were four locals in
    // the encoder -- `at0`, `seed0`, `off0`, `want0` -- with `ctx_bias` loaded
    // from them at the head of every sample and written back at the end of the
    // row.
    for( int32_t j = 0; j<4; ++j ) ctx_bias[j] = 0;
    for( int32_t x = 0; x<width; ++x ) {
      for( int32_t j = 0; j<4; ++j ) ctx_bias[j] >>= 3;
      plane[0]->code_sample<f_DEC>(out, plane_desc[0].src_plane,
                                   plane[2], plane[1]);
      plane[0]->add_bias(ctx_bias);
      // Every plane after the first seeds its prediction from the planes
      // already coded at this pixel, blended by the descriptor's weights -- or
      // from nothing, when the descriptor says this plane is not mixed.
      int16_t seed1 = 0;
      if( ref1_mixed )
        seed1 = 16*out[plane_desc[0].src_plane];
      plane[1]->cursor[0]->dval = seed1;
      plane[1]->code_sample<f_DEC>(out, plane_desc[1].src_plane,
                                   plane[0], plane[2]);
      plane[1]->add_bias(ctx_bias);
      int16_t seed2 = 0;
      if( ref2_mixed )
        seed2 = (plane_desc[plane_desc[2].src_plane].weight1*out[plane_desc[1].src_plane]+plane_desc[plane_desc[2].src_plane].weight0*out[plane_desc[0].src_plane])>>3;
      plane[2]->cursor[0]->dval = seed2;
      plane[2]->code_sample<f_DEC>(out, plane_desc[2].src_plane,
                                   plane[0], plane[1]);
      plane[2]->add_bias(ctx_bias);
      nplanes = plane_count;
      if( plane_count>=4 ) {
        int16_t seed3 = 0;
        if( ref3_mixed )
          seed3 = (plane_desc[plane_desc[3].src_plane].weight2*out[2]+plane_desc[plane_desc[3].src_plane].weight1*out[1]+plane_desc[plane_desc[3].src_plane].weight0**out)>>3;
        plane[3]->cursor[0]->dval = seed3;
        // The decoder stores to `out[3]` where the encoder uses
        // `plane_desc[3].src_plane`, as do all three planes above in both
        // directions.  Kept as the binary has it: this is the one `f_DEC` here
        // that is not about which way the coder is running.
        plane[3]->code_sample<f_DEC>(out, f_DEC ? 3 : plane_desc[3].src_plane,
                                     plane[2], plane[0]);
        plane[3]->add_bias(ctx_bias);
        nplanes = plane_count;
      }
      out += nplanes;
    }
  }
  if constexpr( f_DEC )
    rc_end_decode();
  else
    rc_end_encode();
  p2_coef.restore();
  return alt_p2_planes_free(plane);
}

// The two names `plane.inc` reaches for.  The decode half was a file of its own
// holding these two lines; `alt_p1_code.inc` keeps its pair together and this
// is the same shape one model over.
int32_t alt_model_p2_encode(BmfImage* p_i, uint8_t* a2) {
  return alt_model_p2<0>(p_i, a2);
}

int32_t alt_model_p2_decode(BmfImage* p_i, uint8_t* out) {
  return alt_model_p2<1>(p_i, out);
}

// plane_predict.inc -- the predictors and the colour transform -- what is subtracted from
// an image before it is modelled, and added back after.

// Predictor mode 0 undoes nothing: an image coded without a predictor has
// nothing subtracted from it.  The body is empty in BMF.exe too -- the encoder
// side calls through a table of three, and this is the entry the table needs at
// index 0.
// The MED / LOCO-I predictor, which JPEG-LS calls the median edge detector, and
// now written as the rule rather than as the branch tree MSVC compiled it to:
// pick `min(N,W)` at a rising edge, `max(N,W)` at a falling one, and the plane
// `N + W - NW` in between.
//
// Proven, not argued.  Both spellings evaluated over all 16,777,216 byte triples
// -- 0 disagreements -- which covers the two tie boundaries the case analysis
// has to get right and which a corpus run does not reach on purpose.
//
// The `(uint8_t)` casts here are provably non-wrapping, unlike the folding casts
// elsewhere in this tree: on the third path the gradient lies in `[lo, hi]` and
// on the other two the result is a neighbour.  No `clamp(0, 255)` is needed, and
// adding one -- as one of the plans supplying this stage proposes -- would be a
// no-op here and would break the bitstream anywhere the wrap *is* the algorithm.
static inline uint8_t med_predict(int32_t west, int32_t north, int32_t northwest) {
  const int32_t lo = min32(west, north), hi = max32(west, north);
  if( northwest>=hi )
    return (uint8_t)lo;
  if( northwest<=lo )
    return (uint8_t)hi;
  return (uint8_t)(west+north-northwest);
}

// The zigzag a MED residual takes on its way to a symbol, and its inverse:
// 0, -1, 1, -2, 2, ... becomes 0, 1, 2, 3, 4, ..., so the sign rides in the low
// bit and a small residual stays a small symbol.
//
// Both were built inline, five lines apiece, `fold` counting up in twos from
// each end of the table and `unfold` filling the odd and even slots in one
// pass.  Two spellings of one table and its inverse, and neither said so.
//
// Not the alt models' `alt_init_tables` pair, which buckets by
// `near_lossless_q` and is a different table with the same job.
static void med_fold_table(uint8_t* fold) {
  for( int32_t j = 0; j<128; ++j ) {
    fold[j] = (uint8_t)(2*j);
    fold[128+j] = (uint8_t)(-1-2*j);
  }
}

static void med_unfold_table(uint8_t* unfold) {
  unfold[0] = 0;
  for( int32_t j = 0; j<127; ++j ) {
    unfold[2*j+1] = (uint8_t)(-1-j);
    unfold[2*j+2] = (uint8_t)(1+j);
  }
  unfold[255] = (uint8_t)(-1-127);
}

uint32_t predict_med(uint8_t* pixels, int32_t width, int32_t height) {
  uint32_t done, last;
  alignas(16) uint8_t fold[272];
  uint8_t *p = pixels+height*width;
  uint8_t *up = &p[-width];
  med_fold_table(fold);
  // Same again a row up: `height - 1` rows, so `if( height != 1 )` is the
  // count being non-zero.
  for( int32_t rows_left = height-1; rows_left; --rows_left ) {
    // The `if( width != 1 )` guard and the `do` inside it are one statement:
    // the count is `width - 1`, so the guard is the loop's own test.
    for( int32_t x_left = width-1; x_left; --x_left ) {
      const int32_t north = (uint8_t)*--up;
      --p;
      const uint8_t pred = med_predict(p[-1], north, p[-width-1]);
      const int32_t code = (uint8_t)fold[(uint8_t)(*p-pred)];
      *p = code;
      hist_bump(code);
    }
    // The first column has no west neighbour, so it takes a plain vertical
    // difference.
    --up;
    --p;
    last = (uint8_t)fold[(uint8_t)(*p-p[-width])];
    *p = last;
    hist_bump(last);
  }
  if( width!=1 ) {
    last = width-1;
    const int32_t pairs = last/2;
    {
      uint32_t k = 0;
      for( int32_t ofs = 0; k<(uint32_t)pairs; ++k, ofs -= 2 ) {
        const uint8_t left = p[ofs-2];
        p[ofs-1] = fold[(uint8_t)(p[ofs-1]-left)];
        p[ofs-2] = fold[(uint8_t)(left-p[ofs-3])];
      }
      done = 2*k+1;
    }
    if( last>(done-1) ) {
      uint8_t *q = p-done;
      last = (uint8_t)(*q-*((int8_t*)q-1));
      *q = fold[(uint8_t)last];
    }
  }
  return last;
}

// One plane out of the interleaved image and back again: `dst[i]` is
// `pixels[plane + i*plane_count]`.  This is what both coders degenerate to
// when the plane has no reference planes to predict from, and what
// `expand_image` does inline for the one plane it decodes on its own -- three
// copies of the same two loops, each with the one-plane case spelled out as
// the `memcpy` it is.
//
// `for` rather than the original `do`/`while`, which ran once whatever the
// count: an image with no pixels does not reach here, and the bound is the
// thing worth being able to read.
// `n` bytes from `src` to `dst`, one of the two strided by `plane_count` and
// the other flat -- so a `memcpy` exactly when the image has one plane and
// both strides are one.
static void strided_copy(uint8_t* dst, int32_t dstep,
                         const uint8_t* src, int32_t sstep, int32_t n) {
  if( dstep==1&&sstep==1 ) {
    memcpy(dst, src, n);
    return;
  }
  for( int32_t i = 0; i<n; ++i, dst += dstep, src += sstep )
    *dst = *src;
}

static void deinterleave_plane(const BmfImage* img, uint8_t* dst, int32_t plane) {
  strided_copy(dst, 1, &img->pixels[plane], plane_count, bmf_pixels(img));
}

// The inverse.  `colour_transform` reached for the gather by name and
// `interleave_plane` wrote the scatter out, so the two did not look like a
// pair; writing them both this way round is what shows that the only
// difference is which side carries the stride.
static void interleave_flat(BmfImage* img, const uint8_t* src, int32_t plane) {
  strided_copy(&img->pixels[plane], plane_count, src, 1, bmf_pixels(img));
}

// What a plane's descriptor says about the transform between it and the planes
// it references: which plane, the DC offset, and the three weights.
//
// `interleave_plane` and `colour_transform` each decoded this in the same
// nineteen lines.  The round that named this said those nineteen were the whole
// of what the two share, "the loops under them are inverses and have nothing
// else in common" -- which was a sentence about how they were spelled.  Each
// loop is one blend of the referenced planes and then a sign: the forward
// writes `x - dc - blend` and the inverse `blend + dc + x`, over the same
// operands in the same order.  They are `code_colour_plane<f_DEC>` below.
//
// `by_weights` is the case worth naming.  A two-reference plane whose weights
// are 128 and 0 reads only one plane after all, and which one depends on which
// of the two is zero; that is why a descriptor saying `nrefs == 2` can take the
// one-reference path below.
struct PlaneTransform {
  int32_t to_ref0, to_ref1, mode, dc, wgt0, wgt1, wgt2;
  bool by_weights;

  // What the referenced planes predict of this one at `p`, in the units the
  // residual is in.  Two references read the two planes the descriptor names;
  // three read the three bytes before `p`, which are the other components of
  // the same pixel.  Only these two modes reach here -- one reference is the
  // `by_weights` path above and no references is the flat copy.
  //
  // Both were written four different ways across the encoder and the decoder,
  // one casting to `uint32_t` mid-expression, one summing into an `int32_t`
  // and casting the total, two splitting the sum across an extra local.  All
  // four are the same thirty-two bits; unsigned throughout is the one that
  // cannot overflow signed.
  //
  // The **63** in the three-reference form is not a typo for 64.  Model B
  // computes this same blend for itself, on the interleaved path, in
  // `alt_p1_code.inc`'s `plane_mix3` -- and rounds it with 64.  The
  // two-reference forms agree at 40; only this one differs, by one.  Merging
  // the two helpers changes the output of every four-plane image, so they stay
  // apart.  See the note over `plane_mix2` for the reachability count.
  uint32_t blend(const uint8_t* p) const {
    if( mode==2 )
      return (wgt0*(uint32_t)p[to_ref0]+wgt1*(uint32_t)p[to_ref1]+40)>>7;
    return (wgt1*(uint32_t)p[-2]+wgt0*(uint32_t)p[-3]+wgt2*(uint32_t)p[-1]+63)>>7;
  }
};

static PlaneTransform plane_transform(int32_t plane) {
  PlaneTransform t;
  t.to_ref0 = plane_desc[0].src_plane-plane;
  t.to_ref1 = plane_desc[1].src_plane-plane;
  t.mode = plane_desc[plane].nrefs;
  t.dc = plane_desc[plane].dc;
  t.wgt1 = plane_desc[plane].weight1;
  t.wgt0 = plane_desc[plane].weight0;
  t.wgt2 = plane_desc[plane].weight2;
  t.by_weights = false;
  if( t.mode==2&&t.wgt0+t.wgt1==128 ) {
    if( !t.wgt1 ) {
      t.by_weights = true;
    } else if( !t.wgt0 ) {
      t.to_ref0 = plane_desc[1].src_plane-plane;
      t.by_weights = true;
    }
  }
  return t;
}

// One plane against the planes it references, in whichever direction.  Four
// modes, chosen by `desc_has_refs` and `nrefs`:
//
//   no transform      copy the plane, interleaved to flat or back
//   one reference     `x - dc - ref`, a plain difference
//   two references    `x - dc - (w0*a + w1*b + 40)/128`
//   three references  `x - dc - (w0*a + w1*b + w2*c + 63)/128`
//
// The two-reference case degenerates to the one-reference case when one weight
// is 128 and the other 0, and the code takes that path explicitly -- which is
// `plane_transform`'s `by_weights` flag, and why a two-reference descriptor can
// end up reading only one plane.
//
// `f_DEC` is which way: the encoder reads the image and writes residuals to
// `side`, the decoder reads residuals from `side` and writes the image back.
// Every `if constexpr( f_DEC )` in here is that and nothing else.
//
// The blends were written four different ways between the two bodies -- one
// cast to `uint32_t` mid-expression, one summing into an `int32_t` and casting
// the total, two splitting the sum across an extra local -- and all four are
// the same thirty-two bits.  Spelling them unsigned throughout is what let the
// two loops become one, and it takes a signed overflow out of the forward
// direction on the way.
template<int32_t f_DEC>
static void code_colour_plane(BmfImage* img, uint8_t* side, int32_t plane) {
  uint8_t* base = &img->pixels[plane];
  if( !(plane_desc[plane].flags&desc_has_refs) ) {
    if constexpr( f_DEC )
      interleave_flat(img, side, plane);
    else
      deinterleave_plane(img, side, plane);
    return;
  }
  int32_t stride = plane_count;
  int32_t n = bmf_pixels(img);
  const PlaneTransform t = plane_transform(plane);
  // The same dispatch `plane_transform` makes, written the same way round.
  // Here it was two nested `if`s with the one-reference path falling out of
  // the bottom of both, which is `by_weights || nrefs == 1` reached the long
  // way.
  if( t.by_weights||plane_desc[plane].nrefs==1 ) {
    const uint8_t *ref = base+t.to_ref0;
    for( int32_t i = 0, ofs = 0; i<n; ++i, ofs += stride ) {
      if constexpr( f_DEC )
        base[ofs] = ref[ofs]+t.dc+side[i];
      else
        side[i] = base[ofs]-t.dc-ref[ofs];
    }
    return;
  }
  // Two references and three were two loops of six lines that differed in one
  // expression, which is `PlaneTransform::blend`.
  if( t.mode==2||t.mode==3 ) {
    uint8_t *p = base;
    for( int32_t left = n; left; --left, p += stride ) {
      const uint32_t blend = t.blend(p);
      if constexpr( f_DEC )
        *p = (uint8_t)(blend+t.dc+*side++);
      else
        *side++ = (uint8_t)(*p-t.dc-blend);
    }
  }
}

void interleave_plane(BmfImage* img, uint8_t* src, int32_t plane) {
  code_colour_plane<1>(img, src, plane);
}

void colour_transform(BmfImage* img, uint8_t* dst, int32_t plane) {
  code_colour_plane<0>(img, dst, plane);
}

uint8_t*unpredict_med(uint8_t* pixels, int32_t width, int32_t height) {
  uint32_t done, k, x_left;
  alignas(16) uint8_t unfold[256];
  uint8_t *p = pixels+1;
  med_unfold_table(unfold);
  int32_t rows_left = height-1;
  if( width!=1 ) {
    // The first row has nothing above it, so it is a plain left-to-right
    // difference.  The original unrolled it by two -- the `pairs` loop -- with
    // the odd pixel after it.
    uint32_t row_rest = width-1;
    uint32_t pairs = row_rest/2;
    if( pairs ) {
      for( k = 0; k<pairs; ++k ) {
        uint8_t cur = pixels[2*k]+unfold[pixels[2*k+1]];
        pixels[2*k+1] = cur;
        pixels[2*k+2] = cur+(unfold[pixels[2*k+2]]);
        p = &pixels[2*k+3];
      }
      done = 2*k+1;
    } else {
      done = 1;
    }
    if( row_rest>done-1 ) {
      pixels[done] = pixels[done-1]+unfold[pixels[done]];
      p = &pixels[done+1];
    }
  }
  if( height==1 )
    return p;
  if( width==1 ) {
    // One pixel to a row, so the row loop and the column loop are one loop and
    // `med_predict` never runs: a pixel's only neighbour is the one above it.
    //
    // The recovery said this with a `while( 1 )` wrapped round the first pixel
    // of a row which broke out of itself for a wide image and looped for a
    // narrow one -- one loop doing two jobs, with the narrow case's `return`
    // three levels in and its `x_left = 0` assigned every turn and never read.
    for( ; rows_left; --rows_left ) {
      *p = unfold[(uint8_t)*p]+p[-width];
      ++p;
    }
    return p;
  }
  uint8_t *up = &p[-width];
  for( ; rows_left; --rows_left ) {
    // The first pixel of a row has no west neighbour, so it takes the one
    // above it rather than a MED prediction.
    ++up;
    *p = unfold[(uint8_t)*p]+p[-width];
    ++p;
    for( x_left = width-1; x_left; --x_left ) {
      const uint8_t pred = med_predict(p[-1], (uint8_t)*up, p[-width-1]);
      *p = pred+unfold[(uint8_t)*p];
      ++up;
      ++p;
    }
  }
  return p;
}

// The k'th plane in descriptor order, with `plane_predictor` -- which is how a
// descriptor reaches the model at all -- set from it.  Both walks over the
// planes open with these two lines, the encoder here and the decoder in
// `expand_image`, and until this round both also spelled the loop around them
// as `++k` first and `plane_desc[k - 1]` after it under an `if( plane_count >
// 0 )` guard that a `for` does not need.
static int32_t plane_in_order(int32_t k) {
  const int32_t plane = plane_desc[k].src_plane;
  plane_predictor = plane_desc[plane].flags&desc_predictor;
  return plane;
}

void transform_planes(BmfImage* p_i) {
  int32_t i;
  memset(hist_scratch, 0, 4096);
  // A scratch image in the coded buffer: one header's worth of bytes reserved,
  // then a copy of the header, then the pixels.  The reserved run and the
  // header are the same size, which is why `hdr->pixels` is `stream.buf + 32`
  // -- and what the copy below was addressing by number.
  //
  // `sizeof(BmfImage)` rather than the 16 it is: this was the last place in
  // the tree where an object's layout was written as arithmetic instead of
  // declared, which is the row `shape.py` counts first.
  static_assert(sizeof(BmfImage) == 16, "the reserved run is one header");
  BmfImage *hdr = (BmfImage*)(stream.buf+sizeof(BmfImage));
  *hdr = *p_i;
  uint8_t* src_pixels = p_i->pixels;
  memcpy(hdr->pixels, p_i->pixels, p_i->data_size);
  uint8_t *tmp = (uint8_t*)bmf_new(p_i->width*p_i->height);
  for( int32_t k = 0; k<plane_count; ++k ) {
    const int32_t plane = plane_in_order(k);
    const int32_t predictor = plane_predictor;
    const int32_t alt = (plane_desc[plane].flags&desc_alt_model)!=0;
    plane_alt_model = alt;
    // A plane is transformed when it has references or a predictor, and not
    // when it carries the alternate model -- that family does its own.  The
    // condition held the whole of the loop body and had nothing after it, so it
    // is a name and an early exit.
    const bool transform_it =
        ((plane_desc[plane].flags&desc_has_refs)!=0||predictor)&&!alt;
    if( !transform_it )
      continue;
    colour_transform(hdr, tmp, plane);
    // `!= pred_p2 && == pred_p1` is `== pred_p1`: the two are distinct
    // values of the same two-bit field, so the outer test can only be
    // true when the inner one is.
    if( plane_predictor==pred_p1 )
      predict_med(tmp, p_i->width, p_i->height);
    int32_t n = p_i->width*p_i->height;
    int32_t stride = plane_count;
    if( plane_count==1 ) {
      memcpy(&p_i->pixels[plane], tmp, n);
    } else {
      uint8_t *dst = &p_i->pixels[plane];
      int32_t ofs = 0;
      for( i = 0; i<n; ++i ) {
        dst[ofs] = tmp[i];
        ofs += stride;
      }
    }
  }
  free(tmp);
  model_plane(p_i, src_pixels, src_pixels);
}

// plane.inc -- one plane in and out of the model, whichever model the header names.

// Which of the two alternate models this plane's descriptor names, and the
// call it makes: p1 or p2, and within each the eight-bit body or the generic
// one.  Answers whether it handled the plane; `false` is the main model, which
// is the one thing the encoder and the decoder do differently -- 100 lines
// written out in `model_plane` against a call to `unmodel_plane_slow`.
//
// Sixteen lines apiece in the two dispatchers, and the only differences were
// `_encode` against `_decode` and the fourth argument the two eight-bit
// encoders take.  That is the whole of what `pairshare.py` measured as the
// `model_plane`/`unmodel_plane` pair's 14 shared lines of 170.
//
// `plane_alt_model` with a predictor that is neither 1 nor 2 codes nothing at
// all and does *not* fall through to the main model.  That is what the
// original's nesting says and it is why this answers `true` for any
// `plane_alt_model`, not just for the two arms that do something.
template<int32_t f_DEC>
static bool alt_model_plane(BmfImage* p_i, uint8_t* pixels, uint8_t* raw) {
  if( !plane_alt_model )
    return false;
  const bool p1 = plane_predictor==pred_p1;
  if( !p1&&plane_predictor!=pred_p2 )
    return true;
  // The four entry points come in p1/p2 pairs and each pair has one signature,
  // so the predictor picks *which* of a pair and the depth and direction pick
  // *which pair*.  Written as two nested `if`s under each predictor this was
  // the same ten lines twice, differing in a `1` against a `2`.
  const bool d8 = (p_i->depth&depth_bits)==8;
  if( d8 ) {
    if constexpr( f_DEC )
      (p1 ? alt_model_p1_d8_decode : alt_model_p2_d8_decode)
        (pixels, p_i->width, p_i->height);
    else
      (p1 ? alt_model_p1_d8_encode : alt_model_p2_d8_encode)
        (pixels, p_i->width, p_i->height, raw);
  } else if constexpr( f_DEC ) {
    (p1 ? alt_model_p1_decode : alt_model_p2_decode)(p_i, pixels);
  } else {
    (p1 ? alt_model_p1_encode : alt_model_p2_encode)(p_i, pixels);
  }
  return true;
}

// One plane through the main model, in whichever direction: allocate the
// workspace, run the body, give it back.  The two bodies are not one thing --
// the encoder seeds fifteen context groups and the alphabet before its row
// walk and the decoder reads all of that back off the stream, 130 lines
// against 260 -- but everything around them is, and that is what
// `pairshare.py` was left measuring once both bodies had names.
//
// The `if( blk )` was on the decoder's free and not the encoder's.  It is dead
// either way: the line above has already dereferenced `blk`, so a null one
// does not reach here.  Kept, as the wider of the two spellings.
template<int32_t f_DEC>
static void code_plane(BmfImage* p_i, uint8_t* pixels, uint8_t* raw) {
  if( alt_model_plane<f_DEC>(p_i, pixels, raw) )
    return;
  ModelBlock* blk = new_model_block(p_i->width, p_i->height,
                                    p_i->depth&depth_bits);
  if constexpr( f_DEC )
    blk->unmodel_plane_slow(pixels);
  else
    blk->model_plane_slow(pixels);
  blk->free_workspace();
}

// The two names the callers reach for, and they sit together because they are
// one function apiece.  `model_plane` was a file of its own -- what had been in
// it was 130 lines of `blk->` where the decoder had a call, which is why
// `pairshare.py` read this pair at 14 shared lines of 170: it was comparing a
// body against a call.  With the body in `code_plane` above, the pair is these
// six lines.
void model_plane(BmfImage* p_i, uint8_t* pixels, uint8_t* raw) {
  code_plane<0>(p_i, pixels, raw);
}

void unmodel_plane(BmfImage* p_i, uint8_t* out) {
  code_plane<1>(p_i, out, nullptr);
}

void model_planes(BmfImage* img, uint8_t* pixels, int32_t plane) {
  plane_predictor = plane_desc[plane].flags&desc_predictor;
  plane_alt_model = (plane_desc[plane].flags&desc_alt_model)!=0;
  colour_transform(img, pixels, plane);
  // 1,024 bytes.  The original zeroed them as a `memset` of the unaligned head,
  // one aligned 16-byte store at the tail, and a loop of seven more stepping
  // back by 112 -- SSE, unrolled sevenfold, over a buffer whose start it had to
  // round up to 16 first.  The three ranges cover [0, 1023] whatever the
  // rounding takes: the head covers everything below the aligned start (at most
  // 15 bytes), the loop covers 1,008 from there, and the tail store covers what
  // the loop's own offset pushed past the end.  This runs once per plane.
  memset(hist_scratch, 0, 1024);
  {
    BmfImage hdr = *img;
    hdr.depth = depth_one_plane;
    if( plane_predictor==pred_p1&&!plane_alt_model )
      predict_med(pixels, img->width, img->height);
    model_plane(&hdr, pixels, pixels);
  }
}

// filter_cost.inc -- what one filter would cost on this image.

// Two walks over the image and seven histograms, which is all the frame ever
// held.  The first walk fits two weights by least squares and fills six
// histograms of pixel differences; the second re-walks with the fitted weights
// and fills the seventh.  `estimate_cost` turns each into bits, and the
// cheapest combination is the answer.
//
// **What the frame was hiding.**  Two of its members were the wrong size and
// the wrong type, and each was written through a `uint32_t *` because of it.
//
// `buf[4096]` is `hist_x[1024]`.  `*(uint32_t *)&buf[4*dx+2048]` is
// `hist_x[dx+512]`, and `dx` is a difference of two byte sums, so it is
// -510..510 and the index is 2..1022: it never leaves the member.  That is
// what `liftframe.py` declined this frame for -- its rule flags any computed
// index, because it cannot bound one, and the decline was recorded as though
// the index had been shown to escape.
//
// `buf_1[4]` was `hist_w[512]`, 2048 bytes.  `memset(buf_1, 0, 2048)` and
// `estimate_cost(buf_1, 512)` both said so, and what the four-byte declaration
// made of the other 2044 bytes was the eleven members after it: `img_end`,
// eight offset slots, and the head of a 2008-byte pad.  Measured at both
// widths rather than reasoned about -- the region is 24576..26623 either way,
// and at 32 bits it stops one byte short of the next live member, which is
// what that pad was sized for.
//
// Nothing read those eleven after the `memset`, which is why clearing them was
// invisible: `img_end` is a local here, the eight offsets were the
// decompiler's spill slots for neighbour offsets that are `const` locals in
// the walk, and `nplanes` is `plane_count`.  The histogram itself has moved
// again since: it belongs to `weight_pair_cost` now, which is the walk that
// fills it and the four copies of that walk in `choose_plane_coding`.  So the whole of the frame after
// the histograms was padding, and there is no frame.
//
// **The output was a byte pointer too.**  `pd` was `uint8_t *desc`, written as
// `desc[16*k]`, `desc[33]` and `*(uint32_t *)&desc[16*cand+4]`.  It is four
// `PlaneDesc` -- one candidate's row of `choose_plane_coding`'s 3x16 table,
// which that function copies into `plane_desc` with
// `memcpy(…, 4*sizeof(PlaneDesc))` once a candidate wins.  Byte 16*k+0 is
// `nrefs`, +1 is `src_plane`, +4 and +8 are the two weights, and the whole of
// this function's output is those four fields.  No cast is left in this file.
// One residual quantised into the 512-bin histogram the filter search scores.
// `own` is this plane's gradient at the sample; `a` and `b` are the two
// reference planes' gradients at the same sample, blended by the candidate's
// two weights, rounded, and taken as a nine-bit offset from 256.
//
// Five copies of a hundred and fifty characters -- this one and four in
// `choose_plane_coding` -- and two of the differences between them are not
// what they look like.
//
//   * The second gradient carries a `(uint32_t)` on its last term at every one
//     of the five sites, and it is load-bearing: it makes the blend unsigned,
//     so the `>> 7` is a logical shift rather than an arithmetic one and a
//     negative blend rounds the other way.  `b` is `uint32_t` here for that
//     reason, and the call sites keep the cast that puts it there.
//   * Two of the five cast `own` to `int16_t` and three to `uint16_t`.  That
//     one cannot show, for all inputs and not merely on this corpus: the two
//     readings differ by exactly 65536, which is 128 times 512, so they agree
//     in the nine bits `& 0x1FF` keeps.
// The rows of a histogram block, cut out by index.  Three functions here and in
// plane_choose.inc keep their histograms in one `int32_t[n*1024]` -- because
// each of them also picks a row *by index*, which is what the original's byte
// offsets said -- and each then cut the same cursors out of it a row at a time.
// Six lines, four lines and four lines, and `hists + 3*1024` written out in all
// three.  The stride lives here now and the call sites name their rows.
//
// Six rather than four because `cost_candidate` uses six; the two callers that
// want four ignore the tail, which costs nothing and keeps this one function.
struct HistRows {
  int32_t *r0, *r1, *r2, *r3, *r4, *r5;
};

static HistRows hist_rows(int32_t* hists) {
  return { hists, hists+1*1024, hists+2*1024, hists+3*1024,
           hists+4*1024, hists+5*1024 };
}

static inline int32_t residual_bin(int32_t own, int32_t w0, int32_t a,
                                   int32_t w1, uint32_t b) {
  return ((uint16_t)own-(uint16_t)((w0*a+w1*b+40)>>7)-256)&0x1FF;
}

// Cost one plane under a candidate pair of transform weights: walk every sample
// after the first row, quantise its residual into a 512-bin histogram, and
// score the histogram.
//
// Five copies: `cost_candidate`'s second walk, below, and four in
// `choose_plane_coding` of twenty-six lines each, differing in nothing but the
// two weights and which of four `[512]` locals they cleared.  Those four
// locals are gone with them; the histogram belongs to the walk.
//
// `plane_a` and `plane_b` are byte offsets from this plane to the two it
// references, which is why they are added to the same base rather than passed
// as pointers.
static int32_t weight_pair_cost(const BmfImage* img, const uint8_t* plane0,
                                int32_t plane_a, int32_t plane_b,
                                int32_t w4, int32_t w8) {
  int32_t hist[512];
  memset(hist, 0, sizeof hist);
  const int32_t stride = img->stride;
  const int32_t left = -plane_count;
  const int32_t ofs_up = -stride;
  const int32_t ofs_ul = -stride-plane_count;
  const uint8_t *p = plane0-ofs_ul;
  const uint8_t *q = plane0+plane_a-ofs_ul;
  const uint8_t *r = plane0+plane_b-ofs_ul;
  // One pixel short of the rows below the first, and never zero: the caller
  // only reaches here for an image with at least two rows and two columns.
  for( int32_t n = img->width*(img->height-1)-1; n; --n ) {
    const int32_t cur = *q;
    ++hist[residual_bin(p[ofs_ul]+*p-p[ofs_up]-p[left],
                        w4, q[ofs_ul]+cur-q[ofs_up]-q[left],
                        w8, r[ofs_ul]+*r-r[ofs_up]-(uint32_t)r[left])];
    q -= left;
    p -= left;
    r -= left;
  }
  return estimate_cost(hist, 512);
}

int32_t cost_candidate(BmfImage* img, int32_t cand, PlaneDesc* pd, uint32_t* costs) {
  // Six histograms of a difference, indexed `value + 512`, in one block --
  // which is what the original had: a single 24,576-byte `memset` over six
  // contiguous members.  A round that named the six turned that clear into
  // six, and six declarations and six `memset`s were the two longest runs
  // `dupblock.py` had left in this file.  The names are cursors into the
  // block, the shape `choose_plane_coding` already uses for its eight.
  alignas(16) int32_t hists[6*1024];
  const HistRows hr = hist_rows(hists);
  int32_t *const hist_x = hr.r0;      // dx, the first reference plane
  int32_t *const hist_y = hr.r1;      // dy, the second
  int32_t *const hist_yx = hr.r2;     // dy - dx
  int32_t *const hist_zx = hr.r3;     // dz - dx
  int32_t *const hist_zy = hr.r4;     // dz - dy
  int32_t *const hist_zp = hr.r5;     // dz - (dx + dy)/2
  memset(hists, 0, sizeof hists);

  const int32_t planes = plane_count;
  // `*(const uint16_t*)&img->stride` -- the low half of a `uint32_t`, which
  // is a truncation on a little-endian machine and a different field on any
  // other.  Cast the value.
  //
  // `uint32_t` because that is the type the first walk's offsets were computed
  // in: the original stashed this in the four bytes of `buf_1` and read it
  // back through a `uint32_t *`.  The stash, the reload and the store back are
  // gone; the type they gave the value stays, because every `d - row_b` below
  // was unsigned.
  const uint32_t row_b = img->stride;
  // The two other planes of the pixel, as offsets from this one.  `cand` is
  // 0, 1 or 2, so the pair is (1, 2), (1, -1) or (-2, -1).
  // The two other planes, as offsets from this one.  Not `const`: the swap
  // below exchanges them when the second turns out to be the better first
  // reference, and both names mean the same thing throughout -- "the offset of
  // the reference in slot N".  A third local held the first of them across that
  // swap and `tools/uncopy.py` reported it for what it was, a copy: `d1` is not
  // read again after the swap, so the two were never live at once.
  int32_t d1 = (cand+1)%3-cand;
  int32_t d2 = (cand+2)%3-cand;
  uint8_t* img_end = &img->pixels[img->data_size];
  uint8_t* base = img->pixels;
  double syz = 0.0, syy = 0.0, sxz = 0.0, sxy = 0.0, sxx = 0.0;

  pd[cand].nrefs = 2;
  pd[2].src_plane = (uint8_t)cand;
  uint8_t* p = &base[cand+row_b+planes];
  if( p<img_end ) {
    // Eight neighbour offsets, constant for the whole walk.  The decompiler
    // kept them in frame slots and read them back through `frame.` in the hot
    // loop, which is what a register spill looks like once it has a struct
    // around it; as `const` locals they say what they are -- the north, west and
    // north-west of the two reference planes, and the step to the next pixel.
    const int32_t a_n = d1-row_b,           a_w = d1-planes,     a_nw = d1-row_b-planes;
    const int32_t b_n = d2-row_b,           b_w = d2-planes,     b_nw = d2-row_b-planes;
    const int32_t step = row_b+planes;
    do {
      int32_t dx = p[a_nw]+p[d1]-(p[a_n]+p[a_w]);
      ++hist_x[dx+512];
      int32_t dy = p[b_nw]+p[d2]-(p[b_n]+p[b_w]);
      sxx = sxx+(double)dx*(double)dx;
      ++hist_y[dy+512];
      syy = syy+(double)dy*(double)dy;
      sxy = sxy+(double)dx*(double)dy;
      ++hist_yx[((uint16_t)dy-(uint16_t)dx-512)&0x3FF];
      int32_t diag = p[-step]+*p;
      int32_t west = p[-planes];
      uint8_t *q = p-row_b;
      p += planes;
      int32_t dz = diag-(*q+west);
      sxz = sxz+(double)dx*(double)dz;
      ++hist_zx[((uint16_t)dz-(uint16_t)dx-512)&0x3FF];
      syz = syz+(double)dy*(double)dz;
      ++hist_zy[((uint16_t)dz-(uint16_t)dy-512)&0x3FF];
      int32_t bin = ((uint16_t)dz-(uint16_t)((uint32_t)(((dx+dy)<<6)+40)>>7)-512)&0x3FF;
      ++hist_zp[bin];
    } while( p<img_end );
  }
  // The least-squares solution for `dz ~ wa*dx + wb*dy`, in 1/128ths, clamped
  // to what the descriptor's byte can carry.  The 0.1 keeps the determinant
  // off zero for an image with no gradient at all.
  double inv = 128.0/(0.1-sxy*sxy+sxx*syy);
  double w1f = (syy*sxz-sxy*syz)*inv;
  double w2f = inv*(sxx*syz-sxy*sxz);
  // Not `const`: the swap forty lines down exchanges them when the two
  // reference planes come out in the other order.
  int32_t wa = clamp_weight((int32_t)w1f);
  int32_t wb = clamp_weight((int32_t)w2f);

  int32_t rec = 4*cand;
  costs[rec] = weight_pair_cost(img, &base[cand], d1, d2, wa, wb);
  costs[rec+1] = estimate_cost(hist_zx, 1024);
  costs[rec+2] = estimate_cost(hist_zy, 1024);
  costs[rec+3] = estimate_cost(hist_zp, 1024);
  // Which of the two reference planes to predict from.  `s1` and `s2` are the
  // two orders' costs; taking the second swaps everything that names an order
  // -- the two planes, the two weights, and the two cost slots.
  int32_t cost = estimate_cost(hist_x, 1024);
  int32_t cost_y = estimate_cost(hist_y, 1024);
  int32_t cost_yx = estimate_cost(hist_yx, 1024);
  int32_t c2 = cost_yx;
  int32_t lo1 = c2;
  if( cost<c2 )
    lo1 = cost;
  if( cost_y<c2 )
    c2 = cost_y;
  int32_t s1 = cost_y+lo1;
  int32_t s2 = cost+c2;
  int32_t best = s2;
  if( s1<s2 ) {
    // The two reference planes come out the other way round, so everything
    // that names one of them exchanges: the plane, its cost, and its weight.
    best = s1;
    cost = cost_y;
    swap32(d1, d2);
    swap32(costs[rec+1], costs[rec+2]);
    swap32(wa, wb);
  }
  pd[cand].weight0 = wa;
  pd[cand].weight1 = wb;
  // The plane order, as the permutation and its inverse -- `src_plane[rank]`
  // and `nrefs[plane]` -- which is the pair `expand_image` builds from the
  // wire.  `d1` and `d2` are offsets from this plane, so both indices are
  // 0, 1 or 2 whichever candidate this is.
  int32_t idx1 = cand+d1;
  int32_t idx2 = cand+d2;
  pd[idx1].nrefs = 0;
  pd[0].src_plane = (uint8_t)idx1;
  pd[idx2].nrefs = 1;
  pd[1].src_plane = (uint8_t)idx2;
  // A `bool deep = 0;` guarded this, and nothing assigned it -- so `!deep` was
  // a constant the compiler folded and a condition a reader had to check.
  if( img->data_size>0x1000000u )
    return cost+cost_yx+costs[rec];
  uint32_t lo2 = costs[rec];
  uint32_t lo3 = costs[rec+2];
  lo2 = umin32(lo2, costs[rec+1]);
  lo3 = umin32(lo3, costs[rec+3]);
  lo3 = umin32(lo3, lo2);
  return best+lo3;
}

// plane_choose.inc -- decide how each plane of an image is to be coded.

// The 256-wide window of a histogram with the largest total, scanned from
// `first` and answering where that window starts -- or `miss` when nothing
// after the first window beats it.  That start, plus one, is the plane's DC
// offset.
//
// Three copies, and the differences between them are three constants: two scan
// a whole 1024-entry row from offset 4 and default to -1, and the third scans
// the first half of a row from offset 0 and defaults to 255.
//
// Two of the three then narrowed the answer through an `int8_t` before adding
// one and the third did not, which cannot show: `dc` is a `uint8_t`, and
// `(int8_t)w + 1` and `w + 1` agree modulo 256.
static int32_t widest_window(const int32_t* hist, int32_t first, int32_t end,
                             int32_t miss) {
  int32_t sum = 0;
  for( int32_t i = 0; i<256; ++i )
    sum += hist[first+i];
  int32_t best = sum, at = miss;
  for( int32_t w = first+256; w<end; ++w ) {
    sum += hist[w]-hist[w-256];
    if( sum>=best ) {
      at = w;
      best = sum;
    }
  }
  return at;
}

// The two-weight search for one plane pair: `w` is the best pair found so far
// and `cost` what a full pass over the image says it costs.
//
// The two are the descriptor's `weight0` and `weight1`, which is what they are
// on the wire.  They were `w4` and `w8` here, after the stack slots the
// recovery had them in, and that made the axis part of the name rather than an
// index -- which is why everything below was written twice.
struct WeightSearch {
  const BmfImage* img;
  const uint8_t* plane0;
  int32_t plane_a, plane_b;
  int32_t w[2];
  uint32_t cost;

  // A trial replaces one axis with `cand`, leaving the other where it stands,
  // and keeps the replacement only when it is cheaper.  It answers that axis's
  // bound, recentred `step` away from whatever is now current; `step` is
  // negative on the descending half.
  //
  // Four arms wrote this out.  Each spelled the incumbent into a name of its
  // own -- `wt4_best`, `wt8_best`, `wt4_best_dn`, `wt8_best_dn` -- assigned it
  // back one line later, and recomputed the bound from that name rather than
  // from the weight, so the four did not read as one thing.  A round after
  // that made them two methods, one per axis, which is the same six lines
  // twice.
  int32_t trial(int32_t axis, int32_t cand, int32_t step) {
    int32_t pair[2] = { w[0], w[1] };
    pair[axis] = cand;
    const uint32_t c = weight_pair_cost(img, plane0, plane_a, plane_b,
                                        pair[0], pair[1]);
    if( c<cost ) {
      cost = c;
      w[axis] = cand;
    }
    return w[axis]+step;
  }

  // One direction of the descent.  Both axes walk away from the current best
  // by `dir`, each until it has gone `step` past the last position that
  // improved; a trial that wins pushes its axis's bound out again, so an axis
  // keeps going as long as it keeps improving.  Returns when neither has room.
  //
  // This was written out twice, once per direction, with the second copy
  // nested inside the first's loop and leaving it by a `goto` to a label past
  // the bottom of both.  The two differ in the sign of the walk, the sense of
  // the two comparisons, and which end of [-64, 191] the weight is held
  // against -- all three of which are `dir`.  What was left after that was the
  // per-axis half written twice, which is the `for` below.
  void descend(int32_t step, int32_t dir) {
    int32_t at[2] = { w[0]+dir, w[1]+dir };
    int32_t end[2] = { w[0]+dir*step, w[1]+dir*step };
    // The `return` at the top of a `while( 1 )` is the loop's condition.
    // `MINIMAL-SYNTAX.md` measured this class at 32 sites and none convertible
    // -- "nineteen have it in the middle, twelve have no top-level break at
    // all" -- and the measurement was of a body this one did not have yet: the
    // two directions were written out twice with a `goto` past both, and the
    // top-level test only became a top-level test when they merged.
    //
    // `(dir<0 ? at[k]>=-64 : at[k]<192)` is **not** the `clamp_weight` bound
    // wearing a ternary, and Stage 2 Section 1.6 is right to call it out: which
    // end is tested depends on `dir`, a runtime flag, so it is two predicates
    // over one range rather than a saturation of it.  The two constants are the
    // same `kWeightMin`/`kWeightMax` pair -- one past the top, because this is
    // the *next* value the search would try -- and that shared origin is what
    // makes the rewrite look available when it is not.
    while( dir*at[0]<dir*end[0]||dir*at[1]<dir*end[1] ) {
      for( int32_t k = 0; k<2; ++k )
        if( dir*at[k]<dir*end[k]&&(dir<0 ? at[k]>=kWeightMin : at[k]<kWeightMax+1) )
          end[k] = trial(k, at[k], dir*step);
      at[0] += dir;
      at[1] += dir;
    }
  }
};

// The three weights `choose_alpha_plane` fits and then may throw away, one per
// colour plane.  A named triple because the fit and the choice are two halves of
// one job and this is what crosses between them.
struct AlphaWeights {
  int32_t a, b, c;
};

// Three weights, one per colour plane, fitted to the alpha plane by least
// squares over the image's gradients.
//
// `dv0`, `dv1` and `dv2` are the three colour planes' horizontal-minus-vertical
// gradient at one pixel and `dv3` is the alpha plane's.  The nine sums are the
// covariances of that four-vector -- `S<a><b>` is the sum over pixels of
// `d<a>*d<b>`, with `w` for the alpha term -- and the 3x3 system
// `S * weights = Sw` is solved by cofactors at the end.
//
// The original kept the nine in six SSE registers and spilled them to the
// stack, which arrived as `int32_t x0[4]` .. `x5[4]` read through forty
// `*(double*)` casts, plus three more slots borrowed from the frame's unions --
// `q0` and `q1` overlaid `row_stride`, `plane_b`, `plane_a` and `nplanes_s`,
// and were safe only because those four are last read twenty lines above.  Nine
// named doubles say the same arithmetic and take the round trip out, and the
// two unions that lent the slots had no reader left.
static AlphaWeights fit_alpha_weights(const uint8_t* px, const uint8_t* pp,
                                      uint32_t uu) {
  double Sxx = 0.0, Sxy = 0.0, Sxz = 0.0;
  double Syy = 0.0, Syz = 0.0, Szz = 0.0;
  double Sxw = 0.0, Syw = 0.0, Szw = 0.0;
  for( uint32_t i4 = 0; i4<uu; ++i4 ) {
    const double dv0 = (double)(px[4*i4]+pp[4*i4+4]-(px[4*i4+4]+pp[4*i4]));
    const double dv1 = (double)(px[4*i4+1]+pp[4*i4+5]-(px[4*i4+5]+pp[4*i4+1]));
    const double dv2 = (double)(px[4*i4+2]+pp[4*i4+6]-(px[4*i4+6]+pp[4*i4+2]));
    const int32_t dv3 = px[4*i4+3]+pp[4*i4+7]-(px[4*i4+7]+pp[4*i4+3]);
    Sxx += dv0*dv0;
    Sxy += dv0*dv1;
    Sxz += dv0*dv2;
    Syy += dv1*dv1;
    Syz += dv1*dv2;
    Szz += dv2*dv2;
    Sxw += dv0*(double)dv3;
    Syw += dv1*(double)dv3;
    Szw += dv2*(double)dv3;
  }
  // The three cofactors of the first row of `S`, and one over its
  // determinant -- scaled by 128 because the weights are eighths of a
  // 128th and clamped to [-64, 191] below.  The `+0.1` keeps a singular
  // system (a flat image, every gradient zero) from dividing by zero.
  double d1 = Sxx*Szz-Sxz*Sxz;
  double d2 = 0.0-Sxx*Syz+Sxz*Sxy;
  double d3 = Sxz*Syz-Sxy*Szz;
  double inv = 128.0/(Syy*d1+Syz*d2+Sxy*d3+0.1);
  const int32_t wa = clamp_weight((int32_t)(((Sxz*Syz-Sxy*Szz)*Syw+(0.0-Sxz*Syy+Sxy*Syz)*Szw+(Szz*Syy-Syz*Syz)*Sxw)*inv));
  const int32_t wb = clamp_weight((int32_t)((d1*Syw+d2*Szw+d3*Sxw)*inv));
  const int32_t wc = clamp_weight((int32_t)(inv*((Sxx*Szw-Sxz*Sxw)*Syy+(0.0-Sxx*Syw+Sxw*Sxy)*Syz+(Sxz*Syw-Sxy*Szw)*Sxy)));
  return { wa, wb, wc };
}

// The alpha plane's predictor, chosen among the same four candidates the colour
// planes were and by the same measure: histogram each candidate's residual over
// the image, cost the histogram, keep the cheapest.  Runs only for a four-plane
// image, writes only `plane_desc[3]`, and is the last thing `choose_plane_coding`
// does -- a stage of that function rather than a step in it.
//
// It borrows the caller's eight histogram rows instead of declaring its own.
// They are 32KB of stack that is already there and about to go out of scope, and
// the `widest_window` at the end indexes them by row exactly as the colour
// search does -- rows 4..7 rather than 0..3, which is the `4 +` in that call.
// Taken by reference so `sizeof hists` still means the whole block.
//
// **What the gate sees of this.**  Five of the seventeen corpus images reach
// here -- `t32`, `med32`, `x_ep`, `xform1` and `xform2`, the four-plane ones --
// and making the call conditional on `0` fails 12 of 111 checks, so the stage is
// covered in both directions.  Perturbing the *fitted* weight alone fails only
// one, `xform2`: the other four either pick a candidate that overwrites all
// three weights with a constant or already fit to zero, so the fit is real work
// whose result three of the four candidates discard.  That is a fact about the
// algorithm and not a gap in the corpus, and it is written down because the
// one-check number looks like a gap and is the first thing a probe reports.
static void choose_alpha_plane(BmfImage* img, int32_t (&hists)[8*1024],
                               const uint8_t* data_end, int32_t row_stride) {
  // Rows by number rather than by name here, which is what the original spelled
  // in bytes and what the `widest_window` at the end needs anyway: row 0 is the
  // linear predictor's residual, row 1 the first colour plane's, row 2 the
  // second's, row 3 the third's, and rows 4..7 the four candidates again for
  // the window scan.  `choose_plane_coding` names its four because it reads
  // them fifteen lines apart; these are all inside one loop.
  const HistRows hr = hist_rows(hists);
  memset(hists, 0, sizeof hists);
  const uint8_t*const px = img->pixels;
  const uint8_t*const pp = &px[row_stride];
  // Both loops below were guarded by `&px[row_stride + 4] < data_end` and `uu`
  // was computed inside the first guard, so it was never read undefined -- but
  // only by an argument that spans forty lines and two loops.  Zero says the
  // same thing in the value, and the guard becomes the count it always was.
  const uint32_t uu = &px[row_stride+4]<data_end ? (uint32_t)((data_end-1-pp)/4) : 0;
  const AlphaWeights w = fit_alpha_weights(px, pp, uu);
  int32_t wa_slot = w.a, wb = w.b, wc = w.c;
  // `x0[0..1]` used to be written here and read back forty lines
  // below -- one 64-bit store, which the decompiler wrote as a pair
  // because MSVC had both halves in registers, and `__PAIR64__` is its
  // name for that.  The two slots are `wb` and `wc` and nothing
  // between the store and the reload writes either.  So the spill is
  // the two names.
  //
  // The loop below spilled three more registers to that same area --
  // `quad`, `g0` and `g1`, each already a local one line up -- and
  // those stores are gone with it.
  // The same bound as the accumulation loop above, and the same guard.
  for( uint32_t quad = 0; quad<uu; ++quad ) {
    int32_t nx0 = px[4*quad+4];
    int32_t dg0 = px[4*quad]+pp[4*quad+4];
    int32_t dn0 = pp[4*quad];
    int32_t ad0 = nx0+dn0;
    int32_t dnx1 = pp[4*quad+5];
    const int32_t g0 = dg0-ad0;
    int32_t dn1 = pp[4*quad+1];
    int32_t nx2 = px[4*quad+6];
    const int32_t g1 = px[4*quad+1]+dnx1-(px[4*quad+5]+dn1);
    int32_t dnx2 = pp[4*quad+6];
    int32_t g2 = px[4*quad+2]+dnx2-(nx2+pp[4*quad+2]);
    uint16_t g1w = (uint16_t)(px[4*quad+3]+pp[4*quad+7]-pp[4*quad+3]-px[4*quad+7]);
    int16_t g1_lo = (int16_t)g1;
    g1w = g1w-512;
    int32_t pa = g1*wb+g0*wa_slot;
    int32_t pb = g2*wc;
    ++hr.r1[(g1w-(int16_t)g0)&0x3FF];
    int32_t bin_lin = (g1w-(uint16_t)((uint32_t)(pa+pb+63)>>7))&0x3FF;
    ++hr.r0[bin_lin];
    ++hr.r2[(g1w-g1_lo)&0x3FF];
    g1w = g1w-g2;
    ++hr.r3[g1w&0x3FF];
    const int32_t alpha = pp[4*quad+7]+256;
    int32_t bin_lin2 = ((uint16_t)alpha-(uint16_t)((wb*pp[4*quad+5]+wa_slot*pp[4*quad+4]+wc*(uint32_t)pp[4*quad+6]+63)>>7)+256)&0x3FF;
    ++hr.r3[bin_lin2+1024];
    int32_t r0 = alpha-pp[4*quad+4];
    ++hr.r3[r0+2048];
    int32_t r1 = alpha-pp[4*quad+5];
    ++hr.r3[r1+3072];
    int32_t r2 = alpha-pp[4*quad+6];
    ++hr.r3[r2+4096];
  }
  uint32_t cost_lin = estimate_cost(hr.r0, 1024);
  uint32_t best4 = (cost_lin>>7)+cost_lin;
  const uint32_t cost_c0 = estimate_cost(hr.r1, 1024);
  // The comparison was written twice, once into `pick0` and once as the `if`,
  // and `wa_slot` was copied into `wa_pick` for four lines and copied back --
  // MSVC keeping the register live across the call below.  `uncopy.py` cannot
  // see either: its rule is a local that is *only* a copy, and this one is
  // assigned in between.
  const bool pick0 = cost_c0<best4;
  if( pick0 ) {
    best4 = cost_c0;
    wa_slot = 128;
    wc = 0;
    wb = 0;
  }
  // `x0[0] = pick0;` before this call and `pred4 = x0[0];` after it was
  // MSVC spilling the register across the call, and `estimate_cost`
  // cannot reach a local of this body.  Same shape twice more below.
  const uint32_t cost_c1 = estimate_cost(hr.r2, 1024);
  int32_t pred4 = pick0;
  if( cost_c1<best4 ) {
    best4 = cost_c1;
    pred4 = 2;
    wb = 128;
    wc = 0;
    wa_slot = 0;
  }
  const uint32_t cost_c2 = estimate_cost(hr.r3, 1024);
  // `pred4b` was a second name for `pred4`, diverging only in the arm below --
  // the same spill across the same call, one candidate later.
  if( cost_c2<best4 ) {
    pred4 = 3;
    wc = 128;
    wb = 0;
    wa_slot = 0;
  }
  plane_desc[3].weight0 = wa_slot;
  plane_desc[3].weight1 = wb;
  plane_desc[3].weight2 = wc;
  plane_desc[3].src_plane = 3;
  plane_desc[3].nrefs = 3;
  // Rows 4..7, by the same window and the same layout-read constant
  // as the search above.
  plane_desc[3].dc = widest_window(hists+1024*(4+pred4), 4, 1024, -1)+1;
}

int32_t choose_plane_coding(BmfImage* img) {
  // Eight 1024-entry histograms in one block, because both searches below
  // pick a row *by index*.  The decompilation had it as `uint8_t buf[32768]`
  // with three of its rows named and the last five under one name carrying a
  // 5120-entry array, and the two searches reached their rows as
  // `&buf[4096*pred]` and `&hist_c[1024*pred4b+1024]` -- rows 0..3 and rows
  // 4..7 of this, spelled in bytes.  Every write went through
  // `*(uint32_t *)&buf[4*bin]`, the byte array being `estimate_cost`'s old
  // parameter type reaching back into the declaration.
  //
  // The four names below are cursors into the one block, which is what that
  // index arithmetic says they are.
  alignas(16) int32_t hists[8*1024];
  const HistRows hr = hist_rows(hists);
  int32_t *const hist_flat = hr.r0, *const hist_a = hr.r1;   // rows 0 and 1
  int32_t *const hist_b = hr.r2, *const hist_c = hr.r3;      // row 2, and row 3 with 4..7 after it
  // Four 512-entry histograms of `bin` values, one per arm of the weight
  // search.  The first was the frame's `buf_1`, a `uint8_t[2048]` for the same
  // reason, with the first four bytes doubling as a stash for `wt8_dn_end`
  // across a loop that does not touch it.
  // The three candidates' costs and their descriptors, as the two tables they
  // are.  This was one `alignas(16) uint8_t scratch[256]` with an
  // `int32_t (&)[4]` and an `int32_t (&)[16]` bound onto it at offsets a probe
  // had measured, because the body reaches every row of both by index and the
  // decompilation had given each row a name -- `acc0`, `acc1`, `d4`, `tbl16`,
  // `tbl64a`, `tbl64b` -- of which two named a region nothing reads through.
  //
  // `cost_candidate` fills one row of each: four costs, and four `PlaneDesc`
  // that become the image's plane order if that candidate wins.  What made the
  // one buffer necessary was that every access spelled its own offset --
  // `acc0[4*xform+2]`, `&tbl16[16*cand]`, `*(uint32_t *)&scratch[16*xform+20]`
  // -- and those are `[xform]` and `[cand]` on a two-dimensional table.
  //
  // Eight bytes of the original block sit before the costs and eight between
  // them and the descriptors; nothing reads either, which is why these can be
  // two arrays.  A round that missed that put `tbl16` eight bytes early over
  // `d4`, and for `xform != 0` the plane order came from whatever followed it
  // -- `testfiles/xform1.bmp` is the image that picks a non-zero candidate and
  // is in the corpus because of it.
  uint32_t cand_cost[3][4];
  PlaneDesc cand_desc[3][4];
  uint32_t next_plane, row;
  int32_t result, xform, wt8, wt4, pred;
  uint32_t best_cost, best;
  int32_t n_planes = plane_count;
  int32_t data_size = img->data_size;
  alphabet_reduced = 1;
  int32_t row_stride = img->stride;
  const uint8_t* data_end = &img->pixels[data_size];
  memset(hists, 0, sizeof hists);
  // The descriptors only; the costs are written before they are read.  The
  // loop this replaces started at byte 192 of the block and stopped before
  // reaching the cost table.
  memset(cand_desc, 0, sizeof cand_desc);
  if( n_planes>0 ) {
    if( n_planes/2 ) {
      // `2*pair+++1` is the post-increment-inside-an-expression Phase 2 asks
      // to be pulled out: it reads as `2*pair + 1` and is `2*(pair++) + 1`,
      // which is the same value only because the increment is the loop's own.
      // `pair` outlives the loop -- the plane after the pairs is `2*pair + 1`.
      uint32_t pair = 0;
      for( ; pair<(uint32_t)(n_planes/2); ++pair ) {
        const uint8_t pl_even = 2*pair, pl_odd = 2*pair+1;
        row = 2*pair;
        plane_desc[row].src_plane = pl_even;
        plane_desc[row].nrefs = pl_even;
        plane_desc[row+1].src_plane = pl_odd;
        plane_desc[row+1].nrefs = pl_odd;
      }
      next_plane = 2*pair+1;
    } else {
      next_plane = 1;
    }
    result = next_plane-1;
    // `next_plane` is unsigned and `result` is not, so naming the value here
    // is what makes the conversion visible; it was always happening.
    if( (uint32_t)n_planes>(uint32_t)result ) {
      plane_desc[next_plane-1].src_plane = result;
      plane_desc[next_plane-1].nrefs = result;
    }
    if( n_planes>=3 ) {
      // The three candidate transforms, costed, cheapest kept.  The
      // decompilation wrote the three calls out, each with the row of the
      // descriptor table it fills spelled as a byte offset; they are one loop
      // over `cand_desc[cand]`.  The cost argument is the *base* of the cost
      // table in all three -- `cost_candidate` indexes it by `4*cand` itself.
      //
      // Ties go to the lower index, which is what `cost1 >= cost0` keeping
      // candidate 0 did.  The original compared the first pair signed and the
      // third candidate unsigned -- `(uint32_t)f(2) < cost1` -- which are the
      // same relation for costs that are estimated bit counts and so never
      // negative.  One relation here.
      xform = 0;
      uint32_t cheapest = cost_candidate(img, 0, cand_desc[0], cand_cost[0]);
      for( int32_t cand = 1; cand<3; ++cand ) {
        const uint32_t c = cost_candidate(img, cand, cand_desc[cand],
                                          cand_cost[0]);
        if( c<cheapest ) {
          cheapest = c;
          xform = cand;
        }
      }
      // The winning candidate's four descriptors, copied in.  This was eight
      // `uint64_t` stores through a `(uint8_t*)&plane_desc[0]+off` accessor,
      // two turns of a loop counting down by eight: offsets 56, 48, 40, 32
      // then 24, 16, 8, 0.  Sixty-four bytes, which is one row of the table
      // and `4*sizeof(PlaneDesc)`, so it is one copy.
      memcpy(plane_desc, cand_desc[xform], sizeof cand_desc[xform]);
      best_cost = cand_cost[xform][0];
      int32_t plane_a = plane_desc[0].src_plane-xform;
      wt8 = plane_desc[xform].weight1;
      int32_t plane_b = plane_desc[1].src_plane-xform;
      wt4 = plane_desc[xform].weight0;
      // Coordinate descent on the two weights, four trials to a turn, each a
      // full pass over the image.  Both axes walk down by one until neither
      // can move four steps past its best, then both walk up the same way; a
      // trial that wins pushes its axis's bound out again, so an axis keeps
      // going as long as it keeps improving.  The eleven `sN` and six `pN`
      // slots the descending half ran on were each a copy of a local that
      // never changes under them.
      {
        const uint8_t *plane0 = &img->pixels[xform];
        WeightSearch search = { img, plane0, plane_a, plane_b, { wt4, wt8 },
                                best_cost };
        int32_t wt_step = 4;
        search.descend(wt_step, -1);
        search.descend(wt_step, +1);
        wt8 = search.w[1];
        wt4 = search.w[0];
        best_cost = search.cost;
      }
      uint8_t *px = &img->pixels[row_stride+n_planes+xform];
      if( px<data_end ) {
        // `wt8` and `wt4` were copied into two more locals for this walk and
        // copied straight back after it, with nothing between touching either
        // -- MSVC spilling the two registers the loop wanted.  The copy of
        // `wt8` was unsigned, which made `c2*wt_slot` an unsigned multiply;
        // both weights are small enough that the product is the same either
        // way, and the sum is cast to `uint32_t` before the shift regardless.
        do {
          int32_t c2 = px[plane_b];
          int32_t c2w = c2*wt8;
          int32_t c1 = px[plane_a];
          int32_t c1w = c1*wt4;
          ++hist_c[c2-c1+1280];
          int32_t c0 = *px+512;
          px += n_planes;
          int32_t bin0 = ((uint16_t)c0-(uint16_t)((uint32_t)(c2w+c1w+40)>>7))&0x3FF;
          ++hist_flat[bin0];
          ++hist_a[c0-c1];
          ++hist_b[c0-c2];
          ++hist_c[(c0-((uint32_t)(((c1+c2)<<6)+40)>>7))];
        } while( px<data_end );
      }
      const uint32_t slack = umin32(best_cost>>7, kSlackMax);
      best = slack+best_cost;
      // The winning candidate's other three costs, against the fitted pair:
      // flat, plane-b only, and the two averaged.  Each was its own byte
      // offset into the block and they are one row of four.
      uint32_t cost_flat = cand_cost[xform][1];
      bool cheaper = cost_flat<best;
      if( cost_flat<best ) {
        best = cost_flat;
        wt4 = 128;
        wt8 = 0;
      }
      pred = cheaper;
      if( cand_cost[xform][2]<best ) {
        best = cand_cost[xform][2];
        pred = 2;
        wt4 = 0;
        wt8 = 128;
      }
      bool keep3 = best<=cand_cost[xform][3];
      if( best>cand_cost[xform][3] )
        pred = 3;
      if( !keep3 ) {
        wt4 = 64;
        wt8 = 64;
      }
      plane_desc[xform].weight0 = wt4;
      plane_desc[xform].weight1 = wt8;
      // The widest 256-entry window of one histogram row, and `pos` is its
      // right edge -- truncated to `int8_t`, which is what makes `dc` a byte.
      //
      // `win` started at `(uintptr_t)hist & 0xF`, the low four bits of a stack
      // address: the frame was `alignas(16)` and `buf` sat four bytes into it
      // behind a `_pad0[4]`, so the answer was always 4 and the window always
      // began at entry 4 rather than 0.  Reading the compiler's stack layout
      // as an array index is not something any gate here can see -- all
      // nineteen images produce byte-identical streams at 0 and at 4, checked
      // -- so the measured value is what stays, with the 4 written down.
      plane_desc[xform].dc = widest_window(hists+1024*pred, 4, 1024, -1)+1;
      // The same window over row 4, which is `hist_c[1024..2047]`.
      result = widest_window(hist_c+1024, 0, 512, 255)+1;
      plane_desc[plane_b+xform].dc = result;
      if( n_planes>=4 ) {
        choose_alpha_plane(img, hists, data_end, row_stride);
      }
    }
  }
  return result;
}

// filter_search.inc -- search the filters, which is what -Q9 spends its time on.

// The six plane descriptors the per-plane search probes.  `probe_plane` is
// called with each in turn and the same literal is also the answer stored back
// into `best_flags`, so every one of these numbers appeared twice with nothing
// saying what it selected.
//
// Each probe pairs its predictor with `desc_alt_model`, which is why 5 and 6
// rather than 1 and 2.  These are not the only descriptors that reach the wire:
// the three whole-image trials below start from what the per-plane search chose
// and edit it -- forcing `try_p1` or `try_p2` across all planes, adding
// `desc_has_refs` where `nrefs` is non-zero, or clearing `desc_alt_model` --
// and keep the result if it codes smaller.  Clearing the alt bit is what puts
// a bare 1 or 9 in a descriptor.
enum : int32_t {
  try_mode0    = pred_mode0,                                 //  0
  try_p1       = pred_p1|desc_alt_model,                     //  5
  try_p2       = pred_p2|desc_alt_model,                     //  6
  try_refs     = desc_has_refs,                              //  8
  try_refs_p1  = desc_has_refs|pred_p1|desc_alt_model,       // 13
  try_refs_p2  = desc_has_refs|pred_p2|desc_alt_model,       // 14
};

// The four descriptors, kept and put back.  Every whole-image trial below
// edits `plane_desc` in place, measures the result, and either keeps it or
// undoes it -- ten copies of these three lines between them, each with its own
// spelling of the loop index.
static void save_descriptors(PlaneDesc* saved) {
  for( int32_t k = 0; k<4; ++k )
    saved[k] = plane_desc[k];
}

static void restore_descriptors(const PlaneDesc* saved) {
  for( int32_t k = 0; k<4; ++k )
    plane_desc[k] = saved[k];
}

// Ask every plane for one of the two predictors, keeping nothing of what it was
// asked for before but whether it may use its references.
//
// Four of the five whole-image trials edit every descriptor the same way, and
// all four were written out in the decompiler's shape: `plane_desc[k++].flags`
// with the index saved into a second name for the store, under an
// `if( plane_count > 0 )` guard a `for` does not need.
static void offer_to_all(int32_t want) {
  for( int32_t k = 0; k<plane_count; ++k )
    plane_desc[k].flags = (plane_desc[k].flags&desc_has_refs)|want;
}

// The alternate model taken away from every plane, leaving what else its
// descriptor says.
static void drop_alt_model_from_all() {
  for( int32_t k = 0; k<plane_count; ++k )
    plane_desc[k].flags &= ~desc_alt_model;
}

// Every descriptor cleared.
static void clear_flags_on_all() {
  for( int32_t k = 0; k<plane_count; ++k )
    plane_desc[k].flags = 0;
}

// Every descriptor back to the identity order: plane k is plane k, with no
// transform and no references.
static void reset_descriptors() {
  for( int32_t k = 0; k<plane_count; ++k ) {
    plane_desc[k].flags = 0;
    plane_desc[k].src_plane = k;
    plane_desc[k].nrefs = k;
  }
}

// Let every plane that has references use them.
static void allow_refs_where_present() {
  for( int32_t k = 0; k<plane_count; ++k )
    plane_desc[k].flags |= plane_desc[k].nrefs!=0 ? desc_has_refs : 0;
}

// Transform the planes the way the descriptors currently say, and answer what
// that cost in bits.  Written out five times, and the order is the whole of
// it: the count has to be taken before the packer is flushed, and the packer
// has to be reset before the next trial.  Four of the five spelled the answer
// into a differently-named local, so the five did not look like one thing.
//
// Four callers then wrote `deep2 = bits <= best; if( deep2 )` -- one name,
// four unrelated one-shot conditions, none of them read again after the `if`
// that follows.  They are the conditions now.
static int32_t transform_cost(BmfImage* tile_img) {
  transform_planes(tile_img);
  const int32_t bits = 8*(stream.cur-stream.buf);
  packer_flush();
  packer_reset();
  return bits;
}

// What the per-plane search settles on, beyond the flags it writes into
// `plane_desc` as it goes.
//
// `n_p1` and `n_p2` are counts and not bit totals, which their old names --
// `bits_total` and `n_hard` -- did not say.  `bits_total` accumulated `pred`,
// and `pred` at that point is `pred_p1` (1) or `pred_mode0` (0), so it counted
// the planes that chose the first predictor; every reader of it asks whether it
// is nonzero.
struct PlaneSearch {
  int32_t bits;    // what the winning descriptors cost, over all planes
  int32_t n_p1;    // planes that chose predictor 1
  int32_t n_p2;    // planes that chose predictor 2
  int32_t n_refs;  // planes that took a reference descriptor
};

// One pass over the planes: try each plane's candidates against the trial tile,
// keep the cheapest, and record what was chosen.  Ninety lines out of
// `search_filter`, and closed -- `probe_plane`, `probe_keep`, `best_cost`,
// `best_flags` and `won` are used here and nowhere else, so they come along and
// `search_filter` is left reading as its three stages: search each plane, try
// the transpose, try four whole-image variants.
//
// The candidate ladder is two independent conditions the recovery had nested,
// jumping *into* the inner arm from the outer `else` with a second label under
// both to rejoin: the second predictor is only worth a trial when the first came
// close to the incumbent, and the reference descriptors are tried for every
// plane but the first.
static PlaneSearch search_planes(BmfImage* tile_img, uint8_t* tile_buf,
                                 uint32_t* plane_cost) {
  int32_t best_cost = 0, best_flags = 0;
  // Encode one plane of the trial tile under `flags` and return what it cost,
  // in bits.  Seven sites wrote this out: set the descriptor, call the model,
  // measure the bytes written, flush the packer's last partial word.  Four take
  // it as written; the other three differ in an argument or in what they do
  // between the measurement and the flush.
  //
  // The measurement is real coded bytes and not an estimate, which is what
  // makes comparing candidates worth anything -- and is also the whole cost of
  // `-Q9`.
  auto probe_plane = [&](int32_t pl, int32_t flags) {
    plane_desc[pl].flags = flags;
    model_planes(tile_img, tile_buf, pl);
    int32_t cost = 8*(stream.cur-stream.buf);
    packer_flush();
    return cost;
  };
  // Cost one candidate for this plane and keep it if it is cheaper than the
  // best so far.  Five sites wrote this out, each spelling the incumbent flags
  // into a private name (`f5`, `f6`, `f8`, `f13`, `f14`) that the `if` either
  // overwrote or handed straight back -- five names for one variable.
  //
  // `won` is separate from the returned cost because a tie leaves `best_cost`
  // equal to the candidate's cost without the candidate being taken, so the
  // one site that needs to know cannot read it back off `best_cost`.
  bool won = false;
  auto probe_keep = [&](int32_t pl, int32_t flags) {
    const int32_t cost = probe_plane(pl, flags);
    packer_reset();
    won = cost<best_cost;
    if( won ) {
      best_cost = cost;
      best_flags = flags;
    }
    return cost;
  };
  PlaneSearch out = { 0, 0, 0, 0 };
  // `plane_count` is set once at the top of `compress_image` and once at the top
  // of `expand_image`, and neither is on this path, so the loop's bound cannot
  // move under it.  The original read it into `nplanes` here, again after the
  // tile copy -- the same value both times -- and again as `nplanes_b` and
  // `nplanes_c` further down.
  for( int32_t pi = 0; pi<plane_count; ++pi ) {
    const int32_t plane_i = plane_desc[pi].src_plane;
    // Once any plane has taken the p2 model, the cheaper candidates are not
    // offered to the planes after it: mode 0 is skipped outright and the p2
    // trial becomes unconditional.
    if( out.n_p2 ) {
      best_cost = 0x7FFFFFFF;
    } else {
      best_cost = probe_plane(plane_i, try_mode0);
      packer_reset();
      if( best_cost!=0x7FFFFFFF )
        best_flags = 0;
    }
    const int32_t bits_f5 = probe_keep(plane_i, try_p1);
    // The second predictor is only worth a trial when the first came close
    // to the incumbent, and the reference descriptors are tried for every
    // plane but the first -- two independent conditions.  The recovery
    // nested them and then jumped *into* the inner arm from the outer
    // `else`, with a second label under both to rejoin.
    if( bits_f5<best_cost+(best_cost>>5)||out.n_p2 )
      probe_keep(plane_i, try_p2);
    int32_t pred;
    if( pi ) {
      probe_keep(plane_i, try_refs);
      const int32_t bits_f13 = probe_keep(plane_i, try_refs_p1);
      pred = best_flags&desc_predictor;
      // `bits_f13` was also kept in `rows[0]` for this one comparison,
      // which is the value the line above it already holds.
      if( pred==pred_p2||best_cost+(best_cost>>5)>bits_f13 ) {
        probe_keep(plane_i, try_refs_p2);
        if( won )
          pred = pred_p2;
      }
    } else {
      // The two arms this replaces spelled it `best_flags & 3` and
      // `(uint8_t)best_flags & 3`, which is one value: the field is the low
      // two bits.
      pred = best_flags&desc_predictor;
    }
    const int32_t flag8 = (uint8_t)best_flags&desc_has_refs;
    out.bits += best_cost;
    // `pred` is read for the p2 count before the next line rewrites it, so
    // the count is taken first.  `pred_p1` is 1 and `pred_mode0` is 0, so the
    // line after the count is a count too -- which is what `n_p1` says and
    // `bits_total += pred` did not.
    out.n_p2 += pred==pred_p2;
    if( pred!=pred_p1 )
      pred = pred_mode0;
    out.n_p1 += pred;
    plane_cost[plane_i] = best_cost;
    out.n_refs += flag8!=0;
    plane_desc[plane_i].flags = (uint8_t)best_flags;
  }
  return out;
}

uint32_t search_filter(BmfImage* img) {
  // The frame was one union of two arms and 36 bytes of pad, and the two arms
  // never overlap: everything in the scalar arm is dead by the `free(tile_buf)`
  // below, and `saved` is first written four lines later.  So it is MSVC
  // sharing one 64-byte slot between the per-plane search and the
  // whole-image trials, and the two are plain locals.
  //
  // Two of those scalars did double duty inside the arm as well.  `pi` was the
  // plane loop's index and then a pixel stride, and `costs[0]` -- the first
  // entry of a four-plane cost table -- was that same stride twice more; all
  // three were the `planes*(height-1)` of a pixel transpose, and the transpose
  // is `transpose_image` now.
  //
  // `rows[2]` and `dims[2]` were not arrays either.  Every one of their six
  // roles is a copy of a local that is still live at the read -- `bits_f13`,
  // `pl_k`, `bits_a`, `y0`, `plane_count`, `tile_h`, `plane_i` -- and
  // `dims[0]` was written twice and never read.  `uncopy.py` cannot see any of
  // it: its rule is about a named local, and a subscript is not one.
  PlaneDesc saved[4];
  uint32_t plane_cost[4];
  uint8_t* tile_buf;
  int32_t tile_h, y0, cand, pl_k;
  int32_t tile_w = img->width;
  tile_h = img->height;
  if( tile_w<4||tile_h<3 ) {
    reset_descriptors();
    return 0;
  }
  choose_plane_coding(img);
  BmfImage *tile_img = alloc_image(tile_w, tile_h, img->depth&depth_bits, 0, 0);
  stream_open(tile_img->data_size);
  tile_buf = (uint8_t*)bmf_new(tile_h*tile_w);
  y0 = (img->height-tile_h)>>1;
  int32_t dx = img->width-tile_w;
  int32_t off_y = y0*img->stride;
  uint8_t *srcp = img->pixels+plane_count*(dx>>1)+off_y;
  uint8_t *tile_src = tile_img->pixels;
  // The tile is the middle of the image, `tile_h` rows of it.  The condition
  // was `y0 < tile_h+y0` and the bound `dims[1]+((img->height-dims[1])>>1)`,
  // which is `tile_h+y0` again with `y0` spelled out; the loop runs `tile_h`
  // times either way.
  if( tile_h>0 ) {
    int32_t row_bytes = tile_img->stride;
    uint8_t *dstp = tile_img->pixels;
    for( int32_t y = 0; y<tile_h; ++y ) {
      memcpy(dstp, srcp, row_bytes);
      dstp += row_bytes;
      srcp += img->stride;
    }
  }
  PlaneSearch ps = search_planes(tile_img, tile_buf, plane_cost);
  int32_t best_bits = ps.bits;
  // The transposed tile, costed against the per-plane figures the search just
  // took.  Three pixel transposes here, all `transpose_image`: this one to try
  // the other orientation, and one of the two below to put back whichever
  // orientation lost.
  {
    transpose_image(tile_img, plane_count);
    int32_t bits_d = 0;
    // The plane that costs more transposed is the one that settles it, so the
    // walk stops there -- and where it stopped is the answer: `pk` is short of
    // the count when a plane was dearer and equal to it when none was.  The
    // recovery said that with a `break` out of a `while( 1 )` for one exit and
    // a `goto` past the line below for the other.
    int32_t pk = 0;
    while( pk<plane_count ) {
      pl_k = plane_desc[pk].src_plane;
      model_planes(tile_img, tile_buf, pl_k);
      const int32_t bits = 8*(stream.cur-stream.buf);
      packer_flush();
      bits_d += bits;
      packer_reset();
      if( (uint32_t)(bits-(bits>>8))>plane_cost[pl_k] )
        break;
      ++pk;
    }
    if( pk<plane_count )
      bits_d += best_bits+1;
    if( bits_d+(bits_d>>12)>=best_bits ) {
      // Transposed is no better: put the tile back and leave the image alone.
      transpose_image(tile_img, plane_count);
    } else {
      // Transposed is better, so the whole image turns with it and the tile
      // stays as it is.
      best_bits = bits_d;
      transpose_image(img, plane_count);
    }
  }
  free(tile_buf);
  if( plane_count>2 ) {
    if( ps.n_p1 ) {
      save_descriptors(saved);
      offer_to_all(try_p1);
      int32_t bits_e = transform_cost(tile_img);
      if( bits_e<=best_bits ) {
        best_bits = bits_e;
        cand = 0;
      } else {
        restore_descriptors(saved);
        cand = 1;
      }
      // The `goto planes_done` that stood here asked whether `nplanes_b <= 2`,
      // and both arms above had just set `nplanes_b = plane_count` inside a
      // block guarded by `plane_count > 2`.  Nothing between the two writes the
      // count -- it is set once at the top of `compress_image` and once at the
      // top of `expand_image`, and neither is on this path -- so the test was
      // `plane_count > 2 && plane_count <= 2` and the jump could not be taken.
      // The variable was read nowhere else.
    } else {
      cand = 1;
    }
    if( ps.n_p2+(cand==0) ) {
      save_descriptors(saved);
      offer_to_all(try_p2);
      // `nplanes_c` was `plane_count` assigned before this loop and again on
      // every turn of it, and nothing here writes the count -- three spellings
      // of one read.
      if( plane_count==ps.n_p2&&plane_count-1==ps.n_refs ) {
        cand = 0;
      } else {
        const int32_t bits_a = transform_cost(tile_img);
        if( bits_a<=best_bits ) {
          best_bits = bits_a;
          // **A bit count stored in a plane count**, and it is the original's,
          // left alone.  `n_p2` is read once more below, as `!n_p2`, and what
          // this line is for is to stop that last block from running now that
          // the p2-everywhere transform has been taken.  Writing `bits_a` says
          // so only while `bits_a` is nonzero.
          //
          // It is not provably nonzero: `transform_cost` measures the bytes the
          // coder wrote *before* its flush, and the trial tile is as small as
          // 4x3, so a perfectly predicted tile emitting none of them is not
          // ruled out by anything here.  A flag would change the program on
          // exactly that input and no corpus stream would move to say so, which
          // is the same call `nb_weights`' bound got: the honest thing is the
          // note, not the improvement.
          ps.n_p2 = bits_a;
          if( plane_count-1==ps.n_refs ) {
            cand = 0;
          } else {
            save_descriptors(saved);
            allow_refs_where_present();
            int32_t bits2 = transform_cost(tile_img);
            if( bits2>bits_a )
              restore_descriptors(saved);
            cand = 0;
          }
        } else {
          restore_descriptors(saved);
        }
      }
    }
  } else {
    cand = 1;
  }
  if( !ps.n_p2&&plane_count>1 ) {
    uint8_t *tile_copy = (uint8_t*)bmf_new(tile_img->data_size);
    memcpy(tile_copy, tile_src, tile_img->data_size);
    save_descriptors(saved);
    drop_alt_model_from_all();
    int32_t bits_b = transform_cost(tile_img);
    if( bits_b>best_bits ) {
      restore_descriptors(saved);
    } else {
      best_bits = bits_b;
      cand = 0;
    }
    if( ps.n_refs+ps.n_p1 ) {
      save_descriptors(saved);
      clear_flags_on_all();
      memcpy(tile_src, tile_copy, tile_img->data_size);
      int32_t bits_c = transform_cost(tile_img);
      if( bits_c<=best_bits ) {
        cand = 0;
      } else {
        restore_descriptors(saved);
      }
    }
    free(tile_copy);
  }
  free(stream.buf);
  free((uint8_t*)tile_img);
  return cand;
}

// bmp_read.inc -- read a BMP, in every depth and both run-length forms.

// One run-length opcode: a count and a value.  False on a stream error or an
// end of file, which both arms answer the same way and neither can tell apart
// from a legitimate byte without this check -- `fgetc` returns `int` for that
// reason.  Five lines at the top of each of the two loops.
static bool read_rle_op(FILE* fp, int32_t& n, int32_t& v) {
  if( ferror(fp) )
    return false;
  n = fgetc(fp);
  v = fgetc(fp);
  return n>=0&&v>=0;
}

// An absolute run of `n` nibbles, read a byte at a time from `src` and written
// from the half of `*at` that `hi` names.  Answers where the run ended, leaving
// `hi` saying which half of that byte the next nibble goes in.
//
// The parity does not change inside the run -- a turn writes a whole byte -- so
// the two `hi_nibble = ` stores in the middle of the recovered loop stored what
// was already there.  Lifting the loop out is what takes `read_bmp` off a
// nesting depth of seven; the three exits were three copies of "save the
// cursor" and are the return.
static uint8_t* write_nibbles(uint8_t* at, int32_t& hi, const uint8_t* src,
                              uint32_t n) {
  while( 1 ) {
    const uint8_t pix = *src;
    const uint32_t left = n-1;
    if( hi ) {
      if( !left ) {
        *at = *src&0xF0;
        hi = 0;
        return at;
      }
      *at++ = pix;
    } else {
      *at++ |= (uint8_t)*src>>4;
      if( !left ) {
        hi = 1;
        return at;
      }
      *at = 16*(pix&0xF);
    }
    ++src;
    n = left-1;
    if( !n )
      return at;
  }
}

// The RLE8 opcode stream.  True when it ended -- by the end-of-bitmap escape or
// by running off the top row -- and false on a short read or an opcode that
// would write outside the image.
//
// Both endings were a `goto done` five frames up, to the one place that closes
// the file and gives the scratch back; false is the `return nullptr` that was
// already written five times here and leaves both exactly as it found them.
//
// This and `read_rle4` share a shape and share it as far as it goes: one opcode
// a turn through `read_rle_op`, then a five-way branch, and the two arms that
// are the same in both -- end of line and end of bitmap -- are the same three
// lines.  The other three are not shared and cannot be: a run, a delta and an
// absolute block each carry the nibble/byte difference in their arithmetic, and
// the only way to fold them would be a callback per arm, which is the dispatch
// written twice with an indirection over it.
//
// `write_nibbles` has no counterpart on the writing side either.  A 4-bit image
// is stored *packed*, two pixels to a byte -- which is what `run4/2 + 1` and
// `dxy >> 1` in `read_rle4` are about -- so `write_bmp` copies bytes and never
// has a nibble to lay down.  The helper unpacks an RLE4 absolute run into that
// packed buffer; there is nothing in the other direction for it to do.
static bool read_rle8(FILE* fp, BmfImage* img, uint8_t* at, void* pal_buf) {
  int32_t y = img->height-1;
  int32_t n, v;
  while( read_rle_op(fp, n, v) ) {
    if( n ) {
      if( !img->holds(at, n) )
        return false;
      __builtin_memset(at, v, n);
      at += n;
    } else if( !v ) {
      if( --y<0 )
        return true;
      at = img->row(y);
    } else if( v==1 ) {
      return true;
    } else if( v==2 ) {
      // A delta is two more bytes of the same opcode, so it is the same read.
      // It picks up a `ferror` check the recovery did not have here: after a
      // read error `fgetc` answers EOF, which is the -1 this already refused,
      // so the two agree.
      int32_t dx, dy;
      if( !read_rle_op(fp, dx, dy) )
        return false;
      at += dx-dy*img->stride;
    } else {
      if( !img->holds(at, v) )
        return false;
      if( !read_exact(pal_buf, (v+1)&0xFFFFFFFE, fp) )
        return false;
      memcpy(at, (uint8_t*)pal_buf, v);
      at += v;
    }
  }
  return false;
}

// The RLE4 opcode stream, which is RLE8's with a nibble for a pixel: half the
// horizontal step, a run counted in nibbles, and a cursor that carries which
// half of `*row` the next one goes in.
//
// One opcode per turn, which is what RLE8 above already looked like.  This was
// three `while( 1 )`s with a label at the top of the innermost and five jumps
// back to it, and the nesting *was* the dispatch: fall out of the innermost
// loop for an escape, out of the middle one for anything but an end of line,
// out of the outer one for anything but a delta.  Reading it meant holding
// three loops in mind to see a five-way branch on two bytes.
static bool read_rle4(FILE* fp, BmfImage* img, uint8_t* row, void* pal_buf) {
  int32_t hi_nibble = 1;
  int32_t y = img->height-1;
  int32_t run4, byte_in;
  while( read_rle_op(fp, run4, byte_in) ) {
    const uint32_t byte = (uint32_t)byte_in;
    if( run4 ) {
      if( !img->holds(row, run4/2+1) )
        return false;
      uint8_t lo = byte&0xF;
      // `run4` nibbles of the two-nibble pattern in `byte`, from the half of
      // `*row` that `hi_nibble` names.  Both arms ended twice -- once by
      // falling out of their loop and once by a jump back to the top of the
      // one above -- and those are the same exit.  What told them apart is
      // the parity of `run4`, which is what each arm's counter is left
      // holding.
      if( hi_nibble ) {
        // Byte-aligned, so every full byte is `byte` itself.  The counter
        // steps by two and stops at 0 or 1.
        int32_t left4b = run4;
        uint8_t *row3 = row;
        while( left4b>1 ) {
          *row3++ = byte;
          left4b -= 2;
        }
        row = row3;
        hi_nibble = left4b==0;
        if( left4b )
          *row3 = byte&0xF0;
      } else {
        // Half a byte out of step: each byte written is the low nibble of
        // the previous pattern beside the high nibble of the next, so the
        // first byte carries whatever `*row` already held and the last may
        // be half a byte on its own.  Here the counter ends at 0 or -1.
        int32_t left4 = run4;
        uint8_t *row4 = row;
        uint8_t cur = *row;
        uint32_t hi = byte>>4;
        uint8_t lo16 = 16*lo;
        do {
          *row4++ = hi|cur;
          cur = lo16;
          left4 -= 2;
        } while( left4>0 );
        row = row4;
        hi_nibble = left4<0;
        if( !hi_nibble )
          *row4 = lo16;
      }
    } else if( !byte ) {
      if( --y<0 )
        return true;
      row = img->row(y);
    } else if( byte==1 ) {
      return true;
    } else if( byte==2 ) {
      int32_t dxy, dy4;
      if( !read_rle_op(fp, dxy, dy4) )
        return false;
      // Half the horizontal step, because a column here is a nibble.
      int32_t step = (dxy>>1)-dy4*img->stride;
      if( (dxy&1)==1 ) {
        if( !hi_nibble )
          ++step;
        hi_nibble = !hi_nibble;
      }
      row += step;
    } else {
      // An absolute run of `byte` nibbles, read a byte at a time and split
      // across whichever half of the output `hi_nibble` names.
      if( !img->holds(row, (int32_t)byte/2+1) )
        return false;
      if( !read_exact(pal_buf, (((byte+1)>>1)+1)&0xFFFFFFFE, fp) )
        return false;
      row = write_nibbles(row, hi_nibble, (const uint8_t*)pal_buf, byte);
    }
  }
  return false;
}

// Uncompressed rows, bottom-up, each padded out to a multiple of four bytes.
//
// The stride was re-read from the header after every call in the recovered
// loop -- `stride = (uint16_t)img_f->stride`, twice a turn -- which is one
// value under a spill and a truncation.  Neither says anything: `fread` and
// `fseek` do not write the header, and the accepted-format check one screen up
// bounds a row to 65535 bytes, so the cast cannot narrow it.
static bool read_rows(FILE* fp, BmfImage* img, uint8_t* row, uint32_t stride_pad) {
  const uint32_t stride = img->stride;
  const uint32_t row_pad = stride_pad-stride;
  for( int32_t y = img->height-1; y>=0; --y ) {
    if( fread(row, 1u, stride, fp)!=stride )
      return false;
    if( row_pad )
      fseek(fp, row_pad, 1);
    row -= stride;
  }
  return true;
}

BmfImage* read_bmp(char* path) {
  uint8_t bmp_bgra[4];
  int32_t pal_n, i;
  BmpHeader hdr;
  // Stage-2 11.4.  `bmf_compress` used to open this path, close it again and
  // then call here, purely so that "cannot open" could exit 1 (`bmf_no_open`)
  // while "not a BMP" exits 3 (`bmf_read_error`) -- the two are the same
  // `return nullptr` from here, so the probe was the only thing that told them
  // apart.  Deleting the probe without this line would have changed the exit
  // code for a missing file, which is what makes the caveat worth having.
  FILE* fp = fopen(path, "rb");
  if( !fp )
    bmf_fatal(bmf_no_open, path);
  if( fread(&hdr.bfType, 0xEu, 1u, fp)!=1||hdr.bfType!=bmp_magic||fread(&hdr.biSize, 0x28u, 1u, fp)!=1||hdr.biSize!=bmp_hdr_v3||hdr.biPlanes!=1 ) {
    fclose(fp);
    return nullptr;
  }
  {
    const int32_t bmp_w = hdr.biWidth;
    const int32_t bmp_h = hdr.biHeight;
    const int32_t bmp_bpp = hdr.biBitCount;
    // Everything this reader will not take, one reason per line.  It was one
    // 358-character condition, which is the only statement of the accepted
    // format anywhere -- `MODELS.md` had to reconstruct the list from it by
    // hand.
    if( bmp_w<=0||bmp_w>0xFFFF                                  // width 1..65535
     || bmp_h<=0||bmp_h>0xFFFF                                  // height likewise
     || (bmp_bpp>=8&&(uint32_t)bmp_w*(uint32_t)((bmp_bpp+7)>>3)>0xFFFFu)
                                                                // and a row of it fits in 16 bits
     || (bmp_bpp!=1&&bmp_bpp!=4&&bmp_bpp!=8&&bmp_bpp!=24&&bmp_bpp!=32)
                                                                // 1, 4, 8, 24 or 32 -- no 16
     || (int32_t)hdr.biClrUsed<0                                // a palette count, not a sign
     || (bmp_bpp<=8&&(int32_t)hdr.biClrUsed>(1<<bmp_bpp))       // no more entries than the depth allows
     || hdr.biCompression>bmp_rle4                              // none, RLE8 or RLE4
     || (hdr.biCompression==bmp_rle8&&bmp_bpp!=8)               // RLE8 is 8 bpp only
     || (hdr.biCompression==bmp_rle4&&bmp_bpp!=4) ) {           // RLE4 is 4 bpp only
      fclose(fp);
      return nullptr;
    }
  }
  BmfImage* img = alloc_image(hdr.biWidth, hdr.biHeight, hdr.biBitCount, hdr.biBitCount<=8u, 1);
  if( !img ) {
    fclose(fp);
    return nullptr;
  }
  uint32_t stride_pad = (img->stride+3)&0xFFFFFFFC;
  if( hdr.biBitCount<=8u ) {
    pal_n = 1<<(hdr.biBitCount&31);
    if( (int32_t)hdr.biClrUsed )
      pal_n = (int32_t)hdr.biClrUsed;
    if( pal_n>0 ) {
      // The palette sits past the pixels, and the recovery worked that out
      // again before each of the three stores -- three names, `pal`, `pal2`
      // and `pal3`, for one pointer MSVC rematerialised rather than kept in a
      // register.  It does not depend on `i` either, so it is one line above
      // the loop.
      //
      // The null it takes when the depth carries no palette is the original's:
      // storing through it would fault either way, and nothing that reaches
      // here has `biBitCount <= 8` without `depth_palette`.
      uint8_t* pal = img->depth&depth_palette ? img->pixels+img->data_size : nullptr;
      for( i = 0; i<pal_n; ++i ) {
        if( !read_exact(bmp_bgra, 4u, fp) ) {
          fclose(fp);
          return nullptr;
        }
        pal[3*i+2] = bmp_bgra[2];
        pal[3*i+1] = bmp_bgra[1];
        pal[3*i] = bmp_bgra[0];
      }
    }
  }
  // One padded row of scratch, and the reader has already refused a stride
  // above 0xFFFF, so `stride_pad` is at most 65536 and the floor of 256 only
  // matters for the narrowest images.  `read_bmp` is not reentrant -- one file,
  // one call -- so one buffer is the bound.
  static uint8_t pal_store[65536];
  void* pal_buf = pal_store;
  BMF_ASSUME(max32(stride_pad, 256)<=(int32_t)sizeof pal_store);
  uint8_t *row = img->pixels+img->data_size-img->stride;
  fseek(fp, (int32_t)hdr.bfOffBits, 0);
  // Three ways to read the pixels, and each ended by jumping five frames out to
  // one tail that closes the file and gives the scratch back.  That tail is
  // here; each walk answers whether it got to the end of the bitmap.
  // Both run-length forms leave the pixels they never reach untouched, so both
  // cleared the buffer first; the uncompressed walk writes every byte.
  bool ok;
  if( hdr.biCompression==bmp_rgb ) {
    ok = read_rows(fp, img, row, stride_pad);
  } else {
    memset(img->pixels, 0, img->data_size);
    ok = hdr.biCompression==bmp_rle8 ? read_rle8(fp, img, row, pal_buf)
       : hdr.biCompression==bmp_rle4 ? read_rle4(fp, img, row, pal_buf)
       : false;
  }
  if( !ok )
    return nullptr;
  fclose(fp);
  // `free(pal_buf)` was here; `pal_store` is static.
  return img;
}

// bmp_write.inc -- write one back.

// The palette, and how many bytes of it there are.  Three arms: a greyscale
// ramp of `1 << bits` levels, the image's own palette copied out as BGR quads,
// or zeros -- which of the three is the top two bits of the depth byte.  Zero
// for a depth above eight bits, which has no palette.
//
// Sixty lines in the middle of `write_bmp` between the header fields and the
// pixels, reading only the depth and writing only the bytes at offset 54.  A
// stage of that function and not a step in it.
//
// The middle arm carried `rle_on = want_rle;` between two palette stores, a
// reload of a parameter into the local that already held it, with nothing
// between the two touching either.  It went with the move: there is no
// `want_rle` here to reload from.
static int32_t write_bmp_palette(const BmfImage* img, uint8_t* out_buf,
                                 uint8_t depth, int32_t bits) {
  if( bits>8 )
    return 0;

  // The palette's entry count, `1 << bits`.  A depth reaches `write_bmp`
  // only through `expand_image`, which refuses anything whose plane count
  // `((depth & 0x3F) + 7) >> 3` is outside 1..4, so `bits` is 1..32 and here
  // 1..8 -- and `ncol` is 2, 16 or 256.  The two `> 0` tests and the two
  // `/ 2` ones below were tests on that, and the four arms they guarded
  // (`at = 1`, `at2 = 1`/`done = 1`, and a `pal_bytes` with no palette
  // written) cannot
  // be reached.  `hdrscan.sh` puts every one of the 256 depth bytes through
  // this, which is the check the reasoning rests on.
  //
  // The count had two names, `ncolours` and `ncol`, assigned the same
  // expression on consecutive lines and then used interchangeably -- down to
  // `pal_bytes = 4*ncol` in one arm and `4*ncolours` in the next.
  const int32_t ncol = 1<<(bits&31);
  if( depth&depth_grey ) {
    uint32_t levels = 0x100u>>(bits&31);
    // `ncol` is 2, 16 or 256, so the half is at least one and the `do`'s
    // guaranteed first turn was never load-bearing.  `k` outlives the loop:
    // the odd entry below reads where it stopped.
    uint32_t k = 0;
    int32_t grey = 0;
    for( ; k<(uint32_t)(ncol/2); ++k, grey += 2*levels ) {
      put_u32(&out_buf[8*k+54], bmp_grey_entry((uint8_t)grey));
      put_u32(&out_buf[8*k+58], bmp_grey_entry((uint8_t)(grey+levels)));
    }
    const uint32_t at = 2*k+1;
    if( (at-1)<(uint32_t)ncol )
      put_u32(&out_buf[4*at+50], bmp_grey_entry((uint8_t)(levels*(at-1))));
    return 4*ncol;
  } else if( depth&depth_palette ) {
    uint32_t pairs = ncol/2;
    uint32_t j = 0;
    // `data_ofs2` is `img->data_size` on every path that reaches here, and
    // the palette sits immediately after the pixels -- so this was
    // `img->palette()` with `sizeof(BmfImage)` spelled as a 16 inside each
    // subscript.  Two BGR triples per turn, six bytes.
    const uint8_t *pal = img->palette();
    for( ; j<pairs; ++j ) {
      const uint32_t slot = 2*j;
      const uint8_t *e0 = &pal[6*j], *e1 = &pal[6*j+3];
      put_u32(&out_buf[4*slot+54], bmp_palette_entry(e0[0], e0[1], e0[2]));
      put_u32(&out_buf[4*slot+58], bmp_palette_entry(e1[0], e1[1], e1[2]));
    }
    // `done` was `at2` copied on the next line and then read twice below
    // it; the copy existed because the arm this replaced set the two to
    // different things.
    const uint32_t at2 = 2*j+1;
    if( (at2-1)<(uint32_t)ncol ) {
      // The odd colour the loop above did not reach.  `at2` is one past the
      // last pair it wrote, so `3*at2-3` is that entry's first byte.
      const uint8_t *e = img->palette()+3*at2-3;
      put_u32(&out_buf[4*at2+50], bmp_palette_entry(e[0], e[1], e[2]));
    }
    return 4*ncol;
  } else {
    return 4*ncol;
    memset(out_buf+54, 0, 4*ncol);
    }
}

// The pixels, run-length encoded, written at `buf`.  Returns the cursor past the
// last opcode and sets `*kind` to `bmp_rle4` or `bmp_rle8`, or returns null when
// this depth has no run-length form.
//
// Whether the result is *kept* is the caller's question and not this one's: an
// encoding can come out no smaller than the pixels it replaces, and then the raw
// form wins.  That retry was a `while( 1 )` wrapped around this whole body with
// a `rle_mode = 0` at the bottom of it -- a loop with at most two turns, written
// as an unbounded one, with the raw path reached by a `break` from three places.
// With the encoder a function the caller asks the question once and the loop is
// gone.
//
// `data_len = img->data_size;` sat after the row loop, assigning the value the
// local had held since before the loop with nothing between touching either.  It
// was the second turn's reload and there is no second turn.
static uint8_t* bmp_rle_encode(BmfImage* img, int32_t bits, uint8_t* buf,
                               int32_t rows, uint32_t stride, int32_t* kind) {
  // BMP defines a run-length form for four- and eight-bit pixels and for
  // nothing else, which the original said through a `can_rle` flag set, tested,
  // cleared and tested again, with `rle_kind` derived from the flag and `nib`
  // derived back from `rle_kind` -- four names for one bit.
  //
  // Pixels are nibbles rather than bytes is the whole difference between the two
  // forms: half the shift, and a run counts to 15 rather than 255.
  if( bits!=4&&bits!=8 )
    return nullptr;
  const int32_t nib = bits==4;
  const int32_t run_max = (0x100u>>(nib&31))-1;
  *kind = nib ? bmp_rle4 : bmp_rle8;
  uint8_t *out_at = buf, *q = nullptr, *end = nullptr;
  uint8_t* p = &img->pixels[img->data_size-stride];
  uint8_t byte = 0;
  int32_t lit_len = 0, run = 0;
  // Flush the literal run that ends at `run_end`: an escape byte, the count,
  // the bytes themselves, and a pad byte when the count is odd -- or, for a
  // run too short to be worth the two-byte header, one or two encoded pairs
  // instead.
  //
  // Written out three times, and the three differ only in whether the run
  // ends at `p` or at `q` (which are the same pointer at each of the two
  // sites that use `q`) and in which of the output cursor's two names they
  // advanced.  The pair was `buf_2` and `out_at`, the register and the stack
  // slot MSVC spilled it to at every exit of this five-deep nest; there is
  // one cursor now.
  auto flush_literal = [&](const uint8_t* run_end) {
    if( nib ? lit_len!=1 : lit_len>=3 ) {
      *out_at = 0;
      out_at[1] = lit_len<<(nib&31);
      memcpy(out_at+2, run_end-lit_len, lit_len);
      if( lit_len&1 )
        out_at[lit_len+2] = 0;
      out_at += lit_len+2+(lit_len&1);
    } else if( nib ) {
      *out_at = 2;
      out_at[1] = run_end[-1];
      out_at += 2;
    } else {
      if( lit_len==2 ) {
        *out_at = 1;
        out_at[1] = run_end[-2];
        out_at += 2;
      }
      *out_at = 1;
      out_at[1] = run_end[-1];
      out_at += 2;
    }
  };
  // How many bytes from `from` repeat `*from`, counting `from` itself and
  // stopping at `stop`.  The caller has already established `from + 1 < stop`,
  // which is why the recovered loop tested the byte before the bound and this
  // tests the bound before the byte -- at the first turn they are one test.
  //
  // Not `at`/`end`: this body already has locals by both names, and a shadow
  // is what `BMF_WARN=1 ./build.sh` counts.
  auto run_length = [](const uint8_t* from, const uint8_t* stop) {
    int32_t n = 1;
    while( stop>from+n&&from[n]==from[0] )
      ++n;
    return n;
  };
  // Emit repeat pairs from `p` for as long as the next run is worth more
  // than the literal it would otherwise join, flushing that literal first
  // when there is one.  Returns true when the row ended on a pair boundary,
  // which is the one exit that has to leave the loop *outside* this one --
  // said by a `goto` past both in the recovery, and the reason this was two
  // `while( 1 )`s deep before anything in it happened.
  auto emit_runs = [&]() {
    while( 1 ) {
      q = p+1;
      if( p+1>=end )
        return false;
      byte = (uint8_t)*p;
      run = run_length(p, end);
      if( run<=2&&(run!=2||lit_len) )
        return false;
      run = min32(run, run_max);
      if( lit_len ) {
        flush_literal(p);
        lit_len = 0;
        byte = *p;
      }
      out_at[1] = byte;
      p += run;
      *out_at = run<<(nib&31);
      out_at += 2;
      if( p>=end )
        return true;
    }
  };
  // One row of opcodes: runs and literals until the row runs out.  Three
  // paths end a row -- the row is empty, `emit_runs` reached the end on a
  // pair boundary, or a maximum-length literal ended there -- and each used
  // to be a `goto` two loops out to the end-of-line pair below, setting
  // `row_i`, `rows3` and `stride3` on the way as the row loop's three
  // arguments, passed by assignment because the decompiler had no function to
  // pass them to.  Two of the three were `img->height` and `img->stride`
  // re-read under another name, and nothing in this body writes either field,
  // so eight assignments across four exits said nothing.  `row_i` is the one
  // that carries, and it is the row loop's own counter.
  auto emit_row = [&]() {
    end = &p[stride];
    if( p>=end )
      return;
    lit_len = 0;
    do {
      while( 1 ) {
        if( emit_runs() )
          return;
        ++p;
        if( ++lit_len!=run_max )
          break;
        flush_literal(q);
        if( q>=end )
          return;
        lit_len = 0;
      }
    } while( q<end );
    if( lit_len )
      flush_literal(q);
  };
  if( rows>0 ) {
    for( int32_t row_i = 0; row_i<rows; ++row_i ) {
      emit_row();
      // End of line, then back down two rows: one for the row just written
      // and one because a BMP's rows run bottom-up while the cursor walks
      // forward through them.
      *out_at = 0;
      out_at[1] = 0;
      out_at += 2;
      p -= 2*stride;
    }
  }
  *out_at = 0;
  out_at[1] = 1;
  return out_at+2;
}

int32_t write_bmp(BmfImage* img, char* path, int32_t want_rle) {
  uint8_t* out_at;
  int32_t bits, coded_bytes;
  FILE *fp = fopen(path, "wb");
  if( !fp )
    return 0;
  uint8_t *out_buf = (uint8_t*)bmf_new(img->data_size+8*img->height+(img->data_size>>5)+2048);
  BmpHeader* bmp = (BmpHeader*)out_buf;
  bmp->biSize = bmp_hdr_v3;
  bmp->bfType = bmp_magic;
  int32_t rows = img->height;
  bmp->bfReserved2 = 0;
  bmp->bfReserved1 = 0;
  bmp->biWidth = img->width;
  bmp->biHeight = rows;
  // The depth byte, whose top two bits pick which of the three palettes below
  // gets written.  It was `int8_t depth_flags`, which named the wrong byte --
  // `flags` is the other one -- and tested `depth_palette` as `depth_flags<0`.
  uint8_t depth = img->depth;
  bmp->biPlanes = 1;
  bits = depth&depth_bits;
  bmp->biBitCount = bits;
  bmp->biClrImportant = 0;
  bmp->biClrUsed = 0;
  bmp->biYPelsPerMeter = 0;
  bmp->biXPelsPerMeter = 0;
  // The pixels start after the header and whatever palette there was.
  const int32_t pal_bytes = write_bmp_palette(img, out_buf, depth, bits);
  uint8_t*const buf = &out_buf[pal_bytes+54];
  uint32_t stride = img->stride;
  // Write the two size fields into the header, put the buffer out, and close.
  // Both exits do this -- the run-length one only when the encoding came out
  // smaller than the raw pixels -- and the second copy reached the file and
  // the buffer through `fp2` and `out2`, which are assigned `fp` and `out_buf`
  // on every path that gets there.
  auto finish = [&](int32_t coded) {
    bmp->biSizeImage = (uint32_t)coded;
    uint32_t n_bytes = (uint32_t)(out_at-out_buf);
    bmp->bfSize = n_bytes;
    if( fwrite(out_buf, 1u, n_bytes, fp)!=bmp->bfSize )
      return 0;
    free(out_buf);
    fclose(fp);
    return 1;
  };
  uint32_t off_bits = (uint32_t)(buf-out_buf);
  const uint32_t data_len = img->data_size;
  bmp->bfOffBits = off_bits;
  out_at = buf;
  uint8_t* p = &img->pixels[data_len-stride];
  // The run-length form when there is one and it is smaller; the raw pixels
  // otherwise.  Two questions, and the original asked them as one unbounded
  // loop -- see the note at `bmp_rle_encode`.
  if( want_rle ) {
    int32_t rle_kind = 0;
    uint8_t*const rle_end = bmp_rle_encode(img, bits, buf, rows, stride, &rle_kind);
    if( rle_end&&data_len>(uint32_t)(rle_end-buf) ) {
      bmp->biCompression = rle_kind;
      out_at = rle_end;
      return finish(out_at-buf);
    }
  }
  bmp->biCompression = bmp_rgb;
  if( rows<=0 ) {
    coded_bytes = 0;
  } else {
    const uint32_t pad = ((stride+3)&0xFFFFFFFC)-stride;
    // Guarded by `rows > 0` above, and `rows` is `img->height`.
    for( int32_t y = 0; y<img->height; ++y ) {
      memcpy(out_at, p, stride);
      out_at += stride;
      p -= stride;
      if( pad ) {
        *(uint32_t*)out_at = 0;
        out_at += pad;
      }
    }
    coded_bytes = out_at-buf;
  }
  return finish(coded_bytes);
}

// image_expand.inc -- the image out of a `.bmf`.

// This frame was `liftframe.py`'s one standing failure.  Lifting it made
// seventeen of nineteen images fail to expand at all -- `expand exits 3`, the
// bad-file code -- which is not a stream that moved but the header parse
// itself ceasing to work, and the entry recorded that as the frame's layout
// being what the parse reads through.  It was, and the whole of it is one
// `fread`:
//
//     uint16_t hdr_words[5];
//     uint8_t depth_b;
//     uint8_t flags_b;
//     uint32_t data_len;
//     ...
//     fread(frame.hdr_words, 0x10u, 1u, arc_in->fp)
//
// Sixteen bytes across four members, of which the array is the first ten.  So
// the four are one object and the array's size was never five of anything:
// they are `BmfImage`'s `width`, `height`, `stride` and `_pad8`, then its
// `depth`, `flags` and `data_size`, at exactly those offsets.
// `compress_image` writes that same record with `fwrite(&hdr, 1u, 0x10u, …)`
// from a `BmfImage`, so the writer knew what it was and only the reader did
// not.
//
// That is the `read_bmp` finding one file over -- two `fread`s written across
// slots Hex-Rays had split a record into -- and it is the frame's only layout
// dependency.  With the header a record the rest lifts: a `CodedTail`, a
// `BmfImage` scratch for the one-plane decode, and fourteen spill slots each
// holding a copy of a local that is still live at the read.

// The plane descriptors, six bits each: two of reference count and four of
// flags, then the dc byte and the reference weights those flags call for.  The
// weights are written biased by 64 and read back the same way.
static void read_plane_descs() {
  for( int32_t pl = 0; pl<plane_count; ++pl ) {
    uint32_t desc = unpack_bits(6);
    int32_t nrefs = desc&3;
    plane_desc[pl].flags = desc>>2;
    plane_desc[pl].nrefs = nrefs;
    plane_desc[nrefs].src_plane = pl;
    if( !(plane_desc[pl].flags&desc_has_refs) )
      continue;
    plane_desc[pl].dc = unpack_bits(8);
    if( nrefs<=1 )
      continue;
    plane_desc[pl].weight0 = unpack_bits(8)-64;
    plane_desc[pl].weight1 = unpack_bits(8)-64;
    if( nrefs>2 )
      plane_desc[pl].weight2 = unpack_bits(8)-64;
  }
}

// Each plane coded on its own, so each is decoded through a header that says
// one eight-bit greyscale plane and interleaved back afterwards.
static void unmodel_planes_apart(BmfImage* img_at, uint8_t* plane_buf) {
  BmfImage plane_hdr = *img_at;
  plane_hdr.depth = depth_one_plane;
  for( int32_t k = 0; k<plane_count; ++k ) {
    const int32_t plane = plane_desc[k].src_plane;
    plane_predictor = plane_desc[plane].flags&desc_predictor;
    plane_alt_model = (plane_desc[plane].flags&desc_alt_model)!=0;
    unmodel_plane(&plane_hdr, plane_buf);
    // `pred && pred == pred_p1 && !alt` was three nested `if`s with the mode-0
    // arm hanging off the outermost `else`, which is one condition either way.
    //
    // That arm called `expand_predictor_mode0(width)`, whose body is empty.
    // It is not a format hook and not a table entry -- both call sites are the
    // `else` of an `if`/`else if` chain, and `pred_p1` is 1, so testing for it
    // already excludes mode 0.  The function, its declaration and both calls
    // are gone; the enumerator stays, because it is a value in the stream.
    if( plane_predictor==pred_p1&&!plane_alt_model )
      unpredict_med(plane_buf, img_at->width, img_at->height);
    interleave_plane(img_at, plane_buf, plane);
  }
}

// One coded image, then each plane's predictor undone in place: take the plane
// out, unpredict it, put it back.
static void unmodel_planes_together(BmfImage* img_at, uint8_t* plane_buf) {
  plane_predictor = plane_desc[0].flags&desc_predictor;
  plane_alt_model = (plane_desc[0].flags&desc_alt_model)!=0;
  unmodel_plane(img_at, img_at->pixels);
  // The alternate model leaves this loop nothing to undo; the recovery said so
  // by jumping past it to the `free` that follows, which is the caller's now.
  if( plane_alt_model )
    return;
  for( int32_t k = 0; k<plane_count; ++k ) {
    const int32_t plane = plane_in_order(k);
    const int32_t pred = plane_predictor;
    if( (plane_desc[plane].flags&desc_has_refs)==0&&!pred )
      continue;
    deinterleave_plane(img_at, plane_buf, plane);
    if( pred==pred_p1 )
      unpredict_med(plane_buf, img_at->width, img_at->height);
    interleave_plane(img_at, plane_buf, plane);
  }
}

// A stream that carries descriptors: the near-lossless nibble, the descriptors
// themselves, and then the planes, however they were coded.
static void unmodel_described(BmfImage* img_at, uint8_t flags) {
  // The near-lossless nibble, mirroring `image_compress`: present for a single
  // greyscale plane and for three or more, absent otherwise.  Two `goto`s
  // jumped over it; the condition is the encoder's, negated.
  if( plane_count==1 ? (img_at->depth&depth_grey)!=0 : plane_count>2 ) {
    uint32_t near_lossless = unpack_bits(4);
    if( near_lossless ) {
      printf("\nnear-lossless stream (E=%d); this build only decodes E=0\n", near_lossless);
      exit(3);
    }
    near_lossless_q = 0;
  }
  read_plane_descs();
  uint8_t *plane_buf = (uint8_t*)bmf_new(img_at->width*img_at->height);
  if( flags&flags_planar )
    unmodel_planes_apart(img_at, plane_buf);
  else
    unmodel_planes_together(img_at, plane_buf);
  free(plane_buf);
}

// The coded body of a member: the packed stream read whole, then decoded into
// `img_at`.  False when the file is short of what the header promised, or when
// the stream did not end where its own length said it would -- the caller turns
// either into `fail()`, which is what each was before.
//
// `FILE*` and not the `BmfFile*` the caller holds: the archive is what
// `expand_image` reads members out of, and this reads bytes out of a stream.
// The lift took `arc_in` at first, which left a first parameter every use of
// which was `arc_in->fp` -- `methodise.py`'s rule for a receiver, and the
// wrong reading, since `arc_in->expand_coded(...)` would be the archive
// expanding an image.  Its opposite number is declined in that tool for the
// same sentence; this one did not have to be.
static bool expand_coded(FILE* fp, BmfImage* img_at, const BmfImage& hdr) {
  near_lossless_q = 0;
  alphabet_reduced = 0;
  if( !(hdr.flags&flags_slow) ) {
    printf("\nwritten in fast mode; this build only decodes -S streams\n");
    exit(3);
  }
  desc_slow_mode = 1;
  stream.size = hdr.data_size;
  stream.buf = (uint8_t*)bmf_new(hdr.data_size);
  packer_reset();
  uint32_t want = hdr.data_size;
  if( fread(stream.buf, 1u, hdr.data_size, fp)!=want )
    return false;
  if( (img_at->depth&depth_bits)<=4||(hdr.flags&flags_descriptors)==0 ) {
    plane_predictor = 0;
    plane_alt_model = 0;
    unmodel_plane(img_at, img_at->pixels);
  } else {
    unmodel_described(img_at, hdr.flags);
  }
  if( stream.buf+hdr.data_size!=stream.cur )
    return false;
  free(stream.buf);
  return true;
}

BmfImage* expand_image(BmfFile* arc_in, CodedTail** p_coded_buf) {
  // The member header, as it sits in the file.  `data_size` is the *coded*
  // byte count here, not the pixel count: the two are compared below, and the
  // one that came off the wire is this one.
  BmfImage hdr;
  CodedTail head;
  // The archive version, as a plain local.  The decompilation parked it in
  // `plane_desc[0].weight0` because the original did: `plane_desc[0]` is a
  // header slot, not a plane, and its three weight words were free.
  int32_t version;
  uint32_t magic;
  if( p_coded_buf )
    *p_coded_buf = nullptr;
  FILE *fp1 = (arc_in)->fp;
  if( !fp1 )
    return nullptr;
  // Skip any member that is not an image, by the length in its eight-byte
  // header, until one is.
  while( 1 ) {
    if( fread(&magic, 4u, 1u, fp1)!=1 ) {
      FILE *fp = arc_in->fp;
      if( feof(fp) )
        return nullptr;
      {
        fclose(fp);
        arc_in->fp = 0;
        return nullptr;
      }
    }
    if( (uint16_t)magic!=bmf_sig_other )
      break;
    version = bmf_tag_version(magic);
    if( version!=bmf_version_20||fread(&head, 8u, 1u, arc_in->fp)!=1 )
      break;
    fseek(arc_in->fp, head.len, 1);
    fp1 = arc_in->fp;
  }
  version = bmf_tag_version(magic);
  if( (uint16_t)magic!=bmf_sig_image||version!=bmf_version_20
      ||fread(&hdr, 0x10u, 1u, arc_in->fp)!=1 ) {
    return arc_in->fail();
  }
  if( hdr.flags&flags_tail ) {
    if( !read_exact(&head, 8u, arc_in->fp) )
      return arc_in->fail();
    if( p_coded_buf ) {
      if( head.len>bytes_left(arc_in->fp) ) {
        return arc_in->fail();
      }
      // Up to a word, and up from zero to four: `(len==0)` is what makes an
      // empty tail one word rather than none, and the last word is cleared
      // because the read below stops at `len` and leaves the padding it wrote
      // nothing into.
      uint32_t pad_len = (head.len+(head.len==0)+3)&0xFFFFFFFC;
      CodedTail *blk = (CodedTail*)bmf_new(pad_len+sizeof(CodedTail));
      blk->tag = head.tag;
      blk->len = pad_len;
      blk->data[pad_len/4-1] = 0;
      *p_coded_buf = blk;
      if( !read_exact(blk->data, head.len, arc_in->fp) )
        return arc_in->fail();
    } else {
      fseek(arc_in->fp, head.len, 1);
    }
  }
  if( hdr.data_size>bytes_left(arc_in->fp) ) {
    return arc_in->fail();
  }
  uint32_t pal_bytes = 3<<(hdr.depth&31);
  if( !(hdr.depth&depth_palette) )
    pal_bytes = 0;
  // Stage-2 11.3.  `read_bmp` refuses a source whose row will not fit in
  // sixteen bits; this did not, and `width` is `uint16_t`, so a header claiming
  // 16384 pixels at 32 bits asked for a 262140-byte row and `alloc_image`
  // truncated it to 0.  A zero stride is not caught anywhere downstream -- every
  // row of the image is then row 0.
  //
  // The same predicate as the reader's, written the same way round, and it can
  // only fire on a crafted stream: nothing this program writes gets here,
  // because the encoder refused the source that would have produced it.
  if( !hdr.width||!hdr.height
   || (uint32_t)hdr.width*(uint32_t)((((hdr.depth&depth_bits)+7)>>3))>0xFFFFu ) {
    return arc_in->fail();
  }
  BmfImage *img_at = alloc_image(hdr.width, hdr.height, hdr.depth&depth_bits, (hdr.depth&depth_palette)!=0, 1);
  img_at->depth = hdr.depth;
  uint8_t has_coded = p_coded_buf&&*p_coded_buf;
  img_at->flags |= (hdr.flags&flags_transposed)|(has_coded ? flags_tail : 0);
  plane_count = ((hdr.depth&depth_bits)+7)>>3;
  if( plane_count<1||plane_count>4 ) {
    return arc_in->fail();
  }
  if( hdr.flags&flags_coded ) {
    if( !expand_coded(arc_in->fp, img_at, hdr) ) {
      return arc_in->fail();
    }
  } else {
    // Raw pixels.  `hdr.data_size` is what the file says follows and
    // `img_at->data_size` is what was allocated for it.
    if( hdr.data_size>img_at->data_size ) {
      return arc_in->fail();
    }
    uint32_t want = hdr.data_size;
    if( fread(img_at->pixels, 1u, hdr.data_size, arc_in->fp)!=want ) {
      return arc_in->fail();
    }
  }
  if( hdr.depth&depth_palette ) {
    uint8_t *pal_at = (img_at->depth&depth_palette) ? img_at->palette() : nullptr;
    uint32_t got = fread(pal_at, 1u, pal_bytes, arc_in->fp);
    if( got!=pal_bytes ) {
      return arc_in->fail();
    }
  }
  if( img_at->flags&flags_transposed ) {
    if( (uint64_t)img_at->width*img_at->height*(uint32_t)plane_count>(uint64_t)img_at->data_size ) {
      return arc_in->fail();
    }
    transpose_image(img_at, plane_count);
  }
  return img_at;
}

// image_compress.inc -- one image into one.

// The member's sixteen-byte header and, when the file carries one, the coded
// block that comes before the payload.  Both exits write these four lines --
// the coded arm with the header it has just filled in and the raw arm with the
// image's own, which are the same sixteen bytes laid out the same way, and
// each spelled the block's length into the same function-scope `coded_len`.
static uint8_t write_member_head(const void* head, const CodedTail* extra, FILE* fp) {
  uint8_t ok = fwrite(head, 1u, 0x10u, fp)==16;
  if( extra ) {
    const uint32_t coded_len = extra->len;
    ok &= fwrite(extra, 1u, coded_len+sizeof(CodedTail), fp)==coded_len+sizeof(CodedTail);
  }
  return ok;
}

// The plane descriptors, as `read_plane_descs` reads them back: six bits of
// count and flags, then the dc byte and the weights the flags call for, each
// biased by 64.
static void write_plane_descs() {
  for( int32_t pl = 0; pl<plane_count; ++pl ) {
    pack_bits((plane_desc[pl].flags<<2)|plane_desc[pl].nrefs, 6);
    if( !(plane_desc[pl].flags&desc_has_refs) )
      continue;
    pack_bits(plane_desc[pl].dc, 8);
    if( plane_desc[pl].nrefs<=1u )
      continue;
    pack_bits(plane_desc[pl].weight0+64, 8);
    pack_bits(plane_desc[pl].weight1+64, 8);
    if( plane_desc[pl].nrefs>2u )
      pack_bits(plane_desc[pl].weight2+64, 8);
  }
}

// The image into `stream`, and the flags its coding needs into `hdr`.  Two
// shapes: four bits or fewer is one plane straight through, and anything wider
// gets the filter search, the descriptors, and the planes.  The narrow arm was
// a `goto` past all of that to the flush below, which is this function's own
// early `return`.
static void code_image_body(BmfImage* p_i, BmfImage& hdr) {
  if( (p_i->depth&depth_bits)<=4 ) {
    stream_open(p_i->data_size);
    plane_predictor = 0;
    plane_alt_model = 0;
    alphabet_reduced = 0;
    model_plane(p_i, p_i->pixels, p_i->pixels);
    return;
  }
  const uint32_t filtered = search_filter(p_i);
  hdr.flags |= flags_descriptors;
  // `search_filter` may have transposed the image under the header written at
  // the top, so the header is taken again -- but not the byte count, which the
  // transpose does not move and which both arms of the `if` read the same way.
  const uint32_t data_bytes = p_i->data_size;
  if( p_i->flags&flags_transposed ) {
    hdr.header_from(p_i);
    // The three bits set above, put back over the source's own -- the same
    // value the `|=`s left, re-derived from a header that `search_filter` may
    // have transposed under it.  This was `hdr_pad8b >> 24`, the top byte of
    // the word at offset 8, and `p_i->flags` is not written between the two.
    hdr.flags = flags_coded|flags_descriptors|flags_slow|p_i->flags;
  }
  stream_open(data_bytes);
  // The near-lossless nibble, four zero bits, is written for a single
  // greyscale plane and for three or more planes -- and not for two, nor for a
  // single palette plane.  The decompiler wrote that as a `goto` into the
  // middle of the `if` from its own `else`, which is one condition with the
  // `||` taken out.
  if( plane_count==1 ? (p_i->depth&depth_grey)!=0 : plane_count>2 ) {
    near_lossless_q = 0;
    pack_bits(0, 4);
  }
  alphabet_reduced = 0;
  write_plane_descs();
  if( filtered ) {
    hdr.flags |= flags_planar;
    uint8_t *plane_buf = (uint8_t*)bmf_new(p_i->width*p_i->height);
    for( int32_t k = 0; k<plane_count; ++k )
      model_planes(p_i, plane_buf, plane_desc[k].src_plane);
    free(plane_buf);
  } else {
    transform_planes(p_i);
  }
}

int32_t compress_image(BmfFile* arc_in, BmfImage* p_i, const CodedTail* extra_blk) {
  BmfImage hdr;
  if( !arc_in->fp )
    return 0;
  // The walk that was here read every member already in the output and left
  // the file positioned after the last, which is where an appended member had
  // to go.  `bmf c` writes the file, so there is nothing in front of this one.
  // The tail bit says a coded block precedes the payload.  This was a `!= 0`
  // into a byte and then an `if` that stored 1 over it when the pointer was
  // non-null -- which is the value the comparison had already put there.
  if( extra_blk )
    p_i->flags |= flags_tail;
  near_lossless_q = 0;
  hdr.header_from(p_i);
  hdr.flags = p_i->flags;
  plane_count = ((p_i->depth&depth_bits)+7)>>3;
  // An image member, version 2.0.  This was an `fwrite` of the first four
  // bytes of `"\x81\x8A" "20\x81\x90" "20a+b"` -- both signatures and three
  // more bytes in one literal, of which only the first four were ever written,
  // so the tag it writes could not be read off the line that writes it.
  const uint32_t tag = bmf_tag(bmf_sig_image, '2', '0');
  if( fwrite(&tag, 4u, 1u, arc_in->fp)!=1 )
    return 0;
  uint8_t bpp = p_i->depth;
  uint32_t pal_bytes = 0;
  if( bpp&depth_palette )
    pal_bytes = 3<<(bpp&31);
  // Anything shorter than the header describing it is not worth coding, and the
  // `goto write_raw` that said so jumped the whole of the block below.
  if( p_i->data_size>=0x10u ) {
    desc_slow_mode = 1;
    hdr.flags |= flags_coded|flags_slow;
    code_image_body(p_i, hdr);
    // Everything coded; flush the packer's last word and decide whether the
    // coded stream is smaller than the pixels it came from.  The byte count was
    // spelled out three times over -- once into `fits`, once into
    // `coded_bytes`, once into the header -- and nothing moves the cursor
    // between them.
    packer_flush();
    const int32_t coded_bytes = stream.cur-stream.buf;
    hdr.data_size = (uint32_t)coded_bytes;
    if( (uint32_t)coded_bytes<p_i->data_size ) {
      const uint8_t ok = write_member_head(&hdr, extra_blk, arc_in->fp);
      int32_t ok_all = (fwrite(stream.buf, 1u, coded_bytes, arc_in->fp)==(uint32_t)coded_bytes)&ok;
      free(stream.buf);
      if( ok_all&&(p_i->depth&depth_palette)!=0 )
        write_all(&p_i->pixels[p_i->data_size], pal_bytes, arc_in->fp);
      fflush(arc_in->fp);
      if( ok_all )
        return (int32_t)hdr.data_size;
      return ok_all;
    }
    free(stream.buf);
    if( p_i->flags&flags_transposed )
      transpose_image(p_i, plane_count);
  }
  // The raw member: the image's own sixteen-byte header, which is the same
  // record laid out the same way, and then the pixels.  The transpose above
  // swaps the header's width, height and stride and leaves the pixel buffer
  // alone, so both ways in write the same bytes -- which is what the `pixels`
  // local said by being assigned the value it already held.
  const uint8_t ok_raw = write_member_head(p_i, extra_blk, arc_in->fp);
  uint32_t written = fwrite(p_i->pixels, 1u, pal_bytes+p_i->data_size, arc_in->fp);
  int32_t data_size = p_i->data_size;
  if( !(ok_raw&(written==data_size+pal_bytes)) )
    return 0;
  return data_size;
}


void bmf_compress(const char* InName, const char* OutName) {
  int32_t i;
  BmfImage *p_i = read_bmp((char*)InName);
  if( !p_i )
    bmf_fatal(bmf_read_error);
  printf("File %16s, image %dx%dx%d, size - %d:", InName, p_i->width, p_i->height, p_i->depth&depth_bits, p_i->data_size);
  // Eight bytes, one per run.  It was a `bmf_new` whose result was handed
  // straight to `bmf_open_file` and never freed.
  static BmfFile arc_store;
  BmfFile* Arc = bmf_open_file(&arc_store, (char*)OutName, 0);
  // `Flags`, in a program whose header has a `flags` byte that is not this
  // one: it is the depth.
  int32_t Depth = p_i->depth;
  if( Depth&depth_palette ) {
    if( Depth&depth_grey ) {
      p_i->depth = Depth^depth_palette;
    } else {
      int32_t Colours = 1<<(Depth&depth_bits);
      int32_t Step = 0x100u>>(Depth&depth_bits);
      const uint8_t* Palette = p_i->palette();
      int32_t Grey = 0;
      for( i = 0; i<Colours; ++i ) {
        if( Palette[3*i]!=Grey||Palette[3*i+1]!=Grey||Palette[3*i+2]!=Grey )
          break;
        Grey += Step;
      }
      if( i>=Colours )
        p_i->depth = (Depth|depth_grey)^depth_palette;
    }
  }
  int32_t coded_len = compress_image(Arc, p_i, coded_block);
  if( !coded_len )
    bmf_fatal(bmf_write_error, OutName);
  printf("%6.3f bpp\n", (double)coded_len*8.0/(double)(p_i->height*p_i->width));
  free(p_i);
}

void bmf_decompress(const char* InName, const char* OutName) {
  BmfFile* arc;
  if( void* nb = bmf_new(sizeof(BmfFile)) )
    arc = bmf_open_file((BmfFile*)nb, (char*)InName, 1);
  else
    arc = nullptr;
  BmfImage* p_i = expand_image(arc, &coded_block);
  // One image in a file: nothing to parse is not the end of a list of members,
  // it is a file that is not one of ours.
  if( !p_i )
    bmf_fatal(bmf_bad_file, InName);
  printf("File %16s, image %dx%dx%d, size - %d\n", InName, p_i->width, p_i->height, p_i->depth&depth_bits, p_i->data_size);
  int32_t Depth = p_i->depth&depth_bits;
  if( Depth==2||Depth==15||Depth==16 ) {
    printf("%s: %d bits per pixel is not a BMP depth\n", OutName, Depth);
    exit(5);
  }
  if( !write_bmp(p_i, (char*)OutName, 1) )
    bmf_fatal(bmf_write_error, OutName);
  free(coded_block);
  coded_block = nullptr;
  free(p_i);
  bmf_close_file(arc);
}


// `argv` is `char**` because that is main's signature and `const char**` inside
// because that is what everything downstream takes.  The donor had two bodies
// here -- one of them four lines that cast and forwarded -- and the cast is all
// that was ever between them.
int32_t main(int32_t argc, char** argv) {
  const char*const* args = (const char*const*)argv;
  bmf_set_denormal_mode();
  printf("BMF lossless image compressor, v.2.01 (C) 1998-1999, 2009 by Dmitry Shkarin\n");
  int32_t mode = argc==4&&!args[1][1] ? toupper(args[1][0]) : 0;
  if( mode!='C'&&mode!='D' ) {
    printf("e-mail: <dmitry.shkarin@mtu-net.ru>;  web: http://compression.graphicon.ru/ds/\n"
           "Usage: bmf c input.bmp output     compress, always with -S -Q9\n"
           "       bmf d input output.bmp     expand\n");
    return 1;
  }
  if( mode=='C' )
    bmf_compress(args[2], args[3]);
  else
    bmf_decompress(args[2], args[3]);
  return 0;
}
