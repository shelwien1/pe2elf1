          }
          idx_t = idx_s;
          cur6c = (PixRec*)row_cur[6];
          g_a = cur6c[-3].match[0];
          g_b = cur6c[-2].match[0];
          g_c = cur6c[2].match[0];
          g_d = cur6c[3].match[0];
          g_ab = g_b+g_a;
          g_e = cur6c[4].match[0];
          up3 = (PixRec*)row_cur[7];
          grad[0] = g_d+g_c+g_ab+g_e-5;
          grad[1] = up3[3].match[0]+up3[2].match[0]+up3[1].match[0]+up3[0].match[0]+(int8_t)up3[-1].match[0]+(int8_t)up3[-2].match[0]+(int8_t)up3[-3].match[0]+up3[4].match[0]-8;
          grad[2] = next[-4].match[1]+next[-3].match[1]-2;
          s1d = nb_sym[1];
          grad[3] = next[-5].match[0]+next[-6].match[0]+next[-7].match[0]+next[-4].match[0]-4;
          next[-1].match[4] = s1d==cur6c[1].sym;
          idx_s = idx_t;
          row_cur[5][-1].match[5] = s1d==row_cur[6][2].sym;
          hit_a = hit;
        }
        if( hit_a )
          return idx_s;
        goto pixel_done;
      }
    }
    freq = &grid[bucket_idx];
    freq_tbl = &grid[id2+188];
    tot = freq_tbl->w[5];
    if( freq_tbl->w[5] ) {
      if( tot==1 ) {
        b15 = freq->b15;
        w2t = b15*freq_tbl->w[2];
        w3t = b15*freq_tbl->w[3];
        nb_sym[1] = b15*freq_tbl->w[0];
        w1s = b15*freq_tbl->w[1];
        nb_sym[2] = w2t;
        w4t = b15*freq_tbl->w[4];
        nb_sym[0] = w3t;
        nb_sym[3] = w4t;
        *freq_tbl = *freq;
        w5 = freq_tbl->w[5];
        w0r = freq_tbl->w[0];
        freq_tbl->b14 *= 8;
        w1r = 21*freq_tbl->w[1];
        nb_sym[1] += (21*w0r+w5-1)/w5;
        freq_tbl->w[0] = nb_sym[1];
        q1 = (w1r+w5-1)/w5;
        w2r = 21*freq_tbl->w[2];
        w3 = freq_tbl->w[3];
        q1w = q1+w1s;
        freq_tbl->w[1] = q1w;
        w3r = 21*w3;
        s0a = nb_sym[0];
        n2r = (w2r+w5-1)/w5+nb_sym[2];
        freq_tbl->w[2] = (uint16_t)n2r;
        span = (w3r+w5-1)/w5+s0a;
        w4r = 21*freq_tbl->w[4];
        freq_tbl->w[3] = span;
        n4r = (w4r+w5-1)/w5+nb_sym[3];
        freq_tbl->w[4] = n4r;
        tot2 = nb_sym[1]+n4r+(span+(uint16_t)n2r+q1w);
        tot = tot2;
        freq_tbl->w[5] = tot2;
      }
      arg_tot = tot;
      target = rc.get_freq(arg_tot);
      cum = freq_tbl->w[0];
      if( cum<=target ) {
        cum += freq_tbl->w[1];
        if( cum<=target ) {
          cum += freq_tbl->w[2];
          if( cum<=target ) {
            cum += freq_tbl->w[3];
            if( cum<=target ) {
              cum += freq_tbl->w[4];
              lvl_a = 4;
            } else {
              lvl_a = 3;
            }
          } else {
            lvl_a = 2;
          }
        } else {
          lvl_a = 1;
        }
      } else {
        lvl_a = 0;
      }
      w6a = freq_tbl->w[6];
      arg_high = cum;
      b15a = freq_tbl->b15;
      arg_cum = cum-freq_tbl->w[lvl_a];
      w5a = freq_tbl->w[5];
      if( w5a>w6a&&(freq_tbl->w[lvl_a]+b15a+8<w5a||freq_tbl->w[5]>0x4000u) ) {
        uint8_t kick = (uint8_t)b15a;
        w5a = freq_tbl->rescale((uint16_t)w6a, kick);
        b15a = kick;
      }
      freq_tbl->w[5] = b15a+w5a;
      freq_tbl->w[lvl_a] += b15a;
      rc.decode(arg_cum, arg_high, arg_tot);
      hit = lvl_a;
      if( freq_tbl->b14 ) {
        --freq_tbl->b14;
        freq2 = freq;
        ++freq->w[5];
        ++freq2->w[lvl_a];
        lvl_a = hit;
      }
    } else {
      arg_tot = freq->w[5];
      target2 = rc.get_freq(arg_tot);
      cum2 = freq->w[0];
      if( cum2<=target2 ) {
        cum2 += freq->w[1];
        if( cum2<=target2 ) {
          cum2 += freq->w[2];
          if( cum2<=target2 ) {
            cum2 += freq->w[3];
            if( cum2<=target2 ) {
              cum2 += freq->w[4];
              lvl_b = 4;
            } else {
              lvl_b = 3;
            }
          } else {
            lvl_b = 2;
          }
        } else {
          lvl_b = 1;
        }
      } else {
        lvl_b = 0;
      }
      b15b = freq->b15;
      arg_high = cum2;
      arg_cum = cum2-freq->w[lvl_b];
      w5b = freq->w[5];
      w6b = freq->w[6];
      nb_sym[3] = b15b;
      if( w5b>w6b&&(freq->w[lvl_b]+nb_sym[3]+8<w5b||w5b>0x4000) ) {
        nb_sym[0] = w6b;
        nb_sym[2] = lvl_b;
        k1 = freq->w[1];
        k2 = freq->w[2];
        k0 = freq->w[0]-(freq->w[0]>>1);
        freq->w[0] = k0;
        k1 = k1-(k1>>1);
        freq->w[1] = k1;
        k2h = k2-(k2>>1);
        k3 = (uint16_t)freq->w[3];
        freq->w[2] = k2h;
        k3 = k3-(k3>>1);
        k4 = (uint16_t)freq->w[4];
        freq->w[3] = k3;
        k4 = k4-(k4>>1);
        freq->w[4] = k4;
        k4 = k0+k4;
        w5b = (uint16_t)(k4+k3+k2h+k1);
