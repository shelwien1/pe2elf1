          *frec = grid[bucket_idx];
          w5 = frec->w[5];
          frec->b14 *= 8;
          acc = 21*frec->w[1];
          nb_sym[0] += (21*frec->w[0]+w5-1)/w5;
          frec->w[0] = nb_sym[0];
          q1 = (acc+w5-1)/w5;
          // `acc` is `21*frec->w[1]` until here, and `q1` above is the last
          // thing to read it whole.  From here down it is sixteen bits: MSVC
          // kept the register and wrote only its low half, and both of the
          // reads that follow are sixteen bits wide -- `frec->w[2]`, and
          // `acc2`, which is an `int16_t`.  So the half the partial store
          // preserved is dead, and this is the assignment it amounts to.
          // (Written the other way first, mask and all: 72 images produce the
          // same streams either way, which is a weaker statement than the
          // types are.)
          acc = (uint16_t)nb_sym[1];
          w2s = 21*frec->w[2];
          w6 = q1+w1s;
          frec->w[1] = w6;
          q2 = (w2s+w5-1)/w5;
          w3s = 21*frec->w[3];
          acc = (uint16_t)(q2+acc);
          frec->w[2] = acc;
          bp = nb_sym[2]+(w3s+w5-1)/w5;
          w4s = 21*frec->w[4];
          frec->w[3] = (uint16_t)bp;
          acc2 = (uint16_t)bp+acc+w6;
          w5 = (w4s+w5-1)/w5+nb_sym[3];
          frec->w[4] = w5;
          grid_kind = (uint16_t)(nb_sym[0]+w5+acc2);
          frec->w[5] = grid_kind;
          rowp = row_cur[5];
        }
        s9 = rowp->sym;
        arg_tot = grid_kind;
        if( s9==nb_sym[8] ) {
          cum1 = frec->w[0];
          lvl_a = 1;
        } else if( s9==nb_sym[10] ) {
          cum1 = frec->w[0]+frec->w[1];
          lvl_a = 2;
        } else if( s9==nb_sym[6] ) {
          cum1 = frec->w[0]+frec->w[2]+frec->w[1];
          lvl_a = 3;
        } else if( s9==nb_sym[5] ) {
          cum1 = frec->w[5]-frec->w[4];
          lvl_a = 4;
        } else {
          cum1 = 0;
          lvl_a = 0;
        }
        w6a = frec->w[6];
        arg_cum = cum1;
        arg_high = frec->w[lvl_a]+cum1;
        w5a = frec->w[5];
        b15a = frec->b15;
        if( w5a>w6a&&(frec->w[lvl_a]+b15a+8<w5a||frec->w[5]>0x4000u) ) {
          uint8_t kick = (uint8_t)b15a;
          w5a = frec->rescale((uint16_t)w6a, kick);
          b15a = kick;
        }
        frec->w[5] = b15a+w5a;
        frec->w[lvl_a] += b15a;
        rc.encode(arg_cum, arg_high, arg_tot);
        hit = lvl_a;
        if( frec->b14 ) {
          --frec->b14;
          binp_s = binp;
          ++binp->w[5];
          ++binp_s->w[lvl_a];
          lvl_a = hit;
        }
      } else {
        // `w` is the union member this was casting to reach.
        wr = grid[bucket_idx].w;
        s9b = rowp->sym;
        arg_tot = binp->w[5];
        if( s9b==nb_sym[8] ) {
          cum2 = *wr;
          lvl_b = 1;
        } else if( s9b==nb_sym[10] ) {
          cum2 = *wr+wr[1];
          lvl_b = 2;
        } else if( s9b==nb_sym[6] ) {
          cum2 = *wr+wr[2]+wr[1];
          lvl_b = 3;
        } else if( s9b==nb_sym[5] ) {
          cum2 = wr[5]-wr[4];
          lvl_b = 4;
        } else {
          cum2 = 0;
          lvl_b = 0;
        }
        arg_cum = cum2;
        arg_high = binp->w[lvl_b]+cum2;
        w5c = binp->w[5];
        w6c = binp->w[6];
        nb_sym[3] = binp->b15;
        if( w5c>w6c&&(binp->w[lvl_b]+nb_sym[3]+8<w5c||w5c>0x4000) ) {
          nb_sym[0] = w6c;
          w1 = binp->w[1];
          g2 = binp->w[2];
          nb_sym[2] = lvl_b;
          g0 = binp->w[0]-(binp->w[0]>>1);
          binp->w[0] = g0;
          w1 = w1-(w1>>1);
          binp->w[1] = w1;
          g2h = g2-(g2>>1);
          g3 = (uint16_t)binp->w[3];
          binp->w[2] = g2h;
          g3 = g3-(g3>>1);
          g4 = (uint16_t)binp->w[4];
          binp->w[3] = g3;
          g4 = g4-(g4>>1);
          binp->w[4] = g4;
          g4 = g0+g4;
          lvl_b = nb_sym[2];
          w5c = (uint16_t)(g4+g3+g2h+w1);
          w5b = nb_sym[0];
          binp->w[5] = w5c;
          if( w5b<256&&!binp->b14 ) {
            w5b = 256;
            binp->w[6] = 256;
          }
          if( w5c>w5b ) {
            s3b = nb_sym[3];
            if( nb_sym[3]<15 )
              s3b = 15;
            nb_sym[3] = s3b;
            binp->b15 = s3b;
          }
        }
        s3 = nb_sym[3];
        binp->w[5] = nb_sym[3]+w5c;
        binp->w[lvl_b] += s3;
        rc.encode(arg_cum, arg_high, arg_tot);
        hit = lvl_b;
        frec->w[5] = (frec->w[lvl_b])++!=0;
        lvl_a = hit;
      }
      if( lvl_a )
        return 1;
      runlen = 0;
    }
    mode = exclusion_gen;
    msym3 = mode_symbol[3];
    excl_sym_a = mode_symbol[2];
    excl_sym_b = mode_symbol[1];
    exclusion_mask[mode_symbol[4]] = exclusion_gen;
    exclusion_mask[msym3] = mode;
    wq = pix_cur;
    exclusion_mask[excl_sym_a] = mode;
    exclusion_mask[excl_sym_b] = mode;
    cache = sym_cache;
    exclusion_mask[no_symbol] = mode;
    runlen_s = runlen;
    sel[0] = nullptr;
    w6d = wq->last;
    wq1 = wq->prev;
    // The same 32 candidates as `decode_pixel`'s, in slot order: 0 and 1 the
    // two most recent symbols at this context, 2..9 the move-to-front cache,
    // 10..31 the spatial neighbours widening outward.  The decompilation
    // interleaved the stores with the loads and named every load.
    r5 = row_cur[5];
    up4 = row_cur[6];
    r6 = row_cur[7];
    r7 = row_cur[8];
    nb_sym[0] = w6d;
    nb_sym[1] = wq1;
    for( int32_t c = 0; c<8; ++c )
      nb_sym[2+c] = cache[c];
    nb_sym[10] = r5[-2].sym;
    nb_sym[11] = up4[2].sym;
    nb_sym[12] = r6[1].sym;
    nb_sym[13] = r6->sym;
    nb_sym[14] = up4[-2].sym;
    nb_sym[15] = r6[-1].sym;
    nb_sym[16] = r5[-3].sym;
    nb_sym[17] = up4[3].sym;
    nb_sym[18] = up4[4].sym;
    nb_sym[19] = r5[-4].sym;
    nb_sym[20] = up4[-3].sym;
    nb_sym[21] = r6[2].sym;
    nb_sym[22] = r7->sym;
    nb_sym[23] = r6[-2].sym;
    nb_sym[24] = r5[-5].sym;
    nb_sym[25] = r7[1].sym;
    nb_sym[26] = up4[5].sym;
    nb_sym[27] = row_cur[9]->sym;
    nb_sym[28] = r5[-7].sym;
    nb_sym[29] = r7[-1].sym;
    nb_sym[30] = up4[7].sym;
    nb_sym[31] = r6[3].sym;
    sym_pos = 0;
    do {
      esym = pixel_context((uint32_t*)nb_sym);
      if( esym>=0 ) {
        up_hit = esym==row_cur[5]->sym;
        (&bit_node[(int32_t)ctr_node])->encode_context_bit(&bit_root[(int32_t)ctr_fallback], up_hit);
        if( up_hit )
          return runlen_s+1;
        exclusion_mask[esym] = exclusion_gen;
      }
      pos1 = sym_pos+1;
      sym_pos = pos1;
    } while( pos1<32 );
    msym1b = mode_symbol[1];
    sel1 = sel1_list;
    sel[0] = &sel0_list[mode_symbol[2]];
    sel_p = sel_cur;
    sel[1] = &sel1[msym1b];
    while( 1 ) {
      if( (*sel_p)->live ) {
        if( (*sel_p)->code_symbol(row_cur[5]->sym) )
          return runlen_s+1;
        sel_p = sel_cur;
      }
      sel_cur = ++sel_p;
    }
  }
};

// bmp.inc -- the BMP file, as this program holds it in memory.

// The two decision bytes.  `depth` is a width in its low six bits and two
// statements about the palette in its top two; `flags` is separate, and its
// 0x40 means something else entirely -- which is why these are named rather
// than left as an 0x40 in each field meaning packed rows in one and a grey
// ramp in the other.
static constexpr uint8_t depth_bits = 0x3F;      // bits per pixel
static constexpr uint8_t depth_grey = 0x40;      // the palette is a grey ramp
static constexpr uint8_t depth_palette = 0x80;   // a palette follows the pixels
static constexpr uint8_t flags_transposed = 0x02;// width and height are swapped
static constexpr uint8_t flags_packed = 0x40;    // rows are packed sub-byte

struct BmfImage {
  uint16_t width;
  uint16_t height;
  uint32_t stride;
  uint8_t _pad8[2];
  uint8_t depth;
  uint8_t flags;
  uint32_t data_size;
  uint8_t pixels[0];

  // The palette, when `depth & 0x80` says there is one: it sits immediately
  // after the pixels.  Four sites spelled this `(uint8_t*)img + data_size+16`,
  // where the 16 is `sizeof(BmfImage)` -- the header this same block starts
  // with, so `pixels` already is it.
  uint8_t* palette() { return pixels+data_size; }
  const uint8_t* palette() const { return pixels+data_size; }
};

// Transpose the header.  The loop at each call site has already moved the
// pixels; this swaps the two dimensions that describe them, recomputes the
// stride, and flips bit 1 of `flags`, which is the record that it happened.
//
// Open-coded at five sites, in two spellings that are not obviously the same
// store: three wrote `*(uint16_t*)&img->stride`, which leaves the top half of
// the 32-bit field alone, and two assigned the whole word.  What makes them
// one function is that the *value* is sixteen bits wide at all five -- it goes
// through a `uint16_t` or `int16_t` temporary before the store every time, and
// the reads on these paths are `(uint16_t)img->stride` to match.  A stride
// that did not fit in sixteen bits would already be wrong here in the
// original; given that it fits, zeroing the top half and leaving it alone are
// the same thing, and the whole-word store is the one that says so.
static inline void transpose_image_in_place(BmfImage* img, int32_t planes) {
  uint16_t w = img->width;
  img->width = img->height;
  img->height = w;
  img->flags ^= 2u;
  img->stride = (uint16_t)(img->width*planes);
}

// The allocation is one block: a sixteen-byte `BmfImage`, the pixels, and the
// palette after them if there is one.
//
// It used to build the header's `(pad, pad, depth, flags)` word by arithmetic
// -- `bpp<<16` for `depth`, `0x40000000` for `flags & 0x40` (rows are sub-byte
// packed), `0x00800000` for `depth & 0x80` (a palette follows) -- and store it
// through `result[2]`, because the original wrote it as one store.  The two
// decision bytes are written as themselves now, which is also what let the
// return type stop being `int32_t*`.
BmfImage*alloc_image(int32_t img_w, int32_t img_h, int32_t bpp, int32_t palette, int32_t packed) {
  int32_t bits, row_pack, row_bytes, pal_bytes;
  uint16_t row16;
  bool sub_byte_rows = false;
  row16 = img_w;
  bits = bpp;
  if( bpp>=5&&bpp<=7 ) {
    row_bytes = row16;
  } else {
    if( bpp==3 )
      bits = 4;
    else if( !packed )
      bits = bpp>4 ? bpp : 4;
    bool byte_rows = bpp!=3&&bits>=8;
    if( !packed ) {
      if( !byte_rows&&bits==4 )
        row16 = ((img_w+7)>>1)&0xFFFC;
      else
        row16 = (uint16_t)(((bits+7)>>3)*img_w);
      row_bytes = row16;
    } else if( byte_rows ) {
      row16 = (uint16_t)(((bits+7)>>3)*img_w);
      row_bytes = row16;
    } else {
      if( bits==1 ) {
        row_pack = (int32_t)(((uint32_t)((img_w+7)>>2)>>29)+img_w+7)>>3;
      } else if( bits==2 ) {
        row_pack = (int32_t)(((uint32_t)((img_w+3)>>1)>>30)+img_w+3)>>2;
      } else {
        row_pack = (int32_t)(img_w+((uint32_t)(img_w+1)>>31)+1)>>1;
      }
      sub_byte_rows = true;
      row_bytes = (uint16_t)row_pack;
    }
  }
  int32_t data_bytes = row_bytes*img_h;
  bool has_palette = false;
  if( palette&&bpp<=8 ) {
    pal_bytes = 3<<(bpp&31);
    has_palette = true;
  } else {
    pal_bytes = 0;
  }
  // 19, not 16: three bytes of slop past the header, pixels and palette, which
  // the original allocated and this keeps.
  BmfImage* img = (BmfImage*)bmf_new(data_bytes+pal_bytes+19);
  if( !img )
    return nullptr;
  img->width = img_w;
  img->height = img_h;
  img->stride = row_bytes;
  img->_pad8[0] = 0;
  img->_pad8[1] = 0;
  img->depth = (uint8_t)(bpp|(has_palette ? 0x80 : 0));
  img->flags = sub_byte_rows ? 0x40 : 0;
  img->data_size = data_bytes;
  // The clear used to be guarded by `depth & 0x80`, with a `nullptr` for the
  // other arm -- and reaching it needed `pal_bytes` non-zero, which is exactly
  // when that bit was just set.  The guard could not be false and the `nullptr`
  // could not be passed to `memset`.
  if( pal_bytes )
    memset(img->palette(), 0, pal_bytes);
  return img;
}

#pragma pack(push, 1)
struct BmpHeader {
  uint16_t bfType;
  uint32_t bfSize;
  uint16_t bfReserved1;
  uint16_t bfReserved2;
  uint32_t bfOffBits;
  uint32_t biSize;
  int32_t biWidth;
  int32_t biHeight;
  uint16_t biPlanes;
  uint16_t biBitCount;
  uint32_t biCompression;
  uint32_t biSizeImage;
  int32_t biXPelsPerMeter;
  int32_t biYPelsPerMeter;
  uint32_t biClrUsed;
  uint32_t biClrImportant;
};
#pragma pack(pop)

static inline int32_t bmf_pixels(const BmfImage* img) {
  return img->width*img->height;
}

// file.inc -- the file at each end: one image out, one image in.
//
// This was an archive.  The donor put several images in one file -- its command
// line took a list and appended each to the archive named by `-o` -- and the
// reader walked the members until one failed to parse.  `bmf c in.bmp out`
// writes one image and `bmf d in out.bmp` reads one, so the walk, the append
// point it existed to find, and the member count are all gone.  What is left is
// the handle and the two ways of opening it.

struct BmfFile {
  FILE* fp;
  // Both returns were the same constant -- `nullptr` on the branch that
  // closes, and `f` on the branch where `f` is already null -- and the one
  // caller discarded it.  It also left `fp` pointing at a closed `FILE`, which
  // was harmless only because that caller frees the struct immediately.
  // Close the input and give up.  Eleven sites in `image_expand` wrote
  // `fclose(arc->fp); arc->fp = 0; return nullptr;` out, which is eleven places
  // a reader had to check the file was actually closed.
  BmfImage* fail() {
    close();
    return nullptr;
  }

  void close() {
    if( fp ) {
      fseek(fp, 0, SEEK_END);
      fclose(fp);
      fp = nullptr;
    }
  }
};

BmfFile*bmf_close_file(BmfFile* arc, int8_t do_free) {
  arc->close();
  if( do_free&1 )
    free(arc);
  return arc;
}

static uint32_t bytes_left(FILE* fp) {
  long here = ftell(fp);
  if( here<0||fseek(fp, 0, SEEK_END)!=0 )
    return 0;
  long end = ftell(fp);
  if( end<0||fseek(fp, here, SEEK_SET)!=0 )
    return 0;
  return (uint32_t)(end-here);
}

BmfFile*bmf_open_file(BmfFile* out, char* path, int32_t read_only) {
  // `wb` to write and `rb` to read.  The donor opened `a+b` -- read *and*
  // append -- because it had members already there to walk past; there is one
  // image in a file now, so writing never reads and reading never writes.
  out->fp = fopen(path, read_only ? "rb" : "wb");
  if( !out->fp )
    bmf_fatal(bmf_no_open, path);
  return out;
}

// rc_io.inc -- the range coder's file ends -- what it writes before a stream and what
// it reads after one.  The coder itself is rc.inc.

uint32_t rc_decode_flat(uint32_t tot) {
  uint32_t sym = rc.get_freq(tot);
  rc.decode(sym, sym+1, tot);
  return sym;
}

// Give back what `begin_plane_stream` took.  This is the model layer's, not
// the coder's -- `rc_end` was doing both jobs and only one of them is range
// coding.
static void end_plane_stream() {
  if( plane_alt_model )
    free(model_tables);
}

// The two ends differ in one call: the encoder flushes what it still holds and
// the decoder reads to the marker.  Everything after is the same tear-down.
template<int32_t f_DEC>
void rc_end() {
  if( f_DEC )
    rc.finish();
  else
    rc.flush();
  end_plane_stream();
}

void rc_end_decode() {
  rc_end<1>();
}

void rc_end_encode() {
  rc_end<0>();
}

// Back the output cursor off the packer's partial word.
//
// The packer writes 32 bits at a time and the coder starts at a byte, so
// whatever whole bytes the last word did not need are given back here, one at
// a time, and `stream.pk.free_bits` is left holding what is still owed.  It goes
// transiently negative on the way, which is the thing to know about it.
static void packer_rewind() {
  if( stream.cur==(uint8_t*)stream.pk.word )
    return;
  int32_t bits = stream.pk.free_bits-8;
  if( bits<0 ) {
    stream.pk.free_bits = bits;
    return;
  }
  uint8_t* at = stream.cur;
  do {
    --at;
    bits -= 8;
  } while( bits>=0 );
  stream.cur = at;
  stream.pk.free_bits = bits;
}

// Everything an alternate model needs before its first symbol: the residual
// alphabet's two limits, the symbol tree's level geometry, and 1024 seeded
// frequency strips.  None of it is range coding -- `rc_begin` was doing this
// and the coder's own init in one function, which is why it was 90 lines.
static uint16_t* begin_plane_stream() {
  if( plane_predictor==2 ) {
    alt_freq_init = 8;
    alt_freq_limit = 8;
  } else {
    alt_freq_limit = 16;
    alt_freq_init = 64;
  }
  // Six levels of a binary symbol tree, laid out end to end.  Level `lvl`
  // holds `2^(lvl-2)` pairs, starts at `first`, and its frequency table
  // starts at `first - lvl` -- except level 2, whose base is 0 rather than
  // -2, and levels 2 and 3, whose `first` the original wrote as constants
  // because the recurrence has not started yet.  `model_geometry[i]` is the
  // level that owns slot `i`.
  //
  // The decompilation wrote all six out, with `at4`..`at7` naming the running
  // offset at four of them and the other two folded into constants.
  model_geometry[0] = 0;
  model_geometry[1] = 1;
  level_geom[2].half = 1;
  level_geom[2].first = 2;
  level_geom[2].tbl_base = 0;
  memset(&model_geometry[2], 2, 2);
  int32_t slot = 4;
  for( int32_t lvl = 3; lvl<8; ++lvl ) {
    level_geom[lvl].half = 1<<(lvl-2);
    level_geom[lvl].first = (uint8_t)slot;
    level_geom[lvl].tbl_base = (uint8_t)slot-lvl;
    memset(&model_geometry[slot], lvl, 2*level_geom[lvl].half);
    slot += 2*level_geom[lvl].half;
  }
  uint16_t* tbl = (uint16_t*)bmf_new(0x7F000u);
  if( tbl ) {
    int32_t k = 0;
    uint16_t *row = tbl;
    do {
      row[1] = 24*alt_freq_limit;
      row[2] = 205;
      row[6] = 48;
      row[3] = 124;
      row[7] = 16;
      row[4] = 147;
      row[5] = 83;
      row[8] = 8;
      row[9] = 4;
      *row = 635;
      FreqPair* seed = (FreqPair*)&row[10];
      for( uint32_t i = 0; i<0x7A; ++i ) {
        seed[i].f[0] = 60;
        seed[i].f[1] = 36;
      }
      row += 254;
      ++k;
    } while( (uint32_t)k<0x400 );
  }
  model_tables = tbl;
  return tbl;
}

// The two heads of a stream, and the three steps are three functions now: give
// the packer's spare bytes back, set the model up if the header named one, and
// start the coder.
//
// Three things are genuinely one-sided and each is under `f_DEC`: the encoder
// flushes the packer's accumulator into the stream first, the encoder's counter
// runs forward and the decoder's back, and the coder is initialised for the
// direction it is about to run in.
//
// It used to return `tbl` *uninitialised* when `plane_alt_model` was clear,
// with a comment that the one caller reads it only under the same flag.  It
// returns null there instead: that is what the caller behaves as if it got,
// and it is not undefined.
template<int32_t f_DEC>
uint16_t*rc_begin() {
  if( !f_DEC )
    *stream.pk.word = stream.pk.acc;
  packer_rewind();
  uint16_t* tbl = plane_alt_model ? begin_plane_stream() : nullptr;
  if( f_DEC )
    rc.dec_init();
  else
    rc.enc_init();
  return tbl;
}

uint16_t*rc_begin_encode() {
  return rc_begin<0>();
}

void rc_begin_decode() {
  rc_begin<1>();
}

static uint32_t packer_word() {
  if( stream.cur+4>stream.buf+stream.size )
    bmf_fatal(bmf_read_error);
  uint32_t w = *(uint32_t*)stream.cur;
  stream.cur += 4;
  return w;
}

// Rewind the packer to the start of the coded buffer.  `search_filter` encodes
// the same tile once per candidate flag and measures the bytes each time, so it
// does this between every trial; seven sites wrote all five lines out, and the
// fifth -- `hist_scratch`, which is a *different* buffer's cursor that happens
// to live at the far end of this one -- is the one a reader has to remember is
// part of the reset.
static void packer_reset() {
  stream.pk.free_bits = 0;
  stream.pk.acc = 0;
  stream.cur = stream.buf;
  stream.pk.word = (uint32_t*)stream.buf;
  hist_scratch = stream.buf+stream.size-4096;
}

// The header's bit stream: the per-plane descriptors, a few bits at a time,
// through a 32-bit accumulator that spills to `stream.pk.word` when it fills.
//
// `compress_image` wrote this out six times and `expand_image` its mirror six
// times, at widths 4, 6 and 8.  What made the six copies look unlike each other
// was the count: it was kept in `bits_left`, `free_bits` or `stream.pk.free_bits`
// depending on the site, and every spill branch read the guard variable in one
// place and `stream.pk.free_bits` in another.  They agreed because the line before
// each block assigned one from the other; here there is one name and nothing to
// keep in step.
//
// The order below is the one thing to preserve when reading this against the
// original: the spill branch's `stream.pk.acc` is computed from the count *before*
// the count moves on.  Writing the count first would shift the carry-out by the
// width.
static void pack_bits(uint32_t word, int32_t n) {
  if( stream.pk.free_bits<n ) {
    *(uint32_t*)stream.pk.word = stream.pk.acc|(2*(word<<((31-stream.pk.free_bits)&31)));
    stream.pk.word = (uint32_t*)stream.cur;
    stream.cur += 4;
    stream.pk.acc = word>>(stream.pk.free_bits&31);
    stream.pk.free_bits += 32-n;
  } else {
    stream.pk.acc |= word<<(-stream.pk.free_bits&31);
    stream.pk.free_bits -= n;
  }
}

static uint32_t unpack_bits(int32_t n) {
  const uint32_t mask = (1u<<n)-1;
  uint32_t v;
  stream.pk.free_bits -= n;
  if( stream.pk.free_bits<0 ) {
    const uint32_t w = packer_word();
    v = stream.pk.acc|(w<<((stream.pk.free_bits+n)&31))&mask;
    stream.pk.acc = w>>(-stream.pk.free_bits&31);
    stream.pk.free_bits += 32;
  } else {
    v = stream.pk.acc&mask;
    stream.pk.acc = stream.pk.acc>>n;
  }
  return v;
}

// sym_code.inc -- the symbol trees: a symbol through a tree of binary counters, both
// ways, for both models.

// One symbol out of a level's tree.  The two directions meet at `lvl`, the slot
// in the level frequencies: the encoder is handed a symbol and looks its level
// up in `model_geometry`, the decoder walks the same frequencies until it
// passes the point the coder gave it.  From there the rescale, the escape
// counter and the walk down the binary tree are the same code.
//
// The guard on the walk reads `lvl >= 2` for both, where the encoder said
// `sym >= 2`.  They are the same test: `model_geometry` is 0 at 0, 1 at 1 and
// 2 or more everywhere above -- rc_begin lays it out that way -- so a symbol
// below two has its own index as its level, which is also what the decoder
// returns for those two.
//
// The rescale halves freq[2..9] and leaves the sum in *freq, and the two bodies
// did it with the loads and stores interleaved differently and different
// intermediates -- acc6/acc8/h9 against sum6/h6/h8, some int16_t and some
// uint16_t.  It is the same sum: every intermediate is 16 bits wide and the
// result is stored through a uint16_t, so the orderings agree in the low 16
// bits, which is all of them that survive.  The encoder's spellings are kept.
template<int32_t f_DEC>
int32_t code_symbol_tree(uint16_t* freq, int32_t sym) {
  uint16_t add;
  uint32_t cum, j;
  int32_t lvl, result, go, path, node, span;
  uint16_t fq, *slot;
  uint16_t h9, acc8, acc6, acc;
  uint16_t *f0 = freq+2;
  uint32_t tot = *freq;
  if( f_DEC ) {
    uint32_t target = rc.get_freq(tot);
    slot = f0;
    lvl = 0;
    cum = *f0;
    if( cum<=target ) {
      do {
        ++slot;
        ++lvl;
        cum += *slot;
      } while( cum<=target );
    }
    rc.decode(cum-*slot, cum, tot);
  } else {
    lvl = model_geometry[sym];
    cum = 0;
    for( j = 0; j<(uint32_t)lvl; j++ )
      cum += f0[j];
    slot = &f0[lvl];
    uint32_t cum_hi = cum+*slot;
    result = rc.encode(cum, cum_hi, tot);
  }
  if( *freq>0x4000u ) {
    uint16_t h2 = *(freq+2)-(*(freq+2)>>1);
    acc = *(freq+3);
    *(freq+2) = h2;
    acc = acc-(acc>>1);
    *(freq+3) = acc;
    acc = h2+acc;
    uint16_t h4 = *(freq+4)-(*(freq+4)>>1);
    *(freq+4) = h4;
    int16_t sum4 = acc+h4;
    acc = *(freq+5)-(*(freq+5)>>1);
    acc6 = *(freq+6);
    *(freq+5) = acc;
    acc6 = acc6-(acc6>>1);
    *(freq+6) = acc6;
    acc6 = sum4+acc+acc6;
    acc = *(freq+7)-(*(freq+7)>>1);
    acc8 = *(freq+8);
    *(freq+7) = acc;
    acc = acc6+acc;
    acc8 = acc8-(acc8>>1);
    h9 = *(freq+9);
    *(freq+8) = acc8;
    acc8 = acc+acc8;
    h9 = h9-(h9>>1);
    int32_t esc = *(freq+1);
    *(freq+9) = h9;
    *freq = acc8+h9;
    if( esc<=4*alt_freq_limit ) {
      result = 4*(esc>alt_freq_limit);
      add = esc-result;
      *(freq+1) = esc-result;
    } else {
      add = esc-16;
      *(freq+1) = esc-16;
    }
  } else {
    add = *(freq+1);
  }
  *slot += add;
  *freq += *(freq+1);
  if( lvl<2 )
    return lvl;
  int32_t mask = level_geom[lvl].half;
  if( !f_DEC )
    path = sym-level_geom[lvl].first;
  node = 0;
  for( span = 1;; span *= 2 ) {
    FreqPair *pair = bit_tree(freq, lvl)+span+node;
    int32_t f1 = pair->f[1];
    int32_t fa = pair->f[0];
    if( f_DEC ) {
      go = rc.decode_bit(fa, f1);
    } else {
      go = (mask&path)!=0;
      result = rc.encode_bit(fa, f1, go);
    }
    fq = pair->f[go];
    if( fq>0x4000u ) {
      uint32_t f1_old = pair->f[1];
      pair->f[0] -= pair->f[0]>>1;
      pair->f[1] = f1_old-(f1_old>>1);
      fq = pair->f[go];
    }
    pair->f[go] = alt_freq_init+fq;
    mask >>= 1;
    node = go+2*node;
    if( !mask )
      return node+level_geom[lvl].first;
  }
}

void encode_symbol_tree(uint16_t* freq, int32_t sym) {
  code_symbol_tree<0>(freq, sym);
}

int32_t decode_symbol_tree(uint16_t* freq) {
  return code_symbol_tree<1>(freq, 0);
}

// One symbol of the one-bit model's alphabet.  The two directions meet at the
// slot: the encoder is given a symbol, maps it to a slot and sums the
// frequencies below it; the decoder is given a point in the range and walks the
// same frequencies until it passes it.  Everything after -- the rescale at
// 0x2000, the +32 on the slot and the total, the escape into the binary tree
// for slots 5 and up -- is the same code, and was written twice.
//
// `slot` is `cur - base` in both, which is why the tail can be shared: the
// encoder's `cur = &base[slot]` and the decoder's walk leave it in the same
// place.  The decoder folds the tree's answer back into the slot; the encoder
// sends it and has nothing to fold.
//
// The two bodies differed in a handful of casts as well -- `(uint16_t)freq[1]`
// against `freq[1]`, `int16_t tot_new` against `int32_t result`.  None of them
// is a difference: `freq` is `uint16_t *`, so the casts are the promotion that
// was already happening, and the two totals agree in the low 16 bits that
// `*freq` and `& 0x7FFF` keep.  The encoder's spellings are the ones kept.
template<int32_t f_DEC>
int32_t CounterNode::code_symbol(int32_t ctx, int32_t sym) {
  uint32_t cum;
  int32_t slot;
  uint16_t *cur = c;
  const uint32_t tot = total&0x7FFF;
  if( f_DEC ) {
    sym = rc.get_freq(tot);
    cum = c[0];
    while( cum<=(uint32_t)sym )
      cum += *++cur;
    rc.decode(cum-*cur, cum, tot);
  } else {
    slot = 6-(sym&1);
    if( sym<5 )
      slot = sym;
    cum = 0;
    for( int32_t k = 0; k<slot; k++ )
      cum += c[k];
    cur = &c[slot];
    rc.encode(cum, cum+*cur, tot);
  }
  // Halve or third every counter once the total passes 0x2000, and start the
  // new total at 0x8000 -- the top bit is the flag `tot` masks off above.
  //
  // The decompilation wrapped this in two comparisons and a `done` flag:
  // `freq+7 < base` and `freq+7 >= base` with `base = freq+1`, which are
  // `false` and `true` for any pointer.  Both loops always ran; the flag was
  // MSVC's register for a branch it had already decided.
  if( tot>0x2000 ) {
    total = 0x8000;
    int32_t lo = 256;
    for( int32_t k = 6; k>=0; --k )
      if( c[k]<lo )
        lo = c[k];
    for( int32_t k = 6; k>=0; --k ) {
      const uint16_t nf = lo<=1 ? c[k]-(c[k]>>1) : (c[k]+2)/3;
      c[k] = nf;
      total += nf;
    }
  }
  *cur += 32;
  const int32_t result = total+32;
  total = result;
  slot = cur-c;
  if( slot>=5 ) {
    uint16_t*const strip = model_strip(128*(uint32_t)(slot&1)
        +((((c[0]+(result&0x7FFF)+96-2*(uint32_t)c[slot])>>25)&0xFFFFFFC0)
          +(uint32_t)ctx));
    if( f_DEC )
      slot += 2*decode_symbol_tree(strip);
    else
      encode_symbol_tree(strip, (sym-5)>>1);
  }
  return slot;
}

// The donor pushed a third argument neither body reads.  `tools/deadparam.py`
// took it and the two it was forwarded from.
void alt_p1_encode_symbol(CounterNode* node, int32_t ctx, int32_t sym) {
  node->code_symbol<0>(ctx, sym);
}

int32_t alt_p1_decode_symbol(CounterNode* node, int32_t ctx) {
  return node->code_symbol<1>(ctx, 0);
}



int32_t update_binary_pair(uint16_t* _this, int32_t symbol) {
  int32_t tot, node;
  uint32_t step, f;
  tot = *_this;
  if( (uint32_t)tot<=0x8000 ) {
    int32_t lvl = model_geometry[symbol];
    step = (_this[1]>>2)&0xFFFFFFE0;
    if( plane_predictor==2 )
      step = 15*(_this[1]>>5);
    *(_this+lvl+2) += step+4;
    tot = *_this+step+4;
    *_this = tot;
    if( symbol>=2 ) {
      int32_t mask = level_geom[lvl].half;
      int32_t path = symbol-level_geom[lvl].first;
      node = 0;
      FreqPair *tbl = bit_tree(_this, lvl);
      int32_t span = 1;
      do {
        FreqPair *pair = tbl+node+span;
        int32_t go = (mask&path)!=0;
        f = pair->f[go];
        if( f>0x2000 ) {
          uint32_t f1_old = pair->f[1];
          pair->f[0] -= pair->f[0]>>1;
          pair->f[1] = f1_old-(f1_old>>1);
          f = pair->f[go];
        }
        span *= 2;
        mask >>= 1;
        node = go+2*node;
        pair->f[go] = f+((alt_freq_init*((uint32_t)(plane_predictor==2)+5))>>3);
      } while( mask );
      return 0;
    }
  }
  return tot;
}

// The histogram's entropy, in bits, as one number:
//
//     (N*ln N - sum of n_i*ln n_i) * log2(e)
//
// which is `N * H(p)` -- the total cost of coding N symbols with these
// frequencies, not the per-symbol cost.  Both decision bodies compare
// candidates through this and nothing else.
//
// The two accumulators over even and odd bins are the original's pairing, for
// a two-lane SSE add that is not here any more; they change the rounding of
// the sum and nothing else.
int32_t estimate_cost(uint8_t* bins, int32_t n) {
  const int32_t* bin = (const int32_t*)bins;
  double sum_even = 0.0, sum_odd = 0.0, ent_even = 0.0, ent_odd = 0.0;
  double total;
  int32_t i;
  for( i = 0; i+1<n; i += 2 ) {
    if( bin[i] ) {
      sum_even += (double)bin[i];
      ent_even += (double)bin[i]*log((double)bin[i]);
    }
    if( bin[i+1] ) {
      sum_odd += (double)bin[i+1];
      ent_odd += (double)bin[i+1]*log((double)bin[i+1]);
    }
  }
  double entropy = ent_even+ent_odd;
  total = sum_even+sum_odd;
  for(; i<n; i++ )
    if( bin[i] ) {
      total += (double)bin[i];
      entropy += (double)bin[i]*log((double)bin[i]);
    }
  if( total!=0.0 )
    total = total*log(total);
  return (int32_t)((total-entropy)*1.442695040888963);
}

// sym_list_decode.inc -- read back the alphabet an encoder wrote.

int32_t decode_symbol_list(SymList* syms) {
  struct alignas(16) DecodeSymbolListFrame {
    union {
      SymEntry* list[8192];
      struct {
        uint32_t list0;
        BMF_SPILL_PAD(l0);
        SymEntry* list1;
        uint32_t list2;
        BMF_SPILL_PAD(l2);
        int32_t list3;
        BMF_SPILL_PAD(l3);
        int32_t list4;
        BMF_SPILL_PAD(l4);
        uint32_t list5;
        BMF_SPILL_PAD(l5);
        SymEntry* list6;
        int32_t list7;
        BMF_SPILL_PAD(l7);
        SymEntry* list_tail[8184];
      };
    };
    uint8_t _pad1[32];
  } frame;
  int32_t tot, tot0;
  SymEntry *ent, *p, *q, *head, *cur, *prev, *up, *back;
  SymEntry** w, ** rd, ** rd2;
  uint32_t cum_lo, sym_cum, sym_high, cum_hi;
  int32_t tot_1, tot_all, target;
  int32_t live, cum, i, c, top, half, back_cnt, last_cnt;
  uint32_t n_left, zeros;
  uint32_t list5_s, rescale_at, limit20, running, since_rescale;
  live = syms->live;
  ent = syms->ent;
  w = frame.list;
  uint32_t gen = (uint8_t)exclusion_gen;
  SymList* owner = syms;
  cum = 0;
  i = 0;
  do {
    if( (uint8_t)exclusion_mask[ent[i].sym]==gen ) {
      c = 0;
    } else {
      SymEntry *e = &ent[i];
      c = e->cnt;
      *w++ = e;
    }
    cum += c;
    ++i;
  } while( i<live );
  if( !cum )
    return -1;
  *w = nullptr;
  tot0 = owner->tot;
  tot_all = cum+tot0;
  target = rc.get_freq(tot_all);
  tot = cum+tot0;
  p = frame.list[0];
  rd = &frame.list[1];
  SymEntry* first = frame.list[0];
  cum_lo = 0;
  while( 1 ) {
    cum_lo += p->cnt;
    if( cum_lo>(uint32_t)target )
      break;
    p = *rd++;
    if( !p ) {
      int8_t gen_b = (int8_t)gen;
      sym_cum = cum_lo;
      cum_hi = tot;
      sym_high = tot;
      q = first;
      rd2 = &frame.list[1];
      do {
        exclusion_mask[q->sym] = gen_b;
        q = *rd2++;
      } while( q );
      tot_1 = tot;
      frame.list7 = -1;
      {
        rc.decode(cum_lo, cum_hi, tot_1);
        return frame.list7;
      }
    }
  }
  sym_high = cum_lo;
  sym_cum = cum_lo-p->cnt;
  frame.list7 = p->sym;
  p->cnt += 4;
  head = owner->ent;
  owner->since_rescale += 4;
  if( p==head ) {
    top = p->cnt;
  } else {
    uint8_t c_a = p->cnt;
    uint16_t s_a = p->sym;
    SymEntry *q2 = p-1;
    *p = *q2;
    q2->set(s_a, c_a);
    head = owner->ent;
    if( q2==head ) {
      top = q2->cnt;
    } else {
      frame.list5 = list5_s;
      while( 1 ) {
        top = q2->cnt;
        SymEntry *r = q2-1;
        if( top<=r->cnt )
          break;
        uint16_t s_b = q2->sym;
        uint8_t c_b = q2->cnt;
        *q2 = *r;
        r->set(s_b, c_b);
        head = owner->ent;
        --q2;
        if( r==head ) {
          list5_s = frame.list5;
          top = r->cnt;
          goto next_symbol;
        }
      }
      list5_s = frame.list5;
    }
  }
next_symbol:
  rescale_at = owner->rescale_at;
  if( top>251||rescale_at<owner->since_rescale ) {
    frame.list0 = owner->live;
    limit20 = 20*owner->n;
    n_left = frame.list0;
    frame.list5 = list5_s;
    frame.list4 = rescale_at<limit20;
    cur = head-1;
    do {
      prev = cur;
      ++cur;
      half = (frame.list4+(uint32_t)cur->cnt)>>1;
      cur->cnt = half;
      if( cur!=owner->ent ) {
        up = cur-1;
        frame.list3 = up->cnt;
        if( half>frame.list3 ) {
          frame.list2 = cur->sym;
          cur->set(up->sym, frame.list3);
          if( up!=owner->ent ) {
            (frame.list[1]) = cur;
            frame.list0 = n_left;
            do {
              back = up-1;
              back_cnt = back->cnt;
              if( half<=back_cnt )
                break;
              up->set(back->sym, back_cnt);
              --up;
            } while( back!=owner->ent );
            cur = frame.list[1];
            n_left = frame.list0;
          }
          up->set(frame.list2, half);
        }
      }
      --n_left;
    } while( n_left );
    list5_s = frame.list5;
    running = owner->tot;
    frame.list0 = 0;
    if( !cur->cnt ) {
      zeros = frame.list0;
      do {
        ++zeros;
        owner->tot = ++running;
        last_cnt = prev->cnt;
        --prev;
      } while( !last_cnt );
      frame.list0 = zeros;
      owner->live -= zeros;
    }
    since_rescale = owner->since_rescale;
    owner->tot = running-(running>>1);
    cum_lo = sym_cum;
    cum_hi = sym_high;
    tot_1 = tot_all;
    owner->since_rescale = since_rescale-(since_rescale>>1);
  } else {
    tot_1 = tot_all;
    cum_lo = sym_cum;
    cum_hi = sym_high;
  }
  rc.decode(cum_lo, cum_hi, tot_1);
  return frame.list7;
}

// model_workspace.inc -- the main model's workspace: how it is laid out and how it is given
// back.

// One bank of symbol lists, and the block behind it.  Written out twice, once
// for each of the two banks, ten lines apart.
static void free_sym_lists(SymList* lists) {
  if( !lists )
    return;
  uint32_t n = sym_list_count(lists);
  for( SymList* p = &lists[n]; p>lists; )
    free((--p)->ent);
  free(sym_list_block(lists));
}

// Returns nothing.  It returned `(void**)this` -- after `free(this)` on the
// path that takes it, so the value was a dangling pointer -- and neither of the
// two callers reads it.  Third of its kind in this tree: `alt_p1_free` and
// `alt_model_p1_d8_decode` were the first two, and the decompiler writes the
// register that happened to hold `this` as a return value wherever MSVC left
// it there.
void ModelBlock::free_workspace(int8_t do_free) {
  int32_t i;
  free(sym_code);
  free(sym_word);
  free(run_bucket);
  free(alpha_map);
  free_sym_lists(sel1_list);
  free_sym_lists(sel0_list);
  for( i = 0; i<5; ++i )
    free(row_cur[i]);
  free(escape.ent);
  if( do_free&1 )
    free(this);
}

ModelBlock*ModelBlock::layout_workspace(int32_t img_w, int32_t img_h, int32_t img_depth) {
  uint32_t w;
  int32_t j;
  uint32_t k, m, s, n;
  w = img_w;
  exclusion_gen = 1;
  width = img_w;
  height = img_h;
  depth = img_depth;
  depth_raw = img_depth;
  escape.ent = nullptr;
  sym_code = nullptr;
  for( j = 0; j<5; ++j ) {
    PixRec* buf = (PixRec*)bmf_new(sizeof(PixRec)*(w+16));
    row_cur[j] = buf;
    row_cur[j+5] = buf+8;
    w = width;
    if( (int32_t)width>-16 ) {
      int32_t r = 0;
      do {
        row_cur[j][r].sym = 0;
        row_cur[j][r].match[5] = 1;
        row_cur[j][r].match[4] = 1;
        row_cur[j][r].match[3] = 1;
        row_cur[j][r].match[2] = 1;
        row_cur[j][r].match[1] = 1;
        row_cur[j][r].match[0] = 1;
        w = width;
        ++r;
      } while( (uint32_t)r<width+16 );
    }
  }
  uint8_t* runs = (uint8_t*)bmf_new(w+1);
  run_bucket = runs;
  *runs = 0;
  if( (int32_t)width>0 ) {
    uint8_t bucket = 0;
    int32_t x = 0;
    do {
      bucket += x==2<<(bucket&31);
      run_bucket[x+++1] = bucket;
    } while( (uint32_t)x<width );
  }
  __builtin_memset(sym_rev, 0, sizeof sym_rev);
  for( k = 0; k<0x2000; ++k ) {
    uint16_t rev = sym_rev[k];
    int32_t bits = k;
    for( m = 0; m<0xD; ++m ) {
      rev += rev+(bits&1);
      bits >>= 1;
    }
    sym_rev[k] = rev;
  }
  for( s = 0; s<0x2000; ++s )
    sym_rev[s] *= 8;
  memset(&grid[188], 0, 0x100000);
  ctx_id3_used = 0;
  ctx_id2_used = 0;
  ctx_id1_used = 0;
  memset(ctx_id1, 255, sizeof ctx_id1);
  memset(ctx_id2, 255, sizeof ctx_id2);
  memset(ctx_id3, 255, sizeof ctx_id3);
  memset(exclusion_mask, 0, sizeof exclusion_mask);
  sel[0] = nullptr;
  sel[1] = nullptr;
  escape_list = nullptr;
  for( n = 0; n<0x40000; ++n ) {
    sym_ctr[2*n] = no_symbol;
    sym_ctr[2*n+1] = no_symbol;
  }
  uint32_t i8 = 0;
  do {
    uint32_t e0 = 2*i8;
    ++i8;
    bit_root[e0].init_root();
    bit_root[e0+1].init_root();
  } while( i8<8 );
  uint32_t i24 = 0;
  memset(bit_node, 0, sizeof bit_node);
  sym_word = (uint16_t*)bmf_new(2*height*width);
  esc_ctr[0].init_parent();
  memset(&esc_ctr[1], 0, 1536);
  do {
    uint32_t e1 = 2*i24;
    ++i24;
    run_ctr[e1].init_parent();
    run_ctr[e1+1].init_parent();
  } while( i24<0x18 );
  return this;
}

// sym_reduce.inc -- drop the symbols an image does not use, and renumber what is left.

// The whole of `reduce_alphabet`'s working set, at file scope so that its two
// arms can be two functions.  `liftframe.py` has tried lifting this frame and
// reverted it -- the lifted build aborts on DLRAW while compressing -- so the
// struct stays exactly as it is; only its scope moves.
struct alignas(16) ReduceAlphabetFrame {
  uint32_t zero_base[15];
  void* tmp;
  int32_t kids_i;
  uint8_t buf[4];
  uint32_t*sym_flag() {
    return (uint32_t*)&kids_i;
  }

  // Two `uint16_t` children per node, which is what the code reads: it took
  // `(uint16_t*)&kids[node]` and indexed 0 or 1.  Four words rather than two
  // because the slot is eight bytes wide in the original and the frame's
  // layout is load-bearing -- `memset(buf, 0, 0x10000)` clears this array and
  // 64KB past it, which is also why `liftframe.py` cannot lift this frame.
  uint16_t kids[127][4];
  int32_t y_spill;
  int32_t at_spill;
  int32_t bits_spill;
  uint8_t _pad0[64504];
  SymList lists[16];
  union {
    void* slot[19];
    struct {
      int32_t slot0;
      BMF_SPILL_PAD(0);
      void* slot1;
      uint8_t* slot2;
      uint32_t slot3;
      BMF_SPILL_PAD(3);
      uint32_t slot4;
      BMF_SPILL_PAD(4);
      void* slot5;
      uint32_t slot6;
      BMF_SPILL_PAD(6);
      ModelBlock* slot7;
      uint8_t* slot8;
      uint32_t slot9;
      BMF_SPILL_PAD(9);
      void* slot10;
      ModelBlock* slot11;
      void* slot_tail[7];
    };
  };
};

// Eight bits or fewer, where a symbol is a byte (or a packed field of one) and
// the whole alphabet fits in a 256-entry flag table.  Count the distinct
// symbols, code the count, then code the gaps between the ones that occur and
// renumber the image through the same table.
//
// The wide arm below does none of this -- it builds a binary search tree over
// multi-byte symbols -- and the two shared nothing but a frame and 350 lines.
static void reduce_narrow_alphabet(ReduceAlphabetFrame& f, ModelBlock* blk1, uint8_t* src) {
  int32_t n_distinct, row_w, y, bits, shift, prev, s, s_next;
  uint32_t n_syms3;
  memset(f.sym_flag(), 0, 256*sizeof(uint32_t));
  bool packed = blk1->depth<8;
  int32_t height = blk1->height;
  blk1->alphabet = 0;
  if( packed ) {
    n_distinct = 0;
    if( height ) {
      row_w = blk1->width;
      f.slot8 = src-1;
      f.at_spill = 0;
      y = 0;
      do {
        if( !row_w )
          break;
        f.y_spill = y;
        uint32_t x = 0;
        int32_t at = f.at_spill;
        bits = 0;
        do {
          int32_t bpp = blk1->depth;
          shift = bits-bpp;
          if( shift<0 ) {
            ++f.slot8;
            shift = 8-bpp;
          }
          uint32_t sym = f.slot4&(*f.slot8>>(shift&31));
          bool first = f.sym_flag()[sym]==0;
          f.bits_spill = shift;
          ++x;
          f.sym_flag()[sym] = 1;
          bits = f.bits_spill;
          blk1->alphabet += first;
          blk1->sym_word[at] = sym;
          row_w = blk1->width;
          ++at;
        } while( x<(uint32_t)(*(int32_t*)&blk1->width) );
        n_distinct = blk1->alphabet;
        f.at_spill = at;
        y = f.y_spill+1;
      } while( (uint32_t)(f.y_spill+1)<(uint32_t)blk1->height );
    }
  } else if( height**(int32_t*)&blk1->width ) {
    uint8_t *q = f.slot2;
    uint32_t idx = 0;
    do {
      blk1->alphabet += f.sym_flag()[*q]==0;
      int32_t sym2 = *q;
      f.sym_flag()[sym2] = 1;
      ++q;
      blk1->sym_word[idx++] = sym2;
    } while( idx<(uint32_t)(blk1->height**(int32_t*)&blk1->width) );
    n_distinct = blk1->alphabet;
  } else {
    n_distinct = 0;
  }
  rc.encode(n_distinct-1, n_distinct, f.slot4+1);
  uint32_t n_syms = blk1->alphabet;
  if( n_syms<=f.slot4 ) {
    f.lists[0].init(f.slot4-n_syms+2, 1);
    f.lists[0].rescale_at = 19*f.lists[0].n;
    n_syms3 = blk1->alphabet;
    if( n_syms3 ) {
      prev = 0;
      s = 0;
      uint32_t next_id = 0;
      do {
        if( f.sym_flag()[s] ) {
          f.lists[0].code_symbol(s-prev);
          n_syms3 = blk1->alphabet;
          f.sym_flag()[s] = next_id;
          s_next = s+1;
          prev = s+1;
          ++next_id;
        } else {
          s_next = s+1;
        }
        s = s_next;
      } while( next_id<n_syms3 );
    }
    if( blk1->height**(int32_t*)&blk1->width ) {
      uint32_t m = 0;
      do {
        blk1->sym_word[m] = f.sym_flag()[blk1->sym_word[m]];
        ++m;
      } while( m<(uint32_t)(blk1->height**(int32_t*)&blk1->width) );
    }
    free_sym_entries(f.lists, 16);
  } else {
    free_sym_entries(f.lists, 16);
  }
}

void reduce_alphabet(ModelBlock* blk, uint8_t* src) {
  ReduceAlphabetFrame frame;
  ModelBlock* blk1, * blk4;
  uint32_t alpha_n, done, done2, off, slot_a, sym_bits;
  bool more;
  uint8_t* half;
  int32_t node, side, alpha_m, carry, img_w, img_h, n_moved;
  ModelBlock* blk3;
  uint32_t n_kids, i, written, li, si, si_end, word, k, pairs, n_pairs, j;
  uint16_t* kidp;
  uint8_t *srcp, *p, *rp, *dst_a, *dst_b, *dst_c;
  uint32_t val;
  void* newbuf;
  frame.slot11 = (ModelBlock*)(blk);
  srcp = src;
  sym_bits = blk->depth;
  frame.slot2 = src;
  frame.slot7 = (ModelBlock*)(blk);
  frame.slot4 = 0xFFFFFFFF>>(-sym_bits&31);
  n_kids = (sym_bits+7)>>3;
  for( i = 0; i<8; ++i ) {
    frame.lists[2*i].ent = nullptr;
    frame.lists[2*i+1].ent = nullptr;
  }
  blk1 = frame.slot7;
  if( sym_bits<=8 ) {
    reduce_narrow_alphabet(frame, blk1, src);
  } else {
    memset(frame.buf, 0, 0x10000);
    blk1->alphabet = 1;
    *(uint32_t*)frame.buf = frame.slot4&*(uint32_t*)src;
    blk1->sym_word[0] = 0;
    if( (uint32_t)(blk1->height**(int32_t*)&blk1->width)>1 ) {
      frame.slot8 = src;
      frame.slot9 = n_kids;
      frame.slot7 = (ModelBlock*)(blk1);
      p = frame.slot2;
      node = 0;
      written = 1;
      while( 1 ) {
        p += frame.slot9;
        val = frame.slot4&*(uint32_t*)p;
        if( val!=*(uint32_t*)&frame.buf[8*node] ) {
          node = 0;
          if( val!=*(uint32_t*)frame.buf ) {
            frame.slot3 = written;
            frame.slot2 = p;
            while( 1 ) {
              side = *(uint32_t*)&frame.buf[8*node]<val;
              kidp = frame.kids[node];
              node = kidp[side];
              if( !kidp[side] )
                break;
              if( val==*(uint32_t*)&frame.buf[8*node] ) {
                written = frame.slot3;
                p = frame.slot2;
                mode_symbol[1] = side;
                goto code_dense;
              }
            }
            p = frame.slot2;
            frame.slot0 = side;
            ModelBlock *blk2 = (ModelBlock*)(frame.slot7);
            int32_t alphabet = frame.slot7->alphabet;
            mode_symbol[1] = side;
            node = (uint16_t)alphabet;
            int32_t alpha = alphabet+1;
            kidp[side] = node;
            written = frame.slot3;
            blk2->alphabet = alpha;
            if( alpha>0x2000 ) {
              srcp = frame.slot8;
              alpha_n = alpha;
              n_kids = frame.slot9;
              blk1 = frame.slot7;
              goto alphabet_done;
            }
            *(uint32_t*)&frame.buf[8*node] = val;
          }
        }
// The alphabet is dense enough to code as a run of flags.
code_dense:
        blk3 = frame.slot7;
        frame.slot7->sym_word[written++] = node;
        if( written>=blk3->height*blk3->width ) {
          srcp = frame.slot8;
          n_kids = frame.slot9;
          blk1 = frame.slot7;
          alpha_n = frame.slot7->alphabet;
          goto alphabet_done;
        }
      }
    }
    alpha_n = blk1->alphabet;
// Both codings converge here with `blk->alphabet` set.
alphabet_done:
    rc.encode(alpha_n-1, alpha_n, 0x2001u);
    alpha_m = blk1->alphabet;
    if( alpha_m>0x2000 ) {
      (frame.slot[1]) = bmf_new(blk1->height*n_kids*blk1->width);
      img_w = blk1->width;
      img_h = blk1->height;
      frame.kids_i = blk1->width;
      frame.slot0 = img_h;
      if( n_kids ) {
        frame.slot6 = frame.slot0*img_w;
        if( n_kids>>1 ) {
          half = (uint8_t*)(frame.slot[1])+frame.slot0*frame.kids_i;
          frame.slot8 = srcp;
          frame.slot9 = n_kids;
          frame.slot7 = (ModelBlock*)(blk1);
          pairs = 0;
          do {
            slot_a = 2*pairs;
            off = 2*pairs++*frame.slot6;
            frame.slot[slot_a+2] = (uint8_t*)(frame.slot[1])+off;
            frame.slot[slot_a+3] = (void*)&half[off];
          } while( pairs<n_kids>>1 );
          srcp = frame.slot8;
          n_kids = frame.slot9;
          blk1 = frame.slot7;
          done = 2*pairs+1;
        } else {
          done = 1;
        }
        if( n_kids>(done-1) )
          frame.slot[done+1] = (uint8_t*)(frame.slot[1])+frame.slot0* -frame.kids_i+frame.slot6*done;
      } else {
        frame.slot6 = frame.slot0*img_w;
      }
      if( frame.slot6 ) {
        rp = src;
        if( n_kids ) {
          frame.slot9 = n_kids;
          frame.slot7 = (ModelBlock*)(blk1);
          frame.kids_i = 0;
          n_moved = 0;
          n_pairs = n_kids>>1;
          while( 1 ) {
            while( 1 ) {
              if( n_pairs ) {
                for( j = 0; j<n_pairs; ++j ) {
                  dst_a = (uint8_t*)(frame.slot[2*j+2]);
                  *dst_a = rp[2*j];
                  dst_b = (uint8_t*)frame.slot[2*j+3];
                  frame.slot[2*j+2] = dst_a+1;
                  *dst_b = rp[2*j+1];
                  frame.slot[2*j+3] = dst_b+1;
                }
                done2 = 2*j+1;
                srcp = &rp[2*j];
              } else {
                done2 = 1;
              }
              if( (done2-1)>=frame.slot9 )
                break;
              dst_c = (uint8_t*)frame.slot[done2+1];
              srcp = &rp[done2];
              *dst_c = rp[done2-1];
              more = (uint32_t)(++n_moved)<frame.slot6;
              frame.slot[done2+1] = dst_c+1;
              if( !more )
                goto lists_ready;
              rp += done2;
            }
            if( (uint32_t)(++n_moved)>=frame.slot6 )
              break;
            rp = srcp;
          }
lists_ready:
          n_kids = frame.slot9;
          blk1 = frame.slot7;
        }
      }
      frame.tmp = blk1->sym_word;
      blk1->height = n_kids*frame.slot0;
      blk1->depth = 8;
      free(frame.tmp);
      newbuf = bmf_new(2*blk1->height*blk1->width);
      frame.tmp = frame.slot[1];
      blk1->sym_word = (uint16_t*)newbuf;
      reduce_alphabet(blk1, (uint8_t*)frame.tmp);
      free((frame.slot[1]));
    } else {
      if( 4*n_kids ) {
        frame.slot7 = (ModelBlock*)(blk1);
        li = 0;
        do {
          frame.lists[li].init(256, 1);
          ++li;
        } while( li<4*n_kids );
        blk1 = frame.slot7;
        alpha_m = frame.slot7->alphabet;
      }
      if( alpha_m ) {
        carry = 0;
        si = 0;
        si_end = alpha_m;
        blk4 = (ModelBlock*)(blk1);
        do {
          word = *(uint32_t*)&frame.buf[8*si];
          if( n_kids ) {
            frame.kids_i = si;
            frame.slot9 = n_kids;
            frame.slot7 = (ModelBlock*)(blk4);
            for( k = 0; k<frame.slot9; ++k ) {
              frame.lists[4*k+carry].code_symbol((uint8_t)word);
              carry = (uint8_t)word>>6;
              word >>= 8;
            }
            si = frame.kids_i;
            n_kids = frame.slot9;
            blk4 = (ModelBlock*)(frame.slot7);
            word = *(uint32_t*)&frame.buf[8*frame.kids_i];
            si_end = frame.slot7->alphabet;
          }
          carry = (uint8_t)word>>7;
          ++si;
        } while( si<si_end );
      }
    }
    free_sym_entries(frame.lists, 16);
  }
}

// alt_p1.inc -- the predictor-1 model, around its block.

// The residual codes: `unfold[]` runs 0, -1, +1, -2, +2, ... so a small residual
// of either sign gets a small code, and `fold[]` is its inverse.
//
// The buckets are `2*near_lossless_q + 1` wide, which is the near-lossless
// quantiser: at `E = 0` that is one and the mapping is the plain zigzag above.
// Nothing else in this build sets `near_lossless_q`, so the bucket arithmetic
// is present, correct and never exercised with a width above one.
uint32_t alt_init_tables(uint8_t* fold, int8_t* unfold) {
  uint8_t even, odd;
  uint32_t done;
  int32_t in_bucket, bucket;
  uint8_t half;
  uint32_t i, b;
  int32_t bucket_size = 2*near_lossless_q+1;
  *unfold = 0;
  unfold[255] = 0x80;
  for( i = 0; i<0x3F; ++i ) {
    ((uint8_t*)unfold)[4*i+2] = 2*i+1;
    ((uint8_t*)unfold)[4*i+1] = (uint8_t)(-2*i-1);
    ((uint8_t*)unfold)[4*i+4] = 2*i+2;
    ((uint8_t*)unfold)[4*i+3] = (uint8_t)(-2*i-2);
  }
  unfold[254] = 127;
  unfold[253] = -127;
  *fold = 0;
  uint32_t lo = 1;
  fold[128] = (uint8_t)-1;
  {
    uint32_t span = 128-lo;
    uint32_t pairs = (128-lo)/2;
    half = 0;
    in_bucket = 1;
    if( pairs ) {
      uint32_t k = 0;
      int32_t ofs = 0;
      uint8_t *pos = &(fold)[lo];
      uint8_t *neg = fold-lo;
      do {
        bucket = bucket_size;
        int32_t bucket_1 = in_bucket-1;
        if( bucket_1 )
          bucket = bucket_1;
        else
          ++half;
        even = 2*half;
        pos[2*k] = 2*half;
        odd = 2*half-1;
        in_bucket = bucket-1;
        neg[ofs+256] = odd;
        if( bucket==1 ) {
          in_bucket = bucket_size;
          even = 2*++half;
          odd = 2*half-1;
        }
        pos[2*k+++1] = even;
        neg[ofs+255] = odd;
        ofs -= 2;
      } while( k<pairs );
      done = 2*k+1;
    } else {
      done = 1;
    }
    if( (done-1)<span ) {
      if( in_bucket==1 )
        half = half+1;
      (fold)[lo-1+done] = 2*half;
      fold[257-lo-done] = 2*half-1;
    }
  }
  for( b = 0; b<0x80; ++b ) {
    (fold)[(uint8_t)((uint8_t*)unfold)[2*b]+256] = 2*b;
    (fold)[(uint8_t)((uint8_t*)unfold)[2*b+1]+256] = 2*b+1;
  }
  return b;
}

void alt_model_p1_d8_encode(uint8_t* src, int32_t i, int32_t height, uint8_t* out) {
  AltP1Block *blk;
  AltP1Block *raw = (AltP1Block*)bmf_new(sizeof(AltP1Block));
  if( raw )
    blk = raw->alt_p1_alloc(i, height, 0);
  else
    blk = nullptr;
  blk->d8_encode_body(src, out);
  if( blk )
    blk->alt_p1_free(1);
}

void alt_model_p1_d8_decode(uint8_t* out, int32_t i, int32_t height) {
  AltP1Block *blk;
  AltP1Block *raw = (AltP1Block*)bmf_new(sizeof(AltP1Block));
  if( raw )
    blk = raw->alt_p1_alloc(i, height, 0);
  else
    blk = nullptr;
  rc_begin_decode();
  if( blk->height>0 ) {
    int32_t y = 0;
    do {
      ++y;
      blk->advance_row();
      P1Ctx *cursor2 = blk->cursor[2];
      P1Ctx *cursor4 = blk->cursor[4];
      blk->ctx[2] = 0;
      P1Ctx *cursor0 = blk->cursor[0];
      blk->ctx[3] = cursor2[-2].mag+cursor4[-2].mag+cursor2[0].mag+cursor4[0].mag+cursor2[2].mag+cursor4[2].mag+cursor2[4].mag+cursor4[4].mag+cursor0[-4].mag+cursor0[-2].mag;
      blk->ctx[4] = cursor2[-1].mag+cursor4[-1].mag+cursor2[1].mag+cursor4[1].mag+cursor2[3].mag+cursor4[3].mag+cursor2[5].mag+cursor4[5].mag+cursor0[-3].mag+cursor0[-1].mag;
      if( !(blk->width<=0) ) {
        uint8_t* out_at = out;
        int32_t x = 0;
        do {
          ++x;
          blk->ctx_of(nullptr, nullptr);
          int32_t code = alt_p1_decode_symbol(&blk->counters[blk->ctx[0]], blk->ctx[1]);
          int32_t val = (uint8_t)((uint8_t)blk->pred+blk->unfold[(uint8_t)code]);
          *out_at = val;
          int32_t err = val-blk->pred;
          blk->cursor[0]->sym = val;
          blk->cursor[0]->mag = abs32(err);
          blk->ctx[3+blk->ctx[2]] = blk->ctx[3+blk->ctx[2]]+blk->cursor[0]->mag-blk->cursor[0][-4].mag-(blk->cursor[4][-2].mag-blk->cursor[4][6].mag+blk->cursor[2][-2].mag-blk->cursor[2][6].mag);
          blk->ctx[2] = blk->ctx[2]==0;
          if( blk->counters[blk->ctx[0]].total<0x4000u )
            (blk)->update_model();
          ++blk->cursor[0];
          ++out_at;
          ++blk->cursor[1];
          ++blk->cursor[2];
          ++blk->cursor[3];
          ++blk->cursor[4];
        } while( x<blk->width );
        out = out_at;
      }
    } while( y<blk->height );
  }
  rc_end_decode();
  blk->alt_p1_free(1);
}

// alt_p1_code.inc -- the predictor-1 model, both directions.
//
// The two bodies this replaces were 263 and 212 lines and shared 134 of them,
// in three runs that carry most of the function: the header parse and the
// per-plane block allocation, the 57 lines of per-row rotation -- five buffers
// moved round, five cursors reseated, the two context sums rebuilt from the
// rows above -- and the teardown.  None of that has a direction.
//
// `buf` is the encoder's `src` and the decoder's `out`: the same walk over the
// interleaved planes, read in one direction and written in the other.
//
// What is one-sided is the near-lossless drift control and the side the colour
// transform falls on.  The encoder takes a sample, subtracts the transform,
// folds the residual, reconstructs it, and if the reconstruction has drifted
// more than sixteen it re-sends through `fold_hi` and leaves the original byte
// in `buf`.  The decoder is told which code was used, and adds the transform
// back after the fact -- which is why its stores sit one plane behind, between
// a plane's cursor advance and the next plane's context.
//
// Two spellings differed and are the same value, and both are `abs32` now.
// The encoder wrote a plane's magnitude as `(BYTE4(err) ^ err) - BYTE4(err)`
// over an `int64_t` -- the sign of `err` broadcast into byte 4, exclusive-ored
// and subtracted, which is `|err|` in the low eight bits and nothing in the
// rest -- and the decoder as `abs32(val - pred)`.  `P1Ctx::mag` is a
// `uint8_t`, so eight bits is all either of them keeps.  The `int64_t` went
// with the macro: the width existed so that a byte 4 existed to read.  And the
// decoder held `blk->ctx[0]` in a local across the `ctx[2]` update, which
// cannot change it -- they are different elements.

// A plane's cross-plane prediction: the weighted sum, in 128ths, of the planes
// already coded at this pixel.  `weight0` goes with plane 0, `weight1` with
// plane 1, `weight2` with plane 2.
//
// Two of them because the original's two sites are not the same expression,
// and the differences are load-bearing:
//
//   * the rounding bias is 40 for two planes and 64 for three.  64 is half of
//     128 and rounds to nearest; 40 does not, and biases low by 24/128 of a
//     level.  Both are what BMF.exe does.
//   * the two-plane form's second term is cast to `uint32_t`, which makes the
//     whole sum unsigned and the `>>7` a logical shift.  The three-plane form
//     stays signed and shifts arithmetically.  With a negative weight the two
//     give different answers, so they cannot be one function with a bias
//     parameter, which is what the first attempt at this was.
//
// The three-plane form reads its operands as `p[-3]`, `p[-2]`, `p[-1]`: the
// planes are interleaved, so the three bytes before this one are planes 0, 1
// and 2 of the same pixel.
static inline uint32_t plane_mix2(const PlaneDesc& d, const uint8_t* p0, const uint8_t* p1) {
  return (d.weight0**p0+d.weight1*(uint32_t)*p1+40)>>7;
}

static inline int32_t plane_mix3(const PlaneDesc& d, const uint8_t* p) {
  return (d.weight1*p[-2]+d.weight0*p[-3]+d.weight2*p[-1]+64)>>7;
}

template<int32_t f_DEC>
int32_t alt_model_p1(BmfImage* hdr, uint8_t* buf) {
  int32_t cur3;
  // `void* plane[4]` with three `AltP1Block*&` aliases onto slots 1..3 -- the
  // decompiler's way of saying that a `void*` array is read as blocks.  It is
  // an array of blocks.
  AltP1Block* plane[4];
  int32_t cur0, cur1, code1;
  uint8_t pred1, pred2, pred3;
  AltP1Block* made;
  int32_t w, n_planes, keep0, code0, code1x, want2, code2, code3, np;
  uint8_t pred0, want1, want3;
  int32_t width = hdr->width;
  int32_t height = hdr->height;
  if( plane_count>0 ) {
    int32_t k = 0;
    do {
      AltP1Block *raw = (AltP1Block*)bmf_new(sizeof(AltP1Block));
      if( raw )
        made = raw->alt_p1_alloc(width, height, k);
      else
        made = nullptr;
      plane[k++] = made;
    } while( k<plane_count );
  }
  int32_t src1 = plane_desc[1].src_plane;
  int32_t src2 = plane_desc[2].src_plane;
  int32_t src3 = plane_desc[3].src_plane;
  uint8_t fl1 = plane_desc[src1].flags;
  uint8_t fl2 = plane_desc[src2].flags;
  uint8_t fl3 = plane_desc[src3].flags;
  int32_t dc2 = plane_desc[src2].dc;
  int32_t dc1 = plane_desc[src1].dc;
  int32_t xf1 = fl1&8;
  int8_t dc3 = plane_desc[src3].dc;
  int32_t xf2 = fl2&8;
  int32_t xf3 = fl3&8;
  if( f_DEC )
    rc_begin_decode();
  else
    rc_begin_encode();
  if( height>0 ) {
    uint32_t y = 0;
    w = width;
    n_planes = plane_count;
    do {
      if( n_planes>0 ) {
        int32_t p = 0;
        do {
          ++p;
          AltP1Block* blk_k = plane[p-1];
          blk_k->advance_row();
          P1Ctx *cursor2 = blk_k->cursor[2];
          P1Ctx *cursor4 = blk_k->cursor[4];
          P1Ctx *cursor0 = blk_k->cursor[0];
          blk_k->ctx[2] = 0;
          blk_k->ctx[3] = (int8_t)cursor2[-2].mag+(int8_t)cursor4[-2].mag+cursor2[0].mag+cursor4[0].mag+cursor2[2].mag+cursor4[2].mag+cursor2[4].mag+cursor4[4].mag+cursor0[-4].mag+cursor0[-2].mag;
          blk_k->ctx[4] = (int8_t)cursor2[-1].mag+(int8_t)cursor4[-1].mag+cursor2[1].mag+cursor4[1].mag+cursor2[3].mag+cursor4[3].mag+cursor2[5].mag+cursor4[5].mag+cursor0[-3].mag+cursor0[-1].mag;
          n_planes = plane_count;
        } while( p<plane_count );
        w = width;
      }
      if( w>0 ) {
        uint32_t x = 0;
        do {
          AltP1Block* blk0 = plane[0];
          int32_t off0 = plane_desc[0].src_plane;
          if( !f_DEC ) {
            int32_t want0 = *(buf+off0);
            cur0 = want0;
          }
          plane[0]->ctx_of(nullptr, nullptr);
          if( f_DEC ) {
            code0 = alt_p1_decode_symbol(&blk0->counters[blk0->ctx[0]], blk0->ctx[1]);
            pred0 = (uint8_t)blk0->pred;
            cur0 = (uint8_t)(pred0+blk0->unfold[code0]);
            keep0 = cur0;
          } else {
            keep0 = cur0;
            pred0 = (uint8_t)blk0->pred;
            int32_t resid0 = (uint8_t)(cur0-pred0);
            code0 = blk0->fold[resid0];
            int32_t recon0 = (uint8_t)(blk0->unfold[code0]+pred0);
            int32_t out0 = (uint8_t)(recon0+*(buf+off0)-cur0);
            int32_t drift0 = *(buf+off0)-out0;
            if( drift0<-16||drift0>16 ) {
              code0 = blk0->fold_hi[resid0];
            } else {
              cur0 = recon0;
              *(buf+off0) = out0;
              keep0 = recon0;
            }
            alt_p1_encode_symbol(&blk0->counters[blk0->ctx[0]], blk0->ctx[1], code0);
          }
          int32_t err0 = keep0-blk0->pred;
          blk0->cursor[0]->sym = cur0;
          blk0->cursor[0]->mag = abs32(err0);
          blk0->ctx[blk0->ctx[2]+3] = blk0->ctx[blk0->ctx[2]+3]+blk0->cursor[0]->mag-blk0->cursor[0][-4].mag-(blk0->cursor[4][-2].mag-blk0->cursor[4][6].mag+blk0->cursor[2][-2].mag-blk0->cursor[2][6].mag);
          blk0->ctx[2] = blk0->ctx[2]==0;
          if( blk0->counters[blk0->ctx[0]].total<0x4000u )
            blk0->update_model();
          ++blk0->cursor[0];
          ++blk0->cursor[1];
          ++blk0->cursor[2];
          ++blk0->cursor[3];
          ++blk0->cursor[4];
          int32_t off1 = plane_desc[1].src_plane;
          if( f_DEC ) {
            *(buf+off0) = cur0;
          } else {
            want1 = *(buf+off1);
            if( xf1 )
              want1 = want1-dc1-*(buf+off0);
            cur1 = want1;
          }
          AltP1Block* blk1 = plane[1];
          plane[1]->ctx_of(plane[0], nullptr);
          if( f_DEC ) {
            code1 = alt_p1_decode_symbol(&blk1->counters[blk1->ctx[0]], blk1->ctx[1]);
            pred1 = (uint8_t)blk1->pred;
            cur1 = (uint8_t)(pred1+blk1->unfold[code1]);
          } else {
            pred1 = (uint8_t)blk1->pred;
            int32_t resid1 = (uint8_t)(cur1-pred1);
            code1 = blk1->fold[resid1];
            int32_t at1 = *(buf+off1);
            int32_t recon1 = (uint8_t)(blk1->unfold[code1]+pred1);
            int32_t out1 = (uint8_t)(recon1+*(buf+off1)-cur1);
            int32_t drift1 = at1-out1;
            code1x = code1;
            if( drift1<-16||drift1>16 ) {
              code1x = blk1->fold_hi[resid1];
            } else {
              *(buf+off1) = out1;
              cur1 = recon1;
            }
            alt_p1_encode_symbol(&blk1->counters[blk1->ctx[0]], (int32_t)blk1->ctx[1], code1x);
          }
          int32_t err1 = cur1-blk1->pred;
          blk1->cursor[0]->sym = cur1;
          blk1->cursor[0]->mag = abs32(err1);
          blk1->ctx[blk1->ctx[2]+3] += blk1->cursor[0]->mag-blk1->cursor[0][-4].mag-(blk1->cursor[4][-2].mag-blk1->cursor[4][6].mag)-(blk1->cursor[2][-2].mag-blk1->cursor[2][6].mag);
          blk1->ctx[2] = blk1->ctx[2]==0;
          if( blk1->counters[blk1->ctx[0]].total<0x4000u )
            (blk1)->update_model();
          ++blk1->cursor[0];
          ++blk1->cursor[1];
          ++blk1->cursor[2];
          ++blk1->cursor[3];
          ++blk1->cursor[4];
          int32_t off2 = plane_desc[2].src_plane;
          if( f_DEC ) {
            int32_t val1x = cur1;
            if( xf1 )
              val1x += dc1+*(buf+off0);
            *(buf+off1) = val1x;
          } else {
            want2 = *(buf+off2);
            if( xf2 )
              want2 = (uint8_t)(want2-dc2-(plane_mix2(plane_desc[off2], buf+off0, buf+off1)));
          }
          AltP1Block* blk2 = plane[2];
          plane[2]->ctx_of(plane[1], plane[0]);
          if( f_DEC ) {
            code2 = alt_p1_decode_symbol(&blk2->counters[blk2->ctx[0]], (int32_t)blk2->ctx[1]);
            pred2 = (uint8_t)blk2->pred;
            want2 = (uint8_t)(pred2+blk2->unfold[code2]);
          } else {
            pred2 = (uint8_t)blk2->pred;
            int32_t resid2 = (uint8_t)(want2-pred2);
            code2 = blk2->fold[resid2];
            int32_t recon2 = (uint8_t)(blk2->unfold[code2]+pred2);
            int32_t out2 = (uint8_t)(recon2+*(off2+buf)-want2);
            int32_t drift2 = *(off2+buf)-out2;
            if( drift2<-16||drift2>16 ) {
              code2 = blk2->fold_hi[resid2];
            } else {
              want2 = recon2;
              *(off2+buf) = out2;
            }
            alt_p1_encode_symbol(&blk2->counters[blk2->ctx[0]], (int32_t)blk2->ctx[1], code2);
          }
          int32_t err2 = want2-blk2->pred;
          blk2->cursor[0]->sym = want2;
          blk2->cursor[0]->mag = abs32(err2);
          blk2->ctx[blk2->ctx[2]+3] += blk2->cursor[0]->mag-blk2->cursor[0][-4].mag-(blk2->cursor[4][-2].mag-blk2->cursor[4][6].mag)-(blk2->cursor[2][-2].mag-blk2->cursor[2][6].mag);
          int32_t at2 = blk2->ctx[0];
          blk2->ctx[2] = blk2->ctx[2]==0;
          if( blk2->counters[at2].total<0x4000u )
            (blk2)->update_model();
          ++blk2->cursor[0];
          ++blk2->cursor[1];
          ++blk2->cursor[2];
          ++blk2->cursor[3];
          ++blk2->cursor[4];
          if( f_DEC ) {
            if( xf2 )
              *(buf+off2) = (plane_mix2(plane_desc[off2], buf+off0, buf+off1))+dc2+want2;
            else
              *(buf+off2) = want2;
          }
          n_planes = plane_count;
          if( plane_count>=4 ) {
            int32_t off3 = plane_desc[3].src_plane;
            if( !f_DEC ) {
              if( xf3 )
                want3 = *(buf+off3)-dc3-(plane_mix3(plane_desc[off3], buf+off3));
              else
                want3 = *(buf+off3);
              cur3 = want3;
            }
            AltP1Block* blk3 = plane[3];
            plane[3]->ctx_of(plane[2], plane[1]);
            if( f_DEC ) {
              code3 = alt_p1_decode_symbol(&blk3->counters[blk3->ctx[0]], (int32_t)blk3->ctx[1]);
              pred3 = (uint8_t)blk3->pred;
              cur3 = (uint8_t)(pred3+blk3->unfold[code3]);
            } else {
              pred3 = (uint8_t)blk3->pred;
              code3 = blk3->fold[(uint8_t)(cur3-pred3)];
              int32_t resid3 = (uint8_t)(cur3-pred3);
              int32_t recon3 = (uint8_t)(blk3->unfold[code3]+pred3);
              int32_t drift3 = *(off3+buf)-(uint8_t)(recon3+*(off3+buf)-cur3);
              uint8_t out3 = recon3+*(off3+buf)-cur3;
              if( drift3<-16||drift3>16 ) {
                code3 = blk3->fold_hi[resid3];
              } else {
                cur3 = recon3;
                *(off3+buf) = out3;
              }
              alt_p1_encode_symbol(&blk3->counters[blk3->ctx[0]], (int32_t)blk3->ctx[1], code3);
            }
            int32_t err3 = cur3-blk3->pred;
            blk3->cursor[0]->sym = cur3;
            blk3->cursor[0]->mag = abs32(err3);
            blk3->ctx[blk3->ctx[2]+3] += blk3->cursor[0]->mag-blk3->cursor[0][-4].mag-(blk3->cursor[4][-2].mag-blk3->cursor[4][6].mag)-(blk3->cursor[2][-2].mag-blk3->cursor[2][6].mag);
            blk3->ctx[2] = blk3->ctx[2]==0;
            if( blk3->counters[blk3->ctx[0]].total<0x4000u )
              (blk3)->update_model();
            ++blk3->cursor[0];
            ++blk3->cursor[1];
            ++blk3->cursor[2];
            ++blk3->cursor[3];
            ++blk3->cursor[4];
            if( f_DEC ) {
              int32_t val3x = cur3;
              if( xf3 )
                val3x += (plane_mix3(plane_desc[off3], buf+off3))+dc3;
              *(buf+off3) = val3x;
            }
            n_planes = plane_count;
          }
          buf += n_planes;
          ++x;
        } while( x<(uint32_t)width );
        w = width;
      }
      ++y;
    } while( y<(uint32_t)height );
  }
  if( f_DEC )
    rc_end_decode();
  else
    rc_end_encode();
  np = plane_count;
  if( plane_count>0 ) {
    int32_t f = 0;
    do {
      AltP1Block* q = plane[f];
      if( q ) {
        q->alt_p1_free(1);
        np = plane_count;
      }
      ++f;
    } while( f<np );
  }
  return np;
}

int32_t alt_model_p1_encode(BmfImage* hdr, uint8_t* src) {
  return alt_model_p1<0>(hdr, src);
}

int32_t alt_model_p1_decode(BmfImage* hdr, uint8_t* out) {
  return alt_model_p1<1>(hdr, out);
}

// alt_p2.inc -- the predictor-2 model around its block: the filter, and the two
// directions of its eight-bit body.

// Predict one sample from the seven neighbourhood vectors, and answer with
// three numbers rather than one.  `nb[7][0..2]` receive the centre, this row's
// own prediction and the mixed one; the return value is what the coder uses.
// That third row is one past the `[7][4]` the caller passes -- see the
// `offsetof` assertion beside `p2_row` in alt_p2_block.inc, which is what pins
// the two together.
//
// The first call on a row has no weights of its own to predict with, so it
// seeds them from the mixture instead and returns the mixed prediction
// unchanged.  `uses` is what tells the two apart.
inline int32_t NbRow::predict(float (*nb)[4], CtxWeights* sets, int32_t mode) {
  const float* mix = bmf_p2_mix[mode];
  float acc[4], mixed[7][4], centre, prediction, own;
  int32_t i, j, k;
  for( k = 0; k<4; k++ ) {
    acc[k] = bmf_p2_coef[0][k]*nb[0][k];
    for( j = 1; j<7; j++ )
      acc[k] += bmf_p2_coef[j][k]*nb[j][k];
  }
  centre = bmf_hsum4(acc);
  nb[7][0] = centre;
  for( j = 0; j<7; j++ )
    for( k = 0; k<4; k++ )
      nb[j][k] -= centre;
  for( j = 0; j<7; j++ )
    for( k = 0; k<4; k++ ) {
      mixed[j][k] = mix[0]*sets->row[0]->w[j][k];
      for( i = 1; i<6; i++ )
        mixed[j][k] += mix[i]*sets->row[i]->w[j][k];
    }
  for( k = 0; k<4; k++ ) {
    acc[k] = mixed[0][k]*nb[0][k];
    for( j = 1; j<7; j++ )
      acc[k] += mixed[j][k]*nb[j][k];
  }
  prediction = bmf_hsum4(acc)+centre;
  nb[7][2] = prediction;
  if( uses ) {
    for( k = 0; k<4; k++ ) {
      acc[k] = w[0][k]*nb[0][k];
      for( j = 1; j<7; j++ )
        acc[k] += w[j][k]*nb[j][k];
    }
    own = centre+bmf_hsum4(acc);
    nb[7][1] = own;
    return (int32_t)(prediction+((own-prediction)*w[14][0])/w[14][1]);
  }
  for( j = 0; j<7; j++ )
    for( k = 0; k<4; k++ ) {
      w[j][k] = mixed[j][k]*bmf_p2_decay;
      w[j+7][k] = sets->row[0]->w[j+7][k]*bmf_p2_seed;
    }
  w[14][0] = 47.0f;
  w[14][1] = 169.2f;
  w[14][2] = 1.0f;
  nb[7][1] = prediction;
  return (int32_t)prediction;
}

// One plane of eight-bit samples, coded either way.  Of the two bodies this
// replaces, about ninety lines were the same: the first row's record update,
// the mirrors written past both ends of the row, the three memcpys that seed
// the history buffers, and the whole of the per-row rotation -- five buffers
// and two weight rows moved round, the biases cleared, eight records copied
// down from the row above.  None of that has a direction.
//
// Both loops index off `blk->cursor[0]`, which is what lets them share the
// context: the encoder called it `rec` and the decoder `prev`, and the
// decoder's `pix[-1]` and the encoder's `rec[-1]` are the same record.  So the
// quantiser, the context pair and the frequency record are computed once, for
// both, and only the symbol is one-sided.
//
// What is genuinely one-sided is the near-lossless drift control.  The encoder
// folds the residual, reconstructs it, and if the reconstruction has drifted
// more than sixteen from the source it sends the sample through `fold_hi`
// instead and writes the original byte out.  The decoder has none of that --
// it is told which code was used -- and that asymmetry is the reason these two
// were written separately in the first place.
template<int32_t f_DEC>
void AltP2Block::alt_p2_d8_body(uint8_t* src, uint8_t* out,
                                int32_t width, int32_t height) {
  P2Ctx *pix;
  int32_t j, code0, code;
  uint8_t *outp, code2;
  NbRow **cur_at, **r1;
  NbRow *last, **r0;
  uint32_t k;
  uint8_t* src_end;
  src_end = src;
  if( f_DEC )
    rc_begin_decode();
  else
    rc_begin_encode();
  pix = cursor[0];
  if( width>0 ) {
    uint8_t* p = src;
    for( j = 0; j<width; ++j ) {
      P2Ctx *rec = cursor[0];
      int32_t q2 = rec[-1].val>>4;
      ctx_pair[0] = ctx+ctx_delta[q2+4];
      ctx_pair[1] = ctx+ctx_delta[q2];
      P2Freq&fr = freq[ctx+ctx_w[3].w[(rec[-1].val<=rec[-2].val)+(rec[-1].val<rec[-2].val)]+ctx_w[2].w[rec[-2].sign]+ctx_w[1].w[rec[-1].sign]+ctx_w[0].w[(q2<115)+(q2<17)]+ctx_w[4].w[1]];
      if( f_DEC ) {
        *out = (uint8_t)(((uint16_t)rec[-1].val>>4)+(uint8_t)unfold[fr.decode_symbol(ctx_pair)]);
      } else {
        int32_t q = (uint16_t)rec[-1].val>>4;
        int32_t resid = (uint8_t)(*p-q);
        code0 = fold[resid];
        uint8_t recon = unfold[code0]+q;
        int32_t drift = (uint8_t)*out-(uint8_t)(recon+*out-*p);
        if( drift<-16||drift>16 ) {
          *out = *p;
          code0 = fold_hi[resid];
        } else {
          *out = recon;
        }
        fr.encode_symbol(ctx_pair, code0);
        ++p;
      }
      int32_t val = 16*(uint8_t)*out;
      cursor[0]->val = val;
      cursor[0]->dval = val;
      ++out;
      int32_t err = (int16_t)(rec->val-rec[-1].val);
      rec->err = err;
      // The signed difference goes to `err`, its magnitude to the four
      // difference fields.  It arrived as a partial store -- the magnitude
      // written over `err`'s low word after `rec->err` had taken the signed
      // value -- and every one of the five destinations is sixteen bits wide,
      // so the upper half the store preserved was never read.
      int32_t adiff = abs32(err);
      cursor[0]->aerr = adiff;
      cursor[0]->dupright = adiff;
      cursor[0]->dupleft = adiff;
      cursor[0]->dup = adiff;
      cursor[0]->dleft = (uint32_t)cursor[0]->dup>>1;
      cursor[0]->mag = 2;
      cursor[0]->sign = (cursor[0]->err<=0)+(cursor[0]->err<0);
      pix = cursor[0]+1;
      cursor[0] = pix;
    }
    if( !f_DEC )
      src_end = p;
  }
  {
    P2Ctx*const here = cursor[0];
    here[0] = here[-1];
    here[1] = here[-1];
    here[2] = here[-1];
    here[3] = here[-1];
    here[4] = here[-1];
  }
  P2Ctx*const rec3 = cursor[0]+(-width);
  rec3[-1] = rec3[0];
  rec3[-2] = rec3[1];
  rec3[-3] = rec3[2];
  rec3[-4] = rec3[3];
  rec3[-5] = rec3[4];
  rec3[-6] = rec3[5];
  rec3[-7] = rec3[6];
  rec3[-8] = rec3[7];
  int32_t row_bytes = 18*width+234;
  memcpy(buf[1], buf[0], row_bytes);
  memcpy(buf[2], buf[0], row_bytes);
  memcpy(buf[3], buf[0], row_bytes);
  if( height>1 ) {
    uint32_t* pair = ctx_pair;
    outp = out;
    uint32_t y = 0;
    do {
      cur_at = cur;
      last = cur_at[-1];
      uint8_t *srcp = src_end;
      cur_at[1] = last;
      *cur = last;
      r0 = row0;
      r1 = row1;
      row0 = r1;
      row1 = r0;
      r1 += 2;
      cur = r1;
      r0 += 2;
      above = r0;
      r1[-1] = *r0;
      cur[-2] = *r0;
      memset(p2_row, 0, 15);
      bias[0] = 0.0f;
      bias[1] = 0.0f;
      bias[2] = 0.0f;
      bias[3] = 0.0f;
      __builtin_memset(p2_row, 0, sizeof p2_row);
      {
        P2Ctx*const here = cursor[0];
        here[0] = here[-1];
        here[1] = here[-2];
        here[2] = here[-3];
        here[3] = here[-4];
        here[4] = here[-5];
      }
      ring_advance(buf, cursor, 8);
      cursor[0][-1] = cursor[1][0];
      {
        P2Ctx*const here = cursor[0];
        P2Ctx*const up = cursor[1];
        here[-2] = up[1];
        here[-3] = up[2];
        here[-4] = up[3];
        here[-5] = up[4];
        here[-6] = up[5];
        here[-7] = up[6];
        here[-8] = up[7];
      }
      cursor[0]->dval = 0;
      if( width>0 ) {
        for( k = 0; k<(uint32_t)width; ++k ) {
          int32_t pred = alt_p2_context(nullptr, nullptr);
          if( f_DEC ) {
            code2 = code = freq[ctx].decode_symbol(pair);
            outp[k] = (uint8_t)(pred+(unfold[code]));
          } else {
            uint8_t want = srcp[k];
            int32_t resid2 = (uint8_t)(want-pred);
            uint8_t recon2 = pred+unfold[fold[resid2]];
            int32_t drift2 = outp[k]-(uint8_t)(recon2+outp[k]-want);
            code = fold[resid2];
            if( drift2<-16||drift2>16 ) {
              outp[k] = want;
              code = fold_hi[(uint8_t)(want-pred)];
            } else {
              outp[k] = recon2;
            }
            code2 = code;
            freq[ctx].encode_symbol(pair, code);
          }
          alt_p2_model(outp[k], code2, outp[k]-pred);
        }
        if( !f_DEC )
          src_end = &srcp[width];
        outp = &outp[width];
      }
      ++y;
    } while( y<(uint32_t)(height-1) );
  }
  if( f_DEC )
    rc_end_decode();
  else
    rc_end_encode();
}

// One block allocated, one body run, one block freed.  Only the middle line
// differs, and the two bodies take their arguments in different orders --
// which is the decompiler's record of two call sites, not two intentions.
template<int32_t f_DEC>
void alt_model_p2_d8(uint8_t* src, int32_t i, int32_t height, uint8_t* out) {
  AltP2Block *blk;
  AltP2Block *raw = (AltP2Block*)bmf_page_alloc(sizeof(AltP2Block));
  if( raw )
    blk = raw->alt_p2_alloc(i, 0);
  else
    blk = nullptr;
  if( f_DEC )
    blk->alt_p2_d8_body<1>(nullptr, out, i, height);
  else
    blk->alt_p2_d8_body<0>(src, out, i, height);
  if( blk )
    blk->alt_p2_free(1);
}

void alt_model_p2_d8_encode(uint8_t* src, int32_t i, int32_t height, uint8_t* out) {
  alt_model_p2_d8<0>(src, i, height, out);
}

void alt_model_p2_d8_decode(uint8_t* out, int32_t i, int32_t height) {
  alt_model_p2_d8<1>(nullptr, i, height, out);
}

// alt_p2_context.inc -- the predictor-2 model's context: which of its counters the next
// sample is coded against.

// The two low fields of every bank context: the running prediction quantised
// against three thresholds into bits 13-14, and the activity sum against three
// more into bits 11-12.  Six of these, and the thresholds are the model --
// what is not the model is the shape around them, written out six times.
//
// Two of the six spelled the sum's three tests `(uint32_t)(K-sum)>>31`, which
// is the sign bit of `K-sum`, which is `sum > K`.  The same predicate as the
// other four, in the form MSVC left when it compiled a comparison one way here
// and another way there.  The identity is exact for the values these take --
// `sum_all` is a sum of magnitudes and `K` is at most 58, so `K-sum` cannot
// overflow -- and it was checked against the other spelling before the two
// were written as one.
static inline int32_t ctx_quant(int32_t run, int32_t r0, int32_t r1, int32_t r2,
                                int32_t sum, int32_t s0, int32_t s1, int32_t s2) {
  return (((run>r0)+(run>r1)+(run>r2))<<13)|(((sum>s0)+(sum>s1)+(sum>s2))<<11);
}

int32_t AltP2Block::alt_p2_context(AltP2Block* refa, AltP2Block* refb) {
  CtxWeights weights;
  int32_t ctx15, sum_all, nb_slot;
  P2Ctx *ra1, *ra0, *rb1, *rb0, *rb2, *ra2, *row2c;
  P2Ctx* cx2;
  P2Ctx *nb0, *nb1;
  bool in_band, no_ref;
  int32_t in63, c_lo, mode, c_mid, ctx0, ctx1, pred1, run1, ctx2, run2, bank3, run3, bank4, magsum, run_s2, flat_a, flat_b, ctx_idx;
  uint32_t ctx0_lo;
  int32_t run, run4;
  int32_t magsum_s;
  P2Ctx *row0p = cursor[0];
  P2Ctx *cursor1 = cursor[1];
  P2Ctx *sub0_row = cursor[2];
  int32_t sum_ul = 21*sub0_row[-1].dupleft+12*cursor1[3].dupleft+16*cursor1[2].dupleft+22*cursor1[1].dupleft+(23*row0p[-1].dupleft)+20*cursor1->dupleft+ctx_bias[0]+14*row0p[-2].dupleft;
  int32_t sum_ur = 17*sub0_row[-2].dupright+21*cursor1[2].dupright+15*cursor1[1].dupright+25*cursor1->dupright+9*cursor1[-1].dupright+22*row0p[-1].dupright+ctx_bias[1]+19*row0p[-2].dupright;
  int32_t sum4 = 17*cursor1[3].dleft+15*cursor1[2].dleft+21*cursor1[1].dleft+18*cursor1->dleft+16*cursor1[-1].dleft+22*row0p[-1].dleft+ctx_bias[2]+19*row0p[-2].dleft;
  int32_t lane5 = sub0_row->dup;
  int32_t sum_u = 14*cursor1[3].dup+23*cursor1[1].dup+19*cursor1->dup+25*row0p[-1].dup+ctx_bias[3]+17*row0p[-2].dup+15*(cursor[3]->dup+lane5);
  sum_all = sum4+sum_u+sum_ul+sum_ur;
  int32_t band = (8*sum4>43*sum_u)+(8*sum4>17*sum_u)+(8*sum4>9*sum_u)+(8*sum4>5*sum_u)+(8*sum4>2*sum_u);
  int32_t den_d = 2*row0p[-2].val+2*row0p[-1].val;
  int32_t num_b = cursor1[1].val+(cursor1->val+2*row0p[-1].val);
  int32_t num_d = 16*(sub0_row[2].val+sub0_row->val+cursor1[1].val+sub0_row[-1].val);
  int32_t gA = (sum_all>bmf_p2_thresholds[band][12])+(sum_all>bmf_p2_thresholds[band][11])+(sum_all>bmf_p2_thresholds[band][10])+(sum_all>bmf_p2_thresholds[band][9]);
  int32_t gB = (num_b>bmf_p2_thresholds[band][8])+(num_b>bmf_p2_thresholds[band][7])+(num_b>bmf_p2_thresholds[band][6]);
  int32_t gC = (16*sum_ur>sum_ul*bmf_p2_thresholds[band][5])+(16*sum_ur>sum_ul*bmf_p2_thresholds[band][4])+(16*sum_ur>sum_ul*bmf_p2_thresholds[band][3]);
  int32_t gD = (num_d>bmf_p2_thresholds[band][2]*den_d)+(num_d>den_d*bmf_p2_thresholds[band][1])+(num_d>den_d*bmf_p2_thresholds[band][0]);
  // Mixed radix, and only three of the five terms are bit fields.  `gB`, `gC`
  // and `gD` each sum three comparisons, so each is 0..3 and each is two bits.
  // `gA` sums *four*, so it is 0..4 -- five values with a stride of 64 -- and
  // `band` sums five, so it is 0..5 with a stride of 320, which is 5 * 64.
  // Neither is a field however it is written: `bits<6, 2>(gA)` was tried, and
  // the one neighbourhood in the corpus that reaches `gA == 4` landed in slot
  // 0 instead of 256.  Three streams moved and the gate said so.
  //
  // So they are digits, with their radices written down, and `320 * 6 = 1920`
  // is what `nb_id[]` is sized for.
  nb_slot = CtxIdx{}.bits<4, 2>(gB).bits<2, 2>(gC).bits<0, 2>(gD)
                    .digit<64, 5>(gA).digit<320, 6>(band);
  int32_t nb_at = nb_id[(uint32_t)nb_slot];
  if( nb_id[(uint32_t)nb_slot] ) {
    NbRow *wrow = &nb_weights[nb_at];
    nb_cur = wrow;
    {
      float acc[4], err, floor_;
      int32_t j, k;
      for( k = 0; k<4; ++k ) {
        acc[k] = wrow->w[0][k]*p2_row[0][k];
        for( j = 1; j<7; ++j )
          acc[k] += wrow->w[j][k]*p2_row[j][k];
      }
      err = ((float)row0p[-1].val-(bmf_hsum4(acc)+bias[0]))*2.0999999f;
      floor_ = 7744.0f*wrow->w[14][2];
      for( j = 0; j<7; ++j )
        for( k = 0; k<4; ++k ) {
          float x = p2_row[j][k];
          float ms = wrow->w[7+j][k]+(x*x-wrow->w[7+j][k])*bmf_p2_ms_rate;
          wrow->w[7+j][k] = ms;
          wrow->w[j][k] += bmf_p2_rate[j][k]*err*x/(ms+floor_);
        }
    }
  } else {
    int32_t next_id = nb_id_used;
    nb_id_used = ++next_id;
    nb_id[(uint32_t)nb_slot] = next_id;
    nb_cur = &nb_weights[(int16_t)next_id];
  }
  // The filter's 28 inputs, four to a row.  Rows 0..3 are differences of `dval`
  // -- the second difference of the plane -- at widening offsets from the
  // current pixel: row 0 the four nearest, row 1 the next ring, rows 2 and 3
  // the ones two and three records out.  Rows 4..6 are the cross-plane terms
  // and are only filled when this plane has references; without them the
  // filter sees this plane alone.
  //
  // Written out one subscript at a time because that is what the original did,
  // and left that way: the offsets are not a pattern a loop could generate --
  // `nb0[-1] + nb1->dval - nb1[-1]` and `nb1[-2] + nb1->dval - nb2[-2]` are
  // different shapes -- so a table of offsets would be 28 rows of data plus a
  // loop, which is the same information one indirection further away.
  nb1 = cursor[1];
  p2_row[0][0] = (float)nb1->dval;
  nb0 = cursor[0];
  p2_row[0][1] = (float)nb1[1].dval;
  p2_row[0][2] = (float)(nb0[-1].dval+nb1->dval-nb1[-1].dval);
  row2c = cursor[2];
  p2_row[0][3] = (float)(nb0[-2].dval+(nb1->dval-nb1[-2].dval));
  P2Ctx *nb3 = cursor[3];
  p2_row[1][0] = (float)(nb1[-1].dval+nb1->dval-row2c[-1].dval);
  p2_row[1][1] = (float)(-3*(row2c->dval-nb1->dval)+nb3->dval);
  p2_row[1][2] = (float)(nb0[-1].dval+nb1[2].dval-nb1[1].dval);
  p2_row[1][3] = (float)(nb0[-2].dval+nb1[1].dval-nb1[-1].dval);
  p2_row[2][0] = (float)(2*nb0[-1].dval-nb0[-2].dval);
  P2Ctx *nb2 = (P2Ctx*)(row2c);
  p2_row[2][1] = (float)(nb0[-3].dval+nb1->dval-nb1[-3].dval);
  p2_row[2][2] = (float)(nb2->dval+nb1[1].dval-nb3[1].dval);
  p2_row[2][3] = (float)nb0[-3].dval;
  p2_row[3][0] = (float)(nb1[-2].dval+nb1->dval-nb2[-2].dval);
  p2_row[3][1] = (float)(nb0[-2].dval+nb1[-1].dval-nb1[-3].dval);
  p2_row[3][2] = (float)(nb1[1].dval+((nb1[2].dval+nb1->dval)>>1)-nb2[2].dval);
  p2_row[3][3] = (float)nb3->dval;
  if( refa ) {
    ra0 = (P2Ctx*)refa->cursor[0]-1;
    ra1 = (P2Ctx*)((int16_t*)(refa->cursor[1]-1));
    ra2 = (P2Ctx*)((int16_t*)(refa->cursor[2]-1));
    rb0 = (P2Ctx*)refb->cursor[0]-1;
    no_ref = has_ref==0;
    rb1 = refb->cursor[1]-1;
    rb2 = refb->cursor[2]-1;
    if( !no_ref ) {
      {
        float bias_l = (float)nb0->dval;
        int32_t j, k;
        for( j = 0; j<4; ++j )
          for( k = 0; k<4; ++k )
            p2_row[j][k] += bias_l;
      }
      nb0 = cursor[0];
      nb1 = cursor[1];
    }
    int32_t plane = plane_idx;
    if( plane ) {
      if( plane==1 ) {
        p2_row[4][0] = (float)(nb0->dval+nb1[3].dval);
        p2_row[4][1] = (float)(nb0[-2].val+ra1[2].val-ra1->val);
        p2_row[4][2] = (float)(nb1[1].val+ra0[-1].val-ra1->val);
        p2_row[4][3] = (float)(nb0[-1].val+ra1->val-ra1[-1].val);
        p2_row[5][0] = (float)(nb1[1].val+(rb1[2].val-((P2Ctx*)(rb2))[3].val));
        p2_row[5][1] = (float)(nb0[-2].val+rb0->val-rb0[-2].val);
        p2_row[5][2] = (float)(nb1->val+rb0->val-rb1->val);
        no_ref = has_ref==0;
        p2_row[5][3] = (float)(nb0[-2].val+ra0->err);
        if( no_ref ) {
          int16_t *nb2w = (int16_t*)cursor[2];
          p2_row[6][0] = (float)(nb0[-2].val+ra0->val-ra0[-2].val);
          p2_row[6][1] = (float)(*nb2w+ra0->val-((P2Ctx*)(ra2))->val);
          p2_row[6][2] = (float)(ra2->val+ra0->val-*nb2w+2*(nb1->val-ra1->val));
          in63 = *(int16_t*)((uint8_t*)nb0-18)+nb1[-1].val+ra1[-2].val+ra0->val-ra0[-1].val-ra1[-1].val-nb1[-2].val;
        } else {
          p2_row[6][0] = (float)nb1->val;
          p2_row[6][1] = (float)nb0[-3].val;
          p2_row[6][2] = (float)(nb0[-1].val+ra0[-1].val-ra0[-2].val);
          in63 = nb0[-3].val+nb0[-1].val-nb0[-4].val;
        }
        p2_row[6][3] = (float)in63;
      } else {
        p2_row[4][0] = (float)(nb0[-3].val+nb0[-1].val-nb0[-4].val);
        p2_row[4][1] = (float)(nb0[-1].val+ra0[-1].val-ra0[-2].val);
        p2_row[4][2] = (float)(nb1[1].val+ra1->val-ra2[1].val);
        p2_row[4][3] = (float)(nb0[-2].val+ra1[2].val-ra1->val);
        p2_row[5][0] = (float)(nb1->val+ra0[-2].val-ra1[-2].val);
        p2_row[5][1] = (float)(nb1->val+ra0->val-ra1->val);
        p2_row[5][2] = (float)(nb0[-2].val+ra0->val-ra0[-2].val);
        int16_t *nb2w2 = (int16_t*)cursor[2];
        p2_row[5][3] = (float)(nb0[-2].val+rb0->val-rb0[-2].val);
        p2_row[6][0] = (float)(*nb2w2+rb0->val-((P2Ctx*)(rb2))->val);
        p2_row[6][1] = (float)(rb0[-2].val+rb0->val-nb0[-2].val+2*(nb0[-1].val-rb0[-1].val));
        p2_row[6][2] = (float)(nb0[-2].val+rb0->err);
        p2_row[6][3] = (float)(*nb2w2+ra0->err);
      }
    } else {
      p2_row[4][0] = (float)(nb0[-3].val+nb0[-1].val-nb0[-4].val);
      P2Ctx *nb3x = cursor[3];
      p2_row[4][1] = (float)(nb0[-5].val+nb1->val-nb1[-5].val);
      P2Ctx *nb2x = cursor[2];
      p2_row[4][2] = (float)(nb0[-4].val+nb1->val-nb1[-4].val);
      p2_row[4][3] = (float)((nb2x->val+3*nb1[1].val-4*nb2x[1].val)-(((nb1[2].val-nb1->val-(nb3x[2].val-nb3x->val))>>1)-nb3x[1].val));
      p2_row[5][0] = (float)(nb0[-2].val+ra0->val-ra0[-2].val);
      p2_row[5][1] = (float)(nb1[1].val+ra1[1].val-ra2[2].val);
      p2_row[5][2] = (float)(nb1[-2].val+ra1[2].val-ra2->val);
      p2_row[5][3] = (float)((ra0[-2].val+ra0->val-nb0[-2].val)+2*(nb0[-1].val-ra0[-1].val));
      p2_row[6][0] = (float)(nb2x[1].val+rb0->val-rb2[1].val);
      p2_row[6][1] = (float)(nb0[-2].val+rb0->val-rb0[-2].val);
      p2_row[6][2] = (float)(nb0[-1].val+rb1[1].val-rb1->val);
      p2_row[6][3] = (float)(nb1[1].val+rb1[2].val-rb2[3].val);
    }
  } else {
    p2_row[4][0] = (float)(nb1[3].val+nb1->val-nb2[3].val);
    row2c = nb2;
    p2_row[4][1] = (float)(nb0[-4].val+nb1->val-nb1[-4].val);
    p2_row[4][2] = (float)((nb2->val+3*nb1[1].val-4*nb2[1].val)-((((nb1[2].val-nb1->val)-(nb3[2].val-nb3->val))>>1)-nb3[1].val));
    P2Ctx* nb4 = cursor[4];
    p2_row[4][3] = (float)(row2c[-1].val+nb1[1].val-nb3->val);
    p2_row[5][0] = (float)(nb3[1].val+nb1->val-nb4[1].val);
    p2_row[5][1] = (float)nb1[3].val;
    p2_row[5][2] = (float)(nb0[-3].val+nb0[-1].val-nb0[-4].val);
    p2_row[5][3] = (float)(nb0[-1].val+nb3->val-nb3[-1].val);
    p2_row[6][0] = (float)(nb0[-5].val+nb1->val-nb1[-5].val);
    p2_row[6][1] = (float)nb4->val;
    p2_row[6][2] = (float)(nb0[-5].val+nb0[-1].val-nb0[-6].val);
    p2_row[6][3] = (float)nb1[-6].val;
    rb2 = nullptr;
    rb1 = nullptr;
    rb0 = nullptr;
    ra2 = nullptr;
    ra1 = nullptr;
    ra0 = nullptr;
  }
  NbRow **cur_l = cur;
  weights.row[0] = cur_l[-1];
  NbRow **up_row = above;
  weights.row[1] = up_row[1];
  weights.row[2] = up_row[2];
  weights.row[3] = cur_l[-2];
  weights.row[4] = up_row[0];
  weights.row[5] = cur_l[0];
  c_lo = 14*sum_u;
  mode = 1;
  c_mid = 13*sum_ur;
  if( 16*sum4<=14*sum_u ) {
    c_lo = 16*sum4;
    mode = 0;
  }
  if( c_lo>c_mid )
    mode = 2;
  else
    c_mid = c_lo;
  if( c_mid>11*sum_ul )
    mode = 3;
  int32_t filt = nb_cur->predict((float (*)[4]) p2_row, &weights, mode);
  P2Ctx* cx0 = cursor[0];
  P2Ctx *cx1 = cursor[1];
  // A 32-bit store at `&pred_prev`, which is a `uint16_t` followed by two
  // bytes of padding: the original wrote the whole word and the top half
  // landed in the pad, which nothing reads.  So it is the low half.
  pred_prev = (uint16_t)filt;
  int32_t lane3 = cx1->aerr;
  int32_t g3pair = cx0[-1].aerr+lane3;
  if( refa )
    g3pair += (rb0->aerr+ra0->aerr)>>1;
  run = filt;
  P2Ctx *cx3 = (P2Ctx*)(cursor[3]);
  int32_t g3sum = cx1[3].aerr+cx1[-1].aerr+cx0[-1].aerr+cx0[-3].aerr+cx0[-4].aerr+cx0[-2].aerr;
  int32_t run_s = run;
  // Four of the five masks are a sign test the types prove: a sum of `w` of
  // these `int16_t` members is under `w * 2^15`, so every bit from
  // `15 + ceil(log2 w)` up is a copy of the sign.  The fifth is a sign too, and
  // for a reason from outside that rule -- the cast makes it bit 15 of a
  // *sixteen-bit* value -- so it stays as it was written.  tools/ctxidx.py.
  ctx0_lo = CtxIdx{}.bit<19>(cx1[1].err+cx1->err+cx1[-1].err+cx0[-1].err < 0)
            .bit<18>(cx3->err+cx0[-2].err+2*cx0[-4].err < 0)
            .bit<17>(cx1[-3].err+cx0[-3].err+cx0[-5].err+cx0[-7].err < 0)
            .bit<16>(cx0[-1].err < 0)
            .raw(((uint16_t)cx0[-3].err)&0x8000)
            .bits<13, 2>((run>3536)+(run>720)+(run>288))
            .bits<11, 2>(((g3pair+g3sum)>752)+((g3pair+g3sum)>400)+((g3pair+g3sum)>240));
  bank_ctx[0] = ctx0_lo;
  if( refa ) {
    int32_t lane2 = ra0->err;
    run = run_s;
    ctx0 = CtxIdx{}.bit<25>(rb0[-1].err < 0)
           .bit<24>(rb0->err < 0)
           .bit<23>(ra0[-1].err < 0)
           .bit<22>(rb0->err+rb0[-2].err < 0)
           .bit<21>(ra0[-2].err+lane2 < 0)
           .bit<20>(cx0[-2].err < 0)
           .raw(ctx0_lo);
    cx2 = cursor[2];
  } else {
    run = run_s;
    cx2 = cursor[2];
    ctx0 = CtxIdx{}.bit<25>(cx1[3].err+cx0[-3].err+cx0[-7].err+cx0[-5].err < 0)
           .bit<24>(cx2[1].err+cx2->err+cx0[-4].err+cx0[-8].err < 0)
           .bit<23>(cx0[-4].err+cx0[-6].err < 0)
           .bit<22>(cx0[-4].err < 0)
           .bit<21>(cx0[-5].err < 0)
           .bit<20>(cx0[-7].err < 0)
           .raw(ctx0_lo);
  }
  int32_t bank0 = ctx0>>11;
  bank_ctx[0] = bank0;
  int32_t pred0 = p2_pred(p2_ctr[bank0].weighted, p2_ctr[bank0].rate);
  int32_t sum_c = sum_all;
  P2Ctx *cx4 = cursor[4];
  nb_sum[1] = pred0;
  int32_t run0 = pred0+run_s;
  nb_sum[0] = run0;
  int32_t nb4_4 = cx4[4].val;
  sum_all = ((g3pair<<9)+sum_c)>>13;
  int32_t d_run0 = cx0[-5].val-run0;
  int32_t d_up = nb4_4-run0;
  int32_t up5 = cx1[5].val;
  int32_t d_up5 = up5-run0;
  // The four words below -- two spellings of `ctx1`, two of `ctx2`, and the two
  // `bank` words after them -- keep their masks, and this is the measurement
  // that says they must.
  //
  // Every `expr & <one bit>` here is a sign test *if* `|expr|` stays under that
  // bit, and `tools/ctxidx.py` converts the ones where the types say so: a sum
  // of `w` `int16_t` members is under `w * 2^15`.  These are not those.  Every
  // term carries a `run` -- `run0 = pred0 + run_s`, `run1 = pred1 + run0`, and
  // on down -- which is an accumulated prediction with no type bound, and the
  // masks reach as low as bit 15.
  //
  // Instrumented over the corpus, four of them are *not* sign tests at all:
  //
  //   ctx1  bit 15  `d_run0`                        reaches 36157
  //   bank3 bit 15  `run2-cx0[-3].val`              reaches 35550
  //   bank3 bit 24  `... - ((uint32_t)(...)>>1) ...`  is unsigned throughout
  //   bank4 bit 15  `(uint16_t)run3 - ...`          reaches 69572 as an int
  //
  // and twelve more come within a factor of four of their bit, which makes
  // them sign tests by how the corpus happened to run and not by anything the
  // code says.  Rewriting any of these as `< 0` would change what the program
  // computes.  `tools/ctxidx.py --line N` reports; it declines all six.
  if( refa ) {
    int32_t dv_now = cx0[0].dval;
    ctx1 = (cx0[-1].val+ra0->val-ra0[-1].val-run0)&0x2000000             // bit 25
         |(ra2->dval+ra1->dval-2*ra0->dval)&0x1000000                    // bit 24
         |((dv_now+cx0[-3].dval-run0-(cx1[2].dval-cx1[5].dval))&0x800000 // bit 23
         |(dv_now+cx0[-5].dval-run0)&0x400000                            // bit 22
         |(dv_now+cx1->dval+rb1[2].dval-rb2[2].dval-run0)&0x200000       // bit 21
         |(dv_now+cx0[-1].dval+rb0->dval-rb0[-1].dval-run0)&0x100000     // bit 20
         |(cx2[-1].dval+dv_now+ra0->dval-ra2[-1].dval-run0)&0x80000      // bit 19
         |(dv_now+cx1[2].dval+ra0->dval-ra1[2].dval-run0)&0x40000        // bit 18
         |d_up5&0x20000                                                  // bit 17
         |d_up&0x10000                                                   // bit 16
         |d_run0&0x8000                                                  // bit 15
         |ctx_quant(run0, 2256, 1056, 144, sum_all, 55, 10, 24));
  } else {
    int32_t d_run0b = run0-cx0[-3].val;
    ctx1 = (cx1[-5].val-cx1[-2].val+d_run0b)&0x1000000                   // bit 24
         |(d_run0b+cx1[2].val-up5)&0x800000                              // bit 23
         |(cx4[3].val-cx2[2].val+run0-cx2[1].val)&0x400000               // bit 22
         |(cx4[-1].val-cx3->val+run0-cx1[-1].val)&0x200000               // bit 21
         |(cx1->val-cx1[2].val+run0-cx0[-2].val)&0x100000                // bit 20
         | -d_up5&0x80000                                                // bit 19
         | -d_up&0x40000                                                 // bit 18
         |(run0-cx4[2].val)&0x20000                                      // bit 17
         |(run0-cx4[-3].val)&0x10000                                     // bit 16
         | -d_run0&0x8000                                                // bit 15
         |ctx_quant(run0, 2400, 1024, 240, sum_all, 39, 24, 11)|(nb4_4-cx3->val+run0-cx1[4].val)&0x2000000;   // bit 25
  }
  int32_t bank1 = ctx1>>11;
  bank_ctx[1] = bank1;
  int8_t rate1 = p2_ctr[bank1+32768].rate;
  int32_t w1c = p2_ctr[bank1+32768].weighted;
  int32_t one1 = 1<<((rate1+31)&31);
  pred1 = (one1+w1c)>>(rate1&31);
  run1 = pred1+run0;
  nb_sum[2] = run1;
  nb_sum[3] = pred1;
  int32_t cx2_val0 = cx2->val;
  int32_t cx1_val = cx1->val;
  int32_t dvsum2 = cx0[-2].val-run1;
  int32_t lap = cx0[-2].val+run1-2*cx0[-1].val;
  int32_t dtop2 = cx2_val0-run1;
  if( refa ) {
    int32_t dv1 = cx1[1].dval;
    int32_t d_ra = ra0->val-run1;
    ctx2 = (cx0[0].dval+cx1[-1].dval-run1-(cx2->dval-dv1))&0x2000000     // bit 25
         |(cx0[0].dval+cx0[-1].dval-run1-(cx1->dval-dv1))&0x1000000      // bit 24
         |(rb0->val-run1+cx2_val0-rb2->val)&0x800000                     // bit 23
         |(d_ra+cx2_val0-ra2->val)&0x400000                              // bit 22
         |(d_ra+cx1[-1].val-ra1[-1].val)&0x200000                        // bit 21
         |((cx0[0].dval-cx0[-2].dval+2*cx0[-1].dval-run1)&0x100000       // bit 20
         |(2*cx1_val-run1-cx2_val0)&0x80000                              // bit 19
         | -lap&0x40000                                                  // bit 18
         |dtop2&0x20000                                                  // bit 17
         |dvsum2&0x10000                                                 // bit 16
         |(208-rb0->val)&0x8000                                          // bit 15
         |ctx_quant(run1, 2576, 1280, 640, sum_all, 33, 12, 4));
  } else {
    ctx2 = (run1+3*(cx2_val0-cx1_val)-cx3->val)&0x2000000                // bit 25
         |(run1+cx4->val-(cx2[2].val+cx2[-2].val))&0x1000000             // bit 24
         |(cx3[2].val-cx2[-1].val+run1-cx1[3].val)&0x800000              // bit 23
         |(cx3[1].val-cx1[1].val-dtop2)&0x400000                         // bit 22
         |(cx3->val-cx1_val-dtop2)&0x200000                              // bit 21
         |lap&0x100000                                                   // bit 20
         |(run1-cx4[3].val)&0x80000                                      // bit 19
         |(cx3[1].val-run1)&0x40000                                      // bit 18
         |(run1-cx4->val)&0x20000                                        // bit 17
         |(run1-cx3[-2].val)&0x10000                                     // bit 16
         | -dvsum2&0x8000                                                // bit 15
         |ctx_quant(run1, 2464, 1216, 688, sum_all, 58, 25, 13);
  }
  int32_t bank2 = ctx2>>11;
  bank_ctx[2] = bank2;
  int32_t pred2 = p2_pred(p2_ctr[bank2+65536].weighted, p2_ctr[bank2+65536].rate);
  nb_sum[5] = pred2;
  run2 = pred2+run1;
  nb_sum[4] = run2;
  int32_t run_dv3 = run2-cx0[0].dval;
  // `sum_all = -sum_all` was here, and the six thresholds below read `< -K`
  // because of it.  Nothing else used the negated value: it existed so that
  // `q9`, `q39` and `q10` -- computed from the positive one, before this line
  // -- could be added to comparisons made after it.  Those are written out
  // now, so the negation and the six sign flips cancel.
  bank3 = (int32_t)((3*(cx0[-2].val-cx0[-1].val)+run2-cx0[-3].val)&0x2000000 // bit 25
       |(cx2[1].dval-((uint32_t)(cx1[1].dval+cx1[2].dval+cx1[-1].dval+cx1->dval)>>1)+run_dv3)&0x1000000 // bit 24
       |(cx2[-3].val-cx1[-2].val+run2-cx1[-1].val)&0x800000              // bit 23
       | -(cx2[2].val+run2-2*cx1[1].val)&0x400000                        // bit 22
       |(cx1[-2].dval-cx0[-2].val+run2-cx1->dval)&0x200000               // bit 21
       |(run2-cx1[3].val)&0x100000                                       // bit 20
       |(run_dv3-cx2[1].dval)&0x80000                                    // bit 19
       |(run2-cx3->val)&0x40000                                          // bit 18
       |(2*run2-cx1->dval-(cx1->val+cx0[0].dval))&0x20000                // bit 17
       |(run2-cx0[-1].dval-cx0[0].dval)&0x10000                          // bit 16
       |(run2-cx0[-3].val)&0x8000                                        // bit 15
       |ctx_quant(run2, 2896, 1568, 592, sum_all, 37, 19, 9))>>11;
  bank_ctx[3] = bank3;
  int32_t w3c = p2_ctr[bank3+98304].weighted;
  int32_t pred3 = p2_pred(w3c, p2_ctr[bank3+98304].rate);
  nb_sum[7] = pred3;
  run3 = pred3+run2;
  run = run3;
  nb_sum[6] = run3;
  int32_t dv_now4 = cx0[0].dval;
  int32_t run_dv4 = run3-dv_now4;
  int32_t run_up4 = run3+cx3->val;
  bank4 = (int32_t)((run-((uint32_t)(cx1[1].val+cx1[-1].val+2*cx1->val)>>2))&0x2000000 // bit 25
       |(run_up4-cx0[-2].val-(cx3[2].dval+dv_now4))&0x1000000            // bit 24
       |(run-2*cx0[-2].dval-(dv_now4-cx0[-4].dval))&0x800000             // bit 23
       |(run-cx0[-3].dval-dv_now4-(cx1->val-cx1[-3].val))&0x400000       // bit 22
       |(run_up4-dv_now4-(cx1[1].val+cx2[-1].dval))&0x200000             // bit 21
       |(cx2[-2].val+run-2*cx1[-1].val)&0x100000                         // bit 20
       |(cx2->dval-2*cx1->dval+run_dv4)&0x80000                          // bit 19
       |((run3-cx0[-1].val)-(cx1->val-cx1[-1].val))&0x40000              // bit 18
       |(run_dv4-cx1[4].dval)&0x20000                                    // bit 17
       |(run_dv4-cx1[-2].dval)&0x10000                                   // bit 16
       |(((uint16_t)run3-(uint16_t)cx0[-4].dval-(uint16_t)dv_now4)&0x8000 // bit 15
       )|(ctx_quant(run3, 3056, 1952, 368, sum_all, 39, 21, 10)))>>11;
  bank_ctx[4] = bank4;
  int32_t pred4 = p2_pred(p2_ctr[bank4+131072].weighted, p2_ctr[bank4+131072].rate);
  uint8_t* cx2p = (uint8_t*)cx2;
  nb_sum[9] = pred4;
  run4 = run+pred4;
  nb_sum[8] = run+pred4;
  magsum_s = cx1[5].mag+cx1[4].mag+cx1[-3].mag+cx1[-4].mag+3*(cx1[2].mag+cx2[1].mag)+7*cx1->mag+6*cx1[1].mag+cx0[-6].mag+cx0[-7].mag+cx0[-8].mag+8*cx0[-1].mag+cx4[2].mag+cx4[1].mag+cx4->mag+cx4[-1].mag+cx0[-4].mag+cx0[-5].mag+(cx3[2].mag+cx3[1].mag+cx3[-1].mag+cx3[-2].mag+cx4[-2].mag+cx2p[107]+cx2p[89]+cx2p[71]+(*(cx2p-19))+*(cx2p-37))+4*(cx1[-1].mag+cx0[-2].mag+cx2p[17])+2*(cx1[-2].mag+cx1[3].mag+cx0[-3].mag+cx3->mag+*(cx2p-1)+cx2p[53]);
  int32_t lo_band = band_lo;
  ctx_w[0].sel = (run4<1840)+(run4<272);
  int32_t hi_band = band_hi;
  ctx_w[1].sel = (run4-cx1->val<=hi_band)+(run4-cx1->val<lo_band);
  int32_t d_run4 = run4-cx0[-1].val;
  in_band = d_run4<=hi_band;
  ctx_w[2].sel = in_band+(d_run4<lo_band);
  ctx_w[3].sel = cx1->sign;
  ctx_w[4].sel = cx0[-1].sign;
  magsum = magsum_s;
  int32_t magu = cx2[0].mag+cx1->mag;
  run_s2 = run;
  int32_t magl = cx0[-1].mag+cx0[-2].mag;
  if( refa ) {
    int32_t mag = rb0->mag;
    int32_t mag_ref1 = rb1->mag+ra1->mag;
    int32_t mag_ref0 = mag+ra0->mag;
    magsum = mag_ref1+magsum_s+4*mag_ref0+2*(ra0[-1].mag+rb0[-1].mag);
    flat_a = mag_ref0+magl+rb0[-2].mag+rb0[-1].mag+ra0[-2].mag+ra0[-1].mag;
    run_s2 = run;
    if( has_ref ) {
      int32_t d_run4b = run4-cx1->dval-cx0[0].dval;
      if( d_run4b<lo_band||d_run4b>hi_band ) {
        run4 = run4-cx0[-1].dval-cx0[0].dval;
        flat_b = run4>=lo_band&&hi_band>=run4;
      } else {
        flat_b = 1;
      }
    } else {
      flat_b = mag_ref1+mag_ref0+magu+rb2->mag+ra2->mag;
    }
    if( plane_idx==1 ) {
      magsum_s = magsum;
      int32_t d_ra_ra1 = ra0->val-ra1->val;
      ctx_w[3].sel = (d_ra_ra1<=hi_band)+(d_ra_ra1<lo_band);
      int32_t d_ra_left = ra0->val-ra0[-1].val;
      magsum = magsum_s;
      run_s2 = run;
      ctx_w[4].sel = (d_ra_left<=hi_band)+(d_ra_left<lo_band);
    } else if( (int32_t)plane_idx>1 ) {
      magsum_s = magsum;
      int32_t d_rb_rb1 = rb0->val-rb1->val;
      ctx_w[3].sel = (d_rb_rb1<=hi_band)+(d_rb_rb1<lo_band);
      int32_t d_rb_left = rb0->val-rb0[-1].val;
      in_band = d_rb_left<=hi_band;
      magsum = magsum_s;
      ctx_w[4].sel = in_band+(d_rb_left<lo_band);
      int32_t ra0_val = ra0->val;
      int32_t d_ra_ra1b = ra0_val-((P2Ctx*)(ra1))->val;
      in_band = lo_band<=d_ra_ra1b;
      run_s2 = run;
      if( in_band&&d_ra_ra1b<=hi_band ) {
        flat_a = 1;
      } else {
        int32_t d_ra_leftb = ra0_val-ra0[-1].val;
        flat_a = d_ra_leftb>=lo_band&&d_ra_leftb<=hi_band;
      }
    }
  } else {
    flat_a = magl+cx0[-3].mag+cx0[-4].mag+cx0[-5].mag;
    flat_b = cx4->mag+cx3->mag+magu+cx0[0].mag;
  }
  if( magsum>=960 ) {
    ctx15 = 15;
    ctx = 15;
  } else {
    ctx15 = nb_ctx[magsum>>3];
    ctx = ctx15;
  }
  ctx_idx = (run_s2+pred4+7)>>4;
  if( ctx_idx>=255 )
    ctx_idx = 255;
  if( ctx_idx<0 )
    ctx_idx = 0;
  ctx_pair[0] = ctx_delta[ctx_idx+4]+ctx15;
  ctx_pair[1] = ctx15+ctx_delta[ctx_idx];
  ctx = ctx15+32*(flat_b==0)+16*(flat_a==0)+ctx_w[4].w[ctx_w[4].sel]+ctx_w[3].w[ctx_w[3].sel]+ctx_w[2].w[ctx_w[2].sel]+ctx_w[1].w[ctx_w[1].sel]+ctx_w[0].w[ctx_w[0].sel];
  return ctx_idx;
}

// alt_p2_model.inc -- the predictor-2 model itself, and the largest body in the program.
// "p2" is `plane_predictor == 2`; it is not about depth.  t8g is a single eight-bit
// plane and codes here.  MODELS.md section 7.

// The per-bank counter walk: five banks of context counters, each stepped
// toward this sample's residual, and the mirror and rotate neighbours of each
// stepped with it at lighter weights.
//
// 321 lines inside `alt_p2_model`, and the reason first recorded for leaving
// them there -- "threading about thirty locals through a signature" -- was a
// guess.  What the loop actually needs from the enclosing scope is small and
// nothing it touches is read after it; the compiler was asked rather than a
// regex, twice, because the regex undercounted both times.
void AltP2Block::code_banks(int32_t sample16) {
  uint8_t b_top3;
  bool go;
  int32_t bctx, res, w0, w0b, res2, w1, e1, wnode0m1a, enode0m1a, x0020, x0010, neg,
      w_top, e_top, bump, res_s, w_top3, w_topm1, wm0400x, neg_b, res_t, res_m0010,
      neg_c, neg_d, wd4000p1a, pd4000p1a, wm0400z, wm0020a, pm0020a, res_c;
  for( uint32_t bank = 0; bank<5; ++bank ) {
      bctx = (uint32_t)bank_ctx[bank];
      res = sample16-(nb_sum[2*bank]);
      P2Count* node0 = &p2_ctr[32768*bank+bctx];
      w0 = res+(uint16_t)node0->weighted;
      node0->weighted = w0;
      int32_t countdown = node0->b1;
      if( countdown ) {
        w0b = w0+4*((res>deadzone_hi)-(res<deadzone_lo));
        node0->weighted = w0b;
        uint32_t ctxw = bctx;
        if( (int32_t)abs32(res)<38 ) {
          if( (uint8_t)-- countdown ) {
            node0->b1 = countdown;
          } else {
            if( (uint8_t)node0->rate<8u ) {
              uint8_t b0n = node0->rate+1;
              node0->rate = b0n;
              node0->b1 = p2_b1_reload[b0n-1];
              node0->weighted = 2*w0b;
            } else {
              node0->b1 = countdown;
            }
          }
        }
        if( !alphabet_reduced ) {
          // The mirrored context: the same counter with the top bits of its
          // index flipped, which is the model's guess at what a symmetric
          // neighbourhood would have used.
          //
          // This was `mir_top`, a `uint16_t*` walking `P2Count` two words at a
          // time -- `[0]` the rate byte, `[1]` the weight, `[2]`/`[3]` the next
          // record's, `[-2]`/`[-1]` the previous one's.  It is a `P2Count*`, and
          // the name is reused a hundred lines below for a `uint16_t*` that
          // genuinely does walk a `P2Freq` as words, which is why one name did
          // two jobs.
          //
          // The decompilation also had `prefetch(&mir_top)` *before* the
          // assignment, which asks for the cache line holding a local the
          // function is about to write anyway.  Every other prefetch below is of
          // the counter the next few lines will read; this one is now too.
          P2Count *mir = &p2_ctr[32768*bank+(ctxw^0x7FF0)];
          __builtin_prefetch(mir, 0, 1);
          res2 = (nb_sum[2*bank+1])+res;
          int32_t lowbits = ctxw&3;
          if( (uint32_t)lowbits>=3||(w1 = node0[1].weighted, e1 = res2-p2_pred(w1, (uint8_t)node0[1].rate), go = lowbits<=0, node0[1].weighted = (int16_t)w1+((32*((e1>deadzone_hi)-(uint32_t)(e1<deadzone_lo))+e1+1)>>1), !go) ) {
            wnode0m1a = node0[-1].weighted;
            enode0m1a = res2-p2_pred(wnode0m1a, (uint8_t)node0[-1].rate);
            node0[-1].weighted = (int16_t)wnode0m1a+((32*((enode0m1a>deadzone_hi)-(uint32_t)(enode0m1a<deadzone_lo))+enode0m1a+2)>>2);
          }
          P2Count* bankp = &p2_ctr[32768*bank];
          res_c = res2;
          __builtin_prefetch(&bankp[(ctxw^0x4000)], 0, 1);
          P2Count *d4000 = &bankp[(ctxw^0x4000)];
          P2Count *m4000 = &bankp[(ctxw^0x3FF0)];
          __builtin_prefetch(m4000, 0, 1);
          P2Count *r4000 = &bankp[p2_ctx_rotate[((ctxw^0x4000)>>2)&3]+((ctxw^0x4000)&0xFFFFFFF3)];
          __builtin_prefetch(r4000, 0, 1);
          __builtin_prefetch(&bankp[(ctxw^0x2000)], 0, 1);
          P2Count *d2000 = &bankp[(ctxw^0x2000)];
          __builtin_prefetch(&bankp[(ctxw^0x5FF0)], 0, 1);
          P2Count *m2000 = &bankp[(ctxw^0x5FF0)];
          P2Count *r2000 = &bankp[p2_ctx_rotate[((ctxw^0x2000)>>2)&3]+((ctxw^0x2000)&0xFFFFFFF3)];
          __builtin_prefetch(r2000, 0, 1);
          __builtin_prefetch(&bankp[(ctxw^0x1000)], 0, 1);
          P2Count *d1000 = &bankp[(ctxw^0x1000)];
          __builtin_prefetch(&bankp[(ctxw^0x6FF0)], 0, 1);
          P2Count *m1000 = &bankp[(ctxw^0x6FF0)];
          P2Count *r1000 = &bankp[p2_ctx_rotate[((ctxw^0x1000)>>2)&3]+((ctxw^0x1000)&0xFFFFFFF3)];
          __builtin_prefetch(r1000, 0, 1);
          P2Count *d0800 = &bankp[(ctxw^0x800)];
          P2Count *m0800 = &bankp[(ctxw^0x77F0)];
          P2Count *r0800 = &bankp[p2_ctx_rotate[((ctxw^0x800)>>2)&3]+((ctxw^0x800)&0xFFFFFFF3)];
          P2Count *d0400 = &bankp[(ctxw^0x400)];
          __builtin_prefetch(d0800, 0, 1);
          __builtin_prefetch(m0800, 0, 1);
          __builtin_prefetch(r0800, 0, 1);
          P2Count *m0400 = &bankp[(ctxw^0x7BF0)];
          P2Count *r0400 = &bankp[p2_ctx_rotate[((ctxw^0x400)>>2)&3]+((ctxw^0x400)&0xFFFFFFF3)];
          P2Count *d0200 = &bankp[(ctxw^0x200)];
          __builtin_prefetch(d0400, 0, 1);
          P2Count *m0200 = &bankp[(ctxw^0x7DF0)];
          P2Count *r0200 = &bankp[p2_ctx_rotate[((ctxw^0x200)>>2)&3]+((ctxw^0x200)&0xFFFFFFF3)];
          __builtin_prefetch(m0400, 0, 1);
          __builtin_prefetch(r0400, 0, 1);
          P2Count *d0100 = &bankp[(ctxw^0x100)];
          uint32_t ri0100 = p2_ctx_rotate[((ctxw^0x100)>>2)&3]+((ctxw^0x100)&0xFFFFFFF3);
          P2Count *m0100 = &bankp[(ctxw^0x7EF0)];
          __builtin_prefetch(d0200, 0, 1);
          P2Count *r0100 = &bankp[ri0100];
          P2Count *d0080 = &bankp[(ctxw^0x80)];
          __builtin_prefetch(m0200, 0, 1);
          __builtin_prefetch(r0200, 0, 1);
          P2Count *m0080 = &bankp[(ctxw^0x7F70)];
          P2Count *r0080 = &bankp[p2_ctx_rotate[((ctxw^0x80)>>2)&3]+((ctxw^0x80)&0xFFFFFFF3)];
          P2Count *d0040 = &bankp[(ctxw^0x40)];
          __builtin_prefetch(d0100, 0, 1);
          P2Count *m0040 = &bankp[(ctxw^0x7FB0)];
          P2Count *r0040 = &bankp[p2_ctx_rotate[((ctxw^0x40)>>2)&3]+((ctxw^0x40)&0xFFFFFFF3)];
          __builtin_prefetch(m0100, 0, 1);
          __builtin_prefetch(r0100, 0, 1);
          x0020 = ctxw^0x20;
          x0010 = ctxw^0x10;
          P2Count *d0020 = &bankp[x0020];
          P2Count *m0020 = &bankp[(x0020^0x7FF0)];
          __builtin_prefetch(d0080, 0, 1);
          __builtin_prefetch(m0080, 0, 1);
          P2Count *r0020 = &bankp[p2_ctx_rotate[(x0020>>2)&3]+(x0020&0xFFFFFFF3)];
          P2Count *d0010 = &bankp[x0010];
          uint32_t ri0010 = p2_ctx_rotate[(x0010>>2)&3]+(x0010&0xFFFFFFF3);
          P2Count *m0010 = &bankp[(x0010^0x7FF0)];
          __builtin_prefetch(r0080, 0, 1);
          P2Count *r0010 = &bankp[ri0010];
          neg = -res_c;
          __builtin_prefetch(d0040, 0, 1);
          w_top = mir[0].weighted;
          __builtin_prefetch(m0040, 0, 1);
          e_top = neg-p2_pred(w_top, (uint8_t)mir[0].rate);
          __builtin_prefetch(r0040, 0, 1);
          // `e_top > deadzone_hi`, which is what the five siblings of this line
          // in this file already say.  It arrived as the x86 flags the compare
          // sets -- `!(lt ^ of | zf)` over `__OFSUB__` -- because signed
          // less-than *is* `SF != OF`, so `(e_top-deadzone_hi<0) ^ overflow` is
          // the less-than, and not-less-and-not-equal is greater.
          bump = 32*((e_top>deadzone_hi)-(e_top<deadzone_lo));
          __builtin_prefetch(d0020, 0, 1);
          __builtin_prefetch(m0020, 0, 1);
          res_s = res_c;
          uint32_t w_new = bump+e_top+2;
          go = lowbits<3;
          // The partial store this was written as -- `LOWORD(w_new) = w_top +
          // (w_new>>2)` -- kept a high half that the next line throws away.
          // Sixteen bits in and sixteen bits out.
          mir[0].weighted = (int16_t)(w_top+(w_new>>2));
          __builtin_prefetch(((P2Count*)(r0020)), 0, 1);
          __builtin_prefetch(d0010, 0, 1);
          __builtin_prefetch(m0010, 0, 1);
          __builtin_prefetch(r0010, 0, 1);
          if( go&&(w_top3 = mir[1].weighted, b_top3 = (uint8_t)mir[1].rate, res_c = res_s, go = lowbits<=0, mir[1].weighted = (int16_t)(((uint32_t)(-res_s-p2_pred(w_top3, b_top3)+2)>>2)+w_top3), go) ) {
            res_c = res_s;
            p2_update(d4000, res_s, 2);
            p2_update(r4000, res_s, 3);
            wd4000p1a = d4000[1].weighted;
            pd4000p1a = p2_pred(wd4000p1a, (uint8_t)d4000[1].rate);
            int32_t nres3 = -res_s;
            d4000[1].weighted = (int16_t)((uint32_t)(res_s-pd4000p1a+2)>>2)+wd4000p1a;
            p2_update(m4000, -res_s, 3);
            p2_update(d2000, res_c, 2);
            p2_update(r2000, res_c, 3);
            p2_nudge(&d2000[1], res_c);
            p2_update(m2000, nres3, 3);
            p2_update(d1000, res_c, 2);
            p2_update(r1000, res_c, 3);
            p2_nudge(&d1000[1], res_c);
            p2_update(m1000, nres3, 3);
            p2_update(d0800, res_c, 2);
            p2_update(r0800, res_c, 3);
            p2_nudge(&d0800[1], res_c);
            p2_update(m0800, nres3, 3);
            p2_update(d0400, res_c, 2);
            p2_update(r0400, res_c, 3);
            p2_nudge(&d0400[1], res_c);
            // Not `p2_update`: this subtracts into `nres3` itself, and the
            // residual is read again below.  A helper taking it by value
            // would drop that write.
            wm0400z = m0400->weighted;
            nres3 -= p2_pred(wm0400z, m0400->rate);
            m0400->weighted = p2_bump(wm0400z, nres3, 3);
            p2_update(d0200, res_c, 2);
            p2_update(r0200, res_c, 3);
            p2_nudge(&d0200[1], res_c);
            int32_t nres2 = -res_c;
            p2_update(m0200, -res_c, 3);
            p2_update(d0100, res_c, 2);
            p2_update(r0100, res_c, 3);
            p2_nudge(&d0100[1], res_c);
            p2_update(m0100, nres2, 3);
            p2_update(d0080, res_c, 2);
            p2_update(r0080, res_c, 3);
            p2_nudge(&d0080[1], res_c);
            p2_update(m0080, nres2, 3);
            p2_update(d0040, res_c, 2);
            p2_update(r0040, res_c, 3);
            p2_nudge(&d0040[1], res_c);
            p2_update(m0040, nres2, 3);
            p2_update(d0020, res_c, 2);
            p2_update(r0020, res_c, 3);
            p2_nudge(&d0020[1], res_c);
            wm0020a = m0020->weighted;
            pm0020a = p2_pred(wm0020a, m0020->rate);
            m0020->weighted = wm0020a+((32*((nres2-pm0020a>deadzone_hi)-(uint32_t)(nres2-pm0020a<deadzone_lo))+nres2-pm0020a+4)>>3);
            p2_update(d0010, res_c, 2);
            p2_update(r0010, res_c, 3);
            p2_nudge(&d0010[1], res_c);
            p2_update(m0010, -res_c, 3);
          } else {
            w_topm1 = mir[-1].weighted;
            res_c = res_s;
            mir[-1].weighted = (int16_t)(((uint32_t)(-res_s-p2_pred(w_topm1, (uint8_t)mir[-1].rate)+4)>>3)+w_topm1);
            p2_update(d4000, res_c, 2);
            go = lowbits<3;
            p2_update(r4000, res_c, 3);
            if( go ) {
              p2_nudge(&d4000[1], res_c);
              neg_c = -res_c;
              p2_update(&d4000[-1], res_c, 3);
              p2_update(m4000, neg_c, 3);
              p2_update(d2000, res_c, 2);
              p2_update(r2000, res_c, 3);
              p2_nudge(&d2000[1], res_c);
              p2_update(&d2000[-1], res_c, 3);
              p2_update(m2000, neg_c, 3);
              p2_update(d1000, res_c, 2);
              p2_update(r1000, res_c, 3);
              p2_nudge(&d1000[1], res_c);
              p2_update(&d1000[-1], res_c, 3);
              p2_update(m1000, neg_c, 3);
              p2_update(d0800, res_c, 2);
              p2_update(r0800, res_c, 3);
              p2_nudge(&d0800[1], res_c);
              p2_update(&d0800[-1], res_c, 3);
              p2_update(m0800, neg_c, 3);
              p2_update(d0400, res_c, 2);
              p2_update(r0400, res_c, 3);
              p2_nudge(&d0400[1], res_c);
              p2_update(&d0400[-1], res_c, 3);
              int32_t nres5 = -res_c;
              p2_update(m0400, -res_c, 3);
              p2_update(d0200, res_c, 2);
              p2_update(r0200, res_c, 3);
              p2_nudge(&d0200[1], res_c);
              p2_update(&d0200[-1], res_c, 3);
              p2_update(m0200, nres5, 3);
              p2_update(d0100, res_c, 2);
              p2_update(r0100, res_c, 3);
              p2_nudge(&d0100[1], res_c);
              p2_update(&d0100[-1], res_c, 3);
              p2_update(m0100, nres5, 3);
              p2_update(d0080, res_c, 2);
              p2_update(r0080, res_c, 3);
              p2_nudge(&d0080[1], res_c);
              p2_update(&d0080[-1], res_c, 3);
              p2_update(m0080, nres5, 3);
              p2_update(d0040, res_c, 2);
              p2_update(r0040, res_c, 3);
              p2_nudge(&d0040[1], res_c);
              neg_d = -res_c;
              p2_update(&d0040[-1], res_c, 3);
              p2_update(m0040, neg_d, 3);
              p2_update(d0020, res_c, 2);
              p2_update(r0020, res_c, 3);
              p2_nudge(&d0020[1], res_c);
              p2_update(&d0020[-1], res_c, 3);
              p2_update(m0020, neg_d, 3);
              p2_update(d0010, res_c, 2);
              p2_update(r0010, res_c, 3);
              p2_nudge(&d0010[1], res_c);
              p2_update(&d0010[-1], res_c, 3);
              res_m0010 = neg_d;
            } else {
              p2_update(&d4000[-1], res_c, 3);
              int32_t nres1 = -res_c;
              p2_update(m4000, -res_c, 3);
              p2_update(d2000, res_c, 2);
              p2_update(r2000, res_c, 3);
              p2_update(&d2000[-1], res_c, 3);
              p2_update(m2000, nres1, 3);
              p2_update(d1000, res_c, 2);
              p2_update(r1000, res_c, 3);
              p2_update(&d1000[-1], res_c, 3);
              p2_update(m1000, nres1, 3);
              p2_update(d0800, res_c, 2);
              p2_update(r0800, res_c, 3);
              p2_update(&d0800[-1], res_c, 3);
              p2_update(m0800, nres1, 3);
              p2_update(d0400, res_c, 2);
              p2_update(r0400, res_c, 3);
              p2_update(&d0400[-1], res_c, 3);
              // Not `p2_update`: this subtracts into `nres1` itself, and the
              // residual is read again below.  A helper taking it by value
              // would drop that write.
              wm0400x = m0400->weighted;
              nres1 -= p2_pred(wm0400x, m0400->rate);
              m0400->weighted = p2_bump(wm0400x, nres1, 3);
              p2_update(d0200, res_c, 2);
              p2_update(r0200, res_c, 3);
              neg_b = -res_c;
              p2_update(&d0200[-1], res_c, 3);
              p2_update(m0200, neg_b, 3);
              p2_update(d0100, res_c, 2);
              p2_update(r0100, res_c, 3);
              p2_update(&d0100[-1], res_c, 3);
              p2_update(m0100, neg_b, 3);
              p2_update(d0080, res_c, 2);
              p2_update(r0080, res_c, 3);
              p2_update(&d0080[-1], res_c, 3);
              p2_update(m0080, neg_b, 3);
              p2_update(d0040, res_c, 2);
              p2_update(r0040, res_c, 3);
              p2_update(&d0040[-1], res_c, 3);
              p2_update(m0040, neg_b, 3);
              res_t = res_c;
              p2_update(d0020, res_c, 2);
              res_c = res_t;
              p2_update(r0020, res_t, 3);
              p2_update(&d0020[-1], res_t, 3);
              int32_t nres4 = -res_t;
              p2_update(m0020, -res_t, 3);
              p2_update(d0010, res_c, 2);
              p2_update(r0010, res_c, 3);
              p2_update(&d0010[-1], res_c, 3);
              res_m0010 = nres4;
            }
            // The one counter whose update straddles the join: both arms choose a
            // residual, and the bump happens once, after them.
            p2_update(m0010, res_m0010, 3);
          }
        }
      }
  }
}

uint32_t AltP2Block::alt_p2_model(int32_t sample_in, uint8_t a4, int32_t resid_in) {
  P2Ctx* cursor0;
  int32_t n2_half;
  // The frequency record whose bins this symbol's decision moves.  It was
  // `mir_top` again -- a `uint16_t*` over a `P2Freq`, where index 1 is `f[0]`
  // and `3-is_dec` is `f[2]` or `f[1]`.  Every one of its thirteen
  // assignments was a `P2Freq*` with the cast written on it, and every use was
  // one of those two bins, so there was never anything a word pointer was for.
  P2Freq* bin;
  P2Freq* grp;
  uint32_t rec_idx;
  int32_t hi_nibble;
  P2Freq* p2_rec;
  uint32_t pair_ctx;
  int32_t is_dec;
  uint32_t idx0;
  float sample, d_bias2;
  P2Freq* frecg2, * frecg1, * frecg0, * frecg3, * gtop, * frec;
  uint32_t off0, off1, off2, off3, off4;
  NbRow* wrow_cur;
  NbRow* wrow_b;
  float ms1, bias2, bias1, d_bias, ms_a, ms_b, ms_b10, conf;
  int32_t ctx_lo, ctx_l, ctx15, fold_sel,
      sel_alt, sel0, sel1, sel2, sel3, sel4;
  int32_t dl, du, dul, dur, resid;
  P2Freq* frec_step, * frec4c;
  P2Freq* frec2, * frec3, * frec4b, * frec5, * frec6, * frec7, * prec0, * g0, * g1, * g2, * g3, * g4, * h4, * nxt4, * prec_m1, * h3, * nxt3, * h2, * nxt2, * h1, * nxt1, * h0, * nxt0;
  uint32_t step_v, step10, step13;
  ctx_lo = ctx&0xF;
  int32_t sample16 = 16*sample_in;
  cursor[0]->val = 16*sample_in;
  cursor[0]->dval = cursor[0]->val-cursor[0]->dval;
  cursor[0][1].dval = 0;
  // The deadzone half-width for this context, and where the residual falls
  // against it.  `dead` climbs 0, 1, 2, 4 with the context's low nibble;
  // `sign` is 2 below the band, 1 inside or below the top, 0 above -- a
  // three-way split written as two comparisons summed.
  //
  // The decompilation had `dead` computed twice, both times as three sign
  // shifts of `(K-ctx_lo)`, and negated the unsigned sum before casting it to
  // `int32_t` -- which is `-dead` only because the conversion is
  // implementation-defined in the way gcc happens to define it.
  const int32_t dead = (ctx_lo>6)+(ctx_lo>4)+2*(ctx_lo>9);
  cursor[0]->sign = (resid_in<=dead)+(resid_in< -dead);
  cursor[0]->mag = abs32(resid_in);
  cursor0 = cursor[0];
  sample = (float)sample16;
  dl = sample16-cursor0[-1].val;
  cursor0->dleft = abs32(dl);
  du = sample16-cursor[1]->val;
  cursor[0]->dup = abs32(du);
  dul = sample16-cursor[1][-1].val;
  cursor[0]->dupleft = abs32(dul);
  dur = sample16-cursor[1][1].val;
  cursor[0]->dupright = abs32(dur);
  resid = (int16_t)(sample16-pred_prev);
  cursor[0]->err = resid;
  cursor[0]->aerr = abs32(resid);
  wrow_cur = nb_cur;
  ms1 = wrow_cur->w[14][1]+0.000099999997f;
  wrow_b = cur[-1];
  bias2 = bias[2];
  float n2_bias = bias[0];
  d_bias2 = sample-bias2;
  bias1 = bias[1];
  d_bias = bias1-bias2;
  ms_a = ((((sample-bias2)*(bias1-bias2))-wrow_cur->w[14][0])*0.001f)+wrow_cur->w[14][0];
  ms_b = ms1+(((d_bias*d_bias)-wrow_cur->w[14][1])*0.001f);
  wrow_cur->w[14][1] = ms_b;
  ms_b10 = 0.1f*ms_b;
  if( (0.1f*ms_b)<=ms_a )
    ms_b10 = fminf(ms_b, ms_a);
  wrow_cur->w[14][0] = ms_b10;
  conf = (1.0f-(ms_b10/(ms_b+576.0f)))*2.0f;
  nlms_track_two_rows(wrow_cur, wrow_b, (sample-bias1)*2.5999999f, d_bias2*conf, conf);
  nlms_predict_and_correct(wrow_cur, sample, n2_bias);
  *cur = nb_cur;
  ++cur;
  ++above;
  code_banks(sample16);
  ctx_l = ctx;
  ++cursor[0];
  frec = &freq[ctx_l];
  ++cursor[1];
  ++cursor[2];
  ++cursor[3];
  ++cursor[4];
  step_v = frec[0].step;
  if( step_v>0x10 ) {
    is_dec = a4&1;
    ctx15 = ctx_l&0xF;
    pair_ctx = ctx_pair[a4&1];
    if( ctx15<15 ) {
      bin = &frec[1];
      p2_rescale(&frec[1]);
      step10 = (10*(uint32_t)frec[1].step)>>4;
      if( a4 ) {
        bin->f[2-is_dec] += step10;
        update_binary_pair(model_strip(pair_ctx+1), (a4-1)>>1);
      } else {
        bin->f[0] += step10;
      }
      if( ctx15<=0 ) {
// The residual coder, entered two ways: by falling into it when the context's
// low nibble is zero, and by the `goto` at the bottom of this function, which
// jumps back *into* this block from outside it.
//
// It stays a label.  A structured form needs a loop around the `if` and a flag
// to say which way it was entered -- one more level of nesting and one more
// variable, to remove one `goto` that already says what it does.  That is the
// trade the refactoring plan names when it says to keep state-machine labels,
// and this is one.
code_residual:
        step_v = ctx;
        if( freq[step_v].step<=0x1Au )
          return step_v;
        fold_sel = 2-(fold[(uint8_t)-resid_in]&1);
        if( !fold[(uint8_t)-resid_in] )
          fold_sel = fold[(uint8_t)-resid_in];
        step_v = ctx_w[4].w[2-ctx_w[4].sel]+ctx_w[3].w[2-ctx_w[3].sel]+ctx_w[2].w[2-ctx_w[2].sel]+ctx_w[1].w[2-ctx_w[1].sel]+(ctx_w[0].w[1]+(ctx&0x3F));
        frec_step = &freq[step_v];
        p2_rec = frec_step;
        if( ctx15<15 ) {
          frec2 = &frec_step[1];
          bin = frec2;
          p2_freq_add(frec2, fold_sel, 4);
          if( ctx15<=0 )
            goto counters_done;
        } else {
        }
        bin = &p2_rec[-1];
        p2_freq_add(&p2_rec[-1], fold_sel, 4);
counters_done:
        if( a4 ) {
          n2_half = (a4-1)>>1;
          hi_nibble = (uint8_t)pair_ctx&0xF0;
          if( hi_nibble>=0xF0||(update_binary_pair(model_strip(pair_ctx+16), n2_half), hi_nibble>0) ) {
            update_binary_pair(model_strip(pair_ctx-16), n2_half);
          }
        }
        prec0 = &p2_rec[0];
        p2_freq_add(&p2_rec[0], fold_sel, 6);
        if( !plane_idx||freq[ctx].step>0x100u ) {
          sel_alt = 2-is_dec;
          if( !a4 )
            sel_alt = 0;
          sel0 = ctx_w[0].sel;
          is_dec = sel_alt;
          if( sel0==1 ) {
            h0 = &freq[ctx_w[0].w[0]+step_v-ctx_w[0].w[1]];
            p2_freq_add(h0, fold_sel, 4);
            off0 = ctx-ctx_w[0].w[1];
            frecg0 = &freq[off0+ctx_w[0].w[0]];
            idx0 = ctx_w[0].w[2]+off0;
            grp = frecg0;
            frec3 = &frecg0[0];
            bin = frec3;
            p2_freq_add(frec3, is_dec, 3);
            if( ctx15<15 ) {
              bin = &grp[1];
              p2_freq_add(&grp[1], is_dec, 4);
              nxt0 = &freq[idx0+1];
              p2_freq_add(&freq[idx0+1], is_dec, 2);
            }
            if( ctx15>2 ) {
              bin = &grp[-1];
              p2_freq_add(&grp[-1], is_dec, 6);
            }
          } else {
            g0 = &freq[step_v+ctx_w[0].w[1]-ctx_w[0].w[2-sel0]];
            p2_freq_add(g0, fold_sel, 7);
            grp = (&freq[ctx_w[0].w[1]+(ctx-ctx_w[0].w[ctx_w[0].sel])]);
            bin = &grp[0];
            p2_freq_add(&grp[0], is_dec, 7);
            if( ctx15<15 ) {
              bin = &grp[1];
              p2_freq_add(&grp[1], is_dec, 5);
            }
            if( ctx15>0 ) {
              bin = &grp[-1];
              p2_freq_add(&grp[-1], is_dec, 6);
            }
          }
          sel1 = ctx_w[1].sel;
          if( sel1==1 ) {
            frec4b = &freq[ctx_w[1].w[0]+step_v-ctx_w[1].w[1]];
            bin = frec4b;
            p2_freq_add(frec4b, fold_sel, 4);
            off1 = ctx-ctx_w[1].w[1];
            frecg1 = &freq[off1+ctx_w[1].w[0]];
            idx0 = ctx_w[1].w[2]+off1;
            grp = frecg1;
            h1 = &frecg1[0];
            p2_freq_add(h1, is_dec, 3);
            if( ctx15<15 ) {
              bin = &grp[1];
              p2_freq_add(&grp[1], is_dec, 4);
              nxt1 = &freq[idx0+1];
              p2_freq_add(&freq[idx0+1], is_dec, 2);
            }
            if( ctx15>2 ) {
              bin = &grp[-1];
              p2_freq_add(&grp[-1], is_dec, 6);
            }
          } else {
            g1 = &freq[step_v+ctx_w[1].w[1]-ctx_w[1].w[2-sel1]];
            p2_freq_add(g1, fold_sel, 7);
            grp = (&freq[ctx_w[1].w[1]+(ctx-ctx_w[1].w[ctx_w[1].sel])]);
            bin = &grp[0];
            p2_freq_add(&grp[0], is_dec, 7);
            if( ctx15<15 ) {
              bin = &grp[1];
              p2_freq_add(&grp[1], is_dec, 5);
            }
            if( ctx15>0 ) {
              bin = &grp[-1];
              p2_freq_add(&grp[-1], is_dec, 6);
            }
          }
          sel2 = ctx_w[2].sel;
          if( sel2==1 ) {
            frec5 = &freq[ctx_w[2].w[0]+step_v-ctx_w[2].w[1]];
            bin = frec5;
            p2_freq_add(frec5, fold_sel, 4);
            off2 = ctx-ctx_w[2].w[1];
            frecg2 = &freq[off2+ctx_w[2].w[0]];
            idx0 = ctx_w[2].w[2]+off2;
            grp = frecg2;
            h2 = &frecg2[0];
            p2_freq_add(h2, is_dec, 3);
            if( ctx15<15 ) {
              bin = &grp[1];
              p2_freq_add(&grp[1], is_dec, 4);
              nxt2 = &freq[idx0+1];
              p2_freq_add(&freq[idx0+1], is_dec, 2);
            }
            if( ctx15>2 ) {
              bin = &grp[-1];
              p2_freq_add(&grp[-1], is_dec, 6);
            }
          } else {
            g2 = &freq[step_v+ctx_w[2].w[1]-ctx_w[2].w[2-sel2]];
            p2_freq_add(g2, fold_sel, 7);
            grp = (&freq[ctx_w[2].w[1]+(ctx-ctx_w[2].w[ctx_w[2].sel])]);
            bin = &grp[0];
            p2_freq_add(&grp[0], is_dec, 7);
            if( ctx15<15 ) {
              bin = &grp[1];
              p2_freq_add(&grp[1], is_dec, 5);
            }
            if( ctx15>0 ) {
              bin = &grp[-1];
              p2_freq_add(&grp[-1], is_dec, 6);
            }
          }
          sel3 = ctx_w[3].sel;
          if( sel3==1 ) {
            frec6 = &freq[ctx_w[3].w[0]+step_v-ctx_w[3].w[1]];
            bin = frec6;
            p2_freq_add(frec6, fold_sel, 4);
            off3 = ctx-ctx_w[3].w[1];
            frecg3 = &freq[off3+ctx_w[3].w[0]];
            idx0 = ctx_w[3].w[2]+off3;
            grp = frecg3;
            h3 = &frecg3[0];
            p2_freq_add(h3, is_dec, 3);
            if( ctx15<15 ) {
              bin = &grp[1];
              p2_freq_add(&grp[1], is_dec, 4);
              nxt3 = &freq[idx0+1];
              p2_freq_add(&freq[idx0+1], is_dec, 2);
            }
            if( ctx15>2 ) {
              bin = &grp[-1];
              p2_freq_add(&grp[-1], is_dec, 6);
            }
          } else {
            g3 = &freq[step_v+ctx_w[3].w[1]-ctx_w[3].w[2-sel3]];
            p2_freq_add(g3, fold_sel, 7);
            grp = (&freq[ctx_w[3].w[1]+(ctx-ctx_w[3].w[ctx_w[3].sel])]);
            bin = &grp[0];
            p2_freq_add(&grp[0], is_dec, 7);
            if( ctx15<15 ) {
              bin = &grp[1];
              p2_freq_add(&grp[1], is_dec, 5);
            }
            if( ctx15>0 ) {
              bin = &grp[-1];
              p2_freq_add(&grp[-1], is_dec, 6);
            }
          }
          sel4 = ctx_w[4].sel;
          if( sel4==1 ) {
            frec7 = &freq[ctx_w[4].w[0]+step_v-ctx_w[4].w[1]];
            bin = frec7;
            p2_freq_add(frec7, fold_sel, 4);
            off4 = ctx-ctx_w[4].w[1];
            frec4c = &freq[off4+ctx_w[4].w[0]];
            rec_idx = ctx_w[4].w[2]+off4;
            p2_rec = frec4c;
            h4 = &frec4c[0];
            p2_freq_add(h4, is_dec, 3);
            if( ctx15<15 ) {
              bin = &p2_rec[1];
              p2_freq_add(&p2_rec[1], is_dec, 4);
              nxt4 = &freq[rec_idx+1];
              p2_freq_add(nxt4, is_dec, 2);
            }
            if( ctx15>2 ) {
              prec_m1 = &p2_rec[-1];
              p2_freq_add(&p2_rec[-1], is_dec, 6);
            }
          } else {
            g4 = &freq[step_v+ctx_w[4].w[1]-ctx_w[4].w[2-sel4]];
            p2_freq_add(g4, fold_sel, 7);
            gtop = (&freq[ctx_w[4].w[1]+(ctx-ctx_w[4].w[ctx_w[4].sel])]);
            p2_freq_add(&gtop[0], is_dec, 7);
            if( ctx15<15 ) {
              p2_freq_add(&gtop[1], is_dec, 5);
            }
            if( ctx15>0 ) {
              p2_freq_add(&gtop[-1], is_dec, 6);
            }
          }
        }
        return step_v;
      }
      frec = &freq[ctx];
    }
    bin = &frec[-1];
    p2_rescale(&frec[-1]);
    step13 = (13*(uint32_t)frec[-1].step)>>4;
    if( a4 ) {
      bin->f[2-is_dec] += step13;
      update_binary_pair(model_strip(pair_ctx-1), (a4-1)>>1);
    } else {
      bin->f[0] += step13;
    }
    goto code_residual;
  }
  return step_v;
}

// alt_p2_encode.inc -- the predictor-2 model, encoding.

// `P2Coef` in alt_p2_block.inc is the coefficient-table borrow both directions
// do for the length of one image.  This file's header used to say the encoder
// did it and the decoder did not; the decoder does, in the same six lines, and
// the two are one object now.
int32_t alt_model_p2_encode(BmfImage* p_i, uint8_t* a2) {
  AltP2Block* plane[4];
  uint32_t xf4, i;
  bool xf2;
  int16_t seed1, l7c, seed2;
  uint32_t src1;
  AltP2Block* blk0, ** xf3;
  NbRow **cur, **r1;
  NbRow *b4, **b0;
  int32_t nplanes, want0, off0, seed0, at0, cur0, code0, cur1, code1, cur2, code2, l5c, seed3, nplanes2;
  uint8_t* out = a2;
  P2Coef p2_coef;
  p2_coef.fold();
  int32_t row_i = p_i->width;
  int32_t height = p_i->height;
  if( plane_count>0 ) {
    int32_t pl = 0;
    do {
      AltP2Block* page = (AltP2Block*)bmf_page_alloc(sizeof(AltP2Block));
      plane[pl] = page ? page->alt_p2_alloc(row_i, pl) : nullptr;
      ++pl;
    } while( pl<plane_count );
  }
  int32_t xf0 = plane_desc[plane_desc[1].src_plane].flags&8;
  int32_t np = plane_desc[plane_desc[2].src_plane].flags&8;
  int32_t y = (plane_desc[plane_desc[3].src_plane].flags)&8;
  rc_begin_encode();
  if( height>0 ) {
    src1 = 0;
    int32_t first = -row_i;
    uint32_t row_bytes = 18*row_i+234;
    uint32_t code3 = row_i+13;
    nplanes = plane_count;
    do {
      if( nplanes>0 ) {
        xf4 = src1;
        int32_t pl2 = 0;
        do {
          ++pl2;
          if( xf4 ) {
            xf3 = &plane[pl2];
            if( xf4==1 ) {
              AltP2Block *blk_k = (AltP2Block*)(*(xf3-1));
              {
                P2Ctx*const here = blk_k->cursor[0];
                here[0] = here[-1];
                here[1] = here[-1];
                here[2] = here[-1];
                here[3] = here[-1];
                here[4] = here[-1];
              }
              P2Ctx*const rec4 = blk_k->cursor[0]+first;
              rec4[-1] = rec4[0];
              rec4[-2] = rec4[1];
              rec4[-3] = rec4[2];
              rec4[-4] = rec4[3];
              rec4[-5] = rec4[4];
              rec4[-6] = rec4[5];
              rec4[-7] = rec4[6];
              rec4[-8] = rec4[7];
              memcpy(blk_k->buf[1], blk_k->buf[0], row_bytes);
              memcpy(blk_k->buf[2], blk_k->buf[0], row_bytes);
              memcpy(blk_k->buf[3], blk_k->buf[0], row_bytes);
            }
          } else {
            AltP2Block *src2 = (AltP2Block*)(plane[pl2-1]);
            AltP2Block** back = &plane[pl2];
            int32_t src3 = 0;
            do {
              int32_t xf1 = src3;
              src2->buf[0][xf1].val = 256;
              xf2 = (uint32_t)(++src3)<code3;
              src2->buf[0][xf1].dval = 256;
              src2->buf[0][xf1].err = -16;
              src2->buf[0][xf1].sign = 1;
              src2->buf[0][xf1].mag = 3;
              src2->buf[0][xf1].aerr = 512;
              src2->buf[0][xf1].dupright = 512;
              src2->buf[0][xf1].dupleft = 512;
              src2->buf[0][xf1].dup = 1024;
              src2->buf[0][xf1].dleft = 256;
            } while( xf2 );
            xf3 = back;
            memcpy(src2->buf[1], src2->buf[0], row_bytes);
            memcpy(src2->buf[2], src2->buf[0], row_bytes);
            memcpy(src2->buf[3], src2->buf[0], row_bytes);
            src2->cursor[0] = src2->buf[0]+row_i+8;
            src2->cursor[1] = src2->buf[1]+row_i+8;
            src2->cursor[2] = src2->buf[2]+row_i+8;
            src2->cursor[3] = src2->buf[3]+row_i+8;
            src2->cursor[4] = src2->buf[4]+row_i+8;
          }
          AltP2Block *blk_r = (AltP2Block*)(*(xf3-1));
          cur = blk_r->cur;
          b4 = cur[-1];
          cur[1] = b4;
          *blk_r->cur = b4;
          b0 = blk_r->row0;
          r1 = blk_r->row1;
          blk_r->row0 = r1;
          blk_r->row1 = b0;
          r1 += 2;
          blk_r->cur = r1;
          b0 += 2;
          blk_r->above = b0;
          r1[-1] = *b0;
          blk_r->cur[-2] = *b0;
          memset(blk_r->p2_row, 0, 15);
          blk_r->bias[0] = 0.0f;
          blk_r->bias[1] = 0.0f;
          blk_r->bias[2] = 0.0f;
          blk_r->bias[3] = 0.0f;
          __builtin_memset(blk_r->p2_row, 0, sizeof blk_r->p2_row);
          {
            P2Ctx*const here = blk_r->cursor[0];
            here[0] = here[-1];
            here[1] = here[-2];
            here[2] = here[-3];
            here[3] = here[-4];
            here[4] = here[-5];
          }
          P2Ctx *buf3 = blk_r->buf[3];
          P2Ctx *bb4 = blk_r->buf[4];
          P2Ctx *buf2 = blk_r->buf[2];
          P2Ctx *buf1 = blk_r->buf[1];
          P2Ctx *bb0 = blk_r->buf[0];
          blk_r->buf[4] = buf3;
          blk_r->buf[3] = buf2;
          blk_r->buf[2] = buf1;
          blk_r->buf[0] = bb4;
          blk_r->buf[1] = bb0;
          bb4 += 8;
          blk_r->cursor[0] = bb4;
          bb0 += 8;
          blk_r->cursor[1] = bb0;
          blk_r->cursor[2] = buf1+8;
          blk_r->cursor[3] = buf2+8;
          blk_r->cursor[4] = buf3+8;
          (bb4)[-1] = (bb0)[0];
          {
            P2Ctx*const here = blk_r->cursor[0];
            P2Ctx*const up = blk_r->cursor[1];
            here[-2] = up[1];
            here[-3] = up[2];
            here[-4] = up[3];
            here[-5] = up[4];
            here[-6] = up[5];
            here[-7] = up[6];
            here[-8] = up[7];
          }
          blk_r->cursor[0]->dval = 0;
          nplanes = plane_count;
        } while( plane_count>pl2 );
        src1 = xf4;
      }
      if( row_i<=0 ) {
        ctx_bias[0] = 0;
        ctx_bias[1] = 0;
        ctx_bias[2] = 0;
        ctx_bias[3] = 0;
      } else {
        xf4 = src1;
        want0 = 0;
        off0 = 0;
        seed0 = 0;
        at0 = 0;
        for( i = 0; i<(uint32_t)row_i; ++i ) {
          int32_t off0b = plane_desc[0].src_plane;
          ctx_bias[0] = at0>>3;
          ctx_bias[1] = seed0>>3;
          ctx_bias[2] = off0>>3;
          ctx_bias[3] = want0>>3;
          blk0 = (AltP2Block*)(plane[0]);
          cur0 = out[plane_desc[0].src_plane];
          int32_t pred0 = plane[0]->alt_p2_context(plane[2], plane[1]);
          int32_t resid0 = (uint8_t)(cur0-pred0);
          code0 = (uint8_t)blk0->fold[resid0];
          int32_t out0 = out[off0b];
          int32_t recon0b = (uint8_t)(pred0+(blk0->unfold[code0]));
          int32_t recon0 = (uint8_t)(recon0b+out0-cur0);
          int32_t drift0 = out0-recon0;
          if( drift0<-16||drift0>16 ) {
            code0 = (uint8_t)blk0->fold_hi[resid0];
          } else {
            cur0 = recon0b;
            out[off0b] = recon0;
          }
          blk0->freq[blk0->ctx].encode_symbol(blk0->ctx_pair, code0);
          blk0->alt_p2_model(cur0, code0, cur0-pred0);
          P2Ctx *rec0 = blk0->cursor[0];
          int32_t l7a = rec0[-1].dupright;
          int32_t l4a = rec0[-1].dleft;
          int32_t l5a = rec0[-1].dup;
          ctx_bias[0] += 32*rec0[-1].dupleft;
          ctx_bias[1] += 32*l7a;
          ctx_bias[2] += 32*l4a;
          ctx_bias[3] += 32*l5a;
          if( xf0 )
            seed1 = 16*out[plane_desc[0].src_plane];
          else
            seed1 = 0;
          AltP2Block *blk1 = (AltP2Block*)(plane[1]);
          plane[1]->cursor[0]->dval = seed1;
          int32_t off1 = plane_desc[1].src_plane;
          cur1 = out[plane_desc[1].src_plane];
          int32_t pred1 = blk1->alt_p2_context(plane[0], plane[2]);
          int32_t resid1 = (uint8_t)(cur1-pred1);
          code1 = blk1->fold[resid1];
          int32_t out1 = out[off1];
          int32_t recon1b = (uint8_t)(pred1+blk1->unfold[code1]);
          int32_t recon1 = (uint8_t)(recon1b+out1-cur1);
          int32_t drift1 = out1-recon1;
          if( drift1<-16||drift1>16 ) {
            code1 = blk1->fold_hi[resid1];
          } else {
            cur1 = recon1b;
            out[off1] = recon1;
          }
          blk1->freq[blk1->ctx].encode_symbol(blk1->ctx_pair, code1);
          blk1->alt_p2_model(cur1, code1, cur1-pred1);
          P2Ctx *rec1 = blk1->cursor[0];
          int32_t l7b = rec1[-1].dupright;
          int32_t l4b = rec1[-1].dleft;
          int32_t l5b = rec1[-1].dup;
          ctx_bias[0] += 32*rec1[-1].dupleft;
          ctx_bias[1] += 32*l7b;
          ctx_bias[2] += 32*l4b;
          ctx_bias[3] += 32*l5b;
          if( np )
            seed2 = (plane_desc[plane_desc[2].src_plane].weight1*out[plane_desc[1].src_plane]+plane_desc[plane_desc[2].src_plane].weight0*out[plane_desc[0].src_plane])>>3;
          else
            seed2 = 0;
          AltP2Block *blk2 = (AltP2Block*)(plane[2]);
          plane[2]->cursor[0]->dval = seed2;
          int32_t off2 = plane_desc[2].src_plane;
          cur2 = out[plane_desc[2].src_plane];
          int32_t pred2 = blk2->alt_p2_context(plane[0], plane[1]);
          int32_t resid2 = (uint8_t)(cur2-pred2);
          code2 = blk2->fold[resid2];
          int32_t out2 = out[off2];
          int32_t code2b = (uint8_t)(pred2+blk2->unfold[code2]);
          int32_t recon2 = (uint8_t)(code2b+out2-cur2);
          int32_t drift2 = out2-recon2;
          if( drift2<-16||drift2>16 ) {
            code2 = blk2->fold_hi[resid2];
          } else {
            cur2 = code2b;
            out[off2] = recon2;
          }
          blk2->freq[blk2->ctx].encode_symbol(blk2->ctx_pair, code2);
          blk2->alt_p2_model(cur2, code2, cur2-pred2);
          P2Ctx *rec2 = blk2->cursor[0];
          nplanes = plane_count;
          at0 = ctx_bias[0]+32*rec2[-1].dupleft;
          seed0 = ctx_bias[1]+32*rec2[-1].dupright;
          off0 = ctx_bias[2]+32*rec2[-1].dleft;
          want0 = ctx_bias[3]+32*rec2[-1].dup;
          if( plane_count>=4 ) {
            ctx_bias[0] += 32*rec2[-1].dupleft;
            ctx_bias[1] = seed0;
            ctx_bias[2] = off0;
            ctx_bias[3] = want0;
            if( y )
              l7c = (plane_desc[plane_desc[3].src_plane].weight2*out[2]+plane_desc[plane_desc[3].src_plane].weight1*out[1]+plane_desc[plane_desc[3].src_plane].weight0**out)>>3;
            else
              l7c = 0;
            AltP2Block *l4c = (AltP2Block*)(plane[3]);
            plane[3]->cursor[0]->dval = l7c;
            int32_t alpha_src = plane_desc[3].src_plane;
            l5c = out[plane_desc[3].src_plane];
            int32_t x = l4c->alt_p2_context(plane[2], plane[0]);
            int32_t w = (uint8_t)(l5c-x);
            seed3 = l4c->fold[w];
            int32_t blk3 = out[alpha_src];
            int32_t cur3 = (uint8_t)(x+l4c->unfold[seed3]+blk3-l5c);
            int32_t drift3 = blk3-cur3;
            if( drift3<-16||drift3>16 ) {
              seed3 = l4c->fold_hi[w];
            } else {
              l5c = (uint8_t)(x+l4c->unfold[seed3]);
              out[alpha_src] = cur3;
            }
            l4c->freq[l4c->ctx].encode_symbol(l4c->ctx_pair, seed3);
            l4c->alt_p2_model(l5c, seed3, l5c-x);
            P2Ctx *rec3 = l4c->cursor[0];
            nplanes = plane_count;
            at0 = ctx_bias[0]+32*rec3[-1].dupleft;
            seed0 = ctx_bias[1]+32*rec3[-1].dupright;
            off0 = ctx_bias[2]+32*rec3[-1].dleft;
            want0 = ctx_bias[3]+32*rec3[-1].dup;
          }
          out += nplanes;
        }
        src1 = xf4;
        ctx_bias[0] = at0;
        ctx_bias[1] = seed0;
        ctx_bias[2] = off0;
        ctx_bias[3] = want0;
      }
      ++src1;
    } while( src1<(uint32_t)height );
  }
  rc_end_encode();
  p2_coef.restore();
  nplanes2 = plane_count;
  if( plane_count>0 ) {
    int32_t pl3 = 0;
    do {
      if( plane[pl3] ) {
        plane[pl3]->alt_p2_free(1);
        nplanes2 = plane_count;
      }
      ++pl3;
    } while( pl3<nplanes2 );
  }
  return nplanes2;
}

// alt_p2_decode.inc -- the predictor-2 model, decoding.

// The mirror of `alt_p2_encode.inc`, minus the near-lossless drift control,
// which has nothing to decide here because the code says which fold was used.
//
// It used to say "minus two things", the second being the coefficient-table
// borrow.  That was wrong: this function did the borrow too, in six lines
// identical to the encoder's, 260 lines from the six that undo them.  Both are
// `P2Coef::fold`/`restore` now, which is also how the claim got checked.
int32_t alt_model_p2_decode(BmfImage* p_i, uint8_t* out) {
  AltP2Block* plane[4], ** w;
  uint32_t i_1, first;
  int16_t seed1;
  uint32_t i, src2;
  int16_t seed3, seed2;
  AltP2Block** planep;
  NbRow **cur, **r1;
  bool xf3, off;
  NbRow *b4, **b0;
  int32_t nplanes, nplanes2;
  P2Coef p2_coef;
  p2_coef.fold();
  i = p_i->width;
  int32_t raw = p_i->height;
  if( plane_count>0 ) {
    int32_t pl = 0;
    do {
      AltP2Block* page = (AltP2Block*)bmf_page_alloc(sizeof(AltP2Block));
      plane[pl] = page ? page->alt_p2_alloc(i, pl) : nullptr;
      ++pl;
    } while( pl<plane_count );
  }
  int32_t xf0 = plane_desc[plane_desc[1].src_plane].flags&8;
  int32_t dc_flag = plane_desc[plane_desc[2].src_plane].flags&8;
  int32_t xf4 = (plane_desc[plane_desc[3].src_plane].flags)&8;
  rc_begin_decode();
  if( raw>0 ) {
    src2 = 0;
    int32_t back = -i;
    nplanes = plane_count;
    uint32_t row_bytes = 18*i+234;
    uint32_t np = i+13;
    do {
      if( nplanes>0 ) {
        first = src2;
        int32_t pl2 = 0;
        i_1 = i;
        do {
          ++pl2;
          if( first ) {
            planep = &plane[pl2];
            if( first==1 ) {
              AltP2Block *blk_k = (AltP2Block*)(*(planep-1));
              {
                P2Ctx*const here = blk_k->cursor[0];
                here[0] = here[-1];
                here[1] = here[-1];
                here[2] = here[-1];
                here[3] = here[-1];
                here[4] = here[-1];
              }
              P2Ctx*const rec2 = blk_k->cursor[0]+back;
              rec2[-1] = rec2[0];
              rec2[-2] = rec2[1];
              rec2[-3] = rec2[2];
              rec2[-4] = rec2[3];
              rec2[-5] = rec2[4];
              rec2[-6] = rec2[5];
              rec2[-7] = rec2[6];
              rec2[-8] = rec2[7];
              memcpy(blk_k->buf[1], blk_k->buf[0], row_bytes);
              memcpy(blk_k->buf[2], blk_k->buf[0], row_bytes);
              memcpy(blk_k->buf[3], blk_k->buf[0], row_bytes);
            }
          } else {
            AltP2Block *src3 = (AltP2Block*)(plane[pl2-1]);
            w = &plane[pl2];
            int32_t xf1 = 0;
            do {
              int32_t xf2 = xf1;
              src3->buf[0][xf2].val = 256;
              xf3 = (uint32_t)(++xf1)<np;
              src3->buf[0][xf2].dval = 256;
              src3->buf[0][xf2].err = -16;
              src3->buf[0][xf2].sign = 1;
              src3->buf[0][xf2].mag = 3;
              src3->buf[0][xf2].aerr = 512;
              src3->buf[0][xf2].dupright = 512;
              src3->buf[0][xf2].dupleft = 512;
              src3->buf[0][xf2].dup = 1024;
              src3->buf[0][xf2].dleft = 256;
            } while( xf3 );
            planep = w;
            memcpy(src3->buf[1], src3->buf[0], row_bytes);
            memcpy(src3->buf[2], src3->buf[0], row_bytes);
            memcpy(src3->buf[3], src3->buf[0], row_bytes);
            src3->cursor[0] = src3->buf[0]+i+8;
            src3->cursor[1] = src3->buf[1]+i+8;
            src3->cursor[2] = src3->buf[2]+i+8;
            src3->cursor[3] = src3->buf[3]+i+8;
            src3->cursor[4] = src3->buf[4]+i+8;
          }
          AltP2Block *blk_r = (AltP2Block*)(*(planep-1));
          cur = blk_r->cur;
          b4 = cur[-1];
          cur[1] = b4;
          *blk_r->cur = b4;
          b0 = blk_r->row0;
          r1 = blk_r->row1;
          blk_r->row0 = r1;
          blk_r->row1 = b0;
          r1 += 2;
          blk_r->cur = r1;
          b0 += 2;
          blk_r->above = b0;
          r1[-1] = *b0;
          blk_r->cur[-2] = *b0;
          memset(blk_r->p2_row, 0, 15);
          blk_r->bias[0] = 0.0f;
          blk_r->bias[1] = 0.0f;
          blk_r->bias[2] = 0.0f;
          blk_r->bias[3] = 0.0f;
          __builtin_memset(blk_r->p2_row, 0, sizeof blk_r->p2_row);
          {
            P2Ctx*const here = blk_r->cursor[0];
            here[0] = here[-1];
            here[1] = here[-2];
            here[2] = here[-3];
            here[3] = here[-4];
            here[4] = here[-5];
          }
          P2Ctx *buf3 = blk_r->buf[3];
          P2Ctx *bb4 = blk_r->buf[4];
          P2Ctx *buf2 = blk_r->buf[2];
          P2Ctx *buf1 = blk_r->buf[1];
          P2Ctx *bb0 = blk_r->buf[0];
          blk_r->buf[4] = buf3;
          blk_r->buf[3] = buf2;
          blk_r->buf[2] = buf1;
          blk_r->buf[0] = bb4;
          blk_r->buf[1] = bb0;
          bb4 += 8;
          blk_r->cursor[0] = bb4;
          bb0 += 8;
          blk_r->cursor[1] = bb0;
          blk_r->cursor[2] = buf1+8;
          blk_r->cursor[3] = buf2+8;
          blk_r->cursor[4] = buf3+8;
          (bb4)[-1] = (bb0)[0];
          {
            P2Ctx*const here = blk_r->cursor[0];
            P2Ctx*const up = blk_r->cursor[1];
            here[-2] = up[1];
            here[-3] = up[2];
            here[-4] = up[3];
            here[-5] = up[4];
            here[-6] = up[5];
            here[-7] = up[6];
            here[-8] = up[7];
          }
          blk_r->cursor[0]->dval = 0;
          nplanes = plane_count;
        } while( plane_count>pl2 );
        src2 = first;
        i = i_1;
      }
      ctx_bias[3] = 0;
      ctx_bias[2] = 0;
      ctx_bias[1] = 0;
      ctx_bias[0] = 0;
      if( i>0 ) {
        first = src2;
        uint32_t i_2 = 0;
        i_1 = i;
        do {
          ctx_bias[0] >>= 3;
          ctx_bias[1] >>= 3;
          ctx_bias[2] >>= 3;
          ctx_bias[3] >>= 3;
          AltP2Block* blk0 = (AltP2Block*)(plane[0]);
          int32_t pred0 = plane[0]->alt_p2_context(plane[2], plane[1]);
          P2Freq* freq = &blk0->freq[blk0->ctx];
          int32_t code0 = freq->decode_symbol(blk0->ctx_pair);
          int32_t val0 = (uint8_t)(pred0+(blk0->unfold[code0]));
          blk0->alt_p2_model(val0, code0, val0-pred0);
          P2Ctx *cur0 = blk0->cursor[0];
          ctx_bias[0] += 32*cur0[-1].dupleft;
          ctx_bias[1] += 32*cur0[-1].dupright;
          ctx_bias[2] += 32*cur0[-1].dleft;
          ctx_bias[3] += 32*cur0[-1].dup;
          off = xf0==0;
          out[plane_desc[0].src_plane] = val0;
          if( off )
            seed1 = 0;
          else
            seed1 = 16*out[plane_desc[0].src_plane];
          AltP2Block *blk1 = (AltP2Block*)(plane[1]);
          plane[1]->cursor[0]->dval = seed1;
          int32_t pred1 = blk1->alt_p2_context(plane[0], plane[2]);
          int32_t code1 = blk1->freq[blk1->ctx].decode_symbol(blk1->ctx_pair);
          int32_t val1 = (uint8_t)(pred1+blk1->unfold[code1]);
          blk1->alt_p2_model(val1, code1, val1-pred1);
          P2Ctx *cur1 = blk1->cursor[0];
          int32_t l7a = cur1[-1].dupright;
          int32_t l4a = cur1[-1].dleft;
          ctx_bias[0] += 32*cur1[-1].dupleft;
          int32_t l5a = cur1[-1].dup;
          ctx_bias[1] += 32*l7a;
          ctx_bias[2] += 32*l4a;
          ctx_bias[3] += 32*l5a;
          off = dc_flag==0;
          out[plane_desc[1].src_plane] = val1;
          if( off )
            seed2 = 0;
          else
            seed2 = (plane_desc[plane_desc[2].src_plane].weight1*out[plane_desc[1].src_plane]+plane_desc[plane_desc[2].src_plane].weight0*out[plane_desc[0].src_plane])>>3;
          AltP2Block *blk2 = (AltP2Block*)(plane[2]);
          plane[2]->cursor[0]->dval = seed2;
          int32_t pred2 = blk2->alt_p2_context(plane[0], plane[1]);
          int32_t code2 = blk2->freq[blk2->ctx].decode_symbol(blk2->ctx_pair);
          int32_t val2 = (uint8_t)(pred2+blk2->unfold[code2]);
          blk2->alt_p2_model(val2, code2, val2-pred2);
          P2Ctx *cur2 = blk2->cursor[0];
          int32_t l7b = cur2[-1].dupright;
          int32_t l4b = cur2[-1].dleft;
          ctx_bias[0] += 32*cur2[-1].dupleft;
          int32_t l5b = cur2[-1].dup;
          ctx_bias[1] += 32*l7b;
          ctx_bias[2] += 32*l4b;
          ctx_bias[3] += 32*l5b;
          out[plane_desc[2].src_plane] = val2;
          nplanes = plane_count;
          if( plane_count>=4 ) {
            if( xf4 )
              seed3 = (plane_desc[plane_desc[3].src_plane].weight2*out[2]+plane_desc[plane_desc[3].src_plane].weight1*out[1]+plane_desc[plane_desc[3].src_plane].weight0**out)>>3;
            else
              seed3 = 0;
            AltP2Block *blk3 = (AltP2Block*)(plane[3]);
            plane[3]->cursor[0]->dval = seed3;
            int32_t pred3 = blk3->alt_p2_context(plane[2], plane[0]);
            int32_t code3 = blk3->freq[blk3->ctx].decode_symbol(blk3->ctx_pair);
            int32_t val3 = (uint8_t)(pred3+blk3->unfold[code3]);
            blk3->alt_p2_model(val3, code3, val3-pred3);
            P2Ctx *cur3 = blk3->cursor[0];
            int32_t l7c = cur3[-1].dupright;
            int32_t l4c = cur3[-1].dleft;
            int32_t l5c = cur3[-1].dup;
            ctx_bias[0] += 32*cur3[-1].dupleft;
            ctx_bias[1] += 32*l7c;
            ctx_bias[2] += 32*l4c;
            ctx_bias[3] += 32*l5c;
            out[3] = val3;
            nplanes = plane_count;
          }
          out += nplanes;
          ++i_2;
        } while( i_2<i_1 );
        src2 = first;
        i = i_1;
      }
      ++src2;
    } while( src2<(uint32_t)raw );
  }
  rc_end_decode();
  p2_coef.restore();
  nplanes2 = plane_count;
  if( plane_count>0 ) {
    int32_t pl3 = 0;
    do {
      if( plane[pl3] ) {
        plane[pl3]->alt_p2_free(1);
        nplanes2 = plane_count;
      }
      ++pl3;
    } while( pl3<nplanes2 );
  }
  return nplanes2;
}

// plane_predict.inc -- the predictors and the colour transform -- what is subtracted from
// an image before it is modelled, and added back after.

// Predictor mode 0 undoes nothing: an image coded without a predictor has
// nothing subtracted from it.  The body is empty in BMF.exe too -- the encoder
// side calls through a table of three, and this is the entry the table needs at
// index 0.
void expand_predictor_mode0(int32_t i) {
}

// The MED / LOCO-I predictor, which JPEG-LS calls the median edge detector:
// pick `min(N,W)` at a rising edge, `max(N,W)` at a falling one, and the plane
// `N + W - NW` in between.  Written out twice, once in each direction, in the
// two nested comparisons the original compiled to -- which is the same rule
// with the `min`/`max` inlined into the branch.
//
// A published predictor whose name appears nowhere is the worst kind of
// duplication: two copies, and a reader who does not already recognise it has
// to derive the rule from the branches, twice.
static inline uint8_t med_predict(int32_t west, int32_t north, int32_t northwest) {
  if( west<north ) {
    if( northwest<west )
      return (uint8_t)north;
    if( northwest<=north )
      return (uint8_t)(north+west-northwest);
  } else {
    if( northwest>west )
      return (uint8_t)north;
    if( northwest>=north )
      return (uint8_t)(north+west-northwest);
  }
  return (uint8_t)west;
}

uint32_t predict_med(uint8_t* pixels, int32_t width, int32_t height) {
  uint32_t done;
  uint32_t j, last;
  alignas(16) uint8_t fold[272];
  uint8_t *p = pixels+height*width;
  uint8_t *up = &p[-width];
  for( j = 0; j<128; ++j ) {
    fold[j] = (uint8_t)(2*j);
    fold[128+j] = (uint8_t)(-1-2*(int32_t)j);
  }
  int32_t rows_left = height-1;
  if( height!=1 ) {
    do {
      int32_t x_left = width-1;
      if( width!=1 ) {
        do {
          int32_t north = (uint8_t)*--up;
          --p;
          uint8_t pred = med_predict(p[-1], north, p[-width-1]);
          int32_t code = (uint8_t)fold[(uint8_t)(*p-pred)];
          *p = code;
          ++*(uint32_t*)&hist_scratch[4*code];
          --x_left;
        } while( x_left );
      }
      --up;
      --p;
      last = (uint8_t)fold[(uint8_t)(*p-p[-width])];
      *p = last;
      ++*(uint32_t*)&hist_scratch[4*last];
      --rows_left;
    } while( rows_left );
  }
  if( width!=1 ) {
    last = width-1;
    int32_t pairs = (width-1)/2;
    if( pairs ) {
      uint32_t k = 0;
      int32_t ofs = 0;
      do {
        uint8_t left = p[ofs-2];
        ++k;
        p[ofs-1] = fold[(uint8_t)(p[ofs-1]-left)];
        p[ofs-2] = fold[(uint8_t)(left-p[ofs-3])];
        ofs -= 2;
      } while( k<(uint32_t)pairs );
      done = 2*k+1;
    } else {
      done = 1;
    }
    if( last>(done-1) ) {
      uint8_t *q = p-done;
      last = (uint8_t)(*q-*((int8_t*)q-1));
      *q = fold[(uint8_t)last];
    }
  }
  return last;
}

void interleave_plane(BmfImage* img, uint8_t* src, int32_t plane) {
  int32_t to_ref0;
  uint8_t* base = &img->pixels[plane];
  if( !(plane_desc[plane].flags&8) ) {
    int32_t n_flat = bmf_pixels(img);
    int32_t step = plane_count;
    if( plane_count==1 ) {
      memcpy(base, src, n_flat);
      return;
    }
    int32_t i = 0;
    int32_t ofs = 0;
    do {
      base[ofs] = src[i];
      ofs += step;
      ++i;
    } while( i<n_flat );
    return;
  }
  int32_t stride = plane_count;
  int32_t n = bmf_pixels(img);
  bool by_weights;
  to_ref0 = plane_desc[0].src_plane-plane;
  int32_t to_ref1 = plane_desc[1].src_plane-plane;
  int32_t mode = plane_desc[plane].nrefs;
  int32_t dc = plane_desc[plane].dc;
  int32_t wgt1 = plane_desc[plane].weight1;
  int32_t wgt0 = plane_desc[plane].weight0;
  int32_t wgt2 = plane_desc[plane].weight2;
  by_weights = false;
  if( mode==2&&wgt0+wgt1==128 ) {
    if( !wgt1 ) {
      by_weights = true;
    } else if( !wgt0 ) {
      to_ref0 = plane_desc[1].src_plane-plane;
      by_weights = true;
    }
  }
  if( !by_weights ) {
    if( plane_desc[plane].nrefs!=1 ) {
      if( mode==2 ) {
        int32_t left2 = bmf_pixels(img);
        uint8_t *p2 = base;
        do {
          int32_t x2 = dc+(uint8_t)*src++;
          *p2 = (uint8_t)(((wgt0*p2[to_ref0]+wgt1*(uint32_t)p2[to_ref1]+40)>>7)+x2);
          p2 += stride;
          --left2;
        } while( left2 );
      } else if( mode==3 ) {
        int32_t left3 = bmf_pixels(img);
        uint8_t *p3 = base;
        do {
          int32_t x3 = dc+(uint8_t)*src++;
          *p3 = (uint8_t)(((wgt1*(uint8_t)*(p3-2)+wgt0*(uint8_t)*(p3-3)+wgt2*(uint32_t)(uint8_t)*(p3-1)+63)>>7)+x3);
          p3 += stride;
          --left3;
        } while( left3 );
      }
      return;
    }
  }
  uint8_t *ref = base+to_ref0;
  int32_t i2 = 0;
  int32_t ofs2 = 0;
  do {
    base[ofs2] = ref[ofs2]+dc+src[i2];
    ofs2 += stride;
    ++i2;
  } while( i2<n );
}

// Subtract from one plane whatever the other planes predict of it, and write
// the residual to `dst`.  Four modes, chosen by `flags & 8` and `nrefs`:
//
//   no transform      copy the plane out, interleaved to flat
//   one reference     `x - dc - ref`, a plain difference
//   two references    `x - dc - (w0*a + w1*b + 40)/128`
//   three references  `x - dc - (w0*a + w1*b + w2*c + 63)/128`
//
// The two-reference case degenerates to the one-reference case when one weight
// is 128 and the other 0, and the code takes that path explicitly -- which is
// the `by_weights` flag below, and why a two-reference descriptor can end up
// reading only one plane.
void colour_transform(BmfImage* img, uint8_t* dst, int32_t plane) {
  int32_t to_ref0;
  uint8_t *src = &img->pixels[plane];
  if( !(plane_desc[plane].flags&8) ) {
    int32_t n_flat = bmf_pixels(img);
    int32_t step = plane_count;
    if( plane_count==1 ) {
      memcpy(dst, src, n_flat);
      return;
    }
    int32_t i = 0;
    int32_t ofs = 0;
    do {
      dst[i] = src[ofs];
      ofs += step;
      ++i;
    } while( i<n_flat );
    return;
  }
  int32_t stride = plane_count;
  int32_t n = bmf_pixels(img);
  bool by_weights;
  to_ref0 = plane_desc[0].src_plane-plane;
  int32_t to_ref1 = plane_desc[1].src_plane-plane;
  int32_t mode = plane_desc[plane].nrefs;
  int32_t dc = plane_desc[plane].dc;
  int32_t wgt1 = plane_desc[plane].weight1;
  int32_t wgt0 = plane_desc[plane].weight0;
  int32_t wgt2 = plane_desc[plane].weight2;
  by_weights = false;
  if( mode==2&&wgt0+wgt1==128 ) {
    if( !wgt1 ) {
      by_weights = true;
    } else if( !wgt0 ) {
      to_ref0 = plane_desc[1].src_plane-plane;
      by_weights = true;
    }
  }
  if( by_weights||plane_desc[plane].nrefs==1 ) {
    uint8_t* ref = src+to_ref0;
    int32_t i2 = 0;
    int32_t ofs2 = 0;
    do {
      uint8_t d = src[ofs2]-dc-ref[ofs2];
      ofs2 += stride;
      dst[i2++] = d;
    } while( i2<n );
    return;
  }
  if( mode==2 ) {
    int32_t left2 = bmf_pixels(img);
    uint8_t *p2 = src;
    do {
      int32_t x2 = *p2-dc;
      uint32_t blend = wgt0*p2[to_ref0]+wgt1*p2[to_ref1]+40;
      p2 += stride;
      *dst++ = (uint8_t)(x2-(blend>>7));
      --left2;
    } while( left2 );
  } else if( mode==3 ) {
    int32_t left3 = bmf_pixels(img);
    uint8_t *p3 = src;
    do {
      int32_t x3 = *p3-dc;
      int32_t wsum = wgt1**(p3-2)+wgt0**(p3-3);
      int32_t w12sum = wgt2**(p3-1);
      p3 += stride;
      *dst++ = (uint8_t)(x3-((uint32_t)(wsum+w12sum+63)>>7));
      --left3;
    } while( left3 );
  }
}

uint8_t*unpredict_med(uint8_t* pixels, int32_t width, int32_t height) {
  uint32_t done;
  int32_t rows_left;
  uint32_t j, row_rest, k, x_left;
  uint8_t *p;
  alignas(16) uint8_t unfold[256];
  p = pixels+1;
  unfold[0] = 0;
  for( j = 0; j<127; ++j ) {
    unfold[2*j+1] = (uint8_t)(-1-(int32_t)j);
    unfold[2*j+2] = (uint8_t)(1+j);
  }
  unfold[255] = (uint8_t)(-1-127);
  if( width==1 ) {
    rows_left = height-1;
    if( height==1 )
      return p;
    row_rest = 0;
  } else {
    row_rest = width-1;
    uint32_t pairs = (width-1)/2;
    if( pairs ) {
      for( k = 0; k<pairs; ++k ) {
        uint8_t cur = pixels[2*k]+unfold[pixels[2*k+1]];
        pixels[2*k+1] = cur;
        pixels[2*k+2] = cur+(unfold[pixels[2*k+2]]);
        p = &pixels[2*k+3];
      }
      done = 2*k+1;
    } else {
      done = 1;
    }
    if( row_rest>done-1 ) {
      pixels[done] = pixels[done-1]+unfold[pixels[done]];
      p = &pixels[done+1];
    }
    rows_left = height-1;
    if( height==1 )
      return p;
  }
  {
    uint8_t *up = &p[-width];
    do {
      while( 1 ) {
        ++up;
        *p = unfold[(uint8_t)*p]+p[-width];
        x_left = row_rest;
        ++p;
        if( width!=1 )
          break;
        if( !--rows_left )
          return p;
      }
      do {
        uint8_t pred = med_predict(p[-1], (uint8_t)*up, p[-width-1]);
        *p = pred+unfold[(uint8_t)*p];
        ++up;
        ++p;
        --x_left;
      } while( x_left );
      --rows_left;
    } while( rows_left );
  }
  return p;
}

void transform_planes(BmfImage* p_i) {
  int32_t i;
  memset(hist_scratch, 0, 4096);
  // A scratch image in the coded buffer: sixteen bytes reserved, then a copy
  // of the header, then the pixels.  `BmfImage` is sixteen bytes, so the
  // second 16 and the 32 are the same offset said twice -- `hdr->pixels` is
  // `stream.buf+32`, which is what the copy below was addressing by number.
  BmfImage *hdr = (BmfImage*)(stream.buf+16);
  *hdr = *p_i;
  uint8_t* src_pixels = p_i->pixels;
  memcpy(hdr->pixels, p_i->pixels, p_i->data_size);
  uint8_t *tmp = (uint8_t*)bmf_new(p_i->width*p_i->height);
  if( plane_count>0 ) {
    int32_t k = 0;
    do {
      ++k;
      int32_t plane = plane_desc[k-1].src_plane;
      int32_t predictor = plane_desc[plane].flags&3;
      plane_predictor = predictor;
      int32_t alt = (uint8_t)(plane_desc[plane].flags&4)>>2;
      plane_alt_model = alt;
      if( ((plane_desc[plane].flags&8)!=0||predictor)&&!alt ) {
        colour_transform(hdr, tmp, plane);
        if( plane_predictor!=2 ) {
          if( plane_predictor==1 ) {
            predict_med(tmp, p_i->width, p_i->height);
          }
        }
        int32_t n = p_i->width*p_i->height;
        int32_t stride = plane_count;
        if( plane_count==1 ) {
          memcpy(&p_i->pixels[plane], tmp, n);
        } else {
          uint8_t *dst = &p_i->pixels[plane];
          int32_t ofs = 0;
          for( i = 0; i<n; ++i ) {
            dst[ofs] = tmp[i];
            ofs += stride;
          }
        }
      }
    } while( k<plane_count );
  }
  free(tmp);
  {
    model_plane(p_i, src_pixels, src_pixels);
  }
}

// plane.inc -- one plane in and out of the model, whichever model the header names.

void unmodel_plane(BmfImage* p_i, uint8_t* out) {
  ModelBlock* blk;
  if( plane_alt_model ) {
    if( plane_predictor==1 ) {
      if( (p_i->depth&depth_bits)==8 )
        alt_model_p1_d8_decode(out, p_i->width, p_i->height);
      else
        alt_model_p1_decode(p_i, out);
    } else if( plane_predictor==2 ) {
      if( (p_i->depth&depth_bits)==8 )
        alt_model_p2_d8_decode(out, p_i->width, p_i->height);
      else
        alt_model_p2_decode(p_i, out);
    }
  } else {
    void* raw = bmf_new(sizeof(ModelBlock));
    if( raw )
      blk = ((ModelBlock*)raw)->layout_workspace(p_i->width, p_i->height, p_i->depth&depth_bits);
    else
      blk = nullptr;
    (blk)->unmodel_plane_slow(out);
    if( blk )
      blk->free_workspace(1);
  }
}

void model_planes(BmfImage* img, uint8_t* pixels, int32_t plane) {
  plane_predictor = plane_desc[plane].flags&3;
  plane_alt_model = (uint8_t)(plane_desc[plane].flags&4)>>2;
  colour_transform(img, pixels, plane);
  // 1,024 bytes.  The original zeroed them as a `memset` of the unaligned head,
  // one aligned 16-byte store at the tail, and a loop of seven more stepping
  // back by 112 -- SSE, unrolled sevenfold, over a buffer whose start it had to
  // round up to 16 first.  The three ranges cover [0, 1023] whatever the
  // rounding takes: the head covers everything below the aligned start (at most
  // 15 bytes), the loop covers 1,008 from there, and the tail store covers what
  // the loop's own offset pushed past the end.  This runs once per plane.
  memset(hist_scratch, 0, 1024);
  {
    BmfImage hdr = *img;
    hdr.depth = 72;
    if( plane_predictor==1&&!plane_alt_model )
      predict_med(pixels, img->width, img->height);
    model_plane(&hdr, pixels, pixels);
  }
}

// model_plane.inc -- one plane through the main model.

void model_plane(BmfImage* p_i, uint8_t* pixels, uint8_t* raw) {
  ModelBlock* blk;
  int16_t w2n;
  uint32_t row_w;
  int32_t w3, w4, lvl2, live, y;
  uint16_t w2;
  uint32_t j, k;
  SymList* lists1, * lists0;
  if( plane_alt_model ) {
    if( plane_predictor==1 ) {
      if( (p_i->depth&depth_bits)==8 )
        alt_model_p1_d8_encode(pixels, p_i->width, p_i->height, raw);
      else
        alt_model_p1_encode(p_i, pixels);
    } else if( plane_predictor==2 ) {
      if( (p_i->depth&depth_bits)==8 )
        alt_model_p2_d8_encode(pixels, p_i->width, p_i->height, raw);
      else
        alt_model_p2_encode(p_i, pixels);
    }
  } else {
    void* ws = bmf_new(sizeof(ModelBlock));
    if( ws )
      blk = ((ModelBlock*)ws)->layout_workspace(p_i->width, p_i->height, p_i->depth&depth_bits);
    else
      blk = nullptr;
    rc_begin_encode();
    reduce_alphabet(blk, pixels);
    int32_t bucket = 0;
    int32_t g = 0;
    do {
      int32_t flags = ctx_group_flags[g];
      blk->ctx_state[flags] = g;
      int32_t lo = 0;
      // The five selector weights are the five outcomes of the stage-one
      // decision -- north, west, north-east, north-west, escape -- and one of
      // fifteen groups says which of them share a weight.  Each bit of the
      // group's mask folds one weight into another and zeroes the source, so
      // the six below are read in the order the folds compose: 3 doubles first,
      // then 4 into 2, then 3 into 2, then 4 into 1, then 3 into 1, then 2 into
      // 1.  A group with no bits set gives all five their own weight.
      int32_t f_w3_double = flags&4;
      int32_t f_w4_to_w2 = flags&2;
      int32_t f_w3_to_w2 = flags&0x10;
      int32_t f_w4_to_w1 = flags&1;
      int32_t f_w3_to_w1 = flags&8;
      int32_t f_w2_to_w1 = flags&0x20;
      do {
        uint32_t hi = 0;
        do {
          blk->ctx_bucket[g+15*lo+75*hi] = bucket;
          int32_t alpha = blk->alphabet;
          FreqRec* rec = &blk->grid[bucket];
          w2n = 2;
          rec->w[0] = 2;
          w2 = 2;
          w3 = 2;
          w4 = 2;
          if( f_w3_double ) {
            w3 = 4;
            w4 = 0;
          }
          if( f_w4_to_w2 ) {
            w2 = w4+2;
            w4 = 0;
          }
          if( f_w3_to_w2 ) {
            w2 = w3+w2;
            w3 = 0;
          }
          if( f_w4_to_w1 ) {
            w2n = w4+2;
            w4 = 0;
            rec->w[4] = 0;
          } else {
            rec->w[4] = w4;
          }
          if( f_w3_to_w1 ) {
            w2n += w3;
            w3 = 0;
            rec->w[3] = 0;
          } else {
            rec->w[3] = w3;
          }
          if( f_w2_to_w1 ) {
            rec->w[1] = w2+w2n;
            w2 = 0;
            rec->w[2] = 0;
          } else {
            rec->w[2] = w2;
            rec->w[1] = w2n;
          }
          int32_t has3 = w3!=0;
          int32_t has4 = w4!=0;
          if( w2 )
            w2 = 1;
          int32_t lvl = has4+has3+w2+2;
          if( lvl<=alpha ) {
            rec->b14 = lvl;
          } else {
            rec->b14 = has4+has3+w2+1;
            rec->w[0] = 0;
          }
          if( rec->w[lo]&&rec->w[hi]&&(lvl2 = rec->b14, lvl2<=alpha) ) {
            live = 1;
            int16_t wt = (uint8_t)(1<<((5-lvl2)&31));
            rec->b15 = wt;
            rec->w[6] = wt<<6;
            rec->w[lo] += wt;
            rec->w[hi] += rec->b15;
            rec->w[5] = rec->w[0]+rec->w[4]+rec->w[3]+rec->w[2]+rec->w[1];
          } else {
            live = 0;
          }
          bucket += live;
          ++hi;
        } while( hi<5 );
        ++lo;
      } while( (uint32_t)lo<5 );
      uint32_t gi = 0;
      SymPair* group_ctr = blk->group_ctr[g];
      do {
        group_ctr[gi].last = 0x2000;
        group_ctr[gi++].prev = 0x2000;
      } while( gi<0x10000 );
      ++g;
    } while( (uint32_t)g<0xF );
    uint8_t* buf = (uint8_t*)bmf_new(blk->alphabet);
    uint32_t alpha_n = blk->alphabet;
    blk->alpha_map = buf;
    memset(buf, 1, alpha_n);
    blk->escape_list = &blk->escape;
    blk->escape.init(blk->alphabet, 1);
    blk->sel_cur = blk->sel;
    uint32_t n_syms = blk->alphabet;
    SymListBlock *blk1 = (SymListBlock*)bmf_new(SymListBlock::bytes(n_syms));
    if( blk1 ) {
      blk1->n = n_syms;
      lists1 = blk1->list;
      if( n_syms ) {
        for( j = 0; j<n_syms; ++j )
          lists1[j].ent = nullptr;
      }
    } else {
      lists1 = nullptr;
    }
    uint32_t n_syms2 = blk->alphabet;
    blk->sel1_list = lists1;
    SymListBlock *blk0 = (SymListBlock*)bmf_new(SymListBlock::bytes(n_syms2));
    if( blk0 ) {
      blk0->n = n_syms2;
      lists0 = blk0->list;
      if( n_syms2 ) {
        for( k = 0; k<n_syms2; ++k )
          lists0[k].ent = nullptr;
      }
    } else {
      lists0 = nullptr;
    }
    blk->sel0_list = lists0;
    if( !(blk->alphabet<=0) ) {
      int32_t s = 0;
      do {
        blk->sel1_list[s].init(99, 0);
        blk->sel0_list[s++].init(33, 0);
      } while( (uint32_t)s<blk->alphabet );
    }
    if( blk->height>0 ) {
      uint16_t* word = blk->sym_word;
      y = 0;
      do {
        int32_t y1 = y+1;
        blk->row_cur[5]->match[1] = blk->row_cur[5][-1].sym==0;
        blk->row_cur[5]->match[3] = blk->row_cur[6][-1].sym==0;
        PixRec *r4 = blk->row_cur[4];
        PixRec *row_cur3 = blk->row_cur[3];
        PixRec *row_cur2 = blk->row_cur[2];
        PixRec *row_cur1 = blk->row_cur[1];
        PixRec *r0 = blk->row_cur[0];
        blk->row_cur[4] = row_cur3;
        blk->row_cur[3] = row_cur2;
        blk->row_cur[2] = row_cur1;
        blk->row_cur[1] = r0;
        blk->row_cur[0] = r4;
        r4 += 7;
        blk->row_cur[5] = r4;
        r0 += 7;
        blk->row_cur[6] = r0;
        blk->row_cur[7] = row_cur1+7;
        blk->row_cur[8] = row_cur2+7;
        blk->row_cur[9] = row_cur3+7;
        {
          uint8_t zero = r0[1].sym==0;
          r4->match[2] = zero;
          blk->row_cur[5][-1].match[4] = zero;
          blk->row_cur[5][-2].match[5] = zero;
          zero = blk->row_cur[6][2].sym==0;
          blk->row_cur[5]->match[4] = zero;
          blk->row_cur[5][-1].match[5] = zero;
        }
        blk->row_cur[5]->match[5] = blk->row_cur[6][3].sym==0;
        PixRec *up1 = blk->row_cur[6];
        PixRec *up2 = blk->row_cur[7];
        ++blk->row_cur[5];
        ++up1;
        blk->row_cur[6] = up1;
        ++blk->row_cur[8];
        ++up2;
        blk->row_cur[7] = up2;
        ++blk->row_cur[9];
        blk->grad[0] = up1[3].match[0]+up1[2].match[0]+up1[1].match[0]+up1[0].match[0]+up1[4].match[0]-5;
        blk->grad[3] = 0;
        blk->grad[2] = 0;
        y = y1;
        row_w = blk->width;
        blk->grad[1] = up2[3].match[0]+up2[2].match[0]+up2[1].match[0]+up2[0].match[0]+up2[4].match[0]-5;
        if( row_w>0 ) {
          int32_t x = 0;
          do {
            ++x;
            blk->row_cur[5][x-1].sym = word[x-1];
            row_w = blk->width;
          } while( (uint32_t)x<blk->width );
          word += x;
        }
        if( row_w>0 ) {
          int32_t x2 = 0;
          do {
            int32_t step = (blk)->code_pixel(x2);
            blk->init_tables();
            x2 += step;
          } while( (uint32_t)x2<blk->width );
          y = y1;
        }
      } while( (uint32_t)y<*(uint32_t*)&blk->height );
    }
    rc_end_encode();
    blk->free_workspace(1);
  }
}

// filter_cost.inc -- what one filter would cost on this image.

int32_t cost_candidate(BmfImage* img, int32_t cand, uint8_t* desc, uint32_t* costs) {
  struct alignas(16) CostCandidateFrame {
    uint8_t buf[4096];
    int32_t hist_y[1024];
    int32_t hist_yx[1024];
    int32_t hist_zx[1024];
    int32_t hist_zy[1024];
    int32_t hist_zp[1024];
    uint8_t buf_1[4];
    uint8_t* img_end;
    int32_t step_d;
    int32_t off_b0;
    int32_t off_b1;
    int32_t off_a0;
    int32_t off_a1;
    int32_t nplanes;
    int32_t off_a2;
    int32_t off_b2;
    uint8_t _pad0[2008];
    int32_t cand_i;
    uint8_t* desc_f;
    BmfImage* img_f;
    int32_t rec_off;
    int32_t _pad91;
    int32_t d1_f;
    int32_t best;
    int32_t rows;
    int32_t d2_f;
    int32_t wb;
    int32_t wa;
    uint8_t* r1_f;
    uint8_t* r0_f;
    uint8_t* cursor;
    int32_t off_up;
    uint8_t _pad1[28];
  } frame;
  int32_t cost;
  double syz, syy, sxz, sxy, sxx;
  int32_t w1, w2, left, pick, c2, lo1;
  uint32_t lo2, lo3;
  uint8_t *r0, *r2;
  frame.desc_f = desc;
  frame.nplanes = plane_count;
  // `*(const uint16_t*)&img->stride` -- the low half of a `uint32_t`, which
  // is a truncation on a little-endian machine and a different field on any
  // other.  Cast the value.
  int32_t row_b = (uint16_t)img->stride;
  frame.cand_i = cand;
  frame.img_f = img;
  frame.d1_f = (cand+1)%3-cand;
  frame.d2_f = (cand+2)%3-cand;
  frame.img_end = &frame.img_f->pixels[frame.img_f->data_size];
  int32_t d1 = frame.d1_f;
  *(uint32_t*)frame.buf_1 = row_b;
  memset(frame.buf, 0, 24576);
  uint32_t row_b2 = *(uint32_t*)frame.buf_1;
  int32_t cand2 = frame.cand_i;
  uint8_t *base = frame.img_f->pixels;
  syz = 0;
  syy = 0.0;
  sxz = 0.0;
  sxy = 0.0;
  sxx = 0.0;
  frame.rec_off = 16*frame.cand_i;
  frame.desc_f[16*frame.cand_i] = 2;
  frame.desc_f[33] = (uint8_t)cand2;
  uint8_t *p = &base[cand2+row_b2+frame.nplanes];
  if( p<frame.img_end ) {
    // Eight neighbour offsets, constant for the whole walk.  The decompiler
    // kept them in frame slots and read them back through `frame.` in the hot
    // loop, which is what a register spill looks like once it has a struct
    // around it; as `const` locals they say what they are -- the north, west and
    // north-west of the two reference planes, and the step to the next pixel.
    const int32_t planes = frame.nplanes;
    const int32_t d2 = frame.d2_f;
    const int32_t a_n = d1-row_b2,          a_w = d1-planes,     a_nw = d1-row_b2-planes;
    const int32_t b_n = d2-row_b2,          b_w = d2-planes,     b_nw = d2-row_b2-planes;
    const int32_t step = row_b2+planes;
    frame.d1_f = d1;
    *(uint32_t*)frame.buf_1 = row_b2;
    do {
      int32_t dx = p[a_nw]+p[d1]-(p[a_n]+p[a_w]);
      ++*(uint32_t*)&frame.buf[4*dx+2048];
      int32_t dy = p[b_nw]+p[d2]-(p[b_n]+p[b_w]);
      sxx = sxx+(double)dx*(double)dx;
      ++frame.hist_y[dy+512];
      syy = syy+(double)dy*(double)dy;
      sxy = sxy+(double)dx*(double)dy;
      ++frame.hist_yx[((uint16_t)dy-(uint16_t)dx-512)&0x3FF];
      int32_t diag = p[-step]+*p;
      int32_t west = p[-planes];
      uint8_t *q = p-row_b2;
      p += planes;
      int32_t dz = diag-(*q+west);
      sxz = sxz+(double)dx*(double)dz;
      ++frame.hist_zx[((uint16_t)dz-(uint16_t)dx-512)&0x3FF];
      syz = syz+(double)dy*(double)dz;
      ++frame.hist_zy[((uint16_t)dz-(uint16_t)dy-512)&0x3FF];
      int32_t bin = ((uint16_t)dz-(uint16_t)((uint32_t)(((dx+dy)<<6)+40)>>7)-512)&0x3FF;
      ++frame.hist_zp[bin];
    } while( p<frame.img_end );
  }
  double inv = 128.0/(0.1-sxy*sxy+sxx*syy);
  double w1f = (syy*sxz-sxy*syz)*inv;
  double w2f = inv*(sxx*syz-sxy*sxz);
  w1 = (int32_t)w1f;
  if( (int32_t)w1f>=191 )
    w1 = 191;
  if( w1<-64 )
    w1 = -64;
  frame.wa = w1;
  w2 = (int32_t)w2f;
  if( (int32_t)w2f>=191 )
    w2 = 191;
  if( w2<-64 )
    w2 = -64;
  frame.wb = w2;
  memset(frame.buf_1, 0, 2048);
  int32_t img_w = (uint16_t)frame.img_f->stride;
  frame.d1_f = d1;
  frame.rows = ((frame.img_f->height-1)*frame.img_f->width)-1;
  frame.best = -img_w;
  int32_t nstep = -plane_count;
  frame.off_up = -img_w-plane_count;
  r0 = &base[cand2+img_w+plane_count];
  frame.r0_f = r0;
  uint8_t *r1 = r0+d1;
  frame.r1_f = r1;
  r2 = r0+frame.d2_f;
  frame.cursor = r2;
  do {
    int32_t e0 = r0[frame.off_up];
    frame.r1_f = r1;
    frame.r0_f = r0;
    frame.cursor = r2;
    int32_t e1 = e0+*r0-r0[frame.best]-r0[nstep];
    int32_t e2 = *r1;
    left = frame.rows;
    r2 = &frame.cursor[-nstep];
    int32_t bin2 = ((uint16_t)e1-(uint16_t)((frame.wa*(r1[frame.off_up]+e2-r1[frame.best]-r1[nstep])+frame.wb*(frame.cursor[frame.off_up]+*frame.cursor-frame.cursor[frame.best]-(uint32_t)frame.cursor[nstep])+40)>>7)-256)&0x1FF;
    r1 -= nstep;
    ++*(uint32_t*)&frame.buf_1[4*bin2];
    r0 = &frame.r0_f[-nstep];
    frame.rows = left-1;
  } while( left!=1 );
  pick = frame.d1_f;
  int32_t c0 = estimate_cost((uint8_t*)frame.buf_1, 512);
  int32_t rec = 4*frame.cand_i;
  costs[rec] = c0;
  costs[rec+1] = estimate_cost((uint8_t*)frame.hist_zx, 1024);
  costs[rec+2] = estimate_cost((uint8_t*)frame.hist_zy, 1024);
  costs[rec+3] = estimate_cost((uint8_t*)frame.hist_zp, 1024);
  cost = estimate_cost((uint8_t*)frame.buf, 1024);
  frame.d1_f = estimate_cost((uint8_t*)frame.hist_y, 1024);
  c2 = estimate_cost((uint8_t*)frame.hist_yx, 1024);
  frame.rows = c2;
  lo1 = c2;
  if( cost<c2 )
    lo1 = cost;
  if( frame.d1_f<c2 )
    c2 = frame.d1_f;
  int32_t s1 = frame.d1_f+lo1;
  int32_t s2 = cost+c2;
  frame.best = s2;
  int32_t c2b = frame.rows;
  if( s1<s2 ) {
    frame.best = s1;
    int32_t tmp = pick;
    pick = frame.d2_f;
    cost = frame.d1_f;
    frame.d2_f = tmp;
    uint32_t swap = costs[rec+1];
    costs[rec+1] = costs[rec+2];
    int32_t w2s = frame.wb;
    costs[rec+2] = swap;
    int32_t w1s = frame.wa;
    frame.wa = w2s;
    frame.wb = w1s;
  }
  int32_t off = frame.rec_off;
  uint8_t* descp = frame.desc_f;
  *(uint32_t*)&frame.desc_f[frame.rec_off+4] = frame.wa;
  *(uint32_t*)&descp[off+8] = frame.wb;
  int32_t idx1 = frame.cand_i+pick;
  int32_t idx2 = frame.cand_i+frame.d2_f;
  descp[16*idx1] = 0;
  descp[1] = (uint8_t)idx1;
  bool deep = 0;
  descp[16*idx2] = 1;
  descp[17] = (uint8_t)idx2;
  if( !deep&&frame.img_f->data_size>0x1000000u )
    return cost+c2b+costs[rec];
  lo2 = costs[rec];
  lo3 = costs[rec+2];
  if( lo2>=costs[rec+1] )
    lo2 = costs[rec+1];
  if( lo3>=costs[rec+3] )
    lo3 = costs[rec+3];
  if( lo2<lo3 )
    lo3 = lo2;
  return frame.best+lo3;
}

// plane_choose.inc -- decide how each plane of an image is to be coded.

int32_t choose_plane_coding(BmfImage* img) {
  struct alignas(16) ChoosePlaneCodingFrame {
    uint8_t _pad0[4];
    union {
      uint8_t buf[32768];
      struct {
        uint8_t _buf_head[4096];
        int32_t hist_a[1024];
        int32_t hist_b[1024];
        int32_t hist_c[5120];
      };
    };
    union {
      uint8_t buf_1[2048];
      struct {
        uint8_t _buf_1_head[4];
        int32_t s0;
        int32_t s1;
        int32_t s2;
        uint8_t* p0;
        uint8_t* p1;
        int32_t s3;
        int32_t s4;
        uint8_t* p2;
        int32_t s5;
        int32_t s6;
        int32_t s7;
        uint8_t* p3;
        uint8_t* p4;
        int32_t s8;
        int32_t s9;
        uint8_t* p5;
        int32_t s10;
        uint8_t _pad3[1976];
      };
    };
    union {
      int64_t q0;
      struct {
        int32_t row_stride;
        int32_t plane_b;
      };
    };
    union {
      int64_t q1;
      struct {
        int32_t plane_a;
        uint32_t nplanes_s;
      };
    };
    union {
      double d0;
      uint32_t wt_slot;
    };
    uint8_t _pad6[4];
    uint8_t _pad5[4];
    uint8_t _pad7[28];
  } frame;
  uint8_t buf_3[2048], buf_4[2048], buf_2[2048];
  alignas(16) int32_t x0[4], x1[4], x3[4], x5[4];
  double d1, d2, d3;
  // One run of the original frame, and the body indexes across every boundary
  // in it, so the six are bound onto one buffer at the offsets they had:
  //
  //     0   acc0[4]     the three candidates' costs are one 3x4 table --
  //    16   acc1[5]     `acc0[4*xform+2]` and `scratch[16*xform+16]` read
  //    56   d4          rows 1 and 2 of it from inside `acc1`
  //    64   tbl16[16]   and the three 64-byte tables are one 3x16 table:
  //   128   (row 1)     `&tbl16[16*cand]` selects a row by walking off the
  //   192   (row 2)     end of the first, and the loop above zeroes all 192
  //                     bytes of it as one block -- `scratch[64..255]`
  //
  // Rows 1 and 2 had names, `tbl64a` and `tbl64b`, until the candidate loop
  // started reaching all three by index.  Like `acc1` they then bound a region
  // nothing read through, which is a comment the compiler has to be told to
  // ignore; the map is the comment.
  //
  // `acc1` is not bound below.  Nothing reads that region through a name --
  // `acc0[4*xform+2]` reaches rows 1 and 2 of the cost table from inside it,
  // which is the whole of its traffic -- so a reference there was a comment
  // the compiler had to be told to ignore.  The map above is the comment.
  //
  // `acc0` and `acc1` were bound here when the frame was lifted; the tables
  // were left as separate locals, and `tbl16` was placed 8 bytes early, over
  // `d4`.  So for `xform != 0` the 64 bytes this copies into `plane_desc` --
  // the image's plane order -- came from whatever the compiler put after
  // `tbl16`, and three planes claimed the same source while two were never
  // coded.  Every image in the corpus picks `xform == 0`, where the row is the
  // buffer `cost_candidate` was actually given, so the gate said nothing;
  // `testfiles/xform1.bmp` is the image that does not.
  alignas(16) uint8_t scratch[256];
  int32_t(&acc0)[4] = *(int32_t(*)[4])&scratch[0];
  int32_t(&tbl16)[16] = *(int32_t(*)[16])&scratch[64];
  uint8_t* pp;
  uint32_t uu;
  int32_t wa_slot;
  bool cheaper, keep3, pick0;
  int8_t pos, pos3;
  uint8_t* hist;
  double dv0, dv1, dv2, inv;
  int16_t g1_lo;
  uint32_t n_quads, next_plane, row, slack;
  uint16_t g1w;
  int32_t n_planes, data_size, result, xform, *win_row, wt8, wt4, c2, c2w, c1, c1w, c0, bin0, pred, xform_row, win, sum, best_sum, i, pos2, best_sum2, sum2, wt4_dn, wt8_dn, wt4_dn_end, wt8_dn_end, dv3, wa, wb, wc, nx0, dg0, dn0, ad0, dnx1, g0, dn1, nx2, g1, dnx2, g2, pa, pb, bin_lin, quad_r, alpha, bin_lin2, r0, r1, r2, wa_pick, pred4, pred4b, *hist2, sum3, best_sum3, n_c, wt4_best_dn, n_d, wt8_best_dn, wt4_up, wt8_up, wt4_up_end, wt8_up_end, wt4_best, wt8_best;
  uint32_t best_cost, best, cost_flat, i4, quad, cost_lin, best4, cost_c0, cost_c1, cost_c2;
  uint8_t *px, *end_px, *r_c, *p_c, *r_d, *p_d;
  n_planes = plane_count;
  data_size = img->data_size;
  alphabet_reduced = 1;
  frame.row_stride = (uint16_t)img->stride;
  const uint8_t* data_end = &img->pixels[data_size];
  memset(frame.buf, 0, 0x8000);
  // The three 64-byte tables, as one block: `scratch[64..255]`.  The first 64
  // bytes are `acc0`, `acc1` and `d4` and are deliberately left alone -- the
  // loop this replaces started at 192 and stopped before reaching them.
  memset(&scratch[64], 0, 192);
  if( n_planes>0 ) {
    if( n_planes/2 ) {
      uint32_t pair = 0;
      do {
        uint8_t pl_even = 2*pair;
        row = 2*pair;
        plane_desc[row].src_plane = 2*pair;
        uint8_t pl_odd = 2*pair+++1;
        plane_desc[row].nrefs = pl_even;
        plane_desc[row+1].src_plane = pl_odd;
        plane_desc[row+1].nrefs = pl_odd;
      } while( pair<(uint32_t)(n_planes/2) );
      next_plane = 2*pair+1;
    } else {
      next_plane = 1;
    }
    result = next_plane-1;
    if( (uint32_t)n_planes>(next_plane-1) ) {
      plane_desc[next_plane-1].src_plane = result;
      plane_desc[next_plane-1].nrefs = result;
    }
    if( n_planes>=3 ) {
      // The three candidate transforms, costed, cheapest kept.  Their
      // descriptor buffers are the three rows of one 3x16 table: `tbl16`,
      // `tbl64a` and `tbl64b` name `scratch[64]`, `[128]` and `[192]`, which
      // is `&tbl16[16*cand]` -- the same walking-off-the-end the winning row
      // is selected by twenty lines below.  So the three calls the
      // decompilation wrote out are one loop.
      //
      // Ties go to the lower index, which is what `cost1 >= cost0` keeping
      // candidate 0 did.  The original compared the first pair signed and the
      // third candidate unsigned -- `(uint32_t)f(2) < cost1` -- which are the
      // same relation for costs that are estimated bit counts and so never
      // negative.  One relation here.
      xform = 0;
      uint32_t cheapest = cost_candidate(img, 0, (uint8_t*)tbl16,
                                           (uint32_t*)&acc0[2]);
      for( int32_t cand = 1; cand<3; ++cand ) {
        const uint32_t c = cost_candidate(img, cand,
                                            (uint8_t*)&tbl16[16*cand], (uint32_t*)&acc0[2]);
        if( c<cheapest ) {
          cheapest = c;
          xform = cand;
        }
      }
      x3[2] = xform;
      // The winning candidate's four descriptors, copied in.  This was eight
      // `uint64_t` stores through a `(uint8_t*)&plane_desc[0]+off` accessor,
      // two turns of a loop counting down by eight: offsets 56, 48, 40, 32
      // then 24, 16, 8, 0, from `win_row[14]` down to `win_row[0]`.  Bytes
      // 0..63 of the descriptors from the sixteen words of the row -- which
      // is 4*sizeof(PlaneDesc), so it is one copy.
      //
      // `&tbl16[16*xform]` walks off the end of `tbl16` on purpose: the three
      // tables are one 3x16 array of candidates that the decompilation gave
      // three names.
      win_row = &tbl16[16*xform];
      memcpy(&plane_desc[0], win_row, 4*sizeof(PlaneDesc));
      best_cost = acc0[4*x3[2]+2];
      x3[1] = 16*x3[2];
      frame.plane_a = plane_desc[0].src_plane-x3[2];
      wt8 = plane_desc[x3[2]].weight1;
      frame.plane_b = plane_desc[1].src_plane-x3[2];
      wt4 = plane_desc[x3[2]].weight0;
      {
        frame.wt_slot = wt8;
        x5[3] = wt4;
        frame.nplanes_s = n_planes;
        int32_t wt_step = 4;
        frame.s1 = wt4-1;
        wt4_dn = wt4-1;
        frame.s6 = wt8-1;
        wt8_dn = wt8-1;
        frame.s0 = wt4-wt_step;
        wt4_dn_end = frame.s0;
        *(uint32_t*)frame.buf_1 = wt8-wt_step;
        uint8_t *plane0 = &img->pixels[x3[2]];
        wt8_dn_end = wt8-wt_step;
        while( 1 ) {
          if( wt4_dn<=wt4_dn_end ) {
            if( wt8_dn<=wt8_dn_end ) {
              x1[0] = x5[3]+1;
              wt4_up = x5[3]+1;
              x3[3] = frame.wt_slot+1;
              wt8_up = frame.wt_slot+1;
              x0[3] = x5[3]+wt_step;
              wt4_up_end = x5[3]+wt_step;
              x0[2] = frame.wt_slot+wt_step;
              wt8_up_end = frame.wt_slot+wt_step;
              while( 1 ) {
                if( wt4_up>=wt4_up_end&&wt8_up>=wt8_up_end ) {
                  wt8 = frame.wt_slot;
                  wt4 = x5[3];
                  n_planes = frame.nplanes_s;
                  goto weights_chosen;
                }
                if( wt4_up<wt4_up_end&&wt4_up<192 ) {
                  x0[2] = wt8_up_end;
                  memset(frame.buf_1, 0, 2048);
                  int32_t npix_a = img->width*(img->height-1);
                  int32_t stride_a = (uint16_t)img->stride;
                  x3[3] = wt8_up;
                  x1[0] = wt4_up;
                  int32_t n_a = npix_a-1;
                  int32_t ofs_up_a = -stride_a;
                  int32_t left_a = -plane_count;
                  int32_t ofs_ul_a = -stride_a-plane_count;
                  uint8_t *p_a = plane0-ofs_ul_a;
                  uint8_t *q_a = plane0+frame.plane_a-ofs_ul_a;
                  uint8_t *row_c = plane0+frame.plane_b-ofs_ul_a;
                  do {
                    int32_t ul_a = p_a[ofs_ul_a];
                    int32_t g_a = ul_a+*p_a-p_a[ofs_up_a]-p_a[left_a];
                    int32_t cur_a = *q_a;
                    int32_t bin_a = ((int16_t)g_a-(uint16_t)((x1[0]*(q_a[ofs_ul_a]+cur_a-q_a[ofs_up_a]-q_a[left_a])+frame.wt_slot*(row_c[ofs_ul_a]+*row_c-row_c[ofs_up_a]-(uint32_t)row_c[left_a])+40)>>7)-256)&0x1FF;
                    ++*(uint32_t*)&frame.buf_1[4*bin_a];
                    q_a -= left_a;
                    p_a -= left_a;
                    row_c -= left_a;
                    --n_a;
                  } while( n_a );
                  wt8_up = x3[3];
                  wt4_up = x1[0];
                  uint32_t cost_a = estimate_cost((uint8_t*)frame.buf_1, 512);
                  wt8_up_end = x0[2];
                  wt4_best = x5[3];
                  if( cost_a<best_cost ) {
                    best_cost = cost_a;
                    wt4_best = wt4_up;
                  }
                  x5[3] = wt4_best;
                  wt4_up_end = wt_step+wt4_best;
                }
                if( wt8_up<wt8_up_end&&wt8_up<192 ) {
                  {
                    x0[3] = wt4_up_end;
                    memset(buf_2, 0, 2048);
                    int32_t npix_b = img->width*(img->height-1);
                    int32_t stride_b = (uint16_t)img->stride;
                    x3[3] = wt8_up;
                    x1[0] = wt4_up;
                    int32_t n_b = npix_b-1;
                    int32_t ofs_up_b = -stride_b;
                    int32_t left_b = -plane_count;
                    int32_t ofs_ul_b = -stride_b-plane_count;
                    uint8_t *p_b = plane0-ofs_ul_b;
                    uint8_t *q_b = plane0+frame.plane_a-ofs_ul_b;
                    uint8_t *row_d = plane0+frame.plane_b-ofs_ul_b;
                    do {
                      int32_t ul_b = p_b[ofs_ul_b];
                      int32_t g_b = ul_b+*p_b-p_b[ofs_up_b]-p_b[left_b];
                      int32_t cur_b = *q_b;
                      int32_t bin_b = ((int16_t)g_b-(uint16_t)((x5[3]*(q_b[ofs_ul_b]+cur_b-q_b[ofs_up_b]-q_b[left_b])+x3[3]*(row_d[ofs_ul_b]+*row_d-row_d[ofs_up_b]-(uint32_t)row_d[left_b])+40)>>7)-256)&0x1FF;
                      ++*(uint32_t*)&buf_2[4*bin_b];
                      q_b -= left_b;
                      p_b -= left_b;
                      row_d -= left_b;
                      --n_b;
                    } while( n_b );
                    wt8_up = x3[3];
                    wt4_up = x1[0];
                    uint32_t cost_b = estimate_cost(buf_2, 512);
                    wt4_up_end = x0[3];
                    wt8_best = frame.wt_slot;
                    if( cost_b<best_cost ) {
                      best_cost = cost_b;
                      wt8_best = wt8_up;
                    }
                    frame.wt_slot = wt8_best;
                    wt8_up_end = wt_step+wt8_best;
                  }
                }
                ++wt4_up;
                ++wt8_up;
              }
            }
          }
          if( wt4_dn>wt4_dn_end&&wt4_dn>=-64 ) {
            *(uint32_t*)frame.buf_1 = wt8_dn_end;
            memset(buf_3, 0, 2048);
            int32_t npix_c = img->width*(img->height-1);
            int32_t stride_c = (uint16_t)img->stride;
            frame.s6 = wt8_dn;
            frame.s1 = wt4_dn;
            frame.s2 = npix_c-1;
            frame.s4 = -stride_c;
            int32_t left_c = -plane_count;
            frame.s3 = -stride_c-plane_count;
            frame.p1 = plane0-frame.s3;
            frame.p0 = plane0+frame.plane_a-frame.s3;
            uint8_t *q_c = frame.p0;
            r_c = plane0+frame.plane_b-frame.s3;
            p_c = frame.p1;
            do {
              int32_t ul_c = p_c[frame.s3];
              frame.p0 = q_c;
              frame.p1 = p_c;
              frame.p2 = r_c;
              int32_t g_c = ul_c+*p_c-p_c[frame.s4]-p_c[left_c];
              int32_t cur_c = *q_c;
              frame.s5 = g_c;
              r_c = &frame.p2[-left_c];
              n_c = frame.s2;
              int32_t bin_c = ((uint16_t)frame.s5-(uint16_t)((frame.s1*(q_c[frame.s3]+cur_c-q_c[frame.s4]-q_c[left_c])+frame.wt_slot*(frame.p2[frame.s3]+*frame.p2-frame.p2[frame.s4]-(uint32_t)frame.p2[left_c])+40)>>7)-256)&0x1FF;
              ++*(uint32_t*)&buf_3[4*bin_c];
              q_c -= left_c;
              p_c = &frame.p1[-left_c];
              frame.s2 = n_c-1;
            } while( n_c!=1 );
            wt8_dn = frame.s6;
            wt4_dn = frame.s1;
            uint32_t cost_c = estimate_cost(buf_3, 512);
            wt8_dn_end = *(uint32_t*)frame.buf_1;
            wt4_best_dn = x5[3];
            if( cost_c<best_cost ) {
              best_cost = cost_c;
              wt4_best_dn = wt4_dn;
            }
            x5[3] = wt4_best_dn;
            wt4_dn_end = wt4_best_dn-wt_step;
          }
          if( wt8_dn>wt8_dn_end&&wt8_dn>=-64 ) {
            {
              frame.s0 = wt4_dn_end;
              memset(buf_4, 0, 2048);
              int32_t npix_d = img->width*(img->height-1);
              int32_t stride_d = (uint16_t)img->stride;
              frame.s6 = wt8_dn;
              frame.s1 = wt4_dn;
              frame.s7 = npix_d-1;
              frame.s9 = -stride_d;
              int32_t left_d = -plane_count;
              frame.s8 = -stride_d-plane_count;
              frame.p4 = plane0-frame.s8;
              uint8_t *q_d = plane0+frame.plane_a-frame.s8;
              frame.p3 = q_d;
              r_d = plane0+frame.plane_b-frame.s8;
              p_d = frame.p4;
              do {
                int32_t ul_d = p_d[frame.s8];
                frame.p3 = q_d;
                frame.p4 = p_d;
                frame.p5 = r_d;
                int32_t g_d = ul_d+*p_d-p_d[frame.s9]-p_d[left_d];
                int32_t cur_d = *q_d;
                frame.s10 = g_d;
                r_d = &frame.p5[-left_d];
                n_d = frame.s7;
                int32_t bin_d = ((uint16_t)frame.s10-(uint16_t)((x5[3]*(q_d[frame.s8]+cur_d-q_d[frame.s9]-q_d[left_d])+frame.s6*(frame.p5[frame.s8]+*frame.p5-frame.p5[frame.s9]-(uint32_t)frame.p5[left_d])+40)>>7)-256)&0x1FF;
                ++*(uint32_t*)&buf_4[4*bin_d];
                q_d -= left_d;
                p_d = &frame.p4[-left_d];
                frame.s7 = n_d-1;
              } while( n_d!=1 );
              wt8_dn = frame.s6;
              wt4_dn = frame.s1;
              uint32_t cost_d = estimate_cost(buf_4, 512);
              wt4_dn_end = frame.s0;
              wt8_best_dn = frame.wt_slot;
              if( cost_d<best_cost ) {
                best_cost = cost_d;
                wt8_best_dn = wt8_dn;
              }
              frame.wt_slot = wt8_best_dn;
              wt8_dn_end = wt8_best_dn-wt_step;
            }
          }
          --wt4_dn;
          --wt8_dn;
        }
      }
weights_chosen:
      px = &img->pixels[frame.row_stride+n_planes+x3[2]];
      if( px<data_end ) {
        frame.wt_slot = wt8;
        x5[3] = wt4;
        frame.nplanes_s = n_planes;
        do {
          c2 = px[frame.plane_b];
          c2w = c2*frame.wt_slot;
          c1 = px[frame.plane_a];
          c1w = c1*x5[3];
          ++frame.hist_c[c2-c1+1280];
          c0 = *px+512;
          px += frame.nplanes_s;
          bin0 = ((uint16_t)c0-(uint16_t)((uint32_t)(c2w+c1w+40)>>7))&0x3FF;
          ++*(uint32_t*)&frame.buf[4*bin0];
          ++frame.hist_a[c0-c1];
          ++frame.hist_b[c0-c2];
          ++frame.hist_c[(c0-((uint32_t)(((c1+c2)<<6)+40)>>7))];
        } while( px<data_end );
        wt8 = frame.wt_slot;
        wt4 = x5[3];
        n_planes = frame.nplanes_s;
      }
      slack = best_cost>>7;
      if( best_cost>>7>=0x4000 )
        slack = 0x4000;
      best = slack+best_cost;
      cost_flat = *(int32_t*)((uint8_t*)&acc0[3]+x3[1]);
      cheaper = cost_flat<best;
      if( cost_flat<best ) {
        best = *(int32_t*)((uint8_t*)&acc0[3]+x3[1]);
        wt4 = 128;
        wt8 = 0;
      }
      pred = cheaper;
      if( *(uint32_t*)&scratch[x3[1]+16]<best ) {
        best = *(uint32_t*)&scratch[x3[1]+16];
        pred = 2;
        wt4 = 0;
        wt8 = 128;
      }
      keep3 = best<=*(uint32_t*)&scratch[x3[1]+20];
      if( best>*(uint32_t*)&scratch[x3[1]+20] )
        pred = 3;
      xform_row = x3[2];
      if( !keep3 ) {
        wt4 = 64;
        wt8 = 64;
      }
      plane_desc[x3[2]].weight0 = wt4;
      plane_desc[xform_row].weight1 = wt8;
      hist = &frame.buf[4096*pred];
      win = (uintptr_t)hist&0xF;
      sum = 0;
      for( i = 0; i<256; ++i )
        sum += *(int32_t*)&hist[4*(win+i)];
      win += 256;
      best_sum = sum;
      pos = -1;
      if( win<1024 ) {
        frame.nplanes_s = n_planes;
        do {
          sum = *(uint32_t*)&hist[4*win]+sum-*(uint32_t*)&hist[4*win-1024];
          if( sum>=best_sum ) {
            pos = win;
            best_sum = sum;
          }
          ++win;
        } while( win<1024 );
        n_planes = frame.nplanes_s;
      }
      plane_desc[x3[2]].dc = pos+1;
      best_sum2 = 0;
      for( i = 0; i<0x100; ++i )
        best_sum2 += frame.hist_c[i+1024];
      pos2 = 255;
      for( sum2 = best_sum2; i<512; ++i ) {
        sum2 = frame.hist_c[i+1024]+sum2-frame.hist_c[i+768];
        if( sum2>=best_sum2 ) {
          pos2 = i;
          best_sum2 = sum2;
        }
      }
      result = pos2+1;
      plane_desc[frame.plane_b+x3[2]].dc = result;
      if( n_planes>=4 ) {
        // The alpha plane's weights, by least squares against the other three.
        //
        // `dv0`, `dv1` and `dv2` are the three colour planes' gradients at one
        // pixel and `dv3` the alpha plane's; these are the nine covariances of
        // that four-vector, `S<a><b> = sum over pixels of d<a>*d<b>`, with `w`
        // for the alpha term.  The 3x3 system `S * weights = Sw` is solved by
        // cofactors below.
        //
        // The original kept them in six SSE registers and spilled them to the
        // stack, which arrived here as `int32_t x0[4]` .. `x5[4]` read through
        // forty `*(double*)` casts, plus three more slots borrowed from the
        // frame's unions -- `frame.q0` and `q1` overlay `row_stride`,
        // `plane_b`, `plane_a` and `nplanes_s`, and were safe only because
        // those four are last read twenty lines above.  Nine named doubles say
        // the same arithmetic and take the round trip out.
        double Sxx = 0.0, Sxy = 0.0, Sxz = 0.0;
        double Syy = 0.0, Syz = 0.0, Szz = 0.0;
        double Sxw = 0.0, Syw = 0.0, Szw = 0.0;
        memset(frame.buf, 0, 0x8000);
        pp = &img->pixels[frame.row_stride];
        n_quads = (data_end-1-pp)/4;
        end_px = &img->pixels[frame.row_stride+4];
        if( end_px<data_end ) {
          i4 = 0;
          uu = (data_end-1-pp)/4;
          do {
            dv0 = (double)(img->pixels[4*i4]+pp[4*i4+4]-(img->pixels[4*i4+4]+pp[4*i4]));
            dv1 = (double)(img->pixels[4*i4+1]+pp[4*i4+5]-(img->pixels[4*i4+5]+pp[4*i4+1]));
            dv2 = (double)(img->pixels[4*i4+2]+pp[4*i4+6]-(img->pixels[4*i4+6]+pp[4*i4+2]));
            dv3 = img->pixels[4*i4+3]+pp[4*i4+7]-(img->pixels[4*i4+7]+pp[4*i4+3]);
            Sxx += dv0*dv0;
            ++i4;
            Sxy += dv0*dv1;
            Sxz += dv0*dv2;
            Syy += dv1*dv1;
            Syz += dv1*dv2;
            Szz += dv2*dv2;
            Sxw += dv0*(double)dv3;
            Syw += dv1*(double)dv3;
            Szw += dv2*(double)dv3;
          } while( i4<uu );
          n_quads = uu;
        }
        // The three cofactors of the first row of `S`, and one over its
        // determinant -- scaled by 128 because the weights are eighths of a
        // 128th and clamped to [-64, 191] below.  The `+0.1` keeps a singular
        // system (a flat image, every gradient zero) from dividing by zero.
        d1 = Sxx*Szz-Sxz*Sxz;
        d2 = 0.0-Sxx*Syz+Sxz*Sxy;
        d3 = Sxz*Syz-Sxy*Szz;
        inv = 128.0/(Syy*d1+Syz*d2+Sxy*d3+0.1);
        wa = (int32_t)(((Sxz*Syz-Sxy*Szz)*Syw+(0.0-Sxz*Syy+Sxy*Syz)*Szw+(Szz*Syy-Syz*Syz)*Sxw)*inv);
        if( wa>=191 )
          wa = 191;
        if( wa<-64 )
          wa = -64;
        wa_slot = wa;
        wb = (int32_t)((d1*Syw+d2*Szw+d3*Sxw)*inv);
        if( wb>=191 )
          wb = 191;
        if( wb<-64 )
          wb = -64;
        wc = (int32_t)(inv*((Sxx*Szw-Sxz*Sxw)*Syy+(0.0-Sxx*Syw+Sxw*Sxy)*Syz+(Sxz*Syw-Sxy*Szw)*Sxy));
        if( wc>=191 )
          wc = 191;
        if( wc<-64 )
          wc = -64;
        if( end_px<data_end ) {
          // `x0[0..1]` used to be written here and read back forty lines
          // below -- one 64-bit store, which the decompiler wrote as a pair
          // because MSVC had both halves in registers, and `__PAIR64__` is its
          // name for that.  The two slots are `wb` and `wc` and nothing
          // between the store and the reload writes either: the loop assigns
          // `x0[2]` and `x0[3]`, and those two slots have no other reader in
          // the function at all.  So the spill is the two names.
          uu = n_quads;
          quad = 0;
          do {
            nx0 = img->pixels[4*quad+4];
            dg0 = img->pixels[4*quad]+pp[4*quad+4];
            dn0 = pp[4*quad];
            x0[2] = quad;
            ad0 = nx0+dn0;
            dnx1 = pp[4*quad+5];
            g0 = dg0-ad0;
            dn1 = pp[4*quad+1];
            x0[3] = g0;
            nx2 = img->pixels[4*quad+6];
            g1 = img->pixels[4*quad+1]+dnx1-(img->pixels[4*quad+5]+dn1);
            dnx2 = pp[4*quad+6];
            x1[0] = g1;
            g2 = img->pixels[4*quad+2]+dnx2-(nx2+pp[4*quad+2]);
            g1w = (uint16_t)(img->pixels[4*quad+3]+pp[4*quad+7]-pp[4*quad+3]-img->pixels[4*quad+7]);
            g1_lo = (int16_t)x1[0];
            g1w = g1w-512;
            pa = x1[0]*wb+x0[3]*wa_slot;
            pb = g2*wc;
            ++frame.hist_a[(g1w-(int16_t)x0[3])&0x3FF];
            bin_lin = (g1w-(uint16_t)((uint32_t)(pa+pb+63)>>7))&0x3FF;
            ++*(uint32_t*)&frame.buf[4*bin_lin];
            ++frame.hist_b[(g1w-g1_lo)&0x3FF];
            g1w = g1w-g2;
            quad_r = x0[2];
            ++frame.hist_c[g1w&0x3FF];
            alpha = pp[4*quad_r+7]+256;
            bin_lin2 = ((uint16_t)alpha-(uint16_t)((wb*pp[4*quad_r+5]+wa_slot*pp[4*quad_r+4]+wc*(uint32_t)pp[4*quad_r+6]+63)>>7)+256)&0x3FF;
            ++frame.hist_c[bin_lin2+1024];
            r0 = alpha-pp[4*quad_r+4];
            ++frame.hist_c[r0+2048];
            r1 = alpha-pp[4*quad_r+5];
            ++frame.hist_c[r1+3072];
            r2 = alpha-pp[4*quad_r+6];
            ++frame.hist_c[r2+4096];
            quad = quad_r+1;
          } while( quad<uu );
        }
        cost_lin = estimate_cost((uint8_t*)frame.buf, 1024);
        best4 = (cost_lin>>7)+cost_lin;
        cost_c0 = estimate_cost((uint8_t*)frame.hist_a, 1024);
        pick0 = cost_c0<best4;
        if( cost_c0<best4 )
          best4 = cost_c0;
        wa_pick = wa_slot;
        if( pick0 ) {
          wa_pick = 128;
          wc = 0;
          wb = 0;
        }
        wa_slot = wa_pick;
        x0[0] = pick0;
        cost_c1 = estimate_cost((uint8_t*)frame.hist_b, 1024);
        pred4 = x0[0];
        if( cost_c1<best4 ) {
          best4 = cost_c1;
          pred4 = 2;
          wb = 128;
          wc = 0;
          wa_slot = 0;
        }
        x0[0] = pred4;
        cost_c2 = estimate_cost((uint8_t*)frame.hist_c, 1024);
        pred4b = x0[0];
        if( cost_c2<best4 ) {
          pred4b = 3;
          wc = 128;
          wb = 0;
          wa_slot = 0;
        }
        plane_desc[3].weight0 = wa_slot;
        plane_desc[3].weight1 = wb;
        plane_desc[3].weight2 = wc;
        plane_desc[3].src_plane = 3;
        plane_desc[3].nrefs = 3;
        hist2 = &frame.hist_c[1024*pred4b+1024];
        result = (uintptr_t)hist2&0xF;
        sum3 = 0;
        for( i = 0; i<256; ++i )
          sum3 += hist2[result+i];
        result += 256;
        best_sum3 = sum3;
        for( pos3 = -1; result<1024; ++result ) {
          sum3 = hist2[result]+sum3-hist2[result-256];
          if( sum3>=best_sum3 ) {
            pos3 = result;
            best_sum3 = sum3;
          }
        }
        plane_desc[3].dc = pos3+1;
      }
    }
  }
  return result;
}

// filter_search.inc -- search the filters, which is what -Q9 spends its time on.

uint32_t search_filter(BmfImage* img, int8_t mode) {
  struct alignas(16) SearchFilterFrame {
    uint8_t* base;
    uint8_t marks[16];
    int32_t rows[2];
    int32_t dims[2];
    union {
      PlaneDesc saved[4];
      struct {
        int32_t plane_i;
        uint32_t costs[4];
        int32_t pi;
        uint8_t* tile_buf;
        int32_t flag8;
        int32_t best_flags;
        uint8_t _pad0[28];
      };
    };
    uint8_t* tile_src;
    int32_t n_hard;
    int32_t bits_total;
    int32_t n_flagged;
    int32_t best_bits;
    BmfImage* tile_img;
    uint8_t _pad1[36];
  } frame;
  uint8_t* base2;
  bool deep2;
  uint8_t f0, f1, f2, f3;
  uint8_t *srcp, *p2, *tile_copy, *p4, *p5, *p12, *p13;
  int32_t hard, bits_a, bits_b;
  int32_t p3, p6, p7, p10, p11, p14;
  int32_t flags_s, desc_k;
  int32_t tile_w, tile_h, nplanes, y0, dx, off_y, row_bytes, best_cost, bits_f5, f5, pred, c0, c1, c2, c3, cand, nplanes_c, pl_a, pi0, pl_b, pi1, bits2, plane, pi3, bits_e, nplanes_b, pl_c, pi4, pl_d, bits_c, img_h1, y1, off1, x1, bits_d, pk, pl_k, bits, img_h3, y3, off3, pl_i, rows_x_planes, y2, off2, x2, pl2, bits_f8, f8, pl3, bits_f13, f13, cost_f14, f14, pl0, bits_f6, f6;
  uint16_t img_h3b, img_h2, img_h1b;
  uint8_t* p8, * p9;
  tile_w = img->width;
  tile_h = img->height;
  if( tile_w<4||tile_h<3 ) {
    if( plane_count>0 ) {
      int32_t pl = 0;
      do {
        plane_desc[pl].flags = 0;
        plane_desc[pl].src_plane = pl;
        plane_desc[pl].nrefs = pl;
        ++pl;
      } while( pl<plane_count );
    }
    return 0;
  }
  choose_plane_coding(img);
  frame.tile_img = alloc_image(tile_w, tile_h, img->depth&depth_bits, 0, 0);
  stream.size = frame.tile_img->data_size+0x20000;
  stream.buf = (uint8_t*)bmf_new(stream.size);
  packer_reset();
  frame.dims[0] = tile_h*tile_w;
  frame.tile_buf = (uint8_t*)bmf_new(tile_h*tile_w);
  // Encode one plane of the trial tile under `flags` and return what it cost,
  // in bits.  Seven sites wrote this out: set the descriptor, call the model,
  // measure the bytes written, flush the packer's last partial word.  Four take
  // it as written; the other three differ in an argument or in what they do
  // between the measurement and the flush.
  //
  // The measurement is real coded bytes and not an estimate, which is what
  // makes comparing candidates worth anything -- and is also the whole cost of
  // `-Q9`.
  auto probe_plane = [&](int32_t pl, int32_t flags) {
    plane_desc[pl].flags = flags;
    model_planes(frame.tile_img, frame.tile_buf, pl);
    int32_t cost = 8*(stream.cur-stream.buf);
    *(uint32_t*)stream.pk.word = stream.pk.acc;
    return cost;
  };
  nplanes = plane_count;
  y0 = (img->height-tile_h)>>1;
  dx = img->width-tile_w;
  off_y = y0*img->stride;
  frame.rows[1] = y0;
  srcp = img->pixels+plane_count*(dx>>1)+off_y;
  frame.tile_src = frame.tile_img->pixels;
  if( y0<tile_h+y0 ) {
    row_bytes = (uint16_t)frame.tile_img->stride;
    frame.dims[1] = tile_h;
    int32_t y = frame.rows[1];
    uint8_t *dstp = frame.tile_img->pixels;
    do {
      memcpy(dstp, srcp, row_bytes);
      row_bytes = (uint16_t)frame.tile_img->stride;
      dstp += row_bytes;
      srcp += img->stride;
      ++y;
    } while( y<frame.dims[1]+((img->height-frame.dims[1])>>1) );
    nplanes = plane_count;
  }
  frame.n_hard = 0;
  frame.bits_total = 0;
  frame.n_flagged = 0;
  frame.best_bits = 0;
  if( nplanes>0 ) {
    hard = frame.n_hard;
    frame.best_flags = 0;
    frame.pi = 0;
    frame.dims[0] *= 8;
    while( 1 ) {
      frame.dims[1] = plane_desc[frame.pi].src_plane;
      frame.plane_i = frame.dims[1];
      if( hard ) {
        best_cost = 0x7FFFFFFF;
      } else {
        best_cost = probe_plane(frame.dims[1], 0);
        flags_s = frame.best_flags;
        packer_reset();
        if( best_cost!=0x7FFFFFFF )
          flags_s = 0;
        frame.best_flags = flags_s;
      }
      bits_f5 = probe_plane(frame.dims[1], 5);
      packer_reset();
      f5 = frame.best_flags;
      if( bits_f5<best_cost ) {
        best_cost = bits_f5;
        f5 = 5;
      }
      frame.best_flags = f5;
      if( bits_f5<best_cost+(best_cost>>5)||hard ) {
        pl0 = frame.dims[1];
        bits_f6 = probe_plane(pl0, 6);
        f6 = frame.best_flags;
        packer_reset();
        if( bits_f6<best_cost ) {
          best_cost = bits_f6;
          f6 = 6;
        }
        frame.best_flags = f6;
        if( frame.pi ) {
          {
try_flag8:
            pl2 = frame.dims[1];
            bits_f8 = probe_plane(pl2, 8);
            f8 = frame.best_flags;
            packer_reset();
            if( bits_f8<best_cost ) {
              best_cost = bits_f8;
              f8 = 8;
            }
            frame.best_flags = f8;
          }
          pl3 = frame.dims[1];
          bits_f13 = probe_plane(pl3, 13);
          frame.rows[0] = bits_f13;
          f13 = frame.best_flags;
          packer_reset();
          if( bits_f13<best_cost ) {
            best_cost = bits_f13;
            f13 = 13;
          }
          frame.best_flags = f13;
          pred = f13&3;
          if( pred==2||best_cost+(best_cost>>5)>frame.rows[0] ) {
            // `dims[1]` and `plane_i` are the same plane -- both were set from
            // `plane_desc[pi].src_plane` at the top of this loop -- and the
            // first `cost_f14` was overwritten by the next line.
            cost_f14 = probe_plane(frame.plane_i, 14);
            deep2 = cost_f14<best_cost;
            if( cost_f14<best_cost )
              best_cost = cost_f14;
            packer_reset();
            f14 = frame.best_flags;
            if( deep2 )
              f14 = 14;
            frame.best_flags = f14;
            if( deep2 )
              pred = 2;
          }
          goto keep_flag8;
        }
        pred = f6&3;
      } else {
        if( frame.pi )
          goto try_flag8;
        pred = (uint8_t)frame.best_flags&3;
      }
keep_flag8: { frame.flag8 = (uint8_t)frame.best_flags&8; }
      frame.best_bits += best_cost;
      c0 = pred==2;
      if( pred!=1 )
        pred = 0;
      c1 = frame.plane_i;
      hard += c0;
      frame.bits_total += pred;
      c2 = frame.flag8;
      frame.costs[frame.dims[1]] = best_cost;
      c3 = frame.pi;
      frame.n_flagged += c2!=0;
      plane_desc[c1].flags = (uint8_t)frame.best_flags;
      frame.pi = c3+1;
      if( c3+1>=plane_count ) {
        frame.n_hard = hard;
        break;
      }
    }
  }
  {
    p2 = (uint8_t*)bmf_new(frame.tile_img->data_size);
    img_h1 = frame.tile_img->height;
    frame.rows[1] = plane_count;
    frame.pi = plane_count*(img_h1-1);
    memcpy(p2, frame.tile_src, frame.tile_img->data_size);
    img_h1b = frame.tile_img->height;
    if( img_h1b ) {
      p5 = p2;
      p3 = frame.rows[1];
      y1 = 0;
      off1 = 0;
      do {
        x1 = frame.tile_img->width;
        p4 = &frame.tile_img->pixels[off1];
        do {
          p6 = p3;
          do {
            *p4++ = *p5++;
            --p6;
          } while( p6 );
          p4 += frame.pi;
          --x1;
        } while( x1 );
        img_h1b = frame.tile_img->height;
        off1 += p3;
        ++y1;
      } while( y1<img_h1b );
    }
    transpose_image_in_place(frame.tile_img, frame.rows[1]);
    free(p2);
    bits_d = 0;
    if( plane_count>0 ) {
      pk = 0;
      while( 1 ) {
        pl_k = plane_desc[pk].src_plane;
        frame.rows[0] = pl_k;
        model_planes(frame.tile_img, frame.tile_buf, pl_k);
        bits = 8*(stream.cur-stream.buf);
        *(uint32_t*)stream.pk.word = stream.pk.acc;
        bits_d += bits;
        packer_reset();
        if( (uint32_t)(bits-(bits>>8))>frame.costs[frame.rows[0]] )
          break;
        if( ++pk>=plane_count ) {
          goto tile_restored;
        }
      }
      bits_d += frame.best_bits+1;
    }
tile_restored:
    if( bits_d+(bits_d>>12)>=frame.best_bits ) {
      base2 = (uint8_t*)bmf_new(frame.tile_img->data_size);
      rows_x_planes = plane_count*(frame.tile_img->height-1);
      frame.rows[1] = plane_count;
      memcpy(base2, frame.tile_src, frame.tile_img->data_size);
      img_h2 = frame.tile_img->height;
      if( img_h2 ) {
        frame.costs[0] = rows_x_planes;
        p11 = frame.rows[1];
        y2 = 0;
        off2 = 0;
        p13 = base2;
        do {
          x2 = frame.tile_img->width;
          p12 = &frame.tile_img->pixels[off2];
          do {
            p14 = p11;
            do {
              *p12++ = *p13++;
              --p14;
            } while( p14 );
            p12 += frame.costs[0];
            --x2;
          } while( x2 );
          img_h2 = frame.tile_img->height;
          off2 += p11;
          ++y2;
        } while( y2<img_h2 );
      }
      transpose_image_in_place(frame.tile_img, frame.rows[1]);
      free(base2);
    } else {
      frame.best_bits = bits_d;
      frame.base = (uint8_t*)bmf_new(img->data_size);
      img_h3 = img->height;
      frame.rows[1] = plane_count;
      frame.costs[0] = plane_count*(img_h3-1);
      memcpy(frame.base, img->pixels, img->data_size);
      img_h3b = img->height;
      if( img_h3b ) {
        p7 = frame.rows[1];
        y3 = 0;
        off3 = 0;
        p9 = frame.base;
        do {
          pl_i = img->width;
          p8 = img->pixels+off3;
          do {
            p10 = p7;
            do {
              *p8++ = *p9++;
              --p10;
            } while( p10 );
            p8 += frame.costs[0];
            --pl_i;
          } while( pl_i );
          img_h3b = img->height;
          off3 += p7;
          ++y3;
        } while( y3<img_h3b );
      }
      transpose_image_in_place(img, frame.rows[1]);
      free(frame.base);
    }
  }
  free(frame.tile_buf);
  if( plane_count>2 ) {
    if( frame.bits_total ) {
      for( desc_k = 0; desc_k<4; ++desc_k )
        frame.saved[desc_k] = plane_desc[desc_k];
      if( plane_count>0 ) {
        plane = 0;
        do {
          pi3 = plane;
          f2 = plane_desc[plane++].flags&8|5;
          plane_desc[pi3].flags = f2;
        } while( plane<plane_count );
      }
      transform_planes(frame.tile_img);
      bits_e = 8*(stream.cur-stream.buf);
      deep2 = bits_e<=frame.best_bits;
      *(uint32_t*)stream.pk.word = stream.pk.acc;
      packer_reset();
      if( deep2 ) {
        frame.best_bits = bits_e;
        nplanes_b = plane_count;
        cand = 0;
      } else {
        for( desc_k = 0; desc_k<4; ++desc_k )
          plane_desc[desc_k] = frame.saved[desc_k];
        nplanes_b = plane_count;
        cand = 1;
      }
      if( nplanes_b<=2 )
        goto planes_done;
    } else {
      cand = 1;
    }
    if( frame.n_hard+(cand==0) ) {
      for( desc_k = 0; desc_k<4; ++desc_k )
        frame.saved[desc_k] = plane_desc[desc_k];
      nplanes_c = plane_count;
      if( plane_count>0 ) {
        pl_a = 0;
        do {
          pi0 = pl_a;
          f0 = plane_desc[pl_a++].flags&8|6;
          plane_desc[pi0].flags = f0;
          nplanes_c = plane_count;
        } while( pl_a<plane_count );
      }
      if( nplanes_c==frame.n_hard&&nplanes_c-1==frame.n_flagged ) {
        cand = 0;
      } else {
        transform_planes(frame.tile_img);
        bits_a = 8*(stream.cur-stream.buf);
        deep2 = bits_a<=frame.best_bits;
        frame.rows[0] = bits_a;
        *(uint32_t*)stream.pk.word = stream.pk.acc;
        packer_reset();
        if( deep2 ) {
          frame.best_bits = bits_a;
          frame.n_hard = bits_a;
          if( plane_count-1==frame.n_flagged ) {
            cand = 0;
          } else {
            for( desc_k = 0; desc_k<4; ++desc_k )
              frame.saved[desc_k] = plane_desc[desc_k];
            if( plane_count>0 ) {
              pl_b = 0;
              do {
                pi1 = pl_b;
                f1 = plane_desc[pl_b++].nrefs;
                plane_desc[pi1].flags |= 8*(f1!=0);
              } while( pl_b<plane_count );
            }
            transform_planes(frame.tile_img);
            bits2 = 8*(stream.cur-stream.buf);
            deep2 = bits2<=frame.rows[0];
            *(uint32_t*)stream.pk.word = stream.pk.acc;
            packer_reset();
            if( deep2 ) {
              cand = 0;
            } else {
              for( desc_k = 0; desc_k<4; ++desc_k )
                plane_desc[desc_k] = frame.saved[desc_k];
              cand = 0;
            }
          }
        } else {
          for( desc_k = 0; desc_k<4; ++desc_k )
            plane_desc[desc_k] = frame.saved[desc_k];
        }
      }
    }
  } else {
    cand = 1;
  }
planes_done:
  if( !frame.n_hard&&plane_count>1 ) {
    tile_copy = (uint8_t*)bmf_new(frame.tile_img->data_size);
    memcpy(tile_copy, frame.tile_src, frame.tile_img->data_size);
    for( desc_k = 0; desc_k<4; ++desc_k )
      frame.saved[desc_k] = plane_desc[desc_k];
    if( plane_count>0 ) {
      pl_c = 0;
      do {
        pi4 = pl_c;
        f3 = plane_desc[pl_c++].flags&0xFB;
        plane_desc[pi4].flags = f3;
      } while( pl_c<plane_count );
    }
    transform_planes(frame.tile_img);
    bits_b = 8*(stream.cur-stream.buf);
    frame.rows[1] = bits_b;
    *(uint32_t*)stream.pk.word = stream.pk.acc;
    packer_reset();
    if( bits_b>frame.best_bits ) {
      for( desc_k = 0; desc_k<4; ++desc_k )
        plane_desc[desc_k] = frame.saved[desc_k];
    } else {
      frame.best_bits = bits_b;
      cand = 0;
    }
    if( frame.n_flagged+frame.bits_total ) {
      for( desc_k = 0; desc_k<4; ++desc_k )
        frame.saved[desc_k] = plane_desc[desc_k];
      if( plane_count>0 ) {
        pl_d = 0;
        do
          plane_desc[pl_d++].flags = 0;
        while( pl_d<plane_count );
      }
      memcpy(frame.tile_src, tile_copy, frame.tile_img->data_size);
      transform_planes(frame.tile_img);
      bits_c = 8*(stream.cur-stream.buf);
      deep2 = bits_c<=frame.best_bits;
      *(uint32_t*)stream.pk.word = stream.pk.acc;
      packer_reset();
      if( deep2 ) {
        cand = 0;
      } else {
        for( desc_k = 0; desc_k<4; ++desc_k )
          plane_desc[desc_k] = frame.saved[desc_k];
      }
    }
    free(tile_copy);
  }
  free(stream.buf);
  free((uint8_t*)frame.tile_img);
  return cand;
}

// bmp_read.inc -- read a BMP, in every depth and both run-length forms.

BmfImage* read_bmp(char* path) {
  BmfImage* img_f;
  uint8_t* row, bmp_bgra[4], pix;
  int32_t y8, run4;
  uint8_t* row_at;
  uint8_t* pal, * pal2, * pal3;
  uint8_t lo;
  uint32_t row_pad, byte;
  uint8_t cur, lo16;
  uint8_t* row4, * row3, * row6, * pal_at, * row5;
  int32_t pal_n, i, hi_nibble, left4, left4b, y, dxy, dy4, byte_in, step;
  uint32_t stride_pad, pair, hi, stride, got, left;
  BmpHeader hdr;
  FILE* fp = fopen(path, "rb");
  if( !fp||fread(&hdr.bfType, 0xEu, 1u, fp)!=1||hdr.bfType!=0x4D42||fread(&hdr.biSize, 0x28u, 1u, fp)!=1||hdr.biSize!=40||hdr.biPlanes!=1 ) {
    return nullptr;
  }
  {
    const int32_t bmp_w = hdr.biWidth;
    const int32_t bmp_h = hdr.biHeight;
    const int32_t bmp_bpp = hdr.biBitCount;
    // Everything this reader will not take, one reason per line.  It was one
    // 358-character condition, which is the only statement of the accepted
    // format anywhere -- `MODELS.md` had to reconstruct the list from it by
    // hand.
    if( bmp_w<=0||bmp_w>0xFFFF                                  // width 1..65535
     || bmp_h<=0||bmp_h>0xFFFF                                  // height likewise
     || (bmp_bpp>=8&&(uint32_t)bmp_w*(uint32_t)((bmp_bpp+7)>>3)>0xFFFFu)
                                                                // and a row of it fits in 16 bits
     || (bmp_bpp!=1&&bmp_bpp!=4&&bmp_bpp!=8&&bmp_bpp!=24&&bmp_bpp!=32)
                                                                // 1, 4, 8, 24 or 32 -- no 16
     || (int32_t)hdr.biClrUsed<0                                // a palette count, not a sign
     || (bmp_bpp<=8&&(int32_t)hdr.biClrUsed>(1<<bmp_bpp))       // no more entries than the depth allows
     || hdr.biCompression>2                                     // none, RLE8 or RLE4
     || (hdr.biCompression==1&&bmp_bpp!=8)                      // RLE8 is 8 bpp only
     || (hdr.biCompression==2&&bmp_bpp!=4) ) {                  // RLE4 is 4 bpp only
      fclose(fp);
      return nullptr;
    }
  }
  BmfImage* img = alloc_image(hdr.biWidth, hdr.biHeight, hdr.biBitCount, hdr.biBitCount<=8u, 1);
  if( !img ) {
    fclose(fp);
    return nullptr;
  }
  stride_pad = (img->stride+3)&0xFFFFFFFC;
  if( hdr.biBitCount<=8u ) {
    pal_n = 1<<(hdr.biBitCount&31);
    if( (int32_t)hdr.biClrUsed )
      pal_n = (int32_t)hdr.biClrUsed;
    if( pal_n>0 ) {
      for( i = 0; i<pal_n; ++i ) {
        fread(bmp_bgra, 4u, 1u, fp);
        if( img->depth&depth_palette )
          pal = img->pixels+img->data_size;
        else
          pal = 0;
        *(pal+3*i+2) = bmp_bgra[2];
        if( img->depth&depth_palette )
          pal2 = img->pixels+img->data_size;
        else
          pal2 = 0;
        *(pal2+3*i+1) = bmp_bgra[1];
        if( img->depth&depth_palette )
          pal3 = img->pixels+img->data_size;
        else
          pal3 = 0;
        *(pal3+3*i) = bmp_bgra[0];
      }
    }
  }
  void* pal_buf = bmf_new(stride_pad<256 ? 256 : stride_pad);
  row = img->pixels+img->data_size-img->stride;
  fseek(fp, (int32_t)hdr.bfOffBits, 0);
  if( hdr.biCompression ) {
    uint8_t*const pix_lo = img->pixels;
    uint8_t*const pix_hi = img->pixels+img->data_size;
    if( hdr.biCompression==1 ) {
      memset(img->pixels, 0, img->data_size);
      row_at = row;
      img_f = img;
      int32_t y4 = img->height-1;
      while( 1 ) {
        uint8_t *row_ofs = row_at;
        if( ferror(fp) )
          return nullptr;
        int32_t run = fgetc(fp);
        int32_t run_val = fgetc(fp);
        if( run<0||run_val<0 )
          return nullptr;
        if( run ) {
          if( row_ofs<pix_lo||row_ofs+run>pix_hi )
            return nullptr;
          __builtin_memset(row_ofs, run_val, run);
          row_at = row_ofs+run;
        } else if( run_val ) {
          if( run_val==1 )
            goto done;
          if( run_val==2 ) {
            int32_t dx = fgetc(fp);
            int32_t dy = fgetc(fp);
            if( dx<0||dy<0 )
              return nullptr;
            row_at += dx-dy*(uint16_t)img_f->stride;
          } else {
            if( row_at<pix_lo||row_at+run_val>pix_hi )
              return nullptr;
            fread(pal_buf, (run_val+1)&0xFFFFFFFE, 1u, fp);
            memcpy(row_at, (uint8_t*)pal_buf, run_val);
            row_at += run_val;
          }
        } else {
          if( --y4<0 )
            goto done;
          row_at = img_f->pixels+y4*(uint16_t)img_f->stride;
        }
      }
    }
    if( hdr.biCompression!=2 )
      return nullptr;
    memset(img->pixels, 0, img->data_size);
    img_f = img;
    hi_nibble = 1;
    y8 = img->height-1;
    while( 1 ) {
      while( 1 ) {
        while( 1 ) {
// The top of the run-length opcode loop.  Five paths jump here and this is
          // not a `continue`: the label sits at brace depth 5 and the five jumps at
          // depths 8, 8, 5, 5 and 4, so three of them are inside nested loops or
          // outside this one.  Substituting `continue` compiles, passes the corpus,
          // and sends two of the five to the wrong loop.
next_opcode:
          if( ferror(fp) )
            return nullptr;
          run4 = fgetc(fp);
          byte_in = fgetc(fp);
          if( run4<0||byte_in<0 )
            return nullptr;
          byte = (uint32_t)byte_in;
          pair = byte;
          if( !run4 )
            break;
          if( row<pix_lo||row+(run4/2+1)>pix_hi )
            return nullptr;
          lo = byte&0xF;
          if( hi_nibble ) {
            left4b = run4;
            row3 = row;
            while( left4b!=1 ) {
              *row3++ = pair;
              left4b -= 2;
              if( !left4b ) {
                row = row3;
                hi_nibble = 1;
                goto next_opcode;
              }
            }
            row = row3;
            *row3 = pair&0xF0;
            hi_nibble = 0;
          } else {
            left4 = run4;
            row4 = row;
            cur = *row;
            hi = pair>>4;
            lo16 = 16*lo;
            while( 1 ) {
              *row4++ = hi|cur;
              if( left4==1 )
                break;
              cur = lo16;
              left4 -= 2;
              if( !left4 ) {
                row = row4;
                *row4 = lo16;
                hi_nibble = 0;
                goto next_opcode;
              }
            }
            row = row4;
            hi_nibble = 1;
          }
        }
        if( byte )
          break;
        if( --y8<0 )
          goto done;
        row = img_f->pixels+y8*(uint16_t)img_f->stride;
      }
      if( byte==1 )
        goto done;
      if( byte!=2 )
        break;
      dxy = fgetc(fp);
      dy4 = fgetc(fp);
      if( dxy<0||dy4<0 )
        return nullptr;
      step = (dxy>>1)-dy4*(uint16_t)img_f->stride;
      if( (dxy&1)==1 ) {
        if( !hi_nibble )
          ++step;
        hi_nibble = !hi_nibble;
      }
      row += step;
    }
    if( row<pix_lo||row+((int32_t)byte/2+1)>pix_hi )
      return nullptr;
    fread(pal_buf, (((byte+1)>>1)+1)&0xFFFFFFFE, 1u, fp);
    pal_at = (uint8_t*)pal_buf;
    row5 = row;
    while( 1 ) {
      pix = *pal_at;
      if( hi_nibble ) {
        left = pair-1;
        if( !left ) {
          row = row5;
          *row5 = *pal_at&0xF0;
          hi_nibble = 0;
          goto next_opcode;
        }
        *row5++ = pix;
        hi_nibble = 1;
      } else {
        *row5++ |= (uint8_t)*pal_at>>4;
        left = pair-1;
        if( !left ) {
          row = row5;
          hi_nibble = 1;
          goto next_opcode;
        }
        *row5 = 16*(pix&0xF);
        hi_nibble = 0;
      }
      ++pal_at;
      pair = left-1;
      if( !pair ) {
        row = row5;
        goto next_opcode;
      }
    }
  }
  stride = img->stride;
  row_pad = stride_pad-stride;
  if( hdr.biHeight-1>=0 ) {
    y = hdr.biHeight-1;
    img_f = img;
    row6 = row;
    while( 1 ) {
      got = fread(row6, 1u, stride, fp);
      stride = (uint16_t)img_f->stride;
      if( got!=stride )
        return nullptr;
      if( row_pad ) {
        fseek(fp, row_pad, 1);
        stride = (uint16_t)img_f->stride;
      }
      row6 -= stride;
      if( --y<0 )
        goto done;
    }
  }
// One exit: close the file, give the palette scratch back, return the image.
done:
  fclose(fp);
  free(pal_buf);
  return img;
}

// bmp_write.inc -- write one back.

int32_t write_bmp(BmfImage* img, char* path, int32_t want_rle) {
  uint32_t off_bits, stride, done;
  uint8_t *buf_2, *end;
  int32_t rows2, pal_bytes;
  uint8_t *buf;
  int32_t row_i2, run_max, nib;
  FILE* fp, * fp2;
  bool can_rle;
  uint32_t stride1, at, at2;
  uint8_t *out_buf, *out_at, *p, *q, *out2;
  int32_t rle_on, i, rows, bits, rle_mode, src_bits, rle_kind, rows3, row_i, lit_len, run, coded_bytes, y;
  uint8_t byte;
  uint32_t data_len, stride3, n_bytes, pad;
  rle_on = want_rle;
  fp = fopen(path, "wb");
  if( !fp )
    return 0;
  out_buf = (uint8_t*)bmf_new(img->data_size+8*img->height+(img->data_size>>5)+2048);
  BmpHeader* bmp = (BmpHeader*)out_buf;
  i = img->width;
  bmp->biSize = 40;
  bmp->bfType = 0x4D42;
  rows = img->height;
  rows2 = rows;
  bmp->bfReserved2 = 0;
  bmp->bfReserved1 = 0;
  bmp->biWidth = i;
  bmp->biHeight = rows;
  int8_t depth_flags = (int8_t)img->depth;
  bmp->biPlanes = 1;
  bits = img->depth&depth_bits;
  bmp->biBitCount = bits;
  bmp->biClrImportant = 0;
  bmp->biClrUsed = 0;
  bmp->biYPelsPerMeter = 0;
  bmp->biXPelsPerMeter = 0;
  buf = out_buf+54;
  if( bits<=8 ) {
    int32_t ncolours = 1<<(bits&31);
    int32_t ncol = 1<<(bits&31);
    if( depth_flags&0x40 ) {
      uint32_t levels = 0x100u>>(bits&31);
      if( ncol>0 ) {
        if( ncol/2 ) {
          uint32_t k = 0;
          int32_t grey = 0;
          do {
            *(uint32_t*)&out_buf[8*k+54] = ((uint8_t)grey<<16)|(uint8_t)grey|((uint8_t)grey<<8);
            *(uint32_t*)&out_buf[8*k+58] = ((uint8_t)(grey-levels+2*levels)<<16)|(uint8_t)(grey-levels+2*levels)|((uint8_t)(grey-levels+2*levels)<<8);
            grey += 2*levels;
            ++k;
          } while( k<(uint32_t)(ncol/2) );
          at = 2*k+1;
        } else {
          at = 1;
        }
        if( (at-1)<(uint32_t)ncol )
          *(uint32_t*)&out_buf[4*at+50] = ((uint8_t)(levels*(at-1))<<16)|(uint8_t)(levels*(at-1))|((uint8_t)(levels*(at-1))<<8);
      }
      pal_bytes = 4*ncol;
    } else if( depth_flags<0 ) {
      if( ncol<=0 ) {
        pal_bytes = 4*ncolours;
      } else {
        uint32_t pairs = ncolours/2;
        if( ncolours/2 ) {
          uint32_t j = 0;
          // `data_ofs2` is `img->data_size` on every path that reaches here,
          // and the palette sits immediately after the pixels -- so this was
          // `img->palette()` with `sizeof(BmfImage)` spelled as a 16 inside
          // each subscript.  Two BGR triples per turn, six bytes.
          const uint8_t *pal = img->palette();
          do {
            uint32_t slot = 2*j;
            int32_t bgr = *(uint16_t*)&pal[6*j+3];
            int32_t r = pal[6*j+5];
            *(uint32_t*)&out_buf[4*slot+54] = (pal[6*j+2]<<16)|*(uint16_t*)&pal[6*j];
            *(uint32_t*)&out_buf[4*slot+58] = (r<<16)|bgr;
            ++j;
          } while( j<pairs );
          rle_on = want_rle;
          at2 = 2*j+1;
          done = at2;
        } else {
          at2 = 1;
          done = 1;
        }
        if( (at2-1)<(uint32_t)ncol ) {
          // The odd colour the loop above did not reach.  `done` is one past
          // the last pair it wrote, so `3*done-3` is that entry's first byte.
          const uint8_t *pal2 = img->palette();
          int32_t bgr2 = *(uint16_t*)&pal2[3*done-3];
          *(uint32_t*)&out_buf[4*done+50] = ((pal2[3*done-1])<<16)|bgr2;
        }
        pal_bytes = 4*ncol;
      }
    } else {
      pal_bytes = 4*ncolours;
      memset(buf, 0, 4*ncolours);
      rows2 = img->height;
    }
    buf = &out_buf[pal_bytes+54];
  }
  stride = img->stride;
  off_bits = (uint32_t)(buf-out_buf);
  rle_mode = rle_on;
  data_len = img->data_size;
  while( 1 ) {
    out_at = buf;
    p = &img->pixels[data_len-stride];
    bmp->bfOffBits = off_bits;
    if( !rle_mode )
      break;
    src_bits = img->depth&depth_bits;
    can_rle = src_bits==4;
    if( src_bits!=4 ) {
      if( src_bits!=8 )
        break;
      can_rle = 0;
    }
    rle_kind = 2;
    if( !can_rle )
      rle_kind = 1;
    bmp->biCompression = rle_kind;
    nib = rle_kind-1;
    run_max = (0x100u>>((rle_kind-1)&31))-1;
    if( rows2>0 ) {
      rows3 = rows2;
      stride3 = stride;
      row_i = 0;
      while( 1 ) {
        if( p>=&p[stride3] )
          goto write_rows;
        buf_2 = out_at;
        end = &p[stride3];
        row_i2 = row_i;
        lit_len = 0;
        do {
          while( 1 ) {
            while( 1 ) {
              q = p+1;
              if( p+1>=end )
                break;
              byte = (uint8_t)*p;
              run = 1;
              do {
                if( byte!=p[run] )
                  break;
                ++run;
              } while( end>&p[run] );
              if( run<=2&&(run!=2||lit_len) )
                break;
              if( run_max<run )
                run = run_max;
              if( lit_len ) {
                if( nib ? lit_len!=1 : lit_len>=3 ) {
                  *buf_2 = 0;
                  uint8_t *abs_end2 = buf_2+2;
                  buf_2[1] = lit_len<<(nib&31);
                  memcpy(buf_2+2, &p[-lit_len], lit_len);
                  buf_2 += lit_len+2;
                  if( lit_len&1 ) {
                    abs_end2[lit_len] = 0;
                    ++buf_2;
                  }
                } else if( nib ) {
                  *buf_2 = 2;
                  buf_2[1] = *(p-1);
                  buf_2 += 2;
                } else {
                  if( lit_len==2 ) {
                    *buf_2 = 1;
                    buf_2[1] = *(p-2);
                    buf_2 += 2;
                  }
                  *buf_2 = 1;
                  buf_2[1] = *(p-1);
                  buf_2 += 2;
                }
                lit_len = 0;
                byte = *p;
              }
              buf_2[1] = byte;
              p += run;
              *buf_2 = run<<(nib&31);
              uint8_t *out_end = buf_2+2;
              buf_2 += 2;
              if( p>=end ) {
                out_at = out_end;
                row_i = row_i2;
                rows3 = img->height;
                stride3 = img->stride;
                goto write_rows;
              }
            }
            ++p;
            if( ++lit_len!=run_max )
              break;
            if( nib ? lit_len!=1 : lit_len>=3 ) {
              *buf_2 = 0;
              uint8_t *abs_end = buf_2+2;
              buf_2[1] = lit_len<<(nib&31);
              memcpy(buf_2+2, &q[-lit_len], lit_len);
              buf_2 += lit_len+2;
              if( lit_len&1 ) {
                abs_end[lit_len] = 0;
                ++buf_2;
              }
            } else if( nib ) {
              *buf_2 = 2;
              buf_2[1] = *(q-1);
              buf_2 += 2;
            } else {
              if( lit_len==2 ) {
                *buf_2 = 1;
                buf_2[1] = *(q-2);
                buf_2 += 2;
              }
              *buf_2 = 1;
              buf_2[1] = *(q-1);
              buf_2 += 2;
            }
            if( q>=end ) {
              out_at = buf_2;
              row_i = row_i2;
              rows3 = img->height;
              stride3 = img->stride;
              goto write_rows;
            }
            lit_len = 0;
          }
        } while( q<end );
        out_at = buf_2;
        row_i = row_i2;
        if( lit_len&&(nib ? lit_len!=1 : lit_len>=3) ) {
          *buf_2 = 0;
          buf_2[1] = lit_len<<(nib&31);
          memcpy(buf_2+2, &q[-lit_len], lit_len);
          row_i = row_i2;
          out_at = &buf_2[lit_len+2];
          if( lit_len&1 ) {
            buf_2[lit_len+2] = 0;
            ++out_at;
          }
        } else if( lit_len&&nib ) {
          buf_2[1] = *(q-1);
          *buf_2 = 2;
          out_at = buf_2+2;
        } else if( lit_len ) {
          if( lit_len==2 ) {
            *buf_2 = 1;
            buf_2[1] = *(q-2);
            out_at = buf_2+2;
          }
          out_at[1] = *(q-1);
          *out_at = 1;
          out_at += 2;
        }
        rows3 = img->height;
        stride3 = img->stride;
// The row-writing loop.  Three paths reach it, each setting `row_i`, `rows3`
// and `stride3` first -- which is the loop's three arguments, passed by
// assignment because the decompiler had no function to pass them to.
write_rows:
        *out_at = 0;
        out_at[1] = 0;
        out_at += 2;
        ++row_i;
        p -= 2*stride3;
        if( row_i>=rows3 ) {
          rows2 = rows3;
          stride = stride3;
          data_len = img->data_size;
          break;
        }
      }
    }
    *out_at = 0;
    out_at[1] = 1;
    out_at += 2;
    coded_bytes = out_at-buf;
    if( data_len>(uint32_t)(out_at-buf) ) {
      bmp->biSizeImage = (uint32_t)coded_bytes;
      n_bytes = (uint32_t)(out_at-out_buf);
      bmp->bfSize = n_bytes;
      if( fwrite(out_buf, 1u, n_bytes, fp)!=bmp->bfSize )
        return 0;
      free(out_buf);
      fclose(fp);
      return 1;
    }
    rle_mode = 0;
  }
  fp2 = fp;
  out2 = out_buf;
  bmp->biCompression = 0;
  if( rows2<=0 ) {
    coded_bytes = 0;
  } else {
    pad = ((stride+3)&0xFFFFFFFC)-stride;
    stride1 = stride;
    y = 0;
    do {
      memcpy(out_at, p, stride1);
      stride1 = img->stride;
      out_at += stride1;
      p -= stride1;
      if( pad ) {
        *(uint32_t*)out_at = 0;
        out_at += pad;
      }
      ++y;
    } while( y<img->height );
    out2 = out_buf;
    fp2 = fp;
    coded_bytes = out_at-buf;
  }
  bmp->biSizeImage = (uint32_t)coded_bytes;
  n_bytes = (uint32_t)(out_at-out2);
  bmp->bfSize = n_bytes;
  if( fwrite(out2, 1u, n_bytes, fp2)!=bmp->bfSize )
    return 0;
  free(out2);
  fclose(fp2);
  return 1;
}

// image_expand.inc -- the image out of a `.bmf`.

BmfImage* expand_image(BmfFile* arc_in, CodedTail** p_coded_buf) {
  struct alignas(16) ExpandImageFrame {
    uint8_t* Block;
    union {
      BmfImage img;
      uint32_t mask;
      struct {
        uint32_t s0;
        int32_t s4;
        int32_t s8;
        uint32_t s12;
      };
    };
    int32_t nplanes_s;
    uint8_t* row_step;
    BmfFile* arc_f;
    BmfImage* p_i_2;
    int32_t depth_f;
    uint32_t pal_len;
    uint16_t hdr_words[5];
    uint8_t depth_b;
    int8_t flags_b;
    uint32_t data_len;
    CodedTail head;
    uint32_t magic_word;
    uint8_t _pad0[32];
  } frame;
  BmfFile* arc;
  FILE *fp1;
  BmfImage* img_at;
  uint8_t bpp, has_coded;
  uint32_t pred_s;
  uint8_t* pal_at, * copy, * srcp, * dst;
  int32_t plane_i, plane, pl2, plane2, pred, i, n_pix2, pix_at, nplanes_c, i2, n_planes, last_row, at, y, pl_i, left;
  uint16_t img_h;
  uint8_t major_v, minor_v;
  // The archive version, as a plain local.  The decompilation parked it in
  // `plane_desc[0].weight0` because the original did: `plane_desc[0]` is a
  // header slot, not a plane, and its three weight words were free.
  int32_t version, n_pix;
  uint32_t magic, pal_bytes, want2, got;
  uint8_t* plane_buf;
  arc = arc_in;
  if( p_coded_buf )
    *p_coded_buf = nullptr;
  fp1 = (arc_in)->fp;
  if( !fp1 )
    return nullptr;
  while( 1 ) {
    if( fread(&frame.magic_word, 4u, 1u, fp1)!=1 ) {
      FILE *fp = arc->fp;
      if( feof(fp) )
        return nullptr;
      {
        fclose(fp);
        arc->fp = 0;
        return nullptr;
      }
    }
    magic = frame.magic_word;
    if( (uint16_t)frame.magic_word!=0x9081 )
      break;
    major_v = (uint8_t)(frame.magic_word>>16);
    minor_v = (uint8_t)(frame.magic_word>>24);
    version = ((major_v<<8)-12288)|(minor_v-48);
    if( version!=512||fread(&frame.head, 8u, 1u, arc->fp)!=1 )
      break;
    fseek(arc->fp, frame.head.len, 1);
    fp1 = arc->fp;
  }
  if( (uint16_t)magic!=0x8A81||(major_v = (uint8_t)(magic>>16), minor_v = (uint8_t)(magic>>24), version = ((major_v<<8)-12288)|(minor_v-48), version!=512)||fread(frame.hdr_words, 0x10u, 1u, arc->fp)!=1 ) {
    return arc->fail();
  }
  if( frame.flags_b<0 ) {
    fread(&frame.head, 8u, 1u, arc->fp);
    if( p_coded_buf ) {
      if( frame.head.len>bytes_left(arc->fp) ) {
        return arc->fail();
      }
      // Up to a word, and up from zero to four: `(len==0)` is what makes an
      // empty tail one word rather than none, and the last word is cleared
      // because the read below stops at `len` and leaves the padding it wrote
      // nothing into.
      uint32_t pad_len = (frame.head.len+(frame.head.len==0)+3)&0xFFFFFFFC;
      CodedTail *blk = (CodedTail*)bmf_new(pad_len+sizeof(CodedTail));
      blk->tag = frame.head.tag;
      blk->len = pad_len;
      blk->data[pad_len/4-1] = 0;
      *p_coded_buf = blk;
      fread(blk->data, frame.head.len, 1u, arc->fp);
    } else {
      fseek(arc->fp, frame.head.len, 1);
    }
  }
  if( frame.data_len>bytes_left(arc->fp) ) {
    return arc->fail();
  }
  pal_bytes = 3<<(frame.depth_b&31);
  if( !(frame.depth_b&0x80) )
    pal_bytes = frame.depth_b&0x80;
  frame.pal_len = pal_bytes;
  if( !frame.hdr_words[0]||!frame.hdr_words[1] ) {
    return arc->fail();
  }
  img_at = alloc_image(frame.hdr_words[0], frame.hdr_words[1], frame.depth_b&0x3F, (uint8_t)(frame.depth_b&0x80)>>7, 1);
  frame.depth_f = frame.depth_b;
  img_at->depth = frame.depth_b;
  has_coded = p_coded_buf&&*p_coded_buf;
  int8_t hdr_flags = frame.flags_b;
  img_at->flags |= frame.flags_b&2|(has_coded<<7);
  plane_count = ((frame.depth_f&0x3Fu)+7)>>3;
  if( plane_count<1||plane_count>4 ) {
    return arc->fail();
  }
  if( !(hdr_flags&0x20) ) {
    if( frame.data_len>img_at->data_size ) {
      return arc->fail();
    }
    uint32_t want = frame.data_len;
    if( fread(img_at->pixels, 1u, frame.data_len, arc->fp)!=want ) {
      return arc->fail();
    }
    goto read_palette;
  }
  near_lossless_q = 0;
  alphabet_reduced = 0;
  if( !(hdr_flags&4) ) {
    printf("\nwritten in fast mode; this build only decodes -S streams\n");
    exit(3);
  }
  desc_slow_mode = 1;
  stream.size = frame.data_len;
  stream.buf = (uint8_t*)bmf_new(frame.data_len);
  packer_reset();
  want2 = frame.data_len;
  if( fread(stream.buf, 1u, frame.data_len, arc->fp)!=want2 ) {
    return arc->fail();
  }
  bpp = img_at->depth;
  if( (bpp&0x3Fu)<=4||(frame.flags_b&0x10)==0 ) {
    plane_predictor = 0;
    plane_alt_model = 0;
    unmodel_plane(img_at, img_at->pixels);
    goto check_length;
  }
  // The near-lossless nibble, mirroring `image_compress`: present for a single
  // greyscale plane and for three or more, absent otherwise.  Two `goto`s
  // jumped over it; the condition is the encoder's, negated.
  if( plane_count==1 ? (bpp&0x40)!=0 : plane_count>2 ) {
    uint32_t near_lossless = unpack_bits(4);
    if( near_lossless ) {
      printf("\nnear-lossless stream (E=%d); this build only decodes E=0\n", near_lossless);
      exit(3);
    }
    near_lossless_q = 0;
  }
  if( plane_count>0 ) {
    frame.mask = 255;
    frame.p_i_2 = img_at;
    frame.arc_f = arc;
    int32_t pl = 0;
    do {
      uint32_t desc = unpack_bits(6);
      uint32_t desc_flags = desc>>2;
      int32_t nrefs = desc&3;
      plane_desc[pl].flags = desc_flags;
      plane_desc[pl].nrefs = nrefs;
      plane_desc[nrefs].src_plane = pl;
      if( plane_desc[pl].flags&8 ) {
        uint8_t dc_v = unpack_bits(8);
        plane_desc[pl].dc = dc_v;
        if( nrefs>1 ) {
          uint32_t w4_v = unpack_bits(8);
          plane_desc[pl].weight0 = w4_v-64;
          uint32_t w8_v = unpack_bits(8);
          plane_desc[pl].weight1 = w8_v-64;
          if( nrefs>2 ) {
            uint32_t w12_v = unpack_bits(8);
            plane_desc[pl].weight2 = w12_v-64;
          }
        }
      }
      ++pl;
    } while( pl<plane_count );
    img_at = frame.p_i_2;
    arc = frame.arc_f;
  }
  plane_buf = (uint8_t*)bmf_new(img_at->width*img_at->height);
  if( frame.flags_b&8 ) {
    frame.img = *img_at;
    frame.img.depth = 72;
    if( plane_count>0 ) {
      frame.arc_f = arc;
      plane_i = 0;
      do {
        plane = plane_desc[plane_i].src_plane;
        plane_predictor = plane_desc[plane].flags&3;
        plane_alt_model = (uint8_t)(plane_desc[plane].flags&4)>>2;
        unmodel_plane(&frame.img, plane_buf);
        if( plane_predictor ) {
          if( plane_predictor==1 ) {
            if( !plane_alt_model )
              unpredict_med(plane_buf, img_at->width, img_at->height);
          }
        } else {
          expand_predictor_mode0(img_at->width);
        }
        interleave_plane(img_at, plane_buf, plane);
        ++plane_i;
      } while( plane_i<plane_count );
restore_arc:
      arc = frame.arc_f;
    }
  } else {
    plane_predictor = plane_desc[0].flags&3;
    plane_alt_model = (uint8_t)(plane_desc[0].flags&4)>>2;
    {
      unmodel_plane(img_at, img_at->pixels);
      if( plane_alt_model )
        goto free_plane_buf;
    }
    if( plane_count>0 ) {
      frame.arc_f = arc;
      pl2 = 0;
      do {
        ++pl2;
        plane2 = plane_desc[pl2-1].src_plane;
        pred = plane_desc[plane2].flags&3;
        plane_predictor = pred;
        if( (plane_desc[plane2].flags&8)!=0||pred ) {
          i = img_at->width;
          frame.row_step = &img_at->pixels[plane2];
          n_pix = i*img_at->height;
          frame.nplanes_s = plane_count;
          frame.s12 = n_pix;
          if( plane_count==1 ) {
            memcpy(plane_buf, frame.row_step, frame.s12);
            pred_s = plane_predictor;
          } else {
            frame.Block = &img_at->pixels[plane2];
            frame.s0 = pred;
            frame.s4 = plane2;
            frame.s8 = pl2;
            n_pix2 = frame.s12;
            frame.p_i_2 = img_at;
            pix_at = 0;
            nplanes_c = frame.nplanes_s;
            i2 = 0;
            do {
              plane_buf[pix_at] = frame.Block[i2];
              i2 += nplanes_c;
              ++pix_at;
            } while( pix_at<n_pix2 );
            pred_s = frame.s0;
            plane2 = frame.s4;
            pl2 = frame.s8;
            img_at = frame.p_i_2;
          }
          if( pred_s ) {
            if( pred_s==1 )
              unpredict_med(plane_buf, img_at->width, img_at->height);
          } else {
            expand_predictor_mode0(img_at->width);
          }
          interleave_plane(img_at, plane_buf, plane2);
        }
      } while( pl2<plane_count );
      goto restore_arc;
    }
  }
free_plane_buf:
  free(plane_buf);
check_length:
  if( stream.buf+frame.data_len!=stream.cur ) {
    return arc->fail();
  }
  free(stream.buf);
  frame.depth_f = frame.depth_b;
read_palette:
  if( frame.depth_f&0x80 ) {
    pal_at = (img_at->depth&depth_palette) ? img_at->palette() : nullptr;
    got = fread(pal_at, 1u, frame.pal_len, arc->fp);
    if( got!=frame.pal_len ) {
      return arc->fail();
    }
  }
  if( img_at->flags&flags_transposed ) {
    if( (uint64_t)img_at->width*img_at->height*(uint32_t)plane_count>(uint64_t)img_at->data_size ) {
      return arc->fail();
    }
    copy = (uint8_t*)bmf_new(img_at->data_size);
    n_planes = plane_count;
    last_row = plane_count*(img_at->height-1);
    memcpy(copy, img_at->pixels, img_at->data_size);
    img_h = img_at->height;
    if( img_h ) {
      srcp = copy;
      at = 0;
      y = 0;
      do {
        pl_i = img_at->width;
        frame.p_i_2 = img_at;
        dst = &img_at->pixels[at];
        do {
          left = n_planes;
          do {
            *dst++ = *srcp++;
            --left;
          } while( left );
          dst += last_row;
          --pl_i;
        } while( pl_i );
        img_at = frame.p_i_2;
        img_h = frame.p_i_2->height;
        at += n_planes;
        ++y;
      } while( y<img_h );
    }
    transpose_image_in_place(img_at, n_planes);
    free(copy);
  }
  return img_at;
}

// image_compress.inc -- one image into one.

int32_t compress_image(BmfFile* arc_in, BmfImage* p_i, const CodedTail* extra_blk) {
  BmfImage hdr;
  int32_t plane_n, row_step;
  uint32_t filtered;
  uint8_t* pixels;
  int32_t coded_bytes;
  uint8_t* pix_copy;
  uint32_t coded_len;
  bool fits;
  uint32_t data_bytes, row_bytes;
  uint8_t has_coded, *row_at;
  uint32_t hdr_pad8;
  int32_t ok_all, y, pl_i, countdown, data_size, row_y;
  uint16_t img_h;
  BmfImage* img;
  uint32_t pal_bytes, written;
  uint8_t ok, * dst, ok_raw;
  BmfFile* arc = arc_in;
  if( !arc_in->fp )
    return 0;
  // The walk that was here read every member already in the output and left
  // the file positioned after the last, which is where an appended member had
  // to go.  `bmf c` writes the file, so there is nothing in front of this one.
  has_coded = extra_blk!=nullptr;
  img = (BmfImage*)(p_i);
  row_bytes = p_i->stride;
  if( extra_blk )
    has_coded = 1;
  hdr.width = p_i->width;
  hdr.height = p_i->height;
  p_i->flags |= has_coded<<7;
  hdr_pad8 = *(uint32_t*)&p_i->_pad8;
  hdr.stride = row_bytes;
  near_lossless_q = 0;
  *(uint32_t*)&hdr._pad8 = hdr_pad8;
  hdr.data_size = (uint32_t)p_i->data_size;
  plane_count = ((p_i->depth&depth_bits)+7)>>3;
  if( fwrite("\x81\x8A"
             "20\x81\x90"
             "20a+b",
             4u, 1u, arc->fp)!=1 )
    return 0;
  uint8_t bpp = p_i->depth;
  pal_bytes = bpp&0x80;
  if( bpp&0x80 )
    pal_bytes = 3<<(bpp&31);
  if( p_i->data_size<0x10u )
    goto write_raw;
  desc_slow_mode = 1;
  hdr.flags |= 0x24;
  if( (p_i->depth&depth_bits)<=4 ) {
    stream.size = p_i->data_size+0x20000;
    stream.buf = (uint8_t*)bmf_new(stream.size);
    packer_reset();
    plane_predictor = 0;
    plane_alt_model = 0;
    alphabet_reduced = 0;
    model_plane(p_i, p_i->pixels, p_i->pixels);
    goto write_coded;
  }
  filtered = search_filter(p_i, 0);
  hdr.flags |= 0x10u;
  if( p_i->flags&flags_transposed ) {
    uint32_t img_stride = p_i->stride;
    uint32_t hdr_pad8b = *(uint32_t*)&p_i->_pad8;
    hdr.width = p_i->width;
    hdr.height = p_i->height;
    data_bytes = p_i->data_size;
    hdr.stride = img_stride;
    *(uint32_t*)&hdr._pad8 = hdr_pad8b;
    hdr.data_size = data_bytes;
    hdr.flags = 0x34|(uint8_t)(hdr_pad8b>>24);
  } else {
    data_bytes = p_i->data_size;
  }
  stream.size = data_bytes+0x20000;
  stream.buf = (uint8_t*)bmf_new(data_bytes+0x20000);
  packer_reset();
  // The near-lossless nibble, four zero bits, is written for a single
  // greyscale plane and for three or more planes -- and not for two, nor for a
  // single palette plane.  The decompiler wrote that as a `goto` into the
  // middle of the `if` from its own `else`, which is one condition with the
  // `||` taken out.
  if( plane_count==1 ? (p_i->depth&depth_grey)!=0 : plane_count>2 ) {
    near_lossless_q = 0;
    pack_bits(0, 4);
  }
  alphabet_reduced = 0;
  if( plane_count>0 ) {
    int32_t pl = 0;
    do {
      uint32_t word_flags = (4*plane_desc[pl].flags)|plane_desc[pl].nrefs;
      pack_bits(word_flags, 6);
      if( plane_desc[pl].flags&8 ) {
        uint32_t word_dc = plane_desc[pl].dc;
        pack_bits(word_dc, 8);
        if( plane_desc[pl].nrefs>1u ) {
          uint32_t word_w4 = plane_desc[pl].weight0+64;
          pack_bits(word_w4, 8);
          uint32_t word_w8 = plane_desc[pl].weight1+64;
          pack_bits(word_w8, 8);
          if( plane_desc[pl].nrefs>2u ) {
            uint32_t word_w12 = plane_desc[pl].weight2+64;
            pack_bits(word_w12, 8);
          }
        }
      }
      ++pl;
    } while( pl<plane_count );
  }
  if( filtered ) {
    uint32_t n_pix = p_i->width*p_i->height;
    hdr.flags |= 8u;
    uint8_t *plane_buf = (uint8_t*)bmf_new(n_pix);
    if( plane_count>0 ) {
      int32_t pl2 = 0;
      do
        model_planes(p_i, plane_buf, plane_desc[pl2++].src_plane);
      while( pl2<plane_count );
    }
    free(plane_buf);
  } else {
    transform_planes(p_i);
  }
// Everything coded; flush the packer's last word and decide whether the coded
// stream is smaller than the pixels it came from.
write_coded:
  *(uint32_t*)stream.pk.word = stream.pk.acc;
  fits = (uint32_t)(stream.cur- stream.buf)<p_i->data_size;
  coded_bytes = stream.cur- stream.buf;
  hdr.data_size = (uint32_t)(stream.cur- stream.buf);
  if( fits ) {
    ok = fwrite(&hdr, 1u, 0x10u, arc->fp)==16;
    if( extra_blk ) {
      coded_len = extra_blk->len;
      ok &= fwrite(extra_blk, 1u, coded_len+sizeof(CodedTail), arc->fp)==coded_len+sizeof(CodedTail);
    }
    ok_all = (fwrite(stream.buf, 1u, coded_bytes, arc->fp)==(uint32_t)coded_bytes)&ok;
    free(stream.buf);
    if( ok_all&&(p_i->depth&depth_palette)!=0 )
      fwrite(&p_i->pixels[p_i->data_size], 1u, pal_bytes, arc->fp);
    fflush(arc->fp);
    if( ok_all )
      return (int32_t)hdr.data_size;
    return ok_all;
  }
  free(stream.buf);
  if( p_i->flags&flags_transposed ) {
    pix_copy = (uint8_t*)bmf_new(p_i->data_size);
    plane_n = plane_count;
    row_step = plane_count*(p_i->height-1);
    pixels = p_i->pixels;
    memcpy(pix_copy, p_i->pixels, p_i->data_size);
    img_h = p_i->height;
    if( img_h ) {
      row_at = pix_copy;
      row_y = 0;
      y = 0;
      do {
        pl_i = img->width;
        dst = img->pixels+y;
        do {
          countdown = plane_n;
          do {
            *dst++ = *row_at++;
            --countdown;
          } while( countdown );
          dst += row_step;
          --pl_i;
        } while( pl_i );
        img = (BmfImage*)(p_i);
        img_h = p_i->height;
        y += plane_n;
        ++row_y;
      } while( row_y<img_h );
    }
    transpose_image_in_place(img, plane_n);
    free(pix_copy);
  }
  // Both arms end here with `pixels` pointing at the same bytes: the transpose
  // above swaps the header's width, height and stride and leaves the pixel
  // buffer alone.  The `goto` that skipped this assignment was skipping a
  // second write of the value it already held.
write_raw:
  pixels = p_i->pixels;
  ok_raw = fwrite(img, 1u, 0x10u, arc->fp)==16;
  if( extra_blk ) {
    coded_len = extra_blk->len;
    ok_raw &= fwrite(extra_blk, 1u, coded_len+sizeof(CodedTail), arc->fp)==coded_len+sizeof(CodedTail);
  }
  written = fwrite(pixels, 1u, pal_bytes+img->data_size, arc->fp);
  data_size = img->data_size;
  if( !(ok_raw&(written==data_size+pal_bytes)) )
    return 0;
  return data_size;
}


void bmf_compress(const char* InName, const char* OutName) {
  int32_t i;
  BmfFile* Arc;
  FILE* fp = fopen(InName, "rb");
  if( !fp )
    bmf_fatal(bmf_no_open, InName);
  fclose(fp);
  BmfImage *p_i = read_bmp((char*)InName);
  if( !p_i )
    bmf_fatal(bmf_read_error);
  printf("File %16s, image %dx%dx%d, size - %d:", InName, p_i->width, p_i->height, p_i->depth&depth_bits, p_i->data_size);
  if( void* nb = bmf_new(sizeof(BmfFile)) )
    Arc = bmf_open_file((BmfFile*)nb, (char*)OutName, 0);
  else
    Arc = nullptr;
  int32_t Flags = p_i->depth;
  if( Flags&depth_palette ) {
    if( Flags&depth_grey ) {
      p_i->depth = Flags^depth_palette;
    } else {
      int32_t Colours = 1<<(Flags&depth_bits);
      int32_t Step = 0x100u>>(Flags&depth_bits);
      const uint8_t* Palette = p_i->palette();
      int32_t Grey = 0;
      for( i = 0; i<Colours; ++i ) {
        if( Palette[3*i]!=Grey||Palette[3*i+1]!=Grey||Palette[3*i+2]!=Grey )
          break;
        Grey += Step;
      }
      if( i>=Colours )
        p_i->depth = (Flags|depth_grey)^depth_palette;
    }
  }
  int32_t coded_len = compress_image(Arc, p_i, coded_block);
  if( !coded_len )
    bmf_fatal(bmf_write_error, OutName);
  printf("%6.3f bpp\n", (double)coded_len*8.0/(double)(p_i->height*p_i->width));
  free(p_i);
}

void bmf_decompress(const char* InName, const char* OutName) {
  BmfFile* arc;
  if( void* nb = bmf_new(sizeof(BmfFile)) )
    arc = bmf_open_file((BmfFile*)nb, (char*)InName, 1);
  else
    arc = nullptr;
  BmfImage* p_i = expand_image(arc, &coded_block);
  // One image in a file: nothing to parse is not the end of a list of members,
  // it is a file that is not one of ours.
  if( !p_i )
    bmf_fatal(bmf_bad_file, InName);
  printf("File %16s, image %dx%dx%d, size - %d\n", InName, p_i->width, p_i->height, p_i->depth&depth_bits, p_i->data_size);
  int32_t Depth = p_i->depth&depth_bits;
  if( Depth==2||Depth==15||Depth==16 ) {
    printf("%s: %d bits per pixel is not a BMP depth\n", OutName, Depth);
    exit(5);
  }
  if( !write_bmp(p_i, (char*)OutName, 1) )
    bmf_fatal(bmf_write_error, OutName);
  free(coded_block);
  coded_block = nullptr;
  free(p_i);
  bmf_close_file(arc, 1);
}


// `argv` is `char**` because that is main's signature and `const char**` inside
// because that is what everything downstream takes.  The donor had two bodies
// here -- one of them four lines that cast and forwarded -- and the cast is all
// that was ever between them.
int32_t main(int32_t argc, char** argv) {
  const char*const* args = (const char*const*)argv;
  bmf_set_denormal_mode();
  printf("BMF lossless image compressor, v.2.01 (C) 1998-1999, 2009 by Dmitry Shkarin\n");
  int32_t mode = argc==4&&!args[1][1] ? toupper(args[1][0]) : 0;
  if( mode!='C'&&mode!='D' ) {
    printf("e-mail: <dmitry.shkarin@mtu-net.ru>;  web: http://compression.graphicon.ru/ds/\n"
           "Usage: bmf c input.bmp output     compress, always with -S -Q9\n"
           "       bmf d input output.bmp     expand\n");
    return 1;
  }
  if( mode=='C' )
    bmf_compress(args[2], args[3]);
  else
    bmf_decompress(args[2], args[3]);
  return 0;
}
