// BMF lossless image compressor, v.2.01 (C) 1998-1999, 2009 by Dmitry Shkarin.
// A decompilation of BMF.exe; see tools/README.md for how it is kept honest.
//
// This file is the include list and the entry points.  Everything else is one
// unit per file below: a class with its methods defined in its own body, or a
// function large enough to be read on its own.
//
// The order is a reading order, not a dependency order -- `decls.inc` declares
// every function before any of them is defined, so a unit sits with what it
// belongs to rather than with what happens to call it.  What the order does
// still say is that the four files before `decls.inc` are the ones everything
// is written in terms of: the decompiler's macros, the allocator, the constant
// tables and the program's state.
//
// The *names* group where that order does not.  Sorted, the directory reads as
// nine runs, each one subsystem: `alt_p1_*` and `alt_p2_*` are the two
// alternate models -- each with its block, its parts and its coding bodies --
// then `bmp_*` the file format, `filter_*` the filter search, `image_*` one
// image each way, `model_*` the main model, `plane_*` one plane, `rc_*` the
// range coder, and `sym_*` the alphabet.  The noun comes first and the verb
// second, so `read_bmp.inc` is `bmp_read.inc` and its partner is beside it
// rather than fifteen entries away.
//
// The eight files that join no run -- `bitctr`, `ctxidx`, `decls`, `file`,
// `globals`, `ida`, `memory`, `tables` -- have no run to join.  A prefix
// invented for one file groups nothing, and renaming to a scheme rather than
// to a neighbour is how a naming convention stops meaning anything.
//
// ## the encode/decode pairs
//
// Nine of them are one `template<int32_t f_DEC>` each, instantiated as the two
// names their callers use.  What decided which: how many lines the two bodies
// actually share, measured as a longest common subsequence over the pair.
//
//   rc_end                       5 + 5     CounterNode::code_symbol      53 + 49
//   alt_model_p2_d8             11 + 11     code_symbol_tree              85 + 86
//   BitCtr::code_context_bit    52 + 50     AltP2Block::alt_p2_d8_body   171 + 147
//   rc_begin                    91 + 89     alt_model_p1                 263 + 212
//   P2Freq::code_three_way      49 + 55
//
// Five pairs were measured and declined.  What they share is not the body --
// it is the declaration block and the loop scaffolding -- and folding them
// would put two unrelated algorithms behind one `if`.  `tools/pairshare.py`
// re-measures this table and reports any line of it that has drifted; the
// numbers below were all wrong by the time it was written, which is why it
// exists.
//
//   alt_model_p2_encode / alt_model_p2_decode        123 of 586 (21%)
//   code_pixel / decode_pixel                        147 of 1036 (14%)
//   predict_med / unpredict_med                       10 of 123 (8%)
//   alt_model_p1_d8_encode / alt_model_p1_d8_decode     8 of 60 (13%)
//   model_plane / unmodel_plane                       15 of 258 (6%)
//
// Every merge was gated on its own -- the fifteen streams byte for byte, at
// both pointer widths -- and then all nine were instrumented and run over the
// corpus to check that both instantiations are actually entered.  A template
// whose decode half never runs is a gate passing about nothing.

#include <cctype>
#include <cmath>
#include <cstdarg>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <pmmintrin.h>
#include <xmmintrin.h>

// ida.inc -- what is left of the Hex-Rays vocabulary.
//
// The decompiler writes a byte or a word inside a wider value as a macro over
// a pointer cast -- `BYTE4(x)` for `*((uint8_t *)&x + 4)`, `LOWORD(x) = y` for
// a sixteen-bit store into the low half of a register.  Every one of those is
// gone from this tree now, and what replaced each is at the site: an absolute
// value written as `abs32`, a signed comparison written as a comparison, and a
// partial store written as the assignment it amounts to -- in every case the
// half it preserved turned out to be dead, which the types say and the streams
// agree with.  The macros were how MSVC's register allocation looked from the
// outside; none of them was a decision the program made.
//
// `__OFSUB__` went the same way.  It is the x86 overflow flag after a compare,
// and Hex-Rays emits it wherever the original tested a signed inequality --
// signed less-than *is* `SF != OF`, so `(x-y<0) ^ __OFSUB__(x,y)` is `x < y`
// and nothing more.  Its one site said `e_top > deadzone_hi`, which is what
// the five sibling lines around it already said.
//
// One is kept, because it says something the code means rather than something
// the compiler did.  `__PAIR64__` was the other, and its one remaining site was
// a register split after all -- two 32-bit stores MSVC had both halves for.

// Four bytes of a recovered struct that exist only at the wider pointer width:
// a member that is a pointer in one build and four bytes of padding in the
// other.  The struct's layout is the program's, and this is how it stays the
// same size at both.
#define BMF_SPILL_PAD(n) uint8_t _spill_pad ## n[sizeof(void*)-4]

// The two helpers the decompiler calls by name.  `abs32` is a function and not
// a macro, and it is what the branchless absolute values above became: the
// original computed `(m ^ x) - m` with `m` the sign broadcast into a byte or a
// word, which is `|x|` in as many bits as the destination keeps.
//
// `0u-(uint32_t)x` rather than `(uint32_t)-x`: the second negates before it
// converts, and negating `INT32_MIN` is signed overflow.  No residual in this
// program reaches it -- they are pixel differences -- but the two spellings
// have the same codegen, so the total one costs nothing and is one less thing
// UBSan has to be told to ignore.
inline uint32_t abs32(int32_t x) {
  return x<0 ? 0u-(uint32_t)x : (uint32_t)x;
}

// The exit codes, which are also the indices into the message table below --
// that table is what defines them, so there is nothing here to invent.  They
// are the program's exit status as well, and `test.sh` reads them, so the
// numbers are the interface and not just an ordering.
//
// `bmf_no_option` and `bmf_user_break` are in the table and never raised: the
// original had an option parser and a keyboard-interrupt check, and this build
// has neither.  They stay because removing them would renumber the five that
// are raised.
enum BmfExit {
  bmf_no_file    = 1,
  bmf_no_option  = 2,
  bmf_bad_file   = 3,
  bmf_read_error = 4,
  bmf_write_error= 5,
  bmf_no_open    = 6,
  bmf_no_memory  = 7,
  bmf_user_break = 8,
};

__attribute__((noreturn)) void bmf_fatal(int32_t Code, ...);

// ctxidx.inc -- build a context index out of named bit fields.
//
// Taken from `dummy.cpp`'s `SseIdx`, which does the same job for that
// program's secondary-estimation indices.  Renamed for what it indexes here:
// nothing in BMF is an SSE table, and every use below is a model context.
//
// The decompilation writes these as one multiplication chain --
//
//     nb = 32*W.match[2] + 16*W.match[4] + 2*W.match[0] + 8*NE.match[1]
//        + (N.match[1] + 4*(NE_sym == NW_sym))
//
// -- where every constant is a shift written as a multiply, the fields arrive
// in whatever order the register allocator wanted, and there is no way to see
// that the six terms are six *bits* of one six-bit word without adding up the
// powers of two by hand.  Hex-Rays writes them that way because MSVC emitted
// `lea` chains; the shape was never in the source.
//
//     nb = CtxIdx{}.bit<5>(W.match[2]).bit<4>(W.match[4])
//                  .bit<3>(NE.match[1]).bit<2>(NE_sym == NW_sym)
//                  .bit<1>(W.match[0]).bit<0>(N.match[1]);
//
// Same value, and now the width of the index is countable and a field cannot
// silently overlap its neighbour.
//
// It compiles to the same code: every method is `constexpr`, takes its
// position as a template parameter, and does one shift and one add.  The gate
// is what says so -- the fifteen streams are byte for byte what they were
// before this file existed.
struct CtxIdx {
  uint32_t val = 0;

  // One bit at `Pos`.
  template<int32_t Pos>
  constexpr CtxIdx&bit(bool b) {
    val += (uint32_t)b<<Pos;
    return *this;
  }

  // `W` bits of `v`, moved to `Pos`.
  template<int32_t Pos, int32_t W>
  constexpr CtxIdx&bits(uint32_t v) {
    val += (v&((1u<<W)-1))<<Pos;
    return *this;
  }

  // A mixed-radix digit: `v` counts in units of `Stride`, and `Radix` is how
  // many values it has.  Not a bit field -- `Stride` need not be a power of
  // two, and `Radix` need not be the next one up from it.
  //
  // `nb_slot` is the reason this exists.  `gA` strides 64 with five values and
  // `band` strides 320 -- which is 5*64 -- with six, so the pair is two digits
  // of a mixed-radix number rather than two fields, and writing either as
  // `bits<>` says a width where the truth is a radix.  That is not pedantry:
  // `bits<6, 2>(gA)` was tried, and the one neighbourhood in the corpus that
  // reaches `gA == 4` landed in slot 0 instead of 256, moving three streams.
  //
  // The radix is not enforced here -- it is a fact about the caller's value,
  // and this is a constant-folded add -- but it is written down, which is what
  // says `320 * 6 = 1920` is the size the table has to be.
  template<uint32_t Stride, uint32_t Radix>
  constexpr CtxIdx&digit(uint32_t v) {
    val += Stride*v;
    return *this;
  }

  // A term that is neither a bit field nor a bounded digit -- an index already
  // built, or one whose range the code cannot state.
  constexpr CtxIdx&raw(uint32_t v) {
    val += v;
    return *this;
  }

  constexpr operator uint32_t() const {
    return val;
  }
};

// memory.inc -- the allocator.
//
// Two of them.  The default is plain `malloc`/`free`; everything below the
// `#if` is a bucketed free list over an `mmap`ed arena placed above 4 GB, built
// with `-DBMF_HIGH_ARENA` and existing for one purpose -- to prove the program
// does not care where its memory is.  A pointer stored through a 32-bit
// integer would fault there and nowhere else, which is what `tools/x32.sh` and
// the high-arena gate (92 of 93 checks) are between them checking.
#if UINTPTR_MAX>0xFFFFFFFFu&&defined(BMF_HIGH_ARENA)
#include <sys/mman.h>
#define BMF_ARENA_BYTES ((size_t)768<<20)
#define BMF_ARENA_AT ((void*)0x0000200000000000ull)
static char* bmf_arena;
static size_t bmf_arena_used;
static void bmf_arena_init(void) {
  void* p = mmap(BMF_ARENA_AT, BMF_ARENA_BYTES, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE, -1, 0);
  bmf_arena = (p==MAP_FAILED) ? nullptr : (char*)p;
  if( !bmf_arena ) {
    fprintf(stderr, "bmf: no high arena\n");
    exit(7);
  }
  if( (uintptr_t)bmf_arena<=0xFFFFFFFFu ) {
    fprintf(stderr, "bmf: the high arena is not high\n");
    exit(7);
  }
}

#define BMF_BUCKETS 40
static void* bmf_bucket[BMF_BUCKETS];
// The smallest bucket that holds `n`: bucket `b` is `1 << (b+5)` bytes, so the
// answer is `ceil(log2(n)) - 5`, clamped.  This was the shift loop that says
// the same thing one bucket at a time; it is a cold path either way, so the
// change is for the reader.
static int32_t bmf_bucket_of(size_t n) {
  if( n<=32 )
    return 0;
  int32_t b = 64-5-__builtin_clzll((uint64_t)(n-1));
  return b<BMF_BUCKETS-1 ? b : BMF_BUCKETS-1;
}

static void*bmf_malloc(size_t n) {
  if( !bmf_arena )
    bmf_arena_init();
  int32_t b = bmf_bucket_of(n);
  size_t need = (size_t)1<<(b+5);
  if( bmf_bucket[b] ) {
    void* p = bmf_bucket[b];
    bmf_bucket[b] = *(void**)p;
    ((size_t*)p)[-2] = (size_t)b;
    return p;
  }
  if( bmf_arena_used+need+16>BMF_ARENA_BYTES )
    return nullptr;
  char* p = bmf_arena+bmf_arena_used+16;
  ((size_t*)p)[-2] = (size_t)b;
  bmf_arena_used += need+16;
  return p;
}

static void bmf_free(void* p) {
  if( !p )
    return;
  int32_t b = (int32_t)((size_t*)p)[-2];
  if( b<0||b>=BMF_BUCKETS )
    return;
  *(void**)p = bmf_bucket[b];
  bmf_bucket[b] = p;
}

#define malloc bmf_malloc
#define free bmf_free
#endif
#define BMF_PAGE ((uintptr_t)4096)
static void*bmf_page_alloc(size_t n) {
  void* base = malloc(n+BMF_PAGE+sizeof(void*));
  if( !base )
    return nullptr;
  uintptr_t raw = (uintptr_t)base+sizeof(void*);
  char* p = (char*)((raw+(BMF_PAGE-1))&~(BMF_PAGE-1));
  ((void**)p)[-1] = base;
  memset(p, 0, n);
  return p;
}

static void bmf_page_free(void* p) {
  if( p )
    free(((void**)p)[-1]);
}

// The original installed a new-handler and let `operator new` retry through
// it forever; the handler it installed never returns.  So the loop had one
// iteration and the indirection had one target, and both are gone: this is
// the check they amounted to.
//
// `n ? n : 1` stays.  A zero-byte `malloc` may return null without being out
// of memory, and this build's `bmf_new(0)` callers -- an image with no
// palette -- would take the failure path.
static void*bmf_new(size_t n) {
  void* p = malloc(n ? n : 1);
  if( !p )
    bmf_fatal(bmf_no_memory);
  return p;
}

