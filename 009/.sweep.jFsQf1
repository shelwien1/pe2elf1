  run_done:
        if( idx_s>hit_a ) {
          row_cur[6] = row_cur[6]+idx_s-hit_a;
          r8b = row_cur[8];
          r7b = row_cur[7]+idx_s;
          row_cur[7] = r7b-hit_a;
          row_cur[8] = r8b+idx_s-hit_a;
          rec = row_cur[5];
          row_cur[9] = row_cur[9]+idx_s-hit_a;
          rec->match2345 = 0x01010101;
          row_cur[5]->head4 = 0x01010101;
          pixp = pix_cur;
          nb_sym[1] = mode_symbol[1];
          pixp->prev = pixp->last;
          row_cur[5]->sym = (uint16_t)mode_symbol[1];
          pix_cur->last = (uint16_t)mode_symbol[1];
          flags_word = row_cur[5]->match2345;
          nb_sym[3] = row_cur[5]->head4;
          next = row_cur[5]+1;
          row_cur[5] = next;
          if( idx_s-hit_a!=1 ) {
            nb_sym[2] = (idx_s-hit_a-1)/2;
            if( nb_sym[2] ) {
              s3c = nb_sym[3];
              nb_sym[0] = hit_a;
              s1c = nb_sym[1];
              si = 0;
              idx_t = idx_s;
              s2a = nb_sym[2];
              do {
                pix_cur->prev = s1c;
                row_cur[5]->head4 = s3c;
                row_cur[5]->match2345 = flags_word;
                pixq = pix_cur;
                ++row_cur[5];
                pixq->prev = s1c;
                row_cur[5]->head4 = s3c;
                row_cur[5]->match2345 = flags_word;
                next = row_cur[5]+1;
                row_cur[5] = next;
                ++si;
              } while( si<s2a );
              hit_a = nb_sym[0];
              idx_s = idx_t;
              done = 2*si+1;
            } else {
              done = 1;
            }
            if( (uint32_t)(idx_s-hit_a-1)>(done-1) ) {
              s3d = nb_sym[3];
              pix_cur->prev = nb_sym[1];
              row_cur[5]->head4 = s3d;
              row_cur[5]->match2345 = flags_word;
              next = row_cur[5]+1;
              row_cur[5] = next;
