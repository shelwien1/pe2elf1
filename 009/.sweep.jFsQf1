static constexpr int32_t opt_max_error = 0;

static uint8_t* hist_scratch;

// The exclusion mask: one byte per symbol, stamped with the current generation
// once the symbol has been offered and rejected, so the next candidate that
// names it can be skipped.  `exclusion_gen` is that generation, and bumping it
// is how the whole mask is cleared without touching it.
//
// This was two references onto one 8736-byte blob -- `exclusion_mask[8192]`
// and a `__byte_445440[544]` for the tail -- and the split was wrong twice
// over.  Three things set the real size and none of them is 8192:
//
//   * the alphabet reaches 8193 symbols.  `rc_decode_flat(8193)` returns
//     0..8192 and the count is that plus one (`model.inc`), so a symbol index
//     reaches 8192 -- one past the end of the array that was named for it.
//   * a `SymPair` slot with no symbol yet holds 8192 (`model_workspace.inc`
//     seeds every one of them to it), and `ModelBlock::pixel_context` rejects
//     such a candidate by finding that byte stamped.  So the empty-slot
//     sentinel and the largest possible symbol share slot 8192 on purpose, and
//     `__byte_445440[0]` was that byte: the two writes to it sit in the middle
//     of the four that exclude `mode_symbol[1..4]`.
//   * the generation reset clears in sixteen-byte blocks, `(alphabet+15)>>4`
//     of them (`model.inc`), which for 8193 symbols writes 8208 bytes.
//
// The last is the binding constraint, and it is why `blob-independence.txt`
// records the tail as SHARED: something writes across the boundary, and the
// something is that round-up.  One array, sized by the clear that is widest.
static constexpr int32_t no_symbol = 8192;

alignas(16) static int8_t exclusion_mask[(no_symbol+1+15)&~15];

static uint16_t* model_tables;

static inline uint16_t*model_strip(uint32_t k) {
  return model_tables+254*k;
}

static int32_t mode_symbol[5];

static inline void bmf_zero16(void* p) {
  __builtin_memset(p, 0, 16);
}

static void bmf_set_denormal_mode() {
  _MM_SET_FLUSH_ZERO_MODE(_MM_FLUSH_ZERO_ON);
  _MM_SET_DENORMALS_ZERO_MODE(_MM_DENORMALS_ZERO_ON);
}

static inline float bmf_hsum4(const float x[4]) {
  return (x[0]+x[2])+(x[1]+x[3]);
}

// The five-row ring both alternate models keep.  `buf[0..4]` are the last five
// rows, oldest last, and `cursor[k]` points `margin` records into row `k` so
// that a negative index reaches the left-edge padding.  Advancing rotates the
// rows -- the oldest buffer is reused as the newest -- and repoints all five.
//
// Written out in `AltP1Block::advance_row` and again in `alt_p2_d8_body`, the
// two differing only in `margin` and the record type, which is what a template
// is for.  Both spelled the rotation with five named temporaries because MSVC
// held all five in registers.
//
// The padding-cell copies on either side of the call are deliberately *not*
// here: the two models mirror different numbers of cells from different
// offsets, and folding those in would mean one helper with two shapes behind
// a flag, which is not one helper.
template<typename T>
static inline void ring_advance(T** buf, T** cursor, int32_t margin) {
  T*const oldest = buf[4];
  buf[4] = buf[3];
  buf[3] = buf[2];
  buf[2] = buf[1];
  buf[1] = buf[0];
  buf[0] = oldest;
  for( int32_t k = 0; k<5; ++k )
    cursor[k] = buf[k]+margin;
}


// rc.inc -- the arithmetic coder, and nothing else.  Its file ends are rc_io.inc.
//
// A carry-propagating range coder: `low` and `range` narrow as symbols arrive,
// and a byte leaves whenever `range` falls below `kTop`.  The four constants
// were four magic words in the decompilation -- 0x800000, 0x7F800000,
// 0x80000000, 0x7FFFFFFF -- and the fifth, `kMarker = 0x97`, is the byte the
// original seeds `cache` with, which is why a stream's first byte is not part
// of the coding.
//
// The private section is private for a reason: `p()` and `set_p()` wrap
// `stream.cur`, the one global this shares with the bit packer in rc_io.inc,
// and `dec_get` is the only bounds check between a truncated file and a read
// past the end of the buffer.
struct RangeCoder {
  static const uint32_t kTop = 0x00800000;
  static const uint32_t kPend = 0x7F800000;
  static const uint32_t kCarry = 0x80000000;
  static const uint32_t kMask = 0x7FFFFFFF;
  static const uint8_t kMarker = 0x97;

private:
  uint32_t range;
  uint32_t low;
  uint8_t cache;
  uint32_t pending;
  uint32_t rdiv;
  uint32_t bytes;
  uint8_t*p() {
    return stream.cur;
  }

  void set_p(uint8_t* q) {
    stream.cur = q;
  }

  uint8_t dec_get(uint8_t*&q) {
    if( q>=stream.buf+stream.size )
      bmf_fatal(bmf_read_error);
    return *q++;
  }

public:
  void enc_init() {
    range = 0x80000000;
    low = 0;
    pending = 0;
    bytes = 0;
    cache = kMarker;
  }

  void emit(uint32_t carry) {
    uint8_t* q = p();
    *q++ = (uint8_t)(cache+carry);
    for(; pending; --pending )
      *q++ = (uint8_t)(carry-1);
    set_p(q);
    cache = (uint8_t)(low>>23);
  }

  void enc_normalise() {
    while( range<=kTop ) {
      ++bytes;
      if( low<kPend )
        emit(0);
      else if( low&kCarry )
        emit(1);
      else
        ++pending;
      range <<= 8;
      low = (low<<8)&kMask;
    }
  }

  uint32_t encode(uint32_t cum, uint32_t high, uint32_t tot) {
    enc_normalise();
    uint32_t r = range/tot;
    uint32_t below = r*cum;
    uint32_t width = r*(high-cum);
    range = (high<tot) ? width : range-below;
    low += below;
    return width;
  }

  uint32_t encode_bit(uint32_t f0, uint32_t f1, int32_t bit) {
    enc_normalise();
    uint32_t rt = f0*(range/(f0+f1));
    if( bit ) {
      low += rt;
      range -= rt;
    } else {
      range = rt;
    }
    return range;
  }

  void flush() {
    enc_normalise();
    bytes += 5;
    uint32_t len = bytes;
    uint32_t rounded = ((low&0x7FFFFF)>=((len&0xFFFFFF)>>1))+(low>>23);
    uint32_t carry = rounded>0xFF;
    uint8_t* q = p();
    *q++ = (uint8_t)(cache+carry);
    for(; pending; --pending )
      *q++ = (uint8_t)(carry-1);
    *q++ = (uint8_t)rounded;
    *q++ = (uint8_t)(len>>16);
    *q++ = (uint8_t)(len>>8);
    *q++ = (uint8_t)len;
    while( (uint32_t)(q-(uint8_t*)stream.buf)%4!=3 )
      *q++ = 0;
    *q++ = kMarker;
    set_p(q);
    stream.pk.free_bits = 0;
    stream.pk.acc = 0;
    stream.pk.word = (uint32_t*)stream.cur;
  }

  void dec_init() {
    uint8_t* q = p();
    if( dec_get(q)!=kMarker )
      bmf_fatal(bmf_read_error);
    cache = dec_get(q);
    set_p(q);
    range = 128;
    low = cache>>1;
  }

  void dec_normalise() {
    uint8_t* q = p();
    while( range<=kTop ) {
      uint32_t head = (uint32_t)(uint8_t)(cache<<7)|(low<<8);
      cache = dec_get(q);
      low = (cache>>1)|head;
      range <<= 8;
    }
    set_p(q);
  }

  uint32_t get_freq(uint32_t tot) {
    dec_normalise();
    rdiv = range/tot;
    uint32_t count = low/rdiv;
    return (count>=tot) ? tot-1 : count;
  }

  void decode(uint32_t cum, uint32_t high, uint32_t tot) {
    uint32_t below = cum*rdiv;
    low -= below;
    range = (high<tot) ? (high-cum)*rdiv : range-below;
  }

  int32_t decode_bit(uint32_t f0, uint32_t f1) {
    dec_normalise();
    uint32_t rt = f0*(range/(f0+f1));
    if( low>=rt ) {
      range -= rt;
      low -= rt;
      return 1;
    }
    range = rt;
    return 0;
  }

  void finish() {
    dec_normalise();
    uint8_t* q = p();
    while( dec_get(q)!=kMarker ) {}
    set_p(q);
    stream.pk.word = (uint32_t*)stream.cur;
    stream.pk.free_bits = 0;
    stream.pk.acc = 0;
  }
};

// The one coder the program has.
static RangeCoder rc;

// decls.inc -- every function this program defines, declared before any of it is.
//
// This is what lets the include list in bmf.cpp be a reading order instead of a
// dependency order: a body can call anything, wherever it ends up, and a class
// can define its methods in its own body without waiting for what they call.
// Without it the file has exactly one legal order -- the one the decompiler
// emitted -- and every one of these units would have to sit where its callers
// put it.

// Sixteen parameters here used to be named `unread*` or `unused*`, eight of
// them `unread_flag`, and this note used to say why they stayed: that the
// signatures match BMF.exe's and `tools/addrmap.py` keys on that, so dropping
// one would break the correspondence between a name here and an address there.
//
// That was checked and it is not true.  `addrmap.py`'s `DEF` pattern captures
// the identifier before the `(` and stops; it never reads a parameter list.
// The map survives the drop intact, so the trade the note described -- one
// broken correspondence against a saved token -- was not the trade on offer.
//
// So they are gone, by `tools/deadparam.py`, which had to iterate: four of the
// sixteen were not unread but *forwarded*, and a single pass over the list
// removes the leaves and leaves the chain above them looking load-bearing.
//
// The `__` prefix is gone as well, and the reason given for keeping it -- that
// `deadcheck.py`, `unnamed.py` and `addrmap.py` all match on it -- was true of
// the tools and not of the names.  `addrmap.txt` never stored the prefix, so
// the map's keys did not move; `addrmap.py`'s `DEF` pattern still requires
// `__name(`, because what it reads is the donor file's history and that is
// where the prefixed spelling lives.  Only `deadcheck.py`'s pin list and
// `abpair.py`'s pair table named a body directly, and both are one edit.

