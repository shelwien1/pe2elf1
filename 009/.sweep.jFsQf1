        freq->w[5] = w5b;
        lvl_b = nb_sym[2];
        if( s0c<256&&!freq->b14 ) {
          s0c = 256;
          freq->w[6] = 256;
        }
        if( w5b>s0c ) {
          s3a = nb_sym[3];
          if( nb_sym[3]<15 )
            s3a = 15;
          nb_sym[3] = s3a;
          freq->b15 = s3a;
        }
      }
      s3b = nb_sym[3];
      freq->w[5] = nb_sym[3]+w5b;
      freq->w[lvl_b] += s3b;
      rc.decode(arg_cum, arg_high, arg_tot);
      hit = lvl_b;
      freq_tbl->w[5] = freq_tbl->w[lvl_b]++!=0;
      lvl_a = hit;
