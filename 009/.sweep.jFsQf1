// sym_list.inc -- the symbol list: the alphabet, its weights, and the search that
// codes one symbol of it.

struct FreqRec {
  union {
    uint16_t w[8];
    struct {
      uint16_t _w0to6[7];
      uint8_t b14;
      uint8_t b15;
    };
  };

  // Halve the five selector weights and re-sum them into `w[5]`, raising the
  // escape floor and the increment if the halving left them too small.
  //
  // The two pixel bodies wrote this out, thirty lines each, with the five
  // halvings interleaved against each other and three of the locals spilled
  // through the frame -- `frame.sym[0..2]` held `w[6]`, the level and `b15`
  // across the middle of it.  Both copies also re-read `w[5]` afterwards to add
  // `b15`, which is why this returns the new sum instead of only storing it.
  uint16_t rescale(uint16_t escape_floor, uint8_t& kick) {
    for( int32_t i = 0; i<5; ++i )
      w[i] -= w[i]>>1;
    uint16_t sum = (uint16_t)(w[0]+w[1]+w[2]+w[3]+w[4]);
    w[5] = sum;
    if( escape_floor<256&&!b14 ) {
      escape_floor = 256;
      w[6] = 256;
    }
    if( sum>escape_floor&&kick<15 ) {
      kick = 15;
      b15 = kick;
    }
    return sum;
  }
};

#pragma pack(push, 1)
struct SymEntry {
  uint16_t sym;
  uint8_t cnt;
  void set(uint32_t s, uint32_t c) {
    sym = (uint16_t)s;
    cnt = (uint8_t)c;
  }
};
#pragma pack(pop)

struct SymList {
  uint32_t n;
  uint32_t live;
  uint32_t tot;
  uint32_t since_rescale;
  uint32_t rescale_at;
  SymEntry* ent;
  bool rescale(int32_t count) {
    int32_t last_cnt;
    uint32_t n_left, running, since, due = rescale_at;
    SymEntry *prev, *back;
    if( count<=251&&due>=since_rescale )
      return false;
    n_left = live;
    int32_t bias = due<20*n;
    SymEntry *cur = ent-1;
    prev = cur;
    do {
      prev = cur;
      ++cur;
      int32_t half = (bias+(uint32_t)cur->cnt)>>1;
      cur->cnt = half;
      if( cur!=ent ) {
        SymEntry *up = cur-1;
        int32_t up_cnt = up->cnt;
        if( half>up_cnt ) {
          uint16_t keep = cur->sym;
          cur->set(up->sym, up_cnt);
          if( up!=ent ) {
            do {
              back = up-1;
              int32_t back_cnt = back->cnt;
              if( half<=back_cnt )
                break;
              up->set(back->sym, back_cnt);
              --up;
            } while( back!=ent );
          }
          up->set(keep, half);
        }
      }
      --n_left;
    } while( n_left );
    running = tot;
    if( !cur->cnt ) {
      do {
        ++n_left;
        tot = ++running;
        last_cnt = prev->cnt;
        --prev;
      } while( !last_cnt );
      live -= n_left;
    }
    since = since_rescale;
    tot = running-(running>>1);
    since_rescale = since-(since>>1);
    return true;
  }

  int32_t code_symbol(int32_t want) {
    int32_t enc_cum, enc_high, enc_tot;
    uint32_t left;
    uint8_t c_a, c_b;
    SymEntry* p, * head, * q;
    int32_t cum, c, result, c2, top;
    uint16_t s_a, s_b;
    uint32_t rest, i;
    int8_t gen = exclusion_gen;
    left = live;
    p = ent-1;
    cum = 0;
    while( 1 ) {
      ++p;
      int32_t s = p->sym;
      if( exclusion_mask[s]!=exclusion_gen ) {
        c = p->cnt;
        cum += c;
        if( s==want )
          break;
      }
      if( !--left ) {
        if( !cum )
          return 0;
        enc_cum = cum;
        enc_tot = tot+cum;
        enc_high = enc_tot;
        do {
          exclusion_mask[p->sym] = gen;
          --p;
        } while( p>=ent );
        result = 0;
        {
          rc.encode(enc_cum, enc_high, enc_tot);
          return result;
        }
      }
    }
    enc_high = cum;
    rest = left-1;
    enc_cum = cum-c;
    if( rest ) {
      for( i = 0; i<rest; ++i ) {
        if( exclusion_mask[p[i+1].sym]==exclusion_gen )
          c2 = 0;
        else
          c2 = p[i+1].cnt;
        cum += c2;
      }
    }
    enc_tot = tot+cum;
    p->cnt += 4;
    head = ent;
    since_rescale += 4;
    if( p==head ) {
  sorted:
      top = p->cnt;
    } else {
      s_a = p->sym;
      c_a = p->cnt;
      q = p-1;
      *p = *q;
      q->set(s_a, c_a);
      head = ent;
      if( q==head ) {
        top = q->cnt;
      } else {
        while( 1 ) {
          top = q->cnt;
          p = q-1;
          if( top<=p->cnt )
            break;
          s_b = q->sym;
          c_b = q->cnt;
          *q = *p;
          p->set(s_b, c_b);
          head = ent;
          --q;
          if( p==head )
            goto sorted;
        }
      }
    }
    rescale(top);
    result = 1;
    rc.encode(enc_cum, enc_high, enc_tot);
    return result;
  }

  void add_weight(int32_t want, uint32_t add) {
    uint32_t count;
    bool full;
    uint8_t c3, c, c2;
    SymEntry* q, * p, * head;
    uint16_t s3, s, s2;
    int32_t recycled;
    uint32_t n_live, left;
    SymEntry* list = ent;
    n_live = live;
    p = list;
    left = n_live;
    if( n_live ) {
      while( p->sym!=want ) {
        ++p;
        if( !--left )
          goto rescaled;
      }
      p->cnt += add;
      since_rescale += add;
      head = ent;
      if( p==head ) {
  placed:
        count = p->cnt;
      } else {
        s = p->sym;
        c = p->cnt;
        q = p-1;
        *p = *q;
        q->set(s, c);
        head = ent;
        if( q==head ) {
          count = q->cnt;
        } else {
          while( 1 ) {
            count = q->cnt;
            p = q-1;
            if( count<=p->cnt )
              break;
            s2 = q->sym;
            c2 = q->cnt;
            *q = *p;
            p->set(s2, c2);
            head = ent;
            --q;
            if( p==head )
              goto placed;
          }
        }
      }
      rescale(count);
      return;
    } else {
  rescaled:
      full = n_live==n;
      if( n_live>=n ) {
        if( add<=1 )
          return;
        full = n_live==n;
      }
      if( full ) {
        live = --n_live;
        recycled = list[n_live].cnt;
      } else {
        recycled = 1;
      }
      list += n_live;
      live = n_live+1;
      tot = recycled+tot+1;
      list->cnt = 2;
      list->sym = want;
      since_rescale += 4;
      if( list!=ent ) {
        s3 = list->sym;
        c3 = list->cnt;
        *list = list[-1];
        list[-1].set(s3, c3);
      }
    }
  }
  void init(int32_t n_syms, int32_t dense) {
    uint32_t result;
    const uint32_t n_u = (uint32_t)n_syms;
    n = n_syms;
    SymEntry* buf = (SymEntry*)bmf_new(3*n_syms);
    ent = buf;
    if( dense ) {
      tot = 0;
      live = n_u;
      result = 12*n_u;
      since_rescale = 12*n_u;
      rescale_at = 8*n_u;
      if( n_u ) {
        result = 0;
        do {
          ent[result].sym = result;
          ent[result].cnt = 1;
          ++result;
        } while( result<live );
      }
    } else {
      tot = 2;
      rescale_at = 20*n_u;
      live = 0;
      since_rescale = 18*n_u;
      memset(buf, 0, 3*n_u);
    }
    return;
  }
};

struct SymListBlock {
  uint32_t n;
  SymList list[0];
  static uint32_t bytes(uint32_t n) {
    return __builtin_offsetof(SymListBlock, list)+sizeof(SymList)*n;
  }
};

static inline void free_sym_entries(SymList* list, uint32_t n) {
  while( n-- )
    free(list[n].ent);
}

static inline SymListBlock*sym_list_block(SymList* list) {
  return (SymListBlock*)((uint8_t*)list-__builtin_offsetof(SymListBlock, list));
}

static inline uint32_t sym_list_count(const SymList* list) {
  return sym_list_block((SymList*)list)->n;
}

static inline bool sym_in_top(const SymEntry* ent, int32_t n, int32_t sym) {
  while( n-- )
    if( ent[n].sym==sym )
      return true;
  return false;
}

// bitctr.inc -- the binary counters -- one context bit, coded and decoded, and the
// pair rescale behind them.

struct CounterNode {
  uint16_t total;
  uint16_t c[7];

  // Code one symbol against this node.  Defined out of line in sym_code.inc,
  // beside the tree coder it calls; `alt_p1_encode_symbol` and
  // `alt_p1_decode_symbol` are the two instantiations under their callers'
  // names.
  template<int32_t f_DEC> int32_t code_symbol(int32_t ctx, int32_t sym);

  // One counter bumped, with the node's total kept in step.  119 sites in
  // `alt_p1_block`'s `update_model` wrote both halves out, and the increment --
  // one of nine constants, 2 to 17 -- is what that function is *about*: which
  // counters a coded symbol moves, and by how much.
  //
  // The two halves have to move together, because the coder divides by the
  // total; a site that bumped one and not the other would be a defect no type
  // could catch.  As a method there is one place that can be wrong.
  void bump(int32_t slot, uint32_t n) {
    c[slot] += n;
    total += n;
  }

  // The 64-wide stride the escape's context is shifted by: 0 when this slot
  // holds at least half the node's mass, -64 when it does not.  `>>25` on a
  // value that fits in 16 bits is a sign test, and `&0xFFFFFFC0` turns the
  // resulting 0 or -1 into 0 or -64.
  //
  // `alt_p1_block` spelled this out four times, twice reading `total` from a
  // local holding the value just stored into it.  Same value, three lines
  // apart.
  uint32_t escape_bias(int32_t slot) const {
    return (((total&0x7FFF)+c[0]-2*(uint32_t)c[slot])>>25)&0xFFFFFFC0;
  }
};

struct SymPair {
  uint16_t last;
  uint16_t prev;
};

struct FreqPair {
  uint16_t f[2];
};

static inline FreqPair*bit_tree(uint16_t* freq, int32_t lvl) {
  return (FreqPair*)&freq[2*level_geom[lvl].tbl_base+8];
}

// One binary counter with a parent to fall back on, and a three-state life:
// unseen, seeded, live.  Read against `bcdr.cpp`'s `BIN_CODER`, which is the
// same counter with the same states written by hand -- the two agree line for
// line and only the constants differ, so the names below are that file's.
//
//   BIN_CODER::s[2]     n[2]        the two counts
//   BIN_CODER::MaxFreq  limit       the total at which they are halved
//   STEP = 10           kStep = 8   what a coded bit adds
//   scaleRare()         scale_rare()
//   initChild(bc)       seed_from(parent)
//   process(rc,bc,..)   code_context_bit<f_DEC>(parent, bit)
//
// The one structural difference is where the "seen once" mark lives.
// `BIN_CODER` marks itself unseeded with `MaxFreq == 0` and remembers the
// first bit in `s[1]`; this remembers it in `n[0]` as `bit + 1` and reads
// `n[1] == 0` as "not seeded yet".  Same machine, one slot over -- which is
// worth knowing, because `n[0]` is a *count* in the live state and a
// *remembered bit* before it, and nothing in the decompilation said so.
struct BitCtr {
  uint16_t n[2];
  uint16_t limit;

  // BIN_CODER's STEP, 8 here against its 10, and the same three uses: what a
  // coded bit adds, half of it as the seeding bump, and the ceiling below
  // which the parent is bumped too.
  static const uint32_t kStep = 8;
  static const uint32_t kSeedBump = 4;
  static const uint32_t kSeedLimit = 512;
  static const uint32_t kLimitStep = 64;
  static const uint32_t kMaxLimit = 0x4000;
  static const uint32_t kParentBump = 0x88;

  uint32_t summ() const {
    return n[0]+n[1];
  }

  // `BIN_CODER::initParent`: both sides at half a step, under a low ceiling,
  // so the first few bits move it a long way.  What `esc_ctr[0]` and every
  // `run_ctr[]` start as.
  void init_parent() {
    n[0] = n[1] = kStep/2;
    limit = 72;
  }

  // A root of the escape tree, which does not start even: 40 against 16 is
  // five to two toward "no", at the same ceiling `seed_from` hands a child.
  void init_root() {
    n[0] = 40;
    n[1] = 16;
    limit = kSeedLimit;
  }

  // And the third state has no initialiser at all: a counter is *unseen* when
  // it is all zeroes, which is why `bit_node[]` and `esc_ctr[1..]` are simply
  // memset.  bcdr does the same with `memset(BCdr2, 0, sizeof(BCdr2))`.

  // `BIN_CODER::scaleRare`.  Halve both counts and let the limit climb, so a
  // counter that keeps being right is allowed to get more confident before it
  // is cut back again.  `rescale_counter_pair` is this, called from the run
  // coder, and is now the same code rather than a second copy of it.
  int32_t scale_rare() {
    n[0] -= n[0]>>1;
    n[1] -= n[1]>>1;
    if( limit<kMaxLimit )
      limit += kLimitStep;
    return limit;
  }

  // `BIN_CODER::initChild`.  A counter seen once takes its parent's shape
  // scaled to 64 -- `(64 * (parent - 1) + total) / total` on each side, which
  // is bcdr's formula with 32 -- bumps the side the first bit went, and takes
  // the parent's confidence down by 3 for having handed it over.
  void seed_from(BitCtr* parent) {
    const int32_t first = n[0]-1;
    const int32_t par0 = parent->n[0];
    const int32_t par_tot = par0+parent->n[1];
    n[0] = (par_tot+(par0<<6)-64)/par_tot;
    n[1] = ((parent->n[1]<<6)+par_tot-64)/par_tot;
    n[first] += kSeedBump;
    limit = kSeedLimit;
    const int32_t par_n = parent->n[first];
    parent->n[first] = par_n-3*(par_n>3);
  }

  // The two returns are not the same value and that is not a merge artefact:
  // the encoder returned the counter it had just bumped and the decoder
  // returns the bit.  Nothing reads the encoder's, both call sites drop it,
  // and it is kept anyway -- a merge is not the place to decide that a return
  // value is dead.
  template<int32_t f_DEC>
  int32_t code_context_bit(BitCtr* parent, int32_t bit) {
    int32_t result;
    if( n[0] ) {
      if( !n[1] )
        seed_from(parent);
      const uint32_t tot = summ();
      if( f_DEC )
        bit = rc.decode_bit(n[0], n[1]);
      else
        rc.encode_bit(n[0], n[1], bit);
      if( tot>limit )
        scale_rare();
      result = n[bit]+kStep;
      n[bit] = result;
      // `BIN_CODER`'s "kinda partial update": while this counter is still
      // cheap to be wrong about, the parent hears about the bit as well.
      parent->n[bit] += tot<kParentBump;
    } else {
      // Unseen.  The parent codes the bit, and this keeps it as `bit + 1` so
      // the next visit knows which side to bump when it seeds.
      const uint32_t p_tot = parent->summ();
      if( f_DEC )
        bit = rc.decode_bit(parent->n[0], parent->n[1]);
      else
        rc.encode_bit(parent->n[0], parent->n[1], bit);
      if( p_tot>parent->limit )
        parent->scale_rare();
      result = parent->n[bit]+kStep;
      parent->n[bit] = result;
      n[0] = bit+1;
    }
    return f_DEC ? bit : result;
  }

  int32_t encode_context_bit(BitCtr* parent, int32_t bit) {
    return code_context_bit<0>(parent, bit);
  }

  int32_t decode_context_bit(BitCtr* parent) {
    return code_context_bit<1>(parent, 0);
  }
};

CounterNode*init_counter_node(CounterNode* node) {
  node->c[0] = 8;
  node->c[1] = 2;
  node->c[2] = 2;
  node->c[3] = 2;
  node->c[4] = 2;
  node->c[5] = 3;
  node->c[6] = 3;
  node->total = 22;
  return node;
}

// alt_p1_block.inc -- the alternate model for predictor 1: its block, its context
// and its counters.  "p1" is `plane_predictor == 1` and says nothing about depth --
// measured, this codes t24's and t32's *eight-bit* planes.  MODELS.md section 6.

struct CtxWeight {
  int32_t sel;
  uint32_t w[3];
};

struct P1Ctx {
  uint8_t sym;
  uint8_t mag;
};

// Two shapes `ctx_of` builds from a *neighbouring plane's* row, each of which
// it used in more than one of its three arms.
//
//   `cross_grad`  this plane's west-minus-prediction plus that plane's own
//                 gradient over its last two samples.
//   `nb_resid`    that plane's residual at the sample to the west.
static inline int32_t cross_grad(int32_t here, int32_t guess, const AltP1Block* nb);
static inline int32_t nb_resid(const AltP1Block* nb);

struct AltP1Block {
  int32_t width;
  int32_t height;
  int32_t pred;
  int32_t ctx[5];
  CtxWeight ctx_w[9];
  P1Ctx* buf[5];
  P1Ctx* cursor[5];
  uint8_t level_of[512];
  uint8_t slot_of[256];
  uint8_t fold[256];
  uint8_t fold_hi[256];
  uint8_t unfold[256];
  int32_t group_of[512];
  CounterNode counters[629856];
  // Start a row: mirror the last six records past the right edge, rotate the
  // five row buffers by one, reseat the five cursors, carry the last record of
  // the row above into the left margin, mirror three records back from it, and
  // rebuild the two activity sums the context reads.
  //
  // Twenty-five lines, written out three times -- here, in `alt_p1_code.inc`
  // and in `alt_p1.inc` -- because in the decompilation each of the three
  // callers had its own copy of the loop.
  //
  // The two activity sums that follow it stay at the call sites, because they
  // are *not* the same at all three: `alt_p1_code`'s reads the two mirrored
  // records' magnitudes through `(int8_t)` and the other two read them as the
  // `uint8_t` they are declared.  Whether that difference can ever show is a
  // question about how large a residual magnitude gets, and it is not one this
  // extraction needed to answer.
  void advance_row() {
    {
      P1Ctx*const here = cursor[0];
      for( int32_t k = 0; k<6; ++k )
        here[k] = here[-1-k];
    }
    ring_advance(buf, cursor, 4);
    cursor[0][-4] = cursor[1][3];
    {
      P1Ctx*const here = cursor[0];
      P1Ctx*const up = cursor[1];
      here[-3] = up[2];
      here[-2] = up[1];
      here[-1] = up[0];
    }
  }

  int32_t ctx_of(AltP1Block* nb0, AltP1Block* nb1) {
    bool pick, is_zero, is_neg;
    int32_t act_all;
    uint32_t quiet;
    int32_t guess;
    P1Ctx *cursor1 = cursor[1];
    guess = cursor1->sym;
    P1Ctx *cur = cursor[0];
    int32_t west = cur[-1].sym;
    int32_t northwest = cursor1[-1].sym;
    if( west<guess ) {
      if( northwest>=west ) {
        int32_t plane_b = guess+west-northwest;
        pick = northwest<guess;
        guess = cur[-1].sym;
        if( pick )
          guess = plane_b;
      }
    } else if( northwest<=west ) {
      int32_t plane_a = guess+west-northwest;
      pick = northwest<=guess;
      guess = cur[-1].sym;
      if( !pick )
        guess = plane_a;
    }
    pred = guess;
    P1Ctx *cursor2 = cursor[2];
    int32_t act = cursor1[-1].mag+cur[-3].mag+3*(cursor1[1].mag+cursor2->mag)+6*cur[-1].mag+4*(cursor1->mag+cur[-2].mag)+2*(cursor2[2].mag+cursor1[2].mag+cur[-4].mag);
    // The five selectors below this point are the ones that depend on how many
    // *other planes* this one has to look at -- two, one, or none.  The three
    // arms are genuinely three formulas and not one formula three times, but
    // four shapes recur across them and are named here rather than spelled out
    // seven times between them.
    //
    // `west_grad` and `north_grad` are computed unconditionally: both are pure
    // reads of this plane's own row, and each appeared in two of the three
    // arms.
    const int32_t west_grad = 2*cur[-1].sym-cur[-2].sym-(uint32_t)guess;
    const int32_t north_grad = -guess-cursor1->sym+cursor1[1].sym+cur[-1].sym;
    if( nb0 ) {
      const P1Ctx* r0 = nb0->cursor[0];
      if( nb1 ) {
        const P1Ctx* r1 = nb1->cursor[0];
        act_all = act+2*(r1[-1].mag+r0[-1].mag);
        ctx_w[5].sel = cursor1->sym-(uint32_t)guess+r0[-1].sym-nb0->cursor[1][-1].sym;
        ctx_w[6].sel = cross_grad(cur[-1].sym, guess, nb0);
        ctx_w[7].sel = cross_grad(cur[-1].sym, guess, nb1);
        ctx_w[8].sel = nb_resid(nb1);
        ctx_w[3].sel = nb_resid(nb0);
        quiet = (r1[-1].mag+r0[-1].mag<16);
      } else {
        act_all = cursor1[3].mag+act+3*r0[-1].mag;
        ctx_w[5].sel = west_grad;
        ctx_w[6].sel = west_grad;
        ctx_w[7].sel = north_grad;
        ctx_w[8].sel = cross_grad(cur[-1].sym, guess, nb0);
        ctx_w[3].sel = nb_resid(nb0);
        quiet = (r0[-1].mag<8);
      }
    } else {
      P1Ctx *cursor4 = cursor[4];
      act_all = cursor4->mag+cursor2[-2].mag+cursor1[3].mag+act+cursor4[2].mag;
      ctx_w[5].sel = west_grad;
      ctx_w[6].sel = 2*cursor1->sym-cursor2->sym-(uint32_t)guess;
      ctx_w[7].sel = north_grad;
      ctx_w[8].sel = -3*(cur[-2].sym-cur[-1].sym)+cur[-3].sym-(uint32_t)guess;
      ctx_w[3].sel = cursor1[2].sym-(uint32_t)guess;
      quiet = cur->mag+cursor4->mag+cursor[3]->mag+cursor2->mag+cursor1->mag==0;
    }
    int32_t act_q = (act_all+7)>>4;
    int32_t act_lvl = level_of[act_q];
    int32_t step = p1_level_step[(uint32_t)act_lvl];
    ctx[0] = act_lvl;
    ctx[1] = group_of[act_q]+slot_of[(uint32_t)guess];
    // The same expression twice in the decompilation, once into the slot and
    // once into the index that reads it.  The other eight slots need both --
    // `ctx_w[N].sel` is overwritten further down while `sN` keeps the index --
    // but nothing overwrites slot 0's.
    ctx_w[0].sel = (guess>216)+(guess>22);
    uint32_t s0 = ctx_w[0].sel;
    int32_t s1 = (cursor1[-1].sym-cursor1->sym>=0)+(cursor1[-1].sym>(int32_t)cursor1->sym);
    ctx_w[1].sel = s1;
    int32_t s2 = (cursor1[-1].sym-cur[-1].sym>=0)+(cursor1[-1].sym>(int32_t)cur[-1].sym);
    ctx_w[2].sel = s2;
    is_zero = ctx_w[3].sel==0;
    is_neg = ctx_w[3].sel<0;
    int32_t s4 = (cursor1[1].sym-guess>=-step)+(cursor1[1].sym-guess>step);
    ctx_w[4].sel = s4;
    int32_t hi = step<ctx_w[5].sel;
    int32_t lo = -step<=ctx_w[5].sel;
    int32_t s3 = !is_neg+(!is_neg&&!is_zero);
    ctx_w[3].sel = s3;
    int32_t s5 = lo+hi;
    is_zero = ctx_w[6].sel==0;
    is_neg = ctx_w[6].sel<0;
    ctx_w[5].sel = s5;
    int32_t g6 = !is_neg&&!is_zero;
    int32_t h6 = !is_neg;
    is_zero = ctx_w[7].sel==0;
    is_neg = ctx_w[7].sel<0;
    int32_t s6 = h6+g6;
    ctx_w[6].sel = h6+g6;
    int32_t g7 = !is_neg&&!is_zero;
    int32_t h7 = !is_neg;
    is_zero = ctx_w[8].sel==0;
    is_neg = ctx_w[8].sel<0;
    int32_t s7 = h7+g7;
    ctx_w[7].sel = h7+g7;
    int32_t s8 = !is_neg+(!is_neg&&!is_zero);
    ctx_w[8].sel = s8;
    int32_t result = ctx_w[0].w[s0]+ctx_w[1].w[s1]+ctx_w[2].w[s2]+ctx_w[3].w[s3]+ctx_w[4].w[s4]+ctx_w[5].w[s5]+ctx_w[6].w[s6]+ctx_w[7].w[s7]+ctx_w[8].w[s8]+16*quiet+8*(ctx[3+ctx[2]]==0)+act_lvl;
    ctx[0] = result;
    return result;
  }

  void d8_encode_body(uint8_t* src, uint8_t* out) {
    int32_t code;
    rc_begin_encode();
    if( height>0 ) {
      int32_t y = 0;
      do {
        ++y;
        advance_row();
        {
          P1Ctx *row0 = cursor[0], *row2 = cursor[2], *row4 = cursor[4];
          ctx[2] = 0;
          ctx[3] = row2[-2].mag+row4[-2].mag+row2[0].mag+row4[0].mag+row2[2].mag+row4[2].mag+row2[4].mag+row4[4].mag+row0[-4].mag+row0[-2].mag;
          ctx[4] = row2[-1].mag+row4[-1].mag+row2[1].mag+row4[1].mag+row2[3].mag+row4[3].mag+row2[5].mag+row4[5].mag+row0[-3].mag+row0[-1].mag;
        }
        if( !(width<=0) ) {
          uint8_t* q = out;
          int32_t x = 0;
          do {
            ++x;
            ctx_of(nullptr, nullptr);
            uint8_t guess = (uint8_t)pred;
            int32_t resid = (uint8_t)(*src-guess);
            uint8_t recon = *(fold[resid]+unfold)+guess;
            code = fold[resid];
            int32_t drift = (uint8_t)*q-(uint8_t)(recon+*q-*src);
            if( drift<-16||drift>16 ) {
              *q = *src;
              code = fold_hi[resid];
            } else {
              *q = recon;
            }
            alt_p1_encode_symbol(&counters[ctx[0]], ctx[1], code);
            int32_t val = (uint8_t)*q;
            int32_t err = val-pred;
            cursor[0]->sym = val;
            cursor[0]->mag = abs32(err);
            ctx[3+ctx[2]] = ctx[3+ctx[2]]+cursor[0]->mag-cursor[0][-4].mag-(cursor[4][-2].mag-cursor[4][6].mag+cursor[2][-2].mag-cursor[2][6].mag);
            ctx[2] = ctx[2]==0;
            if( counters[ctx[0]].total<0x4000u )
              update_model();
            ++cursor[0];
            ++q;
            ++cursor[1];
            ++cursor[2];
            ++cursor[3];
            ++cursor[4];
            ++src;
          } while( x<width );
          out = q;
        }
      } while( (uint32_t)y<(uint32_t)height );
    }
    rc_end_encode();
  }

  // One selector's counters, and there are nine of them -- `ctx_w[0]` through
  // `ctx_w[8]`.  The decompilation wrote all nine out, which is why
  // `update_model` was 406 lines: about 360 of them are these forty, nine
  // times over, differing only in which `ctx_w` they read and which locals
  // they spelled the intermediate values into.
  //
  // `sel` names which of the three weights is the live one.  At `sel == 1` the
  // update walks the other two symmetrically.  Otherwise it walks three
  // counters: the opposite weight, the middle one, and an alternate context
  // built from two of the three -- and *which* two is the one thing across the
  // nine that is not uniform.  Slot 0 names `w[0]` and `w[1]` where the other
  // eight name `w[1]` and `w[2-sel]`.
  //
  // That is the same one-weight shift `ctx_alt` shows: its slot-0 term reads
  // `w[1]` where every other term reads `w[2-sel]`.  So the pair is a
  // parameter, not a special case invented to make the loop close.
  void update_selector(int32_t k, int32_t slot_f, int32_t slot_r,
                       uint32_t ctx_alt, int32_t alt_lo, int32_t alt_hi) {
    const CtxWeight& cw = ctx_w[k];
    const int32_t sel = cw.sel;
    // Every block re-read `ctx[0]` after each pair of bumps, into a local of
    // its own -- `ctx0`, `ctx1`, ... `ctx8`, which is where those names came
    // from.  Nothing here writes `ctx`; the re-reads are MSVC spilling a
    // register, and the ninth of them was the value the function returned.
    const int32_t here = ctx[0];
    if( sel==1 ) {
      int32_t mid = here-cw.w[1];
      CounterNode *lo = &counters[mid+cw.w[0]];
      CounterNode *hi = &counters[cw.w[2]+mid];
      lo[0].bump(slot_f, 6);
      hi[0].bump(slot_f, 6);
      if( (here&7)!=7 ) {
        lo[1].bump(slot_f, 4);
        hi[1].bump(slot_f, 4);
      }
      if( here&7 ) {
        lo[-1].bump(slot_f, 3);
        hi[-1].bump(slot_f, 3);
      }
    } else {
      counters[cw.w[2-sel]+here-cw.w[sel]].bump(slot_f, 7);
      CounterNode *mid = &counters[cw.w[1]+here-cw.w[sel]];
      CounterNode *alt = &counters[ctx_alt+cw.w[alt_lo]-cw.w[alt_hi]];
      mid[0].bump(slot_f, 6);
      alt[0].bump(slot_r, 4);
      if( (here&7)!=7 ) {
        mid[1].bump(slot_f, 4);
        alt[1].bump(slot_r, 2);
      }
      if( here&7 ) {
        mid[-1].bump(slot_f, 3);
        alt[-1].bump(slot_r, 2);
      }
    }
  }

  // Returned `ctx[0]` -- or, if the ninth selector's last branch ran, a counter
  // it had just bumped.  All five call sites discard it.
  void update_model() {
    int32_t slot_f, slot_r;
    uint32_t code_f = *((uint8_t)(cursor[0]->sym-(uint8_t)pred)+fold);
    int32_t code_r = *((uint8_t)((uint8_t)pred-cursor[0]->sym)+fold);
    int32_t tree_sym = (int32_t)(code_f-5)>>1;
    slot_f = 6-(code_f&1);
    if( code_f<5 )
      slot_f = *((uint8_t)(cursor[0]->sym-(uint8_t)pred)+fold);
    slot_r = 6-(code_r&1);
    if( code_r<5 )
      slot_r = code_r;
    // `ctx_w[1].sel` and `ctx_w[2].sel` were read into `sel1_top`/`sel2_top`
    // eight lines above this sum, which made two of its nine terms look unlike
    // the other seven.  Nothing between the read and the use touches `ctx_w`.
    uint32_t ctx_alt = ctx[0]&0x1F;
    for( int32_t k = 8; k>=1; --k )
      ctx_alt += ctx_w[k].w[2-ctx_w[k].sel];
    ctx_alt += ctx_w[0].w[1];
    CounterNode *node_alt = &counters[ctx_alt];
    node_alt[0].bump(slot_r, 17);
    const int32_t result = ctx[0];
    if( (result&7)!=7 ) {
      CounterNode *node_up = &counters[result];
      uint32_t ctx_up = ((ctx[1]&7)<7)+ctx[1];
      node_up[1].bump(slot_f, 11);
      if( slot_f>=5 )
        update_binary_pair(model_strip(128*(slot_f&1)+ctx_up+node_up[1].escape_bias(slot_f)), (int32_t)(code_f-5)>>1);
    }
    if( result&7 ) {
      CounterNode *node_dn = &counters[result];
      int32_t ctx_dn = ctx[1]-((ctx[1]&7)!=0);
      node_dn[-1].bump(slot_f, 13);
      if( slot_f>=5 )
        update_binary_pair(model_strip(128*(uint32_t)(slot_f&1)+(uint32_t)ctx_dn+node_dn[-1].escape_bias(slot_f)), tree_sym);
    }
    if( counters[result].total<0xCCCu ) {
      if( (result&7u)<7 ) {
        node_alt[1].bump(slot_r, 7);
      }
      if( result&7 ) {
        node_alt[-1].bump(slot_r, 5);
      }
      if( slot_f>=5 ) {
        uint32_t bias = counters[result].escape_bias(slot_f);
        uint32_t key = ctx[1]+bias+((slot_f&1)<<7);
        if( (key&0x38)>=0x38||(update_binary_pair(model_strip(128*(slot_f&1)+ctx[1]+bias+8), tree_sym), (key&0x38)!=0) ) {
          update_binary_pair(model_strip(key-8), tree_sym);
        }
      }
      // The nine selectors.  `update_selector` is what the decompilation
      // wrote out nine times.
      update_selector(0, slot_f, slot_r, ctx_alt, 0, 1);
      for( int32_t k = 1; k<9; ++k )
        update_selector(k, slot_f, slot_r, ctx_alt, 1, 2-ctx_w[k].sel);
    }
  }

  AltP1Block*alt_p1_alloc(int32_t img_w, int32_t img_h, int32_t plane) {
    int32_t lvl, grp, slot, wid;
    uint32_t ctr = 0;
    width = img_w;
    height = img_h;
    do
      init_counter_node(&counters[ctr++]);
    while( ctr<0x99C60 );
    pred = 0;
    lvl = 0;
    grp = 0;
    int32_t k = 0;
    int32_t plane_hi = plane<<8;
    do {
      level_of[2*k] = lvl;
      int32_t lvl1 = (2*k==p1_level_edges[lvl])+lvl;
      group_of[2*k] = plane_hi|grp;
      level_of[2*k+1] = lvl1;
      int32_t odd = 2*k+1;
      int32_t grp1 = (2*k==p1_group_edges[grp])+grp;
      lvl = (odd==p1_level_edges[lvl1])+lvl1;
      group_of[2*k+1] = grp1|plane_hi;
      grp = (odd==p1_group_edges[grp1])+grp1;
      ++k;
    } while( (uint32_t)k<0x100 );
    uint32_t pair = 0;
    slot = 0;
    do {
      slot_of[2*pair] = 8*slot;
      int32_t slot1 = (2*pair==p1_slot_edges[slot])+slot;
      slot_of[2*pair+1] = 8*slot1;
      int32_t bump = 2*pair+++1==p1_slot_edges[slot1];
      slot = bump+slot1;
    } while( pair<0x80 );
    ctx_w[0].w[1] = 32;
    ctx_w[8].w[0] = 0;
    ctx_w[7].w[0] = 0;
    ctx_w[0].w[2] = 64;
    ctx_w[6].w[0] = 0;
    ctx_w[5].w[0] = 0;
    ctx_w[4].w[0] = 0;
    ctx_w[1].w[1] = 96;
    ctx_w[3].w[0] = 0;
    ctx_w[2].w[0] = 0;
    ctx_w[1].w[0] = 0;
    ctx_w[1].w[2] = 192;
    ctx_w[0].w[0] = 0;
    uint32_t row = 0;
    ctx_w[2].w[1] = 288;
    ctx_w[2].w[2] = 576;
    ctx_w[3].w[1] = 864;
    ctx_w[3].w[2] = 1728;
    ctx_w[4].w[1] = 2592;
    ctx_w[4].w[2] = 5184;
    ctx_w[5].w[1] = 7776;
    ctx_w[5].w[2] = 15552;
    ctx_w[6].w[1] = 23328;
    ctx_w[6].w[2] = 46656;
    ctx_w[7].w[1] = 69984;
    ctx_w[7].w[2] = 139968;
    ctx_w[8].w[1] = 209952;
    ctx_w[8].w[2] = 419904;
    do
      buf[row++] = (P1Ctx*)bmf_new(sizeof(P1Ctx)*(width+10));
    while( row<5 );
    alt_init_tables(fold, (int8_t*)unfold);
    wid = width;
    if( width>-10 ) {
      int32_t r = 0;
      do {
        buf[4][r].sym = 72;
        buf[3][r].sym = 72;
        buf[2][r].sym = 72;
        buf[1][r].sym = 72;
        buf[0][r].sym = 72;
        buf[4][r].mag = 0;
        buf[3][r].mag = 0;
        buf[2][r].mag = 0;
        buf[1][r].mag = 0;
        buf[0][r].mag = 0;
        wid = width;
        ++r;
      } while( r<width+10 );
    }
    cursor[0] = buf[0]+wid+4;
    cursor[1] = buf[1]+wid+4;
    cursor[2] = buf[2]+wid+4;
    cursor[3] = buf[3]+wid+4;
    cursor[4] = buf[4]+wid+4;
    return this;
  }

  // Returns nothing.  The original returned `this` -- a compiler's habit of
  // leaving the object pointer in the return register, not a value anyone
  // wanted -- and after the `free(this)` above it is a dangling pointer that
  // g++ reports under `-Wuse-after-free`.  All three call sites discarded it;
  // the one that did not, `alt_model_p1_d8_decode`, only passed it on to
  // another caller that did.
  void alt_p1_free(int8_t do_free) {
    for( int32_t k = 0; k<5; ++k )
      free(buf[k]);
    if( do_free&1 )
      free(this);
  }
};

static inline int32_t cross_grad(int32_t here, int32_t guess, const AltP1Block* nb) {
  const P1Ctx* r = nb->cursor[0];
  return here-(uint32_t)guess+r[-1].sym-r[-2].sym;
}

static inline int32_t nb_resid(const AltP1Block* nb) {
  return nb->cursor[0][-1].sym-nb->pred;
}

// alt_p2_block.inc -- the alternate model for predictor 2: its counters, its frequency
// records and the block they live in.

struct P2Count {
  int8_t rate;
  uint8_t b1;
  int16_t weighted;
};

struct P2Freq {
  uint16_t step;
  uint16_t f[3];
  uint32_t rescale_three_way() {
    uint32_t cut;
    f[0] -= f[0]>>1;
    f[1] -= f[1]>>1;
    cut = f[2]>>1;
    f[2] -= cut;
    uint32_t budget = step;
    if( budget<=0x100 ) {
      if( step<=0x20u )
        cut = ((16-budget)>>30)&0xFFFFFFFE;
      else
        cut = 32;
      step = budget-cut;
    } else {
      step >>= 1;
    }
    return cut;
  }

  // One symbol of the deep model's three-way counter, and then the tree.  The
  // encoder is handed a symbol and picks the slot it names; the decoder is
  // handed a point in the range and finds the slot containing it.  They agree
  // on `idx = slot - base`, which is what makes the tail one piece of code:
  // slot 0 is the symbol, and slots 1 and 2 escape into the level tree with
  // `idx & 1` choosing the context and `idx` the parity of what comes back.
  //
  // The encoder said `ctx_pair[sym & 1]` and `(sym - 1) >> 1` where this says
  // `ctx_pair[idx & 1]`; they are the same, because `idx` is 1 for odd symbols
  // and 2 for even ones above zero.
  // Named apart from `SymList::code_symbol`, which is a different coder in a
  // different model.  Two methods with one name is not an error the compiler
  // can see, and it made `unstale.py` measure the wrong one.
  template<int32_t f_DEC>
  int32_t code_three_way(const uint32_t* ctx_pair, int32_t sym) {
    uint16_t f_before;
    uint32_t cum;
    uint16_t st, *slot;
    uint16_t down;
    uint16_t *base = &f[0];
    int32_t c01 = f[1]+f[0];
    uint32_t tot = c01+f[2];
    if( f_DEC ) {
      int32_t target = rc.get_freq(tot);
      cum = f[0];
      if( (uint32_t)target>=cum ) {
        if( target>=c01 ) {
          cum = c01;
          slot = &f[2];
        } else {
          slot = &f[1];
        }
      } else {
        cum = 0;
        slot = &f[0];
      }
    } else {
      cum = c01;
      if( sym ) {
        if( sym&1 ) {
          cum = f[0];
          slot = &f[1];
        } else {
          slot = &f[2];
        }
      } else {
        cum = 0;
        slot = &f[0];
      }
    }
    uint32_t tot_1 = cum+*slot;
    if( f_DEC )
      rc.decode(cum, tot_1, tot);
    else
      rc.encode(cum, tot_1, tot);
    f_before = *slot;
    if( *slot>0x4000u ) {
      uint32_t f1_old = f[1];
      uint32_t f2_old = f[2];
      f[0] -= f[0]>>1;
      f[1] = f1_old-(f1_old>>1);
      f[2] = f2_old-(f2_old>>1);
      st = step;
      if( st<=256 ) {
        if( st<=32 )
          down = ((uint32_t)(16-st)>>30)&0xFFFFFFFE;
        else
          down = 32;
        st = st-down;
        step = st;
        f_before = *slot;
      } else {
        st = (uint32_t)st>>1;
        step = st;
        f_before = *slot;
      }
    } else {
      st = step;
    }
    *slot = st+f_before;
    int32_t idx = slot-base;
    if( idx )
      return idx+2*code_symbol_tree<f_DEC>(model_strip(ctx_pair[idx&1]), (sym-1)>>1);
    return 0;
  }

  void encode_symbol(const uint32_t* ctx_pair, int32_t sym) {
    code_three_way<0>(ctx_pair, sym);
  }

  int32_t decode_symbol(const uint32_t* ctx_pair) {
    return code_three_way<1>(ctx_pair, 0);
  }
};

static inline int32_t p2_pred(int32_t weighted, int32_t rate) {
  return (weighted+(1<<((rate+31)&31)))>>(rate&31);
}

static inline int16_t p2_bump(int32_t w2, int32_t err, int32_t shift) {
  const uint32_t kick = 32u*(uint32_t)((err>deadzone_hi)-(err<deadzone_lo));
  return (int16_t)((uint32_t)w2+((kick+(uint32_t)err+(1u<<(shift-1)))>>shift));
}

// One counter update: predict from the weight, bump it by how wrong that was.
// 115 of `alt_p2_model`'s 117 `p2_bump` sites were these three statements
// written out, with a pair of temporaries each.
//
// Eight of those 115 read the rate as `*(uint8_t*)&p->rate`, and `rate` is
// `int8_t` -- so they took the byte unsigned where this takes it signed.  That
// is the same value here and only here: `p2_pred` uses the rate as two shift
// counts and masks both with `&31`, and the two readings differ by 256, which
// is a multiple of 32.
static inline void p2_update(P2Count* p, int32_t res, int32_t shift) {
  const int32_t w = p->weighted;
  p->weighted = p2_bump(w, res-p2_pred(w, p->rate), shift);
}

// The same counter, updated in place at a fixed shift of 2 and *without*
// `p2_bump`'s dead-zone kick.  21 sites fold it into one `+=` on the next
// counter in the bank; the rounding term is the only thing they share with
// `p2_update`, and folding them together would put the kick where the original
// has none.
// One count of a three-way record, bumped by `num` sixteenths of the record's
// step, with the rescale that keeps the three counts from overflowing.  35 of
// the 41 sites in `alt_p2_model` wrote both steps out.
//
// It takes the numerator rather than the increment because `rescale_three_way`
// steps `step` down as well as halving the counts, and the bump reads `step`
// *after* it.  Passing a computed increment would read it before.
//
// The increments in the file are 2, 3, 4, 5, 6, 7, 10 and 13 sixteenths and
// nothing else, which is only visible once they are written as sixteenths:
// `(step&0xFFFC)>>2` and `(step&0xFFF8)>>3` are `(4*step)>>4` and `(2*step)>>4`,
// the masks clearing bits the shift discards anyway.
// The rescale on its own.  Two of `alt_p2_model`'s fifty sites compute the
// increment and then add it *conditionally*, so the add cannot move into the
// helper; the guard still can.
static inline void p2_rescale(P2Freq* r) {
  if( r->f[0]+r->f[1]+r->f[2]>29696 )
    r->rescale_three_way();
}

static inline void p2_freq_add(P2Freq* r, int32_t slot, uint32_t num) {
  p2_rescale(r);
  r->f[slot] += (num*(uint32_t)r->step)>>4;
}

static inline void p2_nudge(P2Count* p, int32_t res) {
  // Sixteen bits in and sixteen bits out, through `uint16_t` so that the
  // wrap is defined rather than signed overflow.
  p->weighted = (int16_t)((uint16_t)p->weighted+((uint32_t)(res-p2_pred(p->weighted, p->rate)+2)>>2));
}

struct P2Ctx {
  int16_t val;
  int16_t dval;
  int16_t err;
  int16_t aerr;
  int16_t dleft;
  int16_t dup;
  int16_t dupleft;
  int16_t dupright;
  uint8_t sign;
  uint8_t mag;
};

// One row of the neighbour-weight bank.
//
// Lines 0..6 are the filter taps, 7..13 the running mean square of each tap's
// input -- which is what makes it *normalised* least mean squares -- and 14
// three scalars the two halves share.  Line 15 is a count of the samples this
// row has seen, and the original kept it in the first of that line's four
// `float` slots.
//
// It was a `float[16][4]` and the count was reached by casting: through a
// `uint32_t*` at one site and an `int32_t*` at the other, which is two answers
// to what the type is.  A `memcpy` accessor made that defined; a member makes
// it unnecessary.  Same 256 bytes, same offsets, and `-Wstrict-aliasing` has
// nothing left to say about it.
struct NbRow {
  float w[15][4];
  uint32_t uses;
  uint32_t _pad[3];
  int32_t predict(float (*nb)[4], CtxWeights* sets, int32_t mode);
};

static_assert(sizeof(NbRow) == 16*4*sizeof(float),
              "NbRow replaces a float[16][4] and has to be the same size");
static_assert(offsetof(NbRow, uses) == 15*4*sizeof(float),
              "the use count is the first slot of line 15");

// `bmf_p2_coef` and `bmf_p2_rate` read like tuning constants and are not: for
// the length of one image the model borrows them.  Rows 4..6 of the
// coefficients -- the cross-plane terms -- fold into rows 0..2 and are zeroed,
// three rate rows go to the reset value, and all of it goes back at the end.
//
// Both directions do it, in the same six lines each, 300 lines apart from the
// six that undo them.  Filing the two tables with the genuine constants would
// make the non-d8 path's behaviour inexplicable, so they are named as what
// they are: a session, folded at the top of an image and restored at the
// bottom.  Explicitly, not by a destructor -- the restore sits before the
// plane-freeing loop in both callers and stays exactly there.
struct P2Coef {
  float saved_coef[7][4];
  float saved_rate[3][4];

  void fold() {
    __builtin_memcpy(saved_coef, bmf_p2_coef, sizeof saved_coef);
    __builtin_memcpy(saved_rate, bmf_p2_rate[4], sizeof saved_rate);
    for( int32_t k = 0; k<4; ++k ) {
      bmf_p2_coef[0][k] += bmf_p2_coef[4][k];
      bmf_p2_coef[1][k] += bmf_p2_coef[5][k];
      bmf_p2_coef[2][k] += bmf_p2_coef[6][k];
      bmf_p2_coef[4][k] = 0;
      bmf_p2_coef[5][k] = 0;
      bmf_p2_coef[6][k] = 0;
      bmf_p2_rate[4][k] = bmf_p2_rate_reset;
      bmf_p2_rate[5][k] = bmf_p2_rate_reset;
      bmf_p2_rate[6][k] = bmf_p2_rate_reset;
    }
  }

  void restore() {
    __builtin_memcpy(bmf_p2_coef, saved_coef, sizeof saved_coef);
    __builtin_memcpy(bmf_p2_rate[4], saved_rate, sizeof saved_rate);
  }
};

struct AltP2Block {
  NbRow nb_weights[1088];
  // This was a union of `p2_row` with a struct whose first 112 bytes were
  // `p2_row0_head[15]` and `_u0_0_4[97]` -- 112 being `sizeof p2_row`, so the
  // union existed only to pin everything after it at the original's offsets.
  // The one overlap ever exercised is a partial clear of the first fifteen
  // bytes of `p2_row` at three sites, which is what `p2_row0_head` was for and
  // is written as that now.
  //
  // Fifteen, not sixteen: three and three-quarter floats.  The original very
  // likely cleared a differently-shaped structure that started here, and
  // rounding it up to a whole element would change what the model sees on the
  // first sample of a plane, so it is preserved rather than tidied.
  float p2_row[7][4];
  // `bias` has to follow `p2_row`, and that is not decoration: `NbRow::predict`
  // is handed `p2_row` as its `nb` and writes `nb[7][0]`, `nb[7][1]` and
  // `nb[7][2]` -- one row past the end of a `[7][4]`, which lands here.  Those
  // three floats are how it returns the centre, the mixed prediction and its
  // own; `alt_p2_model` reads `bias[0..2]` and no other slot.  So the filter
  // returns an `int32_t` and three floats, and the second half of that is
  // invisible at both the call site and the signature.
  //
  // The union this pair came out of guaranteed the adjacency by construction.
  // Sequential members do not, so it is asserted below -- the one place in this
  // tree where an `offsetof` check is not restating the layout, because here
  // the code depends on it.
  float bias[4];
  NbRow* nb_cur;
  NbRow** row0;
  NbRow** row1;
  NbRow** cur;
  NbRow** above;
  int32_t bank_ctx[5];
  int32_t _pad0;
  uint16_t pred_prev;
  uint8_t _pad2[2];
  uint32_t ctx;
  uint32_t ctx_pair[2];
  int32_t nb_id_used;
  int32_t band_lo;
  int32_t band_hi;
  uint32_t plane_idx;
  int32_t has_ref;
  P2Ctx* cursor[5];
  P2Ctx* buf[5];
  CtxWeight ctx_w[5];
  uint8_t _pad1[48];
  int32_t nb_sum[10];
  int32_t ctx_delta[260];
  uint8_t fold[256];
  uint8_t fold_hi[256];
  int8_t unfold[256];
  uint8_t nb_ctx[120];
  // 6 bands * 320.  Declared `[1916]` with the four entries after it split off
  // as `uint8_t _pad2[8]` -- the recovery could not see them indexed, and the
  // index reaches them: `63 + 64*gA + 320*band` with `gA` 0..4 and `band` 0..5
  // is 1919 at its largest, which eight of the seventeen corpus images hit on
  // every run.  The overrun landed in the padding and stopped there, exactly,
  // because four `int16_t` is eight bytes.  Same size, same offsets, and the
  // accesses are in bounds now.  CONTEXT-INDEX.md section 1.
  int16_t nb_id[1920];
  P2Count p2_ctr[163840];
  P2Freq freq[15552];
  uint8_t _pad3[8];
  // Defined out of line, in alt_p2_context.inc and alt_p2_model.inc.  They are
  // 400 and 1100 lines and belong in their own files, which is what the split
  // is for; every other method in this tree is defined in its class body
  // because every other method fits there.  They were free functions taking
  // the block as a first argument, which is what a method is.

  // The NLMS filter, in two halves, and each was a bare braced block inside
  // `alt_p2_model`'s 674 lines.
  //
  // The row's shape is `NbRow` above: lines 0..6 the taps, 7..13 the running
  // mean square of each tap's input -- which is what makes this *normalised*
  // least mean squares, each tap's step divided by the energy it has been
  // seeing -- and line 14 three scalars the two halves share.
  //
  // Both halves are written as `[7][4]` nests rather than 28 scalars because
  // that is the shape the original's SSE was in; keeping it is what lets a
  // compiler put it back.

  // Track the input energy and step both rows' weights toward their own error.
  // Two rows, not one: `fast` adapts against this sample and `slow` against the
  // confidence-scaled one, and the pair is the mixer.
  void nlms_track_two_rows(NbRow* fast, NbRow* slow,
                           float err_fast, float err_slow, float conf) {
    const float floor_fast = 26896.0f*fast->w[14][2];
    const float floor_slow = 5041.0f*slow->w[14][2];
    const float rate_slow = 0.013f*conf;
    for( int32_t j = 0; j<7; ++j )
      for( int32_t k = 0; k<4; ++k ) {
        const float x = p2_row[j][k];
        float ms = fast->w[7+j][k]+(x*x-fast->w[7+j][k])*0.05f;
        fast->w[7+j][k] = ms;
        fast->w[j][k] += bmf_p2_rate[j][k]*err_fast*x/(ms+floor_fast);
        ms = slow->w[7+j][k]+(x*x-slow->w[7+j][k])*rate_slow;
        slow->w[7+j][k] = ms;
        slow->w[j][k] += bmf_p2_rate[j][k]*err_slow*x/(ms+floor_slow);
      }
  }

  // Predict this sample from the fast row, then step that row toward the error
  // it just made.  `w[14][2]` decays toward 10 and scales the step floor, so
  // the filter starts cautious and loosens; `uses` counts the samples this
  // row has seen.
  void nlms_predict_and_correct(NbRow* row, float sample, float bias0) {
    float acc[4];
    for( int32_t k = 0; k<4; ++k ) {
      acc[k] = row->w[0][k]*p2_row[0][k];
      for( int32_t j = 1; j<7; ++j )
        acc[k] += row->w[j][k]*p2_row[j][k];
    }
    const float err = sample-(bias0+bmf_hsum4(acc));
    const float ms_scale = row->w[14][2];
    for( int32_t j = 0; j<7; ++j )
      for( int32_t k = 0; k<4; ++k )
        row->w[j][k] += bmf_p2_rate[j][k]*err*p2_row[j][k]/(row->w[7+j][k]+ms_scale*529.0f);
    ++row->uses;
    row->w[14][2] = ms_scale+((10.0f-ms_scale)*0.00019999999f);
  }

  void code_banks(int32_t sample16);

  template<int32_t f_DEC>
  void alt_p2_d8_body(uint8_t* src, uint8_t* out,
                      int32_t width, int32_t height);
  int32_t alt_p2_context(AltP2Block* refa, AltP2Block* refb);
  uint32_t alt_p2_model(int32_t sample_in, uint8_t a4, int32_t resid_in);

  AltP2Block*alt_p2_alloc(int32_t img_w, int32_t plane) {
    uint32_t done;
    int32_t lvl, len;
    uint32_t j, p, n;
    plane_idx = plane;
    // One pass, not two 2x-unrolled ones.  The original walked the 163,840
    // counters twice -- once zeroing `weighted`, once seeding `rate` and `b1`
    // -- with each loop doing two records an iteration.  This runs once per
    // plane, and the difference is not measurable: 9.7s either way on `x_ep`.
    for( j = 0; j<0x28000; ++j ) {
      p2_ctr[j].weighted = 0;
      p2_ctr[j].rate = 5;
      p2_ctr[j].b1 = 2;
    }
    for( uint32_t e = 0; e<0x3CC0; ++e ) {
      freq[e].f[0] = 2048;
      freq[e].f[1] = 2816;
      freq[e].f[2] = 2816;
      freq[e].step = 4096;
    }
    int32_t dz = 4*near_lossless_q+1;
    int32_t band = 16*near_lossless_q;
    has_ref = (uint8_t)(plane_desc[plane_desc[plane_idx].src_plane].flags&8)>>3;
    deadzone_hi = dz;
    deadzone_lo = -dz;
    band_lo = -band-7;
    band_hi = band+8;
    row0 = (NbRow**)bmf_new(sizeof(NbRow*)*(img_w+4));
    void* buf1 = bmf_new(sizeof(NbRow*)*(img_w+4));
    nb_weights[0].w[14][2] = 1.0f;
    row1 = (NbRow**) buf1;
    cur = row0+img_w+2;
    if( img_w>-4 ) {
      uint32_t pairs = (img_w+4)/2;
      if( pairs ) {
        for( p = 0; p<pairs; ++p ) {
          row1[2*p] = &nb_weights[0];
          row0[2*p] = &nb_weights[0];
          row1[2*p+1] = &nb_weights[0];
          row0[2*p+1] = &nb_weights[0];
        }
        done = 2*p+1;
      } else {
        done = 1;
      }
      if( (uint32_t)(img_w+4)>(done-1) ) {
        row1[done-1] = &nb_weights[0];
        row0[done-1] = &nb_weights[0];
      }
    }
    uint32_t row = 0;
    int32_t row_bytes = 18*(img_w<3 ? 3 : img_w)+234;
    do
      buf[row++] = (P2Ctx*)bmf_new(row_bytes);
    while( row<5 );
    memset(buf[0], 0, row_bytes);
    ctx_bias[3] = 0;
    lvl = 0;
    ctx_bias[2] = 0;
    ctx_bias[1] = 0;
    uint32_t pair = 0;
    ctx_bias[0] = 0;
    cursor[0] = buf[0]+8;
    do {
      ctx_delta[2*pair] = (plane_idx<<8)|(16*lvl);
      int32_t lvl1 = (2*pair==p2_ctx_edges[lvl])+lvl;
      ctx_delta[2*pair+1] = (plane_idx<<8)|(16*lvl1);
      int32_t bump = 2*pair+++1==p2_ctx_edges[lvl1];
      lvl = bump+lvl1;
    } while( pair<0x82 );
    len = 0;
    for( n = 0; n<0x3C; ++n ) {
      nb_ctx[2*n] = len;
      int32_t len1 = (2*n==p2_len_edges[len])+len;
      nb_ctx[2*n+1] = len1;
      len = (2*n+1==p2_len_edges[len1])+len1;
    }
    ctx = 15;
    alt_init_tables(fold, unfold);
    ctx_w[4].w[0] = 0;
    ctx_w[0].w[1] = 64;
    ctx_w[3].w[0] = 0;
    ctx_w[0].w[2] = 128;
    ctx_w[2].w[0] = 0;
    ctx_w[1].w[1] = 192;
    ctx_w[1].w[0] = 0;
    ctx_w[1].w[2] = 384;
    ctx_w[0].w[0] = 0;
    ctx_w[2].w[1] = 576;
    ctx_w[2].w[2] = 1152;
    ctx_w[3].w[1] = 1728;
    ctx_w[3].w[2] = 3456;
    ctx_w[4].w[1] = 5184;
    ctx_w[4].w[2] = 10368;
    return this;
  }

  AltP2Block*alt_p2_free(int8_t do_free) {
    for( int32_t k = 0; k<5; ++k )
      free(buf[k]);
    free(row0);
    free(row1);
    if( do_free&1 )
      bmf_page_free(this);
    return this;
  }
};

// `NbRow::predict` writes `nb[7][0..2]` where `nb` is `p2_row`, a `[7][4]`.
// That is `bias`, and this says so in a form the compiler checks.
static_assert(offsetof(AltP2Block, bias)
              == offsetof(AltP2Block, p2_row)+sizeof(AltP2Block::p2_row),
              "NbRow::predict returns three floats by writing one row past "
              "p2_row, which has to be bias");

// The six weight sets `NbRow::predict` mixes, in the order `bmf_p2_mix[mode]`
// weights them -- so the order is the model's and not a choice.  In cursor
// terms, with `cur` and `above` both pointing at this pixel's column and both
// advanced one slot per pixel:
//
//     row[0] = cur[-1]     one to the left, this row
//     row[1] = above[1]    one to the right, the row above
//     row[2] = above[2]    two to the right, the row above
//     row[3] = cur[-2]     two to the left, this row
//     row[4] = above[0]    directly above
//     row[5] = cur[0]      this column's slot, which this row has not written
//                          yet -- the two row buffers alternate, so it still
//                          holds what was put there when this buffer was last
//                          the current row
//
// `f0` was the name, which is an offset and not a role: the member sits at
// zero and the decompiler said so.
struct CtxWeights {
  NbRow* row[6];
};

// model.inc -- the main model.  One pixel in and one pixel out are the two largest
// bodies in the program, and they are methods of the block they read.

struct PixRec {
  union {
    struct {
      uint16_t sym;
      uint8_t match[6];
    };
    // The same eight bytes as two words.  `match2345` was already named; the
    // low word had only `_head[4]` and eleven sites reached it as
    // `*(uint32_t*)rec`, which is the punning this union exists to make
    // unnecessary.
    struct {
      uint32_t head4;
      uint32_t match2345;
    };
  };
};

struct ModelBlock {
  uint32_t width;
  int32_t height;
  uint32_t depth;
  uint32_t depth_raw;
  uint32_t alphabet;
  uint32_t ctx_id1_used;
  uint32_t ctx_id2_used;
  uint32_t ctx_id3_used;
  uint32_t hit;
  uint32_t ctx_state_seen;
  uint32_t bucket_idx;
  uint32_t sym_pos;
  uint32_t ctr_fallback;
  uint32_t ctr_node;
  PixRec* row_cur[10];
  FreqRec grid[65723];
  uint8_t _pad1051664[16];
  BitCtr bit_root[16];
  BitCtr bit_node[4096];
  BitCtr esc_ctr[257];
  BitCtr run_ctr[48];
  uint8_t _pad16[2];
  SymList escape;
  SymList* sel1_list;
  SymList* sel0_list;
  SymList* sel[2];
  SymList* escape_list;
  uint8_t _pad22[4];
  SymList** sel_cur;
  uint16_t* sym_word;
  uint32_t* sym_code;
  uint8_t ctx_state[64];
  uint8_t ctx_bucket[375];
  uint8_t _pad25[1];
  uint8_t* run_bucket;
  uint8_t* alpha_map;
  uint8_t grad[4];
  uint16_t sym_ctr[524288];
  SymPair group_ctr[15][65536];
  uint16_t* sym_cache;
  SymPair* pix_cur;
  uint16_t sym_rev[8192];
  uint16_t ctx_id1[192512];
  uint16_t ctx_id2[108800];
  uint16_t ctx_id3[712000];
  // The pair AltP1Block and AltP2Block already have as methods: one lays the
  // workspace out over a fresh allocation and returns `this`, the other gives
  // it back.  Defined out of line in model_workspace.inc.
  ModelBlock*layout_workspace(int32_t img_w, int32_t img_h, int32_t img_depth);
  void free_workspace(int8_t do_free);

  int32_t pixel_context(uint32_t* nb) {
    int32_t band;
    int32_t pos = sym_pos;
    uint32_t result = (nb)[pos];
    if( exclusion_mask[result]==exclusion_gen )
      return -1;
    bool near = false;
    for( band = 11; band<16; ++band )
      near |= result==nb[band];
    bool far = false;
    for( band = 16; band<32; ++band )
      far |= result==nb[band];
    int32_t near_hit = 32*near+((result==nb[10])<<6);
    int32_t far_hit = 16*far;
    int32_t ctx0 = far_hit+near_hit;
    ctr_node = ctx0;
    if( (far_hit+near_hit==0)&&pos>6 )
      return -1;
    SymList* sel0 = sel0_list;
    int32_t ctx1 = ctx0+8*sym_in_top((sel0[mode_symbol[1]].ent), 10, result);
    ctr_node = ctx1;
    SymEntry *list_prev = sel0[mode_symbol[2]].ent;
    SymEntry *list_sym = sel0[result].ent;
    int32_t fallback = sym_in_top((sel0[mode_symbol[3]].ent), 6, result)+2*sym_in_top(list_sym, 10, mode_symbol[2])+4*sym_in_top(list_prev, 4, result);
    int32_t ctx2 = fallback+ctx1;
    if( pos<=14||(ctx2&0xB)!=0 ) {
      ctr_node = (pos<<7)+ctx2;
      ctr_fallback = fallback+8*(pos>9);
    } else {
      ctr_fallback = fallback;
      return -1;
    }
    return result;
  }

  int32_t init_tables() {
    SymList** cur;
    bool promoted;
    SymList* list, ** prev;
    int32_t recycled, hit1;
    uint32_t hit0 = hit;
    if( !hit0 ) {
      if( sel==sel_cur ) {
        if( sel[0] ) {
          sel0_list[mode_symbol[1]].add_weight(row_cur[5]->sym, 3u);
          sel0_list[row_cur[5]->sym].add_weight(mode_symbol[2], 2u);
          sel1_list[mode_symbol[1]].add_weight(row_cur[5]->sym, 4u);
          sel1_list[row_cur[5]->sym].add_weight(mode_symbol[1], 2u);
        } else {
          sel0_list[mode_symbol[2]].add_weight(row_cur[5]->sym, (sym_pos>3)+2);
        }
      } else {
        sel0_list[mode_symbol[1]].add_weight(row_cur[5]->sym, 3u);
        sel0_list[row_cur[5]->sym].add_weight(mode_symbol[2], 2u);
        sel0_list[row_cur[5]->sym].add_weight(mode_symbol[1], 1u);
        sel1_list[row_cur[5]->sym].add_weight(mode_symbol[1], 2u);
        cur = sel_cur;
        do {
          prev = cur-1;
          sel_cur = prev;
          list = *prev;
          uint16_t want = row_cur[5]->sym;
          uint32_t n_live = list->live;
          SymEntry *ent = list->ent;
          if( n_live==list->n ) {
            list->live = --n_live;
            recycled = list->ent[n_live].cnt;
          } else {
            recycled = 1;
          }
          SymEntry *slot = &ent[n_live];
          list->live = n_live+1;
          list->tot = recycled+list->tot+1;
          slot->set(want, 2);
          list->since_rescale += 4;
          if( slot!=list->ent ) {
            uint16_t sym = slot->sym;
            uint8_t cnt = slot->cnt;
            *slot = slot[-1];
            slot[-1].set(sym, cnt);
          }
          cur = sel_cur;
        } while( cur!=sel );
      }
      if( exclusion_gen==-1 ) {
        exclusion_gen = 1;
        uint8_t *buf = (uint8_t*)exclusion_mask;
        uint32_t blocks = (alphabet+15)>>4;
        do {
          bmf_zero16(buf);
          buf += 16;
          --blocks;
        } while( blocks );
        hit1 = hit;
      } else {
        ++exclusion_gen;
        hit1 = hit;
      }
      promoted = hit1&&hit1<=2;
    } else {
      promoted = hit0<=2;
      if( !promoted&&mode_symbol[3]!=mode_symbol[4] ) {
        sel0_list[mode_symbol[2]].add_weight(row_cur[5]->sym, 1u);
        hit1 = hit;
        promoted = hit1&&hit1<=2;
      }
    }
    if( !promoted ) {
      int32_t just = row_cur[5]->sym;
      uint16_t *cache = sym_cache;
      int32_t c0 = cache[0];
      if( just!=c0 ) {
        int32_t c1 = cache[1];
        if( just==c1 ) {
          cache[1] = c0;
        } else {
          int32_t c2 = cache[2];
          if( just==c2 ) {
            cache[2] = c1;
            sym_cache[1] = sym_cache[0];
          } else {
            int32_t c3 = cache[3];
            if( just==c3 ) {
              cache[3] = c2;
              sym_cache[2] = sym_cache[1];
              sym_cache[1] = sym_cache[0];
            } else {
              int32_t c4 = cache[4];
              if( just==c4 ) {
                cache[4] = c3;
                sym_cache[3] = sym_cache[2];
                sym_cache[2] = sym_cache[1];
                sym_cache[1] = sym_cache[0];
              } else {
                int32_t c5 = cache[5];
                if( just==c5 ) {
                  cache[5] = c4;
                  sym_cache[4] = sym_cache[3];
                  sym_cache[3] = sym_cache[2];
                  sym_cache[2] = sym_cache[1];
                  sym_cache[1] = sym_cache[0];
                } else {
                  int32_t c6 = cache[6];
                  if( just==c6 ) {
                    cache[6] = c5;
                  } else {
                    cache[7] = c6;
                    sym_cache[6] = sym_cache[5];
                  }
                  sym_cache[5] = sym_cache[4];
                  sym_cache[4] = sym_cache[3];
                  sym_cache[3] = sym_cache[2];
                  sym_cache[2] = sym_cache[1];
                  sym_cache[1] = sym_cache[0];
                }
              }
            }
          }
        }
        sym_cache[0] = just;
      }
    }
    pix_cur->prev = pix_cur->last;
    pix_cur->last = row_cur[5]->sym;
    {
      PixRec*const here = row_cur[5];
      PixRec*const up = row_cur[6];
      here->match[0] = here->sym==up->sym;
      here->match[1] = here->sym==here[-1].sym;
      here->match[2] = here->sym==up[1].sym;
      here->match[3] = here->sym==up[-1].sym;
      here->match[4] = here->sym==up[2].sym;
      here->match[5] = here->sym==up[3].sym;
    }
    PixRec *up1 = row_cur[6];
    PixRec *up2 = row_cur[7];
    PixRec *row = row_cur[5]+1;
    row_cur[5] = row;
    ++row_cur[8];
    ++up1;
    row_cur[6] = up1;
    ++up2;
    ++row_cur[9];
    row_cur[7] = up2;
    grad[0] += up1[4].match[0]-up1[-4].match[0];
    grad[1] += up2[4].match[0]-up2[-4].match[0];
    grad[2] += row[-1].match[1]-row[-5].match[1];
    int32_t result = row[-1].match[0]-row[-8].match[0];
    grad[3] += result;
    return result;
  }

  void expand_alphabet() {
    SymList lists[16];
    uint32_t* codes_p;
    int32_t left2, left;
    uint32_t i, cap, n_syms, j, carry;
    uint32_t bits = depth;
    uint32_t mask = 0xFFFFFFFF>>(-(uint8_t)depth&31);
    uint32_t nbytes = (bits+7)>>3;
    for( i = 0; i<8; ++i ) {
      lists[2*i].ent = nullptr;
      lists[2*i+1].ent = nullptr;
    }
    cap = mask+1;
    if( bits>8 )
      cap = no_symbol+1;
    uint32_t n_1 = rc_decode_flat(cap);
    alphabet = n_1+1;
    if( (int32_t)(n_1+1)<=0x2000 ) {
      void* codes = bmf_new(sizeof(uint32_t)*(n_1+1));
      n_syms = alphabet;
      sym_code = (uint32_t*)codes;
      if( n_syms ) {
        for( j = 0; j<n_syms; ++j ) {
          sym_code[j] = j;
          n_syms = alphabet;
        }
      }
      if( (int32_t)depth>8 ) {
        if( 4*nbytes ) {
          uint32_t k = 0;
          do
            lists[k++].init(256, 1);
          while( k<(4*nbytes) );
          n_syms = alphabet;
        }
        if( n_syms ) {
          codes_p = sym_code;
          carry = 0;
          uint32_t s = 0;
          do {
            codes_p[s] = 0;
            if( nbytes ) {
              uint32_t b = 0;
              do {
                uint32_t piece = decode_symbol_list(&lists[4*b+carry]);
                carry = piece>>6;
                sym_code[s] += piece<<((8*b)&31);
                ++b;
              } while( b<nbytes );
            }
            codes_p = sym_code;
            carry = (uint8_t)codes_p[s++]>>7;
          } while( s<alphabet );
        }
      } else if( n_syms<=mask ) {
        lists[0].init(mask-n_syms+2, 1);
        lists[0].rescale_at = 19*lists[0].n;
        if( alphabet ) {
          int32_t run = 0;
          uint32_t s2 = 0;
          do {
            int32_t gap = decode_symbol_list(&lists[0]);
            sym_code[s2] = gap+run;
            run += gap+1;
            ++s2;
          } while( s2<alphabet );
        }
      }
      for( left = 15; left>=0; --left )
        free(lists[left].ent);
    } else {
      depth = 8;
      height = height*nbytes;
      expand_alphabet();
      for( left2 = 15; left2>=0; --left2 )
        free(lists[left2].ent);
    }
  }

  void unmodel_plane_slow(uint8_t* dst) {
    uint8_t* row[19];
    ModelBlock* this_1, * blk;
    uint32_t has4, jj, wt, nbytes, row_w;
    uint16_t* out16;
    SymEntry* out_ent;
    uint8_t* out_at, * dst_keep;
    int32_t g0;
    int32_t done;
    int32_t lo1, g1;
    uint32_t* x6;
    uint8_t* dst_base, * dst_buf, * buf, * expand_buf, * out_bits, * row_at, * interleave_at, * p, * out8;
    PixRec* kk, * row_cur3, * row_cur2, * row_cur1, * n_syms;
    int32_t g, lo, w2, w4, w2n, lvl_n, live, bucket, x, x2, step, x7, x3, x4, bits, bpp, bpp_raw, nchunk, n_pix, chunk, q5, q1, at, q2, written, n_pix2, x5;
    SymListBlock* has3, * alpha;
    SymList *i, *j;
    PixRec* lists, * t;
    dst_keep = dst;
    dst_base = &dst[-(depth<8)];
    rc_begin_decode();
    expand_alphabet();
    this_1 = this;
    g1 = 0;
    g = 0;
    do {
      int32_t flags = ctx_group_flags[g];
      this_1->ctx_state[flags] = g;
      lo1 = 0;
      g0 = g;
      int32_t y0 = flags&4;
      int32_t f_b1 = flags&2;
      int32_t f_b4 = flags&0x10;
      lo = 0;
      int32_t f_b0 = flags&1;
      int32_t f_b5 = flags&0x20;
      int32_t f_b3 = flags&8;
      do {
        lo1 = lo;
        int32_t k = 0;
        do {
          this_1->ctx_bucket[g+15*lo+75*k] = g1;
          int32_t m5 = this_1->alphabet;
          FreqRec *rec = &this_1->grid[g1];
          rec->w[1] = 2;
          rec->w[2] = 2;
          rec->w[3] = 2;
          rec->w[4] = 2;
          if( y0 ) {
            w2 = (uint16_t)(rec->w[4]+rec->w[3]);
            rec->w[3] = w2;
            w4 = 0;
            rec->w[4] = 0;
          } else {
            w2 = rec->w[3];
            w4 = rec->w[4];
          }
          if( f_b1 ) {
            w2n = (uint16_t)(w4+rec->w[2]);
            rec->w[2] = w2n;
            w4 = 0;
            rec->w[4] = 0;
          } else {
            w2n = rec->w[2];
          }
          if( f_b4 ) {
            w2n = (uint16_t)(w2+w2n);
            rec->w[2] = w2n;
            w2 = 0;
            rec->w[3] = 0;
          }
          if( f_b0 ) {
            rec->w[1] += w4;
            w4 = 0;
            rec->w[4] = 0;
          }
          if( f_b3 ) {
            rec->w[1] += w2;
            w2 = 0;
            rec->w[3] = 0;
          }
          if( f_b5 ) {
            rec->w[1] += w2n;
            w2n = 0;
            rec->w[2] = 0;
          }
          lvl_n = (w2!=0)+(w2n!=0)+(w4!=0)+2;
          if( lvl_n<=m5 ) {
            rec->b14 = lvl_n;
            rec->w[0] = 2;
          } else {
            lvl_n = lvl_n-1;
            rec->b14 = lvl_n;
            rec->w[0] = 0;
          }
          if( rec->w[lo1]&&rec->w[k]&&(uint8_t)lvl_n<=m5 ) {
            live = 1;
            int16_t lvl = (uint8_t)(1<<((5-lvl_n)&31));
            rec->b15 = lvl;
            rec->w[6] = lvl<<6;
            rec->w[lo1] += lvl;
            rec->w[k] += rec->b15;
            rec->w[5] = rec->w[0]+rec->w[4]+rec->w[3]+rec->w[2]+rec->w[1];
          } else {
            live = 0;
          }
          g1 += live;
          ++k;
        } while( k<5 );
        lo = lo1+1;
      } while( lo1+1<5 );
      int32_t gi = 0;
      SymPair* gctr = this_1->group_ctr[g0];
      do {
        gctr[gi].last = no_symbol;
        gctr[gi++].prev = no_symbol;
      } while( gi<0x10000 );
      g = g0+1;
    } while( g0+1<15 );
    dst_buf = dst_base;
    blk = (ModelBlock*)(this_1);
    buf = (uint8_t*)bmf_new(this_1->alphabet);
    uint32_t alpha_n = this_1->alphabet;
    this_1->alpha_map = buf;
    memset(buf, 1, alpha_n);
    blk->escape_list = &blk->escape;
    blk->escape.init(blk->alphabet, 1);
    blk->sel_cur = blk->sel;
    wt = blk->alphabet;
    has3 = (SymListBlock*)bmf_new(SymListBlock::bytes(wt));
    if( has3 ) {
      has3->n = wt;
      SymList *list_a = has3->list;
      for( i = list_a; wt; --wt )
        (list_a++)->ent = nullptr;
    } else {
      i = nullptr;
    }
    has4 = blk->alphabet;
    blk->sel1_list = i;
    alpha = (SymListBlock*)bmf_new(SymListBlock::bytes(has4));
    if( alpha ) {
      alpha->n = has4;
      SymList *list_b = alpha->list;
      for( j = list_b; has4; --has4 )
        (list_b++)->ent = nullptr;
    } else {
      j = nullptr;
    }
    blk->sel0_list = j;
    if( !(blk->alphabet<=0) ) {
      int32_t s = 0;
      do {
        blk->sel1_list[s].init(99, 0);
        blk->sel0_list[s++].init(33, 0);
      } while( (uint32_t)s<blk->alphabet );
    }
    jj = blk->depth;
    if( jj==blk->depth_raw ) {
      expand_buf = nullptr;
    } else {
      dst_buf = (uint8_t*)bmf_new(blk->height*blk->width+3);
      jj = blk->depth;
      expand_buf = dst_buf;
    }
    nbytes = (jj+7)>>3;
    if( blk->height>0 ) {
      out_at = dst_buf;
      bucket = 0;
      while( 1 ) {
        blk->row_cur[5]->match[1] = blk->row_cur[5][-1].sym==0;
        blk->row_cur[5]->match[3] = blk->row_cur[6][-1].sym==0;
        kk = blk->row_cur[4];
        row_cur3 = blk->row_cur[3];
        row_cur2 = blk->row_cur[2];
        row_cur1 = blk->row_cur[1];
        n_syms = blk->row_cur[0];
        blk->row_cur[4] = row_cur3;
        blk->row_cur[3] = row_cur2;
        blk->row_cur[2] = row_cur1;
        blk->row_cur[1] = n_syms;
        blk->row_cur[0] = kk;
        kk += 7;
        blk->row_cur[5] = kk;
        n_syms += 7;
        blk->row_cur[6] = n_syms;
        blk->row_cur[7] = row_cur1+7;
        blk->row_cur[8] = row_cur2+7;
        blk->row_cur[9] = row_cur3+7;
        {
          uint8_t zero = n_syms[1].sym==0;
          kk->match[2] = zero;
          blk->row_cur[5][-1].match[4] = zero;
          blk->row_cur[5][-2].match[5] = zero;
          zero = blk->row_cur[6][2].sym==0;
          blk->row_cur[5]->match[4] = zero;
          blk->row_cur[5][-1].match[5] = zero;
        }
        blk->row_cur[5]->match[5] = blk->row_cur[6][3].sym==0;
        lists = blk->row_cur[6];
        t = blk->row_cur[7];
        ++blk->row_cur[5];
        ++lists;
        ++blk->row_cur[8];
        blk->row_cur[6] = lists;
        ++t;
        blk->row_cur[7] = t;
        ++blk->row_cur[9];
        blk->grad[0] = lists[3].match[0]+lists[2].match[0]+lists[1].match[0]+lists[0].match[0]+lists[4].match[0]-5;
        blk->grad[3] = 0;
        blk->grad[2] = 0;
        row_w = blk->width;
        blk->grad[1] = t[3].match[0]+t[2].match[0]+t[1].match[0]+t[0].match[0]+t[4].match[0]-5;
        x = bucket;
        if( row_w<=0 )
          break;
        x2 = 0;
        do {
          int32_t y = (blk)->decode_pixel(x2);
          blk->init_tables();
          row_w = blk->width;
          x2 += y;
        } while( (uint32_t)x2<blk->width );
        x = bucket;
        if( nbytes!=4 )
          goto list_ready;
        if( row_w>0 ) {
          uint32_t *out32 = (uint32_t*)out_at;
          int32_t y2 = 0;
          do
            *out32++ = blk->sym_code[blk->row_cur[0][y2+++8].sym];
          while( (uint32_t)y2<blk->width );
          out_at = (uint8_t*)out32;
          goto next_list;
        }
  next_list:
        bucket = x+1;
        // `height` is `int32_t` and this side is already `uint32_t`, so C
        // converts the right operand too.  Written where it happens.
        if( (uint32_t)bucket>=(uint32_t)blk->height )
          goto list_done;
      }
      if( nbytes==4 )
        goto next_list;
  list_ready:
      if( nbytes==3 ) {
        if( row_w>0 ) {
          out_ent = (SymEntry*)out_at;
          step = 0;
          do {
            x6 = blk->sym_code;
            x7 = blk->row_cur[0][step+8].sym;
            out_ent->set((uint16_t)x6[x7], (uint8_t)(x6[x7]>>16));
            ++step;
            ++out_ent;
          } while( (uint32_t)step<blk->width );
          out_at = (uint8_t*)out_ent;
        }
        goto next_list;
      }
      if( nbytes!=2 ) {
        if( blk->depth==8 ) {
          if( row_w>0 ) {
            out8 = out_at;
            x5 = 0;
            do
              *out8++ = (uint8_t)blk->sym_code[blk->row_cur[0][x5+++8].sym];
            while( (uint32_t)x5<blk->width );
            out_at = out8;
          }
        } else if( row_w>0 ) {
          x4 = 0;
          bits = 0;
          out_bits = out_at;
          do {
            bpp = blk->depth;
            bits -= bpp;
            if( bits<0 ) {
              bits = 8-bpp;
              *++out_bits = blk->sym_code[blk->row_cur[0][x4+8].sym]<<((8-bpp)&31);
            } else {
              *out_bits |= blk->sym_code[blk->row_cur[0][x4+8].sym]<<(bits&31);
            }
            ++x4;
          } while( (uint32_t)x4<blk->width );
          out_at = out_bits;
        }
        goto next_list;
      }
      if( row_w>0 ) {
        out16 = (uint16_t*)out_at;
        x3 = 0;
        do
          *out16++ = blk->sym_code[blk->row_cur[0][x3+++8].sym];
        while( (uint32_t)x3<blk->width );
        out_at = (uint8_t*)out16;
      }
      goto next_list;
    }
  list_done:
    rc_end_decode();
    bpp_raw = blk->depth_raw;
    if( (uint32_t)bpp_raw!=blk->depth ) {
      nchunk = (bpp_raw+7)>>3;
      if( nchunk<=0 ) {
        n_pix = blk->height*blk->width;
      } else {
        done = 0;
        n_pix = blk->height*blk->width;
        chunk = n_pix/nchunk;
        if( nchunk>=6 ) {
          q5 = 0;
          row_at = expand_buf;
          do {
            row[q5] = row_at;
            row_at += 5*chunk;
            row[q5+1] = &expand_buf[chunk*(q5+1)];
            row[q5+2] = &expand_buf[chunk*(q5+2)];
            row[q5+3] = &expand_buf[chunk*(q5+3)];
            row[q5+4] = &expand_buf[chunk*(q5+4)];
            q5 += 5;
          } while( q5<=nchunk-6 );
          done = q5;
        }
        q1 = done;
        at = chunk*done;
        do {
          row[q1] = &expand_buf[at];
          at += chunk;
          ++q1;
        } while( q1<nchunk );
      }
      if( n_pix>0 ) {
        interleave_at = dst_keep;
        q2 = 0;
        written = 0;
        do {
          p = row[q2];
          *interleave_at = *p;
          n_pix2 = blk->height*blk->width;
          ++interleave_at;
          row[q2++] = p+1;
          if( q2==nchunk )
            q2 = 0;
          ++written;
        } while( written<n_pix2 );
      }
      free(expand_buf);
    }
  }

  int32_t decode_pixel(int32_t x) {
    // The neighbour list `pixel_context` indexes by `sym_pos`.  BMF.exe fills
    // it one slot at a time, so Hex-Rays gave each slot a member, and an
    // earlier round recovered the array beside them.  The frame struct is what
    // was left over: this array, four bytes of gap and thirty-two of trailing
    // pad, no other member, and nothing reading either.  `pixel_context`
    // indexes 0..31 and no further, so the pad held nothing back.
    alignas(16) int32_t nb_sym[32];
    int32_t idx_t;
    FreqRec* freq;
    uint16_t* id3p;
    uint8_t g_ab;
    int8_t gen;
    FreqRec* freq2;
    PixRec* up4;
    FreqRec* freq_tbl;
    SymList* sel1, ** sel_p;
    int32_t bin_tot;
    int32_t arg_cum, arg_high, arg_tot;
    uint32_t done, lvl_a, pos1;
    PixRec* r8, * r7, * rec;
    SymPair* pixq;
    PixRec* r8b, * r7b, * next, * r5, * cur6b;
    uint8_t g_a, g_b, g_c, g_d, g_e;
    int32_t n2r;
    int16_t s1c, w1s, s3b;
    int32_t up_sym, left_sym, up_p1_sym, up_m1_sym, m_lo, m_up, nb, key, state, pair_last, cap, bucket_at, up_m0, m_w1, nb2, all_up, sig1, id1, sig2, id2, s1a, m_up0, idx1, run, bucket, bit, msym1c, hit_a, idx_s, mask, seen, run0, s1b, flags_word, s3c, s3d, s1d, tot, target, cum, w6a, b15a, w5a, msym3, msym1, msym2, psym, bit2, msym1b, lsym, b15, w2t, w3t, w4t, w5, w0r, w1r, q1, w2r, w3, w3r, s0a, span, w4r, n4r, target2, cum2, lvl_b, b15b, w5b, w6b, s0c, s3a;
    PixRec* row;
    SymPair* pair;
    PixRec* cur6;
    uint16_t pair_prev;
    PixRec* up5, * r8c;
    SymPair *pixp, *pixr;
    uint16_t q1w, tot2, k0;
    uint32_t si, s2a, k2, k2h;
    uint16_t k1;
    uint16_t k4, k3;
    PixRec* up2;
    PixRec* up1;
    PixRec* up3;
    PixRec* up9;
    PixRec* cur6c;
    BitCtr* ctr;
    cur6 = (PixRec*)row_cur[6];
    up_sym = cur6->sym;
    row = row_cur[5];
    left_sym = row[-1].sym;
    up_p1_sym = cur6[1].sym;
    up_m1_sym = cur6[-1].sym;
    nb_sym[0] = up_sym;
    mode_symbol[1] = up_sym;
    nb_sym[1] = left_sym;
    mode_symbol[2] = left_sym;
    nb_sym[3] = up_p1_sym;
    mode_symbol[3] = up_p1_sym;
    m_lo = cur6->match[1]+4*(up_p1_sym==up_m1_sym);
    m_up = cur6[1].match[1];
    nb_sym[2] = up_m1_sym;
    mode_symbol[4] = up_m1_sym;
    // Six match flags of the four named neighbours, as six bits.
    nb = CtxIdx{}.bit<5>(row[-1].match[2]).bit<4>(row[-1].match[4])
                 .bit<3>(m_up).bit<1>(row[-1].match[0]).raw(m_lo);
    if( up_sym==left_sym ) {
      if( nb_sym[3]==nb_sym[0] ) {
        int16_t revtab = sym_rev[up_sym];
        if( up_sym==nb_sym[2] )
          key = (uint16_t)(revtab-row[-2].sym);
        else
          key = (uint16_t)(revtab-nb_sym[2]);
      } else {
        key = (uint16_t)(sym_rev[up_sym]-nb_sym[3]);
      }
    } else {
      key = (uint16_t)(sym_rev[up_sym]-nb_sym[1]);
    }
    sym_cache = &sym_ctr[8*key];
    state = ctx_state[nb];
    ctx_state_seen = state;
    pair = &group_ctr[state][key];
    pix_cur = pair;
    pair_last = pair->last;
    if( pair_last==nb_sym[0] ) {
      cap = 15;
    } else if( pair_last==nb_sym[1] ) {
      cap = 30;
    } else if( pair_last==nb_sym[3] ) {
      cap = 45;
    } else {
      cap = 60;
      if( !(pair_last==nb_sym[2]) )
        cap = 0;
    }
    pair_prev = pair->prev;
    if( pair_prev==nb_sym[0] ) {
      cap += 75;
    } else if( pair_prev==nb_sym[1] ) {
      cap += 150;
    } else if( pair_prev==nb_sym[3] ) {
      cap += 225;
    } else if( pair_prev==nb_sym[2] ) {
      cap += 300;
    }
    r8 = row_cur[8];
    bucket_at = ctx_bucket[state+cap];
    r7 = row_cur[7];
    bucket_idx = bucket_at;
    up_m0 = cur6->match[0];
    nb_sym[2] = up_m0;
    m_w1 = row[-1].match[1];
    up9 = row_cur[9];
    nb2 = CtxIdx{}.bit<3>(row[-2].match[2]).bit<2>(row[-2].match[5])
                  .bit<1>(row[-2].match[4]).bit<0>(m_w1);
    all_up = ((uint8_t)(up9->match[0]&r8->match[0]&nb_sym[2]&r7->match[0])<<9)+((uint8_t)(up9->match[1]&r8->match[1]&r7->match[1]&cur6->match[1])<<8)+(bucket_at<<10)+nb2;
    cur6b = cur6;
    // The four gradient accumulators as four "is it flat" bits, over the
    // four-bit `nb2` below them; `all_up` carries the two run bits at 8 and 9
    // and the bucket from 10 up.
    sig1 = CtxIdx{}.bit<7>(grad[3]==0).bit<6>(grad[2]==0)
                   .bit<5>(grad[1]==0).bit<4>(grad[0]==0)
                   .raw(all_up);
    id1 = ctx_id1[sig1];
    if( id1==0xFFFF ) {
      ctx_id1[sig1] = ctx_id1_used;
      cur6b = row_cur[6];
      row = row_cur[5];
      ++ctx_id1_used;
      id1 = ctx_id1[sig1];
      nb_sym[2] = cur6b->match[0];
    }
    sig2 = CtxIdx{}.bit<2>(cur6b[1].match[3]).bit<1>(nb_sym[2])
                   .bit<0>(row[-1].match[5]).raw(8*id1);
    id2 = ctx_id2[sig2];
    if( id2==0xFFFF ) {
      ctx_id2[sig2] = ctx_id2_used++;
      id2 = ctx_id2[sig2];
    }
    if( (int32_t)alphabet<32 ) {
      int32_t id3_used = ctx_id3_used;
      // The encoder's half of this context is at `sig3` below, written the same
      // way: a four-bit field of the symbol under a lazily allocated id.  It
      // reuses `sym1`, which held the left neighbour's symbol until here.
      nb_sym[1] = CtxIdx{}.bits<0, 4>(nb_sym[1]).raw(16*id2);
      id3p = &ctx_id3[nb_sym[1]];
      id2 = *id3p;
      if( id2==0xFFFF ) {
        s1a = nb_sym[1];
        if( id3_used>53248 )
          s1a = nb_sym[1]|0xF;
        id3p = &ctx_id3[s1a];
        id2 = *id3p;
      }
      if( id2>=id3_used ) {
        *id3p = id3_used;
        ++ctx_id3_used;
        id2 = *id3p;
      }
    }
    if( row_cur[5][-1].match[1]&row_cur[5][-1].match[0] ) {
      up1 = row_cur[6];
      up2 = row_cur[7];
      if( (uint8_t)(up2[2].match[1]&up2[1].match[1]&up2[0].match[1]&up1[3].match[1]&up1[2].match[1]&up1[1].match[1]&up1[0].match[1]&up1[0].match[0]&(int8_t)up1[-1].match[1])&up2[3].match[1] ) {
        m_up0 = up2[0].match[0];
        idx1 = 1;
        if( width-x<=1 ) {
          run = 1;
        } else {
          nb_sym[1] = width-x;
          while( 1 ) {
            run = idx1;
            if( !(up1[idx1+2].match[1]&up1[idx1+2].match[0]) )
              break;
            m_up0 = (uint8_t)(up2[run].match[0]&m_up0);
            if( ++idx1>=nb_sym[1] ) {
              run = idx1;
              goto run_copied;
            }
          }
        }
  run_copied:
        bucket = *(run_bucket+idx1);
        bit = esc_ctr[(8*bucket+4*(uint8_t)(up2[run+3].match[1]&up2[run+2].match[1])+2*m_up0+*(alpha_map+nb_sym[0])+1)].decode_context_bit(esc_ctr);
        msym1c = mode_symbol[1];
        hit = bit;
        *(((uint8_t*)alpha_map)+msym1c) = bit;
        hit_a = hit;
        if( hit_a ) {
          idx_s = idx1;
        } else {
          idx_s = 0;
          if( idx1==1 )
            goto run_done;
          nb_sym[3] = idx1;
          nb_sym[0] = bucket;
          idx_s = 0;
          mask = 1<<(bucket&31);
          seen = 0;
          do {
            if( (mask|seen)<nb_sym[3] ) {
              ctr = &run_ctr[16*((seen==0)+(bucket==nb_sym[0]))+bucket];
              run0 = ctr->n[0];
              bin_tot = run0+ctr->n[1];
              nb_sym[1] = rc.decode_bit(run0, ctr->n[1]);
              if( ctr->limit<(uint32_t)bin_tot )
                ctr->scale_rare();
              s1b = nb_sym[1];
              ctr->n[nb_sym[1]] += 8;
