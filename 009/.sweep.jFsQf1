      cap += 150;
    } else if( pair_prev==nb_sym[6] ) {
      cap += 225;
    } else if( pair_prev==nb_sym[5] ) {
      cap += 300;
    }
    r1 = row_cur[8];
    bucket_at = ctx_bucket[state+cap];
    r2 = row_cur[7];
    bucket_idx = bucket_at;
    up_match0 = cur6->match[0];
    match1 = cur6->match[1];
    cur2 = cur5;
    nb_sym[0] = up_match0;
    PixRec* up9 = row_cur[9];
    m_w1 = cur5[-1].match[1];
    nb2 = CtxIdx{}.bit<3>(cur5[-2].match[2]).bit<2>(cur5[-2].match[5])
