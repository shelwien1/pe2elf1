    sel1 = sel1_list;
    sel[0] = &sel0_list[mode_symbol[2]];
    sel_p = sel_cur;
    sel[1] = &sel1[msym1b];
    while( 1 ) {
      if( sel_p>&escape_list )
        bmf_fatal(bmf_read_error);
      if( (*sel_p)->live ) {
        lsym = decode_symbol_list(*sel_p);
        row_cur[5]->sym = lsym;
        if( lsym>=0 )
          return idx_t+1;
        sel_p = sel_cur;
      }
      sel_cur = ++sel_p;
    }
  }

  int32_t code_pixel(int32_t x) {
    // The neighbour list `pixel_context` indexes by `sym_pos`.  BMF.exe fills
