#  aacpack's hdr family at level -9: a field of the AAC syntax (every value
#  of the walk the other families do not code), as the difference to its
#  last value at the same index in the same channel: tag the element (E_*,
#  elems.inc), fld its index in a run (a band, an envelope: up to 63), p1
#  p2 the last two differences there (sq2), p1r the last value's low byte,
#  pos the values in a row the element has had (tc_qlog), nb its bits (0 a
#  count), ws the channel's window sequence (4 none), ch the channel
#  element's channel (2 none), pb the element's value at the index before
#  where that was the value before (1 + its low 3 bits; 0 not), hx a
#  context of the field's own (window_shape, headers now and then, SBR
#  dt/df flags; 0 the rest), ml the fields in a row equal to their last
#  value (1 + tc_qlog), dm the digest's prediction (0 none).  Fields of n
#  bits skip the decisions their range leaves no choice in;
#  ics_info's grouping bits go one at a time.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9 from
#  this file and family.inc.

Prefix H9_hdr
Debug 1
Const 0

Index a
 a_tag: tag, &11111111
 a_fld: fld, 1!111111111111111

Index b
 b_tag: tag, &11111111
 b_p1r: p1r, &11111111

Index c
 c_tag: tag, &11111111
 c_p1: p1, 1!1111111111
 c_p2: p2, 1!111111

Index d
 d_tag: tag, &11111111
 d_fld: fld, 1!1111111
 d_p1: p1, 1!111111
 d_dm: dm, 1!111111111111111111111111111111111111111111111111111111111111

Index e
 e_tag: tag, &11111111
 e_ws: ws, 1!1111
 e_fld: fld, 1!1111111
 e_ml: ml, 1!1111111

Index h
 h_tag: tag, &11111111
 h_ch: ch, 1!11
 h_fld: fld, 1!111111111111111
 h_hx: hx, 1!1111111111111111

Index i
 i_tag: tag, &11111111
 i_pb: pb, 1!11111111
 i_p1r: p1r, &00000111

Index j
 j_tag: tag, &11111111
 j_pos: pos, 1!111
 j_p1: p1, 1!1111

Index k
 k_tag: tag, &11111111
 k_nb: nb, 1!11111111
 k_p1r: p1r, &00000111

Index l
 l_tag: tag, &11111111
 l_p1r: p1r, &00001111
 l_fld: fld, 1!1111

Index s
 s_tag: tag, &11111111

Index f
 f_tag: tag, &11111111
 f_fld: fld, 1!1111

Index m
 m_tag: tag, &11111111

Index w
 w_nb: nb, 1!11111111

Index t
 t_tag: tag, &11111111

Index n

Index g
 g_p1: p1, 1!111111

Number rA, 1, 0!10000010
Number rB, 1, 0!11110010
Number rC, 1, 0!11111111
Number rD, 1, 0!11111111
Number rE, 1, 0!11111111
Number rH, 1, 0!11111111
Number rI, 1, 0!10001001
Number rJ, 1, 0!11111110
Number rK, 1, 0!11111111
Number rL, 1, 0!11111101
Number rT, 1, 0!10000000
Number rG, 1, 0!01000000
Number rS1, 1, 0!01000
Number rS2, 1, 0!00110
Number lr, 1, 0!01111
Number mwA, 1, 0!10000000
Number mwB, 1, 0!00000100
Number mwC, 1, 0!00000100
Number mwD, 1, 0!00011011
Number mwE, 1, 0!00010000
Number mwH, 1, 0!00001000
Number mwI, 1, 0!00000001
Number mwJ, 1, 0!00010100
Number mwK, 1, 0!00110011
Number mwL, 1, 0!00111110
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01100
Number mt, 1, 0!010
Number qs, 1, 3!0010111
Number qf, 1, 3!0010001
Number mb, 1, 0!00001000
#  Frozen: no hint's mixer (lrm, mbm, index n): the family codes without one.
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows.  Frozen.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
