#  aacpack's esc family at level -9: an escaped magnitude of codebook 11,
#  less 16.  kq its place (tc_qlog), a1 the magnitude before it (tc_qlog), pf
#  the channel's last frame's at the place (1 + tc_qlog; 0 not known), oc
#  the CPE's other channel's (1 + tc_qlog; 0 none), ws long 0 short 1, la the
#  channel's last escape (tc_qlog), sb the band, av spc's: the place's
#  magnitude averaged over the frames, xp spc's guess at the magnitude.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9 from
#  this file and family.inc.

Prefix H9_esc
Debug 1
Const 0

Index a
 a_kq: kq, 1!1111110111110101010
 a_a1: a1, 1!0101010101

Index b
 b_pf: pf, 1!110100110010
 b_a1: a1, 1!00000

Index c
 c_oc: oc, 1!111010001011
 c_ws: ws, 1!1

Index d
 d_la: la, 1!000000001110
 d_kq: kq, 1!11101

Index e
 e_sb: sb, 1!01010010000000111101101110000000110000101000000000

Index h
 h_a1: a1, 1!111111111001
 h_la: la, 1!11111
 h_xp: xp, 1!011010000000111111110011100000000000000

Index i
 i_pf: pf, 1!000011111101
 i_oc: oc, 1!10101

Index j
 j_kq: kq, 1!0001010101110001001
 j_pf: pf, 1!01111

Index k
 k_a1: a1, 1!111111110101
 k_oc: oc, 1!01111

Index l
 l_la: la, 1!111111111111
 l_pf: pf, 1!10101

Index s
 s_a1: a1, 1!00000
 s_av: av, 1!1000000100001000110100011000010

Index f
 f_pf: pf, 1!00000
 f_av: av, 1!1100100010101001101010001011001

Index m
 m_ws: ws, 1!1

Index w
 w_ws: ws, 1!1

Index t
 t_kq: kq, 1!0000000000000000000

Index g

Number rA, 1, 0!00000000
Number rB, 1, 0!11010111
Number rC, 1, 0!01111111
Number rD, 1, 0!11110101
Number rE, 1, 0!11111101
Number rH, 1, 0!00100111
Number rI, 1, 0!10100010
Number rJ, 1, 0!00111011
Number rK, 1, 0!10101000
Number rL, 1, 0!11111001
Number rT, 1, 0!10000000
Number rG, 1, 0!01000000
Number rS1, 1, 0!01000
Number rS2, 1, 0!10000
Number lr, 1, 0!11011
Number mwA, 1, 0!00110011
Number mwB, 1, 0!11111001
Number mwC, 1, 0!11111100
Number mwD, 1, 0!00000000
Number mwE, 1, 0!11010001
Number mwH, 1, 0!00000000
Number mwI, 1, 0!10011110
Number mwJ, 1, 0!11101100
Number mwK, 1, 0!11111010
Number mwL, 1, 0!10011100
Number mwT, 1, 0!01110100
Number mwG, 1, 0!00000000
Number bw, 1, 0!01001
Number mt, 1, 0!010
Number qs, 1, 3!1110111
Number qf, 1, 3!0010001
Number mb, 1, 0!00101000
#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows.  Frozen.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
