#  aacpack's sec family at level -9: section_data.  kd 0 the bits of a
#  section's codebook (a tree: the node is where in it), 1 whether the
#  section goes on to the next band; cb the section's codebook (16 not
#  yet), pc the one before it in the group (16 none), fc the band's in the
#  channel's last frame (16 not known), gc in the group before (16 none), oc
#  of the CPE's other channel (16 none), sb the band, run the section's
#  bands so far, rem those left to max_sfb, ws the window sequence, gr the
#  group, fn the last frame's codebook at the next band (16 not known).
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9 from
#  this file and family.inc.

Prefix H9_sec
Debug 1
Const 0

Index a
 a_kd: kd, 1!1
 a_pc: pc, 1!1111111111111111
 a_fc: fc, 1!1111111111111111

Index b
 b_kd: kd, 1!1
 b_fc: fc, 1!1111111111111111
 b_sb: sb, 1!1111111

Index c
 c_kd: kd, 1!1
 c_cb: cb, 1!1111111111111111
 c_fn: fn, 1!1111111111111111

Index d
 d_kd: kd, 1!1
 d_gc: gc, 1!1111111111111111
 d_ws: ws, 1!111

Index e
 e_kd: kd, 1!1
 e_oc: oc, 1!1111111111111111
 e_pc: pc, 1!111

Index h
 h_kd: kd, 1!1
 h_sb: sb, 1!11111111111111111111111111111111111111111111111111
 h_ws: ws, 1!1

Index i
 i_kd: kd, 1!1
 i_run: run, 1!1111111111111111
 i_cb: cb, 1!1111111111111111

Index j
 j_kd: kd, 1!1
 j_rem: rem, 1!11111111
 j_fn: fn, 1!1111111111111111

Index k
 k_kd: kd, 1!1
 k_gr: gr, 1!1111111
 k_pc: pc, 1!1111111111111111

Index l
 l_kd: kd, 1!1
 l_cb: cb, 1!1111111111111111
 l_fc: fc, 1!1111111111111111
 l_run: run, 1!111

Index s
 s_kd: kd, 1!1
 s_cb: cb, 1!1111111111111111

Index f
 f_kd: kd, 1!1
 f_fc: fc, 1!1111111111111111

Index m
 m_kd: kd, 1!1

Index w
 w_kd: kd, 1!1

Index t

Index n

Index g

Number rA, 1, 0!11111110
Number rB, 1, 0!10011111
Number rC, 1, 0!11111111
Number rD, 1, 0!11111111
Number rE, 1, 0!11111111
Number rH, 1, 0!10111101
Number rI, 1, 0!11101010
Number rJ, 1, 0!11111110
Number rK, 1, 0!11111111
Number rL, 1, 0!11111110
Number rS1, 1, 0!10000
Number rS2, 1, 0!00110
Number lr, 1, 0!01111
Number mwA, 1, 0!00001000
Number mwB, 1, 0!00000100
Number mwC, 1, 0!10000011
Number mwD, 1, 0!00011111
Number mwE, 1, 0!00010100
Number mwH, 1, 0!00100000
Number mwI, 1, 0!00000000
Number mwJ, 1, 0!00001110
Number mwK, 1, 0!00011101
Number mwL, 1, 0!00000010
Number bw, 1, 0!01100
Number qs, 1, 3!0010111
Number qf, 1, 3!0010001
Number mb, 1, 0!10000000
#  Frozen: what a family of bit() decisions never reads: no mantissa, no
#  hint, no signs.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000
#  Frozen: no hint's mixer (lrm, mbm, index n): the family codes without one.
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows.  Frozen.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
