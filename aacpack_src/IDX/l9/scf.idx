#  aacpack's scf family at level -9: scale_factor_data, the deltas.  kd 0 a
#  scalefactor, 1 an intensity position, 2 a noise energy; sb the band, d1
#  d2 the last two deltas of the kind in the channel (sq2), pd the delta at
#  the band in the channel's last frame (1 + sq2; 0 not known), pa that
#  frame's value at the band less this band's predecessor's (1 + sq2; 0 not
#  known), cb the band's codebook, oc the CPE's other channel's delta at
#  the band (1 + sq2; 0 none), ws the window sequence, gr the group, gd
#  global_gain less the last frame's (1 + sq2; 0 not known), pv the band's
#  predecessor less global_gain (sq2).
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9 from
#  this file and family.inc.

Prefix H9_scf
Debug 1
Const 0

Index a
 a_kd: kd, 1!11
 a_pa: pa, 1!11111111111111
 a_d1: d1, 1!11111

Index b
 b_kd: kd, 1!11
 b_pd: pd, 1!11111111111111
 b_d1: d1, 1!111

Index c
 c_kd: kd, 1!11
 c_sb: sb, 1!11111111111111111111111111111111111111111111111111
 c_ws: ws, 1!1

Index d
 d_kd: kd, 1!11
 d_d1: d1, 1!1111111111111
 d_d2: d2, 1!11111

Index e
 e_kd: kd, 1!11
 e_oc: oc, 1!1111111111111
 e_pa: pa, 1!11111

Index h
 h_kd: kd, 1!11
 h_cb: cb, 1!111111111111111
 h_pa: pa, 1!111

Index i
 i_kd: kd, 1!11
 i_gd: gd, 1!1111111
 i_pa: pa, 1!1111111

Index j
 j_kd: kd, 1!11
 j_gr: gr, 1!1111111
 j_ws: ws, 1!1

Index k
 k_kd: kd, 1!11
 k_pv: pv, 1!1111111111
 k_sb: sb, 1!11111

Index l
 l_kd: kd, 1!11
 l_pa: pa, 1!111111111111
 l_pd: pd, 1!11111

Index s
 s_kd: kd, 1!11
 s_pa: pa, 1!111

Index f
 f_kd: kd, 1!11
 f_d1: d1, 1!111

Index m
 m_kd: kd, 1!11

Index w
 w_ws: ws, 1!1

Index t
 t_kd: kd, 1!11

Index n

Index g
 g_d1: d1, 1!11111

Number rA, 1, 0!10000010
Number rB, 1, 0!11110010
Number rC, 1, 0!11111111
Number rD, 1, 0!11111111
Number rE, 1, 0!11111111
Number rH, 1, 0!11111111
Number rI, 1, 0!10001001
Number rJ, 1, 0!11111110
Number rK, 1, 0!11111111
Number rL, 1, 0!11111101
Number rT, 1, 0!10000000
Number rG, 1, 0!01000000
Number rS1, 1, 0!01000
Number rS2, 1, 0!00110
Number lr, 1, 0!01111
Number mwA, 1, 0!10000000
Number mwB, 1, 0!00000100
Number mwC, 1, 0!00000100
Number mwD, 1, 0!00011011
Number mwE, 1, 0!00010000
Number mwH, 1, 0!00001000
Number mwI, 1, 0!00000001
Number mwJ, 1, 0!00010100
Number mwK, 1, 0!00110011
Number mwL, 1, 0!00111110
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number bw, 1, 0!01100
Number mt, 1, 0!010
Number qs, 1, 3!0010111
Number qf, 1, 3!0010001
Number mb, 1, 0!00100001
#  Frozen: no hint's mixer (lrm, mbm, index n): the family codes without one.
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows.  Frozen.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
