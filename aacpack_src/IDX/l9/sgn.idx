#  aacpack's sgn family at level -9: the sign of a nonzero spectral value.
#  cb its codebook, oc the CPE's other channel's at the place (0 zero or
#  none, 1 +, 2 -), ms ms_used (2 none), s1 the sign of the value before it
#  (0 zero, 1 +, 2 -), s2 of the one before that, pf the channel's last
#  frame's at the place (0 1 2), mg its magnitude (up to 7), kq its place
#  (tc_qlog), ws long 0 short 1.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9 from
#  this file and family.inc.

Prefix H9_sgn
Debug 1
Const 0

Index a
 a_cb: cb, 1!1111111111
 a_oc: oc, 1!11
 a_ms: ms, 1!11

Index b
 b_s1: s1, 1!11
 b_s2: s2, 1!11
 b_cb: cb, 1!1111111111

Index c
 c_pf: pf, 1!11
 c_mg: mg, 1!1111111

Index d
 d_oc: oc, 1!11
 d_mg: mg, 1!1111

Index e
 e_kq: kq, 1!1111111111111111111

Index h
 h_cb: cb, 1!1111111111
 h_mg: mg, 1!1111111
 h_kq: kq, 1!111111

Index i
 i_oc: oc, 1!11
 i_s1: s1, 1!11
 i_pf: pf, 1!11

Index j
 j_ws: ws, 1!1
 j_cb: cb, 1!1111111111

Index k
 k_s1: s1, 1!11
 k_mg: mg, 1!1111111

Index l
 l_oc: oc, 1!11
 l_ms: ms, 1!11
 l_pf: pf, 1!11

Index s
 s_cb: cb, 1!1111111111

Index f
 f_oc: oc, 1!11

Index m
 m_cb: cb, 1!1111111111

Index w
 w_ms: ms, 1!11

Index t

Index n

Index g

Number rA, 1, 0!11111110
Number rB, 1, 0!10011111
Number rC, 1, 0!11111111
Number rD, 1, 0!11111111
Number rE, 1, 0!11111111
Number rH, 1, 0!10111101
Number rI, 1, 0!11101010
Number rJ, 1, 0!11111110
Number rK, 1, 0!11111111
Number rL, 1, 0!11111110
Number rS1, 1, 0!10000
Number rS2, 1, 0!00110
Number lr, 1, 0!01111
Number mwA, 1, 0!00001000
Number mwB, 1, 0!00000100
Number mwC, 1, 0!10000011
Number mwD, 1, 0!00011111
Number mwE, 1, 0!00010100
Number mwH, 1, 0!00100000
Number mwI, 1, 0!00000000
Number mwJ, 1, 0!00001110
Number mwK, 1, 0!00011101
Number mwL, 1, 0!00000010
Number bw, 1, 0!01100
Number qs, 1, 3!0010111
Number qf, 1, 3!0010001
Number mb, 1, 0!00100000
#  Frozen: what a family of bit() decisions never reads: no mantissa, no
#  hint, no signs.
! Number rT, 1, 0!00000000
! Number mwT, 1, 0!00000000
! Number mt, 1, 0!000
! Number rG, 1, 0!00000000
! Number mwG, 1, 0!00000000
#  Frozen: no hint's mixer (lrm, mbm, index n): the family codes without one.
! Number lrm, 1, 0!00000
! Number mbm, 1, 0!00000000
#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows.  Frozen.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hS, 1, 0!11000
! Number hF, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
! Number hN, 1, 0!11000
