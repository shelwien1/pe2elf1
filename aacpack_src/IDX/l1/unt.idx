#  aacpack's unt family at level -1: the stream's own values (cmstream.inc):
#  the kind of each unit, the lengths of what is stored as its bytes, the
#  assumed SBR headers, the CRC.  fld is the field, ctx a context its caller
#  gives, p1 p2 the field's last two values (tc_qlog).
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9 from
#  this file and family.inc.

Prefix H1_unt
Debug 1
Const 0

Index a
 a_fld: fld, 1!110010000000000

Index b
 b_fld: fld, 1!010100000000000
 b_ctx: ctx, 1!000000000000000

Index c
 c_fld: fld, 1!110100000000000
 c_p1: p1, 1!000000

Index d
 d_fld: fld, 1!010010000000000
 d_ctx: ctx, 1!1111111
 d_p1: p1, 1!11

Index m
 m_fld: fld, 1!110100000000000

Index t
 t_fld: fld, 1!111111111111111

Index g

Number rA, 1, 0!00000000
Number rB, 1, 0!11000000
Number rC, 1, 0!00000000
Number rD, 1, 0!00000000
Number rT, 1, 0!10000000
Number rG, 1, 0!01000000
Number lr, 1, 0!11111
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000000
Number mwD, 1, 0!00000000
Number mwT, 1, 0!11111111
Number mwG, 1, 0!00000000
Number mt, 1, 0!010
Number mb, 1, 0!11111111
#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows.  Frozen.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
