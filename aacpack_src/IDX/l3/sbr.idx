#  aacpack's sbr family at level -3: SBR envelopes and noise floors and the
#  PS parameters, the deltas the bitstream has.  kd the kind (0 envelope
#  across frequency, 1 in time, 2 3 the noise floor's, 4-7 the same of a
#  coupled balance channel, 8 9 iid, 10 11 icc, 12 ipd, 13 opd, 14 a start
#  value), bd the band, nb the bands, d1 d2 the last two values in the
#  envelope (sq2), pv the value at the band in the last envelope of the
#  kind (1 + sq2; 0 not known), ar amp_res, fr freq_res, en the envelope, ch
#  the channel, lv the band's level as the last envelope left it (1 +
#  tc_qlog; 0 not known), q the fine iid quantization, rm the mean of the
#  envelope's values so far (1 + sq2), cl the core's top coded band's
#  level (envelopes; 0 not known), rs the last envelope's shape at the band
#  (frequency deltas: 1 + sq2), dg the digest's prediction (0 none).
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9 from
#  this file and family.inc.

Prefix H3_sbr
Debug 1
Const 0

Index a
 a_kd: kd, 1!10110100111100
 a_bd: bd, 1!100110110100111101000000000000
 a_ar: ar, 1!1

Index b
 b_kd: kd, 1!01100000000001
 b_lv: lv, 1!01100011010
 b_ch: ch, 1!0

Index c
 c_kd: kd, 1!11000001011001
 c_d1: d1, 1!1111000000
 c_d2: d2, 1!111111
 c_rm: rm, 1!11010100000010

Index d
 d_kd: kd, 1!11101100000010
 d_ar: ar, 1!1
 d_fr: fr, 1!1
 d_bd: bd, 1!001010110100

Index e
 e_kd: kd, 1!11100100010001
 e_d1: d1, 1!1111000010
 e_pv: pv, 1!11111
 e_rs: rs, 1!01111100001000

Index h
 h_kd: kd, 1!10100000010000
 h_nb: nb, 1!11111111111111111111
 h_bd: bd, 1!111

Index m
 m_kd: kd, 1!00111100000001

Index t
 t_kd: kd, 1!10000000000010

Index g
 g_d1: d1, 1!11111

Number rA, 1, 0!11111110
Number rB, 1, 0!11111111
Number rC, 1, 0!11111111
Number rD, 1, 0!11110010
Number rE, 1, 0!11111111
Number rH, 1, 0!11001111
Number rT, 1, 0!10000000
Number rG, 1, 0!01000000
Number lr, 1, 0!01110
Number mwA, 1, 0!00000100
Number mwB, 1, 0!00010110
Number mwC, 1, 0!00000000
Number mwD, 1, 0!00111110
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00101000
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00010001
Number mt, 1, 0!100
Number mb, 1, 0!10000000
#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows.  Frozen.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
