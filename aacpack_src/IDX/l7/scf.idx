#  aacpack's scf family at level -7: scale_factor_data, the deltas.  kd 0 a
#  scalefactor, 1 an intensity position, 2 a noise energy; sb the band, d1
#  d2 the last two deltas of the kind in the channel (sq2), pd the delta at
#  the band in the channel's last frame (1 + sq2; 0 not known), pa that
#  frame's value at the band less this band's predecessor's (1 + sq2; 0 not
#  known), cb the band's codebook, oc the CPE's other channel's delta at
#  the band (1 + sq2; 0 none), ws long 0 short 1, gr the group, gd
#  global_gain less the last frame's (1 + sq2; 0 not known), pv the band's
#  predecessor less global_gain (sq2), fb the first of its kind in the frame
#  (0 not), sk the bands skipped since the last of its kind (tc_qlog), mu
#  the band's ms_used (1 L/R, 2 M/S; 0 none), pw short windows' group before
#  at the band less the value so far (1 + sq2; 0 none), dm the digest's
#  prediction (0 none).
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9 from
#  this file and family.inc.

Prefix H7_scf
Debug 1
Const 0

Index a
 a_kd: kd, 1!01
 a_pa: pa, 1!00111111111111
 a_d1: d1, 1!01111

Index b
 b_kd: kd, 1!00
 b_pd: pd, 1!01000001010101
 b_d1: d1, 1!100

Index c
 c_kd: kd, 1!01
 c_sb: sb, 1!11111111111111111100100111110101111011111111110100
 c_ws: ws, 1!1

Index d
 d_kd: kd, 1!11
 d_d1: d1, 1!1111111100011
 d_d2: d2, 1!00001
! d_dm: dm, 1!111111111111111111111111111111111111111111111111111111111111

Index e
 e_kd: kd, 1!00
 e_oc: oc, 1!1101010101000
 e_pa: pa, 1!00000
 e_mu: mu, 1!11

Index h
 h_kd: kd, 1!10
 h_cb: cb, 1!000000000000000
 h_pa: pa, 1!100

Index i
 i_kd: kd, 1!11
 i_gd: gd, 1!1111111
 i_pa: pa, 1!1111111

Index j
 j_kd: kd, 1!11
 j_gr: gr, 1!0100010
 j_ws: ws, 1!1
 j_pw: pw, 1!1111110000001111111000000

Index k
 k_kd: kd, 1!11
 k_pv: pv, 1!1111111111
 k_sb: sb, 1!00101
 k_sk: sk, 1!100100010000000

Index l
 l_kd: kd, 1!11
 l_pa: pa, 1!000111111111
 l_pd: pd, 1!10111

Index s
 s_kd: kd, 1!10
 s_pa: pa, 1!111
 s_fb: fb, 1!11

Index m
 m_kd: kd, 1!01
 m_mu: mu, 1!11

Index w
 w_ws: ws, 1!1

Index t
 t_kd: kd, 1!01

Index g
 g_d1: d1, 1!11111

Number rA, 1, 0!11111111
Number rB, 1, 0!11111100
Number rC, 1, 0!11111111
Number rD, 1, 0!11111111
Number rE, 1, 0!11111111
Number rH, 1, 0!10000000
Number rI, 1, 0!11111100
Number rJ, 1, 0!01001011
Number rK, 1, 0!11111111
Number rL, 1, 0!11111101
Number rT, 1, 0!11000000
Number rG, 1, 0!01111110
Number lr, 1, 0!01111
Number mwA, 1, 0!00011010
Number mwB, 1, 0!00000000
Number mwC, 1, 0!00000001
Number mwD, 1, 0!00011101
Number mwE, 1, 0!00000101
Number mwH, 1, 0!10000000
Number mwI, 1, 0!10110001
Number mwJ, 1, 0!00010000
Number mwK, 1, 0!00000000
Number mwL, 1, 0!00111111
Number mwT, 1, 0!00010001
Number mwG, 1, 0!00001000
Number mt, 1, 0!000
Number mb, 1, 0!00110110
#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows.  Frozen.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
