#  aacpack's esc family at level -7: an escaped magnitude of codebook 11,
#  less 16.  kq its place (tc_qlog), a1 the magnitude before it (tc_qlog), pf
#  the channel's last frame's at the place (1 + tc_qlog; 0 not known), oc
#  the CPE's other channel's (1 + tc_qlog; 0 none), ws long 0 short 1, la the
#  channel's last escape (tc_qlog), sb the band, av spc's: the place's
#  magnitude averaged over the frames, xp spc's guess at the magnitude.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9 from
#  this file and family.inc.

Prefix H7_esc
Debug 1
Const 0

Index a
 a_kq: kq, 1!1101011111010100010
 a_a1: a1, 1!1010101111

Index b
 b_pf: pf, 1!000000001010
 b_a1: a1, 1!00000

Index c
 c_oc: oc, 1!111001001011
 c_ws: ws, 1!1

Index d
 d_la: la, 1!000000001101
 d_kq: kq, 1!10001

Index e
 e_sb: sb, 1!01101011110111111101000111100000000011100000000000

Index h
 h_a1: a1, 1!111111110010
 h_la: la, 1!11111
 h_xp: xp, 1!001100000000111111110100100000000000000

Index i
 i_pf: pf, 1!010101111101
 i_oc: oc, 1!10111

Index j
 j_kq: kq, 1!0011111101100011001
 j_pf: pf, 1!11110

Index k
 k_a1: a1, 1!000000001001
 k_oc: oc, 1!00000

Index l
 l_la: la, 1!000000000110
 l_pf: pf, 1!00001

Index s
 s_a1: a1, 1!00000
 s_av: av, 1!1110001010110011111100000001000

Index m
 m_ws: ws, 1!1

Index w
 w_ws: ws, 1!1

Index t
 t_kq: kq, 1!0000000000000000000

Index g

Number rA, 1, 0!10000010
Number rB, 1, 0!11111000
Number rC, 1, 0!11111011
Number rD, 1, 0!10111010
Number rE, 1, 0!11111111
Number rH, 1, 0!00000000
Number rI, 1, 0!11000000
Number rJ, 1, 0!11111110
Number rK, 1, 0!11111110
Number rL, 1, 0!11111101
Number rT, 1, 0!10000000
Number rG, 1, 0!01000000
Number lr, 1, 0!11101
Number mwA, 1, 0!00000000
Number mwB, 1, 0!00000001
Number mwC, 1, 0!00000101
Number mwD, 1, 0!00000000
Number mwE, 1, 0!10000001
Number mwH, 1, 0!00000000
Number mwI, 1, 0!00000000
Number mwJ, 1, 0!00000000
Number mwK, 1, 0!00000011
Number mwL, 1, 0!00000000
Number mwT, 1, 0!01101111
Number mwG, 1, 0!00000000
Number mt, 1, 0!010
Number mb, 1, 0!00001011
#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows.  Frozen.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
