#  aacpack's hdr family at level -7: a field of the AAC syntax (every value
#  of the walk the other families do not code), as the difference to its
#  last value at the same index in the same channel: tag the element (E_*,
#  elems.inc), fld its index in a run (a band, an envelope: up to 63), p1
#  p2 the last two differences there (sq2), p1r the last value's low byte,
#  pos the values in a row the element has had (tc_qlog), nb its bits (0 a
#  count), ws the channel's window sequence (4 none), ch the channel
#  element's channel (2 none), pb the element's value at the index before
#  where that was the value before (1 + its low 3 bits; 0 not), hx a
#  context of the field's own (window_shape, headers now and then, SBR
#  dt/df flags; 0 the rest), ml the fields in a row equal to their last
#  value (1 + tc_qlog), dm the digest's prediction (0 none).  Fields of n
#  bits skip the decisions their range leaves no choice in;
#  ics_info's grouping bits go one at a time.
#  IDX/IDX-FORMAT.md is the format; ../../mk.sh regenerates MOD/l9 from
#  this file and family.inc.

Prefix H7_hdr
Debug 1
Const 0

Index a
 a_tag: tag, &11111111
 a_fld: fld, 1!000000000000011

Index b
 b_tag: tag, &00011011
 b_p1r: p1r, &11011101

Index c
 c_tag: tag, &11111111
 c_p1: p1, 1!1111111010
 c_p2: p2, 1!111111

Index d
 d_tag: tag, &11111111
 d_fld: fld, 1!0001001
 d_p1: p1, 1!000000
! d_dm: dm, 1!111111111111111111111111111111111111111111111111111111111111

Index e
 e_tag: tag, &00111111
 e_ws: ws, 1!1111
 e_fld: fld, 1!1111010
 e_ml: ml, 1!0111100

Index h
 h_tag: tag, &10111111
 h_ch: ch, 1!11
 h_fld: fld, 1!101111101111011
 h_hx: hx, 1!10101110000001111000

Index i
 i_tag: tag, &11111111
 i_pb: pb, 1!11111100
 i_p1r: p1r, &11001111

Index j
 j_tag: tag, &11111111
 j_pos: pos, 1!111
 j_p1: p1, 1!0000

Index k
 k_tag: tag, &00110011
 k_nb: nb, 1!11101010
 k_p1r: p1r, &11000111

Index l
 l_tag: tag, &11110111
 l_p1r: p1r, &10011011
 l_fld: fld, 1!1110

Index s
 s_tag: tag, &00000000

Index m
 m_tag: tag, &11111111

Index w
 w_nb: nb, 1!00100011

Index t
 t_tag: tag, &01000111

Index g
 g_p1: p1, 1!111110

Number rA, 1, 0!10000011
Number rB, 1, 0!01110011
Number rC, 1, 0!11111111
Number rD, 1, 0!11111110
Number rE, 1, 0!11111110
Number rH, 1, 0!11111101
Number rI, 1, 0!11111110
Number rJ, 1, 0!01000101
Number rK, 1, 0!00000000
Number rL, 1, 0!11111101
Number rT, 1, 0!10001010
Number rG, 1, 0!01000000
Number lr, 1, 0!11111
Number mwA, 1, 0!10000110
Number mwB, 1, 0!10000001
Number mwC, 1, 0!00000100
Number mwD, 1, 0!00000010
Number mwE, 1, 0!00000000
Number mwH, 1, 0!00000000
Number mwI, 1, 0!00000000
Number mwJ, 1, 0!00001000
Number mwK, 1, 0!00000010
Number mwL, 1, 0!00000010
Number mwT, 1, 0!00000000
Number mwG, 1, 0!00000000
Number mt, 1, 0!000
Number mb, 1, 0!00011111
#  Rows per table, as log2: a table whose index Volume fits in 2^h rows is
#  direct, one that does not is hashed into 2^h rows.  Frozen.
! Number hA, 1, 0!11000
! Number hB, 1, 0!11000
! Number hC, 1, 0!11000
! Number hD, 1, 0!11000
! Number hE, 1, 0!11000
! Number hH, 1, 0!11000
! Number hI, 1, 0!11000
! Number hJ, 1, 0!11000
! Number hK, 1, 0!11000
! Number hL, 1, 0!11000
! Number hS, 1, 0!11000
! Number hM, 1, 0!11000
! Number hT, 1, 0!11000
