+/**
+* The number PHP 5's sprintf() made of an argument: the leading integer of a string for %d
+* ('1e3' is 1, PHP 7.1+ reads 1000), a float for %f.
+*
+* @param	mixed
+* @param	boolean	Float (%e, %f, %g) instead of integer
+*
+* @return	integer|float
+*/
+function vb_sprintf_number($value, $float)
+{
+	if (is_object($value))
+	{
+		return ($float ? 1.0 : 1);
+	}
+	if ($float)
+	{
+		return floatval($value);
+	}
+	if (is_string($value))
+	{
+		return (preg_match('#^[ \t\n\r\x0B\x0C]*[+-]?\d+#', $value, $match) ? intval($match[0]) : 0);
+	}
+	return intval($value);
+}
