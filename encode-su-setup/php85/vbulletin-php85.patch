+/**
+* sprintf() with an array of arguments (the format first), with the PHP 5 rules. vB formats
+* phrases from the database this way. For a bad format PHP 8 throws an Error, where PHP 5
+* returned false (too few arguments) or printed nothing for an unknown or incomplete
+* conversion specification (a lone '%' in a phrase, say) but still used up an argument.
+* PHP 8 also reads a precision without digits ('%.f') as 0, PHP 5 ignored it; and PHP 5
+* converted an argument for %d with its own rules ('1e3' is 1) and in place, so that a
+* later %1$s printed the number.
+*
+* @param	array	The format string, then the arguments
+*
+* @return	string|false
+*/
+function vb_sprintf_array($args)
+{
+	$args = array_values($args); // string keys would be named arguments in PHP 8
+	if (PHP_VERSION_ID < 80000)
+	{
+		return call_user_func_array('sprintf', $args);
+	}
+
+	$format = strval($args[0]);
+	if (!preg_match('#%(?!(?:\d+\$)?s)#', str_replace('%%', '', $format)))
+	{
+		// only %s and %1$s (most phrases): PHP 5 and PHP 8 agree, apart from errors
+		try
+		{
+			return call_user_func_array('sprintf', $args);
+		}
+		catch (Error $e) // ArgumentCountError (too few arguments), ValueError (argnum 0)
+		{
+			return false;
+		}
+	}
+
+	// rewrite the format as PHP 5 read it, with an argument number for every conversion
+	$count = count($args);
+	$length = strlen($format);
+	$new = '';
+	$start = 0;
+	$next = 1;
+	$converted = array(); // argument => index of the value PHP 5 converted it to
+	while (($pos = strpos($format, '%', $start)) !== false)
+	{
+		$new .= substr($format, $start, $pos - $start);
+		$i = $pos + 1;
+		if ($i < $length AND $format[$i] == '%')
+		{
+			$new .= '%%';
+			$start = $i + 1;
+			continue;
+		}
+
+		$argnum = 0;
+		$modifiers = '';
+		// PHP 5 read argnum$, flags, width and precision only after an ASCII character that is not a letter
+		if ($i >= $length OR (ord($format[$i]) < 128 AND !preg_match('#[a-z]#i', $format[$i])))
+		{
+			preg_match('#((\d*)\$)?((?:[ 0+\-]|\'[\s\S])*\d*)(\.\d*)?#A', $format, $match, 0, $i);
+			$i += strlen($match[0]);
+			if (!empty($match[1]))
