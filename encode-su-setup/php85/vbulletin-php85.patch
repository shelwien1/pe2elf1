+				if ($argnum <= 0)
+				{
+					return false;
+				}
+			}
+			$modifiers = $match[3] . ((isset($match[4]) AND $match[4] !== '.') ? $match[4] : '');
+		}
+		if ($i < $length AND $format[$i] == 'l')
+		{
+			$i++;
+		}
+		$type = ($i < $length ? $format[$i] : '');
+		$start = min($i + 1, $length);
+
+		$arg = ($argnum ? $argnum : $next++);
+		if ($arg >= $count)
+		{
+			return false; // too few arguments
+		}
+		if ($type === '%')
+		{
+			$new .= '%%';
+		}
+		else if ($type !== '' AND strpos('sdugGeEfFcoxXb', $type) !== false)
+		{
+			$value = (isset($converted[$arg]) ? $converted[$arg] : $arg);
+			if ($type != 's')
+			{
+				$args[] = vb_sprintf_number($args[$value], strpos('gGeEfF', $type) !== false);
+				$value = count($args) - 1;
+				if (!$argnum)
