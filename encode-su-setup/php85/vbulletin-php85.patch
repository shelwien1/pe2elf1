+/**
+* Whether mbstring knows an encoding. PHP 8 throws ValueError for an unknown or empty
+* encoding where PHP 7 returned false, which the @mb_*() calls with a fallback relied on.
+*
+* @param	string	Encoding name (e.g. the language charset)
+*
+* @return	boolean
+*/
+function vb_mb_encoding_ok($encoding)
+{
+	static $known = array();
+
+	$encoding = strval($encoding);
+	if (!isset($known[$encoding]))
+	{
+		$known[$encoding] = false;
+		if ($encoding !== '' AND function_exists('mb_strlen'))
+		{
+			try
+			{
+				$known[$encoding] = (@mb_strlen('', $encoding) !== false);
+			}
+			catch (Throwable $e)
+			{
+			}
+		}
+	}
+
+	return $known[$encoding];
+}
