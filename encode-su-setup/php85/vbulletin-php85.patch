+/**
+* Loose comparison (==) with the PHP 7 rule for a number and a non-numeric string: PHP 7
+* converted the string to a number (so 0 == '' and 0 == 'abc' were true), PHP 8 compares
+* them as strings. Form helpers use this to pre-select the same options as before.
+*
+* @param	mixed
+* @param	mixed
+*
+* @return	boolean
+*/
+function vb_loose_equals($a, $b)
+{
+	if ((is_int($a) OR is_float($a)) AND is_string($b) AND !is_numeric($b))
+	{
+		return $a == (float) $b;
+	}
+	if ((is_int($b) OR is_float($b)) AND is_string($a) AND !is_numeric($a))
+	{
+		return (float) $a == $b;
+	}
+	return $a == $b;
+}
+
+/**
+* in_array() using vb_loose_equals() (PHP 7 comparison rules).
+*
+* @param	mixed
+* @param	array
+*
+* @return	boolean
+*/
+function vb_loose_in_array($needle, $haystack)
+{
+	foreach ($haystack AS $value)
+	{
+		if (vb_loose_equals($needle, $value))
+		{
+			return true;
+		}
+	}
+	return false;
+}
