# The scalefactors' mixing stage (sh_model_counts.inc: Process_sf1xlong;
# freq_cm.inc), which mixes mp3c's two predictions of each bit of MPEG-1's
# long-block scalefactors with four counters of its own: the rows of the
# counters (ya..yd, a row holding the 32 nodes of a scalefactor's binary
# tree) and the mixer's weight sets (yw, and the node).  The variables are
# Process_sf1xlong's.

Const 0

# the channel's last value at the band, and the band
Index ya
 ya_i0: i,      1!11111111111111111111
 ya_i1: yprev,  1!111111111111111

# the other channel's value at the band, and the band
Index yb
 yb_i0: i,      1!11111111111111111111
 yb_i1: yoth,   1!111111111111111

# the value that keeps the band's last quantizer step, and the band
# below's value in this granule
Index yc
 yc_i0: ypred,  1!1111111111111111
 yc_i1: k,      1!111111111111111

# the same, and the change of global_gain
Index yd
 yd_i0: ypred,  1!1111111111111111
 yd_i1: ydg,   -7!111111111111111

Index yw
 yw_i0: i,      1!11111111111111111111

# as the spectral stage's (sh_model.idx: xlim .. xmb)
Number ylim, 1,0!1111011011
Number ymw,  1,0!100000010000
Number ysh,  1,0!0100
Number ywa,  1,0!00000000010000001
Number ywb,  1,0!01000000000000000
Number ylr,  1,0!00100101
Number ymb,  1,0!00110111

# MPEG-2's scalefactors' stage (sh_model_counts.inc: Process_sf2), the same
# over ProcessScale2's ylong trees: rows of 64 nodes (za..zd), weight sets
# zw (and the node)

# the channel's last value at the position, and the position
Index za
 za_i0: p,      1!11111111111111111111111111111111111111
 za_i1: zprev,  1!111111111111111

# the other channel's value, and the position
Index zb
 zb_i0: p,      1!11111111111111111111111111111111111111
 zb_i1: zoth,   1!111111111111111

# the value that keeps the last quantizer step, and the value before
Index zc
 zc_i0: zpred,  1!1111111111111111
 zc_i1: zbelow, 1!111111111111111

# the same, and the change of global_gain
Index zd
 zd_i0: zpred,  1!1111111111111111
 zd_i1: zdg,   -7!111111111111111

Index zw
 zw_i0: p,      1!11111111111111111111111111111111111111
 zw_i1: bk,     1!11

# MPEG-1's short-block scalefactors' stage (sh_model_counts.inc:
# Process_sf1short), the same over ProcessScale1's small trees: rows of 16
# nodes (sa..sd), weight sets sw (and the node)

# the channel's last value at the band and window, and the band, window
Index sa
 sa_i0: i,      1!11111111111
 sa_i1: b,      1!11
 sa_i2: sprev,  1!111111111111111

# the window before at the band, and the band
Index sb
 sb_i0: i,      1!11111111111
 sb_i1: swin,   1!1111111111111111

# the band below in this window, and the window before
Index sc
 sc_i0: sbelow, 1!111111111111111
 sc_i1: swin,   1!1111111111111111

# the other channel's value, and the band
Index sd
 sd_i0: i,      1!11111111111
 sd_i1: soth,   1!111111111111111

Index sw
 sw_i0: i,      1!11111111111
 sw_i1: b,      1!11

# global_gain's stage (sh_model_counts.inc: Process_GlGain), the same over
# its tree of 9 levels: rows of 512 nodes (ga..gd), weight sets gw (and the
# depth); and its parameters, as the spectral stage's

# the channel, and its last change
Index ga
 ga_i0: ch,     1!1
 ga_i1: gld,   -7!111111111111111

# the other channel's latest change
Index gb
 gb_i0: ch,     1!1
 gb_i1: god,   -7!111111111111111

# the channel's last value, in steps of 8
Index gc
 gc_i0: glast,  1!000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000

# the other channel's latest value, less this one's last
Index gd
 gd_i0: ch,     1!1
 gd_i1: gx,   -15!1111111111111111111111111111111

Index gw
 gw_i0: ch,     1!1

Number glim, 1,0!0111110111
Number gmw,  1,0!100111100101
Number gsh,  1,0!1111
Number gwa,  1,0!00000101100000000
Number gwb,  1,0!00100000010000010
Number glr,  1,0!01000000
Number gmb,  1,0!00011000

# the counts' stage (sh_model_counts.inc: Process_cnt), the same over the
# count trees of 10 levels: rows of 1024 nodes (ca..cd), weight sets cw (and
# the depth)

# which count, and the channel's last value of it
Index ca
 ca_i0: cwh,    1!1
 ca_i1: clast,  1!

# which count, and the other channel's latest value of it
Index cb
 cb_i0: cwh,    1!1
 cb_i1: coth,   1!

# which count, and the change of global_gain
Index cc
 cc_i0: cwh,    1!1
 cc_i1: cdg,   -7!111111111111111

# which count, the block type, and the c1 that k follows
Index cd
 cd_i0: cwh,    1!1
 cd_i1: cbt,    1!111
 cd_i2: cc1,    1!

Index cw
 cw_i0: cwh,    1!1

Number clim, 1,0!1110110001
Number cmw,  1,0!001001100110
Number csh,  1,0!0100
Number cwa,  1,0!00001000000101000
Number cwb,  1,0!01000000000000000
Number clr,  1,0!00010100
Number cmb,  1,0!01000000
